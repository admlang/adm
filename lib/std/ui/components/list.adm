partial module std.ui.components {
	use (
		std.math.geom::(Line, Point, Rect, StrokeStyle)
		std.services.vault.kept::(keep, keepable, restored)
		std.time
		std.ui::(Key, KeyEvent, MouseButton, PointerEvent, PointerPhase, RenderContext, themeOf)
		std.ui.frames::(askFrame, askRebuild)
		std.ui.runtime::(dragSlack, redrawBy, warn)
		std.ui.styles::*
		std.units::Pixels
	)

	// What a list hands the function that draws a row.
	struct RowItem<T> {
		// The item of the row and where it is among the items.
		content  T
		index    int
		// Whether the row is selected, and whether the keyboard is on it.
		selected bool
		current  bool
		// In a `Tree`: how many nodes are above the row's, and whether its children show.
		depth    int
		expanded bool
		// A sticky header held at the edge of the rows' room, over the rows that scroll
		// under it, rather than at its own place among them.
		docked   bool
	}

	// A row the list mounts: which, and the room before it for the rows it does not.
	internal struct ListMount {
		index int
		gap   float
	}

	// Where a row draws the line that parts a section from what scrolls: above a
	// header at its place among the rows or held at the bottom, below one held at the
	// top; the first header has none.
	internal enum DividerSide {
		None,
		Top,
		Bottom,
	}

	// Items too many or too lazy for an array: `List(source = files)`.
	interface Source<T> {
		// How many items there are now.
		def count() int
		// The item at `index`, from 0.
		def at(index int) T
		// What changed since the list last looked. The source sends with `offer`; a
		// list in a window takes each change as it is sent and shows it on the next
		// frame.
		def changes() channel<SourceChange>
	}

	// What a change of a `Source` did.
	enum SourceChangeKind {
		// `count` items were added before the item that was at `at`.
		Inserted,
		// `count` items from `at` on are gone.
		Removed,
		// `count` items from `at` on are other items or look different.
		Updated,
		// Everything may be different.
		Reset,
	}

	// One change of a `Source`.
	struct SourceChange {
		kind  SourceChangeKind
		at    int
		count int
	}

	// How many rows of a collection can be selected.
	enum SelectionMode {
		None,
		Single,
		Multiple,
	}

	// Where dragged rows go against the row the pointer is on when they are let go of.
	enum RowPlace {
		Before,
		After,
		// Among the row's children: in a `Tree`.
		Inside,
	}

	// What a collection tells when rows dragged with the pointer were let go of on
	// another row.
	struct RowDrop<T> {
		// The dragged items, in row order.
		items  T[]
		// The row the pointer was on, and where against it the items go.
		target T
		place  RowPlace
	}

	// What a `Tree` tells the list that shows its rows about a drag of them.
	internal interface DropHost {
		// Whether rows `items` may go to `place` against row `target`, before the caller
		// is asked: not into the subtree of one of them.
		def dropAllowed(items int[], target int, place RowPlace) bool
		// How far from the start edge the content of row `index` begins: the drop line
		// starts there.
		def dropLead(index int) float
		// The drag rested on row `index` with the drop inside it: a closed node opens.
		def dragRested(index int)
	}

	// How near an edge of the rows' room a drag scrolls them, how far on each step and
	// how long between steps; how long a drag rests on a row before the row is told.
	internal const rowDragEdge = 24.0
	internal const rowDragStep = 12.0
	internal const rowDragTick = 16ms
	internal const rowDragRest = 700ms

	// The style of a `List`.
	style ListStyle {
		Box
		Layout
		Background
		Interaction
		width = fill
		height = fill
	}

	// The style of the box a list puts around each row: the theme's hover fill under the
	// pointer, its selection fill while the row is selected, and a ring in the focus colour
	// inside the row the keyboard is on.
	style ListRowStyle {
		Box
		Layout
		Background
		Outline
		width = fill
		on = {
			hover:    {background: overlayFill(theme.palette.hover)},
			selected: {background: new BackgroundFill(theme.palette.selection)},
			current:  {outline: Ring{width: theme.metrics.focusWidth, paint: theme.palette.focus, offset: 0(px) - theme.metrics.focusWidth}},
		}
	}

	// The heights of the rows of a virtualised collection: one height for all of them, or
	// what each row measured, with the average of those for a row not seen yet. Sums over
	// the measured rows are kept in two Fenwick trees (heights, and how many are measured),
	// so the top of a row and the row at an offset cost O(log n).
	internal type RowHeights {
		// The height every row has; none: measured.
		fixed    ?float  = none
		count    int
		// Each row's measured height; below 0: not measured.
		known    float[]
		sums     float[]
		marks    int[]
		// The measured rows: the sum of their heights and how many they are.
		measured float
		seen     int

		// The height of a row nothing measured.
		def guess() float {
			return seen > 0 ?? (measured / float(seen), 32.0)
		}

		// Forgets every measure.
		def reset() {
			let rows = count
			resize(0)
			resize(rows)
		}

		// Follows the number of rows: rows added at the end are not measured, those past
		// the end are forgotten.
		def resize(rows int) {
			return when rows == count
			if rows < count {
				for let i = rows; i < count; i++ {
					continue when known[i] < 0.0
					measured -= known[i]
					seen--
				}
				known.len(rows)
				// A prefix of a Fenwick tree is the tree of the prefix.
				sums.len(rows + 1)
				marks.len(rows + 1)
				count = rows
				return
			}
			sums.push(0.0) when sums.len() == 0
			marks.push(0) when marks.len() == 0
			for let i = count; i < rows; i++ {
				known.push(-1.0)
				sums.push(0.0)
				marks.push(0)
			}
			count = rows
		}

		// Notes what row `index` measured; whether that is another height than it had.
		def measure(index int, height float) bool {
			return false when index < 0 || index >= count || !(fixed is none)
			let before = known[index]
			return false when before >= 0.0 && (before - height).abs() < 0.01
			let delta = before < 0.0 ?? (height, height - before)
			if before < 0.0 {
				seen++
			}
			measured += delta
			known[index] = height
			for let i = index + 1; i <= count; i += i & -i {
				sums[i] += delta
				marks[i]++ when before < 0.0
			}
			return true
		}

		// Forgets what `rows` rows from `from` on measured.
		def forget(from int, rows int) {
			for let index = from.max(0); index < (from + rows).min(count); index++ {
				let before = known[index]
				continue when before < 0.0
				known[index] = -1.0
				measured -= before
				seen--
				for let i = index + 1; i <= count; i += i & -i {
					sums[i] -= before
					marks[i]--
				}
			}
		}

		// The height of one row.
		def height(index int) float {
			let same = fixed
			return same unless same is none
			return guess() when index < 0 || index >= count || known[index] < 0.0
			return known[index]
		}

		// How far the top of row `index` is from the top of the first; with `count`, the
		// height of all the rows.
		def top(index int) float {
			let rows = index.max(0).min(count)
			let same = fixed
			return same * float(rows) unless same is none
			let sum = 0.0
			let counted = 0
			for let i = rows; i > 0; i -= i & -i {
				sum += sums[i]
				counted += marks[i]
			}
			return sum + float(rows - counted) * guess()
		}

		// The row that holds the offset `y` from the top of the first; the last row when
		// `y` is past the end, 0 when there are no rows.
		def at(y float) int {
			return 0 when count == 0 || y <= 0.0
			let same = fixed
			if !(same is none) {
				return 0 when same <= 0.0
				return int(y / same).min(count - 1)
			}
			let each = guess()
			let step = 1
			for step * 2 <= count {
				step *= 2
			}
			let row = 0
			let above = 0.0
			for step > 0 {
				let next = row + step
				if next <= count {
					let span = sums[next] + float(step - marks[next]) * each
					if above + span <= y {
						row = next
						above += span
					}
				}
				step /= 2
			}
			return row.min(count - 1)
		}
	}

	// What takes the presses on the rows of a collection.
	internal interface RowHost {
		// A button went down on row `index`.
		def rowPressed(index int, e PointerEvent) bool
		// A button went down on row `index` while it was held at an edge as a sticky
		// header: the row is brought to its place rather than picked.
		def dockedPressed(index int, e PointerEvent) bool
	}

	// Tells the collection `row` is in that a button went down on it.
	internal def pressedAbove(row component, index int, e PointerEvent, docked bool) bool {
		let above = row.parent()
		for {
			return false when above is none
			if above is RowHost {
				return above.dockedPressed(index, e) when docked
				return above.rowPressed(index, e)
			}
			above = above.parent()
		}
		return false
	}

	// The box around one row of a collection.
	internal component ListRow {
		type {
			// Which item the row shows.
			@input
			index int = 0

			@input
			@state
			selected bool = false

			// The keyboard is on the row and shows where it is.
			@input
			@state
			current bool = false

			// The height the collection gives every row; none: the content's.
			@input
			tall ?Pixels = none

			// A section header: held at the top of the rows' room once scrolled past,
			// `lift` below the top (the headers held there before it), and at the bottom
			// while its place is below the room, `stack` above the bottom (the headers
			// held there after it), drawn over the other rows.
			@input
			sticky bool = false

			@input
			lift Pixels = 0(px)

			@input
			stack Pixels = 0(px)

			// Held at an edge now, over rows that scroll under it: a press brings it to
			// its place instead of picking it.
			@input
			docked bool = false

			// The line that parts its section from what scrolls, where it has one.
			@input
			divider DividerSide = DividerSide.None

			def new() {
				role = Role.ListItem
			}

			def sized() Sizing {
				let same = tall
				return auto when same is none
				return same
			}

			def placing() Position {
				return sticky ?? (Position.Sticky, Position.Normal)
			}

			def layering() Layer {
				return sticky ?? (Layer.Floating, Layer.Content)
			}

			def anchoring() Anchors {
				return Anchors{} unless sticky
				return Anchors{top: new AnchorLine(lift), bottom: new AnchorLine(stack)}
			}

			def pointer(e PointerEvent) bool {
				return false when e.phase != PointerPhase.Down
				let me component = self
				return pressedAbove(me, index, e, docked)
			}

			def render(ctx RenderContext) {
				ctx.outerShadows()
				// Held over the rows that scroll under it, the row covers them: the
				// theme's surface across its box, under its own fills.
				ctx.draw.fill(frameBox(ctx), 0.0, themeOf(self).palette.surface) when docked
				ctx.background()
				ctx.borders()
				ctx.childNodes()
				ctx.innerShadows()
				return when divider == DividerSide.None
				let box = frameBox(ctx)
				let y = divider == DividerSide.Top ?? (0.5, box.bottom - 0.5)
				ctx.draw.stroke(new Line(new Point(0.0, y), new Point(box.right, y)), themeOf(self).palette.divider, StrokeStyle{width: 1.0(px)})
			}
		}

		view {
			children()
		}

		style {
			ListRowStyle
			height   = self.sized()
			position = self.placing()
			layer    = self.layering()
			anchors  = self.anchoring()
		}
	}

	// The room of the rows a collection does not mount, before and after those it does.
	internal component ListGap {
		type {
			@input
			height Pixels = 0(px)
		}

		view {}

		style {
			Box
			width  = fill
			height = self.height
		}
	}

	// The rows a list mounts: those from `first` up to `end`, with the room of the rows
	// before and after them.
	// What a `List` with a `persist` name keeps: the row at the top of its room and how
	// far that row's top is above the room's.
	internal struct KeptListPlace {
		row  int
		past float
	}

	internal struct ListWindow {
		first int
		end   int
		lead  Pixels
		trail Pixels
	}

	// Rows mounted beyond each end of what shows, so a small scroll and the next row the
	// keyboard goes to are there already.
	internal const listOverscan = 3

	// The height a list fills with rows on its first frame, before layout told its own.
	internal const listFirstFill = 480.0

	// Shows many items one under another and scrolls them, mounting only the rows that
	// show: `List(files) { rowRenderer = (it RowItem<File>) => FileRow(it.content) }`.
	// Items come as an array or, when they are too many or too lazy for one, as a `Source`
	// (`List(source = files)`). Without `rowRenderer` a row is the item as text.
	//
	// The selection and the row the keyboard is on are kept by each item's identity. An
	// item is its own identity as a map key is: a number, a string, an enum or a struct by
	// its value, a `type` by being that object, or by its `hash()` and `equals()` when it
	// declares them; `selected` then holds items. `id` gives another identity, such as one
	// field: `List(files, id = (f File) => f.path, selected = paths)`.
	//
	// A click selects a row; with `SelectionMode.Multiple`, Shift selects up to it and the
	// platform's command key adds or removes it. Up, Down, Home, End, Page Up and Page Down
	// move through the rows, Space selects the row the keyboard is on, Enter or a double
	// click opens it.
	component List<T, I = T> {
		type {
			// The items, when they are an array.
			@input(value = true)
			items T[] = []

			// The items, when they are not an array; `items` is then not read.
			@input
			source ?Source<T> = none

			// An item's identity; none: the item itself. A list whose ids are of another
			// type than its items must pass it.
			@input
			id ?(def(T) I) = none

			// The ids of the selected rows. The list assigns a new array when the selection
			// changes; code that changes it passes another array too.
			@input(bind = true)
			@state
			selected I[] = []

			// How many rows can be selected.
			@input
			selection SelectionMode = SelectionMode.Single

			// The height every row has; none: each row is as high as its content and is
			// measured when it is first shown.
			@input
			rowHeight ?Pixels = none

			// Draws the row of an item.
			@input
			rowRenderer ?(def(RowItem<T>) view) = none

			// Which items are section headers that never leave the view: a header whose
			// row has scrolled above the room is held at its top, one whose row is below
			// the room at its bottom, those held at an edge stacked there in row order,
			// each edge's stack within half the room (the headers nearest the room stay
			// when more would be held). A header's row reaching a stack joins it. A held
			// header draws with `rowRenderer` (`RowItem.docked`), over the rows that
			// scroll under it, which take no presses there; a press on it brings its row
			// to the top, under the headers held before it; a press on its arrow (a
			// `Tree`) opens or closes it. A line in the theme's divider colour parts each
			// header but the first from what scrolls: above the header, below the last
			// one held at the top; between two held headers there is none.
			@input
			sticky ?(def(T) bool) = none

			// Which headers draw the line that parts them from what scrolls; none: every
			// header but the first. A list divided only between groups of groups (the
			// project's files, then everything else) names the first header after them.
			@input
			divided ?(def(T) bool) = none

			// A name to keep the scroll position under between runs, inside the
			// `PersistScope`s above it (`<name>.scroll`): the row at the top and how far
			// it is scrolled into, so rows measured as they show come back to the same
			// row. Empty: not kept.
			@input
			persist string = ""

			// Runs when the selection changed, with the ids now selected.
			@input
			onChange ?(def(I[])) = none

			// Tells every listener the selection changed, after the handler ran: heard with
			// `@on(List.changed)`.
			@emit()
			def changed(ids I[]) I[] {
				return ids
			}

			// Runs when a row is opened: Enter, or a double click on it.
			@input
			onOpen ?(def(T)) = none

			// Tells every listener a row was opened, after the handler ran.
			@emit()
			def opened(item T) T {
				return item
			}

			// Which rows the user can drag, once `onMove` is set; none: every row.
			@input
			movable ?(def(T) bool) = none

			// Whether the dragged rows may go where the pointer is, asked as it moves: a
			// place refused shows no mark and takes no drop. None: every place.
			@input
			accepts ?(def(RowDrop<T>) bool) = none

			// Runs when rows dragged with the pointer are let go of on another row: with
			// the dragged rows in row order (the selection when a selected row was
			// dragged, else that row alone), the row the pointer is on and the place,
			// before or after it. The list moves nothing itself: the caller changes the
			// items. A drag near the top or bottom of the rows scrolls them. Unset: rows
			// are not dragged.
			@input
			onMove ?(def(RowDrop<T>)) = none

			// Tells every listener rows were dragged to another place, after the handler
			// ran: heard with `@on(List.moved)`.
			@emit()
			def moved(drop RowDrop<T>) RowDrop<T> {
				return drop
			}

			heights RowHeights = new RowHeights()

			// The rows `sticky` says are headers, in order; what they were found for
			// (the count and the items), and whether to find them again.
			headers      int[] = []
			headersFor   int = -1
			headersItems ?T[] = none
			headersStale bool = true

			// Whether the list said that it needs `id`.
			warned bool = false

			// The row the keyboard is on (below 0: none) and its id; the row a Shift
			// selection starts from.
			cursorAt int = -1
			// The keyboard's row's id as a set, to find the row by.
			cursorSet map<I, bool>
			cursor   ?I = none
			pivot    int = -1

			// The selection as a set, and the array it was built from with its length then.
			chosen     map<I, bool>
			chosenFrom ?I[] = none
			chosenSize int = -1

			// What the last run of the view saw: the height of the room for rows, how far
			// they were scrolled, the first row that showed and how far its top was above
			// the room's.
			seenRoom   float = 0.0
			seenOffset float = -1.0
			anchor     int = -1
			anchorPast float = 0.0
			// Whether the rows were scrolled to their end then.
			seenEnd    bool = false

			// Where the rows are to be scrolled once layout knows they reach that far;
			// below 0: nowhere.
			wanted float = -1.0

			// The place read back when it was mounted, until the rows are scrolled
			// there, and the place kept last.
			restoring ?KeptListPlace = none
			keptPlace KeptListPlace = KeptListPlace{row: -1, past: 0.0}
			// The kept place was read: from here on the place is kept.
			placeRead bool = false

			// A press on a row that can be dragged: the row, where the pointer went down
			// in the window, and whether the row was selected then with no modifier held,
			// so that the selection waits until the press ends without a drag.
			pressRow  int = -1
			pressAt   Point<Pixels> = new Point<Pixels>(0(px), 0(px))
			pressKept bool = false

			// A drag of rows: the dragged rows and their items; the row under the pointer
			// and the place against it a drop would go to (below 0: none); where the
			// pointer is, in the list; the `DropHost` above the list (a `Tree`); when the
			// drop place last changed and whether the host was told the drag rested
			// there; when the drag last scrolled the rows.
			inDrag  bool = false
			dragRows  int[] = []
			dragItems T[] = []
			dropAt    int = -1
			dropPlace RowPlace = RowPlace.Before
			dragPoint Point<Pixels> = new Point<Pixels>(0(px), 0(px))
			host      ?DropHost = none
			restAt    time.Time = time.now()
			restTold  bool = false
			stepAt    time.Time = time.now()

			// The task that waits for the source's changes, the source it waits on and
			// which of the list's sources that is, counted; the changes it took that the next run of the view reads.
			internal watcher  async none
			internal watching ?Source<T> = none
			internal turn     int = 0
			internal arrived  SourceChange[] = []
			// Whether the list is in a window's tree.
			internal mounted  bool = false

			def new() {
				role      = Role.List
				focusable = true
				tabStop   = true
			}

			// How many items there are.
			def count() int {
				let from = source
				return items.len() when from is none
				return from.count()
			}

			// The item at `index`.
			def at(index int) T {
				let from = source
				return items[index] when from is none
				return from.at(index)
			}

			// The identity of an item.
			def idOf(item T) I {
				let tell = id
				return tell(item) unless tell is none
				let own any = item
				return own when own is I
				// Every row then has the id an unset `I` holds, and two rows with one key
				// stop the program.
				warn("List: `id` is needed when the ids are not the items") unless warned
				warned = true
				let unset I
				return unset
			}

			// The id of the row the keyboard is on.
			def current() ?I {
				return cursor
			}

			// A set of one id. Ids are told apart as map keys are (a type's `hash()` and
			// `equals()` when it declares them), which `==` does not do for a type.
			def only(key I) map<I, bool> {
				let one = map<I, bool>{}
				one[key] = true
				return one
			}

			// Puts the keyboard on row `index`, whose id is `key`.
			def place(index int, key I) {
				cursorAt  = index
				cursor    = key
				cursorSet = only(key)
			}

			// Takes the keyboard off the rows.
			def lift() {
				cursorAt  = -1
				cursor    = none
				cursorSet = map<I, bool>{}
			}

			// Whether the row with this id is selected.
			def holds(key I) bool {
				return chosen.hasKey(key)
			}

			// Scrolls so the row with this id shows; an id no item has does nothing.
			def reveal(key I) {
				let index = locate(key)
				revealRow(index) when index >= 0
			}

			// Where the item with this id is; -1: nowhere.
			def locate(key I) int {
				let sought = only(key)
				let rows = count()
				for let i = 0; i < rows; i++ {
					return i when sought.hasKey(idOf(at(i)))
				}
				return -1
			}

			// The height of the room the rows show in, as laid out last.
			def room() float {
				let pane = port
				return 0.0 when pane is none
				return float(pane.style.geom.content.height)
			}

			// How far the rows are scrolled.
			def scrolledBy() float {
				let pane = port
				return 0.0 when pane is none
				return float(pane.scrollOffset().y)
			}

			// Scrolls the rows to `y` from their start, as far as the rows go. The scroll
			// view stops at the end of the rows as laid out last; when the rows have grown
			// since, the rest is `wanted` and done on the frames that follow.
			def scrollRows(y float) {
				let pane = port
				return when pane is none
				let tall = room()
				let to = tall > 0.0 ?? (y.min(heights.top(heights.count) - tall).max(0.0), y.max(0.0))
				pane.scrollTo(new Point<Pixels>(pane.scrollOffset().x, to * 1(px)))
				let now = scrolledBy()
				wanted = to - now > 0.5 ?? (to, -1.0)
				// The rows are where the list put them: nothing else scrolled.
				seenOffset = now
				anchor     = heights.count > 0 ?? (heights.at(now), -1)
				anchorPast = now - heights.top(anchor)
			}

			// Scrolls as little as shows row `index` whole, clear of the headers held at the
			// top and the bottom of the room. Those stacks change with the offset: the row
			// is put against the stack of the offset it would be at with none held, and a
			// stack never holds more over the row once the row moves away from its edge, so
			// it shows whole at the offset it ends at.
			def revealRow(index int) {
				let top = heights.top(index)
				let bottom = top + heights.height(index)
				let from = scrolledBy()
				let tall = room()
				if tall <= 0.0 {
					scrollRows(top) when top < from
				} else if top < from + heldOver(index, topHeaders(from, tall)) {
					scrollRows(top - heldOver(index, topHeaders(top, tall)))
				} else if bottom > from + tall - heldOver(index, bottomHeaders(from, tall)) {
					let to = bottom - tall
					scrollRows(to + heldOver(index, bottomHeaders(to, tall)))
				}
				redraw()
			}

			// The height of the headers held in `stack`, but for row `index` itself.
			def heldOver(index int, stack int[]) float {
				let sum = 0.0
				for let h in stack {
					sum += heights.height(h) when h != index
				}
				return sum
			}

			// Takes what the source says changed: rows that moved lose their measures, and
			// the keyboard's row follows its item.
			def follow() {
				listen()
				let from = source
				return when from is none
				for let change in taken(from) {
					headersStale = true
					match change.kind {
						case SourceChangeKind.Updated:
							heights.forget(change.at, change.count)
						case SourceChangeKind.Inserted:
							heights.reset()
							cursorAt += change.count when cursorAt >= change.at
							pivot += change.count when pivot >= change.at
						case SourceChangeKind.Removed:
							heights.reset()
							if cursorAt >= change.at + change.count {
								cursorAt -= change.count
							} else if cursorAt >= change.at {
								lift()
							}
							if pivot >= change.at + change.count {
								pivot -= change.count
							} else if pivot >= change.at {
								pivot = -1
							}
						case SourceChangeKind.Reset:
							heights.reset()
							lift()
							pivot = -1
					}
				}
			}

			// The changes of `from` not read yet, oldest first. While a task waits on the
			// source it alone receives, so that none is read out of turn; with no task
			// (the list is in no window) they are received here.
			internal def taken(from Source<T>) SourceChange[] {
				// Under the UI's state lock, as the task's store.
				__global_lock(1)
				let got = arrived
				arrived = []
				__global_unlock(1)
				return got unless watching is none
				let told = from.changes()
				for told.len() > 0 {
					got.push(<-told)
				}
				return got
			}

			// Has a task wait on the source the list has now, in place of the one that
			// waited on the source it had before.
			internal def listen() {
				let from = source
				let held = watching
				return when from is none && held is none
				return when !(from is none) && !(held is none) && from == held
				if !(held is none) {
					watcher.cancel()
					watching = none
				}
				turn++
				return when from is none || !mounted
				watching = from
				watcher  = async<tasks> hear(from, turn)
			}

			// Waits for the changes of `from` and hands each to the next frame, which runs
			// the view. A change received after the list took another source is dropped.
			internal async def hear(from Source<T>, mine int) {
				let me component = self
				for let change in from.changes() {
					__global_lock(1)
					arrived.push(change) when mine == turn
					__global_unlock(1)
					askRebuild(me)
				}
			}

			// Finds the header rows again when the items changed under them.
			def refreshHeaders() {
				let tell = sticky
				if tell is none {
					headers    = []
					headersFor = -1
					return
				}
				let from = items
				let same = headersItems
				let changed = headersStale || headersFor != count() || same is none || same != from
				return unless changed
				headers = []
				for let i = 0; i < count(); i++ {
					headers.push(i) when tell(at(i))
				}
				headersFor   = count()
				headersItems = from
				headersStale = false
			}

			// The rows to mount in order, each with the room before it: the window's,
			// and the headers outside it that are held at an edge: those held at the top
			// whose rows are above the window, those held at the bottom whose rows are
			// below it. The last mount is the room after them all, with no row (index -1).
			def mounts(shown ListWindow, above int[], below int[]) ListMount[] {
				let rows int[] = []
				for let h in above {
					rows.push(h) when h < shown.first
				}
				for let i = shown.first; i < shown.end; i++ {
					rows.push(i)
				}
				for let h in below {
					rows.push(h) when h >= shown.end
				}
				let out ListMount[] = []
				let flow = 0.0
				for let i in rows {
					out.push(ListMount{index: i, gap: heights.top(i) - flow})
					flow = heights.top(i) + heights.height(i)
				}
				out.push(ListMount{index: -1, gap: (heights.top(heights.count) - flow).max(0.0)})
				return out
			}

			// The headers held at the top of a room `tall` high scrolled `from` its start,
			// in row order: the last ones whose rows are above the room, as many as fit in
			// half of it, then each header after them whose row is behind that stack, the
			// first ones leaving when it is too tall.
			def topHeaders(from float, tall float) int[] {
				let cap = tall / 2.0
				let last = -1
				for let (k, h) in headers {
					break unless heights.top(h) < from
					last = k
				}
				let out int[] = []
				let used = 0.0
				// None above the room: `first` past `last`, so nothing is taken.
				let first = last + 1
				for let k = last; k >= 0; k-- {
					let high = heights.height(headers[k])
					break when used + high > cap && used > 0.0
					used += high
					first = k
				}
				for let k = first; k <= last; k++ {
					out.push(headers[k])
				}
				for let k = last + 1; k < headers.len(); k++ {
					let h = headers[k]
					break unless heights.top(h) < from + used
					out.push(h)
					used += heights.height(h)
					for used > cap && out.len() > 1 {
						used -= heights.height(out[0])
						out.remove(0)
					}
				}
				return out
			}

			// The headers held at the bottom of a room `tall` high scrolled `from` its
			// start, in row order: the first ones whose rows cross the bottom of the room,
			// as many as fit in half of it, then each header before them whose row crosses
			// that stack, the last ones leaving when it is too tall.
			def bottomHeaders(from float, tall float) int[] {
				let edge = from + tall
				let cap = tall / 2.0
				let first = headers.len()
				for let (k, h) in headers {
					if heights.top(h) + heights.height(h) > edge {
						first = k
						break
					}
				}
				let out int[] = []
				let used = 0.0
				for let k = first; k < headers.len(); k++ {
					let high = heights.height(headers[k])
					break when used + high > cap && out.len() > 0
					out.push(headers[k])
					used += high
				}
				let front int[] = []
				for let k = first - 1; k >= 0; k-- {
					let h = headers[k]
					break unless heights.top(h) + heights.height(h) > edge - used
					front.push(h)
					used += heights.height(h)
					for used > cap && front.len() + out.len() > 1 {
						used -= heights.height(out[out.len() - 1])
						out.remove(out.len() - 1)
					}
				}
				let all int[] = []
				for let k = front.len() - 1; k >= 0; k-- {
					all.push(front[k])
				}
				return all + out
			}

			// How far below the top a header sits: the heights of the headers held at
			// the top before it, or of all of them for one not held there.
			def liftOf(index int, above int[]) float {
				let sum = 0.0
				for let h in above {
					return sum when h == index
					sum += heights.height(h)
				}
				return sum
			}

			// How far above the bottom a header sits: the heights of the headers held at
			// the bottom after it, or of all of them for one not held there.
			def stackOf(index int, below int[]) float {
				let sum = 0.0
				let after = !below.includes(index)
				for let h in below {
					sum += heights.height(h) when after
					after = true when h == index
				}
				return sum
			}

			// The line a header draws: none for one `divided` leaves out (the first,
			// without `divided`), below the last one held at the top, above the first one
			// held at the bottom, none for the others held, above one in the room.
			def dividerOf(index int, above int[], below int[]) DividerSide {
				let tell = divided
				if tell is none {
					return DividerSide.None when headers.len() == 0 || headers[0] == index
				} else {
					return DividerSide.None unless tell(at(index))
				}
				if above.includes(index) {
					return above[above.len() - 1] == index ?? (DividerSide.Bottom, DividerSide.None)
				}
				if below.includes(index) {
					return below[0] == index ?? (DividerSide.Top, DividerSide.None)
				}
				return DividerSide.Top
			}

			// Builds the set of the selection when `selected` is another array or another
			// length than the one it was built from.
			def index() {
				let from = chosenFrom
				return when !(from is none) && from == selected && chosenSize == selected.len()
				chosen = map<I, bool>{}
				for let key in selected {
					chosen[key] = true
				}
				chosenFrom = selected
				chosenSize = selected.len()
			}

			// The lowest row among the selected ones; -1 with none.
			def firstSelected() int {
				let first = -1
				for let key in selected {
					let found = locate(key)
					first = found when found >= 0 && (first < 0 || found < first)
				}
				return first
			}

			// Finds the keyboard's row again when the items moved under it.
			def track() {
				let key = cursor
				if key is none || cursorAt < 0 {
					lift()
					return
				}
				return when cursorAt < count() && cursorSet.hasKey(idOf(at(cursorAt)))
				let found = locate(key)
				if found < 0 {
					lift()
					return
				}
				cursorAt = found
			}

			// Notes the height of each mounted row. When one differs from what the rows
			// were placed with and nothing else scrolled since, the first row that showed
			// stays where it was, and rows that were at their end stay at their end.
			def settle() {
				let pane = port
				return when pane is none
				let moved = false
				if heights.fixed is none {
					for let child in pane.childNodes {
						continue unless child is ListRow
						let tall = float(child.style.geom.frame.height)
						continue when tall <= 0.0
						moved = true when heights.measure(child.index, tall)
					}
				}
				// A scroll before the kept place was reached wins over it.
				restoring = none when seenOffset >= 0.0 && scrolledBy() != seenOffset
				let back = restoring
				if !(back is none) && back.row < heights.count {
					restoring = none
					scrollRows(heights.top(back.row) + back.past)
					return
				}
				if scrolledBy() != seenOffset {
					// Something else scrolled: that is where the rows stay.
					wanted    = -1.0
					restoring = none
					return
				}
				if moved && seenEnd {
					scrollRows(heights.top(heights.count))
				} else if moved && anchor >= 0 && wanted < 0.0 {
					scrollRows(heights.top(anchor) + anchorPast)
				} else if wanted >= 0.0 {
					scrollRows(wanted)
				}
			}

			// The rows to mount on this run of the pane.
			def window() ListWindow {
				let same = rowHeight
				heights.fixed = none
				heights.fixed = float(same) unless same is none
				follow()
				heights.resize(count())
				refreshHeaders()
				index()
				track()
				settle()
				// The rows moved under a drag: the drop place follows the pointer.
				aim(dragPoint) when inDrag

				let rows = heights.count
				let tall = room()
				seenRoom = tall
				tall     = listFirstFill when tall <= 0.0
				let from = scrolledBy()
				seenOffset = from
				let pane = port
				seenEnd = !(pane is none) && from > 0.0 && from >= float(pane.reach().y) - 0.5
				let first = heights.at(from)
				anchor     = rows > 0 ?? (first, -1)
				anchorPast = from - heights.top(first)
				keepPlace()
				let last = heights.at(from + tall)
				let start = (first - listOverscan).max(0)
				let end = (last + 1 + listOverscan).min(rows)
				let lead = heights.top(start)
				let trail = heights.top(rows) - heights.top(end)
				return ListWindow{first: start, end: end, lead: lead * 1(px), trail: trail.max(0.0) * 1(px)}
			}

			// Mounted: scrolled to the row it showed at the top when it was last kept.
			def attached() {
				mounted = true
				listen()
				return unless keepable(persist)
				placeRead = true
				let kept = restored<KeptListPlace>(placeKey(), KeptListPlace{row: -1, past: 0.0})
				restoring = kept.row >= 0 ?? (kept, none)
			}

			// Left the window: the task that waited is cancelled with `tasks`.
			def detached() {
				mounted  = false
				watching = none
			}

			internal def placeKey() string {
				return "{keptName(self, persist)}.scroll"
			}

			// Keeps the row at the top when it, or how far it is scrolled into, changed;
			// not while a kept place is still to be reached.
			internal def keepPlace() {
				return when anchor < 0 || !placeRead || !keepable(persist) || !(restoring is none) || wanted >= 0.0
				let held = keptPlace
				return when held.row == anchor && (held.past - anchorPast).abs() < 0.5
				keptPlace = KeptListPlace{row: anchor, past: anchorPast}
				keep<KeptListPlace>(placeKey(), keptPlace)
			}

			// Whether layout gave the rows another room or a row another height than the
			// view placed them with.
			def stale() bool {
				let pane = port
				return false when pane is none
				return true when (room() - seenRoom).abs() > 0.5 || wanted >= 0.0 || !(restoring is none)
				return false unless heights.fixed is none
				for let child in pane.childNodes {
					continue unless child is ListRow
					let tall = float(child.style.geom.frame.height)
					return true when tall > 0.0 && (heights.height(child.index) - tall).abs() > 0.5
				}
				return false
			}

			// Makes `ids` the selection and tells the handler and the listeners.
			def choose(ids I[]) {
				selected = ids
				index()
				let tell = onChange
				tell(ids) unless tell is none
				changed(ids)
				redraw()
			}

			// The ids of the rows from `from` to `to`, both counted.
			def idsBetween(from int, to int) I[] {
				let ids I[]
				for let i = from.min(to).max(0); i <= from.max(to) && i < count(); i++ {
					ids.push(idOf(at(i)))
				}
				return ids
			}

			// Puts the keyboard on row `index` and selects as a click or an arrow does:
			// `extend` up to it from where the last selection started, `toggle` that row
			// alone, else that row only.
			def moveTo(index int, extend bool, toggle bool) {
				return when index < 0 || index >= count()
				let key = idOf(at(index))
				place(index, key)
				match selection {
					case SelectionMode.None:
						pivot = index
					case SelectionMode.Single:
						pivot = index
						choose([key]) unless selected.len() == 1 && holds(key)
					case SelectionMode.Multiple:
						if extend && pivot >= 0 {
							choose(idsBetween(pivot, index))
						} else if toggle {
							pivot = index
							let own = only(key)
							let ids I[]
							for let held in selected {
								ids.push(held) unless own.hasKey(held)
							}
							ids.push(key) unless holds(key)
							choose(ids)
						} else {
							pivot = index
							choose([key]) unless selected.len() == 1 && holds(key)
						}
				}
				revealRow(index)
			}

			// Opens the row the keyboard is on.
			def open() {
				return when cursorAt < 0 || cursorAt >= count()
				let item = at(cursorAt)
				let tell = onOpen
				tell(item) unless tell is none
				opened(item)
			}

			// A press on a row: the primary button selects it and a second click opens it;
			// the secondary button selects a row that is not selected and leaves the press
			// to a context menu.
			// A press on a header held at an edge brings its row to the top of the room,
			// under the headers before it, which are held there then (as many as fit in
			// half the room).
			def dockedPressed(index int, e PointerEvent) bool {
				return false when disabled || e.button != MouseButton.Left
				focus()
				let cap = room() / 2.0
				let under = 0.0
				for let k = headers.len() - 1; k >= 0; k-- {
					continue unless headers[k] < index
					let high = heights.height(headers[k])
					break when under + high > cap && under > 0.0
					under += high
				}
				scrollRows(heights.top(index) - under)
				redraw()
				return true
			}

			def rowPressed(index int, e PointerEvent) bool {
				return false when disabled
				focus()
				if e.button == MouseButton.Right {
					moveTo(index, extend = false, toggle = false) unless index < count() && holds(idOf(at(index)))
					return false
				}
				return false when e.button != MouseButton.Left
				let held = e.modifiers
				let drags = draggable(index)
				// A press on a selected row that can be dragged drags the selection: it
				// selects that row alone only when the press ends without a drag.
				pressKept = drags && !held.shift && !held.mod && holds(idOf(at(index)))
				moveTo(index, extend = held.shift, toggle = held.mod) unless pressKept
				open() when e.clicks == 2
				return true unless drags
				// The press goes on up to the list, which holds the pointer for the drag:
				// the row's own box may be scrolled away while it lasts.
				pressRow = index
				pressAt  = e.windowPosition
				return false
			}

			// Whether row `index` can be dragged.
			def draggable(index int) bool {
				return false when onMove is none || index < 0 || index >= count()
				let tell = movable
				return true when tell is none
				return tell(at(index))
			}

			// The `DropHost` the list is in; none outside one.
			def hostAbove() ?DropHost {
				let above = parent()
				for {
					return none when above is none
					return above when above is DropHost
					above = above.parent()
				}
				return none
			}

			// Starts the drag of the pressed row: the selected rows when it is selected,
			// else it alone, less those `movable` refuses; no drag when none is left.
			def startDrag() {
				return unless draggable(pressRow)
				let rows int[] = []
				if holds(idOf(at(pressRow))) {
					for let i = 0; i < count(); i++ {
						rows.push(i) when holds(idOf(at(i))) && draggable(i)
					}
				} else {
					rows.push(pressRow)
				}
				return when rows.len() == 0
				dragRows  = rows
				dragItems = []
				for let i in rows {
					dragItems.push(at(i))
				}
				host   = hostAbove()
				inDrag = true
				dropAt = -1
				stepAt = time.now()
				style.cursor = Cursor.Grabbing
			}

			// Whether the dragged rows may go to `place` against row `target`: not against
			// one of them, nor where the host or `accepts` refuses.
			def allowed(target int, place RowPlace) bool {
				return false when dragRows.includes(target)
				let above = host
				return false when !(above is none) && !above.dropAllowed(dragRows, target, place)
				let ask = accepts
				return true when ask is none
				return ask(RowDrop<T>{items: dragItems, target: at(target), place: place})
			}

			// Finds where the dragged rows would go for the pointer at `at`, in the list:
			// the row there and the place against it, in thirds under a `DropHost`
			// (before, inside, after) and halves without one; inside refused falls back
			// to the nearer half, and a half refused to no place.
			def aim(at Point<Pixels>) {
				dragPoint = at
				let (was, wasPlace) = (dropAt, dropPlace)
				dropAt = -1
				let pane = port
				let rows = count()
				if !(pane is none) && rows > 0 {
					let y = float(at.y) - float(pane.style.geom.bounds.top) - float(pane.style.geom.content.top) + scrolledBy()
					let index = y >= heights.top(rows) ?? (rows - 1, heights.at(y))
					let tall = heights.height(index)
					let part = tall > 0.0 ?? (((y - heights.top(index)) / tall).max(0.0).min(1.0), 1.0)
					let near = part < 0.5 ?? (RowPlace.Before, RowPlace.After)
					if !(host is none) && part >= 1.0 / 3.0 && part < 2.0 / 3.0 && allowed(index, RowPlace.Inside) {
						dropAt    = index
						dropPlace = RowPlace.Inside
					} else if allowed(index, near) {
						dropAt    = index
						dropPlace = near
					}
				}
				return when dropAt == was && dropPlace == wasPlace
				restAt   = time.now()
				restTold = false
				redraw()
			}

			// Ends the drag; with `drop`, the rows go where the pointer is when there is
			// a place for them there.
			def endDrag(drop bool) {
				let (index, place) = (dropAt, dropPlace)
				let taken = dragItems
				inDrag    = false
				dragRows  = []
				dragItems = []
				dropAt    = -1
				host      = none
				style.cursor = none
				redraw()
				return when !drop || index < 0 || index >= count()
				let told = RowDrop<T>{items: taken, target: at(index), place: place}
				let tell = onMove
				tell(told) unless tell is none
				moved(told)
			}

			// The pointer after a press on a row that can be dragged: the list holds it;
			// a move past the slack starts the drag, which follows the pointer; let go of,
			// the rows are dropped, or the pressed row is selected alone when it was
			// selected and nothing was dragged.
			def pointer(e PointerEvent) bool {
				return false when pressRow < 0
				match e.phase {
					case PointerPhase.Down:
						e.capture()
						return true
					case PointerPhase.Move:
						if !inDrag {
							let (dx, dy) = (float(e.windowPosition.x) - float(pressAt.x), float(e.windowPosition.y) - float(pressAt.y))
							return true when dx * dx + dy * dy < dragSlack * dragSlack
							startDrag()
							return true unless inDrag
						}
						aim(e.position)
						return true
					case PointerPhase.Up:
						let index = pressRow
						let kept = pressKept && !inDrag
						pressRow  = -1
						pressKept = false
						endDrag(e.button == MouseButton.Left) when inDrag
						moveTo(index, extend = false, toggle = false) when kept
						return true
					case PointerPhase.Cancel:
						pressRow  = -1
						pressKept = false
						endDrag(false) when inDrag
						return true
					default:
						return false
				}
			}

			// A step of a drag at `now`: rows near an edge of their room scroll by
			// `rowDragStep` every `rowDragTick`, and the host is told once when the drag
			// rested `rowDragRest` on a row with the drop inside it. Asks to be drawn
			// again when the next step is due.
			def tick(now time.Time) {
				return unless inDrag
				let pane = port
				return when pane is none
				let top = float(pane.style.geom.bounds.top) + float(pane.style.geom.content.top)
				let bottom = top + float(pane.style.geom.content.height)
				let y = float(dragPoint.y)
				let from = scrolledBy()
				let most = (heights.top(heights.count) - room()).max(0.0)
				let step = 0.0
				step = -rowDragStep when y < top + rowDragEdge && from > 0.0
				step = rowDragStep when y > bottom - rowDragEdge && from < most
				if step != 0.0 {
					if now.since(stepAt) >= rowDragTick {
						stepAt = now
						scrollRows(from + step)
						aim(dragPoint)
						askFrame(true)
					} else {
						redrawBy(stepAt + rowDragTick)
					}
				}
				let above = host
				return when above is none || dropAt < 0 || dropPlace != RowPlace.Inside || restTold
				if now.since(restAt) >= rowDragRest {
					restTold = true
					above.dragRested(dropAt)
				} else {
					redrawBy(restAt + rowDragRest)
				}
			}

			// The mark of where the dragged rows would go: a line in the accent colour
			// along the edge of the row they go before or after, from where the row's
			// content starts, or a ring inside the row they go into.
			def drawDrop(ctx RenderContext) {
				return when dropAt < 0
				let pane = port
				return when pane is none
				let look = themeOf(self)
				let thick = float(look.metrics.focusWidth)
				let (outer, inner) = (pane.style.geom.bounds, pane.style.geom.content)
				let left = float(outer.left) + float(inner.left)
				let top = float(outer.top) + float(inner.top)
				let right = left + float(inner.width)
				let rowTop = top + heights.top(dropAt) - scrolledBy()
				let rowBottom = rowTop + heights.height(dropAt)
				let above = host
				let lead = 0.0
				lead = above.dropLead(dropAt) unless above is none
				ctx.draw.save()
				ctx.draw.clip(Rect{left: left, top: top, right: right, bottom: top + float(inner.height)})
				if dropPlace == RowPlace.Inside {
					let half = thick / 2.0
					ctx.draw.stroke(Rect{left: left + half, top: rowTop + half, right: right - half, bottom: rowBottom - half}, look.palette.accent, StrokeStyle{width: thick * 1(px)})
				} else {
					let y = dropPlace == RowPlace.Before ?? (rowTop, rowBottom)
					let (from, to) = ctx.direction == Direction.RightToLeft ?? ((left, right - lead), (left + lead, right))
					ctx.draw.fill(Rect{left: from, top: y - thick / 2.0, right: to, bottom: y + thick / 2.0}, look.palette.accent)
				}
				ctx.draw.restore()
			}

			// The row a page away from the keyboard's row, toward the end or the start.
			def paged(forward bool) int {
				let tall = room()
				let here = cursorAt.max(0)
				let edge = heights.top(here) + (forward ?? (tall, -tall))
				let to = heights.at(edge)
				return forward ?? (to.max(here + 1).min(count() - 1), to.min(here - 1).max(0))
			}

			def key(e KeyEvent) bool {
				return false when !e.down || disabled
				let rows = count()
				return false when rows == 0
				// With no row of its own yet, the keyboard starts from the first
				// selected row, as a list given its selection has it.
				if cursorAt < 0 {
					let first = firstSelected()
					place(first, idOf(at(first))) when first >= 0
				}
				let held = e.modifiers
				let to = -1
				match e.key {
					case Key.Up:
						to = cursorAt < 0 ?? (rows - 1, (cursorAt - 1).max(0))
					case Key.Down:
						to = (cursorAt + 1).min(rows - 1)
					case Key.Home:
						to = 0
					case Key.End:
						to = rows - 1
					case Key.PageUp:
						to = paged(false)
					case Key.PageDown:
						to = paged(true)
					case Key.Space:
						return false when cursorAt < 0
						moveTo(cursorAt, extend = held.shift, toggle = held.mod)
						return true
					case Key.Enter, Key.KeypadEnter:
						return false when cursorAt < 0
						open()
						return true
					case Key.Escape:
						return false unless inDrag
						pressRow  = -1
						pressKept = false
						endDrag(false)
						return true
					case Key.A:
						return false when !held.mod || selection != SelectionMode.Multiple
						pivot = 0
						choose(idsBetween(0, rows - 1))
						return true
					default:
						return false
				}
				if held.mod && !held.shift {
					// The keyboard's row moves alone; Space then selects it.
					place(to, idOf(at(to)))
					revealRow(to)
					return true
				}
				moveTo(to, extend = held.shift, toggle = false)
				return true
			}

			def render(ctx RenderContext) {
				ctx.outerShadows()
				ctx.background()
				ctx.borders()
				ctx.childNodes()
				ctx.innerShadows()
				drawDrop(ctx)
				tick(time.now())
				// Layout told the rows' room and heights after the view placed them.
				askFrame(true) when stale()
			}
		}

		view {
			let shown = window()
			let above = topHeaders(seenOffset, seenRoom)
			let below = bottomHeaders(seenOffset, seenRoom)
			ScrollView(ref = port) {
				for let (k, m) in mounts(shown, above, below) {
					// The room before the first row and after the last is always a
					// part, so the rows are the parts between.
					if k == 0 || m.index < 0 || m.gap > 0.5 {
						ListGap(height = m.gap * 1(px))
					}
					if m.index >= 0 {
						let i = m.index
						let item = at(i)
						let key = idOf(item)
						let picked = holds(key)
						let here = i == cursorAt
						let header = headers.includes(i)
						let held = header && (above.includes(i) || below.includes(i))
						ListRow(index = i, selected = picked, current = here && focusVisible, tall = rowHeight, key = key, sticky = header, lift = (header ?? (liftOf(i, above), 0.0)) * 1(px), stack = (header ?? (stackOf(i, below), 0.0)) * 1(px), docked = held, divider = header ?? (dividerOf(i, above, below), DividerSide.None)) {
							let make = rowRenderer
							if make is none {
								Text("{item}")
							} else {
								make(RowItem<T>{content: item, index: i, selected: picked, current: here, docked: held})
							}
						}
					}
				}
			}
		}

		style ListStyle
	}
}
