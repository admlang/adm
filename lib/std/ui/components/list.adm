partial module std.ui.components {
	use (
		std.math.geom::Point
		std.services.vault.kept::(keep, keepable, restored)
		std.ui::(Key, KeyEvent, MouseButton, PointerEvent, PointerPhase, RenderContext)
		std.ui.frames::askFrame
		std.ui.runtime::warn
		std.ui.styles::*
		std.units::Pixels
	)

	// What a list hands the function that draws a row.
	struct RowItem<T> {
		// The item of the row and where it is among the items.
		content  T
		index    int
		// Whether the row is selected, and whether the keyboard is on it.
		selected bool
		current  bool
		// In a `Tree`: how many nodes are above the row's, and whether its children show.
		depth    int
		expanded bool
	}

	// Items too many or too lazy for an array: `List(source = files)`.
	interface Source<T> {
		// How many items there are now.
		def count() int
		// The item at `index`, from 0.
		def at(index int) T
		// What changed since the list last looked; the list reads it on each frame and
		// never waits on it. The source sends with `offer` and asks for a frame.
		def changes() channel<SourceChange>
	}

	// What a change of a `Source` did.
	enum SourceChangeKind {
		// `count` items were added before the item that was at `at`.
		Inserted,
		// `count` items from `at` on are gone.
		Removed,
		// `count` items from `at` on are other items or look different.
		Updated,
		// Everything may be different.
		Reset,
	}

	// One change of a `Source`.
	struct SourceChange {
		kind  SourceChangeKind
		at    int
		count int
	}

	// How many rows of a collection can be selected.
	enum SelectionMode {
		None,
		Single,
		Multiple,
	}

	// The style of a `List`.
	style ListStyle {
		Box
		Layout
		Background
		width = fill
		height = fill
	}

	// The style of the box a list puts around each row: the theme's hover fill under the
	// pointer, its selection fill while the row is selected, and a ring in the focus colour
	// inside the row the keyboard is on.
	style ListRowStyle {
		Box
		Layout
		Background
		Outline
		width = fill
		on = {
			hover:    {background: overlayFill(theme.palette.hover)},
			selected: {background: new BackgroundFill(theme.palette.selection)},
			current:  {outline: Ring{width: theme.metrics.focusWidth, paint: theme.palette.focus, offset: 0(px) - theme.metrics.focusWidth}},
		}
	}

	// The heights of the rows of a virtualised collection: one height for all of them, or
	// what each row measured, with the average of those for a row not seen yet. Sums over
	// the measured rows are kept in two Fenwick trees (heights, and how many are measured),
	// so the top of a row and the row at an offset cost O(log n).
	internal type RowHeights {
		// The height every row has; none: measured.
		fixed    ?float  = none
		count    int
		// Each row's measured height; below 0: not measured.
		known    float[]
		sums     float[]
		marks    int[]
		// The measured rows: the sum of their heights and how many they are.
		measured float
		seen     int

		// The height of a row nothing measured.
		def guess() float {
			return seen > 0 ?? (measured / float(seen), 32.0)
		}

		// Forgets every measure.
		def reset() {
			let rows = count
			resize(0)
			resize(rows)
		}

		// Follows the number of rows: rows added at the end are not measured, those past
		// the end are forgotten.
		def resize(rows int) {
			return when rows == count
			if rows < count {
				for let i = rows; i < count; i++ {
					continue when known[i] < 0.0
					measured -= known[i]
					seen--
				}
				known.len(rows)
				// A prefix of a Fenwick tree is the tree of the prefix.
				sums.len(rows + 1)
				marks.len(rows + 1)
				count = rows
				return
			}
			sums.push(0.0) when sums.len() == 0
			marks.push(0) when marks.len() == 0
			for let i = count; i < rows; i++ {
				known.push(-1.0)
				sums.push(0.0)
				marks.push(0)
			}
			count = rows
		}

		// Notes what row `index` measured; whether that is another height than it had.
		def measure(index int, height float) bool {
			return false when index < 0 || index >= count || !(fixed is none)
			let before = known[index]
			return false when before >= 0.0 && (before - height).abs() < 0.01
			let delta = before < 0.0 ?? (height, height - before)
			if before < 0.0 {
				seen++
			}
			measured += delta
			known[index] = height
			for let i = index + 1; i <= count; i += i & -i {
				sums[i] += delta
				marks[i]++ when before < 0.0
			}
			return true
		}

		// Forgets what `rows` rows from `from` on measured.
		def forget(from int, rows int) {
			for let index = from.max(0); index < (from + rows).min(count); index++ {
				let before = known[index]
				continue when before < 0.0
				known[index] = -1.0
				measured -= before
				seen--
				for let i = index + 1; i <= count; i += i & -i {
					sums[i] -= before
					marks[i]--
				}
			}
		}

		// The height of one row.
		def height(index int) float {
			let same = fixed
			return same unless same is none
			return guess() when index < 0 || index >= count || known[index] < 0.0
			return known[index]
		}

		// How far the top of row `index` is from the top of the first; with `count`, the
		// height of all the rows.
		def top(index int) float {
			let rows = index.max(0).min(count)
			let same = fixed
			return same * float(rows) unless same is none
			let sum = 0.0
			let counted = 0
			for let i = rows; i > 0; i -= i & -i {
				sum += sums[i]
				counted += marks[i]
			}
			return sum + float(rows - counted) * guess()
		}

		// The row that holds the offset `y` from the top of the first; the last row when
		// `y` is past the end, 0 when there are no rows.
		def at(y float) int {
			return 0 when count == 0 || y <= 0.0
			let same = fixed
			if !(same is none) {
				return 0 when same <= 0.0
				return int(y / same).min(count - 1)
			}
			let each = guess()
			let step = 1
			for step * 2 <= count {
				step *= 2
			}
			let row = 0
			let above = 0.0
			for step > 0 {
				let next = row + step
				if next <= count {
					let span = sums[next] + float(step - marks[next]) * each
					if above + span <= y {
						row = next
						above += span
					}
				}
				step /= 2
			}
			return row.min(count - 1)
		}
	}

	// What takes the presses on the rows of a collection.
	internal interface RowHost {
		// A button went down on row `index`.
		def rowPressed(index int, e PointerEvent) bool
	}

	// Tells the collection `row` is in that a button went down on it.
	internal def pressedAbove(row component, index int, e PointerEvent) bool {
		let above = row.parent()
		for {
			return false when above is none
			return above.rowPressed(index, e) when above is RowHost
			above = above.parent()
		}
		return false
	}

	// The box around one row of a collection.
	internal component ListRow {
		type {
			// Which item the row shows.
			@input
			index int = 0

			@input
			@state
			selected bool = false

			// The keyboard is on the row and shows where it is.
			@input
			@state
			current bool = false

			// The height the collection gives every row; none: the content's.
			@input
			tall ?Pixels = none

			def new() {
				role = Role.ListItem
			}

			def sized() Sizing {
				let same = tall
				return auto when same is none
				return same
			}

			def pointer(e PointerEvent) bool {
				return false when e.phase != PointerPhase.Down
				let me component = self
				return pressedAbove(me, index, e)
			}
		}

		view {
			children()
		}

		style {
			ListRowStyle
			height = self.sized()
		}
	}

	// The room of the rows a collection does not mount, before and after those it does.
	internal component ListGap {
		type {
			@input
			height Pixels = 0(px)
		}

		view {}

		style {
			Box
			width  = fill
			height = self.height
		}
	}

	// The rows a list mounts: those from `first` up to `end`, with the room of the rows
	// before and after them.
	// What a `List` with a `persist` name keeps: the row at the top of its room and how
	// far that row's top is above the room's.
	internal struct KeptListPlace {
		row  int
		past float
	}

	internal struct ListWindow {
		first int
		end   int
		lead  Pixels
		trail Pixels
	}

	// Rows mounted beyond each end of what shows, so a small scroll and the next row the
	// keyboard goes to are there already.
	internal const listOverscan = 3

	// The height a list fills with rows on its first frame, before layout told its own.
	internal const listFirstFill = 480.0

	// Shows many items one under another and scrolls them, mounting only the rows that
	// show: `List(files) { rowRenderer = (it RowItem<File>) => FileRow(it.content) }`.
	// Items come as an array or, when they are too many or too lazy for one, as a `Source`
	// (`List(source = files)`). Without `rowRenderer` a row is the item as text.
	//
	// The selection and the row the keyboard is on are kept by each item's identity. An
	// item is its own identity as a map key is: a number, a string, an enum or a struct by
	// its value, a `type` by being that object, or by its `hash()` and `equals()` when it
	// declares them; `selected` then holds items. `id` gives another identity, such as one
	// field: `List(files, id = (f File) => f.path, selected = paths)`.
	//
	// A click selects a row; with `SelectionMode.Multiple`, Shift selects up to it and the
	// platform's command key adds or removes it. Up, Down, Home, End, Page Up and Page Down
	// move through the rows, Space selects the row the keyboard is on, Enter or a double
	// click opens it.
	component List<T, I = T> {
		type {
			// The items, when they are an array.
			@input(value = true)
			items T[] = []

			// The items, when they are not an array; `items` is then not read.
			@input
			source ?Source<T> = none

			// An item's identity; none: the item itself. A list whose ids are of another
			// type than its items must pass it.
			@input
			id ?(def(T) I) = none

			// The ids of the selected rows. The list assigns a new array when the selection
			// changes; code that changes it passes another array too.
			@input(bind = true)
			@state
			selected I[] = []

			// How many rows can be selected.
			@input
			selection SelectionMode = SelectionMode.Single

			// The height every row has; none: each row is as high as its content and is
			// measured when it is first shown.
			@input
			rowHeight ?Pixels = none

			// Draws the row of an item.
			@input
			rowRenderer ?(def(RowItem<T>) view) = none

			// A name to keep the scroll position under between runs, inside the
			// `PersistScope`s above it (`<name>.scroll`): the row at the top and how far
			// it is scrolled into, so rows measured as they show come back to the same
			// row. Empty: not kept.
			@input
			persist string = ""

			// Runs when the selection changed, with the ids now selected.
			@input
			onChange ?(def(I[])) = none

			// Tells every listener the selection changed, after the handler ran: heard with
			// `@on(List.changed)`.
			@emit()
			def changed(ids I[]) I[] {
				return ids
			}

			// Runs when a row is opened: Enter, or a double click on it.
			@input
			onOpen ?(def(T)) = none

			// Tells every listener a row was opened, after the handler ran.
			@emit()
			def opened(item T) T {
				return item
			}

			heights RowHeights = new RowHeights()

			// Whether the list said that it needs `id`.
			warned bool = false

			// The row the keyboard is on (below 0: none) and its id; the row a Shift
			// selection starts from.
			cursorAt int = -1
			// The keyboard's row's id as a set, to find the row by.
			cursorSet map<I, bool>
			cursor   ?I = none
			pivot    int = -1

			// The selection as a set, and the array it was built from with its length then.
			chosen     map<I, bool>
			chosenFrom ?I[] = none
			chosenSize int = -1

			// What the last run of the view saw: the height of the room for rows, how far
			// they were scrolled, the first row that showed and how far its top was above
			// the room's.
			seenRoom   float = 0.0
			seenOffset float = -1.0
			anchor     int = -1
			anchorPast float = 0.0
			// Whether the rows were scrolled to their end then.
			seenEnd    bool = false

			// Where the rows are to be scrolled once layout knows they reach that far;
			// below 0: nowhere.
			wanted float = -1.0

			// The place read back when it was mounted, until the rows are scrolled
			// there, and the place kept last.
			restoring ?KeptListPlace = none
			keptPlace KeptListPlace = KeptListPlace{row: -1, past: 0.0}
			// The kept place was read: from here on the place is kept.
			placeRead bool = false

			def new() {
				role      = Role.List
				focusable = true
				tabStop   = true
			}

			// How many items there are.
			def count() int {
				let from = source
				return items.len() when from is none
				return from.count()
			}

			// The item at `index`.
			def at(index int) T {
				let from = source
				return items[index] when from is none
				return from.at(index)
			}

			// The identity of an item.
			def idOf(item T) I {
				let tell = id
				return tell(item) unless tell is none
				let own any = item
				return own when own is I
				// Every row then has the id an unset `I` holds, and two rows with one key
				// stop the program.
				warn("List: `id` is needed when the ids are not the items") unless warned
				warned = true
				let unset I
				return unset
			}

			// The id of the row the keyboard is on.
			def current() ?I {
				return cursor
			}

			// A set of one id. Ids are told apart as map keys are (a type's `hash()` and
			// `equals()` when it declares them), which `==` does not do for a type.
			def only(key I) map<I, bool> {
				let one = map<I, bool>{}
				one[key] = true
				return one
			}

			// Puts the keyboard on row `index`, whose id is `key`.
			def place(index int, key I) {
				cursorAt  = index
				cursor    = key
				cursorSet = only(key)
			}

			// Takes the keyboard off the rows.
			def lift() {
				cursorAt  = -1
				cursor    = none
				cursorSet = map<I, bool>{}
			}

			// Whether the row with this id is selected.
			def holds(key I) bool {
				return chosen.hasKey(key)
			}

			// Scrolls so the row with this id shows; an id no item has does nothing.
			def reveal(key I) {
				let index = locate(key)
				revealRow(index) when index >= 0
			}

			// Where the item with this id is; -1: nowhere.
			def locate(key I) int {
				let sought = only(key)
				let rows = count()
				for let i = 0; i < rows; i++ {
					return i when sought.hasKey(idOf(at(i)))
				}
				return -1
			}

			// The height of the room the rows show in, as laid out last.
			def room() float {
				let pane = port
				return 0.0 when pane is none
				return float(pane.style.geom.content.height)
			}

			// How far the rows are scrolled.
			def scrolledBy() float {
				let pane = port
				return 0.0 when pane is none
				return float(pane.scrollOffset().y)
			}

			// Scrolls the rows to `y` from their start, as far as the rows go. The scroll
			// view stops at the end of the rows as laid out last; when the rows have grown
			// since, the rest is `wanted` and done on the frames that follow.
			def scrollRows(y float) {
				let pane = port
				return when pane is none
				let tall = room()
				let to = tall > 0.0 ?? (y.min(heights.top(heights.count) - tall).max(0.0), y.max(0.0))
				pane.scrollTo(new Point<Pixels>(pane.scrollOffset().x, to * 1(px)))
				let now = scrolledBy()
				wanted = to - now > 0.5 ?? (to, -1.0)
				// The rows are where the list put them: nothing else scrolled.
				seenOffset = now
				anchor     = heights.count > 0 ?? (heights.at(now), -1)
				anchorPast = now - heights.top(anchor)
			}

			// Scrolls as little as shows row `index` whole.
			def revealRow(index int) {
				let top = heights.top(index)
				let bottom = top + heights.height(index)
				let from = scrolledBy()
				let tall = room()
				if top < from {
					scrollRows(top)
				} else if bottom > from + tall && tall > 0.0 {
					scrollRows(bottom - tall)
				}
				askFrame(true)
			}

			// Takes what the source says changed: rows that moved lose their measures, and
			// the keyboard's row follows its item.
			def follow() {
				let from = source
				return when from is none
				let told = from.changes()
				for told.len() > 0 {
					let change = <-told
					match change.kind {
						case SourceChangeKind.Updated:
							heights.forget(change.at, change.count)
						case SourceChangeKind.Inserted:
							heights.reset()
							cursorAt += change.count when cursorAt >= change.at
							pivot += change.count when pivot >= change.at
						case SourceChangeKind.Removed:
							heights.reset()
							if cursorAt >= change.at + change.count {
								cursorAt -= change.count
							} else if cursorAt >= change.at {
								lift()
							}
							if pivot >= change.at + change.count {
								pivot -= change.count
							} else if pivot >= change.at {
								pivot = -1
							}
						case SourceChangeKind.Reset:
							heights.reset()
							lift()
							pivot = -1
					}
				}
			}

			// Builds the set of the selection when `selected` is another array or another
			// length than the one it was built from.
			def index() {
				let from = chosenFrom
				return when !(from is none) && from == selected && chosenSize == selected.len()
				chosen = map<I, bool>{}
				for let key in selected {
					chosen[key] = true
				}
				chosenFrom = selected
				chosenSize = selected.len()
			}

			// Finds the keyboard's row again when the items moved under it.
			def track() {
				let key = cursor
				if key is none || cursorAt < 0 {
					lift()
					return
				}
				return when cursorAt < count() && cursorSet.hasKey(idOf(at(cursorAt)))
				let found = locate(key)
				if found < 0 {
					lift()
					return
				}
				cursorAt = found
			}

			// Notes the height of each mounted row. When one differs from what the rows
			// were placed with and nothing else scrolled since, the first row that showed
			// stays where it was, and rows that were at their end stay at their end.
			def settle() {
				let pane = port
				return when pane is none
				let moved = false
				if heights.fixed is none {
					for let child in pane.childNodes {
						continue unless child is ListRow
						let tall = float(child.style.geom.frame.height)
						continue when tall <= 0.0
						moved = true when heights.measure(child.index, tall)
					}
				}
				// A scroll before the kept place was reached wins over it.
				restoring = none when seenOffset >= 0.0 && scrolledBy() != seenOffset
				let back = restoring
				if !(back is none) && back.row < heights.count {
					restoring = none
					scrollRows(heights.top(back.row) + back.past)
					return
				}
				if scrolledBy() != seenOffset {
					// Something else scrolled: that is where the rows stay.
					wanted    = -1.0
					restoring = none
					return
				}
				if moved && seenEnd {
					scrollRows(heights.top(heights.count))
				} else if moved && anchor >= 0 && wanted < 0.0 {
					scrollRows(heights.top(anchor) + anchorPast)
				} else if wanted >= 0.0 {
					scrollRows(wanted)
				}
			}

			// The rows to mount on this run of the pane.
			def window() ListWindow {
				let same = rowHeight
				heights.fixed = none
				heights.fixed = float(same) unless same is none
				follow()
				heights.resize(count())
				index()
				track()
				settle()

				let rows = heights.count
				let tall = room()
				seenRoom = tall
				tall     = listFirstFill when tall <= 0.0
				let from = scrolledBy()
				seenOffset = from
				let pane = port
				seenEnd = !(pane is none) && from > 0.0 && from >= float(pane.reach().y) - 0.5
				let first = heights.at(from)
				anchor     = rows > 0 ?? (first, -1)
				anchorPast = from - heights.top(first)
				keepPlace()
				let last = heights.at(from + tall)
				let start = (first - listOverscan).max(0)
				let end = (last + 1 + listOverscan).min(rows)
				let lead = heights.top(start)
				let trail = heights.top(rows) - heights.top(end)
				return ListWindow{first: start, end: end, lead: lead * 1(px), trail: trail.max(0.0) * 1(px)}
			}

			// Mounted: scrolled to the row it showed at the top when it was last kept.
			def attached() {
				return unless keepable(persist)
				placeRead = true
				let kept = restored<KeptListPlace>(placeKey(), KeptListPlace{row: -1, past: 0.0})
				restoring = kept.row >= 0 ?? (kept, none)
			}

			internal def placeKey() string {
				return "{keptName(self, persist)}.scroll"
			}

			// Keeps the row at the top when it, or how far it is scrolled into, changed;
			// not while a kept place is still to be reached.
			internal def keepPlace() {
				return when anchor < 0 || !placeRead || !keepable(persist) || !(restoring is none) || wanted >= 0.0
				let held = keptPlace
				return when held.row == anchor && (held.past - anchorPast).abs() < 0.5
				keptPlace = KeptListPlace{row: anchor, past: anchorPast}
				keep<KeptListPlace>(placeKey(), keptPlace)
			}

			// Whether layout gave the rows another room or a row another height than the
			// view placed them with.
			def stale() bool {
				let pane = port
				return false when pane is none
				return true when (room() - seenRoom).abs() > 0.5 || wanted >= 0.0 || !(restoring is none)
				return false unless heights.fixed is none
				for let child in pane.childNodes {
					continue unless child is ListRow
					let tall = float(child.style.geom.frame.height)
					return true when tall > 0.0 && (heights.height(child.index) - tall).abs() > 0.5
				}
				return false
			}

			// Makes `ids` the selection and tells the handler and the listeners.
			def choose(ids I[]) {
				selected = ids
				index()
				let tell = onChange
				tell(ids) unless tell is none
				changed(ids)
				askFrame(true)
			}

			// The ids of the rows from `from` to `to`, both counted.
			def idsBetween(from int, to int) I[] {
				let ids I[]
				for let i = from.min(to).max(0); i <= from.max(to) && i < count(); i++ {
					ids.push(idOf(at(i)))
				}
				return ids
			}

			// Puts the keyboard on row `index` and selects as a click or an arrow does:
			// `extend` up to it from where the last selection started, `toggle` that row
			// alone, else that row only.
			def moveTo(index int, extend bool, toggle bool) {
				return when index < 0 || index >= count()
				let key = idOf(at(index))
				place(index, key)
				match selection {
					case SelectionMode.None:
						pivot = index
					case SelectionMode.Single:
						pivot = index
						choose([key]) unless selected.len() == 1 && holds(key)
					case SelectionMode.Multiple:
						if extend && pivot >= 0 {
							choose(idsBetween(pivot, index))
						} else if toggle {
							pivot = index
							let own = only(key)
							let ids I[]
							for let held in selected {
								ids.push(held) unless own.hasKey(held)
							}
							ids.push(key) unless holds(key)
							choose(ids)
						} else {
							pivot = index
							choose([key]) unless selected.len() == 1 && holds(key)
						}
				}
				revealRow(index)
			}

			// Opens the row the keyboard is on.
			def open() {
				return when cursorAt < 0 || cursorAt >= count()
				let item = at(cursorAt)
				let tell = onOpen
				tell(item) unless tell is none
				opened(item)
			}

			// A press on a row: the primary button selects it and a second click opens it;
			// the secondary button selects a row that is not selected and leaves the press
			// to a context menu.
			def rowPressed(index int, e PointerEvent) bool {
				return false when disabled
				focus()
				if e.button == MouseButton.Right {
					moveTo(index, extend = false, toggle = false) unless index < count() && holds(idOf(at(index)))
					return false
				}
				return false when e.button != MouseButton.Left
				moveTo(index, extend = e.modifiers.shift, toggle = e.modifiers.mod)
				open() when e.clicks == 2
				return true
			}

			// The row a page away from the keyboard's row, toward the end or the start.
			def paged(forward bool) int {
				let tall = room()
				let here = cursorAt.max(0)
				let edge = heights.top(here) + (forward ?? (tall, -tall))
				let to = heights.at(edge)
				return forward ?? (to.max(here + 1).min(count() - 1), to.min(here - 1).max(0))
			}

			def key(e KeyEvent) bool {
				return false when !e.down || disabled
				let rows = count()
				return false when rows == 0
				let held = e.modifiers
				let to = -1
				match e.key {
					case Key.Up:
						to = cursorAt < 0 ?? (rows - 1, (cursorAt - 1).max(0))
					case Key.Down:
						to = (cursorAt + 1).min(rows - 1)
					case Key.Home:
						to = 0
					case Key.End:
						to = rows - 1
					case Key.PageUp:
						to = paged(false)
					case Key.PageDown:
						to = paged(true)
					case Key.Space:
						return false when cursorAt < 0
						moveTo(cursorAt, extend = held.shift, toggle = held.mod)
						return true
					case Key.Enter, Key.KeypadEnter:
						return false when cursorAt < 0
						open()
						return true
					case Key.A:
						return false when !held.mod || selection != SelectionMode.Multiple
						pivot = 0
						choose(idsBetween(0, rows - 1))
						return true
					default:
						return false
				}
				if held.mod && !held.shift {
					// The keyboard's row moves alone; Space then selects it.
					place(to, idOf(at(to)))
					revealRow(to)
					return true
				}
				moveTo(to, extend = held.shift, toggle = false)
				return true
			}

			def render(ctx RenderContext) {
				ctx.outerShadows()
				ctx.background()
				ctx.borders()
				ctx.childNodes()
				ctx.innerShadows()
				// Layout told the rows' room and heights after the view placed them.
				askFrame(true) when stale()
			}
		}

		view {
			let shown = window()
			ScrollView(ref = port) {
				ListGap(height = shown.lead)
				for let i = shown.first; i < shown.end; i++ {
					let item = at(i)
					let key = idOf(item)
					let picked = holds(key)
					let here = i == cursorAt
					ListRow(index = i, selected = picked, current = here && focusVisible, tall = rowHeight, key = key) {
						let make = rowRenderer
						if make is none {
							Text("{item}")
						} else {
							make(RowItem<T>{content: item, index: i, selected: picked, current: here})
						}
					}
				}
				ListGap(height = shown.trail)
			}
		}

		style ListStyle
	}
}
