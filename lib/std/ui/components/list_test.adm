partial module std.ui.components {
	use (
		std.math.geom::(Point, Size)
		std.testing
		std.ui::(Key, KeyEvent, Modifiers, PointerPhase)
		std.ui.runtime::Scene
		std.ui.styles::*
		std.units::Pixels
	)

	internal let listLog = string[]

	// Ten thousand numbers in rows 20 high, in a room for five of them.
	component NumbersPage {
		type {
			@bindable
			picked int[] = []

			numbers int[] = []

			def new() {
				style.width = 200(px)
				style.height = 100(px)
				for let i = 0; i < 10000; i++ {
					numbers.push(i)
				}
			}

			def noted(ids int[]) {
				listLog.push("selected {ids.len()}")
			}

			def shown(number int) {
				listLog.push("opened {number}")
			}
		}

		view {
			List(numbers, rowHeight = 20(px), selected = picked, selection = SelectionMode.Multiple, onChange = noted, onOpen = shown, ref = list)
		}

		style StageStyle
	}

	// A row as high as it is told.
	component TallRow {
		type {
			@input
			tall float = 20.0
		}

		view {}

		style {
			Box
			width  = fill
			height = self.tall * 1(px)
		}
	}

	// A thousand rows 10, 20 and 30 high in turn, measured as they show.
	component UnevenPage {
		type {
			numbers int[] = []

			def new() {
				style.width = 200(px)
				style.height = 100(px)
				for let i = 0; i < 1000; i++ {
					numbers.push(i)
				}
			}
		}

		view {
			List(numbers, ref = list) {
				rowRenderer = (it RowItem<int>) => TallRow(tall = 10.0 + float(it.content % 3) * 10.0)
			}
		}

		style StageStyle
	}

	// Names: each is its own identity, so the selection holds names.
	component NamesPage {
		type {
			@bindable
			picked string[] = []

			names string[] = ["ada", "bob", "cy"]

			def new() {
				style.width = 200(px)
				style.height = 100(px)
			}
		}

		view {
			List(names, rowHeight = 20(px), selected = picked, ref = list)
		}

		style StageStyle
	}

	// A document that is told from another by being that object.
	type Paper {
		path  string = ""
		title string = ""

		def new(path string, title string) {
			self.path = path
			self.title = title
		}
	}

	// A label that is the same label as another with the same text.
	type Label2 {
		text string = ""

		def new(text string) {
			self.text = text
		}

		def hash() uint64 {
			return new KeyHasher().add(text).sum()
		}

		def equals(other Label2) bool {
			return text == other.text
		}
	}

	// Documents selected by their paths: `id` gives the identity.
	component PapersPage {
		type {
			@bindable
			picked string[] = []

			papers Paper[] = [new Paper("/a", "A"), new Paper("/b", "B"), new Paper("/c", "C")]

			def new() {
				style.width = 200(px)
				style.height = 100(px)
			}
		}

		view {
			List(papers, id = (paper Paper) => paper.path, rowHeight = 20(px), selected = picked, ref = list) {
				rowRenderer = (it RowItem<Paper>) => Text(it.content.title)
			}
		}

		style StageStyle
	}

	// Labels selected as themselves: their `hash()` and `equals()` say which is which.
	component LabelsPage {
		type {
			@bindable
			picked Label2[] = []

			labels Label2[] = [new Label2("red"), new Label2("green"), new Label2("blue")]

			def new() {
				style.width = 200(px)
				style.height = 100(px)
			}
		}

		view {
			List(labels, rowHeight = 20(px), selected = picked, ref = list) {
				rowRenderer = (it RowItem<Label2>) => Text(it.content.text)
			}
		}

		style StageStyle
	}

	// One document in a list whose ids are strings and that has no `id`.
	component NoIdPage {
		type {
			@bindable
			picked string[] = []

			papers Paper[] = [new Paper("/a", "A")]
		}

		view {
			List(papers, selected = picked) {
				rowRenderer = (it RowItem<Paper>) => Text(it.content.title)
			}
		}

		style StageStyle
	}

	// A million numbers no array holds: the item at `index` is `index - shift`, so items
	// added at the start push the others down.
	type Countless {
		feed  channel<SourceChange> = new channel<SourceChange>(16)
		size  int                   = 1000000
		shift int                   = 0

		def count() int {
			return size
		}

		def at(index int) int {
			return index - shift
		}

		def changes() channel<SourceChange> {
			return feed
		}

		// Adds `rows` items before the first.
		def prepend(rows int) {
			size += rows
			shift += rows
			let _ = feed.offer(SourceChange{kind: SourceChangeKind.Inserted, at: 0, count: rows})
		}
	}

	component CountlessPage {
		type {
			numbers Countless = new Countless()

			def new() {
				style.width = 200(px)
				style.height = 100(px)
			}
		}

		view {
			List(source = numbers, rowHeight = 20(px), ref = list)
		}

		style StageStyle
	}

	check "List" {
		// The rows of a list as mounted now: the children of its scroll view between the
		// two gaps.
		def rowsOf(port component) ListRow[] {
			let rows ListRow[]
			for let child in port.childNodes {
				rows.push(child) when child is ListRow
			}
			return rows
		}

		// A point on the row that shows `nth` from the top of a list of rows 20 high.
		def onRow(nth int) Point<Pixels> {
			return new Point<Pixels>(50(px), (float(nth) * 20.0 + 10.0) * 1(px))
		}

		// The heights of rows are summed and searched as a plain loop over them would.
		@test()
		def TestRowHeightsMatchAPlainSum() {
			let heights = new RowHeights()
			heights.resize(100)
			assert heights.top(100) == 3200.0 && heights.at(64.0) == 2
			let plain float[]
			for let i = 0; i < 100; i++ {
				plain.push(-1.0)
			}
			for let i = 0; i < 100; i += 3 {
				let tall = 10.0 + float(i % 7) * 4.0
				assert heights.measure(i, tall)
				assert !heights.measure(i, tall)
				plain[i] = tall
			}
			heights.forget(30, 10)
			for let i = 30; i < 40; i++ {
				plain[i] = -1.0
			}
			heights.resize(90)
			heights.resize(95)
			plain.len(90)
			for let i = 90; i < 95; i++ {
				plain.push(-1.0)
			}
			assert heights.measure(92, 50.0)
			plain[92] = 50.0

			let each = heights.guess()
			let sum = 0.0
			for let i = 0; i < 95; i++ {
				assert (heights.top(i) - sum).abs() < 0.001
				let tall = plain[i] < 0.0 ?? (each, plain[i])
				assert (heights.height(i) - tall).abs() < 0.001
				assert heights.at(sum + tall / 2.0) == i
				sum += tall
			}
			assert (heights.top(95) - sum).abs() < 0.001
			assert heights.at(sum + 100.0) == 94 && heights.at(-5.0) == 0

			// One height for every row needs no measures.
			heights.fixed = 20.0
			assert heights.top(95) == 1900.0 && heights.at(45.0) == 2 && heights.height(7) == 20.0
			assert !heights.measure(3, 99.0)
		}

		// A list mounts the rows that show and a few around them, with the room of the
		// others before and after; scrolling mounts other rows.
		@test()
		def TestListMountsOnlyTheRowsThatShow() {
			let page = NumbersPage()
			let scene = new Scene(page)
			let size = new Size<Pixels>(200(px), 100(px))
			scene.arrange(size)
			scene.arrange(size)
			let list = page.list
			assert !(list is none)
			return when list is none
			let port = list.port
			assert !(port is none)
			return when port is none

			// Rows 0 to 5 show; three more are mounted after them.
			let rows = rowsOf(port)
			assert rows.len() == 9 && rows[0].index == 0 && rows[8].index == 8
			assert port.childNodes.len() == 11
			assert float(port.reach().y) == 10000.0 * 20.0 - 100.0
			let shown = rows[1].childNodes[0]
			assert shown is Text && shown.text == "1"

			// Halfway down: rows 5000 to 5005 show, three are mounted on each side.
			port.scrollTo(new Point<Pixels>(0(px), 100000(px)))
			scene.arrange(size)
			scene.arrange(size)
			rows = rowsOf(port)
			assert rows.len() == 12 && rows[0].index == 4997 && rows[11].index == 5008
			let lead = port.childNodes[0]
			assert float(lead.style.geom.frame.height) == 4997.0 * 20.0
			assert float(port.scrollOffset().y) == 100000.0
			scene.close()
		}

		// A click selects a row, Shift selects up to it, the command key adds and removes
		// one; the keys move through the rows, and Enter or a double click opens one.
		@test()
		def TestListSelectsWithPointerAndKeys() {
			listLog.len(0)
			let page = NumbersPage()
			let scene = new Scene(page)
			let size = new Size<Pixels>(200(px), 100(px))
			scene.arrange(size)
			scene.arrange(size)
			let list = page.list
			assert !(list is none)
			return when list is none
			let port = list.port
			return when port is none

			scene.pointer(PointerPhase.Down, onRow(1))
			scene.pointer(PointerPhase.Up, onRow(1))
			scene.arrange(size)
			assert page.picked.len() == 1 && page.picked[0] == 1
			assert listLog.join(",") == "selected 1"
			assert list.focused
			let rows = rowsOf(port)
			assert rows[1].selected && !rows[0].selected
			let current = list.current()
			assert !(current is none) && current == 1

			scene.hold(Modifiers{shift: true})
			scene.pointer(PointerPhase.Down, onRow(4))
			scene.pointer(PointerPhase.Up, onRow(4))
			assert page.picked.join(",") == "1,2,3,4"
			scene.hold(Modifiers{mod: true})
			scene.pointer(PointerPhase.Down, onRow(2))
			scene.pointer(PointerPhase.Up, onRow(2))
			assert page.picked.join(",") == "1,3,4"
			scene.pointer(PointerPhase.Down, onRow(0))
			scene.pointer(PointerPhase.Up, onRow(0))
			assert page.picked.join(",") == "1,3,4,0"
			scene.hold(Modifiers{})

			// A double click opens the row; the first click selected it alone.
			scene.pointer(PointerPhase.Down, onRow(3))
			scene.pointer(PointerPhase.Up, onRow(3))
			scene.pointer(PointerPhase.Down, onRow(3), clicks = 2)
			scene.pointer(PointerPhase.Up, onRow(3))
			assert page.picked.join(",") == "3"
			assert listLog[-1] == "opened 3"

			// The keys.
			scene.key(KeyEvent{target: list, key: Key.Down})
			assert page.picked.join(",") == "4"
			scene.key(KeyEvent{target: list, key: Key.Up})
			scene.key(KeyEvent{target: list, key: Key.Up})
			assert page.picked.join(",") == "2"
			scene.hold(Modifiers{shift: true})
			scene.key(KeyEvent{target: list, key: Key.Up})
			assert page.picked.join(",") == "1,2"
			scene.hold(Modifiers{})
			scene.key(KeyEvent{target: list, key: Key.PageDown})
			assert page.picked.join(",") == "6"

			// End goes to the last row and scrolls it into view.
			scene.key(KeyEvent{target: list, key: Key.End})
			assert page.picked.join(",") == "9999"
			scene.arrange(size)
			scene.arrange(size)
			assert float(port.scrollOffset().y) == float(port.reach().y)
			rows = rowsOf(port)
			assert rows[-1].index == 9999 && rows[-1].selected
			scene.key(KeyEvent{target: list, key: Key.Enter})
			assert listLog[-1] == "opened 9999"

			// The command key moves the keyboard's row alone; Space then adds it.
			scene.hold(Modifiers{mod: true})
			scene.key(KeyEvent{target: list, key: Key.Up})
			assert page.picked.join(",") == "9999"
			scene.key(KeyEvent{target: list, key: Key.Space})
			assert page.picked.join(",") == "9999,9998"
			scene.key(KeyEvent{target: list, key: Key.A})
			assert page.picked.len() == 10000
			scene.hold(Modifiers{})
			scene.close()
		}

		// Rows as high as their content are measured as they show: the rows not seen yet
		// take the average, and the end of the list is where its last row ends.
		@test()
		def TestListMeasuresUnevenRows() {
			let page = UnevenPage()
			let scene = new Scene(page)
			let size = new Size<Pixels>(200(px), 100(px))
			for let i = 0; i < 4; i++ {
				scene.arrange(size)
			}
			let list = page.list
			assert !(list is none)
			return when list is none
			let port = list.port
			return when port is none

			// 10 + 20 + 30 + 10 + 20 + 30 fills the room; rows 0 to 5 show.
			let rows = rowsOf(port)
			assert rows[0].index == 0 && float(rows[1].style.geom.frame.height) == 20.0
			assert rows.len() == 9
			assert !list.stale()
			assert (list.heights.top(1000) - 20000.0).abs() < 1000.0

			port.scrollTo(new Point<Pixels>(0(px), 1000000(px)))
			for let i = 0; i < 6; i++ {
				scene.arrange(size)
			}
			rows = rowsOf(port)
			assert rows[-1].index == 999
			assert !list.stale()
			let reach = float(port.reach().y)
			assert float(port.scrollOffset().y) == reach
			assert (list.heights.top(1000) - 100.0 - reach).abs() < 0.5

			// A row in the middle: the first row that shows stays put while the rows
			// around it are measured.
			port.scrollTo(new Point<Pixels>(0(px), list.heights.top(500) * 1(px)))
			for let i = 0; i < 6; i++ {
				scene.arrange(size)
			}
			assert !list.stale()
			assert (float(port.scrollOffset().y) - list.heights.top(500)).abs() < 0.5
			scene.close()
		}

		// The selection and the rows follow the items when they move.
		@test()
		def TestListKeepsSelectionByItem() {
			let page = NamesPage()
			let scene = new Scene(page)
			let size = new Size<Pixels>(200(px), 100(px))
			scene.arrange(size)
			scene.arrange(size)
			let list = page.list
			assert !(list is none)
			return when list is none
			let port = list.port
			return when port is none

			scene.pointer(PointerPhase.Down, onRow(1))
			scene.pointer(PointerPhase.Up, onRow(1))
			scene.arrange(size)
			assert page.picked.join(",") == "bob"
			let before = rowsOf(port)
			assert before.len() == 3 && before[1].selected

			page.names = ["bob", "ada", "cy"]
			scene.arrange(size)
			let after = rowsOf(port)
			assert after[0] == before[1] && after[0].selected && after[0].index == 0
			assert !after[1].selected
			let current = list.current()
			assert !(current is none) && current == "bob" && list.cursorAt == 0

			// The page selects by assigning another array.
			page.picked = ["cy"]
			scene.arrange(size)
			after = rowsOf(port)
			assert after[2].selected && !after[0].selected
			list.reveal("cy")
			scene.close()
		}

		// With `id` the identity is what it returns: other objects with the same paths
		// are the same rows, selected as before.
		@test()
		def TestListKeepsSelectionById() {
			let page = PapersPage()
			let scene = new Scene(page)
			let size = new Size<Pixels>(200(px), 100(px))
			scene.arrange(size)
			scene.arrange(size)
			let list = page.list
			assert !(list is none)
			return when list is none
			let port = list.port
			return when port is none

			scene.pointer(PointerPhase.Down, onRow(1))
			scene.pointer(PointerPhase.Up, onRow(1))
			scene.arrange(size)
			assert page.picked.join(",") == "/b"
			let before = rowsOf(port)

			page.papers = [new Paper("/c", "C2"), new Paper("/b", "B2")]
			scene.arrange(size)
			let after = rowsOf(port)
			assert after.len() == 2 && after[1] == before[1] && after[1].selected && !after[0].selected
			let shown = after[1].childNodes[0]
			assert shown is Text && shown.text == "B2"
			let current = list.current()
			assert !(current is none) && current == "/b" && list.cursorAt == 1
			scene.close()
		}

		// Items that declare `hash()` and `equals()` are the same item when those say so.
		@test()
		def TestListKeepsSelectionByEquals() {
			let page = LabelsPage()
			let scene = new Scene(page)
			let size = new Size<Pixels>(200(px), 100(px))
			scene.arrange(size)
			scene.arrange(size)
			let list = page.list
			assert !(list is none)
			return when list is none
			let port = list.port
			return when port is none

			scene.pointer(PointerPhase.Down, onRow(2))
			scene.pointer(PointerPhase.Up, onRow(2))
			scene.arrange(size)
			assert page.picked.len() == 1 && page.picked[0].text == "blue"
			let before = rowsOf(port)

			page.labels = [new Label2("blue"), new Label2("red")]
			scene.arrange(size)
			let after = rowsOf(port)
			// The row's component is another one: a view tells keys apart with `==`,
			// which for a type is being the same object.
			assert after[0] != before[2]
			assert after.len() == 2 && after[0].selected && !after[1].selected
			assert list.cursorAt == 0
			list.reveal(new Label2("red"))
			scene.close()
		}

		// A list whose ids are of another type than its items says that it needs `id`.
		@test()
		def TestListWithoutIdSaysSo() {
			let page = NoIdPage()
			let scene = new Scene(page)
			let size = new Size<Pixels>(200(px), 100(px))
			let warnings = scene.arrange(size)
			assert warnings.join("|").contains("`id` is needed")
			warnings = scene.arrange(size)
			assert !warnings.join("|").contains("`id` is needed")
			scene.close()
		}

		// A source of a million items: the rows that show are asked for, and the
		// keyboard's row follows its item when the source says items were added.
		@test()
		def TestListReadsASource() {
			let page = CountlessPage()
			let scene = new Scene(page)
			let size = new Size<Pixels>(200(px), 100(px))
			scene.arrange(size)
			scene.arrange(size)
			let list = page.list
			assert !(list is none)
			return when list is none
			let port = list.port
			return when port is none

			assert rowsOf(port).len() == 9
			assert float(port.reach().y) == 1000000.0 * 20.0 - 100.0
			scene.pointer(PointerPhase.Down, onRow(2))
			scene.pointer(PointerPhase.Up, onRow(2))
			scene.arrange(size)
			assert list.cursorAt == 2 && list.selected.join(",") == "2"

			page.numbers.prepend(5)
			scene.arrange(size)
			assert list.cursorAt == 7 && list.count() == 1000005
			let rows = rowsOf(port)
			assert rows[7].selected && !rows[2].selected
			let shown = rows[7].childNodes[0]
			assert shown is Text && shown.text == "2"

			list.reveal(900000)
			scene.arrange(size)
			scene.arrange(size)
			assert float(port.scrollOffset().y) == 900005.0 * 20.0 + 20.0 - 100.0
			scene.close()
		}
	}
}
