partial module std.ui.components {
	use (
		std.math.geom::(Axes, Edges, Point, Rect, Size)
		std.ui::(Key, KeyEvent, PointerEvent, RenderContext, Theme, UI)
		std.ui.styles::*
		std.units::(Extent, Pixels)
	)

	// Moves the keyboard focus among the lines of a menu for an arrow key, Home or End:
	// Down and Up go to the next and the one before, round
	// at the ends. True when the key was one of them.
	internal def stepLines(lines component[], key Key) bool {
		return false unless key := Key.Down || Key.Up || Key.Home || Key.End
		let stops component[]
		let at = -1
		for let line in lines {
			continue when !line.takesFocus || line.disabled
			at = stops.len() when line.isFocused
			stops.push(line)
		}
		let count = stops.len()
		return true when count == 0
		let to = 0
		switch key {
			case Key.Down:
				to = (at + 1) % count
			case Key.Up:
				to = at <= 0 ?? (count - 1, at - 1)
			case Key.End:
				to = count - 1
			default:
		}
		stops[to].focus()
		return true
	}

	// Moves the focus to the next line of a menu, after the focused one and round, whose
	// label starts with the letter of `key`, whatever its capitals. True when there is one.
	internal def seekLine(lines component[], key Key) bool {
		let letter = key.name
		return false when letter.len() != 1
		let stops component[]
		let at = -1
		for let line in lines {
			continue when !line.takesFocus || line.disabled
			at = stops.len() when line.isFocused
			stops.push(line)
		}
		for let i = 1; i <= stops.len(); i++ {
			let line = stops[(at + i + stops.len()) % stops.len()]
			if line is MenuItem {
				if line.label.upper().startsWith(letter) {
					line.focus()
					return true
				}
			}
		}
		return false
	}

	// Tells the nearest menu above `from` that one of its lines was picked.
	internal def pickedAbove(from component) {
		let above = from.parent()
		for {
			return when above is none
			if above is MenuSurface {
				above.picked()
				return
			}
			above = above.parent()
		}
	}

	// The checked line of a menu, the current option of a list of choices; none when no
	// line is checked.
	internal def checkedLine(lines component[]) ?component {
		for let line in lines {
			if line is MenuItem {
				return line when line.checked
			}
		}
		return none
	}

	// The checked line of a menu takes the focus when it can, else the first line that can.
	internal def focusChecked(lines component[]) {
		let start = checkedLine(lines)
		if !(start is none) && start.takesFocus && !start.disabled {
			start.focus()
			return
		}
		focusFirst(lines)
	}

	// The first line of a menu that can take the focus takes it.
	internal def focusFirst(lines component[]) {
		for let line in lines {
			continue when !line.takesFocus || line.disabled
			line.focus()
			return
		}
	}

	// The most lines a menu shows before its lines scroll.
	internal const menuLines = 12

	// The tallest a menu may be: no more than `menuLines` lines (`line` high each, with
	// `padding`) and the room the window has on the larger of the two sides of `named`
	// it can open on, so it fits on one of them; beside the target, or placed at a point
	// (`named` none), the window's height. `gap` is kept free from the target and from the
	// window's edges.
	internal def menuHeight(named ?component, side Side, window Size<Pixels>, gap float, line float, padding float) float {
		let most = line * float(menuLines) + padding
		let room = float(window.height) - gap * 2.0
		if !(named is none) && (side := Side.Above || Side.Below) {
			let target = laidOut(named)
			if !target.isScoped {
				let beside = target.style.geom.frame
				room = (float(beside.top) - gap).max(float(window.height) - float(beside.bottom) - gap)
			}
		}
		return most.min(room).max(line + padding)
	}

	// Where the lines of a menu that scrolls them are after `by`, or none when they are
	// as far as they go.
	internal def scrolledBy(menu component, offset Point<Pixels>, extent Size<Pixels>, by Point<Pixels>) ?Point<Pixels> {
		let to = clampScroll(new Point<Pixels>(offset.x + by.x, offset.y + by.y), scrollReach(menu.style.geom.content, extent, menuAxes))
		return none when to.x == offset.x && to.y == offset.y
		return to
	}

	// A menu's lines scroll up and down.
	internal let menuAxes = new Axes<bool>(false, true)

	// The style of a `Menu` and a `ContextMenu`: what floats over the page, with a bar
	// that scrolls lines past the most it shows.
	style MenuStyle {
		PopoverStyle
		Scrollbars
		padding = new Edges<Extent>(theme.metrics.unit)
		scrollbar = {thumb: theme.palette.foreground.withOpacity(0.35), thumbHover: theme.palette.foreground.withOpacity(0.55), radius: scrollbar.thickness / 2.0}
	}

	// What holds menus and is told when one closes itself: a `MenuBar`.
	internal interface MenuHolder {
		def menuDismissed(menu component)
	}

	// A list of lines that opens beside a component:
	// `Menu(open = shown, onClose = hide) { MenuItem(label = "Rename", onActivate = rename) }`.
	// It hangs beside `attach` (its parent when none is given), out of any clipping, and
	// closes when a line is picked, on Escape and on a press outside it. While it is open
	// the arrows, Home and End move among its lines, and a letter goes to the next line
	// that starts with it.
	component Menu {
		type {
			// Whether it is shown.
			@input(value = true, bind = true)
			@state
			open bool = false

			// The component it hangs beside; none: its parent.
			@input
			attach ?component = none

			// The side of the target it opens on when there is room.
			@input
			side Side = Side.Below

			// Runs when it closes itself: a line was picked, Escape, or a press outside it
			// and its target.
			@input
			onClose ?(def()) = none

			// Tells every listener it closed itself, after the handler ran: heard with
			// `@on(Menu.closed)`.
			@emit()
			def closed() bool {
				return true
			}

			// What a `MenuBar` shows for it.
			@input
			title string = ""

			// What a `MenuBar` shows for it in place of `title`.
			@input
			heading ?view = none

			// Whether its first line takes the keyboard focus when it opens. False for a
			// list under a field that goes on being typed in.
			@input
			focusLines bool = true

			// Whether it opens at its checked line: that line takes the focus in place of
			// the first (with `focusLines`) and is scrolled into view. A list of choices
			// (`Dropdown`, `ComboBox`) opens at the current one.
			@input
			openAtChecked bool = false

			// Whether it is at least as wide as what it hangs beside, wider when its lines
			// need the room: a list of choices (`Dropdown`, `ComboBox`) is.
			@input
			matchWidth bool = false

			// How far from its target's start edge it hangs: a `MenuBar` puts each of its
			// menus under its title.
			along float

			look  Theme = UI.theme()
			// Whether it was open when it was placed last.
			shown bool

			// Whether it is laid out right to left.
			def rtl() bool {
				return style.geom.direction == Direction.RightToLeft
			}

			// How far its lines are scrolled, the size they were laid out in, and its bar:
			// a menu taller than it may be (`menuHeight`) scrolls them.
			offset Point<Pixels> = new Point<Pixels>(0(px), 0(px))
			extent Size<Pixels> = new Size<Pixels>(0(px), 0(px))
			bars   ScrollBars = new ScrollBars()

			def scrollAxes() Axes<bool> {
				return menuAxes
			}

			def scrollOffset() Point<Pixels> {
				return offset
			}

			def scrollExtent() Size<Pixels> {
				return extent
			}

			def scrollPort() Rect<Pixels> {
				return style.geom.content
			}

			def scrollbarLook() Scrollbar {
				return style.scrollbar
			}

			def scrollbarRoom() Pixels {
				return barRoom(style.scrollbar)
			}

			def scrollbarKept() bool {
				return barKept(style.scrollbar)
			}

			// Layout reports the size the lines took; the offset is brought back inside.
			def scrolled(extent Size<Pixels>) {
				self.extent = extent when extent.width != self.extent.width || extent.height != self.extent.height
				let to = clampScroll(offset, scrollReach(style.geom.content, extent, menuAxes))
				offset = to when to.y != offset.y
			}

			def scrollBy(by Point<Pixels>) bool {
				let me component = self
				let to = scrolledBy(me, offset, extent, by)
				return false when to is none
				offset = to
				return true
			}

			// The wheel scrolls the lines, and the bar takes presses and drags.
			def pointer(e PointerEvent) bool {
				let (pointed, dragged) = (bars.pointed, bars.dragged)
				let taken = bars.pointer(self, e)
				redraw(style.geom.frame) when bars.pointed != pointed || bars.dragged != dragged
				return taken
			}

			def floating() bool {
				return open
			}

			// What it hangs beside.
			def floatTarget() ?component {
				let named = attach
				return named unless named is none
				return parent()
			}

			// Hides itself.
			def dismiss() {
				return when !open
				open = false
				redraw()
				let above = parent()
				if !(above is none) {
					let me component = self
					above.menuDismissed(me) when above is MenuHolder
				}
				let run = onClose
				run() unless run is none
				closed()
			}

			// One of its lines was picked: it closes, and so does the menu it is a line of.
			def picked() {
				dismiss()
				let me component = self
				pickedAbove(me)
			}

			// Shows or hides it and says how far along its target it hangs: what a
			// `MenuBar` does with each of its menus.
			def hang(shown bool, at float) {
				open  = shown
				along = at
			}

			// Shows or hides itself and keeps itself beside its target; the frame it opens,
			// its first line (or its checked one, `openAtChecked`) takes the keyboard focus.
			def place(window Size<Pixels>) {
				style.visible = open
				let fresh = open && !shown
				shown = open
				let target = floatTarget()
				return when !open || target is none
				// It opens scrolled to its first line, or to the line it opens at; the focused
				// line is scrolled to.
				if fresh {
					offset = new Point<Pixels>(0(px), 0(px))
					if !focusLines {
						let start = openAtChecked ?? (checkedLine(childNodes), none)
						start.reveal() unless start is none
					} else if openAtChecked {
						focusChecked(childNodes)
					} else {
						focusFirst(childNodes)
					}
				}
				// The menu of a line of another menu starts where the line ends: the pointer
				// goes from one to the other without leaving the line.
				let away = target is SubMenu ?? (0.0, float(look.metrics.unit))
				let unit = float(look.metrics.unit)
				style.maxHeight = menuHeight(target, side, window, away.max(unit), float(look.metrics.controlHeight), unit * 2.0) * 1(px)
				if matchWidth {
					let beside = laidOut(target)
					style.minWidth = beside.style.geom.frame.width unless beside.isScoped
				}
				style.anchors = besideAnchors(target, style.geom.frame, side, rtl(), window, away, along)
			}

			def key(e KeyEvent) bool {
				return false when !e.down
				return false when !open
				return stepLines(childNodes, e.key) || (!e.modifiers.mod && seekLine(childNodes, e.key))
			}

			def render(ctx RenderContext) {
				drawFloat(ctx)
				bars.draw(self, ctx)
			}
		}

		view {
			children()
		}

		style MenuStyle
	}

	// A line between two groups of lines in a menu: `MenuSeparator()`.
	component MenuSeparator {
		type {
			look Theme = UI.theme()

			def render(ctx RenderContext) {
				let box = frameBox(ctx)
				let line = float(look.metrics.borderWidth)
				let top = (box.bottom - line) / 2.0
				ctx.draw.fill(Rect{left: 0.0, top: top, right: box.right, bottom: top + line}, look.palette.border)
			}
		}

		view {}

		style {
			BoxStyle
			width  = fill
			height = theme.metrics.unit * 2.0 + theme.metrics.borderWidth
		}
	}

	// A menu that opens where the secondary button is released on the component it is
	// placed in: `Panel() { ...; ContextMenu() { MenuItem(label = "Rename", onActivate = rename) } }`.
	// It closes when a line is picked, on Escape and on a press outside it; the arrows,
	// Home and End move among its lines.
	component ContextMenu {
		type {
			// Runs when it closes.
			@input
			onClose ?(def()) = none

			// Tells every listener it closed itself, after the handler ran: heard with
			// `@on(ContextMenu.closed)`.
			@emit()
			def closed() bool {
				return true
			}

			look  Theme = UI.theme()
			// Whether it is shown, and the point of the window it was opened at.
			open  bool
			at    Point<Pixels> = new Point<Pixels>(0(px), 0(px))
			// Whether it was open when it was placed last.
			shown bool

			// Opens it at a point of the window, as a release of the secondary button there
			// does.
			def context(at Point<Pixels>) {
				return when disabled
				self.at = at
				open  = true
				shown = false
				redraw()
			}

			// How far its lines are scrolled, the size they were laid out in, and its bar:
			// a menu taller than it may be (`menuHeight`) scrolls them.
			offset Point<Pixels> = new Point<Pixels>(0(px), 0(px))
			extent Size<Pixels> = new Size<Pixels>(0(px), 0(px))
			bars   ScrollBars = new ScrollBars()

			def scrollAxes() Axes<bool> {
				return menuAxes
			}

			def scrollOffset() Point<Pixels> {
				return offset
			}

			def scrollExtent() Size<Pixels> {
				return extent
			}

			def scrollPort() Rect<Pixels> {
				return style.geom.content
			}

			def scrollbarLook() Scrollbar {
				return style.scrollbar
			}

			def scrollbarRoom() Pixels {
				return barRoom(style.scrollbar)
			}

			def scrollbarKept() bool {
				return barKept(style.scrollbar)
			}

			// Layout reports the size the lines took; the offset is brought back inside.
			def scrolled(extent Size<Pixels>) {
				self.extent = extent when extent.width != self.extent.width || extent.height != self.extent.height
				let to = clampScroll(offset, scrollReach(style.geom.content, extent, menuAxes))
				offset = to when to.y != offset.y
			}

			def scrollBy(by Point<Pixels>) bool {
				let me component = self
				let to = scrolledBy(me, offset, extent, by)
				return false when to is none
				offset = to
				return true
			}

			// The wheel scrolls the lines, and the bar takes presses and drags.
			def pointer(e PointerEvent) bool {
				let (pointed, dragged) = (bars.pointed, bars.dragged)
				let taken = bars.pointer(self, e)
				redraw(style.geom.frame) when bars.pointed != pointed || bars.dragged != dragged
				return taken
			}

			// Whether it is laid out right to left.
			def rtl() bool {
				return style.geom.direction == Direction.RightToLeft
			}

			def floating() bool {
				return open
			}

			// It hangs beside nothing: it is placed at a point.
			def floatTarget() ?component {
				return none
			}

			// Hides itself.
			def dismiss() {
				return when !open
				open = false
				redraw()
				let run = onClose
				run() unless run is none
				closed()
			}

			// One of its lines was picked: it closes, and so does the menu it is a line of.
			def picked() {
				dismiss()
				let me component = self
				pickedAbove(me)
			}

			// Shows or hides itself and keeps itself at its point; the frame it opens, its
			// first line takes the keyboard focus.
			def place(window Size<Pixels>) {
				style.visible = open
				let fresh = open && !shown
				shown = open
				return when !open
				offset = new Point<Pixels>(0(px), 0(px)) when fresh
				focusFirst(childNodes) when fresh
				let me component = self
				let unit = float(look.metrics.unit)
				style.maxHeight = menuHeight(none, Side.Below, window, unit, float(look.metrics.controlHeight), unit * 2.0) * 1(px)
				style.anchors = pointAnchors(windowRoot(me), at, style.geom.frame, window)
			}

			def key(e KeyEvent) bool {
				return false when !e.down
				return false when !open
				return stepLines(childNodes, e.key) || (!e.modifiers.mod && seekLine(childNodes, e.key))
			}

			def render(ctx RenderContext) {
				drawFloat(ctx)
				bars.draw(self, ctx)
			}
		}

		view {
			children()
		}

		style MenuStyle
	}
}
