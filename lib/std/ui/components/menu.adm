partial module std.ui.components {
	use (
		std.math.geom::(Edges, Point, Rect, Size)
		std.ui::(Key, KeyEvent, RenderContext, Theme, UI)
		std.ui.styles::*
		std.units::(Extent, Pixels)
	)

	// Moves the keyboard focus among the lines of a menu for an arrow key, Home or End:
	// Down and Up go to the next and the one before, round
	// at the ends. True when the key was one of them.
	internal def stepLines(lines component[], key Key) bool {
		return false unless key := Key.Down || Key.Up || Key.Home || Key.End
		let stops component[]
		let at = -1
		for let line in lines {
			continue when !line.focusable || line.disabled
			at = stops.len() when line.isFocused
			stops.push(line)
		}
		let count = stops.len()
		return true when count == 0
		let to = 0
		switch key {
			case Key.Down:
				to = (at + 1) % count
			case Key.Up:
				to = at <= 0 ?? (count - 1, at - 1)
			case Key.End:
				to = count - 1
			default:
		}
		stops[to].focus()
		return true
	}

	// Moves the focus to the next line of a menu, after the focused one and round, whose
	// label starts with the letter of `key`, whatever its capitals. True when there is one.
	internal def seekLine(lines component[], key Key) bool {
		let letter = key.name
		return false when letter.len() != 1
		let stops component[]
		let at = -1
		for let line in lines {
			continue when !line.focusable || line.disabled
			at = stops.len() when line.isFocused
			stops.push(line)
		}
		for let i = 1; i <= stops.len(); i++ {
			let line = stops[(at + i + stops.len()) % stops.len()]
			if line is MenuItem {
				if line.label.upper().startsWith(letter) {
					line.focus()
					return true
				}
			}
		}
		return false
	}

	// Tells the nearest menu above `from` that one of its lines was picked.
	internal def pickedAbove(from component) {
		let above = from.parent()
		for {
			return when above is none
			if above is MenuSurface {
				above.picked()
				return
			}
			above = above.parent()
		}
	}

	// The first line of a menu that can take the focus takes it.
	internal def focusFirst(lines component[]) {
		for let line in lines {
			continue when !line.focusable || line.disabled
			line.focus()
			return
		}
	}

	// What holds menus and is told when one closes itself: a `MenuBar`.
	internal interface MenuHolder {
		def menuDismissed(menu component)
	}

	// A list of lines that opens beside a component:
	// `Menu(open = shown, onClose = hide) { MenuItem(label = "Rename", onActivate = rename) }`.
	// It hangs beside `attach` (its parent when none is given), out of any clipping, and
	// closes when a line is picked, on Escape and on a press outside it. While it is open
	// the arrows, Home and End move among its lines, and a letter goes to the next line
	// that starts with it.
	component Menu {
		type {
			// Whether it is shown.
			@input(value = true, bind = true)
			@state
			open bool = false

			// The component it hangs beside; none: its parent.
			@input
			attach ?component = none

			// The side of the target it opens on when there is room.
			@input
			side Side = Side.Below

			// Runs when it closes itself: a line was picked, Escape, or a press outside it
			// and its target.
			@input
			onClose ?(def()) = none

			// Tells every listener it closed itself, after the handler ran: heard with
			// `@on(Menu.closed)`.
			@emit()
			def closed() bool {
				return true
			}

			// What a `MenuBar` shows for it.
			@input
			title string = ""

			// Whether its first line takes the keyboard focus when it opens. False for a
			// list under a field that goes on being typed in.
			@input
			focusLines bool = true

			// How far from its target's start edge it hangs: a `MenuBar` puts each of its
			// menus under its title.
			along float

			look  Theme = UI.theme()
			// Whether it was open when it was placed last.
			shown bool

			// Whether it is laid out right to left.
			def rtl() bool {
				return style.geom.direction == Direction.RightToLeft
			}

			def floating() bool {
				return open
			}

			// What it hangs beside.
			def floatTarget() ?component {
				let named = attach
				return named unless named is none
				return parent()
			}

			// Hides itself.
			def dismiss() {
				return when !open
				open = false
				redraw()
				let above = parent()
				if !(above is none) {
					let me component = self
					above.menuDismissed(me) when above is MenuHolder
				}
				let run = onClose
				run() unless run is none
				closed()
			}

			// One of its lines was picked: it closes, and so does the menu it is a line of.
			def picked() {
				dismiss()
				let me component = self
				pickedAbove(me)
			}

			// Shows or hides it and says how far along its target it hangs: what a
			// `MenuBar` does with each of its menus.
			def hang(shown bool, at float) {
				open  = shown
				along = at
			}

			// Shows or hides itself and keeps itself beside its target; the frame it opens,
			// its first line takes the keyboard focus.
			def place(window Size<Pixels>) {
				style.visible = open
				let fresh = open && !shown
				shown = open
				let target = floatTarget()
				return when !open || target is none
				focusFirst(childNodes) when fresh && focusLines
				// The menu of a line of another menu starts where the line ends: the pointer
				// goes from one to the other without leaving the line.
				let away = target is SubMenu ?? (0.0, float(look.metrics.unit))
				style.anchors = besideAnchors(target, style.geom.frame, side, rtl(), window, away, along)
			}

			def key(e KeyEvent) bool {
				return false when !e.down
				return false when !open
				return stepLines(childNodes, e.key) || (!e.modifiers.mod && seekLine(childNodes, e.key))
			}

			def render(ctx RenderContext) {
				drawFloat(ctx, look)
			}
		}

		view {
			children()
		}

		style {
			PopoverStyle
			padding = new Edges<Extent>(theme.metrics.unit)
		}
	}

	// A line between two groups of lines in a menu: `MenuSeparator()`.
	component MenuSeparator {
		type {
			look Theme = UI.theme()

			def render(ctx RenderContext) {
				let box = frameBox(ctx)
				let line = float(look.metrics.borderWidth)
				let top = (box.bottom - line) / 2.0
				ctx.draw.fill(Rect{left: 0.0, top: top, right: box.right, bottom: top + line}, look.palette.border)
			}
		}

		view {}

		style {
			BoxStyle
			width  = fill
			height = theme.metrics.unit * 2.0 + theme.metrics.borderWidth
		}
	}

	// A menu that opens where the secondary button is released on the component it is
	// placed in: `Panel() { ...; ContextMenu() { MenuItem(label = "Rename", onActivate = rename) } }`.
	// It closes when a line is picked, on Escape and on a press outside it; the arrows,
	// Home and End move among its lines.
	component ContextMenu {
		type {
			// Runs when it closes.
			@input
			onClose ?(def()) = none

			// Tells every listener it closed itself, after the handler ran: heard with
			// `@on(ContextMenu.closed)`.
			@emit()
			def closed() bool {
				return true
			}

			look  Theme = UI.theme()
			// Whether it is shown, and the point of the window it was opened at.
			open  bool
			at    Point<Pixels> = new Point<Pixels>(0(px), 0(px))
			// Whether it was open when it was placed last.
			shown bool

			// Opens it at a point of the window, as a release of the secondary button there
			// does.
			def context(at Point<Pixels>) {
				return when disabled
				self.at = at
				open  = true
				shown = false
				redraw()
			}

			def floating() bool {
				return open
			}

			// It hangs beside nothing: it is placed at a point.
			def floatTarget() ?component {
				return none
			}

			// Hides itself.
			def dismiss() {
				return when !open
				open = false
				redraw()
				let run = onClose
				run() unless run is none
				closed()
			}

			// One of its lines was picked: it closes, and so does the menu it is a line of.
			def picked() {
				dismiss()
				let me component = self
				pickedAbove(me)
			}

			// Shows or hides itself and keeps itself at its point; the frame it opens, its
			// first line takes the keyboard focus.
			def place(window Size<Pixels>) {
				style.visible = open
				let fresh = open && !shown
				shown = open
				return when !open
				focusFirst(childNodes) when fresh
				let me component = self
				style.anchors = pointAnchors(windowRoot(me), at, style.geom.frame, window)
			}

			def key(e KeyEvent) bool {
				return false when !e.down
				return false when !open
				return stepLines(childNodes, e.key) || (!e.modifiers.mod && seekLine(childNodes, e.key))
			}

			def render(ctx RenderContext) {
				drawFloat(ctx, look)
			}
		}

		view {
			children()
		}

		style {
			PopoverStyle
			padding = new Edges<Extent>(theme.metrics.unit)
		}
	}
}
