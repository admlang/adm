partial module std.ui.components {
	use (
		std.math.geom::(Point, Size)
		std.testing
		std.ui::(Key, KeyEvent, PointerPhase)
		std.ui.runtime::Scene
		std.ui.styles::*
		std.units::Pixels
	)

	// A button with a menu of `count` lines under it, open.
	component LongMenu {
		type {
			@input
			count int = 40
		}

		view {
			Button("Open", ref = opener)
			Menu(open = true, attach = opener, ref = menu) {
				for let i in 0..count {
					MenuItem("Line {i}", key = i)
				}
			}
		}

		style StageStyle
	}

	// A panel whose context menu has `count` lines.
	component LongContextMenu {
		type {
			@input
			count int = 40
		}

		view {
			Panel(ref = panel) {
				ContextMenu(ref = menu) {
					for let i in 0..count {
						MenuItem("Line {i}", key = i)
					}
				}
			}
		}

		style StageStyle
	}

	// A dropdown and a combo box over `count` options.
	component LongChoices {
		type {
			names string[]

			def new() {
				for let i in 0..40 {
					names.push("Option {i}")
				}
			}
		}

		view {
			Column() {
				Dropdown(options = names, ref = pick)
				ComboBox(options = names, ref = field)
			}
		}

		style StageStyle
	}

	// A dropdown and a combo box over 40 options whose current one is option 30.
	component CurrentChoices {
		type {
			names string[]

			def new() {
				for let i in 0..40 {
					names.push("Option {i}")
				}
			}
		}

		view {
			Column() {
				Dropdown(options = names, selected = 30, ref = pick)
				ComboBox(value = "Option 30", options = names, ref = field)
			}
		}

		style StageStyle
	}

	// Choice lists given a width: a dropdown 240 wide, a combo box that fills its row,
	// and one left at its own width.
	component WideChoices {
		type {
			names string[] = ["A much longer option", "B"]
		}

		view {
			Column(style = {width: fill}) {
				Dropdown(options = names, selected = 0, ref = pick, style = {width: 240(px)})
				Dropdown(options = names, selected = 1, ref = drawn, style = {width: 240(px)}) {
					rowRenderer = (it RowItem<string>) => view {
						Text(it.content)
					}
				}
				ComboBox(options = names, ref = field, style = {width: fill})
				ComboBox(options = names, ref = plain)
			}
		}

		style StageStyle
	}

	check "Menu" {
		// A menu taller than the room it has is held to `menuHeight` and scrolls its
		// lines: keys that move the focus bring the focused line into view, Down from the
		// last goes round to the first, and the wheel scrolls.
		@test()
		def TestLongMenuScrolls() {
			let page = LongMenu()
			let scene = new Scene(page)
			let window = new Size<Pixels>(400(px), 300(px))
			let lay = def () {
				scene.arrange(window)
				scene.arrange(window)
			}
			lay()
			let menu = page.menu
			let opener = page.opener
			assert !(menu is none) && !(opener is none)
			if !(menu is none) && !(opener is none) {
				let lines = menu.childNodes
				assert lines.len() == 40
				let frame = menu.style.geom.frame
				let high = float(frame.height)
				let most = menuHeight(opener, Side.Below, window, 4.0, 28.0, 8.0)
				assert high > 0.0 && high <= most + 0.5 && float(frame.bottom) <= 300.0
				assert float(menu.extent.height) > high
				assert scene.focused() == lines[0] && float(menu.offset.y) == 0.0
				// The bar stands beside the lines: they keep their width.
				let line = lines[0].style.geom.frame
				assert float(frame.width) >= float(line.width) + float(menu.style.scrollbar.thickness)

				let whole component = page
				scene.key(KeyEvent{target: whole, key: Key.End})
				lay()
				assert scene.focused() == lines[39] && float(menu.offset.y) > 0.0
				let content = menu.style.geom.frame
				assert float(lines[39].style.geom.frame.bottom) <= float(content.bottom) + 0.5
				assert float(lines[39].style.geom.frame.top) >= float(content.top) - 0.5

				scene.key(KeyEvent{target: whole, key: Key.Down})
				lay()
				assert scene.focused() == lines[0] && float(menu.offset.y) == 0.0

				let inside = new Point<Pixels>((float(frame.left) + 20.0) * 1(px), (float(frame.top) + 20.0) * 1(px))
				scene.pointer(PointerPhase.Scroll, inside, scroll = new Point<Pixels>(0(px), 60(px)))
				lay()
				assert float(menu.offset.y) == 60.0
			}
		}

		// A menu that fits is as tall as its lines and has nothing to scroll.
		@test()
		def TestShortMenuKeepsItsHeight() {
			let page = LongMenu(count = 3)
			let scene = new Scene(page)
			let window = new Size<Pixels>(400(px), 600(px))
			scene.arrange(window)
			scene.arrange(window)
			let menu = page.menu
			assert !(menu is none)
			if !(menu is none) {
				let lines = menu.childNodes
				assert lines.len() == 3
				let spanned = float(lines[2].style.geom.frame.bottom) - float(lines[0].style.geom.frame.top)
				assert float(menu.style.geom.frame.height) >= spanned
				assert float(menu.offset.y) == 0.0 && !menu.bars.bar(menu, true).shown
				assert !menu.scrollBy(new Point<Pixels>(0(px), 40(px)))
			}
		}

		// The list of a dropdown and of a combo box is held to `menuHeight` and the keys
		// that move among its lines bring the focused one into view.
		@test()
		def TestChoiceListsScroll() {
			let page = LongChoices()
			let scene = new Scene(page)
			let window = new Size<Pixels>(400(px), 300(px))
			let lay = def () {
				scene.arrange(window)
				scene.arrange(window)
			}
			lay()
			let whole component = page
			let pick = page.pick
			assert !(pick is none)
			if !(pick is none) {
				pick.flip()
				lay()
				let list = pick.find<Menu>()
				assert !(list is none)
				if !(list is none) {
					let frame = list.style.geom.frame
					assert float(frame.height) > 0.0 && float(frame.bottom) <= 300.0
					assert scene.focused() == list.childNodes[0]
					scene.key(KeyEvent{target: whole, key: Key.End})
					lay()
					assert scene.focused() == list.childNodes[39] && float(list.offset.y) > 0.0
					assert float(list.childNodes[39].style.geom.frame.bottom) <= float(list.style.geom.frame.bottom) + 0.5
				}
				scene.key(KeyEvent{target: whole, key: Key.Escape})
				lay()
			}
			let field = page.field
			assert !(field is none)
			if !(field is none) {
				// Down from its text goes into the list.
				let text = field.find<TextField>()
				text.focus() unless text is none
				lay()
				scene.key(KeyEvent{target: whole, key: Key.Down})
				lay()
				let list = field.find<Menu>()
				assert !(list is none)
				if !(list is none) {
					assert float(list.style.geom.frame.height) > 0.0 && float(list.style.geom.frame.bottom) <= 300.0
					assert scene.focused() == list.childNodes[0]
					scene.key(KeyEvent{target: whole, key: Key.Up})
					lay()
					assert scene.focused() == list.childNodes[39] && float(list.offset.y) > 0.0
				}
			}
		}

		// A list of choices opens at its current option: a dropdown's takes the focus, a
		// combo box's arrow scrolls to it and leaves the focus in the field, and Down then
		// goes to it.
		@test()
		def TestChoiceListsOpenAtTheCurrentOne() {
			let page = CurrentChoices()
			let scene = new Scene(page)
			let window = new Size<Pixels>(400(px), 300(px))
			let lay = def () {
				scene.arrange(window)
				scene.arrange(window)
			}
			lay()
			let whole component = page
			let inView = def (list Menu, line component) bool {
				let (shown, at) = (list.style.geom.frame, line.style.geom.frame)
				return float(at.top) >= float(shown.top) - 0.5 && float(at.bottom) <= float(shown.bottom) + 0.5
			}
			let pick = page.pick
			assert !(pick is none)
			if !(pick is none) {
				pick.flip()
				lay()
				let list = pick.find<Menu>()
				assert !(list is none)
				if !(list is none) {
					let current = list.childNodes[30]
					assert scene.focused() == current && float(list.offset.y) > 0.0 && inView(list, current)
				}
				scene.key(KeyEvent{target: whole, key: Key.Escape})
				lay()
			}
			let field = page.field
			assert !(field is none)
			if !(field is none) {
				let text = field.find<TextField>()
				assert !(text is none)
				text.focus() unless text is none
				lay()
				field.flip()
				lay()
				let list = field.find<Menu>()
				assert !(list is none)
				if !(list is none) {
					let current = list.childNodes[30]
					assert float(list.offset.y) > 0.0 && inView(list, current)
					assert scene.focused() is TextField
					scene.key(KeyEvent{target: whole, key: Key.Down})
					lay()
					assert scene.focused() == current && inView(list, current)
				}
			}
		}

		// A list of choices fills the width its style gives it, whatever option it shows,
		// and its open list is at least as wide.
		@test()
		def TestChoiceListsTakeTheirWidth() {
			let page = WideChoices()
			let scene = new Scene(page)
			let window = new Size<Pixels>(400(px), 300(px))
			let lay = def () {
				scene.arrange(window)
				scene.arrange(window)
			}
			lay()
			let wide = def (c component) float {
				return float(c.style.geom.frame.width)
			}
			let (pick, field, plain) = (page.pick, page.field, page.plain)
			assert !(pick is none) && !(field is none) && !(plain is none)
			if !(pick is none) {
				let button = pick.find<Button>()
				assert !(button is none) && wide(pick) == 240.0
				if !(button is none) {
					assert wide(button) == 240.0
					pick.pick(1)
					lay()
					assert wide(button) == 240.0
				}
				pick.flip()
				lay()
				let list = pick.find<Menu>()
				assert !(list is none) && wide(list) >= 240.0 unless list is none
			}
			// A dropdown whose rows draw themselves: the row's view at the start of the
			// button, the chevron at its end.
			let drawn = page.drawn
			assert !(drawn is none)
			if !(drawn is none) {
				let button = drawn.find<Button>()
				let chevron = drawn.find<Icon>()
				assert !(button is none) && !(chevron is none)
				if !(button is none) && !(chevron is none) {
					let shown = button.find<Text>()
					assert !(shown is none)
					let inner = button.style.geom.frame
					let pad = float(inner.width) - float(button.style.geom.content.width)
					assert float(chevron.style.geom.frame.right) >= float(inner.right) - pad
					assert float(shown.style.geom.frame.left) <= float(inner.left) + pad unless shown is none
				}
			}
			if !(field is none) {
				let text = field.find<TextField>()
				// The page is as wide as the dropdown: the combo box fills that line.
				assert wide(field) == 240.0 && !(text is none) && wide(text) == 240.0 unless text is none
				field.flip()
				lay()
				let list = field.find<Menu>()
				assert !(list is none) && wide(list) >= 240.0 unless list is none
			}
			if !(plain is none) {
				let text = plain.find<TextField>()
				assert wide(plain) == 200.0 && !(text is none) && wide(text) == 200.0 unless text is none
			}
		}

		// A context menu taller than the window is held inside it and scrolls.
		@test()
		def TestLongContextMenuScrolls() {
			let page = LongContextMenu()
			let scene = new Scene(page)
			let window = new Size<Pixels>(400(px), 300(px))
			let lay = def () {
				scene.arrange(window)
				scene.arrange(window)
			}
			lay()
			let menu = page.menu
			assert !(menu is none)
			if !(menu is none) {
				menu.context(new Point<Pixels>(10(px), 10(px)))
				lay()
				let frame = menu.style.geom.frame
				assert float(frame.height) > 0.0 && float(frame.top) >= 0.0 && float(frame.bottom) <= 300.0
				let whole component = page
				scene.key(KeyEvent{target: whole, key: Key.Up})
				lay()
				assert scene.focused() == menu.childNodes[39] && float(menu.offset.y) > 0.0
			}
		}
	}
}
