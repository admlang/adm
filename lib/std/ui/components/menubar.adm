partial module std.ui.components {
	use (
		std.math.geom::(Corners, Edges, Rect, Size)
		std.ui::(Key, KeyEvent, Limit, MouseButton, PointerEvent, PointerPhase, RenderContext, Theme, UI)
		std.ui.paint
		std.ui.styles::*
		std.units::(Extent, Pixels)
	)

	// The style of a `MenuBar`: its box, its background, its titles in a row, the look of
	// its text, and how it takes the pointer and the keyboard.
	style MenuBarStyle {
		Box
		Background
		Layout
		Typography
		Interaction
		width = fill
		height = theme.metrics.controlHeight + theme.metrics.unit
		background = new BackgroundFill(theme.palette.surface)
		arrange = Arrange.Row
		align = Align{horizontal: Alignment.Start, vertical: Alignment.Fill}
	}

	// One title of a `MenuBar`: a part of it, the titles in order. The bar takes the
	// pointer and tells the title what it found: the pointer over it (`over`), its menu
	// open (`open`), the keys on it while the keyboard focus shows (`ringed`).
	internal component MenuTitle {
		type {
			@input(value = true)
			title string = ""

			@input
			@state
			over bool = false

			@input
			@state
			open bool = false

			@input
			@state
			ringed bool = false

			block ?paint.TextBlock = none
			look  Theme = UI.theme()

			def titled() paint.TextBlock {
				let made = labelBlock(block, title, style.font, style.foreground, style.paragraph, look.palette.foreground)
				block = made
				return made
			}

			def measure(limit Limit) Size<Pixels> {
				return titled().measure(limit)
			}

			def render(ctx RenderContext) {
				ctx.outerShadows()
				ctx.background()
				ctx.borders()
				paint.drawBlock(ctx.draw, titled(), ctx.geometry.content.toFloat(), Align{horizontal: Alignment.Center, vertical: Alignment.Center}, ctx.direction == Direction.RightToLeft, ctx.scale)
				ctx.innerShadows()
			}
		}

		view {}

		style {
			Box
			Control
			padding = new Edges<Extent>(0(px), theme.metrics.unit * 2.5)
			// Its fill stops short of the bar's edges.
			margin     = new Edges<Extent>(2(px), 0(px))
			radius     = new Corners<Extent>(theme.metrics.radius)
			foreground = theme.palette.foreground
			hitTest    = HitTest.None
			on         = {
				over:     {background: new BackgroundFill(theme.palette.surface.mix(theme.palette.hover))},
				open:     {background: new BackgroundFill(theme.palette.surface.mix(theme.palette.pressed))},
				ringed:   {outline: Ring{width: theme.metrics.focusWidth, paint: theme.palette.focus, offset: -theme.metrics.focusWidth}},
				disabled: {foreground: theme.palette.foregroundDisabled},
			}
		}
	}

	// The menus of a window in a row of titles:
	// `MenuBar() { Menu(title = "File") { MenuItem(...) }; Menu(title = "Edit") { ... } }`.
	// A press on a title opens its menu under it; with one open, moving the pointer to
	// another title or pressing Left or Right opens that one. With the focus on the bar,
	// Left and Right move along the titles and Down, Enter or Space open one.
	component MenuBar {
		type {
			// The menus' titles as last read.
			names   string[]
			// The menu that is open, the title under the pointer and the one the keys are
			// on; -1 for none.
			open    int = -1
			over    int = -1
			current int

			def new() {
				focusable = true
				tabStop   = true
			}

			// Whether it is laid out right to left.
			def rtl() bool {
				return style.geom.direction == Direction.RightToLeft
			}

			// The menus' titles, in order: the same array until one changes.
			def titles() string[] {
				let at = 0
				let same = true
				for let child in childNodes {
					if child is Menu {
						same = false when at >= names.len() || names[at] != child.title
						at++
					}
				}
				return names when same && at == names.len()
				let now string[]
				for let child in childNodes {
					now.push(child.title) when child is Menu
				}
				names = now
				return names
			}

			// One of its menus closed itself: a pick, Escape, a press elsewhere.
			def menuDismissed(menu component) {
				let at = 0
				for let child in childNodes {
					let closed = child == menu
					if child is Menu {
						if closed && at == open {
							open = -1
							redraw()
						}
						at++
					}
				}
			}

			// The titles: its parts of that kind, in order.
			def parts() component[] {
				let found component[]
				for let child in childNodes {
					found.push(child) when child is MenuTitle
				}
				return found
			}

			// Where title `i` was laid out, in the bar.
			def slot(i int) Rect {
				let held = parts()
				return Rect{} when i < 0 || i >= held.len()
				let (own, part) = (style.geom.frame, held[i].style.geom.frame)
				let (left, top) = (float(part.left) - float(own.left), float(part.top) - float(own.top))
				return Rect{left: left, top: top, right: left + float(part.width), bottom: top + float(part.height)}
			}

			// Shows the open menu under its title and hides the others.
			def sync() {
				let wide = float(style.geom.frame.width)
				let at = 0
				for let child in childNodes {
					if child is Menu {
						let under = slot(at)
						child.hang(at == open, rtl() ?? (wide - under.right, under.left))
						at++
					}
				}
			}

			// Opens menu `index`; -1 closes the open one.
			def show(index int) {
				open    = index >= names.len() ?? (-1, index)
				current = open when open >= 0
				sync()
				redraw()
			}

			// The title at a horizontal position in the bar, -1 for none.
			def titleAt(x float) int {
				for let i = 0; i < parts().len(); i++ {
					let part = slot(i)
					return i when x >= part.left && x < part.right
				}
				return -1
			}

			def pointer(e PointerEvent) bool {
				return false when disabled
				let (x, y) = (float(e.position.x), float(e.position.y))
				// Events of an open menu's lines pass through here: only the bar's own count.
				let inside = y >= 0.0 && y < float(style.geom.frame.height)
				match e.phase {
					case PointerPhase.Move, PointerPhase.Enter:
						let at = inside ?? (titleAt(x), -1)
						if at != over {
							over = at
							redraw()
						}
						// With a menu open, the pointer on another title opens that one.
						show(at) when open >= 0 && at >= 0 && at != open
						return false
					case PointerPhase.Leave, PointerPhase.Cancel:
						if over != -1 {
							over = -1
							redraw()
						}
						return false
					case PointerPhase.Down:
						return false when e.button != MouseButton.Left || !inside
						let at = titleAt(x)
						return false when at < 0
						show(at == open ?? (-1, at))
						return true
					default:
						return false
				}
			}

			def key(e KeyEvent) bool {
				return false when !e.down
				let count = titles().len()
				return false when disabled || count == 0
				let step = rtl() ?? (-1, 1)
				match e.key {
					case Key.Left:
						current = (current - step + count) % count
					case Key.Right:
						current = (current + step + count) % count
					case Key.Down, Key.Enter, Key.KeypadEnter, Key.Space:
						// A key inside an open menu is the menu's.
						return false when open >= 0
						show(current)
						return true
					default:
						return false
				}
				// With a menu open the keys move to the menu beside it.
				if open >= 0 {
					show(current)
				} else {
					redraw()
				}
				return true
			}

			def attached() {
				sync()
			}
		}

		// Its parts: the menus in its block, `line` along its bottom, and a title per menu.
		view {
			children()
			StripLine(ref = line)
			for let (i, name) in titles() {
				MenuTitle(name, over = i == over && !disabled, open = i == open, ringed = i == current && focusVisible)
			}
		}

		style MenuBarStyle
	}
}
