partial module std.ui.components {
	use (
		std.math.geom::(Rect, Size)
		std.ui::(Key, KeyEvent, Limit, MouseButton, PointerEvent, PointerPhase, RenderContext, Theme, UI)
		std.ui.paint
		std.ui.styles::*
		std.units::Pixels
	)

	// The style of a `MenuBar`: its box, its background, the look of its titles, and how
	// it takes the pointer and the keyboard.
	style MenuBarStyle {
		Box
		Background
		Typography
		Interaction
		width = fill
		height = theme.metrics.controlHeight + theme.metrics.unit
		background = new BackgroundFill(theme.palette.surface)
	}

	// The menus of a window in a row of titles:
	// `MenuBar() { Menu(title = "File") { MenuItem(...) }; Menu(title = "Edit") { ... } }`.
	// A press on a title opens its menu under it; with one open, moving the pointer to
	// another title or pressing Left or Right opens that one. With the focus on the bar,
	// Left and Right move along the titles and Down, Enter or Space open one.
	component MenuBar {
		type {
			look    Theme = UI.theme()
			// The titles and their slots, and the titles as last laid out.
			row     TitleRow = new TitleRow()
			names   string[]
			// The menu that is open, the title under the pointer and the one the keys are
			// on; -1 for none.
			open    int = -1
			over    int = -1
			current int

			def new() {
				focusable = true
				tabStop   = true
			}

			// Whether it is laid out right to left.
			def rtl() bool {
				return style.geom.direction == Direction.RightToLeft
			}

			// The menus' titles, in order: the same array until one changes.
			def titles() string[] {
				let at = 0
				let same = true
				for let child in childNodes {
					if child is Menu {
						same = false when at >= names.len() || names[at] != child.title
						at++
					}
				}
				return names when same && at == names.len()
				let now string[]
				for let child in childNodes {
					now.push(child.title) when child is Menu
				}
				names = now
				return names
			}

			// One of its menus closed itself: a pick, Escape, a press elsewhere.
			def menuDismissed(menu component) {
				let at = 0
				for let child in childNodes {
					let closed = child == menu
					if child is Menu {
						if closed && at == open {
							open = -1
							redraw()
						}
						at++
					}
				}
			}

			// Brings the titles and their slots in step with the menus and the theme.
			def lay() {
				let palette = look.palette
				row.lay(titles(), -1, !disabled, palette.foreground, palette.foreground, palette.foregroundDisabled, float(look.metrics.unit) * 2.5, style.font, style.foreground, style.paragraph)
			}

			// Shows the open menu under its title and hides the others.
			def sync() {
				lay()
				let at = 0
				for let child in childNodes {
					if child is Menu {
						child.hang(at == open, at < row.edges.len() ?? (row.edges[at], 0.0))
						at++
					}
				}
			}

			// Opens menu `index`; -1 closes the open one.
			def show(index int) {
				open    = index >= names.len() ?? (-1, index)
				current = open when open >= 0
				sync()
				redraw()
			}

			// The title at a horizontal position in the bar, -1 for none.
			def titleAt(x float) int {
				return row.at(rtl() ?? (float(style.geom.frame.width) - x, x))
			}

			def measure(limit Limit) Size<Pixels> {
				lay()
				return new Size<Pixels>(row.width() * 1(px), float(look.metrics.controlHeight) * 1(px))
			}

			def pointer(e PointerEvent) bool {
				return false when disabled
				let (x, y) = (float(e.position.x), float(e.position.y))
				// Events of an open menu's lines pass through here: only the bar's own count.
				let inside = y >= 0.0 && y < float(style.geom.frame.height)
				match e.phase {
					case PointerPhase.Move, PointerPhase.Enter:
						let at = inside ?? (titleAt(x), -1)
						if at != over {
							over = at
							redraw()
						}
						// With a menu open, the pointer on another title opens that one.
						show(at) when open >= 0 && at >= 0 && at != open
						return false
					case PointerPhase.Leave, PointerPhase.Cancel:
						if over != -1 {
							over = -1
							redraw()
						}
						return false
					case PointerPhase.Down:
						return false when e.button != MouseButton.Left || !inside
						let at = titleAt(x)
						return false when at < 0
						show(at == open ?? (-1, at))
						return true
					default:
						return false
				}
			}

			def key(e KeyEvent) bool {
				return false when !e.down
				let count = titles().len()
				return false when disabled || count == 0
				let step = rtl() ?? (-1, 1)
				match e.key {
					case Key.Left:
						current = (current - step + count) % count
					case Key.Right:
						current = (current + step + count) % count
					case Key.Down, Key.Enter, Key.KeypadEnter, Key.Space:
						// A key inside an open menu is the menu's.
						return false when open >= 0
						show(current)
						return true
					default:
						return false
				}
				// With a menu open the keys move to the menu beside it.
				if open >= 0 {
					show(current)
				} else {
					redraw()
				}
				return true
			}

			def attached() {
				sync()
			}

			def render(ctx RenderContext) {
				lay()
				let palette = look.palette
				let frame = ctx.geometry.frame
				let (width, height) = (float(frame.width), float(frame.height))
				let mirrored = ctx.direction == Direction.RightToLeft
				ctx.background()
				for let (i, block) in row.blocks {
					let slot = row.slot(i, width, height, mirrored)
					let lit = i == open || (i == over && !disabled)
					ctx.draw.fill(Rect{left: slot.left, top: 2.0, right: slot.right, bottom: height - 2.0}, float(look.metrics.radius), palette.surface.mix(i == open ?? (palette.pressed, palette.hover))) when lit
					paint.drawBlock(ctx.draw, block, slot, Align{horizontal: Alignment.Center, vertical: Alignment.Center}, mirrored, ctx.scale)
					drawFocusRing(ctx, look, Rect{left: slot.left + 3.0, top: 3.0, right: slot.right - 3.0, bottom: height - 3.0}, float(look.metrics.radius)) when i == current && focusVisible
				}
				let line = float(look.metrics.borderWidth)
				ctx.draw.fill(Rect{left: 0.0, top: height - line, right: width, bottom: height}, palette.divider)
				ctx.childNodes()
			}
		}

		view {
			children()
		}

		style MenuBarStyle
	}
}
