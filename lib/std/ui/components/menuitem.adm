partial module std.ui.components {
	use (
		std.math.geom::(Axes, Corners, Edges, Rect, Size)
		std.ui::(Action, Limit, RenderContext, Theme, UI)
		std.ui.paint
		std.gfx.color::Color
		std.ui.runtime::(FoundIcon, Hotkey, HotkeySlot, drawIcon)
		std.ui.styles::*
		std.units::(Extent, Pixels)
	)

	// What holds the lines of a menu and closes when one of them is picked.
	internal interface MenuSurface {
		// One of its lines was picked.
		def picked()
	}

	// Draws the face the lines of a menu share: the fill behind a line that is lit (none:
	// no fill), then in the room before the label a check mark when `ticked`, else the
	// icon, then the label. What a line shows at its end is the caller's.
	internal def drawLineFace(ctx RenderContext, look Theme, lit ?Color, ink Color, ticked bool, found ?FoundIcon, label paint.TextBlock) {
		let box = frameBox(ctx)
		ctx.draw.fill(box, float(look.metrics.radius).min(4.0), lit) unless lit is none
		drawLineMark(ctx, look, ink, ticked, found)
		paint.drawBlock(ctx.draw, label, ctx.geometry.content.toFloat(), Align{horizontal: Alignment.Start, vertical: Alignment.Center}, ctx.direction == Direction.RightToLeft, ctx.scale)
	}

	// Draws a line's check mark when `ticked`, else its icon, in the room before its
	// content.
	internal def drawLineMark(ctx RenderContext, look Theme, ink Color, ticked bool, found ?FoundIcon) {
		let box = frameBox(ctx)
		let rtl = ctx.direction == Direction.RightToLeft
		let left = rtl ?? (box.right - float(look.metrics.unit) - markSide, float(look.metrics.unit))
		if ticked {
			// The check mark of a `Checkbox`, in the label's colour.
			drawTick(ctx, left, (box.bottom - markSide) / 2.0, markSide, ink)
		} else if !(found is none) {
			let side = float(look.metrics.iconSize)
			let across = left + (markSide - side) / 2.0
			drawIcon(ctx.draw, found, Rect{left: across, top: (box.bottom - side) / 2.0, right: across + side, bottom: (box.bottom + side) / 2.0}, ink)
		}
	}

	// The style of a `MenuItem`: no fill of its own, the menu's surface a step further
	// under the pointer and while it shows the keyboard focus, one more while held down;
	// its label and icon in the theme's foreground, the disabled one while not enabled.
	style MenuItemStyle {
		Box
		Control
		Layout
		// What `start` and `end` give stands in a row with the label.
		arrange = Arrange.Row
		gap = new Axes<Extent>(theme.metrics.unit * 2.0)
		align = Align{horizontal: Alignment.Start, vertical: Alignment.Center}
		foreground = theme.palette.foreground
		on = {
			hover:        {background: overlayFill(theme.palette.hover)},
			focusVisible: {background: overlayFill(theme.palette.hover)},
			pressed:      {background: overlayFill(theme.palette.pressed)},
			disabled:     {foreground: theme.palette.foregroundDisabled},
		}
		// Room for the check mark before the label.
		padding = new Edges<Extent>(0(px), theme.metrics.unit * 2.0, 0(px), theme.metrics.unit * 2.0 + markSide * 1(px))
		minHeight = theme.metrics.controlHeight
		width = fill
		radius = new Corners<Extent>(float(theme.metrics.radius).min(4.0) * 1(px))
	}

	// One line of a menu or a list of choices:
	// `MenuItem(label = "Save", icon = "save", shortcut = "Ctrl+S", onActivate = save)`.
	// It is as wide as the menu it is in; a click, Space or Enter picks it.
	component MenuItem {
		type {
			// The text of the line.
			@input(value = true)
			label string = ""

			// Shows a check mark before the label.
			@input
			checked bool = false

			// The name of an icon shown before the label, where the check mark goes; a
			// checked line shows the mark. Empty: none.
			@input
			icon string = ""

			// The keys that do the same, shown at the line's end: "Ctrl+S", "F2",
			// "Ctrl+Shift+Del". Pressed anywhere in the window, when no component took
			// them, they pick the line; in a `ContextMenu` they are only shown, for keys
			// the menu's target takes itself.
			@input
			shortcut string = ""

			// What stands before the label in place of `icon`, and at the line's end in
			// place of the shortcut's text (whose keys still pick the line):
			// `MenuItem("Sync") { end = view { Badge("3") } }`.
			@input
			start ?view = none

			@input
			end ?view = none

			// The icon as looked up last, and the shortcut's text as set last.
			picture IconSlot = new IconSlot()
			keys    ?paint.TextBlock = none
			// The keys the shortcut's text names.
			combo   HotkeySlot = new HotkeySlot()

			// Runs when the line is picked.
			@input
			onActivate ?(def()) = none

			// The action the line runs, an `@action` method of a controller
			// (`MenuItem(action = close)`): its label, icon and shortcut are the line's
			// where the line gives none, and the line is enabled while the action is.
			@input
			action ?Action = none

			// Tells every listener the line was picked, after the handler ran: heard with
			// `@on(MenuItem.activated)`.
			@emit()
			def activated() bool {
				return true
			}

			block ?paint.TextBlock = none
			look  Theme = UI.theme()


			// Picks the line as a click does, and closes the menu it is in.
			def pick() {
				return when disabled
				let tell = onActivate
				tell() unless tell is none
				let act = action
				if !(act is none) {
					let _ = act.run()
				}
				activated()
				let me component = self
				pickedAbove(me)
			}

			// Its label, icon and keys: its own, else its action's.
			def shownLabel() string {
				let act = action
				return label when label != "" || act is none
				return act.label
			}

			def shownIcon() string {
				let act = action
				return icon when icon != "" || act is none
				return act.icon
			}

			def shownShortcut() string {
				let act = action
				return shortcut when shortcut != "" || act is none
				return act.shortcut
			}

			// Enabled while its action is.
			def followAction() {
				let act = action
				return when act is none
				let can = act.enabled
				enabled = can when enabled != can
			}

			def current() paint.TextBlock {
				followAction()
				let made = labelBlock(block, shownLabel(), style.font, em * 1(px), style.foreground, style.paragraph, look.palette.foreground, decoration = style.decoration)
				block = made
				return made
			}

			// The shortcut's text block, in the muted colour.
			def hint() paint.TextBlock {
				// A shortcut that is shown and cannot be read is reported when first shown.
				let _ = combo.get(shownShortcut())
				let palette = look.palette
				let made = labelBlock(keys, shownShortcut(), style.font, em * 1(px), none, style.paragraph, !disabled ?? (palette.foregroundMuted, palette.foregroundDisabled), decoration = style.decoration)
				keys = made
				return made
			}

			def hotkey() ?Hotkey {
				return combo.get(shownShortcut())
			}

			def hotkeyPressed() {
				pick()
			}

			// The label, and after it the shortcut with room between the two.
			def measure(limit Limit) Size<Pixels> {
				let text = current().measure(limit)
				return text when shownShortcut() == ""
				let aside = hint().measure(Limit{})
				return new Size<Pixels>(text.width + aside.width + look.metrics.unit * 6.0, float(text.height).max(float(aside.height)) * 1(px))
			}

			// A click picks it.
			def clicked() {
				pick()
			}

			// A slot is given: the label and what stands beside it are children in a row.
			def slotted() bool {
				return !(start is none) || !(end is none)
			}

			def render(ctx RenderContext) {
				let palette = look.palette
				ctx.outerShadows()
				ctx.background()
				ctx.borders()
				if slotted() {
					// The check mark stays in the room before the content.
					drawLineMark(ctx, look, inkOf(style.foreground, palette.foreground), checked, none)
					ctx.childNodes()
					ctx.innerShadows()
					return
				}
				drawLineFace(ctx, look, none, inkOf(style.foreground, palette.foreground), checked, picture.get(shownIcon()), current())
				// The shortcut at the line's end.
				paint.drawBlock(ctx.draw, hint(), ctx.geometry.content.toFloat(), Align{horizontal: Alignment.End, vertical: Alignment.Center}, ctx.direction == Direction.RightToLeft, ctx.scale) when shownShortcut() != ""
				ctx.innerShadows()
			}
		}

		view {
			if slotted() {
				if start is none {
					if shownIcon() != "" {
						Icon(shownIcon())
					}
				} else {
					start()
				}
				if shownLabel() == "" {
					Spacer()
				} else {
					Text(shownLabel(), style = {width: fill})
				}
				if end is none {
					if shownShortcut() != "" {
						Text(shownShortcut(), style = {foreground: disabled ?? (look.palette.foregroundDisabled, look.palette.foregroundMuted)})
					}
				} else {
					end()
				}
			}
		}

		style MenuItemStyle
	}
}
