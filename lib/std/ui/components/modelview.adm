partial module std.ui.components {
	use (
		std.formats.image
		std.gfx.canvas::(ModelPicture)
		std.gfx.color::(Color, RGBA)
		std.gfx.scene::(PreparedModel, Viewpoint)
		std.math::(sqrt)
		std.time
		std.ui::RenderContext
		std.ui.styles::*
	)

	// How long a picture of a view that moves may take to draw on the CPU: a
	// picture that would take longer is drawn smaller and stretched.
	internal const modelViewBudget = 0.04

	// What a drawing task of a ModelView came to: the picture it was asked
	// for and at which part of its size, the image (none when the task was
	// cancelled or the model changed meanwhile) and how long it took.
	internal struct ModelViewDrawn {
		ticket  int
		asked   ModelPicture
		part    float
		picture ?image.Image
		took    duration
	}

	// A 3D model seen from a viewpoint: `ModelView(model = prepared, viewpoint = eye)`,
	// with a `std.gfx.scene.PreparedModel` and a `Viewpoint`. It shows the model over its
	// own background and fills the room it is given unless its style sets a size. Without
	// a viewpoint it frames the whole model.
	//
	// The view only shows: turning, moving and zooming are the application's, which
	// changes the viewpoint from the pointer and the wheel (`PreparedModel.pick` gives the
	// point under the pointer). A viewpoint changed in place is the same object to the
	// view, so call `redraw()` on it afterwards, or pass a copy (`Viewpoint.copy()`). A
	// change of the model (`pose`, `hide`, `lines`, ...) needs `redraw()` too.
	//
	// A renderer that draws models on a GPU draws the picture in every frame. Elsewhere
	// the picture is drawn on a task and shown when it is ready, so the window never
	// waits for it: while the viewpoint moves the picture is drawn smaller, as small as
	// keeps it to a twenty-fifth of a second, and stretched, then drawn at its full size
	// once the viewpoint rests.
	component ModelView {
		type {
			// The model; none shows nothing.
			@input(value = true)
			model ?PreparedModel = none

			// Where the model is seen from; none frames the whole model.
			@input
			viewpoint ?Viewpoint = none

			// Pixels drawn per pixel along each axis, 1 to 4: 2 smooths edges.
			@input
			samples int = 1

			// What the drawing tasks hand back; `render` takes it on the drawing task.
			internal done      channel<ModelViewDrawn> = new channel<ModelViewDrawn>(size = 4)
			// The last picture drawn, what it shows, and whether at its full size.
			internal shown     ?image.Image = none
			internal shownOf   ?ModelPicture = none
			internal sharp     bool = false
			// The picture being drawn: its task, what it was asked for, whether at the
			// full size, and the ticket that tells its result from an older task's.
			internal busy      bool = false
			internal drawing   async none
			internal drawingOf ?ModelPicture = none
			internal whole     bool = false
			internal ticket    int = 0
			// Seconds a drawn pixel took in the last picture, 0 before the first.
			internal cost      float = 0.0

			def render(ctx RenderContext) {
				ctx.outerShadows()
				ctx.background()
				ctx.borders()
				show(ctx)
				ctx.childNodes()
				ctx.innerShadows()
			}

			// Draws the model into the content box.
			internal def show(ctx RenderContext) {
				let prepared = model
				return when prepared is none
				let box = ctx.geometry.content.toFloat()
				let (wide, high) = (box.right - box.left, box.bottom - box.top)
				return when wide <= 0.0 || high <= 0.0
				let from = prepared.framing(wide / high)
				let given = viewpoint
				from = given unless given is none
				if ctx.draw.models {
					ctx.draw.drawModel(prepared, from, box, samples)
					return
				}
				take()
				let w = int((wide * ctx.scale).round()).max(1)
				let h = int((high * ctx.scale).round()).max(1)
				let want = ModelPicture{model: prepared, from: from.copy(), width: w, height: h, samples: samples.clamp(1, 4), changes: prepared.changes()}
				let picture = shown
				ctx.draw.drawImage(picture, box) unless picture is none
				let current = shows(shownOf, want)
				return when current && sharp
				// A view that rests gets its full picture; one that moved gets a part
				// small enough for the budget, by what the last picture cost.
				let part = 1.0
				if !current {
					let full = cost * float(w * h * want.samples * want.samples)
					part = 0.4
					part = full > modelViewBudget ?? (sqrt(modelViewBudget / full).clamp(0.2, 1.0), 1.0) when cost > 0.0
				}
				if busy {
					return when shows(drawingOf, want) && whole == (part >= 1.0)
					// A full picture under way is of a view that has moved on: its task
					// is stopped. A reduced one is short, and is left to end, so a view
					// that keeps moving keeps getting pictures.
					return unless whole
					drawing.cancel()
				}
				ticket++
				busy      = true
				whole     = part >= 1.0
				drawingOf = want
				drawing   = async<tasks> drawLater(want, part, ticket)
			}

			// Takes what the drawing tasks finished: the newest task's picture is
			// shown; an older task's is dropped.
			internal def take() {
				for done.len() > 0 {
					let got = <-done
					continue when got.ticket != ticket
					busy = false
					let picture = got.picture
					continue when picture is none
					shown   = picture
					shownOf = got.asked
					sharp   = got.part >= 1.0
					let drawn = picture.size()
					let pixels = float(drawn.width) * float(drawn.height) * float(got.asked.samples * got.asked.samples)
					cost = got.took.seconds() / pixels when pixels > 0.0
				}
			}

			// Whether a picture asked for as `held` is the one `want` asks for.
			internal def shows(held ?ModelPicture, want ModelPicture) bool {
				return false when held is none
				return held.model == want.model && held.changes == want.changes && held.width == want.width && held.height == want.height && held.samples == want.samples && held.from.equals(want.from)
			}

			// Draws `part` of the picture's size on this task and hands it back.
			internal async def drawLater(asked ModelPicture, part float, ticket int) {
				let w = int((float(asked.width) * part).round()).max(1)
				let h = int((float(asked.height) * part).round()).max(1)
				let started = time.now()
				let picture = asked.model.render(w, h, asked.from, new Color(RGBA{r: 0, g: 0, b: 0, a: 0}), asked.samples)
				done <- ModelViewDrawn{ticket: ticket, asked: asked, part: part, picture: picture, took: time.since(started)}
				redraw()
			}
		}

		view {}

		style {
			PanelStyle
			width  = fill
			height = fill
		}
	}
}
