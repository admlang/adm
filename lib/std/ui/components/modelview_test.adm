partial module std.ui.components {
	use (
		std.formats.models::(Camera, Material, Mesh, Model, Node, Primitive)
		std.gfx.canvas
		std.gfx.color::(Color)
		std.gfx.scene::(PreparedModel, Viewpoint)
		std.math.geom::(Size, Vec3)
		std.testing
		std.time
		std.ui.runtime::Scene
		std.ui.styles::*
		std.units::Pixels
	)

	// A green unit square facing +z, prepared.
	internal def modelViewSquare() PreparedModel {
		let model = new Model("test")
		let m = new Material("m")
		m.baseColor = new Color("#00ff00")
		m.unlit = true
		model.materials.push(m)
		let mesh = new Mesh("square")
		let p = mesh.add(new Primitive())
		p.material = m
		p.positions = float32[-0.5, -0.5, 0, 0.5, -0.5, 0, 0.5, 0.5, 0, -0.5, 0.5, 0]
		p.indices = uint32[0, 1, 2, 0, 2, 3]
		model.meshes.push(mesh)
		let node = new Node("square")
		node.mesh = mesh
		model.nodes.push(node)
		return new PreparedModel(model)
	}

	// Three units in front of the origin, looking at it.
	internal def modelViewFront() Viewpoint {
		let lens = new Camera()
		lens.yfov = 0.5
		return new Viewpoint(new Vec3(0, 0, 3), new Vec3(0, 0, 0), new Vec3(0, 1, 0), lens)
	}

	// A model view of 120 by 120 pixels over a dark page.
	component ModelPage {
		type {
			prepared PreparedModel = modelViewSquare()
			eye      Viewpoint = modelViewFront()

			def new() {
				style.width = 120(px)
				style.height = 120(px)
			}
		}

		view {
			ModelView(prepared, viewpoint = eye, ref = shownModel)
		}

		style StageStyle
	}

	check "ModelView" {
		// Whether the pixel of the surface shows the square's green.
		internal def green(surface canvas.Canvas, x int, y int) bool {
			let i = (y * surface.width + x) * 4
			return surface.pixels[i] < 40 && surface.pixels[i + 1] > 215 && surface.pixels[i + 2] < 40
		}

		// Paints the page until the pixel is the square's green (or is not, with
		// `wanted` false), for at most two seconds: the picture is drawn on a task.
		internal def paintUntil(scene Scene, surface canvas.Canvas, x int, y int, wanted bool = true) bool {
			let size = new Size<Pixels>(120(px), 120(px))
			for let turn = 0; turn < 400; turn++ {
				surface.clear(new Color("#000000"))
				scene.arrange(size)
				scene.paint(surface)
				return true when green(surface, x, y) == wanted
				time.sleep(5ms)
			}
			return false
		}

		// On a renderer that does not draw models itself the picture comes from a
		// task: the page is painted at once without it, and shows it when it is ready,
		// first small and stretched, then at its full size.
		@test()
		def TestThePictureComesWhenItIsDrawn() {
			let page = ModelPage()
			let scene = new Scene(page)
			let surface = new canvas.Canvas(120, 120)
			let size = new Size<Pixels>(120(px), 120(px))
			scene.arrange(size)
			scene.arrange(size)
			scene.paint(surface)
			assert !green(surface, 60, 60)
			assert paintUntil(scene, surface, 60, 60)
			// At its full size the square's edge is where the model's own picture has
			// it.
			let own = page.prepared.render(120, 120, page.eye)
			assert !(own is none)
			return when own is none
			let edge = 0
			for edge < 60 && own.raw()[(60 * 120 + edge) * 4 + 3] == 0 {
				edge++
			}
			assert edge > 10 && edge < 50
			assert paintUntil(scene, surface, edge - 2, 60, false)
			assert green(surface, edge + 2, 60)
			scene.close()
		}

		// A viewpoint that moved and a model that changed show once the view is
		// asked to draw again.
		@test()
		def TestItFollowsTheViewpointAndTheModel() {
			let page = ModelPage()
			let scene = new Scene(page)
			let surface = new canvas.Canvas(120, 120)
			assert paintUntil(scene, surface, 60, 60)
			let shown = page.shownModel
			assert shown is ModelView
			return unless shown is ModelView
			// From behind, the single-sided square is not seen.
			page.eye.eye = new Vec3(0, 0, -3)
			shown.redraw()
			assert paintUntil(scene, surface, 60, 60, false)
			page.eye.eye = new Vec3(0, 0, 3)
			shown.redraw()
			assert paintUntil(scene, surface, 60, 60)
			// Hidden, the square leaves the picture.
			page.prepared.hide(page.prepared.model.nodes[0])
			shown.redraw()
			assert paintUntil(scene, surface, 60, 60, false)
			scene.close()
		}
	}
}
