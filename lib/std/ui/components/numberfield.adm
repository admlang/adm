partial module std.ui.components {
	use (
		std.math.geom::Axes
		std.ui.frames::askFrame
		std.ui::(Key, KeyEvent, RenderContext, TextKind)
		std.ui.styles::*
		std.units::Extent
	)

	// Whether text is a number written out whole: an optional sign, digits, at most one
	// point, at least one digit.
	internal def numberText(text string) bool {
		let digits = 0
		let points = 0
		for let (i, ch) in text {
			if ch >= '0' && ch <= '9' {
				digits++
				continue
			}
			if ch == '.' {
				points++
				continue
			}
			return false unless i == 0 && (ch == '-' || ch == '+')
		}
		return digits > 0 && points <= 1
	}

	// A number typed or stepped: `NumberField(value = count, min = 0.0, max = 10.0, onChange = setCount)`.
	// The field takes digits; the two arrows at its end, Up and Down change the number by
	// `step`. A
	// number typed inside the limits is taken as it is typed; other text changes nothing
	// until Enter is pressed or the focus leaves, when a number is brought inside the
	// limits and rounded to `decimals`, and the field shows the number as it is.
	component NumberField {
		type {
			// The number.
			@input(value = true, bind = true)
			value float = 0.0

			// The least and the most it may be; none: no limit.
			@input
			min ?float = none

			@input
			max ?float = none

			// What the buttons and the arrows change it by.
			@input
			step float = 1.0

			// How many digits are shown after the point.
			@input
			decimals int = 0

			// Runs with the new number when the user changes it.
			@input
			onChange ?(def(float)) = none

			// Tells every listener its new value, after the handler ran: heard with
			// `@on(NumberField.changed)`.
			@emit()
			def changed(now float) float {
				return now
			}

			// What the field shows, and the number that text was last made from or read as.
			text  string
			known float
			// Whether the focus was in it when it was drawn last.
			held  bool

			def new() {
				text  = written(value)
				known = value
			}

			// The number as the field writes it.
			def written(number float) string {
				return ("%." + decimals.max(0).str() + "f").format(number)
			}

			// The number rounded to `decimals` digits after the point and kept inside `min`
			// and `max`.
			def bounded(number float) float {
				let scale = 1.0
				for let i = 0; i < decimals.max(0); i++ {
					scale *= 10.0
				}
				let to = (number * scale).round() / scale
				let least = min
				to = to.max(least) unless least is none
				let most = max
				to = to.min(most) unless most is none
				return to
			}

			// The field's text: the number again when the caller changed it.
			def shown() string {
				if value != known {
					known = value
					text  = written(value)
				}
				return text
			}

			// Takes a number as the user set it and tells the caller when it is another.
			def take(number float) {
				let to = bounded(number)
				known = to
				return when to == value
				value = to
				let tell = onChange
				tell(to) unless tell is none
				changed(to)
			}

			// The field's text changed: a number the field can hold as written is taken,
			// anything else waits for `settle` (text on its way to a number, a number
			// outside the limits or with more digits than are shown).
			def typed(now string) {
				text = now
				let plain = now.trim()
				return when !numberText(plain)
				let number = parseFloat<float>(plain)
				take(number) when bounded(number) == number
			}

			// Enter, or the focus left: a typed number is taken, brought inside the limits
			// and rounded, and the field shows the number as it is.
			def settle() {
				let plain = text.trim()
				take(parseFloat<float>(plain)) when numberText(plain)
				text = written(value)
			}

			// Changes the number by `by` steps, as a button does.
			def nudge(by float) {
				return when disabled
				take(value + step * by)
				text = written(value)
			}

			// One of the field's arrows: 1 up, -1 down.
			def stepBy(by int) {
				nudge(float(by))
			}

			def up() {
				nudge(1.0)
			}

			def down() {
				nudge(-1.0)
			}

			def key(e KeyEvent) bool {
				return false when !e.down
				return false when disabled
				match e.key {
					case Key.Up:
						up()
					case Key.Down:
						down()
					default:
						return false
				}
				return true
			}

			def render(ctx RenderContext) {
				// The frame the focus leaves it, what was typed is settled.
				if held && !focusWithin {
					settle()
					// The settled number shows once the views ran again.
					askFrame(true)
				}
				held = focusWithin
				ctx.outerShadows()
				ctx.background()
				ctx.borders()
				ctx.childNodes()
				ctx.innerShadows()
			}
		}

		view {
			TextField(value = shown(), kind = TextKind.Decimal, enabled = !disabled, onStep = stepBy, onChange = typed, onSubmit = settle)
		}

		style {
			RowStyle
			arrange = Arrange.Row
			gap     = new Axes<Extent>(2(px))
		}
	}
}
