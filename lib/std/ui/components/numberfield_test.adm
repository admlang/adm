partial module std.ui.components {
	use (
		std.math.geom::Size
		std.testing
		std.ui.runtime::Scene
		std.ui.styles::*
		std.units::Pixels
	)

	// Two number fields given a width: one alone, one with a unit after it.
	component Timings {
		type {
			told float[]

			def changed(now float) {
				told.push(now)
			}
		}

		view {
			Column(gap = 8(px), style = {width: 400(px)}) {
				NumberField(value = 5.0, onChange = changed, style = {width: 380(px)}, ref = plain)
				NumberField(value = 5.0, style = {width: 380(px)}, ref = withUnit) {
					Text("min", ref = unitText)
				}
			}
		}

		style StageStyle
	}

	check "NumberField" {
		// The text box takes the width the number field is given, less the controls in
		// its block.
		@test()
		def TestNumberFieldTakesItsWidth() {
			let page = Timings()
			let scene = new Scene(page)
			let size = new Size<Pixels>(400(px), 200(px))
			scene.arrange(size)
			scene.arrange(size)
			let plain = page.plain
			let withUnit = page.withUnit
			let unit = page.unitText
			assert !(plain is none) && !(withUnit is none) && !(unit is none)
			if !(plain is none) && !(withUnit is none) && !(unit is none) {
				let field = plain.field
				let second = withUnit.field
				assert !(field is none) && !(second is none)
				if !(field is none) && !(second is none) {
					assert float(plain.style.geom.frame.width) == 380.0
					assert float(field.style.geom.frame.width) == 380.0
					let unitWidth = float(unit.style.geom.frame.width)
					assert unitWidth > 0.0
					assert float(second.style.geom.frame.width) == 380.0 - unitWidth - 2.0
				}
			}
			scene.close()
		}
	}
}
