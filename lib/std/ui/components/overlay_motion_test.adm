partial module std.ui.components {
	use (
		std.math.geom::Size
		std.testing
		std.time
		std.ui::UI
		std.ui.runtime::(Scene, nodeOf)
		std.ui.styles::*
		std.units::(Percent, Pixels)
	)

	// A page 400 by 300 with one of each thing that comes over the page, each shown by
	// a flag the test sets.
	component OverlayPage {
		type {
			@bindable
			hung bool = false

			@bindable
			listed bool = false

			@bindable
			asked bool = false

			@bindable
			told bool = false

			@bindable
			drawn bool = false

			edge Side = Side.Start

			def new() {
				style.width = 400(px)
				style.height = 300(px)
			}
		}

		view {
			Button(label = "Page", ref = anchor)
			Popover(open = hung, ref = popover) {
				Text("Details")
			}
			Menu(open = listed, ref = menu) {
				MenuItem(label = "Rename")
			}
			Dialog(open = asked, title = "Rename", ref = dialog) {
				Text("To what?")
			}
			Toast("Saved", open = told, lasts = 0s, ref = toast)
			Drawer(open = drawn, side = edge, ref = drawer) {
				Text("Home")
			}
		}

		style StageStyle
	}

	check "Overlay motion" {
		// What is drawn of `c`: whether it is, how opaque, how far moved along each axis
		// (pixels, or percent of its own size) and at what scale.
		def drawnOf(scene Scene, c ?component) (bool, float, float, float, float) {
			return (false, 0.0, 0.0, 0.0, 0.0) when c is none
			let node = nodeOf(scene.tree, c)
			return (false, 0.0, 0.0, 0.0, 0.0) when node is none
			let decoration = node.decoration
			return (node.box.visible, 1.0, 0.0, 0.0, 1.0) when decoration is none
			let (x, y) = (decoration.transform.translate.x, decoration.transform.translate.y)
			let (across, down) = (0.0, 0.0)
			across = float(x) when x is Pixels
			across = float(x) when x is Percent
			down = float(y) when y is Pixels
			down = float(y) when y is Percent
			return (node.box.visible, decoration.opacity, across, down, decoration.transform.scale.x)
		}

		def near(a float, b float) bool {
			return (a - b).abs() < 1e-6
		}

		// A popover, a menu and a dialog fade in a little smaller than they are and
		// fade out the same way, in the theme's time for each, on its curve for what
		// arrives; while one goes it is still drawn, and then it is not there.
		@test()
		def TestFloatsFadeInAndOut() {
			let page = OverlayPage()
			let scene = new Scene(page)
			let size = new Size<Pixels>(400(px), 300(px))
			let t0 = time.now()
			let at = def (since duration) {
				scene.clock = t0 + since
				scene.arrange(size)
			}
			at(0ms)
			let motion = UI.theme().motion
			assert motion.fast == 120ms && motion.normal == 200ms && motion.slow == 280ms
			let arrives = motion.enter
			assert arrives is Ease && arrives == Ease.Out
			let since = 1s
			for let which = 0; which < 3; which++ {
				let shown ?component = page.popover
				let takes = motion.fast
				shown = page.menu when which == 1
				if which == 2 {
					shown = page.dialog
					takes = motion.normal
				}
				let show = def (now bool) {
					page.hung = now when which == 0
					page.listed = now when which == 1
					page.asked = now when which == 2
				}
				let (seen, _, _, _, _) = drawnOf(scene, shown)
				assert !seen

				show(true)
				at(since)
				let (first, opacity, _, _, scale) = drawnOf(scene, shown)
				assert first && near(opacity, 0.0)
				// Half its time in, an arrival is seven eighths there.
				at(since + takes * 0.5)
				(first, opacity, _, _, scale) = drawnOf(scene, shown)
				assert first && near(opacity, 0.875) && near(scale, 0.96 + 0.04 * 0.875)
				at(since + takes)
				(first, opacity, _, _, scale) = drawnOf(scene, shown)
				assert first && near(opacity, 1.0) && near(scale, 1.0)

				show(false)
				at(since + 1s)
				(first, opacity, _, _, scale) = drawnOf(scene, shown)
				assert first && near(opacity, 1.0)
				at(since + 1s + takes * 0.5)
				(first, opacity, _, _, scale) = drawnOf(scene, shown)
				assert first && near(opacity, 0.125) && near(scale, 1.0 - 0.04 * 0.875)
				at(since + 1s + takes)
				(first, _, _, _, _) = drawnOf(scene, shown)
				assert !first
				since += 3s
			}
			scene.close()
		}

		// A notice rises into its place as it fades in, and fades out where it is.
		@test()
		def TestToastRisesAndFades() {
			let page = OverlayPage()
			let scene = new Scene(page)
			let size = new Size<Pixels>(400(px), 300(px))
			let t0 = time.now()
			let at = def (since duration) {
				scene.clock = t0 + since
				scene.arrange(size)
			}
			at(0ms)
			page.told = true
			at(1s)
			let (seen, opacity, _, down, _) = drawnOf(scene, page.toast)
			assert seen && near(opacity, 0.0)
			at(1s + 100ms)
			(seen, opacity, _, down, _) = drawnOf(scene, page.toast)
			assert seen && near(opacity, 0.875) && near(down, 16.0 * 0.125)
			at(1s + 200ms)
			(seen, opacity, _, down, _) = drawnOf(scene, page.toast)
			assert seen && near(opacity, 1.0) && near(down, 0.0)

			page.told = false
			at(2s)
			at(2s + 100ms)
			(seen, opacity, _, down, _) = drawnOf(scene, page.toast)
			assert seen && near(opacity, 0.125) && near(down, 0.0)
			at(2s + 200ms)
			(seen, _, _, _, _) = drawnOf(scene, page.toast)
			assert !seen
			scene.close()
		}

		// A drawer slides in from past its edge of the window, its own size away, and
		// out there again: from the left for the start edge, the right for the end
		// edge, above and below; under RightToLeft the start edge is the right one.
		@test()
		def TestDrawerSlidesFromItsEdge() {
			let size = new Size<Pixels>(400(px), 300(px))
			let cases = [(Side.Start, Direction.LeftToRight, -100.0, 0.0), (Side.End, Direction.LeftToRight, 100.0, 0.0), (Side.Above, Direction.LeftToRight, 0.0, -100.0), (Side.Below, Direction.LeftToRight, 0.0, 100.0), (Side.Start, Direction.RightToLeft, 100.0, 0.0)]
			for let which in cases {
				let (edge, direction, fromAcross, fromDown) = which
				let page = OverlayPage()
				page.edge = edge
				let scene = new Scene(page)
				let t0 = time.now()
				let at = def (since duration) {
					scene.clock = t0 + since
					scene.arrange(size, direction)
				}
				at(0ms)
				at(10ms)
				page.drawn = true
				at(1s)
				at(1s + 140ms)
				let (seen, opacity, across, down, _) = drawnOf(scene, page.drawer)
				assert seen && near(opacity, 1.0) && near(across, fromAcross * 0.125) && near(down, fromDown * 0.125)
				at(1s + 280ms)
				(seen, _, across, down, _) = drawnOf(scene, page.drawer)
				assert seen && near(across, 0.0) && near(down, 0.0)

				page.drawn = false
				at(2s)
				at(2s + 140ms)
				(seen, _, across, down, _) = drawnOf(scene, page.drawer)
				assert seen && near(across, fromAcross * 0.875) && near(down, fromDown * 0.875)
				at(2s + 280ms)
				(seen, _, _, _, _) = drawnOf(scene, page.drawer)
				assert !seen
				scene.close()
			}
		}
	}
}
