partial module std.ui.components {
	use (
		std.math.geom::Corners
		std.ui::RenderContext
		std.ui.styles::*
		std.units::Extent
	)

	// The style of a `Panel`.
	style PanelStyle {
		Box
		Layout
		Background
		Compositing
		Motion
	}

	// A container with a background that can fade and move: the surface other components
	// sit on. `Panel() { ... }`
	component Panel {
		type {
			def render(ctx RenderContext) {
				ctx.outerShadows()
				ctx.background()
				ctx.borders()
				ctx.childNodes()
				ctx.innerShadows()
			}
		}

		view {
			children()
		}

		style {
			PanelStyle
			radius     = new Corners<Extent>(theme.metrics.radius)
			background = new BackgroundFill(theme.palette.surface)
		}
	}
}
