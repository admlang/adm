partial module std.ui.components {
	use (
		std.math.geom::Size
		std.testing
		std.ui.layout::Node
		std.ui.runtime::Scene
		std.ui.styles::*
		std.units::Pixels
	)

	// A title, a scrolled column of words, and a row whose label can grow.
	component PartsPage {
		type {
			@input
			words string[] = []

			@input
			wide bool = false

			@input
			hidden bool = false
		}

		view {
			Column(style = {width: fill, height: fill}) {
				Text("Title")
				ScrollView() {
					Column(style = {width: fill}) {
						for let word in words {
							Text(word)
						}
					}
				}
				Row() {
					Text(wide ?? ("a label much longer than the one before", "short"))
					if !hidden {
						Text("end")
					}
				}
			}
		}

		style {
			Box
			width  = fill
			height = fill
		}
	}

	// Whether two trees of nodes have the same nodes, in the same places of the window.
	internal def samePlaces(a Node, b Node) bool {
		let (one, two) = (a.geom.frame, b.geom.frame)
		return false when one.left != two.left || one.top != two.top || one.right != two.right || one.bottom != two.bottom
		return false when a.children.len() != b.children.len()
		for let (i, child) in a.children {
			return false unless samePlaces(child, b.children[i])
		}
		return true
	}

	check "Parts" {
		// A change lays out again the part of the tree its parent sees no difference
		// in, and everything ends where a whole layout of the same page puts it.
		@test()
		def TestPartsLandWhereAWholeLayoutPutsThem() {
			let size = new Size<Pixels>(300(px), 200(px))
			let page = PartsPage(words = ["one", "two", "three"])
			let scene = new Scene(page)
			scene.arrange(size)
			scene.arrange(size)
			let whole = def () Node {
				let fresh = new Scene(PartsPage(words = page.words, wide = page.wide, hidden = page.hidden))
				fresh.arrange(size)
				return fresh.tree
			}

			// The number of the last whole layout: parts leave it as it is.
			let serial = scene.tree.laidSerial

			// A word that wraps: the scrolled column grows, the scroll view does not.
			page.words = ["one", "a word much longer than the others, so long that it wraps onto lines of its own", "three"]
			scene.arrange(size)
			assert scene.tree.relaidParts && scene.tree.laidSerial == serial
			assert samePlaces(scene.tree, whole())

			// The row's label grows: the row is content sized, the column it is in is not.
			page.wide = true
			scene.arrange(size)
			assert scene.tree.relaidParts && scene.tree.laidSerial == serial
			assert samePlaces(scene.tree, whole())

			// What the row holds goes: the row is laid out again with one child.
			page.hidden = true
			scene.arrange(size)
			assert samePlaces(scene.tree, whole())

			// Nothing changed: nothing is laid out.
			scene.arrange(size)
			assert !scene.tree.relaidParts && !scene.tree.shifted
			scene.close()
		}
	}
}
