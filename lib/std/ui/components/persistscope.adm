partial module std.ui.components {
	use std.services.vault.kept::keepable

	// Names the values kept for what it holds: a `@persist(key)` field of a component
	// under it is kept under `<name>.<key>`, and so is the `persist` name of a std
	// component under it (`ScrollView(persist = "log")`), so two editors that keep the
	// same field keep two values: `PersistScope("left") { Editor() }`. A scope inside
	// another adds its name after the outer one's. A name that is not a kept key
	// (letters, digits, '.', '_' and '-') names nothing. It has no box of its own.
	@scoped
	component PersistScope {
		type {
			// What the keys under it start with.
			@input(value = true)
			name string
		}

		view {
			children()
		}
	}

	// The component a view is building a child for, while it builds it: the place the
	// keys of the child's kept fields are found from, before the child has one.
	let keptBuilder = new TaskLocal<component>()

	// Called by the compiler before a view builds a child whose type keeps fields;
	// returns the builder it replaces, which `__ui_built` puts back.
	def __ui_building(owner component) ?component {
		let before = keptBuilder.get()
		keptBuilder.set(owner)
		return before
	}

	// Called by the compiler once the child is built.
	def __ui_built(before ?component) {
		keptBuilder.set(before)
	}

	// The key a kept field of a component that is being made is under: `key` inside
	// the scopes above the component a view builds it for, `key` itself when no view
	// is building it.
	def __ui_kept_key(key string) string {
		let builder = keptBuilder.get()
		return key when builder is none
		return keyUnder(builder, key)
	}

	// The key a kept field of `owner` is under: `key` inside the scopes above it, or,
	// while it has no parent yet, above the component a view builds it for.
	def __ui_kept_key_of(owner component, key string) string {
		let parent = owner.parent()
		let above = parent is none ?? (owner._heldIn, parent)
		return __ui_kept_key(key) when above is none
		return keyUnder(above, key)
	}

	// `key` inside the scopes at `from` and above it, the outermost first.
	def keyUnder(from component, key string) string {
		let names = string[]
		let at ?component = from
		for {
			break when at is none
			if at is PersistScope {
				names.push(at.name) when keepable(at.name)
			}
			let above = at.parent()
			at = above is none ?? (at._heldIn, above)
		}
		return key when names.len() == 0
		names.reverse().push(key)
		return names.join(".")
	}

	// The name a std component keeps its `persist` values under: `name` inside the
	// scopes above it.
	def keptName(owner component, name string) string {
		return name when name == ""
		return __ui_kept_key_of(owner, name)
	}
}
