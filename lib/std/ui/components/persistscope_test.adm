partial module std.ui.components {
	use (
		std.math.geom::(Point, Size)
		std.services.vault::(Vault, VaultConfig)
		std.services.vault.kept::(forget, restored)
		std.testing
		std.ui::(MouseButton, PointerPhase)
		std.ui.runtime::Scene
		std.ui.styles::*
		std.units::Pixels
	)

	// A scroll view that keeps how far it is scrolled, inside a scope.
	component KeptReader {
		type {
			def new() {
				style.width = 200(px)
				style.height = 100(px)
			}
		}

		view {
			PersistScope("reader") {
				ScrollView(persist = "log") {
					Button(label = "One")
					Button(label = "Two")
					Button(label = "Three")
					Button(label = "Four")
					Button(label = "Five")
					Button(label = "Six")
				}
			}
		}

		style StageStyle
	}

	// A list of a thousand rows that keeps how far it is scrolled; `uneven` rows are
	// measured as they show.
	component KeptList {
		type {
			@input
			uneven bool = false

			numbers int[] = []

			def new() {
				style.width = 200(px)
				style.height = 100(px)
				for let i = 0; i < 1000; i++ {
					numbers.push(i)
				}
			}
		}

		view {
			if uneven {
				List(numbers, persist = "uneven", ref = unevenList) {
					rowRenderer = (it RowItem<int>) => TallRow(tall = 10.0 + float(it.content % 3) * 10.0)
				}
			} else {
				List(numbers, rowHeight = 20(px), persist = "even", ref = evenList)
			}
		}

		style StageStyle
	}

	check "PersistScope" {
		// A list with a `persist` name starts where it was scrolled, its rows of one
		// height or measured as they show.
		@test()
		def TestListKeepsItsPlace() {
			Vault.config(VaultConfig{memoryKiB: 64, passes: 1}) onerror recover none
			forget("even.scroll")
			forget("uneven.scroll")
			let window = new Size<Pixels>(400(px), 200(px))
			for let uneven in [false, true] {
				let page = KeptList(uneven = uneven)
				let scene = new Scene(page)
				scene.arrange(window)
				for let _ in 0..5 {
					scene.pointer(PointerPhase.Scroll, new Point<Pixels>(50(px), 50(px)), MouseButton.Left, new Point<Pixels>(0(px), 200(px)))
					scene.arrange(window)
				}
				let list = uneven ?? (page.unevenList, page.evenList)
				assert !(list is none)
				if !(list is none) {
					assert list.scrolledBy() == 1000.0
					let row = list.anchor
					let past = list.anchorPast

					let again = KeptList(uneven = uneven)
					let next = new Scene(again)
					for let _ in 0..4 {
						next.arrange(window)
					}
					// The same row at the top, scrolled as far into it: rows measured as
					// they show stand at other offsets until all above are measured.
					let back = uneven ?? (again.unevenList, again.evenList)
					assert !(back is none)
					if !(back is none) {
						assert back.anchor == row && (back.anchorPast - past).abs() < 0.5
						assert back.scrolledBy() == 1000.0 unless uneven
					}
				}
			}
		}

		// A scroll view with a `persist` name keeps its position under the name inside
		// its scopes, and one mounted in the same place starts there.
		@test()
		def TestScrollViewKeepsItsPlace() {
			Vault.config(VaultConfig{memoryKiB: 64, passes: 1}) onerror recover none
			forget("reader.log.scroll")
			let window = new Size<Pixels>(400(px), 200(px))
			let page = KeptReader()
			let scene = new Scene(page)
			scene.arrange(window)
			scene.pointer(PointerPhase.Scroll, new Point<Pixels>(50(px), 50(px)), MouseButton.Left, new Point<Pixels>(0(px), 40(px)))
			scene.arrange(window)
			let kept = restored<KeptScroll>("reader.log.scroll", KeptScroll{x: -1.0, y: -1.0})
			assert kept.x == 0.0 && kept.y == 40.0

			let again = KeptReader()
			let next = new Scene(again)
			next.arrange(window)
			next.arrange(window)
			let scroller = again.children[0].children[0]
			assert scroller is ScrollView
			if scroller is ScrollView {
				assert float(scroller.scrollOffset().y) == 40.0
			}
		}
	}
}
