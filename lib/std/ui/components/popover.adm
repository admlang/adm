partial module std.ui.components {
	use (
		std.gfx.canvas
		std.math.geom::(Corners, Edges, Point, Rect, Size)
		std.ui::(RenderContext, Theme, UI)
		std.ui.runtime::Boxed
		std.ui.styles::*
		std.units::(Extent, Pixels)
	)

	// The side of its target a popover opens on.
	enum Side {
		Above,
		Below,
		// Before the target in the reading direction.
		Start,
		// After the target in the reading direction.
		End,
	}

	// The anchors that keep a box beside `target`: on the wanted side when the box
	// (`own`, as it was laid out last) fits in the window there or does not fit on the
	// other side either, `gap` away, moved along the target's edge as far as the window
	// asks. Above or below the target it starts `along` from the target's start edge.
	internal def besideAnchors(named component, own Rect<Pixels>, side Side, rtl bool, window Size<Pixels>, gap float, along float = 0.0) Anchors {
		let target = laidOut(named)
		// A scope that holds nothing laid out has nothing to hang beside.
		return Anchors{} when target.isScoped
		let beside = target.style.geom.frame
		let (wide, high) = (float(own.width), float(own.height))
		let (windowWide, windowHigh) = (float(window.width), float(window.height))
		let roomAbove = float(beside.top) - gap
		let roomBelow = windowHigh - float(beside.bottom) - gap
		// Start is the left side reading left to right.
		let roomLeft = float(beside.left) - gap
		let roomRight = windowWide - float(beside.right) - gap
		let before = side == Side.Above || (side == Side.Start) != rtl && side != Side.Below
		let upright = side := Side.Above || Side.Below
		let (roomBefore, roomAfter, size) = upright ?? ((roomAbove, roomBelow, high), (roomLeft, roomRight, wide))
		// The other side only when it fits there and not here.
		before = !before when size > (before ?? (roomBefore, roomAfter)) && size <= (before ?? (roomAfter, roomBefore))

		let anchors = Anchors{}
		if upright {
			let line = new AnchorLine(target, before ?? (AnchorEdge.Top, AnchorEdge.Bottom))
			let away Extent = (before ?? (-gap, gap)) * 1(px)
			line.offset = away
			anchors.bottom = line when before
			anchors.top = line unless before
			// Along the target's start edge, pushed back inside the window.
			let slide = rtl ?? (-along, along)
			if rtl {
				slide = -(float(beside.right) - wide) when float(beside.right) + slide - wide < 0.0
				slide = windowWide - float(beside.right) when float(beside.right) + slide > windowWide
				let edge = new AnchorLine(target, AnchorEdge.Right)
				let moved Extent = slide * 1(px)
				edge.offset = moved
				anchors.right = edge
			} else {
				slide = windowWide - float(beside.left) - wide when float(beside.left) + slide + wide > windowWide
				slide = -float(beside.left) when float(beside.left) + slide < 0.0
				let edge = new AnchorLine(target, AnchorEdge.Left)
				let moved Extent = slide * 1(px)
				edge.offset = moved
				anchors.left = edge
			}
		} else {
			let line = new AnchorLine(target, before ?? (AnchorEdge.Left, AnchorEdge.Right))
			let away Extent = (before ?? (-gap, gap)) * 1(px)
			line.offset = away
			anchors.right = line when before
			anchors.left = line unless before
			let slide = 0.0
			slide = windowHigh - float(beside.top) - high when float(beside.top) + high > windowHigh
			slide = -float(beside.top) when float(beside.top) + slide < 0.0
			let edge = new AnchorLine(target, AnchorEdge.Top)
			let moved Extent = slide * 1(px)
			edge.offset = moved
			anchors.top = edge
		}
		return anchors
	}

	// The anchors that put a box at `at`, a point of the window whose root is `root`:
	// its start corner there, moved inside the window, and above the point when there
	// is no room below it.
	internal def pointAnchors(root component, at Point<Pixels>, own Rect<Pixels>, window Size<Pixels>) Anchors {
		let (wide, high) = (float(own.width), float(own.height))
		let (left, top) = (float(at.x), float(at.y))
		top -= high when top + high > float(window.height) && top - high >= 0.0
		left = (float(window.width) - wide).min(left).max(0.0)
		let across = new AnchorLine(root, AnchorEdge.Left)
		let along Extent = left * 1(px)
		across.offset = along
		let down = new AnchorLine(root, AnchorEdge.Top)
		let fall Extent = top.max(0.0) * 1(px)
		down.offset = fall
		return Anchors{left: across, top: down}
	}

	// What a float that names `target` hangs beside: the target itself, or, when that is a
	// scoped component (which is not laid out), the first thing it holds that is.
	internal def laidOut(target component) component {
		let at = target
		for at.isScoped {
			let found ?component = none
			for let child in at.childNodes {
				let look = child.style
				if look is Boxed {
					continue unless look.position := Position.Normal || Position.Sticky
				}
				found = child
				break
			}
			return target when found is none
			at = found
		}
		return at
	}

	// The root of the window `from` is in.
	internal def windowRoot(from component) component {
		let at = from
		for {
			let above = at.parent()
			return at when above is none
			at = above
		}
	}

	// The face of something that floats over the page: its shadows, background and
	// borders, the theme's edge, then what it holds.
	internal def drawFloat(ctx RenderContext, look Theme) {
		ctx.outerShadows()
		ctx.background()
		ctx.borders()
		drawEdge(ctx, look, frameBox(ctx), float(look.metrics.radius), false)
		ctx.childNodes()
		ctx.innerShadows()
	}

	// Asks for the keyboard focus to go to the first component under `within`, in tree
	// order, that Tab stops at. False when there is none.
	internal def focusInside(within component) bool {
		for let child in within.childNodes {
			if child.focusable && child.tabStop && !child.disabled {
				child.focus()
				return true
			}
			return true when focusInside(child)
		}
		return false
	}

	// The style of a `Popover`.
	style PopoverStyle {
		Box
		Layout
		Background
		Compositing
		Motion
		background = new BackgroundFill(theme.palette.overlay)
		position = Position.Relative
		layer = Layer.Popup
		visible = false
		padding = new Edges<Extent>(theme.metrics.unit * 2.0)
		radius = new Corners<Extent>(theme.metrics.radius)
	}

	// Content that hangs beside a component, above the page and out of any clipping:
	// `Popover(open, attach = trigger, side = Side.Below) { ... }`. It follows its target,
	// and flips to the other side or shifts along it when there is no room.
	component Popover {
		type {
			// Whether it is shown. Closing it (Escape, a click outside) writes false back
			// to what the caller passed when that is bindable.
			@input(value = true, bind = true)
			@state
			open bool = false

			// The component it hangs beside; none: its parent.
			@input
			attach ?component = none

			// The side of the target it opens on when there is room.
			@input
			side Side = Side.Below

			// Runs when it closes itself: on Escape or a press outside it and its target.
			@input
			onClose ?(def()) = none

			// Tells every listener it closed itself, after the handler ran: heard with
			// `@on(Popover.closed)`.
			@emit()
			def closed() bool {
				return true
			}

			look  Theme = UI.theme()
			// Whether it was open on the frame before.
			shown bool

			// Whether it is laid out right to left.
			def rtl() bool {
				return style.geom.direction == Direction.RightToLeft
			}

			def floating() bool {
				return open
			}

			// What it hangs beside.
			def floatTarget() ?component {
				let named = attach
				return named unless named is none
				return parent()
			}

			// Hides itself.
			def dismiss() {
				return when !open
				open = false
				let run = onClose
				run() unless run is none
				closed()
			}

			// Shows or hides itself and keeps itself beside its target. As it opens, the
			// keyboard focus goes to the first thing in it that Tab stops at; the runtime
			// gives it back to what had it when the popover goes.
			def place(window Size<Pixels>) {
				style.visible = open
				if open && !shown {
					let me component = self
					let _ = focusInside(me)
				}
				shown = open
				let target = floatTarget()
				return when !open || target is none
				style.anchors = besideAnchors(target, style.geom.frame, side, rtl(), window, float(look.metrics.unit))
			}

			def render(ctx RenderContext) {
				drawFloat(ctx, look)
			}
		}

		view {
			children()
		}

		style PopoverStyle
	}
}
