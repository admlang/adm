partial module std.ui.components {
	use (
		std.ui::(Geometry, Key, KeyEvent, MouseButton, PointerEvent, PointerPhase)
	)

	// What a pointer event means to something that is pressed.
	internal enum Press {
		// Nothing for a pressable.
		None,
		// A button went down on it: the press began.
		Began,
		// The primary button came up over it: a click.
		Clicked,
		// The secondary button came up over it.
		Menu,
		// The button came up outside it: the press is called off.
		Dropped,
	}

	// Reads a pointer event for a pressable whose box `geom` gives. A press that begins
	// captures the pointer, so the release reaches the component wherever it happens.
	internal def pressOf(e PointerEvent, geom Geometry) Press {
		if e.phase == PointerPhase.Down {
			e.capture()
			return Press.Began
		}
		return Press.None when e.phase != PointerPhase.Up
		let (x, y) = (float(e.position.x), float(e.position.y))
		let inside = x >= 0.0 && y >= 0.0 && x < float(geom.frame.width) && y < float(geom.frame.height)
		return Press.Dropped when !inside
		return Press.Menu when e.button == MouseButton.Right
		return Press.Clicked
	}

	// Whether a key pressed on a focused control activates it: Space, Enter or the keypad's
	// Enter.
	internal def activates(e KeyEvent) bool {
		return e.key := Key.Space || Key.Enter || Key.KeypadEnter
	}

	// Takes a pointer event for a control that a click activates: `run` on a click. True
	// when the event was the control's.
	internal def pressRuns(e PointerEvent, geom Geometry, enabled bool, run def()) bool {
		return false when !enabled
		match pressOf(e, geom) {
			case Press.None:
				return false
			case Press.Clicked:
				run()
			default:
		}
		return true
	}

	// Takes a key for a focused control that Space and Enter activate. True when the key
	// was one of them.
	internal def keyRuns(e KeyEvent, enabled bool, run def()) bool {
		return false when !enabled || !activates(e)
		run()
		return true
	}
}
