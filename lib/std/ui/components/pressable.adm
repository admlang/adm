partial module std.ui.components {
	use (
		std.ui::(KeyEvent, PointerEvent)
		std.ui.styles::*
	)

	// The style of a `Pressable`.
	style PressableStyle {
		Box
		Interaction
	}

	// Makes what is inside it something to press, with the pointer or, once it has the
	// focus, with Space or Enter: `Pressable(onClick = open) { Icon("folder") }`.
	component Pressable {
		type {
			// Runs when it is clicked, or activated with Space or Enter while focused.
			@input
			onClick ?(def()) = none

			// Runs on the second click of a double click.
			@input
			onDoubleClick ?(def()) = none

			// Runs when a press is held.
			@input
			onLongPress ?(def()) = none

			// Runs on a right click, a long press on a touch screen, or the menu key.
			@input
			onContextMenu ?(def()) = none

			// Tells every listener the secondary button was released on it, after the handler ran: heard with
			// `@on(Pressable.contextMenuAsked)`.
			@emit()
			def contextMenuAsked() bool {
				return true
			}

			def new() {
				focusable = true
				tabStop   = true
			}

			def pointer(e PointerEvent) bool {
				return false when disabled
				match pressOf(e, style.geom) {
					case Press.None:
						return false
					case Press.Clicked:
						press()
					case Press.Menu:
						let run = onContextMenu
						run() unless run is none
						contextMenuAsked()
					default:
				}
				return true
			}

			def key(e KeyEvent) bool {
				return false when !e.down
				return false when disabled || !activates(e)
				press()
				return true
			}

			// Tells every listener it was activated, after `onClick` ran: heard with
			// `@on(Pressable.clicked)`.
			@emit()
			def clicked() bool {
				return true
			}

			// Runs what it is for.
			def press() {
				let run = onClick
				run() unless run is none
				clicked()
			}
		}

		view {
			children()
		}

		style PressableStyle
	}
}
