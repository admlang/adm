partial module std.ui.components {
	use (
		std.math.geom::Rect
		std.time
		std.ui::(RenderContext, Theme, UI)
		std.ui.runtime::redrawBy
		std.ui.styles::*
		std.units::Pixels
	)

	// How long the moving piece of a `ProgressBar` of unknown length takes to cross it.
	internal const progressPeriod = 1500ms
	// How long between two drawings of a bar of unknown length.
	internal const progressStep = 16ms

	// How far along something is: `ProgressBar(value = done)` fills that part of the bar,
	// 0 to 1; `ProgressBar()` shows work of unknown length as a piece moving along it.
	component ProgressBar {
		type {
			// The part done, 0 to 1; none: unknown.
			@input(value = true)
			value ?float = none

			look    Theme = UI.theme()
			started time.Time = time.now()

			def render(ctx RenderContext) {
				let palette = look.palette
				let frame = ctx.geometry.frame
				let (width, height) = (float(frame.width), float(frame.height))
				let round = height / 2.0
				ctx.draw.fill(Rect{left: 0.0, top: 0.0, right: width, bottom: height}, round, palette.surfaceSunken.mix(palette.pressed))
				let rtl = ctx.direction == Direction.RightToLeft
				let done = value
				if done is none {
					// A piece a third of the bar long that enters at the start and leaves at
					// the end.
					let piece = width / 3.0
					// A frame drawn outside a window carries no time: the piece is at its start.
					let since = ctx.draw.frameTime.since(started)
					since = 0s when since < 0s
					let turn = float(since % progressPeriod) / float(progressPeriod)
					let left = -piece + turn * (width + piece)
					left = width - left - piece when rtl
					ctx.draw.save()
					ctx.draw.clip(Rect{left: 0.0, top: 0.0, right: width, bottom: height})
					ctx.draw.fill(Rect{left: left, top: 0.0, right: left + piece, bottom: height}, round, palette.accent)
					ctx.draw.restore()
					// It moves sixty times a second, however fast the display is.
					redrawBy(ctx.draw.frameTime + progressStep)
					return
				}
				let part = width * done.max(0.0).min(1.0)
				return when part <= 0.0
				let filled = rtl ?? (Rect{left: width - part, top: 0.0, right: width, bottom: height}, Rect{left: 0.0, top: 0.0, right: part, bottom: height})
				ctx.draw.fill(filled, round, palette.accent)
			}
		}

		view {}

		style {
			BarStyle
			width  = 160(px)
			height = 6(px)
		}
	}
}
