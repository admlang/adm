partial module std.ui.components {
	use (
		std.math.geom::(Circle, Corners, Point)
		std.ui::(Key, KeyEvent, PointerEvent, RenderContext, Theme, UI)
		std.ui.styles::*
		std.units::Extent
	)

	// The circle of a `Radio`: its part named `circle`. It is told the control's states
	// and draws a dot in its style's `foreground` while `on`.
	internal component RadioMark {
		type {
			@input
			@state
			on bool = false

			// The pointer is over the control, and holds it.
			@input
			@state
			over bool = false

			@input
			@state
			held bool = false

			// The control shows the keyboard focus.
			@input
			@state
			ringed bool = false

			look Theme = UI.theme()

			def render(ctx RenderContext) {
				ctx.outerShadows()
				ctx.background()
				ctx.borders()
				let box = frameBox(ctx)
				ctx.draw.fill(new Circle(new Point(box.right / 2.0, box.bottom / 2.0), box.right / 5.0), inkOf(style.foreground, look.palette.onAccent)) when on
				ctx.innerShadows()
			}
		}

		view {}

		style {
			MarkStyle
			width  = markSide * 1(px)
			height = markSide * 1(px)
			radius = new Corners<Extent>(markSide / 2.0 * 1(px))
		}
	}

	// One choice among several, of which one is selected:
	// `Radio(selected = size == "small", label = "Small", onChange = pickSmall)`. A click,
	// Space or Enter selects it; the caller unselects the others by what it passes them.
	component Radio {
		type {
			// Whether it is the selected one.
			@input(value = true, bind = true)
			@state
			selected bool = false

			// The text after the circle; empty: the circle alone.
			@input
			label string = ""

			// Runs when the user selects it and it was not selected.
			@input
			onChange ?(def(bool)) = none

			// Tells every listener it was selected, after the handler ran: heard with
			// `@on(Radio.changed)`.
			@emit()
			def changed(now bool) bool {
				return now
			}

			def new() {
				focusable = true
				tabStop   = true
			}

			// Selects it as a click does.
			def choose() {
				return when disabled || selected
				selected = true
				let tell = onChange
				tell(true) unless tell is none
				changed(true)
			}

			def pointer(e PointerEvent) bool {
				return pressRuns(e, style.geom, !disabled, choose)
			}

			// The radios placed beside it are one group: the arrows go to the one before
			// or after it, round at the ends, and select it.
			def key(e KeyEvent) bool {
				return false when !e.down
				return keyRuns(e, !disabled, choose) unless e.key := Key.Up || Key.Down || Key.Left || Key.Right
				let above = parent()
				return false when above is none || disabled
				let group component[]
				let at = -1
				let me component = self
				for let child in above.childNodes {
					let own = child == me
					if child is Radio {
						continue when child.disabled
						at = group.len() when own
						group.push(child)
					}
				}
				return false when group.len() < 2 || at < 0
				let back = e.key := Key.Up || Key.Left
				let next = group[(at + (back ?? (group.len() - 1, 1))) % group.len()]
				next.focus()
				next.choose() when next is Radio
				return true
			}
		}

		// Its parts: `circle`, the circle with its dot, and `text`, the label.
		view {
			RadioMark(ref = circle, on = selected, over = hover, held = pressed, ringed = focusVisible)
			if label != "" {
				Text(label, ref = text)
			}
		}

		style MarkedStyle
	}
}
