partial module std.ui.components {
	use (
		std.math.geom::(Circle, Point, Size)
		std.ui::(Key, KeyEvent, Limit, PointerEvent, RenderContext, Theme, UI)
		std.ui.paint
		std.ui.styles::*
		std.units::Pixels
	)

	// One choice among several, of which one is selected:
	// `Radio(selected = size == "small", label = "Small", onChange = pickSmall)`. A click,
	// Space or Enter selects it; the caller unselects the others by what it passes them.
	component Radio {
		type {
			// Whether it is the selected one.
			@input(value = true, bind = true)
			@state
			selected bool = false

			// The text after the circle; empty: the circle alone.
			@input
			label string = ""

			// Runs when the user selects it and it was not selected.
			@input
			onChange ?(def(bool)) = none

			// Tells every listener it was selected, after the handler ran: heard with
			// `@on(Radio.changed)`.
			@emit()
			def changed(now bool) bool {
				return now
			}

			block ?paint.TextBlock = none
			look  Theme = UI.theme()

			def new() {
				focusable = true
				tabStop   = true
			}

			// Selects it as a click does.
			def choose() {
				return when disabled || selected
				selected = true
				let tell = onChange
				tell(true) unless tell is none
				changed(true)
			}

			def current() paint.TextBlock {
				let made = controlLabel(block, label, style.font, style.foreground, style.paragraph, look, !disabled)
				block = made
				return made
			}

			def measure(limit Limit) Size<Pixels> {
				return markedSize(label, current(), markSide, limit)
			}

			def pointer(e PointerEvent) bool {
				return pressRuns(e, style.geom, !disabled, choose)
			}

			// The radios placed beside it are one group: the arrows go to the one before
			// or after it, round at the ends, and select it.
			def key(e KeyEvent) bool {
				return false when !e.down
				return keyRuns(e, !disabled, choose) unless e.key := Key.Up || Key.Down || Key.Left || Key.Right
				let above = parent()
				return false when above is none || disabled
				let group component[]
				let at = -1
				let me component = self
				for let child in above.childNodes {
					let own = child == me
					if child is Radio {
						continue when child.disabled
						at = group.len() when own
						group.push(child)
					}
				}
				return false when group.len() < 2 || at < 0
				let back = e.key := Key.Up || Key.Left
				let next = group[(at + (back ?? (group.len() - 1, 1))) % group.len()]
				next.focus()
				next.choose() when next is Radio
				return true
			}

			def render(ctx RenderContext) {
				let palette = look.palette
				let box = markBox(ctx, markSide, markSide)
				let half = markSide / 2.0
				ctx.draw.fill(box, half, markFill(palette, selected, hover, pressed, !disabled))
				if selected {
					ctx.draw.fill(new Circle(new Point(box.left + half, box.top + half), markSide / 5.0), palette.onAccent)
				} else {
					drawEdge(ctx, look, box, half, hover && !disabled)
				}
				drawMarkLabel(ctx, label, current(), markSide)
				drawFocusRing(ctx, look, box, half) when focusVisible
			}
		}

		view {}

		style ControlStyle
	}
}
