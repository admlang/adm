partial module std.ui.components {
	use (
		std.math.geom::Axes
		std.ui.styles::*
		std.units::(Extent)
	)

	// The style of a `Row`: its box and how it arranges its children.
	style RowStyle {
		Box
		Layout
	}

	// Places its children along the reading direction: `Row(gap = 8(px)) { ... }`.
	component Row {
		type {
			// The space between neighbouring children.
			@input
			gap Extent = 0(px)
		}

		view {
			children()
		}

		style {
			RowStyle
			arrange = Arrange.Row
			gap     = new Axes<Extent>(self.gap)
		}
	}
}
