partial module std.ui.components {
	use (
		std.math.geom::(Axes, Point, Rect, Size)
		std.services.vault.kept::(keep, keepable, restored)
		std.ui::(Key, KeyEvent, MouseButton, PointerEvent, PointerPhase, RenderContext)
		std.ui.navigation::Router
		std.ui.styles::*
		std.units::Pixels
	)

	// The style of a `ScrollView`.
	style ScrollViewStyle {
		Box
		Layout
		Scrollbars
		Background
		width = fill
		height = fill
		scrollbar = {thumb: theme.palette.foreground.withOpacity(0.35), thumbHover: theme.palette.foreground.withOpacity(0.55), radius: scrollbar.thickness / 2.0}
	}

	// What a `ScrollView` with a `persist` name keeps: how far it is scrolled.
	internal struct KeptScroll {
		x, y float
	}

	// Where one scrollbar is, in the component's coordinates.
	internal struct Bar {
		shown bool
		track Rect
		thumb Rect
	}

	// Shows content larger than itself and scrolls it with the wheel, a touch pan or its
	// bars: `ScrollView() { ... }`. It fills the room its parent has for it; in a parent
	// that sizes to its content it is as large as its own and has nothing to scroll.
	component ScrollView {
		type {
			// Which axes scroll.
			@input
			axes Axes<bool> = new Axes<bool>(false, true)

			// A name to keep the scroll position under between runs, inside the
			// `PersistScope`s above it (`<name>.scroll`), and in each history entry of the
			// `Router` above it, so going back to a page scrolls it back; empty: not kept.
			@input
			persist string = ""

			// The kept position read back when it was mounted, until the content is
			// large enough to scroll that far or it is scrolled another way.
			restoring ?Point<Pixels> = none

			// How far the content is scrolled from its start corner, and the size the
			// content was laid out in.
			offset Point<Pixels> = new Point<Pixels>(0(px), 0(px))
			extent Size<Pixels> = new Size<Pixels>(0(px), 0(px))

			// Its bars: a drag of a thumb, the bar the pointer is over.
			bars ScrollBars = new ScrollBars()

			// Whether it is laid out right to left.
			def rtl() bool {
				return style.geom.direction == Direction.RightToLeft
			}

			// Which axes the content is laid out unshrunk on.
			def scrollAxes() Axes<bool> {
				return axes
			}

			// How far the content is scrolled.
			def scrollOffset() Point<Pixels> {
				return offset
			}

			// The room a bar takes from the content box; none for a bar drawn over the
			// content or not at all.
			def scrollbarRoom() Pixels {
				return barRoom(style.scrollbar)
			}

			// Whether the room is taken when nothing scrolls.
			def scrollbarKept() bool {
				return barKept(style.scrollbar)
			}

			// The size the content was laid out in.
			def scrollExtent() Size<Pixels> {
				return extent
			}

			// The box the content shows in.
			def scrollPort() Rect<Pixels> {
				return style.geom.content
			}

			// The look of its bars.
			def scrollbarLook() Scrollbar {
				return style.scrollbar
			}

			// Layout reports the size the content took; the offset is brought back inside.
			def scrolled(extent Size<Pixels>) {
				// Assigned only when it differs: a change marks it, and what reads it.
				self.extent = extent when extent.width != self.extent.width || extent.height != self.extent.height
				let wanted = restoring
				if wanted is none {
					clampTo(offset)
					return
				}
				clampTo(wanted)
				restoring = none when offset.x == wanted.x && offset.y == wanted.y
			}

			// Mounted: scrolled as far as it was in the router's current entry; one that
			// is not under a router, or on the first page a router shows, as far as it was
			// when it was last kept. A page the router went to anew starts at the top.
			def attached() {
				return unless keepable(persist)
				let router = context<Router>()
				if !(router is none) {
					let entry = router.scrollOf(keptKey())
					if !(entry is none) {
						restoring = entry
						return
					}
					return when router.version > 0
				}
				let kept = restored<KeptScroll>(keptKey(), KeptScroll{x: -1.0, y: -1.0})
				return when kept.x < 0.0 || kept.y < 0.0
				restoring = new Point<Pixels>(kept.x * 1(px), kept.y * 1(px))
			}

			internal def keptKey() string {
				return "{keptName(self, persist)}.scroll"
			}

			// The furthest the content scrolls on each axis.
			def reach() Point<Pixels> {
				return scrollReach(style.geom.content, extent, axes)
			}

			// Scrolls so the content is `at` away from its start corner, as far as it goes.
			def scrollTo(at Point<Pixels>) {
				restoring = none
				let before = offset
				clampTo(at)
				if keepable(persist) && (offset.x != before.x || offset.y != before.y) {
					keep<KeptScroll>(keptKey(), KeptScroll{x: float(offset.x), y: float(offset.y)})
					let router = context<Router>()
					router.keepScroll(keptKey(), offset) unless router is none
				}
			}

			internal def clampTo(at Point<Pixels>) {
				let to = clampScroll(at, reach())
				offset = to when to.x != offset.x || to.y != offset.y
			}

			// Scrolls by a distance; false when the content was already as far as it goes.
			def scrollBy(by Point<Pixels>) bool {
				let before = offset
				scrollTo(new Point<Pixels>(before.x + by.x, before.y + by.y))
				return offset.x != before.x || offset.y != before.y
			}

			// The bar of one axis: its track beside the content box (over its edge for an
			// Overlay bar) and the thumb on it.
			def bar(vertical bool) Bar {
				return bars.bar(self, vertical)
			}

			// The wheel scrolls; a press on a thumb drags it and one beside it scrolls a
			// page that way. A wheel at the end of the content is left to an ancestor.
			def pointer(e PointerEvent) bool {
				let (pointed, dragged) = (bars.pointed, bars.dragged)
				let taken = bars.pointer(self, e)
				// A thumb is drawn in another colour under the pointer and while dragged.
				redraw(style.geom.frame) when bars.pointed != pointed || bars.dragged != dragged
				return taken
			}

			// Page Up, Page Down, Home, End and the arrows scroll; a key that cannot scroll
			// further is left to an ancestor.
			def key(e KeyEvent) bool {
				return false when !e.down
				let port = style.geom.content
				let line = 40.0
				let most = reach()
				match e.key {
					case Key.PageUp:
						return scrollBy(new Point<Pixels>(0(px), -float(port.height) * 1(px)))
					case Key.PageDown:
						return scrollBy(new Point<Pixels>(0(px), float(port.height) * 1(px)))
					case Key.Home:
						return scrollBy(new Point<Pixels>(0(px), -float(most.y) * 1(px)))
					case Key.End:
						return scrollBy(new Point<Pixels>(0(px), float(most.y) * 1(px)))
					case Key.Up:
						return scrollBy(new Point<Pixels>(0(px), -line * 1(px)))
					case Key.Down:
						return scrollBy(new Point<Pixels>(0(px), line * 1(px)))
					case Key.Left, Key.Right:
						let forward = (e.key == Key.Right) != rtl()
						return scrollBy(new Point<Pixels>((forward ?? (line, -line)) * 1(px), 0(px)))
					default:
						return false
				}
			}

			def render(ctx RenderContext) {
				ctx.outerShadows()
				ctx.background()
				ctx.borders()
				ctx.childNodes()
				ctx.innerShadows()
				bars.draw(self, ctx)
			}
		}

		view {
			children()
		}

		style ScrollViewStyle
	}

	// The room a bar of this look takes from the content box; none for a bar drawn over
	// the content or not at all.
	internal def barRoom(look Scrollbar) Pixels {
		return 0(px) when look.mode := ScrollbarMode.Overlay || ScrollbarMode.Hidden
		return look.thickness
	}

	// Whether a bar of this look keeps its room when nothing scrolls.
	internal def barKept(look Scrollbar) bool {
		return look.mode == ScrollbarMode.Always || (look.stable && look.mode == ScrollbarMode.Auto)
	}

	// The furthest content laid out in `extent` scrolls on each axis in a box of `port`.
	internal def scrollReach(port Rect<Pixels>, extent Size<Pixels>, axes Axes<bool>) Point<Pixels> {
		let x = axes.horizontal ?? ((float(extent.width) - float(port.width)).max(0.0), 0.0)
		let y = axes.vertical ?? ((float(extent.height) - float(port.height)).max(0.0), 0.0)
		return new Point<Pixels>(x * 1(px), y * 1(px))
	}

	// `at` brought inside 0 to `most` on each axis.
	internal def clampScroll(at Point<Pixels>, most Point<Pixels>) Point<Pixels> {
		let (x, y) = (float(at.x).max(0.0).min(float(most.x)), float(at.y).max(0.0).min(float(most.y)))
		return new Point<Pixels>(x * 1(px), y * 1(px))
	}

	// What scrolls with bars: a `ScrollView`, and a menu taller than it may be.
	internal interface BarHost {
		// How far the content is scrolled from its start corner.
		def scrollOffset() Point<Pixels>
		// The size the content was laid out in.
		def scrollExtent() Size<Pixels>
		// The axes the content scrolls on.
		def scrollAxes() Axes<bool>
		// The box the content shows in, in the component's coordinates.
		def scrollPort() Rect<Pixels>
		// The look of its bars.
		def scrollbarLook() Scrollbar
		// Whether it is laid out right to left.
		def rtl() bool
		// Scrolls by a distance; false when the content was already as far as it goes.
		def scrollBy(by Point<Pixels>) bool
	}

	// The scrollbars of a `BarHost`: where they are, a drag of a thumb and the bar the
	// pointer is over.
	internal type ScrollBars {
		// The bar whose thumb is being dragged (0 none, 1 horizontal, 2 vertical), where
		// the pointer took it and the offset then; the bar the pointer is over.
		dragged   int
		dragFrom  float
		dragStart float
		pointed   int

		// The bar of one axis: its track beside the content box (over its edge for an
		// Overlay bar) and the thumb on it.
		def bar(host BarHost, vertical bool) Bar {
			let look = host.scrollbarLook()
			let port = host.scrollPort()
			let extent = host.scrollExtent()
			let axes = host.scrollAxes()
			let rtl = host.rtl()
			let length = vertical ?? (float(port.height), float(port.width))
			let whole = vertical ?? (float(extent.height), float(extent.width))
			let scrolls = vertical ?? (axes.vertical, axes.horizontal)
			let over = scrolls && whole > length + 0.5
			let shown = scrolls && look.mode != ScrollbarMode.Hidden && (over || look.mode == ScrollbarMode.Always)
			let blank = Rect{left: 0.0, top: 0.0, right: 0.0, bottom: 0.0}
			return Bar{shown: false, track: blank, thumb: blank} when !shown || length <= 0.0

			let thick = float(look.thickness)
			let inside = look.mode == ScrollbarMode.Overlay
			let track = blank
			if vertical {
				// At the end side: the left one under RightToLeft.
				let edge = rtl ?? (float(port.left), float(port.right))
				let left = rtl == inside ?? (edge, edge - thick)
				track = Rect{left: left, top: float(port.top), right: left + thick, bottom: float(port.bottom)}
			} else {
				let top = inside ?? (float(port.bottom) - thick, float(port.bottom))
				track = Rect{left: float(port.left), top: top, right: float(port.right), bottom: top + thick}
			}

			let size = length
			size = (length * length / whole).max(float(look.minThumb)).min(length) when over
			let most = whole - length
			let offset = host.scrollOffset()
			let at = vertical ?? (float(offset.y), float(offset.x))
			let along = most > 0.0 ?? ((length - size) * at / most, 0.0)
			// Sideways under RightToLeft the content starts at the right.
			along = length - size - along when !vertical && rtl
			let thumb = track
			if vertical {
				thumb = Rect{left: track.left, top: track.top + along, right: track.right, bottom: track.top + along + size}
			} else {
				thumb = Rect{left: track.left + along, top: track.top, right: track.left + along + size, bottom: track.bottom}
			}
			return Bar{shown: true, track: track, thumb: thumb}
		}

		// The wheel scrolls; a press on a thumb drags it and one beside it scrolls a page
		// that way. A wheel at the end of the content is left to an ancestor.
		def pointer(host BarHost, e PointerEvent) bool {
			let (x, y) = (float(e.position.x), float(e.position.y))
			match e.phase {
				case PointerPhase.Scroll:
					return host.scrollBy(e.scroll)
				case PointerPhase.Leave:
					pointed = 0
					return false
				case PointerPhase.Up, PointerPhase.Cancel:
					let was = dragged
					dragged = 0
					return was != 0
				default:
			}

			let port = host.scrollPort()
			let rtl = host.rtl()
			if dragged != 0 {
				return true when e.phase != PointerPhase.Move
				let vertical = dragged == 2
				let held = bar(host, vertical)
				let length = vertical ?? (float(port.height), float(port.width))
				let size = vertical ?? (held.thumb.bottom - held.thumb.top, held.thumb.right - held.thumb.left)
				let free = length - size
				return true when free <= 0.0
				let most = scrollReach(port, host.scrollExtent(), host.scrollAxes())
				let moved = (vertical ?? (y, x)) - dragFrom
				moved = -moved when !vertical && rtl
				let to = dragStart + moved * (vertical ?? (float(most.y), float(most.x))) / free
				let at = host.scrollOffset()
				let by = vertical ?? (new Point<Pixels>(0(px), to * 1(px) - at.y), new Point<Pixels>(to * 1(px) - at.x, 0(px)))
				let _ = host.scrollBy(by)
				return true
			}

			pointed = 0
			for let vertical in [false, true] {
				let found = bar(host, vertical)
				continue when !found.shown || !holds(found.track, x, y)
				pointed = vertical ?? (2, 1) when holds(found.thumb, x, y)
				return false when e.phase != PointerPhase.Down || e.button != MouseButton.Left
				if pointed != 0 {
					e.capture()
					let at = host.scrollOffset()
					dragged = pointed
					dragFrom = vertical ?? (y, x)
					dragStart = vertical ?? (float(at.y), float(at.x))
					return true
				}
				// Beside the thumb: a page toward the pointer.
				let before = vertical ?? (y < found.thumb.top, x < found.thumb.left)
				before = !before when !vertical && rtl
				let page = (vertical ?? (float(port.height), float(port.width))) * (before ?? (-1.0, 1.0))
				let _ = host.scrollBy(vertical ?? (new Point<Pixels>(0(px), page * 1(px)), new Point<Pixels>(page * 1(px), 0(px))))
				return true
			}
			return false
		}

		// Draws the bars that show: each track, and its thumb, slimmer than the track, in
		// the hover colour under the pointer and while dragged.
		def draw(host BarHost, ctx RenderContext) {
			let look = host.scrollbarLook()
			for let vertical in [false, true] {
				let drawn = bar(host, vertical)
				continue when !drawn.shown
				ctx.draw.fill(drawn.track, look.track)
				let which = vertical ?? (2, 1)
				let paint = (pointed == which || dragged == which) ?? (look.thumbHover, look.thumb)
				let thumb = drawn.thumb
				let slim = vertical ?? (Rect{left: thumb.left + 2.0, top: thumb.top, right: thumb.right - 2.0, bottom: thumb.bottom}, Rect{left: thumb.left, top: thumb.top + 2.0, right: thumb.right, bottom: thumb.bottom - 2.0})
				ctx.draw.fill(slim, float(look.radius), paint)
			}
		}
	}

	// Whether the point is inside the rectangle.
	internal def holds(area Rect, x float, y float) bool {
		return x >= area.left && x < area.right && y >= area.top && y < area.bottom
	}
}
