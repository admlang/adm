partial module std.ui.components {
	use (
		std.math.geom::Axes
		std.ui::(Key, KeyEvent, TextKind)
		std.ui.styles::*
		std.units::Extent
	)

	// A field for what to look for, with a magnifier before the text and, while it holds
	// text, a cross at its end that empties it:
	// `SearchField(value = query, onChange = filter, onSubmit = search)`. Enter runs
	// `onSubmit` with the text; Escape empties a field that holds text.
	component SearchField {
		type {
			// The text looked for.
			@input(value = true, bind = true)
			value string = ""

			// Shown while the text is empty.
			@input
			placeholder string = "Search"

			// Runs with the text when Enter is pressed.
			@input
			onSubmit ?(def(string)) = none

			// Tells every listener the text Enter was pressed on, after the handler ran: heard with
			// `@on(SearchField.submitted)`.
			@emit()
			def submitted(text string) string {
				return text
			}

			// Runs with the new text when the user changes it or empties the field.
			@input
			onChange ?(def(string)) = none

			// Tells every listener its new text, after the handler ran: heard with
			// `@on(SearchField.changed)`.
			@emit()
			def changed(text string) string {
				return text
			}

			// The field's text changed.
			def typed(text string) {
				// The field wrote `value` already: it passes the bound input on.
				value = text
				let tell = onChange
				tell(text) unless tell is none
				changed(text)
			}

			// Enter in the field.
			def submit() {
				let run = onSubmit
				run(value) unless run is none
				submitted(value)
			}

			// Empties the field and gives it the focus back.
			def clear() {
				return when value == ""
				typed("")
				let part = field
				part.focus() unless part is none
			}

			def key(e KeyEvent) bool {
				return false when !e.down
				return false when e.key != Key.Escape || value == "" || disabled
				clear()
				return true
			}
		}

		view {
			TextField(ref = field, value = value, placeholder = placeholder, kind = TextKind.Search, enabled = !disabled, leading = "search", trailing = value != "" ?? ("close", ""), onTrailing = clear, onSubmit = submit, onChange = typed)
		}

		style {
			RowStyle
			arrange = Arrange.Row
			gap     = new Axes<Extent>(4(px))
		}
	}
}
