partial module std.ui.components {
	use (
		std.math.geom::(Circle, Corners, Edges, Point)
		std.ui::(Key, KeyEvent, MouseButton, PointerEvent, PointerPhase, RenderContext, Theme, UI)
		std.ui.styles::*
		std.units::Extent
	)

	// The radius of a `Slider`'s thumb and the height of its track, in logical pixels.
	internal const thumbRadius = 8.0
	internal const trackHeight = 4.0

	// The filled part of a `Slider`'s track, from its start to the thumb: the part named
	// `fill` of the track. `along` is how much of the track it covers, 0 to 1.
	internal component SliderFill {
		type {
			@input
			along float = 0.0
		}

		view {}

		style {
			Box
			Decorated
			width      = 100(%) * self.along
			height     = trackHeight * 1(px)
			radius     = new Corners<Extent>(trackHeight / 2.0 * 1(px))
			background = new BackgroundFill(theme.palette.accent)
			on         = {
				disabled: {background: new BackgroundFill(theme.palette.foregroundDisabled)},
			}
		}
	}

	// The thumb of a `Slider`: its part named `thumb`, a disc in the accent with a dot in
	// its style's `foreground`. It is told how far along the track it sits (`along`, 0 at
	// the track's start to 1 at its end) and the control's states: the pointer over it (`over`), a drag
	// (`held`), the keyboard focus shown (`ringed`).
	internal component SliderThumb {
		type {
			@input
			along float = 0.0

			@input
			@state
			over bool = false

			@input
			@state
			held bool = false

			@input
			@state
			ringed bool = false

			look Theme = UI.theme()

			def render(ctx RenderContext) {
				ctx.outerShadows()
				ctx.background()
				ctx.borders()
				let box = frameBox(ctx)
				ctx.draw.fill(new Circle(new Point(box.right / 2.0, box.bottom / 2.0), box.right * 3.0 / 16.0), inkOf(style.foreground, look.palette.onAccent))
				ctx.innerShadows()
			}
		}

		view {}

		style {
			Box
			Decorated
			Foreground
			Interaction
			width    = thumbRadius * 2.0 * 1(px)
			height   = thumbRadius * 2.0 * 1(px)
			radius   = new Corners<Extent>(thumbRadius * 1(px))
			position = Position.Relative
			// An offset from the track's centre, towards its end: layout turns it under RightToLeft.
			anchors    = Anchors{centerX: new AnchorLine(100(%) * (self.along - 0.5)), centerY: new AnchorLine(0(px))}
			hitTest    = HitTest.None
			background = new BackgroundFill(theme.palette.accent)
			foreground = theme.palette.onAccent
			on         = {
				over:     {background: new BackgroundFill(theme.palette.accentHover)},
				held:     {background: new BackgroundFill(theme.palette.accentPressed)},
				disabled: {background: new BackgroundFill(theme.palette.foregroundDisabled)},
				ringed:   {outline: focusRing()},
			}
		}
	}

	// The track of a `Slider`: its part named `track`, a sunken line that holds the `fill`
	// and the `thumb`, whose centre goes from one end of the line to the other. It is
	// told how much of it is filled (`along`, 0 to 1), which is where the thumb sits, and
	// the control's states, for the thumb.
	internal component SliderTrack {
		type {
			@input
			along float = 0.0

			@input
			over bool = false

			@input
			held bool = false

			@input
			ringed bool = false
		}

		view {
			SliderFill(ref = fill, along = along)
			SliderThumb(ref = thumb, along = along, over = over, held = held, ringed = ringed)
		}

		style {
			Box
			Decorated
			Layout
			// As wide as the room: `fill` names the part here.
			width      = 100(%)
			height     = trackHeight * 1(px)
			radius     = new Corners<Extent>(trackHeight / 2.0 * 1(px))
			background = new BackgroundFill(theme.palette.surfaceSunken.mix(theme.palette.pressed))
			arrange    = Arrange.Row
		}
	}

	// A value picked by dragging a thumb along a track:
	// `Slider(value = volume, min = 0.0, max = 100.0, onChange = setVolume)`. A press on
	// the track puts the thumb there; the arrows move it a step, Home and End to the ends.
	component Slider {
		type {
			// Where the thumb is, from `min` to `max`.
			@input(value = true, bind = true)
			value float = 0.0

			@input
			min float = 0.0

			@input
			max float = 100.0

			// What the value moves by: values in between are rounded to it. 0: any value,
			// and the arrows move a hundredth of the range.
			@input
			step float = 0.0

			// Runs with the new value when the user changes it.
			@input
			onChange ?(def(float)) = none

			// Tells every listener its new value, after the handler ran: heard with
			// `@on(Slider.changed)`.
			@emit()
			def changed(now float) float {
				return now
			}

			look     Theme = UI.theme()
			// A drag is moving the thumb.
			dragging bool

			// Whether it is laid out right to left.
			def rtl() bool {
				return style.geom.direction == Direction.RightToLeft
			}

			def new() {
				focusable = true
				tabStop   = true
			}

			// Sets the value as the user does: kept inside the range, rounded to the step,
			// and reported when it differs.
			def pick(wanted float) {
				let to = wanted
				to = min + ((to - min) / step).round() * step when step > 0.0
				to = to.max(min).min(max)
				return when to == value
				value = to
				let tell = onChange
				tell(to) unless tell is none
				changed(to)
			}

			// How far along the track the value is, 0 to 1.
			def fraction() float {
				return 0.0 when max <= min
				return ((value - min) / (max - min)).max(0.0).min(1.0)
			}

			// The value under a horizontal position in the component.
			def valueAt(x float) float {
				let room = float(style.geom.frame.width) - thumbRadius * 2.0
				return min when room <= 0.0
				let along = ((x - thumbRadius) / room).max(0.0).min(1.0)
				along = 1.0 - along when rtl()
				return min + along * (max - min)
			}

			def pointer(e PointerEvent) bool {
				return false when disabled
				match e.phase {
					case PointerPhase.Down:
						return false when e.button != MouseButton.Left
						e.capture()
						dragging = true
						pick(valueAt(float(e.position.x)))
						return true
					case PointerPhase.Move:
						return false when !dragging
						pick(valueAt(float(e.position.x)))
						return true
					case PointerPhase.Up, PointerPhase.Cancel:
						let was = dragging
						dragging = false
						return was
					default:
						return false
				}
			}

			def key(e KeyEvent) bool {
				return false when !e.down
				return false when disabled
				let by = step > 0.0 ?? (step, (max - min) / 100.0)
				let forward = rtl() ?? (-by, by)
				match e.key {
					case Key.Left:
						pick(value - forward)
					case Key.Right:
						pick(value + forward)
					case Key.Down:
						pick(value - by)
					case Key.Up:
						pick(value + by)
					case Key.Home:
						pick(min)
					case Key.End:
						pick(max)
					default:
						return false
				}
				return true
			}
		}

		// Its part: `track`, the line, which holds the `fill` and the `thumb`.
		view {
			SliderTrack(ref = track, along = fraction(), over = hover, held = dragging, ringed = focusVisible)
		}

		style {
			BarStyle
			Layout
			width  = 160(px)
			height = theme.metrics.controlHeight
			// The thumb's centre goes from end to end of the track.
			padding = new Edges<Extent>(0(px), thumbRadius * 1(px))
			arrange = Arrange.Row
			align   = Align{horizontal: Alignment.Start, vertical: Alignment.Center}
		}
	}
}
