// A view value that names the component's members is shown anew whenever the
// component's view runs again, whether it was given in the call's parentheses
// or assigned in its block.
partial module std.ui.components {
	use (
		std.math.geom::Size
		std.testing
		std.ui.runtime::Scene
		std.ui.styles::*
		std.units::Pixels
	)

	// Places what it is given, as a status bar places its end.
	component SlotHolder {
		type {
			@input
			end ?view = none
		}

		view {
			Text("bar")
			if !(end is none) {
				end()
			}
		}

		style {
			Box
			Layout
		}
	}

	component SlotCounter {
		type {
			@state
			count int = 0

			def bump() {
				count++
			}
		}

		view {
			Column() {
				Text("own {count}")
				SlotHolder(end = view {
					Text("given {count}")
				})
				SlotHolder() {
					end = view {
						Text("assigned {count}")
					}
				}
				SlotHolder() {
					end = view {
						Text("fixed")
					}
				}
			}
		}

		style StageStyle
	}

	// Gives its holder a view only while `shown`: a mark that comes and goes.
	component SlotLater {
		type {
			@state
			shown bool = false

			def later() ?view {
				return none when !shown
				return view {
					Text("later")
				}
			}
		}

		view {
			SlotHolder(end = later())
		}

		style StageStyle
	}

	// The texts under a component, top to bottom.
	internal def slotTextsUnder(c component) string[] {
		let out string[]
		for let child in c.childNodes {
			if child is Text {
				out.push(child.text)
			}
			out.push(...slotTextsUnder(child))
		}
		return out
	}

	check "Slots" {
		@test()
		def TestSlotsFollowTheirComponent() {
			let page = SlotCounter()
			let scene = new Scene(page)
			let size = new Size<Pixels>(300(px), 200(px))
			scene.arrange(size)
			scene.arrange(size)
			assert slotTextsUnder(page).join(",") == "own 0,bar,given 0,bar,assigned 0,bar,fixed"
			// A store from outside a view (a task's, a handler's) marks the component;
			// the next frames show the views it gave as they read it now.
			page.bump()
			scene.arrange(size)
			scene.arrange(size)
			assert slotTextsUnder(page).join(",") == "own 1,bar,given 1,bar,assigned 1,bar,fixed"
			page.count = 5
			scene.arrange(size)
			scene.arrange(size)
			assert slotTextsUnder(page).join(",") == "own 5,bar,given 5,bar,assigned 5,bar,fixed"
			scene.close()
		}

		// A view value passed on from a call is given again when it is another one:
		// a mark that was none and comes shows, and goes again.
		@test()
		def TestPassedOnViewComesAndGoes() {
			let page = SlotLater()
			let scene = new Scene(page)
			let size = new Size<Pixels>(300(px), 200(px))
			scene.arrange(size)
			scene.arrange(size)
			assert slotTextsUnder(page).join(",") == "bar"
			page.shown = true
			scene.arrange(size)
			scene.arrange(size)
			assert slotTextsUnder(page).join(",") == "bar,later"
			page.shown = false
			scene.arrange(size)
			scene.arrange(size)
			assert slotTextsUnder(page).join(",") == "bar"
			scene.close()
		}
	}
}
