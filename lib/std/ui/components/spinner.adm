partial module std.ui.components {
	use (
		std.math::(Tau, cos, sin)
		std.math.geom::(Circle, Point)
		std.time
		std.ui::(RenderContext, Theme, UI)
		std.ui.runtime::redrawBy
		std.ui.styles::*
		std.units::Pixels
	)

	// How many dots a `Spinner` has and how long one turn takes.
	internal const spinnerDots = 8
	internal const spinnerTurn = 900ms
	// How long between two drawings of a spinner: thirty a second.
	internal const spinnerStep = 33ms

	// Work in progress with no known length, in little room: `Spinner()`. Dots in a ring,
	// the brightness going round. 20 pixels a side unless its style says otherwise.
	component Spinner {
		type {
			look    Theme = UI.theme()
			started time.Time = time.now()

			def render(ctx RenderContext) {
				let frame = ctx.geometry.frame
				let side = float(frame.width).min(float(frame.height))
				return when side <= 0.0
				let (centreX, centreY) = (float(frame.width) / 2.0, float(frame.height) / 2.0)
				let dot = side / 9.0
				let ring = side / 2.0 - dot
				// Where the lead is on the ring, in dots: it moves a little on every frame.
				let dots = float(spinnerDots)
				// A frame drawn outside a window carries no time: the lead is on the first dot.
				let since = ctx.draw.frameTime.since(started)
				since = 0s when since < 0s
				let lead = float(since % spinnerTurn) / float(spinnerTurn) * dots
				let ink = look.palette.accent
				for let i = 0; i < spinnerDots; i++ {
					// A dot is solid as the lead reaches it and fades as the lead goes on.
					let behind = (lead - float(i) + dots) % dots
					let angle = float(i) / dots * Tau
					let at = new Point(centreX + sin(angle) * ring, centreY - cos(angle) * ring)
					ctx.draw.fill(new Circle(at, dot), ink.withAlpha(uint8(255.0 * (1.0 - behind / dots * 0.85))))
				}
				// It turns in steps the eye does not tell apart, not on every frame a fast
				// display shows.
				redrawBy(ctx.draw.frameTime + spinnerStep)
			}
		}

		view {}

		style {
			FigureStyle
			width  = 20(px)
			height = 20(px)
		}
	}
}
