partial module std.ui.components {
	use (
		std.ui::(PointerEvent, PointerPhase)
		std.ui.styles::*
	)

	// A button with more ways to do the same thing behind an arrow:
	// `SplitButton(label = "Run", onClick = run) { MenuItem(label = "Debug", onActivate = debug) }`.
	// A press on the label runs `onClick`; the arrow opens a menu of the lines in its block.
	component SplitButton {
		type {
			// The text on the main button.
			@input(value = true)
			label string = ""

			// Whether the menu is shown.
			@bindable
			opened bool

			// Tells every listener its main button was clicked, before `onClick` runs:
			// heard with `@on(SplitButton.clicked)`.
			@emit()
			def clicked() {}

			// Its own buttons take the focus and the clicks: the row between them is
			// neither.
			def new() {
				focusable = false
				tabStop   = false
			}

			// A press between its buttons is no click of the main one.
			def pointer(e PointerEvent) bool {
				return e.phase := PointerPhase.Down || PointerPhase.Up
			}

			def flip() {
				opened = !opened when !disabled
			}
		}

		view {
			Button(label = label, enabled = !disabled, onClick = click)
			Button(icon = "chevron-down", tooltip = "More", enabled = !disabled, onClick = flip)
			Menu(open = opened) {
				children()
			}
		}

		style {
			RowStyle
			arrange = Arrange.Row
		}
	}
}
