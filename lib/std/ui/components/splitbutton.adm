partial module std.ui.components {
	use std.ui.styles::*

	// A button with more ways to do the same thing behind an arrow:
	// `SplitButton(label = "Run", onClick = run) { MenuItem(label = "Debug", onActivate = debug) }`.
	// A press on the label runs `onClick`; the arrow opens a menu of the lines in its block.
	component SplitButton {
		type {
			// The text on the main button.
			@input(value = true)
			label string = ""

			// Runs when the main button is pressed.
			@input
			onClick ?(def()) = none

			// Whether the menu is shown.
			@bindable
			opened bool

			// Tells every listener it was activated, after `onClick` ran: heard with
			// `@on(SplitButton.clicked)`.
			@emit()
			def clicked() bool {
				return true
			}

			def press() {
				let run = onClick
				run() unless run is none
				clicked()
			}

			def flip() {
				opened = !opened when !disabled
			}
		}

		view {
			Button(label = label, enabled = !disabled, onClick = press)
			Button(icon = "chevron-down", tooltip = "More", enabled = !disabled, onClick = flip)
			Menu(open = opened) {
				children()
			}
		}

		style {
			RowStyle
			arrange = Arrange.Row
		}
	}
}
