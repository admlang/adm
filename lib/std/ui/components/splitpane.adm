partial module std.ui.components {
	use (
		std.math.geom::(Axes, Rect)
		std.ui::(MouseButton, PointerEvent, PointerPhase, RenderContext, Theme, UI)
		std.ui.styles::*
		std.units::(Extent, Pixels)
	)

	// The room between two panes of a `SplitPane`, which the pointer takes to drag, in
	// logical pixels.
	internal const splitGap = 7.0

	// The style of a `SplitPane`: its box, its tracks, and the pointer's shape over a
	// divider.
	style SplitPaneStyle {
		Box
		Layout
		Tracks
		Interaction
		arrange = Arrange.Grid
		gap = new Axes<Extent>(splitGap * 1(px))
		// A pane fills its track whatever its own size is.
		align = Align{horizontal: Alignment.Fill, vertical: Alignment.Fill}
		width = fill
		height = fill
	}

	// Panes side by side with a divider between each two that the pointer drags:
	// `SplitPane(sizes = [1.0, 3.0]) { Files(); Editor() }`. Each child is a pane; the
	// panes share the room by `sizes`, equally when none are given. `stacked = true`
	// puts them one above the other.
	component SplitPane {
		type {
			// The share of the room each pane takes, in order, as weights: [1.0, 3.0]
			// gives the second three times the first. Fewer than the panes, or none: the
			// rest share equally.
			@input(value = true)
			sizes float[] = []

			// Puts the panes one above the other.
			@input
			stacked bool = false

			// The least a pane becomes.
			@input
			least Pixels = 40(px)

			// Runs with the panes' shares when the user moved a divider.
			@input
			onResize ?(def(float[])) = none

			// Tells every listener the shares of its panes after a drag, after the handler ran: heard with
			// `@on(SplitPane.resized)`.
			@emit()
			def resized(shares float[]) float[] {
				return shares
			}

			look    Theme = UI.theme()
			// The share of each pane as it is now, and what they were made from.
			shares  float[]
			madeFor     float[]
			madeCount   int = -1
			madeStacked bool
			madeLeast   Pixels = 0(px)
			// The divider being dragged and the one under the pointer (the pane before
			// it), -1 for none; where the pointer took it, and the two panes' sizes then.
			dragged int = -1
			over    int = -1
			from    float
			before  float
			after   float

			// Whether it is laid out right to left.
			def rtl() bool {
				return style.geom.direction == Direction.RightToLeft
			}

			def new() {
				track()
			}

			// Makes the shares and the tracks again when the panes, `sizes`, `stacked` or
			// `least` changed. True when it did.
			def track() bool {
				let count = childNodes.len()
				let same = count == madeCount && stacked == madeStacked && least == madeLeast && sizes.len() == madeFor.len()
				if same {
					for let (i, size) in sizes {
						same = false when madeFor[i] != size
					}
				}
				return false when same
				madeCount   = count
				madeStacked = stacked
				madeLeast   = least
				let given float[]
				for let size in sizes {
					given.push(size)
				}
				madeFor = given
				let next float[]
				for let i = 0; i < count; i++ {
					next.push(i < sizes.len() && sizes[i] > 0.0 ?? (sizes[i], 1.0))
				}
				shares = next
				lay()
				return true
			}

			// Sets the tracks from the shares.
			def lay() {
				let panes Track[]
				let floor Extent = least
				for let share in shares {
					panes.push(new Track(fill * share, floor))
				}
				let whole Track[] = [new Track(fill)]
				style.columns = stacked ?? (whole, panes)
				style.rows = stacked ?? (panes, whole)
			}

			// Where pane `i` starts and ends along the split, in the component.
			def span(i int) (float, float) {
				let own = style.geom.frame
				let pane = childNodes[i].style.geom.frame
				return (float(pane.top) - float(own.top), float(pane.bottom) - float(own.top)) when stacked
				return (float(pane.left) - float(own.left), float(pane.right) - float(own.left))
			}

			// The divider at a point of the component: the pane before it, -1 for none.
			def dividerAt(x float, y float) int {
				let along = stacked ?? (y, x)
				for let i = 0; i + 1 < childNodes.len() && i + 1 < shares.len(); i++ {
					let (_, end) = span(i)
					let (start, _) = span(i + 1)
					return i when along >= end.min(start) && along < end.max(start)
				}
				return -1
			}

			// Notes the divider under the pointer and asks to be drawn when it is another.
			def point(i int) {
				return when i == over
				over = i
				// Over a divider the pointer says which way it moves.
				if i >= 0 {
					style.cursor = stacked ?? (Cursor.ResizeRow, Cursor.ResizeColumn)
				} else {
					style.cursor = none
				}
				redraw()
			}

			// Moves the dragged divider to where the pointer is: the two panes beside it
			// share their room anew, neither under `least`.
			def drag(along float) {
				let both = before + after
				let floor = float(least).min(both / 2.0)
				let by = along - from
				by = -by when rtl() && !stacked
				let first = (before + by).max(floor).min(both - floor)
				let sum = shares[dragged] + shares[dragged + 1]
				return when both <= 0.0
				let share = sum * first / both
				return when share == shares[dragged]
				shares[dragged] = share
				shares[dragged + 1] = sum - share
				lay()
				redraw()
				// The caller gets shares of its own: it may keep them as its `sizes`.
				let now float[]
				for let held in shares {
					now.push(held)
				}
				let tell = onResize
				tell(now) unless tell is none
				resized(now)
			}

			def pointer(e PointerEvent) bool {
				return false when disabled
				let (x, y) = (float(e.position.x), float(e.position.y))
				match e.phase {
					case PointerPhase.Down:
						return false when e.button != MouseButton.Left
						let at = dividerAt(x, y)
						return false when at < 0
						e.capture()
						dragged = at
						from    = stacked ?? (y, x)
						let (start, end) = span(at)
						let (next, last) = span(at + 1)
						before = (end - start).abs()
						after  = (last - next).abs()
						redraw()
						return true
					case PointerPhase.Move:
						if dragged < 0 {
							point(dividerAt(x, y))
							return false
						}
						drag(stacked ?? (y, x))
						return true
					case PointerPhase.Leave:
						point(-1)
						return false
					case PointerPhase.Up, PointerPhase.Cancel:
						let was = dragged >= 0
						dragged = -1
						redraw() when was
						return was
					default:
						return false
				}
			}

			def attached() {
				let _ = track()
			}

			def render(ctx RenderContext) {
				redraw() when track()
				ctx.outerShadows()
				ctx.background()
				ctx.borders()
				ctx.childNodes()
				let palette = look.palette
				let frame = ctx.geometry.frame
				let (wide, high) = (float(frame.width), float(frame.height))
				let line = float(look.metrics.borderWidth)
				for let i = 0; i + 1 < childNodes.len() && i + 1 < shares.len(); i++ {
					let (_, end) = span(i)
					let (start, _) = span(i + 1)
					let middle = (end + start) / 2.0
					// The divider that is dragged or under the pointer is drawn stronger.
					let held = i == dragged || (i == over && dragged < 0)
					let half = (held ?? (line * 3.0, line)) / 2.0
					let ink = i == dragged ?? (palette.accent, held ?? (palette.borderStrong, palette.divider))
					ctx.draw.fill(stacked ?? (Rect{left: 0.0, top: middle - half, right: wide, bottom: middle + half}, Rect{left: middle - half, top: 0.0, right: middle + half, bottom: high}), ink)
				}
				ctx.innerShadows()
			}
		}

		view {
			children()
		}

		style SplitPaneStyle
	}
}
