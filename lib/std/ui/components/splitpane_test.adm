partial module std.ui.components {
	use (
		std.gfx.canvas
		std.math.geom::(Point, Size)
		std.services.vault::(Vault, VaultConfig)
		std.services.vault.kept::forget
		std.testing
		std.ui::(Appearance, PointerPhase, UI)
		std.ui.runtime::Scene
		std.ui.styles::*
		std.units::Pixels
	)

	// Two panes whose shares are a field of the page, kept between runs.
	component SharedPanes {
		type {
			@bindable
			shares float[] = [1.0, 1.0]

			def new() {
				style.width = 407(px)
				style.height = 100(px)
			}
		}

		view {
			SplitPane(sizes = shares, persist = "panes") {
				Text("left")
				Text("right")
			}
		}

		style StageStyle
	}

	// Two panes filling a stage, with or without a rule between them.
	component RuledPanes {
		type {
			@input
			rule bool = true

			def new() {
				style.width = 207(px)
				style.height = 100(px)
			}
		}

		view {
			SplitPane(sizes = [1.0, 1.0], rule = rule) {
				Text("left")
				Text("right")
			}
		}

		style StageStyle
	}

	check "SplitPane" {
		// The red, green and blue of the pixel at `at`.
		def shade(surface canvas.Canvas, at Point<Pixels>) string {
			let i = (int(float(at.y)) * surface.width + int(float(at.x))) * 4
			return "{surface.pixels[i]},{surface.pixels[i + 1]},{surface.pixels[i + 2]}"
		}

		// With `rule = false` nothing is drawn between the panes at rest, where a ruled
		// pane draws its line; the divider under the pointer is drawn either way.
		@test()
		def TestRuleCanBeLeftOut() {
			UI.theme().follow(Appearance{})
			let window = new Size<Pixels>(207(px), 100(px))
			let paintMiddle = def (shown RuledPanes, hover bool) string {
				let scene = new Scene(shown)
				scene.arrange(window)
				let pane = shown.children[0]
				let frame = pane.style.geom.frame
				let middle = new Point<Pixels>((float(frame.left) + float(frame.width) / 2.0) * 1(px), (float(frame.top) + float(frame.height) / 2.0) * 1(px))
				scene.pointer(PointerPhase.Move, middle) when hover
				scene.arrange(window)
				let surface = new canvas.Canvas(207, 100)
				scene.paint(surface)
				return shade(surface, middle)
			}
			let ruled = paintMiddle(RuledPanes(), false)
			let bare = paintMiddle(RuledPanes(rule = false), false)
			assert ruled != bare
			let backdrop = paintMiddle(RuledPanes(rule = false), false)
			assert bare == backdrop
			let hovered = paintMiddle(RuledPanes(rule = false), true)
			assert hovered != bare
		}

		// A drag writes the shares back into a bound field and keeps them; a pane mounted
		// again shares the room as it was left.
		@test()
		def TestSharesAreBoundAndKept() {
			Vault.config(VaultConfig{memoryKiB: 64, passes: 1}) onerror recover none
			forget("panes.sizes")
			let page = SharedPanes()
			let scene = new Scene(page)
			let size = new Size<Pixels>(407(px), 100(px))
			scene.arrange(size)
			scene.arrange(size)
			let grip = new Point<Pixels>(203(px), 50(px))
			let _ = scene.pointer(PointerPhase.Down, grip)
			let _ = scene.pointer(PointerPhase.Move, new Point<Pixels>(303(px), 50(px)))
			let _ = scene.pointer(PointerPhase.Up, new Point<Pixels>(303(px), 50(px)))
			scene.arrange(size)
			scene.arrange(size)
			assert page.shares.len() == 2 && (page.shares[0] / page.shares[1] - 3.0).abs() < 0.05

			let again = SharedPanes()
			let next = new Scene(again)
			next.arrange(size)
			next.arrange(size)
			let left = again.children[0].childNodes[0]
			assert (float(left.style.geom.frame.width) - 300.0).abs() < 1.0
			assert (again.shares[0] / again.shares[1] - 3.0).abs() < 0.05
		}
	}
}
