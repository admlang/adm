partial module std.ui.components {
	use (
		std.math.geom::(Point, Size)
		std.services.vault::(Vault, VaultConfig)
		std.services.vault.kept::forget
		std.testing
		std.ui::PointerPhase
		std.ui.runtime::Scene
		std.ui.styles::*
		std.units::Pixels
	)

	// Two panes whose shares are a field of the page, kept between runs.
	component SharedPanes {
		type {
			@bindable
			shares float[] = [1.0, 1.0]

			def new() {
				style.width = 407(px)
				style.height = 100(px)
			}
		}

		view {
			SplitPane(sizes = shares, persist = "panes") {
				Text("left")
				Text("right")
			}
		}

		style StageStyle
	}

	check "SplitPane" {
		// A drag writes the shares back into a bound field and keeps them; a pane mounted
		// again shares the room as it was left.
		@test()
		def TestSharesAreBoundAndKept() {
			Vault.config(VaultConfig{memoryKiB: 64, passes: 1}) onerror recover none
			forget("panes.sizes")
			let page = SharedPanes()
			let scene = new Scene(page)
			let size = new Size<Pixels>(407(px), 100(px))
			scene.arrange(size)
			scene.arrange(size)
			let grip = new Point<Pixels>(203(px), 50(px))
			let _ = scene.pointer(PointerPhase.Down, grip)
			let _ = scene.pointer(PointerPhase.Move, new Point<Pixels>(303(px), 50(px)))
			let _ = scene.pointer(PointerPhase.Up, new Point<Pixels>(303(px), 50(px)))
			scene.arrange(size)
			scene.arrange(size)
			assert page.shares.len() == 2 && (page.shares[0] / page.shares[1] - 3.0).abs() < 0.05

			let again = SharedPanes()
			let next = new Scene(again)
			next.arrange(size)
			next.arrange(size)
			let left = again.children[0].childNodes[0]
			assert (float(left.style.geom.frame.width) - 300.0).abs() < 1.0
			assert (again.shares[0] / again.shares[1] - 3.0).abs() < 0.05
		}
	}
}
