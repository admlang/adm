partial module std.ui.components {
	use (
		std.math.geom::(Axes, Corners, Edges)
		std.ui::(RenderContext, Theme, UI)
		std.ui.styles::*
		std.units::Extent
	)

	// Where a step of a `Stepper` stands.
	internal enum StepState {
		// After the current one.
		Upcoming,
		// The current one.
		Current,
		// Before the current one.
		Done,
		// It has an `error`.
		Failed,
	}

	// One step of a `Stepper`: `Step("Account") { ... }`. What it holds shows while it is
	// the current step, filling the room beside or under the steps' line.
	component Step {
		type {
			// What its place in the line says.
			@input(value = true)
			title string = ""

			// The step may be left out: its place says so under the title.
			@input
			optional bool = false

			// What is wrong in the step, said under its title; empty: nothing is. A step
			// with an error is marked as one, whether it is done or not.
			@input
			error string = ""

			// What its place in the line shows in place of `title`.
			@input
			heading ?view = none

			// Shows or hides what it holds. True when that changed it.
			def show(on bool) bool {
				return false when style.visible == on
				style.visible = on
				return true
			}
		}

		view {
			children()
		}

		style {
			ColumnStyle
			width  = fill
			height = fill
		}
	}

	// The disc of a step in a `Stepper`'s line: its number, a check once it is done, `!`
	// with an error. The current one is filled with the accent.
	internal component StepMark {
		type {
			@input(value = true)
			number int = 1

			@input
			@state
			state StepState = StepState.Upcoming

			@input
			@state
			current bool = false

			@input
			@state
			done bool = false

			@input
			@state
			failed bool = false
		}

		view {
			if done {
				Icon("check")
			} else if failed {
				Text("!")
			} else {
				Text("{number}")
			}
		}

		style {
			Box
			Decorated
			Foreground
			Layout
			width      = 24(px)
			height     = 24(px)
			radius     = new Corners<Extent>(12(px))
			align      = Align{horizontal: Alignment.Center, vertical: Alignment.Center}
			border     = controlEdge(theme.palette.border)
			foreground = theme.palette.foregroundMuted
			on         = {
				current: {background: new BackgroundFill(theme.palette.accent), border: controlEdge(theme.palette.accent), foreground: theme.palette.onAccent},
				done:    {background: new BackgroundFill(theme.palette.accent.mix(theme.palette.surface, 0.8)), border: controlEdge(theme.palette.accent), foreground: theme.palette.accent},
				failed:  {background: new BackgroundFill(theme.palette.danger), border: controlEdge(theme.palette.danger), foreground: theme.palette.onAccent},
			}
		}
	}

	// A step's place in a `Stepper`'s line: its mark, then its title (or heading) with what
	// is said under it, an error or that it may be left out. A click on it runs the
	// stepper's `onSelect` when it has one.
	internal component StepPlace {
		type {
			@input(value = true)
			title string = ""

			@input
			number int = 1

			@input
			state StepState = StepState.Upcoming

			@input
			note string = ""

			@input
			line ?view = none

			look Theme = UI.theme()
		}

		view {
			StepMark(number, state = state, current = state == StepState.Current, done = state == StepState.Done, failed = state == StepState.Failed)
			Column(gap = 0(px)) {
				if line is none {
					Text(title, style = {font: {weight: state == StepState.Current ?? (FontWeight.SemiBold, FontWeight.Normal)}})
				} else {
					line()
				}
				if note != "" {
					Text(note, style = {foreground: state == StepState.Failed ?? (look.palette.danger, look.palette.foregroundMuted), font: {size: 0.85(em)}})
				}
			}
		}

		style {
			Box
			Control
			Layout
			arrange = Arrange.Row
			gap     = new Axes<Extent>(theme.metrics.unit * 2.0)
			align   = Align{horizontal: Alignment.Start, vertical: Alignment.Center}
			padding = new Edges<Extent>(theme.metrics.unit)
			radius  = new Corners<Extent>(theme.metrics.radius)
			on      = {
				focusVisible: {outline: focusRing()},
			}
		}
	}

	// The line between two places of a `Stepper`, in the accent once the step before it
	// is done.
	internal component StepLink {
		type {
			@input
			@state
			done bool = false

			@input
			across bool = true
		}

		view {}

		style {
			Box
			Decorated
			width      = self.across ?? (fill, 2(px))
			height     = self.across ?? (2(px), 16(px))
			minWidth   = self.across ?? (16(px), 2(px))
			margin     = self.across ?? (new Edges<Extent>(0(px), theme.metrics.unit), new Edges<Extent>(0(px), 0(px), 0(px), 15(px)))
			background = new BackgroundFill(theme.palette.border)
			on         = {
				done: {background: new BackgroundFill(theme.palette.accent)},
			}
		}
	}

	// The steps of a task done in order, one shown at a time under a line of their
	// titles: `Stepper(current = at, onSelect = go) { Step("Account") { ... };
	// Step("Payment", optional = true) { ... } }`. The steps before the current one are
	// done, a step with an `error` is marked as one. With `onSelect` a click on a step's
	// place runs it with the step's index, and the caller decides whether to go there;
	// without, the line only shows where the task is. `axis = Arrange.Column` puts the
	// line down the start side, the step's content beside it.
	component Stepper {
		type {
			// The index of the current step.
			@input(value = true, bind = true)
			@state
			current int = 0

			// Runs with a step's index when its place is clicked.
			@input
			onSelect ?(def(int)) = none

			// Tells every listener the step whose place was clicked, after the handler
			// ran: heard with `@on(Stepper.selected)`.
			@emit()
			def selected(index int) int {
				return index
			}

			// The way the steps' line runs: `Arrange.Row` along the top, `Arrange.Column`
			// down the start side.
			@input
			axis Arrange = Arrange.Row

			// The steps, in order.
			def steps() Step[] {
				let found Step[]
				for let child in childNodes {
					found.push(child) when child is Step
				}
				return found
			}

			// Shows the current step and hides the others. True when that changed any.
			def sync() bool {
				let changed = false
				for let (i, step) in steps() {
					changed = true when step.show(i == current)
				}
				return changed
			}

			def stateOf(index int, step Step) StepState {
				return StepState.Failed when step.error != ""
				return StepState.Done when index < current
				return StepState.Current when index == current
				return StepState.Upcoming
			}

			def noteOf(step Step) string {
				return step.error when step.error != ""
				return step.optional ?? ("Optional", "")
			}

			def pick(index int) {
				let run = onSelect
				run(index) unless run is none
				selected(index)
			}

			def across() bool {
				return axis != Arrange.Column
			}

			def attached() {
				let _ = sync()
			}

			def render(ctx RenderContext) {
				// Steps changed since the view ran show on the next frame.
				redraw() when sync()
				ctx.outerShadows()
				ctx.background()
				ctx.borders()
				ctx.childNodes()
				ctx.innerShadows()
			}
		}

		// Its parts: `line`, the places of the steps and the links between them, then the
		// steps.
		view {
			let _ = sync()
			let all = steps()
			StepLine(ref = line, across = across()) {
				for let (i, step) in all {
					if i > 0 {
						StepLink(key = i * 2, done = i <= current, across = across())
					}
					if onSelect is none {
						StepPlace(step.title, key = i * 2 + 1, number = i + 1, state = stateOf(i, step), note = noteOf(step), line = step.heading)
					} else {
						StepPlace(step.title, key = i * 2 + 1, number = i + 1, state = stateOf(i, step), note = noteOf(step), line = step.heading, onClick = def () {
							pick(i)
						})
					}
				}
			}
			children()
		}

		style {
			Box
			Layout
			arrange = self.axis == Arrange.Column ?? (Arrange.Row, Arrange.Column)
			gap     = new Axes<Extent>(theme.metrics.unit * 3.0)
			width   = fill
			height  = fill
		}
	}

	// The line of a `Stepper`: its places in a row or a column.
	internal component StepLine {
		type {
			@input
			across bool = true
		}

		view {
			children()
		}

		style {
			Box
			Layout
			arrange = self.across ?? (Arrange.Row, Arrange.Column)
			align   = Align{horizontal: Alignment.Start, vertical: self.across ?? (Alignment.Center, Alignment.Start)}
			width   = self.across ?? (fill, auto)
		}
	}
}
