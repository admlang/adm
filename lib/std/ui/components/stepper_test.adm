partial module std.ui.components {
	use (
		std.math.geom::(Point, Size)
		std.testing
		std.ui::(Key, KeyEvent, PointerPhase)
		std.ui.runtime::Scene
		std.ui.styles::*
		std.units::Pixels
	)

	internal let stepLog = string[]

	// A task of three steps, the second optional, the third with an error.
	component Signup {
		type {
			@bindable
			at int = 1

			def new() {
				style.width = 600(px)
				style.height = 300(px)
			}

			def go(index int) {
				stepLog.push("go {index}")
				at = index
			}
		}

		view {
			Stepper(current = at, onSelect = go) {
				Step("Account") {
					Text("account page")
				}
				Step("Plan", optional = true) {
					Text("plan page")
				}
				Step("Pay", error = "Card declined") {
					Text("pay page")
				}
			}
		}

		style StageStyle
	}

	// The places of a stepper's line, in order.
	internal def placesOf(stepper component) StepPlace[] {
		let found StepPlace[]
		for let child in stepper.children[0].childNodes {
			found.push(child) when child is StepPlace
		}
		return found
	}

	// Which of a stepper's pages show, in order: `+` shown, `-` hidden.
	internal def pagesShown(stepper component) string {
		let shown = ""
		for let child in stepper.childNodes {
			if child is Step {
				shown += child.style.visible ?? ("+", "-")
			}
		}
		return shown
	}

	check "Stepper" {
		// The steps before the current one are done, the current one shows its page,
		// an error and an optional step say so under their titles.
		@test()
		def TestStates() {
			let page = Signup()
			let scene = new Scene(page)
			let size = new Size<Pixels>(600(px), 300(px))
			scene.arrange(size)
			scene.arrange(size)
			let stepper = page.children[0]
			let places = placesOf(stepper)
			assert places.len() == 3
			assert places[0].state == StepState.Done && places[1].state == StepState.Current && places[2].state == StepState.Failed
			assert places[1].note == "Optional" && places[2].note == "Card declined" && places[0].note == ""
			assert pagesShown(stepper) == "-+-"
			scene.close()
		}

		// A click on a place runs `onSelect` with its index; the caller moves `current`,
		// and the page shown follows. Space on a focused place does the same.
		@test()
		def TestSelect() {
			stepLog = string[]
			let page = Signup()
			let scene = new Scene(page)
			let size = new Size<Pixels>(600(px), 300(px))
			scene.arrange(size)
			scene.arrange(size)
			let stepper = page.children[0]
			let first = placesOf(stepper)[0]
			let frame = first.style.geom.frame
			let at = new Point<Pixels>(frame.left + float(frame.width) / 2.0 * 1(px), frame.top + float(frame.height) / 2.0 * 1(px))
			scene.pointer(PointerPhase.Down, at)
			scene.pointer(PointerPhase.Up, at)
			scene.arrange(size)
			scene.arrange(size)
			assert stepLog.join(",") == "go 0" && page.at == 0
			assert pagesShown(stepper) == "+--"
			let last = placesOf(stepper)[2]
			assert first.focused
			last.focus()
			scene.arrange(size)
			scene.key(KeyEvent{target: last, key: Key.Space})
			assert stepLog.join(",") == "go 0,go 2"
			scene.close()
		}
	}
}
