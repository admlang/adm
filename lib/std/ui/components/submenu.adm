partial module std.ui.components {
	use (
		std.gfx.color::Color
		std.math.geom::(Edges, Rect, Size)
		std.ui::(Key, KeyEvent, Limit, PointerEvent, PointerPhase, RenderContext, Theme, UI)
		std.ui.paint
		std.ui.runtime::drawIcon
		std.ui.styles::*
		std.units::(Extent, Pixels)
	)

	// A line of a menu that opens a menu of its own beside it:
	// `SubMenu("Open recent") { MenuItem("a.adm"); MenuItem("b.adm") }`. The pointer on
	// the line opens it and leaving the line and its menu closes it; with the focus on
	// the line, Right, Enter or Space open it and Left, in its menu, closes it again. A
	// pick in it closes every menu it is in.
	component SubMenu {
		type {
			// The text of the line.
			@input(value = true)
			label string = ""

			// The name of an icon shown before the label; empty: none.
			@input
			icon string = ""

			// Whether its menu is shown.
			@bindable
			opened  bool

			block   ?paint.TextBlock = none
			look    Theme = UI.theme()
			picture IconSlot = new IconSlot()
			arrow   IconSlot = new IconSlot()

			def new() {
				focusable = true
				tabStop   = true
			}

			def current() paint.TextBlock {
				let made = controlLabel(block, label, style.font, style.foreground, style.paragraph, look, !disabled)
				block = made
				return made
			}

			def measure(limit Limit) Size<Pixels> {
				return current().measure(limit)
			}

			// The pointer on the line opens its menu; off the line and the menu, it closes.
			def pointer(e PointerEvent) bool {
				return false when disabled
				match e.phase {
					case PointerPhase.Enter:
						opened = true
						redraw()
					case PointerPhase.Leave:
						opened = false
						redraw()
					default:
				}
				// A press on the line keeps the menu it is in open.
				return e.phase := PointerPhase.Down || PointerPhase.Up
			}

			def key(e KeyEvent) bool {
				return false when !e.down
				return false when disabled
				let (forward, back) = style.geom.direction == Direction.RightToLeft ?? ((Key.Left, Key.Right), (Key.Right, Key.Left))
				// Its own line: open. A key that comes up from its menu: Left closes it and
				// the line has the focus again.
				if focused {
					let opens = e.key := Key.Enter || Key.KeypadEnter || Key.Space
					return false unless opens || e.key == forward
					opened = true
					redraw()
					return true
				}
				return false when e.key != back || !opened
				opened = false
				focus()
				return true
			}

			def render(ctx RenderContext) {
				let palette = look.palette
				let lit ?Color = none
				lit = palette.overlay.mix(palette.hover) when !disabled && (hover || opened || focusVisible)
				drawLineFace(ctx, look, lit, disabled ?? (palette.foregroundDisabled, palette.foreground), false, picture.get(icon), current())
				// The arrow at the end says there is more.
				let rtl = ctx.direction == Direction.RightToLeft
				let mark = arrow.get(rtl ?? ("chevron-left", "chevron-right"))
				let box = frameBox(ctx)
				let side = float(look.metrics.iconSize)
				let at = rtl ?? (float(look.metrics.unit), box.right - float(look.metrics.unit) - side)
				drawIcon(ctx.draw, mark, Rect{left: at, top: (box.bottom - side) / 2.0, right: at + side, bottom: (box.bottom + side) / 2.0}, disabled ?? (palette.foregroundDisabled, palette.foregroundMuted)) unless mark is none
				ctx.childNodes()
			}
		}

		view {
			Menu(open = opened, side = Side.End) {
				children()
			}
		}

		style {
			ControlStyle
			// Room for the check mark of the lines around it before the label, and for the arrow after it.
			padding   = new Edges<Extent>(0(px), theme.metrics.unit * 2.0 + theme.metrics.iconSize, 0(px), theme.metrics.unit * 2.0 + markSide * 1(px))
			minHeight = theme.metrics.controlHeight
			width     = fill
		}
	}

	// Something that shows more about a component when the pointer rests on it, with
	// content of its own: `Tooltip() { tip = view { Text("Saved"); Text("2 minutes ago") }; Button("Save") }`.
	// What is in its block is what it is about, laid out as if the tooltip were not there;
	// `tip` is what shows beside it. For plain text every component has `tooltip = "..."`.
	@scoped
	component Tooltip {
		type {
			// What shows.
			@input
			tip ?view = none

			// How long the pointer rests before it shows.
			@input
			delay duration = 500ms

			// The side it shows on when there is room.
			@input
			side Side = Side.Below
		}

		view {
			children()
			if !(tip is none) {
				HoverCard(delay = delay, linger = 0s, side = side) {
					tip()
				}
			}
		}
	}
}
