partial module std.ui.components {
	use (
		std.math.geom::(Circle, Point, Size)
		std.ui::(KeyEvent, Limit, PointerEvent, RenderContext, Theme, UI)
		std.ui.paint
		std.ui.styles::*
		std.units::Pixels
	)

	// The width and height of a `Switch`'s track, in logical pixels.
	internal const switchWidth = 34.0
	internal const switchHeight = 18.0

	// Something that is on or off and takes effect at once, with a label after it:
	// `Switch(on = wrap, label = "Wrap lines", onChange = setWrap)`. A click on the track
	// or the label, Space or Enter changes it.
	component Switch {
		type {
			// Whether it is on.
			@input(value = true, bind = true)
			@state
			on bool = false

			// The text after the track; empty: the track alone.
			@input
			label string = ""

			// Runs with the new state when the user changes it.
			@input
			onChange ?(def(bool)) = none

			// Tells every listener its new value, after the handler ran: heard with
			// `@on(Switch.changed)`.
			@emit()
			def changed(now bool) bool {
				return now
			}

			block ?paint.TextBlock = none
			look  Theme = UI.theme()

			def new() {
				focusable = true
				tabStop   = true
			}

			// Changes the state as a click does.
			def toggle() {
				return when disabled
				on = !on
				let tell = onChange
				tell(on) unless tell is none
				changed(on)
			}

			def current() paint.TextBlock {
				let made = controlLabel(block, label, style.font, style.foreground, style.paragraph, look, !disabled)
				block = made
				return made
			}

			def measure(limit Limit) Size<Pixels> {
				return markedSize(label, current(), switchWidth, limit)
			}

			def pointer(e PointerEvent) bool {
				return pressRuns(e, style.geom, !disabled, toggle)
			}

			def key(e KeyEvent) bool {
				return false when !e.down
				return keyRuns(e, !disabled, toggle)
			}

			def render(ctx RenderContext) {
				let palette = look.palette
				let track = markBox(ctx, switchWidth, switchHeight)
				let half = switchHeight / 2.0
				ctx.draw.fill(track, half, markFill(palette, on, hover, pressed, !disabled))
				drawEdge(ctx, look, track, half, hover && !disabled) unless on
				// The knob sits at the end of the line when on: the right, the left under
				// RightToLeft.
				let atEnd = on != (ctx.direction == Direction.RightToLeft)
				let centre = atEnd ?? (track.right - half, track.left + half)
				let knob = on ?? (palette.onAccent, !disabled ?? (palette.foregroundMuted, palette.foregroundDisabled))
				ctx.draw.fill(new Circle(new Point(centre, track.top + half), half * 2.0 / 3.0), knob)
				drawMarkLabel(ctx, label, current(), switchWidth)
				drawFocusRing(ctx, look, track, half) when focusVisible
			}
		}

		view {}

		style ControlStyle
	}
}
