partial module std.ui.components {
	use (
		std.math.geom::(Corners, Edges)
		std.ui::(KeyEvent, PointerEvent)
		std.ui.styles::*
		std.units::Extent
	)

	// The width and height of a `Switch`'s track, in logical pixels.
	internal const switchWidth = 34.0
	internal const switchHeight = 18.0

	// The knob of a `Switch`: the part named `knob` of its track. A disc in the muted
	// foreground, in what is drawn on the accent while `on`.
	internal component SwitchKnob {
		type {
			@input
			@state
			on bool = false
		}

		view {}

		style {
			Box
			Decorated
			width      = switchHeight * 2.0 / 3.0 * 1(px)
			height     = switchHeight * 2.0 / 3.0 * 1(px)
			radius     = new Corners<Extent>(switchHeight / 3.0 * 1(px))
			background = new BackgroundFill(theme.palette.foregroundMuted)
			on         = {
				disabled: {background: new BackgroundFill(theme.palette.foregroundDisabled)},
				on:       {background: new BackgroundFill(theme.palette.onAccent)},
			}
		}
	}

	// The track of a `Switch`: its part named `track`. It is told the control's states
	// and holds the knob, at its start while off and at its end while `on`.
	internal component SwitchTrack {
		type {
			@input
			@state
			on bool = false

			// The pointer is over the control, and holds it.
			@input
			@state
			over bool = false

			@input
			@state
			held bool = false

			// The control shows the keyboard focus.
			@input
			@state
			ringed bool = false
		}

		view {
			SwitchKnob(ref = knob, on = on)
		}

		style {
			MarkStyle
			Layout
			width  = switchWidth * 1(px)
			height = switchHeight * 1(px)
			radius = new Corners<Extent>(switchHeight / 2.0 * 1(px))
			// The knob's centre is half the track's height from its end; the edge is part
			// of the box.
			padding = new Edges<Extent>(0(px), switchHeight / 6.0 * 1(px) - theme.metrics.borderWidth)
			arrange = Arrange.Row
			align   = Align{horizontal: Alignment.Start, vertical: Alignment.Center}
			on      = {
				on: {align: Align{horizontal: Alignment.End, vertical: Alignment.Center}},
			}
		}
	}

	// Something that is on or off and takes effect at once, with a label after it:
	// `Switch(on = wrap, label = "Wrap lines", onChange = setWrap)`. A click on the track
	// or the label, Space or Enter changes it.
	component Switch {
		type {
			// Whether it is on.
			@input(value = true, bind = true)
			@state
			on bool = false

			// The text after the track; empty: the track alone.
			@input
			label string = ""

			// Runs with the new state when the user changes it.
			@input
			onChange ?(def(bool)) = none

			// Tells every listener its new value, after the handler ran: heard with
			// `@on(Switch.changed)`.
			@emit()
			def changed(now bool) bool {
				return now
			}

			def new() {
				focusable = true
				tabStop   = true
			}

			// Changes the state as a click does.
			def toggle() {
				return when disabled
				on = !on
				let tell = onChange
				tell(on) unless tell is none
				changed(on)
			}

			def pointer(e PointerEvent) bool {
				return pressRuns(e, style.geom, !disabled, toggle)
			}

			def key(e KeyEvent) bool {
				return false when !e.down
				return keyRuns(e, !disabled, toggle)
			}
		}

		// Its parts: `track`, the track with its `knob`, and `text`, the label.
		view {
			SwitchTrack(ref = track, on = on, over = hover, held = pressed, ringed = focusVisible)
			if label != "" {
				Text(label, ref = text)
			}
		}

		style MarkedStyle
	}
}
