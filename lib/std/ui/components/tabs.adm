partial module std.ui.components {
	use (
		std.ui::RenderContext
		std.ui.styles::*
	)

	// One page of a `Tabs`: `Tab(title = "main.adm") { ... }`. It is shown while it is the
	// current one, and fills the room under the strip.
	component Tab {
		type {
			// What its tab in the strip says.
			@input(value = true)
			title string = ""

			// Shows or hides the page. True when that changed it.
			def show(on bool) bool {
				return false when style.visible == on
				style.visible = on
				return true
			}
		}

		view {
			children()
		}

		style {
			ColumnStyle
			width  = fill
			height = fill
		}
	}

	// Pages of which one shows, under a strip of their titles:
	// `Tabs(current = shown, onChange = show) { Tab(title = "main.adm") { ... }; Tab(title = "lib.adm") { ... } }`.
	// A click on a title shows its page; the strip takes the keys a `TabStrip` does.
	component Tabs {
		type {
			// The index of the page that shows.
			@input(value = true, bind = true)
			@state
			current int = 0

			// Runs with the new index when the user picks another page.
			@input
			onChange ?(def(int)) = none

			// Tells every listener which one is current now, after the handler ran: heard with
			// `@on(Tabs.changed)`.
			@emit()
			def changed(index int) int {
				return index
			}

			// The pages' titles as the strip was last given them.
			names string[]

			// The pages' titles, in order: the same array until one changes. The view asks
			// for them each time it runs, which is when the pages are brought in step with
			// `current`, before their styles are read for the frame.
			def titles() string[] {
				let _ = sync()
				let now string[]
				for let child in childNodes {
					now.push(child.title) when child is Tab
				}
				let same = now.len() == names.len()
				if same {
					for let (i, name) in now {
						same = false when names[i] != name
					}
				}
				names = now unless same
				return names
			}

			// Shows the current page and hides the others. True when that changed any.
			def sync() bool {
				let changed = false
				let at = 0
				for let child in childNodes {
					if child is Tab {
						changed = true when child.show(at == current)
						at++
					}
				}
				return changed
			}

			// Shows the page as a click on its title does.
			def pick(index int) {
				// The strip wrote `current` already: it passes the bound input on.
				current = index
				let _ = sync()
				let tell = onChange
				tell(index) unless tell is none
				changed(index)
			}

			def attached() {
				let _ = sync()
			}

			def render(ctx RenderContext) {
				// Pages changed since the view ran show on the next frame.
				redraw() when sync()
				ctx.outerShadows()
				ctx.background()
				ctx.borders()
				ctx.childNodes()
				ctx.innerShadows()
			}
		}

		view {
			TabStrip(tabs = titles(), current = current, enabled = !disabled, onChange = pick)
			children()
		}

		style {
			ColumnStyle
			arrange = Arrange.Column
			width   = fill
			height  = fill
		}
	}
}
