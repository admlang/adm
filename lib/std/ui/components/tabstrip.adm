partial module std.ui.components {
	use (
		std.gfx.canvas
		std.gfx.color::(Color, Transparent)
		std.math.geom::(Axes, Corners, Edges, Rect, Size)
		std.ui::(Key, KeyEvent, Limit, MouseButton, PointerEvent, PointerPhase, RenderContext, Theme, UI)
		std.ui.frames
		std.ui.paint
		std.ui.styles::*
		std.units::(Extent, Pixels)
	)

	// The side of the cross that closes a tab of a `TabStrip`, in logical pixels.
	internal const tabCross = 14.0

	// A tab of a `TabStrip` was dragged from one place to another: both count from 0, in
	// the order before the move.
	struct TabMove {
		from int
		to   int
	}

	// The cross of a tab of a `TabStrip`: the part named `cross` of the tab, at its end.
	// The strip tells it the pointer is on it (`over`) or holds it (`held`).
	internal component TabCross {
		type {
			@input
			@state
			over bool = false

			@input
			@state
			held bool = false

			look Theme = UI.theme()

			def render(ctx RenderContext) {
				ctx.background()
				let box = frameBox(ctx)
				drawCross(ctx, box.left, box.top, box.right, inkOf(style.foreground, look.palette.foregroundMuted))
			}
		}

		view {}

		style {
			Box
			Decorated
			Foreground
			Interaction
			width      = tabCross * 1(px)
			height     = tabCross * 1(px)
			radius     = new Corners<Extent>(3(px))
			position   = Position.Relative
			anchors    = Anchors{right: new AnchorLine(theme.metrics.unit * 2.0), centerY: new AnchorLine(0(px))}
			foreground = theme.palette.foregroundMuted
			hitTest    = HitTest.None
			on         = {
				held:     {background: new BackgroundFill(theme.palette.surface.mix(theme.palette.hover))},
				over:     {background: new BackgroundFill(theme.palette.surface.mix(theme.palette.hover)), foreground: theme.palette.foreground},
				disabled: {foreground: theme.palette.foregroundDisabled, background: new BackgroundFill([])},
			}
		}
	}

	// What a tab of a `TabStrip` shows in its cross's place while the cross is not shown:
	// the caller's `mark` for the tab, centred in the cross's square at the tab's end.
	internal component TabMark {
		view {
			children()
		}

		style {
			Box
			Layout
			Interaction
			width    = tabCross * 1(px)
			height   = tabCross * 1(px)
			position = Position.Relative
			anchors  = Anchors{right: new AnchorLine(theme.metrics.unit * 2.0), centerY: new AnchorLine(0(px))}
			align    = Align{horizontal: Alignment.Center, vertical: Alignment.Center}
			hitTest  = HitTest.None
		}
	}

	// The cross at the end of a line of the folded tabs' menu of a `TabStrip`: a click on
	// it runs `onClick` (the strip closes the tab) and leaves the line unpicked. Lit under
	// the pointer; no focus stop.
	internal component TabLineCross {
		type {
			look Theme = UI.theme()

			def new() {
				focusable = false
			}

			def render(ctx RenderContext) {
				ctx.background()
				let box = frameBox(ctx)
				drawCross(ctx, box.left, box.top, box.right, inkOf(style.foreground, look.palette.foregroundMuted))
			}
		}

		view {}

		style {
			Box
			Decorated
			Foreground
			Interaction
			width      = tabCross * 1(px)
			height     = tabCross * 1(px)
			radius     = new Corners<Extent>(3(px))
			foreground = theme.palette.foregroundMuted
			on         = {
				hover:    {background: new BackgroundFill(theme.palette.surface.mix(theme.palette.hover)), foreground: theme.palette.foreground},
				pressed:  {background: new BackgroundFill(theme.palette.surface.mix(theme.palette.pressed))},
				disabled: {foreground: theme.palette.foregroundDisabled, background: new BackgroundFill([])},
			}
		}
	}

	// One tab of a `TabStrip`: a part of it, the tabs in order. Its title is drawn in its
	// style's `foreground`: muted, the plain one on the current tab, which stands on a
	// line of the accent. The strip takes the pointer and tells the tab what it found:
	// the pointer over it (`over`), the keyboard focus shown on it (`ringed`), and what its
	// cross is told.
	internal component TabTitle {
		type {
			@input(value = true)
			title string = ""

			@input
			@state
			current bool = false

			@input
			@state
			over bool = false

			@input
			@state
			ringed bool = false

			// Whether it has a cross at its end, and whether the cross is shown now; while
			// it is not, `mark` stands in its place.
			@input
			closable bool = false

			@input
			crossShown bool = true

			// What the tab shows in place of `title`.
			@input
			line ?view = none

			// What stands at its end while its cross is not shown; none for nothing.
			@input
			mark ?view = none

			@input
			crossOver bool = false

			@input
			crossHeld bool = false

			block ?paint.TextBlock = none
			look  Theme = UI.theme()

			def titled() paint.TextBlock {
				let made = labelBlock(block, title, style.font, em * 1(px), style.foreground, style.paragraph, look.palette.foregroundMuted, decoration = style.decoration)
				block = made
				return made
			}

			def measure(limit Limit) Size<Pixels> {
				return titled().measure(limit)
			}

			def render(ctx RenderContext) {
				ctx.outerShadows()
				ctx.background()
				ctx.borders()
				paint.drawBlock(ctx.draw, titled(), ctx.geometry.content.toFloat(), Align{horizontal: Alignment.Center, vertical: Alignment.Center}, ctx.direction == Direction.RightToLeft, ctx.scale) when line is none
				ctx.childNodes()
				ctx.innerShadows()
			}
		}

		view {
			if !(line is none) {
				line()
			}
			if closable && crossShown {
				TabCross(ref = cross, over = crossOver, held = crossHeld)
			} else if !(mark is none) {
				TabMark() {
					mark()
				}
			}
		}

		style {
			Box
			Control
			Layout
			arrange = Arrange.Row
			gap     = new Axes<Extent>(theme.metrics.unit)
			align   = Align{horizontal: Alignment.Center, vertical: Alignment.Center}
			// A title stays on one line: squeezed, it shortens in the middle, the way a
			// file name keeps its start and its extension. A heading given by the caller
			// inherits this unless it sets its own.
			paragraph = ParagraphLayout{wrap: Wrap.None, overflow: TextOverflow.EllipsisMiddle}
			// Three units beside the title, and room for the cross or the mark after it. The
			// line the current tab stands on is part of the box of every tab, so the titles
			// sit level.
			padding    = new Edges<Extent>(theme.metrics.borderWidth * 2.0, theme.metrics.unit * 3.0 + (self.closable || !(self.mark is none) ?? (tabCross * 1(px) + theme.metrics.unit, 0(px))), 0(px), theme.metrics.unit * 3.0)
			border     = {bottom: canvas.Border{width: theme.metrics.borderWidth * 2.0, paint: new Color(Transparent)}}
			foreground = theme.palette.foregroundMuted
			hitTest    = HitTest.None
			on         = {
				over:                {background: new BackgroundFill(theme.palette.surface.mix(theme.palette.hover))},
				current:             {foreground: theme.palette.foreground, background: new BackgroundFill([]), border: {bottom: canvas.Border{width: theme.metrics.borderWidth * 2.0, paint: theme.palette.accent}}},
				ringed:              {outline: Ring{width: theme.metrics.focusWidth, paint: theme.palette.focus, offset: -theme.metrics.focusWidth}},
				disabled:            {foreground: theme.palette.foregroundDisabled},
				[current, disabled]: {border: {bottom: canvas.Border{width: theme.metrics.borderWidth * 2.0, paint: theme.palette.foregroundDisabled}}},
			}
		}
	}

	// A row of tabs of which one is current:
	// `TabStrip(tabs = ["main.adm", "lib.adm"], current = shown, onChange = show)`. A click
	// on a tab makes it current; with the focus, the arrows move to the next and the one
	// before, Home and End to the first and the last. What a tab shows is the caller's.
	// With `onMove`, a tab is dragged along the row to another place: the caller moves
	// the title in what it passes as `tabs`. With `onClose`, each tab has a cross at its
	// end: a click on it, or a click of the middle button on the tab, runs it with the
	// tab's index, and the caller takes the title out. With `mark`, a tab shows the
	// caller's mark at its end (a dot for unsaved changes, a lock) and its cross only
	// while the pointer is on the tab. Tabs that do not fit fold behind a button at the
	// end that counts them and lists them in a menu, where a tab is closed as in the
	// strip: by its cross or the middle button. With `contextMenu`, the secondary button
	// on a tab, in the strip or in that list, opens a menu of the lines it gives.
	component TabStrip {
		type {
			// The tabs' titles, in order.
			@input(value = true)
			tabs string[] = []

			// The index of the current tab.
			@input(bind = true)
			@state
			current int = 0

			// What the tab at an index shows in place of its title:
			// `TabStrip(files, heading = (i int) => view { Icon(iconOf(i)); Text(files[i]) })`.
			@input
			heading ?(def(int) view) = none

			// What stands at the end of the tab at an index while the pointer is not on it,
			// in its cross's place: `TabStrip(files, mark = (i int) => unsaved(i) ?? (view { Dot() }, none))`.
			// None for a tab: nothing there. With `mark` set, a closable tab shows its cross
			// only while the pointer is on the tab (the middle button closes it as before);
			// unset, every closable tab shows its cross.
			@input
			mark ?(def(int) ?view) = none

			// The lines of the menu the secondary button opens on the tab at an index, in
			// the strip or in the folded tabs' list:
			// `TabStrip(files, contextMenu = (i int) => view { MenuItem("Close", onActivate = () => closeFile(i)) })`.
			// Unset: no menu.
			@input
			contextMenu ?(def(int) view) = none

			// The tab the secondary button came up on last: the one `contextMenu` lists for.
			contextTab int = -1

			// Runs with the new index when the user picks another tab.
			@input
			onChange ?(def(int)) = none

			// Tells every listener which one is current now, after the handler ran: heard with
			// `@on(TabStrip.changed)`.
			@emit()
			def changed(index int) int {
				return index
			}

			// Runs when the user drags a tab past the middle of a neighbour: with the place
			// it was at and the one it goes to. The caller moves the title in `tabs`; the
			// dragged tab stays the current one. Unset: tabs are not dragged.
			@input
			onMove ?(def(int, int)) = none

			// Tells every listener a tab was dragged to another place, after the handler
			// ran: heard with `@on(TabStrip.moved)`.
			@emit()
			def moved(move TabMove) TabMove {
				return move
			}

			// Runs with a tab's index when the user closes it: by the cross the tabs then
			// have, or with the middle button. The caller takes the title out of `tabs`.
			// Unset: tabs have no cross.
			@input
			onClose ?(def(int)) = none

			// Tells every listener the user closed a tab, after the handler ran: heard
			// with `@on(TabStrip.closed)`.
			@emit()
			def closed(index int) int {
				return index
			}

			// The tab whose cross the pointer is on, and the one whose cross was pressed;
			// -1 for none.
			crossOver int = -1
			crossHeld int = -1

			// The tab whose line of the folded tabs' menu the middle button went down on,
			// -1 for none.
			lineHeld int = -1

			// The tab being dragged, -1 for none.
			grabbed int = -1

			look   Theme = UI.theme()
			// The tab under the pointer, -1 for none.
			over   int = -1

			// When not every tab fits the strip, the tabs placed: their indices in order,
			// the current one among them, the rest behind the chevron button at the end,
			// whose menu lists every tab. None: every tab is placed.
			placed ?int[] = none
			// The width of each tab as laid out with every tab placed at its natural
			// width, and the titles that was for: what `refit` folds by once a frame has
			// shown them all. A state, so the strip's style (`wrap`) follows it.
			widths float[] = []
			@state
			measuredFor string = ""
			// Whether the menu of every tab is open; the menu clears it as it closes.
			@bindable
			menuOpen bool = false

			// Whether it is laid out right to left.
			def rtl() bool {
				return style.geom.direction == Direction.RightToLeft
			}

			def new() {
				focusable = true
				tabStop   = true
			}

			// The room on each side of a title.
			def pad() float {
				return float(look.metrics.unit) * 3.0
			}

			// The tabs: its parts after the line under them.
			def parts() component[] {
				let found component[]
				for let child in childNodes {
					found.push(child) when child is TabTitle
				}
				return found
			}

			// Where tab `i` was laid out, in the component; empty for one not placed.
			def slot(i int) Rect {
				return partSlot(partOf(i))
			}

			// Where the part `k` (a placed tab, in order) was laid out, in the component.
			def partSlot(k int) Rect {
				let held = parts()
				return Rect{} when k < 0 || k >= held.len()
				let (own, tab) = (style.geom.frame, held[k].style.geom.frame)
				let (left, top) = (float(tab.left) - float(own.left), float(tab.top) - float(own.top))
				return Rect{left: left, top: top, right: left + float(tab.width), bottom: top + float(tab.height)}
			}

			// The part showing tab `i`; -1 when it is behind the chevron.
			def partOf(i int) int {
				let folded = placed
				return i when folded is none
				for let (k, tab) in folded {
					return k when tab == i
				}
				return -1
			}

			// The tab part `k` shows.
			def tabOf(k int) int {
				let folded = placed
				return k when folded is none
				return k < folded.len() ?? (folded[k], -1)
			}

			// Whether the tabs' widths are to be measured on this frame: the titles are
			// not those the widths were noted for. The strip then wraps its row, so every
			// tab is laid out at its natural width (a row that does not wrap narrows its
			// tabs to fit, and a title that shortens with an ellipsis has no width it
			// cannot go under).
			def measuring() bool {
				return tabs.join("\n") != measuredFor
			}

			// Decides, once the strip is laid out, which tabs to place: all of them when
			// they fit, else the first ones that do with the current tab among them, the
			// chevron's square kept free. Runs as the strip is drawn, after the frame
			// that placed every tab at its natural width (`measuring`; their widths are
			// noted then and kept until the titles change) and after any other; a change
			// asks for the next frame to place the tabs again, so a strip shows its tabs
			// wrapped or clipped for one frame when it first shows or narrows.
			def refit() {
				// The strip takes the width of its tabs, folded or not: the room is
				// what holds it.
				let width = float(style.geom.frame.width)
				let above = parent()
				if !(above is none) {
					let room = float(above.style.geom.content.width)
					width = room when room > 0.0
				}
				return when width <= 0.0 || tabs.len() == 0
				let key = tabs.join("\n")
				if key != measuredFor {
					let held = parts()
					return when held.len() != tabs.len()
					widths = []
					for let part in held {
						widths.push(float(part.style.geom.frame.width))
					}
					measuredFor = key
				}
				let next = fitting(width)
				return when sameTabs(next, placed)
				placed = next
				let me component = self
				frames.askRebuild(me)
			}

			// The tabs to place in `width`: none when every tab fits, else the first that
			// fit beside the chevron button, and the current one however far it is. The
			// button's room is its width once it is laid out (its count makes it wider
			// than a square), a square before: a fold that proves too wide folds one more
			// tab on the next frame, and a larger count never narrows the button.
			def fitting(width float) ?int[] {
				let total = 0.0
				for let w in widths {
					total += w
				}
				return none when total <= width
				let reserved = float(look.metrics.controlHeight)
				let chevron = more
				if !(chevron is none) {
					let laid = float(chevron.style.geom.frame.width)
					reserved = laid when laid > reserved
				}
				let room = width - reserved
				let chosen int[] = []
				let used = current >= 0 && current < widths.len() ?? (widths[current], 0.0)
				for let (i, w) in widths {
					if i == current {
						chosen.push(i)
						continue
					}
					break when used + w > room
					used += w
					chosen.push(i)
				}
				chosen.push(current) when current >= 0 && current < widths.len() && !chosen.includes(current)
				return chosen
			}

			def sameTabs(a ?int[], b ?int[]) bool {
				return b is none when a is none
				return false when b is none
				return false when a.len() != b.len()
				for let (i, tab) in a {
					return false when b[i] != tab
				}
				return true
			}

			// Opens or closes the menu of every tab.
			def flipMenu() {
				menuOpen = !menuOpen when !disabled
			}

			// A tab picked from the menu.
			def pickFromMenu(index int) {
				menuOpen = false
				pick(index)
			}

			def render(ctx RenderContext) {
				ctx.outerShadows()
				ctx.background()
				ctx.borders()
				ctx.childNodes()
				ctx.innerShadows()
				refit()
			}

			// The square of tab `i`'s cross in the component.
			def crossBox(i int) Rect {
				let high = float(style.geom.frame.height)
				let tab = slot(i)
				let left = rtl() ?? (tab.left + pad() - float(look.metrics.unit), tab.right - pad() + float(look.metrics.unit) - tabCross)
				return Rect{left: left, top: (high - tabCross) / 2.0, right: left + tabCross, bottom: (high + tabCross) / 2.0}
			}

			// The tab whose cross holds a point of the component, -1 for none.
			def crossAt(x float, y float) int {
				return -1 when onClose is none
				let at = tabAt(x)
				return -1 when at < 0
				return holds(crossBox(at), x, y) ?? (at, -1)
			}

			// Closes the tab as a click on its cross does.
			def close(index int) {
				let tell = onClose
				return when disabled || tell is none || index < 0 || index >= tabs.len()
				tell(index)
				closed(index)
				redraw()
			}

			// The tab at a horizontal position in the component, -1 for none.
			def tabAt(x float) int {
				for let k = 0; k < parts().len(); k++ {
					let tab = partSlot(k)
					return tabOf(k) when x >= tab.left && x < tab.right
				}
				return -1
			}

			// The tab a pointer event is on: the one whose line of the folded tabs' menu the
			// event's target is on or under, else the one at the event's place in the
			// strip; -1 for none.
			def tabUnder(e PointerEvent) int {
				let line = lineTab(e.target)
				return line when line >= 0
				let y = float(e.position.y)
				return -1 when y < 0.0 || y >= float(style.geom.frame.height)
				return tabAt(float(e.position.x))
			}

			// The tab whose line of the folded tabs' menu `target` is or is under, -1 for
			// none: the lines stand in the menu in the tabs' order.
			def lineTab(target component) int {
				let lines = list
				return -1 when lines is none
				let holder component = lines
				let step = target
				for {
					let above = step.parent()
					return -1 when above is none
					if above == holder {
						for let (i, line) in lines.children {
							return i when line == step
						}
						return -1
					}
					step = above
				}
			}

			// Makes the tab current as a click does.
			def pick(index int) {
				return when disabled || index < 0 || index >= tabs.len() || index == current
				current = index
				let tell = onChange
				tell(index) unless tell is none
				changed(index)
			}

			// Moves the dragged tab when the pointer at `x` is past the middle of another
			// tab, on that tab's side of it.
			def drag(x float) {
				let tell = onMove
				let to = tabAt(x)
				return when tell is none || to < 0 || to == grabbed || grabbed < 0 || grabbed >= tabs.len()
				let (own, other) = (slot(grabbed), slot(to))
				let middle = (other.left + other.right) / 2.0
				return when other.left >= own.left && x < middle
				return when other.left < own.left && x > middle
				let from = grabbed
				grabbed = to
				current = to
				tell(from, to)
				moved(TabMove{from: from, to: to})
				redraw()
			}

			// Notes the tab under the pointer and asks to be drawn when it is another one.
			def point(index int) {
				return when index == over
				over = index
				redraw()
			}

			def pointer(e PointerEvent) bool {
				return false when disabled
				match e.phase {
					case PointerPhase.Move, PointerPhase.Enter:
						point(tabAt(float(e.position.x)))
						let cross = crossAt(float(e.position.x), float(e.position.y))
						if cross != crossOver {
							crossOver = cross
							redraw()
						}
						return false when grabbed < 0 || e.phase != PointerPhase.Move
						drag(float(e.position.x))
						return true
					case PointerPhase.Leave:
						point(-1)
						return false
					case PointerPhase.Cancel:
						point(-1)
						grabbed   = -1
						crossHeld = -1
						lineHeld  = -1
						return false
					case PointerPhase.Down:
						// The middle button on a tab, or on its line of the folded tabs'
						// menu, closes it when it comes up there.
						if e.button == MouseButton.Middle && !(onClose is none) {
							let line = lineTab(e.target)
							if line >= 0 {
								lineHeld = line
							} else {
								crossHeld = tabUnder(e)
							}
							e.capture()
							return crossHeld >= 0 || lineHeld >= 0
						}
						return false when e.button != MouseButton.Left
						// A press on a cross is the cross's: the tab is neither picked nor
						// dragged.
						crossHeld = crossAt(float(e.position.x), float(e.position.y))
						if crossHeld >= 0 {
							e.capture()
							redraw()
							return true
						}
						let at = tabAt(float(e.position.x))
						pick(at)
						// A tab that can be moved holds the pointer until it is let go of.
						if at >= 0 && !(onMove is none) {
							grabbed = at
							e.capture()
						}
						return true
					case PointerPhase.Up:
						if lineHeld >= 0 {
							let pressed = lineHeld
							lineHeld = -1
							close(pressed) when lineTab(e.target) == pressed
							return true
						}
						if crossHeld >= 0 {
							let pressed = crossHeld
							crossHeld = -1
							let (x, y) = (float(e.position.x), float(e.position.y))
							let released = e.button == MouseButton.Middle ?? (tabUnder(e), crossAt(x, y))
							close(pressed) when released == pressed && y >= 0.0 && y < float(style.geom.frame.height)
							redraw()
							return true
						}
						// The secondary button came up on a tab: the context menu, which the
						// runtime opens after this, lists for that tab.
						if e.button == MouseButton.Right && !(contextMenu is none) {
							let at = tabUnder(e)
							if at != contextTab {
								contextTab = at
								redraw()
							}
							return false
						}
						let held = grabbed >= 0
						grabbed = -1
						return held
					default:
						return false
				}
			}

			def key(e KeyEvent) bool {
				return false when !e.down
				return false when disabled || tabs.len() == 0
				let step = rtl() ?? (-1, 1)
				match e.key {
					case Key.Left:
						pick((current - step + tabs.len()) % tabs.len())
					case Key.Right:
						pick((current + step + tabs.len()) % tabs.len())
					case Key.Home:
						pick(0)
					case Key.End:
						pick(tabs.len() - 1)
					default:
						return false
				}
				return true
			}

			// What `heading` gives for the tab at `index`; none without it.
			def headingAt(index int) ?view {
				let make = heading
				return none when make is none
				return make(index)
			}

			// What `mark` gives for the tab at `index`; none without it.
			def markAt(index int) ?view {
				let make = mark
				return none when make is none
				return make(index)
			}

			// Whether the tab at `index` shows its cross: always without `mark`, else while
			// the pointer is on the tab or holds its cross.
			def crossShownOn(index int) bool {
				return mark is none || index == over || index == crossHeld
			}

			// What the line of the folded tabs' menu for the tab at `index` shows at its
			// end: the tab's mark, then its cross when tabs can be closed; none for
			// neither.
			def lineEnd(index int) ?view {
				let marked = markAt(index)
				return none when marked is none && onClose is none
				return view {
					if !(marked is none) {
						marked()
					}
					if !(onClose is none) {
						TabLineCross(onClick = def () {
							close(index)
						})
					}
				}
			}

			// The lines `contextMenu` gives for the tab the secondary button came up on;
			// none when there is no such tab.
			def contextLines() ?view {
				let make = contextMenu
				return none when make is none || contextTab < 0 || contextTab >= tabs.len()
				return make(contextTab)
			}
		}

		// Its parts: `line`, the line under the tabs, then a tab per title, each with its
		// `cross` when tabs can be closed, or its mark. When not every tab fits (`refit`),
		// only those placed, then the chevron button and its menu of every tab (`list`),
		// each line ending in the tab's mark and its cross. Last, with `contextMenu`, the
		// menu the secondary button opens, listing for the tab it came up on.
		view {
			StripLine(ref = line)
			let folded = placed
			if folded is none || measuring() {
				for let (i, title) in tabs {
					TabTitle(title, line = headingAt(i), mark = markAt(i), current = i == current, over = i == over && i != current, ringed = i == current && focusVisible, closable = !(onClose is none), crossShown = crossShownOn(i), crossOver = i == crossOver, crossHeld = i == crossHeld)
				}
			} else {
				for let i in folded {
					TabTitle(tabs[i], line = headingAt(i), mark = markAt(i), current = i == current, over = i == over && i != current, ringed = i == current && focusVisible, closable = !(onClose is none), crossShown = crossShownOn(i), crossOver = i == crossOver, crossHeld = i == crossHeld)
				}
				// The button counts the folded tabs; a menu line shows a tab as the strip
				// does, its heading or its title, with its mark at the end.
				Button("+{tabs.len() - folded.len()}", trailing = "chevron-down", onClick = flipMenu, enabled = !disabled, ref = more)
				Menu(open = menuOpen, attach = more, openAtChecked = true, ref = list) {
					for let (i, title) in tabs {
						MenuItem(label = heading is none ?? (title, ""), start = headingAt(i), end = lineEnd(i), checked = i == current, key = i, onActivate = def () {
							pickFromMenu(i)
						})
					}
				}
			}
			if !(contextMenu is none) {
				ContextMenu() {
					let lines = contextLines()
					if !(lines is none) {
						lines()
					}
				}
			}
		}

		style {
			ControlStyle
			Layout
			height  = theme.metrics.controlHeight + theme.metrics.unit
			arrange = Arrange.Row
			wrap    = self.measuring()
			align   = Align{horizontal: Alignment.Start, vertical: Alignment.Fill}
		}
	}
}
