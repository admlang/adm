partial module std.ui.components {
	use (
		std.gfx.canvas
		std.gfx.color::(Color, Transparent)
		std.math.geom::(Axes, Corners, Edges, Rect, Size)
		std.ui::(Key, KeyEvent, Limit, MouseButton, PointerEvent, PointerPhase, RenderContext, Theme, UI)
		std.ui.paint
		std.ui.styles::*
		std.units::(Extent, Pixels)
	)

	// The side of the cross that closes a tab of a `TabStrip`, in logical pixels.
	internal const tabCross = 14.0

	// A tab of a `TabStrip` was dragged from one place to another: both count from 0, in
	// the order before the move.
	struct TabMove {
		from int
		to   int
	}

	// The cross of a tab of a `TabStrip`: the part named `cross` of the tab, at its end.
	// The strip tells it the pointer is on it (`over`) or holds it (`held`).
	internal component TabCross {
		type {
			@input
			@state
			over bool = false

			@input
			@state
			held bool = false

			look Theme = UI.theme()

			def render(ctx RenderContext) {
				ctx.background()
				let box = frameBox(ctx)
				drawCross(ctx, box.left, box.top, box.right, inkOf(style.foreground, look.palette.foregroundMuted))
			}
		}

		view {}

		style {
			Box
			Decorated
			Foreground
			Interaction
			width      = tabCross * 1(px)
			height     = tabCross * 1(px)
			radius     = new Corners<Extent>(3(px))
			position   = Position.Relative
			anchors    = Anchors{right: new AnchorLine(theme.metrics.unit * 2.0), centerY: new AnchorLine(0(px))}
			foreground = theme.palette.foregroundMuted
			hitTest    = HitTest.None
			on         = {
				held:     {background: new BackgroundFill(theme.palette.surface.mix(theme.palette.hover))},
				over:     {background: new BackgroundFill(theme.palette.surface.mix(theme.palette.hover)), foreground: theme.palette.foreground},
				disabled: {foreground: theme.palette.foregroundDisabled, background: new BackgroundFill([])},
			}
		}
	}

	// One tab of a `TabStrip`: a part of it, the tabs in order. Its title is drawn in its
	// style's `foreground`: muted, the plain one on the current tab, which stands on a
	// line of the accent. The strip takes the pointer and tells the tab what it found:
	// the pointer over it (`over`), the keyboard focus shown on it (`ringed`), and what its
	// cross is told.
	internal component TabTitle {
		type {
			@input(value = true)
			title string = ""

			@input
			@state
			current bool = false

			@input
			@state
			over bool = false

			@input
			@state
			ringed bool = false

			// Whether it has a cross at its end.
			@input
			closable bool = false

			// What the tab shows in place of `title`.
			@input
			line ?view = none

			@input
			crossOver bool = false

			@input
			crossHeld bool = false

			block ?paint.TextBlock = none
			look  Theme = UI.theme()

			def titled() paint.TextBlock {
				let made = labelBlock(block, title, style.font, em * 1(px), style.foreground, style.paragraph, look.palette.foregroundMuted, decoration = style.decoration)
				block = made
				return made
			}

			def measure(limit Limit) Size<Pixels> {
				return titled().measure(limit)
			}

			def render(ctx RenderContext) {
				ctx.outerShadows()
				ctx.background()
				ctx.borders()
				paint.drawBlock(ctx.draw, titled(), ctx.geometry.content.toFloat(), Align{horizontal: Alignment.Center, vertical: Alignment.Center}, ctx.direction == Direction.RightToLeft, ctx.scale) when line is none
				ctx.childNodes()
				ctx.innerShadows()
			}
		}

		view {
			if !(line is none) {
				line()
			}
			if closable {
				TabCross(ref = cross, over = crossOver, held = crossHeld)
			}
		}

		style {
			Box
			Control
			Layout
			arrange = Arrange.Row
			gap     = new Axes<Extent>(theme.metrics.unit)
			align   = Align{horizontal: Alignment.Center, vertical: Alignment.Center}
			// Three units beside the title, and room for the cross after it. The line the
			// current tab stands on is part of the box of every tab, so the titles sit level.
			padding    = new Edges<Extent>(theme.metrics.borderWidth * 2.0, theme.metrics.unit * 3.0 + (self.closable ?? (tabCross * 1(px) + theme.metrics.unit, 0(px))), 0(px), theme.metrics.unit * 3.0)
			border     = {bottom: canvas.Border{width: theme.metrics.borderWidth * 2.0, paint: new Color(Transparent)}}
			foreground = theme.palette.foregroundMuted
			hitTest    = HitTest.None
			on         = {
				over:                {background: new BackgroundFill(theme.palette.surface.mix(theme.palette.hover))},
				current:             {foreground: theme.palette.foreground, background: new BackgroundFill([]), border: {bottom: canvas.Border{width: theme.metrics.borderWidth * 2.0, paint: theme.palette.accent}}},
				ringed:              {outline: Ring{width: theme.metrics.focusWidth, paint: theme.palette.focus, offset: -theme.metrics.focusWidth}},
				disabled:            {foreground: theme.palette.foregroundDisabled},
				[current, disabled]: {border: {bottom: canvas.Border{width: theme.metrics.borderWidth * 2.0, paint: theme.palette.foregroundDisabled}}},
			}
		}
	}

	// A row of tabs of which one is current:
	// `TabStrip(tabs = ["main.adm", "lib.adm"], current = shown, onChange = show)`. A click
	// on a tab makes it current; with the focus, the arrows move to the next and the one
	// before, Home and End to the first and the last. What a tab shows is the caller's.
	// With `onMove`, a tab is dragged along the row to another place: the caller moves
	// the title in what it passes as `tabs`. With `onClose`, each tab has a cross at its
	// end: a click on it, or a click of the middle button on the tab, runs it with the
	// tab's index, and the caller takes the title out.
	component TabStrip {
		type {
			// The tabs' titles, in order.
			@input(value = true)
			tabs string[] = []

			// The index of the current tab.
			@input(bind = true)
			@state
			current int = 0

			// What the tab at an index shows in place of its title:
			// `TabStrip(files, heading = (i int) => view { Icon(iconOf(i)); Text(files[i]) })`.
			@input
			heading ?(def(int) view) = none

			// Runs with the new index when the user picks another tab.
			@input
			onChange ?(def(int)) = none

			// Tells every listener which one is current now, after the handler ran: heard with
			// `@on(TabStrip.changed)`.
			@emit()
			def changed(index int) int {
				return index
			}

			// Runs when the user drags a tab past the middle of a neighbour: with the place
			// it was at and the one it goes to. The caller moves the title in `tabs`; the
			// dragged tab stays the current one. Unset: tabs are not dragged.
			@input
			onMove ?(def(int, int)) = none

			// Tells every listener a tab was dragged to another place, after the handler
			// ran: heard with `@on(TabStrip.moved)`.
			@emit()
			def moved(move TabMove) TabMove {
				return move
			}

			// Runs with a tab's index when the user closes it: by the cross the tabs then
			// have, or with the middle button. The caller takes the title out of `tabs`.
			// Unset: tabs have no cross.
			@input
			onClose ?(def(int)) = none

			// Tells every listener the user closed a tab, after the handler ran: heard
			// with `@on(TabStrip.closed)`.
			@emit()
			def closed(index int) int {
				return index
			}

			// The tab whose cross the pointer is on, and the one whose cross was pressed;
			// -1 for none.
			crossOver int = -1
			crossHeld int = -1

			// The tab being dragged, -1 for none.
			grabbed int = -1

			look   Theme = UI.theme()
			// The tab under the pointer, -1 for none.
			over   int = -1

			// Whether it is laid out right to left.
			def rtl() bool {
				return style.geom.direction == Direction.RightToLeft
			}

			def new() {
				focusable = true
				tabStop   = true
			}

			// The room on each side of a title.
			def pad() float {
				return float(look.metrics.unit) * 3.0
			}

			// The tabs: its parts after the line under them.
			def parts() component[] {
				let found component[]
				for let child in childNodes {
					found.push(child) when child is TabTitle
				}
				return found
			}

			// Where tab `i` was laid out, in the component.
			def slot(i int) Rect {
				let held = parts()
				return Rect{} when i < 0 || i >= held.len()
				let (own, tab) = (style.geom.frame, held[i].style.geom.frame)
				let (left, top) = (float(tab.left) - float(own.left), float(tab.top) - float(own.top))
				return Rect{left: left, top: top, right: left + float(tab.width), bottom: top + float(tab.height)}
			}

			// The square of tab `i`'s cross in the component.
			def crossBox(i int) Rect {
				let high = float(style.geom.frame.height)
				let tab = slot(i)
				let left = rtl() ?? (tab.left + pad() - float(look.metrics.unit), tab.right - pad() + float(look.metrics.unit) - tabCross)
				return Rect{left: left, top: (high - tabCross) / 2.0, right: left + tabCross, bottom: (high + tabCross) / 2.0}
			}

			// The tab whose cross holds a point of the component, -1 for none.
			def crossAt(x float, y float) int {
				return -1 when onClose is none
				let at = tabAt(x)
				return -1 when at < 0
				return holds(crossBox(at), x, y) ?? (at, -1)
			}

			// Closes the tab as a click on its cross does.
			def close(index int) {
				let tell = onClose
				return when disabled || tell is none || index < 0 || index >= tabs.len()
				tell(index)
				closed(index)
				redraw()
			}

			// The tab at a horizontal position in the component, -1 for none.
			def tabAt(x float) int {
				for let i = 0; i < parts().len(); i++ {
					let tab = slot(i)
					return i when x >= tab.left && x < tab.right
				}
				return -1
			}

			// Makes the tab current as a click does.
			def pick(index int) {
				return when disabled || index < 0 || index >= tabs.len() || index == current
				current = index
				let tell = onChange
				tell(index) unless tell is none
				changed(index)
			}

			// Moves the dragged tab when the pointer at `x` is past the middle of another
			// tab, on that tab's side of it.
			def drag(x float) {
				let tell = onMove
				let to = tabAt(x)
				return when tell is none || to < 0 || to == grabbed || grabbed < 0 || grabbed >= tabs.len()
				let (own, other) = (slot(grabbed), slot(to))
				let middle = (other.left + other.right) / 2.0
				return when other.left >= own.left && x < middle
				return when other.left < own.left && x > middle
				let from = grabbed
				grabbed = to
				current = to
				tell(from, to)
				moved(TabMove{from: from, to: to})
				redraw()
			}

			// Notes the tab under the pointer and asks to be drawn when it is another one.
			def point(index int) {
				return when index == over
				over = index
				redraw()
			}

			def pointer(e PointerEvent) bool {
				return false when disabled
				match e.phase {
					case PointerPhase.Move, PointerPhase.Enter:
						point(tabAt(float(e.position.x)))
						let cross = crossAt(float(e.position.x), float(e.position.y))
						if cross != crossOver {
							crossOver = cross
							redraw()
						}
						return false when grabbed < 0 || e.phase != PointerPhase.Move
						drag(float(e.position.x))
						return true
					case PointerPhase.Leave:
						point(-1)
						return false
					case PointerPhase.Cancel:
						point(-1)
						grabbed   = -1
						crossHeld = -1
						return false
					case PointerPhase.Down:
						// The middle button on a tab closes it when it comes up there.
						if e.button == MouseButton.Middle && !(onClose is none) {
							crossHeld = tabAt(float(e.position.x))
							e.capture()
							return crossHeld >= 0
						}
						return false when e.button != MouseButton.Left
						// A press on a cross is the cross's: the tab is neither picked nor
						// dragged.
						crossHeld = crossAt(float(e.position.x), float(e.position.y))
						if crossHeld >= 0 {
							e.capture()
							redraw()
							return true
						}
						let at = tabAt(float(e.position.x))
						pick(at)
						// A tab that can be moved holds the pointer until it is let go of.
						if at >= 0 && !(onMove is none) {
							grabbed = at
							e.capture()
						}
						return true
					case PointerPhase.Up:
						if crossHeld >= 0 {
							let pressed = crossHeld
							crossHeld = -1
							let (x, y) = (float(e.position.x), float(e.position.y))
							let released = e.button == MouseButton.Middle ?? (tabAt(x), crossAt(x, y))
							close(pressed) when released == pressed && y >= 0.0 && y < float(style.geom.frame.height)
							redraw()
							return true
						}
						let held = grabbed >= 0
						grabbed = -1
						return held
					default:
						return false
				}
			}

			def key(e KeyEvent) bool {
				return false when !e.down
				return false when disabled || tabs.len() == 0
				let step = rtl() ?? (-1, 1)
				match e.key {
					case Key.Left:
						pick((current - step + tabs.len()) % tabs.len())
					case Key.Right:
						pick((current + step + tabs.len()) % tabs.len())
					case Key.Home:
						pick(0)
					case Key.End:
						pick(tabs.len() - 1)
					default:
						return false
				}
				return true
			}

			// What `heading` gives for the tab at `index`; none without it.
			def headingAt(index int) ?view {
				let make = heading
				return none when make is none
				return make(index)
			}
		}

		// Its parts: `line`, the line under the tabs, then a tab per title, each with its
		// `cross` when tabs can be closed.
		view {
			StripLine(ref = line)
			for let (i, title) in tabs {
				TabTitle(title, line = headingAt(i), current = i == current, over = i == over && i != current, ringed = i == current && focusVisible, closable = !(onClose is none), crossOver = i == crossOver, crossHeld = i == crossHeld)
			}
		}

		style {
			ControlStyle
			Layout
			height  = theme.metrics.controlHeight + theme.metrics.unit
			arrange = Arrange.Row
			align   = Align{horizontal: Alignment.Start, vertical: Alignment.Fill}
		}
	}
}
