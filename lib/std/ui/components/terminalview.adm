partial module std.ui.components {
	use (
		std.gfx.color::(Color, RGBA)
		std.math.geom::(Point, Rect, Size)
		std.services.clipboard::Clipboard
		std.terminal
		std.time
		std.ui::(Key, KeyEvent, Limit, MouseButton, PointerEvent, PointerPhase, RenderContext, TextKind, TextRange, Theme, UI)
		std.ui.paint
		std.ui.runtime::wakeBy
		std.ui.styles::*
		std.units::Pixels
	)

	// How long a size change waits before `onResize` hears it, so a window being
	// dragged reports its final size, not every step.
	internal const terminalResizeSettle = 150ms

	// The sixteen named terminal colours as xterm draws them, used where the theme
	// names none (`terminal.ansiRed`, `terminal.ansiBrightBlue`, ...).
	internal const ansiNames = string[
		"Black", "Red", "Green", "Yellow", "Blue", "Magenta", "Cyan", "White",
		"BrightBlack", "BrightRed", "BrightGreen", "BrightYellow", "BrightBlue", "BrightMagenta", "BrightCyan", "BrightWhite"]
	internal const ansiRgb = int[
		0, 0, 0, 205, 0, 0, 0, 205, 0, 205, 205, 0, 0, 0, 238, 205, 0, 205, 0, 205, 205, 229, 229, 229,
		127, 127, 127, 255, 0, 0, 0, 255, 0, 255, 255, 0, 92, 92, 255, 255, 0, 255, 0, 255, 255, 255, 255, 255]

	// TerminalView shows a `terminal.Screen` and sends what the user types to the
	// program behind it: a shell in a container or over SSH. The caller owns the
	// stream: it hands what the program writes to `feed`, and gets the bytes to
	// write back (keys, pasted text, the screen's replies) through `onInput`, and
	// the size in cells through `onResize` whenever the view's room changes.
	//
	// ```
	// TerminalView(shell, onInput = def (data byte[]) { session.write(data) onerror recover none },
	//              onResize = def (columns int, rows int) { session.resize(rows, columns) onerror recover none })
	// ```
	//
	// Keys are sent as xterm sends them (arrows and function keys with their
	// modifiers, Control and Alt chords, application cursor keys when the program
	// asked for them); Ctrl+Shift+C and Ctrl+Shift+V (Command+C and +V on macOS)
	// copy the selection and paste, pasting bracketed when the program asked
	// (mode 2004). The wheel scrolls back through the lines that left the top;
	// Shift+PageUp and Shift+PageDown page through them; any key sent returns to
	// the live screen. A drag selects cells, a double click a word, a triple click
	// a line. In the alternate screen the wheel sends arrow keys instead.
	//
	// While it has the focus the view takes the platform's text input, as a text
	// field does: typed and composed text goes to the program once it is final,
	// and what an input method is still composing shows at the cursor.
	component TerminalView {
		type {
			// The screen shown; none shows nothing.
			@input(value = true)
			screen ?terminal.Screen = none

			// Takes the bytes the program is to read: what was typed or pasted,
			// and what the screen answers to the program's queries.
			@input
			onInput ?(def(byte[])) = none

			// Hears the size in cells (columns, rows) once it settles after the
			// view's room changed, and once at first.
			@input
			onResize ?(def(int, int)) = none

			// Lines of scrollback shown above the live screen; 0 shows it live.
			back int = 0

			internal look         Theme = UI.theme()
			cellWidth    float = 0.0
			cellHeight   float = 0.0
			columns      int = 0
			rows         int = 0
			internal reported     Size<int> = Size<int>{width: 0, height: 0}
			internal settleAt     time.Time
			internal settling     bool = false
			// A selection: where the press was and where the pointer is, in cells of
			// the screen as scrolled back when it started; `marked` says one shows.
			internal marked       bool = false
			internal anchor       Point<int> = Point<int>{x: 0, y: 0}
			internal reach        Point<int> = Point<int>{x: 0, y: 0}
			internal markedBack   int = 0
			internal dragging     bool = false
			// Blocks of the rows drawn last, kept while a row's content stands.
			internal rowBlocks    paint.TextBlock[] = []
			internal rowKeys      string[] = []
			// What an input method is composing, shown at the cursor until `commit`
			// sends what it became.
			internal composing    string = ""

			def new() {
				focusable    = true
				tabStop      = true
				capturesKeys = true
			}

			// feed hands the view what the program wrote: the screen reads it, its
			// replies go out through `onInput`, and the view is drawn again.
			def feed(data byte[]) {
				let shown = screen
				return when shown is none
				shown.feed(data)
				answer(shown)
				redraw()
			}

			// feed hands the view text the program wrote, as its UTF-8.
			def feed(text string) {
				feed(text.bytes())
			}

			// send writes bytes to the program through `onInput`, as a key does; the
			// view returns to the live screen.
			def send(data byte[]) {
				return when data.len() == 0
				back = 0
				let out = onInput
				out(data) unless out is none
			}

			// What the screen answered to the program since last asked goes out.
			internal def answer(shown terminal.Screen) {
				let replies = shown.responses()
				return when replies.len() == 0
				let out = onInput
				out(replies) unless out is none
			}

			// The text selected, "" without a selection.
			def selectedText() string {
				let shown = screen
				return "" when !marked || shown is none
				return shown.selection(markedBack, anchor.x, anchor.y, reach.x, reach.y)
			}

			// copy puts the selection on the clipboard; nothing without one.
			def copy() {
				let text = selectedText()
				return when text == ""
				Clipboard.copy(text) onerror recover none
			}

			// paste sends the clipboard's text to the program, bracketed when the
			// program asked for it, line ends as the Enter key sends them.
			def paste() {
				let text = Clipboard.paste() onerror recover ""
				return when text == ""
				let shown = screen
				let typed = text.replace("\r\n", "\r", -1).replace("\n", "\r", -1)
				if !(shown is none) && shown.bracketedPaste {
					send(("\u001b[200~" + typed + "\u001b[201~").bytes())
				} else {
					send(typed.bytes())
				}
			}

			// Typed text goes to the program as it is, in place of what was being
			// composed.
			def commit(text string) {
				if composing != "" {
					composing = ""
					redraw()
				}
				send(text.bytes())
			}

			// Text being composed is not the program's yet: it shows at the cursor.
			def compose(text string, caret int) {
				return when text == composing
				composing = text
				redraw()
			}

			// The program holds the text, not the view: an input method gets no
			// context.
			def surrounding() string {
				return ""
			}

			def selection() TextRange {
				return TextRange{start: 0, end: 0}
			}

			// An on-screen keyboard deletes this way: sent as that many Backspace
			// keys, then that many Delete keys.
			def deleteSurrounding(before int, after int) {
				let shown = screen
				return when shown is none
				let erase = keyBytes(KeyEvent{target: self, key: Key.Backspace}, shown)
				let remove = keyBytes(KeyEvent{target: self, key: Key.Delete}, shown)
				let out byte[] = []
				for let n = 0; n < before; n++ {
					out.push(...erase)
				}
				for let n = 0; n < after; n++ {
					out.push(...remove)
				}
				send(out)
			}

			// The cursor's cell, where the platform puts its candidate window.
			def caretRect() Rect<Pixels> {
				let frame = style.geom.frame
				let inside = style.geom.content
				let shown = screen
				let (column, row) = shown is none ?? ((0, 0), (shown.cursor.column, shown.cursor.row))
				let left = float(frame.left) + float(inside.left) + float(column) * cellWidth
				let top = float(frame.top) + float(inside.top) + float(row) * cellHeight
				return Rect<Pixels>{left: left * 1(px), top: top * 1(px), right: (left + cellWidth) * 1(px), bottom: (top + cellHeight) * 1(px)}
			}

			def inputKind() TextKind {
				return TextKind.Text
			}

			def key(e KeyEvent) bool {
				return false when !e.down
				let shown = screen
				return false when shown is none
				let shift = e.modifiers.shift
				let control = e.modifiers.control
				// Copy and paste as terminals have them: with Shift beside the
				// shortcut key, so Ctrl+C still reaches the program.
				let chord = (e.modifiers.mod && shift) || (e.modifiers.command && !control)
				if chord && e.key == Key.C {
					copy()
					return true
				}
				if chord && e.key == Key.V {
					paste()
					return true
				}
				if shift && !control && !e.modifiers.alt && (e.key == Key.PageUp || e.key == Key.PageDown) {
					let page = rows.max(1)
					scrollBy(e.key == Key.PageUp ?? (page, -page), shown)
					return true
				}
				let data = keyBytes(e, shown)
				if data.len() > 0 {
					send(data)
					return true
				}
				// A key that types sends its text through `commit`; it is taken here
				// so no shortcut above the view sees it.
				return e.text != "" && !control && !e.modifiers.alt && !e.modifiers.command
			}

			def pointer(e PointerEvent) bool {
				let shown = screen
				return false when shown is none
				match e.phase {
					case PointerPhase.Scroll:
						let lines = int((float(e.scroll.y) / cellHeight.max(1.0)).round())
						return false when lines == 0
						if shown.alternate {
							// A full-screen program hears the wheel as cursor keys.
							let arrow = lines < 0 ?? (keyBytes(KeyEvent{target: self, key: Key.Up}, shown), keyBytes(KeyEvent{target: self, key: Key.Down}, shown))
							let out byte[] = []
							for let n = 0; n < lines.abs() * 3; n++ {
								out.push(...arrow)
							}
							send(out)
							return true
						}
						scrollBy(-lines, shown)
						return true
					case PointerPhase.Down:
						return false when e.button != MouseButton.Left
						focus()
						e.capture()
						let (column, row) = cellAt(e.position)
						if e.clicks >= 3 {
							markedBack = back
							anchor     = Point<int>{x: 0, y: row}
							reach      = Point<int>{x: columns, y: row}
							marked     = true
							dragging   = false
							redraw()
							return true
						}
						if e.clicks == 2 {
							selectWord(shown, column, row)
							dragging = false
							redraw()
							return true
						}
						markedBack = back
						anchor     = Point<int>{x: column, y: row}
						reach      = anchor
						marked     = false
						dragging   = true
						redraw()
						return true
					case PointerPhase.Move:
						return false when !dragging
						let (column, row) = cellAt(e.position)
						let moved = Point<int>{x: column, y: row}
						marked = moved.x != anchor.x || moved.y != anchor.y
						reach  = moved
						redraw()
						return true
					case PointerPhase.Up, PointerPhase.Cancel:
						return false when !dragging
						dragging = false
						redraw()
						return true
					default:
						return false
				}
			}

			// scrollBy moves the view through the scrollback by `lines` (up when
			// positive), as far as it goes.
			internal def scrollBy(lines int, shown terminal.Screen) {
				let want = (back + lines).max(0).min(shown.scrollbackLines())
				return when want == back
				back = want
				redraw()
			}

			// The cell under a point of the view, the row counted on the screen as
			// scrolled back now.
			internal def cellAt(at Point<Pixels>) (int, int) {
				let inside = style.geom.content
				let x = float(at.x) - float(inside.left)
				let y = float(at.y) - float(inside.top)
				let column = int((x / cellWidth.max(1.0)).floor()).max(0).min(columns.max(1))
				let row = int((y / cellHeight.max(1.0)).floor()).max(0).min(rows.max(1) - 1)
				return (column, row)
			}

			// selectWord marks the run of non-blank cells around a cell.
			internal def selectWord(shown terminal.Screen, column int, row int) {
				let cells = shown.line(row, back)
				return when cells.len() == 0
				let at = column.min(cells.len() - 1)
				return when isBlank(cells[at])
				let first = at
				for first > 0 && !isBlank(cells[first - 1]) {
					first--
				}
				let last = at + 1
				for last < cells.len() && !isBlank(cells[last]) {
					last++
				}
				markedBack = back
				anchor     = Point<int>{x: first, y: row}
				reach      = Point<int>{x: last, y: row}
				marked     = true
			}

			internal def isBlank(cell terminal.Cell) bool {
				return cell.width == 1 && cell.text.trim() == ""
			}

			// The font the cells are set in: the style's, else the theme's code font.
			internal def cellFont() Font {
				let own = style.font
				return own unless own is none
				return look.fonts.code
			}

			def render(ctx RenderContext) {
				look = UI.theme()
				ctx.outerShadows()
				ctx.background()
				ctx.borders()
				let shown = screen
				let inside = ctx.geometry.content.toFloat()
				let font = cellFont()
				let em = self.em * 1(px)
				let probe = new paint.TextBlock("M", font, em)
				let measured = probe.measure(Limit{})
				cellWidth  = float(measured.width).max(1.0)
				cellHeight = float(measured.height).max(1.0)
				let wide = int(((inside.right - inside.left) / cellWidth).floor()).max(1)
				let high = int(((inside.bottom - inside.top) / cellHeight).floor()).max(1)
				if wide != columns || high != rows {
					columns = wide
					rows    = high
					shown.resize(columns, rows) unless shown is none
					settling  = true
					settleAt  = time.now() + terminalResizeSettle
					rowBlocks = []
					rowKeys   = []
				}
				if settling {
					if time.now() >= settleAt {
						settling = false
						if reported.width != columns || reported.height != rows {
							reported = Size<int>{width: columns, height: rows}
							let tell = onResize
							tell(columns, rows) unless tell is none
						}
					} else {
						wakeBy(settleAt, self)
					}
				}
				return when shown is none
				back = back.min(shown.scrollbackLines())
				let palette = look.palette
				let foreground = look.color("terminal.foreground", palette.foreground)
				let background = look.color("terminal.background", palette.surfaceSunken)
				let named Color[] = []
				for let i = 0; i < 16; i++ {
					named.push(look.color("terminal.ansi" + ansiNames[i], new Color(RGBA{r: ansiRgb[i * 3], g: ansiRgb[i * 3 + 1], b: ansiRgb[i * 3 + 2], a: 255})))
				}
				ctx.draw.save()
				ctx.draw.clip(inside)
				for rowBlocks.len() < rows {
					rowBlocks.push(new paint.TextBlock("", font, em))
					rowKeys.push("")
				}
				for let row = 0; row < rows; row++ {
					let cells = shown.line(row, back)
					let top = inside.top + float(row) * cellHeight
					let bottom = top + cellHeight
					drawBackgrounds(ctx, cells, inside.left, top, bottom, foreground, background, named)
					drawText(ctx, row, cells, font, em, inside.left, top, bottom, foreground, background, named)
				}
				drawSelection(ctx, inside, focused ?? (palette.selection, palette.selectionInactive)) when marked && markedBack == back
				drawCursor(ctx, shown, inside, foreground, background) when back == 0 && shown.cursorVisible && shown.cursor.row < rows
				drawComposing(ctx, shown, inside, font, em, foreground, background) when back == 0 && composing != "" && shown.cursor.row < rows
				ctx.draw.restore()
				ctx.childNodes()
				ctx.innerShadows()
			}

			// The colour a cell's foreground or background means.
			internal def colorOf(color terminal.CellColor, fallback Color, named Color[]) Color {
				match color.mode {
					case terminal.ColorMode.Indexed:
						return named[color.index] when color.index < 16
						let (r, g, b) = terminal.indexedRgb(color.index)
						return new Color(RGBA{r: r, g: g, b: b, a: 255})
					case terminal.ColorMode.Rgb:
						return new Color(RGBA{r: color.red, g: color.green, b: color.blue, a: 255})
					default:
						return fallback
				}
			}

			// The foreground and background a cell is drawn with, inverse and
			// faint applied.
			internal def inks(attrs terminal.Attributes, foreground Color, background Color, named Color[]) (Color, Color) {
				let fore = colorOf(attrs.foreground, foreground, named)
				let backing = colorOf(attrs.background, background, named)
				fore = look.palette.foregroundMuted when attrs.faint && attrs.foreground.mode == terminal.ColorMode.Default
				return attrs.inverse ?? ((backing, fore), (fore, backing))
			}

			// Backgrounds are filled a run of same-coloured cells at a time; the
			// default background is the view's own and is not drawn again.
			internal def drawBackgrounds(ctx RenderContext, cells terminal.Cell[], left float, top float, bottom float, foreground Color, background Color, named Color[]) {
				let col = 0
				for col < cells.len() {
					let (_, backing) = inks(cells[col].look, foreground, background, named)
					let plain = cells[col].look.background.mode == terminal.ColorMode.Default && !cells[col].look.inverse
					let end = col + 1
					for end < cells.len() {
						let (_, next) = inks(cells[end].look, foreground, background, named)
						let nextPlain = cells[end].look.background.mode == terminal.ColorMode.Default && !cells[end].look.inverse
						break when nextPlain != plain || (!plain && next != backing)
						end++
					}
					ctx.draw.fill(Rect{left: left + float(col) * cellWidth, top: top, right: left + float(end) * cellWidth, bottom: bottom}, backing) unless plain
					col = end
				}
			}

			// A row's text is one block with a run per change of look, kept while
			// the row reads the same; underlines and strikes are drawn as lines.
			internal def drawText(ctx RenderContext, row int, cells terminal.Cell[], font Font, em Pixels, left float, top float, bottom float, foreground Color, background Color, named Color[]) {
				let text = ""
				let key = ""
				let runs TextRun[] = []
				let at = 0
				let col = 0
				for col < cells.len() {
					let cell = cells[col]
					if cell.width == 0 {
						col++
						continue
					}
					let end = col + 1
					for end < cells.len() && (cells[end].width == 0 || sameLook(cells[end].look, cell.look)) {
						end++
					}
					let piece = ""
					for let c = col; c < end; c++ {
						piece += cells[c].text
						key += cells[c].text
					}
					let (fore, backing) = inks(cell.look, foreground, background, named)
					let shown = cell.look.invisible ?? (backing, fore)
					let run = TextRun{start: at, end: at + piece.len(), foreground: shown}
					run.font = Font{family: font.family, fallback: font.fallback, size: font.size, weight: cell.look.bold ?? (FontWeight.Bold, font.weight), width: font.width, italic: cell.look.italic || font.italic, ligatures: font.ligatures} when cell.look.bold || cell.look.italic
					runs.push(run)
					key += "\u0001{cell.look.bold}{cell.look.italic}{cell.look.invisible}{cell.look.inverse}{cell.look.faint}{cell.look.foreground.mode}{cell.look.foreground.index}{cell.look.foreground.red}{cell.look.foreground.green}{cell.look.foreground.blue}{cell.look.background.mode}{cell.look.background.index}"
					text += piece
					at += piece.len()
					// Lines under and through the run.
					let spanLeft = left + float(col) * cellWidth
					let spanRight = left + float(end) * cellWidth
					if cell.look.underline != terminal.Underline.None {
						let thick = cell.look.underline == terminal.Underline.Double ?? (3.0, 1.0)
						ctx.draw.fill(Rect{left: spanLeft, top: bottom - 2.0 - thick + 1.0, right: spanRight, bottom: bottom - 1.0}, shown)
					}
					if cell.look.strike {
						let middle = (top + bottom) / 2.0
						ctx.draw.fill(Rect{left: spanLeft, top: middle - 0.5, right: spanRight, bottom: middle + 0.5}, shown)
					}
					col = end
				}
				return when text.trim() == ""
				let block = rowBlocks[row]
				if rowKeys[row] != key || block.text != text {
					block = new paint.TextBlock(text, font, em)
					block.runs = runs
					rowBlocks[row] = block
					rowKeys[row] = key
				}
				paint.drawBlock(ctx.draw, block, Rect{left: left, top: top, right: left + float(cells.len()) * cellWidth, bottom: bottom}, Align{}, false, ctx.scale)
			}

			internal def sameLook(a terminal.Attributes, b terminal.Attributes) bool {
				return a.bold == b.bold && a.faint == b.faint && a.italic == b.italic && a.inverse == b.inverse && a.invisible == b.invisible && a.underline == b.underline && a.strike == b.strike && sameColor(a.foreground, b.foreground) && sameColor(a.background, b.background)
			}

			internal def sameColor(a terminal.CellColor, b terminal.CellColor) bool {
				return a.mode == b.mode && a.index == b.index && a.red == b.red && a.green == b.green && a.blue == b.blue
			}

			internal def drawSelection(ctx RenderContext, inside Rect, ink Paint) {
				let (c1, r1, c2, r2) = (anchor.x, anchor.y, reach.x, reach.y)
				(c1, r1, c2, r2) = (reach.x, reach.y, anchor.x, anchor.y) when r2 < r1 || (r2 == r1 && c2 < c1)
				for let row = r1; row <= r2 && row < rows; row++ {
					let first = row == r1 ?? (c1, 0)
					let last = row == r2 ?? (c2, columns)
					continue when last <= first
					let top = inside.top + float(row) * cellHeight
					ctx.draw.fill(Rect{left: inside.left + float(first) * cellWidth, top: top, right: inside.left + float(last) * cellWidth, bottom: top + cellHeight}, ink)
				}
			}

			// What is being composed, from the cursor's cell on over what is there,
			// underlined as a text field shows it.
			internal def drawComposing(ctx RenderContext, shown terminal.Screen, inside Rect, font Font, em Pixels, foreground Color, background Color) {
				let block = new paint.TextBlock(composing, font, em)
				block.foreground = foreground
				let left = inside.left + float(shown.cursor.column) * cellWidth
				let top = inside.top + float(shown.cursor.row) * cellHeight
				let right = left + float(block.measure(Limit{}).width)
				let bottom = top + cellHeight
				ctx.draw.fill(Rect{left: left, top: top, right: right, bottom: bottom}, background)
				paint.drawBlock(ctx.draw, block, Rect{left: left, top: top, right: right, bottom: bottom}, Align{}, false, ctx.scale)
				ctx.draw.fill(Rect{left: left, top: bottom - 2.0, right: right, bottom: bottom - 1.0}, foreground)
			}

			// The cursor: a block that inverts its cell while the view has the focus
			// and an outline when it does not; an underline or a bar when the
			// program asked for one.
			internal def drawCursor(ctx RenderContext, shown terminal.Screen, inside Rect, foreground Color, background Color) {
				let cells = shown.line(shown.cursor.row)
				let column = shown.cursor.column.min(cells.len() - 1)
				let left = inside.left + float(column) * cellWidth
				let top = inside.top + float(shown.cursor.row) * cellHeight
				let cell = cells[column.max(0)]
				let right = left + cellWidth * float(cell.width.max(1))
				let bottom = top + cellHeight
				match shown.cursorShape {
					case terminal.CursorShape.Bar:
						ctx.draw.fill(Rect{left: left, top: top, right: left + 2.0, bottom: bottom}, foreground)
					case terminal.CursorShape.Underline:
						ctx.draw.fill(Rect{left: left, top: bottom - 2.0, right: right, bottom: bottom}, foreground)
					default:
						if !focused {
							ctx.draw.fill(Rect{left: left, top: top, right: right, bottom: top + 1.0}, foreground)
							ctx.draw.fill(Rect{left: left, top: bottom - 1.0, right: right, bottom: bottom}, foreground)
							ctx.draw.fill(Rect{left: left, top: top, right: left + 1.0, bottom: bottom}, foreground)
							ctx.draw.fill(Rect{left: right - 1.0, top: top, right: right, bottom: bottom}, foreground)
							return
						}
						ctx.draw.fill(Rect{left: left, top: top, right: right, bottom: bottom}, foreground)
						return when cell.width == 0 || cell.text.trim() == "" || cell.look.invisible
						let over = new paint.TextBlock(cell.text, cellFont(), self.em * 1(px))
						over.foreground = background
						paint.drawBlock(ctx.draw, over, Rect{left: left, top: top, right: right, bottom: bottom}, Align{}, false, ctx.scale)
				}
			}
		}

		view {}

		style {
			PanelStyle
			Typography
			width      = fill
			height     = fill
			font       = theme.fonts.code
			background = new BackgroundFill(theme.color("terminal.background", theme.palette.surfaceSunken))
		}
	}

	// keyBytes is what a key press sends to the program, as xterm sends it: ""
	// for a key that sends nothing by itself (its text comes as typed text).
	internal def keyBytes(e KeyEvent, shown terminal.Screen) byte[] {
		let shift = e.modifiers.shift
		let alt = e.modifiers.alt
		let control = e.modifiers.control
		let mod = 1 + (shift ?? (1, 0)) + (alt ?? (2, 0)) + (control ?? (4, 0))
		let plain = mod == 1
		let out byte[] = []
		let cursor = def (letter string) byte[] {
			return "\u001b[1;{mod}{letter}".bytes() unless plain
			let lead = shown.applicationCursorKeys ?? ("\u001bO", "\u001b[")
			return (lead + letter).bytes()
		}
		let tilde = def (number int) byte[] {
			return plain ?? ("\u001b[{number}~".bytes(), "\u001b[{number};{mod}~".bytes())
		}
		let function = def (letter string) byte[] {
			return plain ?? ("\u001bO{letter}".bytes(), "\u001b[1;{mod}{letter}".bytes())
		}
		match e.key {
			case Key.Up:
				return cursor("A")
			case Key.Down:
				return cursor("B")
			case Key.Right:
				return cursor("C")
			case Key.Left:
				return cursor("D")
			case Key.Home:
				return cursor("H")
			case Key.End:
				return cursor("F")
			case Key.Insert:
				return tilde(2)
			case Key.Delete:
				return tilde(3)
			case Key.PageUp:
				return tilde(5)
			case Key.PageDown:
				return tilde(6)
			case Key.F1:
				return function("P")
			case Key.F2:
				return function("Q")
			case Key.F3:
				return function("R")
			case Key.F4:
				return function("S")
			case Key.F5:
				return tilde(15)
			case Key.F6:
				return tilde(17)
			case Key.F7:
				return tilde(18)
			case Key.F8:
				return tilde(19)
			case Key.F9:
				return tilde(20)
			case Key.F10:
				return tilde(21)
			case Key.F11:
				return tilde(23)
			case Key.F12:
				return tilde(24)
			case Key.Enter, Key.KeypadEnter:
				let enter = alt ?? ("\u001b\r", "\r")
				return enter.bytes()
			case Key.Tab:
				return shift ?? ("\u001b[Z".bytes(), "\t".bytes())
			case Key.Backspace:
				let code = control ?? (0x08, 0x7f)
				out.push(byte(0x1b)) when alt
				out.push(byte(code))
				return out
			case Key.Escape:
				return "\u001b".bytes()
			case Key.Space:
				if control {
					out.push(byte(0x1b)) when alt
					out.push(byte(0))
					return out
				}
			default:
		}
		// Control chords: letters as 1 to 26, the punctuation xterm maps.
		if control {
			let code = controlCode(e.key)
			if code >= 0 {
				out.push(byte(0x1b)) when alt
				out.push(byte(code))
				return out
			}
		}
		// Alt with a key that types: ESC before the text.
		if alt && !control && e.text != "" {
			out.push(byte(0x1b))
			out.push(...e.text.bytes())
			return out
		}
		return out
	}

	// controlCode is the byte Control makes of a key, -1 for none.
	internal def controlCode(key Key) int {
		let letters = [Key.A, Key.B, Key.C, Key.D, Key.E, Key.F, Key.G, Key.H, Key.I, Key.J, Key.K, Key.L, Key.M, Key.N, Key.O, Key.P, Key.Q, Key.R, Key.S, Key.T, Key.U, Key.V, Key.W, Key.X, Key.Y, Key.Z]
		for let (i, letter) in letters {
			return i + 1 when key == letter
		}
		match key {
			case Key.Digit2:
				return 0
			case Key.Digit3, Key.LeftBracket:
				return 27
			case Key.Digit4, Key.Backslash:
				return 28
			case Key.Digit5, Key.RightBracket:
				return 29
			case Key.Digit6:
				return 30
			case Key.Digit7, Key.Minus, Key.Slash:
				return 31
			case Key.Digit8:
				return 127
			default:
				return -1
		}
	}
}
