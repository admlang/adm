partial module std.ui.components {
	use (
		std.gfx.canvas
		std.math.geom::(Point, Size)
		std.terminal
		std.testing
		std.time
		std.ui::(Key, KeyEvent, Modifiers, PointerPhase)
		std.ui.runtime::Scene
		std.ui.styles::*
		std.units::Pixels
	)

	internal let terminalSent byte[] = []
	internal let terminalSizes string[] = []

	// A terminal term over a small screen, what it sends kept in `terminalSent`.
	component TerminalPage {
		type {
			screen terminal.Screen = new terminal.Screen(8, 2)

			def new() {
				style.width = 200(px)
				style.height = 100(px)
			}

			def took(data byte[]) {
				terminalSent.push(...data)
			}

			def sized(columns int, rows int) {
				terminalSizes.push("{columns}x{rows}")
			}
		}

		view {
			TerminalView(screen, onInput = took, onResize = sized, ref = term)
		}

		style StageStyle
	}

	check "TerminalView" {
		internal def sentText() string {
			let out = string(terminalSent)
			terminalSent = []
			return out
		}

		internal def shownView(page TerminalPage) !TerminalView {
			let shown = page.term
			return shown when shown is TerminalView
			fail "the page has no terminal view"
		}

		// Presses a key with the modifiers held, as the scene takes them: it routes
		// a key to the focused component and holds the modifiers itself.
		internal def press(scene Scene, term TerminalView, key Key, shift bool = false, control bool = false, alt bool = false, text string = "") {
			scene.hold(Modifiers{shift: shift, control: control, alt: alt, mod: control})
			scene.key(KeyEvent{target: term, key: key, text: text})
			scene.hold(Modifiers{})
		}

		// Keys go to the program as xterm sends them, following the cursor key
		// mode the program set; typed text goes as it is.
		@test()
		def sendsKeys() !none {
			terminalSent = []
			let page = TerminalPage()
			let scene = new Scene(page)
			scene.arrange(new Size<Pixels>(200(px), 100(px)))
			let term = try shownView(page)
			term.focus()
			scene.arrange(new Size<Pixels>(200(px), 100(px)))
			press(scene, term, Key.Up)
			press(scene, term, Key.Enter)
			press(scene, term, Key.Tab, shift = true)
			press(scene, term, Key.F5)
			press(scene, term, Key.Backspace)
			press(scene, term, Key.Delete)
			assert sentText() == "\u001b[A\r\u001b[Z\u001b[15~\u007f\u001b[3~"
			press(scene, term, Key.Up, shift = true, control = true)
			press(scene, term, Key.C, control = true)
			press(scene, term, Key.X, alt = true, text = "x")
			press(scene, term, Key.F1, control = true)
			press(scene, term, Key.Space, control = true)
			// Ctrl+Space is a NUL byte, which a string cannot hold: checked as bytes.
			assert terminalSent[terminalSent.len() - 1] == byte(0)
			terminalSent.pop()
			assert sentText() == "\u001b[1;6A\u0003\u001bx\u001b[1;5P"
			page.screen.feed("\u001b[?1h")
			press(scene, term, Key.Left)
			press(scene, term, Key.Home)
			assert sentText() == "\u001bOD\u001bOH"
			// A key that types is taken, its text coming through the text input.
			scene.key(KeyEvent{target: term, key: Key.A, text: "a"})
			assert sentText() == ""
			term.commit("ab")
			assert sentText() == "ab"
			return none
		}

		// What the program asks back goes out through the same callback as the
		// keys, once the term has fed the screen.
		@test()
		def forwardsReplies() !none {
			terminalSent = []
			let page = TerminalPage()
			let scene = new Scene(page)
			scene.arrange(new Size<Pixels>(200(px), 100(px)))
			let term = try shownView(page)
			term.focus()
			scene.arrange(new Size<Pixels>(200(px), 100(px)))
			term.feed("hi\u001b[6n")
			assert page.screen.rowText(0) == "hi" && sentText() == "\u001b[1;3R"
			term.feed("\u001b[c".bytes())
			assert sentText().startsWith("\u001b[?62;")
			return none
		}

		// The wheel scrolls back through the lines that left the top; a key
		// sent returns to the live screen; in the alternate screen the wheel
		// sends arrows instead.
		@test()
		def scrollsBack() !none {
			terminalSent = []
			let page = TerminalPage()
			let scene = new Scene(page)
			let size = new Size<Pixels>(200(px), 100(px))
			scene.arrange(size)
			scene.paint(new canvas.Canvas(200, 100))
			let term = try shownView(page)
			term.focus()
			scene.arrange(new Size<Pixels>(200(px), 100(px)))
			for let i = 0; i < 10; i++ {
				term.feed("line {i}\r\n")
			}
			assert page.screen.scrollbackLines() > 0
			let spot = new Point<Pixels>(20(px), 20(px))
			scene.pointer(PointerPhase.Scroll, spot, scroll = new Point<Pixels>(0(px), -60(px)))
			assert term.back > 0
			let shown = term.back
			scene.pointer(PointerPhase.Scroll, spot, scroll = new Point<Pixels>(0(px), 60(px)))
			assert term.back < shown
			press(scene, term, Key.Enter)
			assert term.back == 0 && sentText() == "\r"
			term.feed("\u001b[?1049h")
			scene.pointer(PointerPhase.Scroll, spot, scroll = new Point<Pixels>(0(px), -60(px)))
			assert term.back == 0 && sentText().startsWith("\u001b[A\u001b[A\u001b[A")
			return none
		}

		// A drag marks cells, whose text the selection reads; a double click
		// takes the word.
		@test()
		def selectsWithThePointer() !none {
			terminalSent = []
			let page = TerminalPage()
			let scene = new Scene(page)
			scene.arrange(new Size<Pixels>(200(px), 100(px)))
			scene.paint(new canvas.Canvas(200, 100))
			let term = try shownView(page)
			term.focus()
			scene.arrange(new Size<Pixels>(200(px), 100(px)))
			term.feed("hello wo")
			let cell = term.cellWidth
			let row = term.cellHeight / 2.0
			scene.pointer(PointerPhase.Down, new Point<Pixels>((cell * 0.5) * 1(px), row * 1(px)))
			scene.pointer(PointerPhase.Move, new Point<Pixels>((cell * 3.5) * 1(px), row * 1(px)))
			scene.pointer(PointerPhase.Up, new Point<Pixels>((cell * 3.5) * 1(px), row * 1(px)))
			assert term.selectedText() == "hel"
			scene.pointer(PointerPhase.Down, new Point<Pixels>((cell * 6.5) * 1(px), row * 1(px)), clicks = 2)
			scene.pointer(PointerPhase.Up, new Point<Pixels>((cell * 6.5) * 1(px), row * 1(px)), clicks = 2)
			assert term.selectedText() == "wo"
			return none
		}

		// The screen takes the size the term has room for, and the program
		// hears it once the size has settled.
		@test()
		def reportsItsSize() !none {
			terminalSizes = []
			let page = TerminalPage()
			let scene = new Scene(page)
			scene.arrange(new Size<Pixels>(200(px), 100(px)))
			scene.paint(new canvas.Canvas(200, 100))
			let term = try shownView(page)
			term.focus()
			scene.arrange(new Size<Pixels>(200(px), 100(px)))
			assert term.columns > 8 && term.rows >= 2
			assert page.screen.columns == term.columns && page.screen.rows == term.rows
			assert terminalSizes.len() == 0
			time.sleep(terminalResizeSettle + 20ms)
			// The wake the view asked for brings a frame in a window; here the frame is asked for.
			term.redraw()
			scene.paint(new canvas.Canvas(200, 100))
			assert terminalSizes.len() == 1 && terminalSizes[0] == "{term.columns}x{term.rows}"
			return none
		}
	}
}
