partial module std.ui.components {
	use (
		std.gfx.color::Color
		std.math.geom::Size
		std.ui::(Limit, RenderContext, Theme, UI)
		std.ui.paint
		std.ui.runtime::Paragraphed
		std.ui.styles::*
		std.units::Pixels
	)

	// The style of a `Text`: its box and how its text is drawn, in the theme's disabled
	// colour while it or a component above it is not enabled.
	style TextStyle {
		Box
		Typography
		on = {
			disabled: {foreground: theme.palette.foregroundDisabled},
		}
	}

	// A run of text in one style: `Text("Hello {name}")`. It is as large as its text, wraps
	// in the width it is given, and sits in a taller or wider box as its `align` says.
	component Text {
		type {
			// What it shows.
			@input(value = true)
			text string = ""

			// Parts of the text styled apart from the rest, by range.
			@input
			runs TextRun[] = []

			// The text as set last.
			block ?paint.TextBlock = none
			// The theme the text colour comes from when the style sets none.
			look  Theme = UI.theme()

			// How its lines are set: as its own style says, else as the nearest component
			// above it whose style says (`paragraph` is inherited); none: the defaults.
			def lines() ?ParagraphLayout {
				let own = style.paragraph
				return own unless own is none
				let above = parent()
				for {
					return none when above is none
					let held = above.style
					if held is Paragraphed {
						let set = held.paragraph
						return set unless set is none
					}
					above = above.parent()
				}
				return none
			}

			// The block for the text and style as they are now.
			def current() paint.TextBlock {
				let set = lines()
				let made = labelBlock(block, text, style.font, style.foreground, set, look.palette.foreground)
				// Runs passed again as another array are set again.
				if made.runs != runs {
					made.runs = runs
					made.changed()
				}
				// A block kept from the frame before follows the settings of this one.
				let wanted = ParagraphLayout{}
				wanted = set unless set is none
				if made.layout != wanted {
					made.layout = wanted
					made.changed()
				}
				block = made
				return made
			}

			def measure(limit Limit) Size<Pixels> {
				return current().measure(limit)
			}

			def firstBaseline() ?Pixels {
				return baselineOf(current())
			}

			def render(ctx RenderContext) {
				ctx.outerShadows()
				ctx.background()
				ctx.borders()
				let area = ctx.geometry.content
				paint.drawBlock(ctx.draw, current(), area.toFloat(), style.align, ctx.direction == Direction.RightToLeft, ctx.scale)
				ctx.childNodes()
				ctx.innerShadows()
			}
		}

		view {}

		style TextStyle
	}

	// The baseline of a text block's first line from its top; none without a line.
	internal def baselineOf(block paint.TextBlock) ?Pixels {
		let lines = block.paragraph(0.0).lines()
		return none when lines.len() == 0
		return lines[0].baseline * 1(px)
	}

	// The colour a component draws its label and icons in: its style's `foreground` when
	// that is a colour, else `otherwise` (the theme's).
	internal def inkOf(foreground ?Paint, otherwise Color) Color {
		let own = foreground
		return own when own is Color
		return otherwise
	}

	// The text block for a label drawn by a component: `held` when it still shows that text
	// at that size, else a new one with the component's typography. Text whose style sets
	// no `foreground` is drawn in `ink`. A kept block follows a colour that changed: the
	// theme's, or the style's under a state (`on = {disabled: {foreground: ...}}`).
	internal def labelBlock(held ?paint.TextBlock, text string, typeface ?Font, foreground ?Paint, lines ?ParagraphLayout, ink Color) paint.TextBlock {
		let font = Font{family: "system-ui"}
		font = typeface unless typeface is none
		let size = paint.sizeIn(font.size, 16.0) * 1(px)
		if !(held is none) && held.text == text && held.size == size {
			let shade = inkOf(foreground, ink)
			// A paint that is no colour cannot be told from the one drawn: kept.
			return held when !(foreground is none) && !(foreground is Color)
			let drawn = held.foreground
			let same = false
			same = drawn == shade when drawn is Color
			if !same {
				held.foreground = shade
				held.changed()
			}
			return held
		}
		let made = new paint.TextBlock(text, font, size)
		made.foreground = ink
		made.foreground = foreground unless foreground is none
		made.layout = lines unless lines is none
		return made
	}
}
