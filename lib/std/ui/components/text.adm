partial module std.ui.components {
	use (
		std.gfx.color::Color
		std.math.geom::Size
		std.net.url
		std.services.runtime::Runtime
		std.ui::(Limit, MouseButton, PointerEvent, PointerPhase, RenderContext, Theme, UI)
		std.ui.navigation::Router
		std.ui.paint
		std.ui.styles::*
		std.units::Pixels
	)

	// The style of a `Text`: its box and how its text is drawn, in the theme's disabled
	// colour while it or a component above it is not enabled. The pointer is a hand over
	// a run that is a link.
	style TextStyle {
		Box
		Typography
		Interaction
		on = {
			disabled: {foreground: theme.palette.foregroundDisabled},
		}
	}

	// A run of text in one style: `Text("Hello {name}")`. It is as large as its text, wraps
	// in the width it is given, and sits in a taller or wider box as its `align` says.
	// A run with a `link` is followed when it is clicked: a location of the application
	// (`/docs#intro`) through the window's `Router`, an address with a scheme
	// (`https://adm-lang.dev/`) by the desktop (`Runtime.open`); the pointer is a hand
	// over it. A run's `tooltip`, else its link, shows when the pointer rests on it.
	component Text {
		type {
			// What it shows.
			@input(value = true)
			text string = ""

			// Parts of the text styled apart from the rest, by range.
			@input
			runs TextRun[] = []

			// The text as set last.
			block ?paint.TextBlock = none
			// The theme the text colour comes from when the style sets none.
			look  Theme = UI.theme()
			// The run with a link or a tooltip under the pointer, and the one a press went
			// down on; -1: none.
			pointed  int = -1
			pressed  int = -1
			// The tooltip the caller gave, while a run's shows in its place.
			given    ?string = none

			// How its lines are set: its style's `paragraph`, its own or the one it inherits;
			// none: the defaults.
			def lines() ?ParagraphLayout {
				return style.paragraph
			}

			// The block for the text and style as they are now.
			def current() paint.TextBlock {
				let set = lines()
				let made = labelBlock(block, text, style.font, em * 1(px), style.foreground, set, look.palette.foreground, decoration = style.decoration)
				// Runs passed again as another array are set again.
				if made.runs != runs {
					made.runs = runs
					made.changed()
				}
				block = made
				return made
			}

			def measure(limit Limit) Size<Pixels> {
				return current().measure(limit)
			}

			def firstBaseline() ?Pixels {
				return current().firstBaseline()
			}

			def render(ctx RenderContext) {
				ctx.outerShadows()
				ctx.background()
				ctx.borders()
				let area = ctx.geometry.content
				paint.drawBlock(ctx.draw, current(), area.toFloat(), style.align, ctx.direction == Direction.RightToLeft, ctx.scale)
				ctx.childNodes()
				ctx.innerShadows()
			}

			// The run with a link or a tooltip drawn at the point; -1 when there is none.
			def runAt(x float, y float) int {
				// The pointer moves over a text far more often than over a link: no lookup of
				// the character for runs that only style the text.
				let pointable = false
				for let run in runs {
					pointable = true unless run.link is none && run.tooltip is none
				}
				return -1 unless pointable
				let geom = style.geom
				let at = paint.characterAt(current(), geom.content.toFloat(), style.align, geom.direction == Direction.RightToLeft, x, y)
				return -1 when at < 0
				for let (i, run) in runs {
					continue when at < run.start || at >= run.end
					return i unless run.link is none && run.tooltip is none
				}
				return -1
			}

			// A press and release on a run with a link follows it; moving over the runs
			// changes the pointer and the tooltip. Anything else is left to the components
			// around it.
			def pointer(e PointerEvent) bool {
				return false when disabled || runs.len() == 0
				match e.phase {
					case PointerPhase.Enter, PointerPhase.Move:
						point(runAt(float(e.position.x), float(e.position.y)))
						return false
					case PointerPhase.Leave:
						point(-1)
						return false
					case PointerPhase.Down:
						return false when e.button != MouseButton.Left
						let at = runAt(float(e.position.x), float(e.position.y))
						return false when at < 0 || runs[at].link is none
						e.capture()
						pressed = at
						return true
					case PointerPhase.Up:
						let was = pressed
						pressed = -1
						return false when was < 0
						follow(runs[was]) when was < runs.len() && runAt(float(e.position.x), float(e.position.y)) == was
						return true
					case PointerPhase.Cancel:
						pressed = -1
						return false
					default:
						return false
				}
			}

			// Notes the run under the pointer: a hand over a link, and the run's tooltip
			// (else its link) in place of the caller's.
			def point(at int) {
				return when at == pointed
				pointed = at
				let run ?TextRun = none
				run = runs[at] when at >= 0 && at < runs.len()
				let caller = given
				if run is none {
					style.cursor = none
					tooltip = caller unless caller is none
					given   = none
					return
				}
				given = tooltip when caller is none
				style.cursor = run.link is none ?? (none, Cursor.Pointer)
				let tip = run.tooltip
				let to = run.link
				tooltip = tip is none ?? ((to is none ?? ("", to)), tip)
			}

			// Goes where the run's link says: an address with a scheme through the desktop
			// (`Runtime.open`, which needs the `open` permission), a location of the
			// application through the window's `Router`. One that cannot be followed does
			// nothing.
			def follow(run TextRun) {
				let to = run.link
				return when to is none || to == ""
				let address = url.parse(to) onerror recover new url.URL()
				if address.isAbs() {
					Runtime.open(to) onerror recover none
					return
				}
				let router = context<Router>()
				router.go(to) unless router is none
			}
		}

		view {}

		style TextStyle
	}

	// The colour a component draws its label and icons in: its style's `foreground` when
	// that is a colour, else `otherwise` (the theme's).
	internal def inkOf(foreground ?Paint, otherwise Color) Color {
		let own = foreground
		return own when own is Color
		return otherwise
	}

	// The font of a label whose style has none, its own or inherited.
	internal let plainFont = Font{family: "system-ui"}

	// The text block for a label drawn by a component: `held` when it still shows that text
	// at that size in that font (`sameFont`: a style that merges a font, `font = {weight:
	// ...}`, makes another object of the same values at each layout), else a new one
	// with the component's typography. `size` is the size the
	// text is set at: the component's `em * 1(px)` for its style's font, whose own size
	// the layout has resolved into it. Text whose style sets no `foreground` is drawn in
	// `ink`. A kept block follows a colour that changed: the
	// theme's, or the style's under a state (`on = {disabled: {foreground: ...}}`).
	internal def labelBlock(held ?paint.TextBlock, text string, typeface ?Font, size Pixels, foreground ?Paint, lines ?ParagraphLayout, ink Color, decoration ?Decoration = none) paint.TextBlock {
		let font = plainFont
		font = typeface unless typeface is none
		if !(held is none) && held.text == text && held.size == size && sameFont(held.font, font) {
			let shade = inkOf(foreground, ink)
			// A paint that is no colour cannot be told from the one drawn: kept.
			if !(foreground is none) && !(foreground is Color) {
				held.follow(lines)
				decorate(held, decoration)
				return held
			}
			let drawn = held.foreground
			let same = false
			same = drawn == shade when drawn is Color
			if !same {
				held.foreground = shade
				held.changed()
			}
			held.follow(lines)
			decorate(held, decoration)
			return held
		}
		let made = new paint.TextBlock(text, font, size)
		made.foreground = ink
		made.foreground = foreground unless foreground is none
		made.follow(lines)
		decorate(made, decoration)
		return made
	}

	// Whether two fonts have the same values: a struct compares by identity.
	internal def sameFont(a Font, b Font) bool {
		return true when a == b
		if a.family != b.family || a.size != b.size || a.weight != b.weight || a.width != b.width || a.italic != b.italic || a.ligatures != b.ligatures {
			return false
		}
		return false unless a.fallback.equals(b.fallback) && a.features.len() == b.features.len() && a.axes.len() == b.axes.len()
		for let (tag, value) in a.features {
			return false unless b.features.hasKey(tag) && b.features[tag] == value
		}
		for let (tag, value) in a.axes {
			return false unless b.axes.hasKey(tag) && b.axes[tag] == value
		}
		return true
	}

	// Gives the block the lines its style draws with the text; a style keeps one
	// object while its decoration stands, so the block is set again only for another.
	internal def decorate(block paint.TextBlock, decoration ?Decoration) {
		return when decoration is none || block.decoration == decoration
		block.decoration = decoration
		block.changed()
	}
}
