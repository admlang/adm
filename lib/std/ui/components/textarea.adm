partial module std.ui.components {
	use (
		std.gfx.color::Color
		std.math.geom::(Edges, Point, Rect, Size)
		std.time
		std.ui::(Key, KeyEvent, Limit, MouseButton, PointerEvent, PointerPhase, RenderContext, TextKind, TextRange, Theme, UI)
		std.ui.paint
		std.ui.runtime::afterArrange
		std.ui.styles::*
		std.units::(Extent, Pixels)
	)

	// A distance from the left edge that is past the end of any line.
	internal const pastLine = 1000000000.0

	// Several lines of editable text: `TextArea(notes, rows = 4)`. It edits as a
	// `TextField` does, and: Enter starts a line, the text wraps in its width, Up and Down
	// move between lines keeping the caret's distance from the edge, Home and End go to
	// the ends of the line (with Control or Command, of the text), Page Up and Page Down
	// move by what it shows. Text taller than it scrolls with the wheel and to keep the
	// caret in sight.
	component TextArea {
		type {
			// The text. Typing writes it back to what the caller passed when that is
			// bindable; otherwise it edits its own copy.
			@input(value = true, bind = true)
			value string = ""

			// Shown while the text is empty.
			@input
			placeholder string = ""

			// How many lines high it is when its style sets no height.
			@input
			rows int = 4

			// Runs with the new text when the user changes it.
			@input
			onChange ?(def(string)) = none

			// Tells every listener its new text, after the handler ran: heard with
			// `@on(TextArea.changed)`.
			@emit()
			def changed(text string) string {
				return text
			}

			// The text being edited with its caret and selection, and the `value` it was
			// last in step with.
			edit      paint.TextEdit
			seen      string
			// The text as set last, the placeholder, and a block that gives the height of
			// a line.
			block     ?paint.TextBlock = none
			hint      ?paint.TextBlock = none
			ruler     ?paint.TextBlock = none
			look      Theme = UI.theme()
			// Where a caret can stand, and the block and the width that was found for.
			map       ?paint.CaretMap = none
			mapBlock  ?paint.TextBlock = none
			mapText   string
			mapWidth  float = -1.0
			// How far the text is moved up so the caret stays in sight.
			shift     float
			// The distance from the left edge that Up and Down keep; below 0: the caret's.
			goal      float = -1.0
			// Whether its menu was asked for (it is built then), and where it opens once it
			// is there.
			menuAsked bool
			menuAt    ?Point<Pixels> = none
			// A drag is selecting.
			selecting bool
			// The bar's thumb is being dragged, how far under its top the pointer took it,
			// and whether the pointer is over the bar.
			sliding   bool
			grip      float
			overBar   bool
			// When the caret was last moved: it shows steadily from then, and blinks after.
			moved     time.Time
			blink     duration

			def new() {
				focusable = true
				tabStop   = true
				edit      = new paint.TextEdit(value)
				seen      = value
				moved     = time.now()
				blink     = UI.appearance().caretBlink
			}

			// Takes a `value` the caller changed into the edit.
			def take() {
				return when value == seen
				edit.set(value)
				seen  = value
				shift = 0.0
				goal  = -1.0
			}

			// After an edit or a caret move: the value follows the edit, the caret shows.
			// A move up or down keeps its `goal`; anything else forgets it.
			def report(vertical bool = false) {
				let before = value
				value = edit.text
				seen  = value
				moved = time.now()
				goal  = -1.0 unless vertical
				reveal()
				return when value == before
				let tell = onChange
				tell(value) unless tell is none
				changed(value)
			}

			// A block for `text` in the area's typography, wrapped at words.
			def wrapped(held ?paint.TextBlock, text string, ink Color) paint.TextBlock {
				let made = labelBlock(held, text, style.font, style.foreground, style.paragraph, ink)
				made.layout.wrap = Wrap.Words when style.paragraph is none
				return made
			}

			// The block for the text as it is now.
			def current() paint.TextBlock {
				take()
				let palette = look.palette
				let made = wrapped(block, edit.shown(), !disabled ?? (palette.foreground, palette.foregroundDisabled))
				block = made
				return made
			}

			// The height of one line of the area's text.
			def lineHigh() float {
				let made = wrapped(ruler, "Ag", look.palette.foreground)
				ruler = made
				return float(made.measure(Limit{}).height)
			}

			// The width the text is set in.
			def room() float {
				return float(style.geom.content.width)
			}

			// Where a caret can stand in the text as it is set now.
			def carets() paint.CaretMap {
				let made = current()
				let wide = room()
				let held = map
				let from = mapBlock
				if !(held is none) && !(from is none) {
					return held when from == made && mapText == made.text && mapWidth == wide
				}
				let fresh = new paint.CaretMap(made, wide)
				map      = fresh
				mapBlock = made
				mapText  = made.text
				mapWidth = wide
				return fresh
			}

			// `rows` lines high; its width is the style's.
			def measure(limit Limit) Size<Pixels> {
				return new Size<Pixels>(0(px), (lineHigh() * float(rows.max(1))).ceil() * 1(px))
			}

			def firstBaseline() ?Pixels {
				let _ = lineHigh()
				let held = ruler
				return none when held is none
				return baselineOf(held)
			}

			// The height of the whole text.
			def tall() float {
				let places = carets()
				let (_, bottom) = places.rows(places.count() - 1, lineHigh())
				return bottom
			}

			// The furthest the text moves up.
			def reach() float {
				return (tall() - float(style.geom.content.height)).max(0.0)
			}

			// Moves the text so the caret's line is inside the content box.
			def reveal() {
				let high = float(style.geom.content.height)
				return when high <= 0.0
				let places = carets()
				let (_, line) = places.place(edit.drawn(edit.caret))
				let (top, bottom) = places.rows(line, lineHigh())
				shift = bottom - high when bottom - shift > high
				shift = top when top - shift < 0.0
				shift = shift.min(reach()).max(0.0)
			}

			// The caret position nearest a point of the component.
			def indexAt(x float, y float) int {
				let area = style.geom.content
				let places = carets()
				return edit.written(places.at(places.lineAt(y - float(area.top) + shift), x - float(area.left)))
			}

			// The caret position `by` lines under the caret (above, when negative), at the
			// distance from the edge the first such move started from.
			def lineStep(by int) int {
				let places = carets()
				let (x, line) = places.place(edit.drawn(edit.caret))
				goal = x when goal < 0.0
				let to = line + by
				return 0 when to < 0
				return edit.text.len() when to >= places.count()
				return edit.written(places.at(to, goal))
			}

			// The start or the end of the caret's line.
			def lineEdge(end bool) int {
				let places = carets()
				let (_, line) = places.place(edit.drawn(edit.caret))
				return edit.written(places.at(line, end ?? (pastLine, -1.0)))
			}

			// How many whole lines it shows.
			def page() int {
				return int(float(style.geom.content.height) / lineHigh()).max(1)
			}

			// What the lines of its menu do.
			def cutText() {
				take()
				report() when editCut(edit, false)
			}

			def copyText() {
				let _ = editCopy(edit, false)
			}

			def pasteText() {
				take()
				report() when editPaste(edit, false)
			}

			def selectText() {
				edit.selectAll()
				report()
			}

			// Whether there is something to cut or copy.
			def marked() bool {
				return edit.hasSelection()
			}

			// Opens the menu once the views ran again and built it.
			def openMenu() {
				let at = menuAt
				let built = menu
				return when at is none || built is none
				built.context(at)
				menuAt = none
			}

			// The bar of a text taller than the area, in the component's coordinates: where
			// its track starts and how long it is, where the thumb starts and how long it
			// is. A track of length 0: the text fits and there is no bar.
			def bar() (float, float, float, float) {
				let area = style.geom.content
				let seen = float(area.height)
				let whole = tall()
				return (0.0, 0.0, 0.0, 0.0) when whole <= seen || seen <= 0.0
				let length = (seen * seen / whole).max(12.0)
				let along = (seen - length) * shift / (whole - seen)
				return (float(area.top), seen, float(area.top) + along, length)
			}

			// Whether a point of the component is on the bar: the ten pixels at the end edge.
			def onBar(x float) bool {
				let (_, track, _, _) = bar()
				return false when track <= 0.0
				let wide = float(style.geom.frame.width)
				return style.geom.direction == Direction.RightToLeft ?? (x < 10.0, x >= wide - 10.0)
			}

			// Scrolls so the thumb's top is at `top`, as far as the text goes.
			def slideTo(top float) {
				let (start, track, _, length) = bar()
				return when track <= length
				let to = ((top - start) / (track - length) * reach()).min(reach()).max(0.0)
				return when to == shift
				shift = to
				redraw()
			}

			// A press puts the caret and starts a selection that a drag extends; the wheel
			// scrolls; the bar at the end edge is dragged, and a press beside its thumb moves
			// a page; the secondary button asks for the menu.
			def pointer(e PointerEvent) bool {
				return false when disabled
				match e.phase {
					case PointerPhase.Scroll:
						let to = (shift + float(e.scroll.y)).min(reach()).max(0.0)
						return false when to == shift
						shift = to
						redraw()
						return true
					case PointerPhase.Down:
						return false when e.button != MouseButton.Left
						e.capture()
						if onBar(float(e.position.x)) {
							// On the thumb: it follows the pointer. Beside it: a page that way.
							let (_, _, thumb, length) = bar()
							let y = float(e.position.y)
							if y >= thumb && y < thumb + length {
								sliding = true
								grip    = y - thumb
							} else {
								let page = float(style.geom.content.height)
								shift = (shift + (y < thumb ?? (-page, page))).min(reach()).max(0.0)
							}
							redraw()
							return true
						}
						// A second press selects the word under it, a third its line.
						if e.clicks == 2 {
							edit.selectWord(indexAt(float(e.position.x), float(e.position.y)))
							report()
							return true
						}
						if e.clicks >= 3 {
							edit.move(indexAt(float(e.position.x), float(e.position.y)))
							let (from, to) = (lineEdge(false), lineEdge(true))
							edit.move(from)
							edit.move(to, true)
							report()
							return true
						}
						selecting = true
						edit.move(indexAt(float(e.position.x), float(e.position.y)), e.modifiers.shift)
						report()
						return true
					case PointerPhase.Move, PointerPhase.Enter:
						if sliding {
							slideTo(float(e.position.y) - grip)
							return true
						}
						if !selecting {
							// Over the bar the pointer is an arrow, over the text an I-beam.
							let over = onBar(float(e.position.x))
							if over != overBar {
								overBar = over
								style.cursor = over ?? (Cursor.Default, Cursor.Text)
								redraw()
							}
							return false
						}
						edit.move(indexAt(float(e.position.x), float(e.position.y)), true)
						report()
						return true
					case PointerPhase.Leave:
						if overBar {
							overBar = false
							style.cursor = Cursor.Text
							redraw()
						}
						return false
					case PointerPhase.Up, PointerPhase.Cancel:
						if e.phase == PointerPhase.Up && e.button == MouseButton.Right && !menuAsked {
							menuAsked = true
							menuAt    = e.windowPosition
							redraw()
							afterArrange(openMenu)
							return true
						}
						let was = selecting || sliding
						selecting = false
						sliding   = false
						return was
					default:
						return false
				}
			}

			// The editing keys. Keys that type a
			// character are taken, so they do not reach a shortcut further up; the
			// character itself arrives through `commit`.
			def key(e KeyEvent) bool {
				return false when !e.down
				return false when disabled
				take()
				let extend = e.modifiers.shift
				let word = e.modifiers.mod
				let vertical = false
				switch e.key {
					case Key.Left:
						let (from, _) = edit.range()
						edit.move(edit.hasSelection() && !extend ?? (from, edit.step(false, word)), extend)
					case Key.Right:
						let (_, to) = edit.range()
						edit.move(edit.hasSelection() && !extend ?? (to, edit.step(true, word)), extend)
					case Key.Up:
						edit.move(lineStep(-1), extend)
						vertical = true
					case Key.Down:
						edit.move(lineStep(1), extend)
						vertical = true
					case Key.PageUp:
						edit.move(lineStep(-page()), extend)
						vertical = true
					case Key.PageDown:
						edit.move(lineStep(page()), extend)
						vertical = true
					case Key.Home:
						edit.move(word ?? (0, lineEdge(false)), extend)
					case Key.End:
						edit.move(word ?? (edit.text.len(), lineEdge(true)), extend)
					case Key.Backspace:
						let _ = edit.erase(false, word)
					case Key.Delete:
						let _ = edit.erase(true, word)
					case Key.Enter, Key.KeypadEnter:
						edit.insert("\n")
					default:
						let taken = editShortcut(edit, e, secret = false, oneLine = false)
						report() when taken == KeyTaken.Changed
						return taken != KeyTaken.No
				}
				report(vertical)
				return true
			}

			// Text from the platform's input: in place of the selection, or at the caret.
			def commit(text string) {
				return when disabled
				take()
				edit.insert(text)
				report()
			}

			// What an input method is edit.composing: shown underlined at the caret until it
			// is committed or taken back (an empty `text`). It takes the place of the
			// selection. `caret` is where the method's caret is in it, in characters;
			// negative: at its end.
			def compose(text string, caret int) {
				return when disabled
				take()
				report() when edit.compose(text, caret)
				moved = time.now()
				reveal()
				redraw()
			}

			def surrounding() string {
				return edit.text
			}

			def selection() TextRange {
				let (from, to) = edit.range()
				return TextRange{start: from, end: to}
			}

			def deleteSurrounding(before int, after int) {
				take()
				let at = edit.caret
				edit.move(at - before)
				edit.move(at + after, true)
				let _ = edit.erase(false)
				report()
			}

			// The caret in the window.
			def caretRect() Rect<Pixels> {
				let frame = style.geom.frame
				let area = style.geom.content
				let places = carets()
				let (x, line) = places.place(edit.drawn(edit.caret))
				let (top, bottom) = places.rows(line, lineHigh())
				let left = float(frame.left) + float(area.left) + x
				let above = float(frame.top) + float(area.top) - shift
				return Rect<Pixels>{left: left * 1(px), top: (above + top) * 1(px), right: (left + 1.0) * 1(px), bottom: (above + bottom) * 1(px)}
			}

			// For the platform's keyboard: text of several lines.
			def inputKind() TextKind {
				return TextKind.Multiline
			}

			// How long the caret is shown, then hidden: the style's, else the desktop's; 0s
			// does not blink.
			def caretPeriod() duration {
				let own = style.caret.blink
				return own unless own is none
				return blink
			}

			def render(ctx RenderContext) {
				let palette = look.palette
				let box = frameBox(ctx)
				ctx.outerShadows()
				ctx.background()
				ctx.borders()

				let inside = ctx.geometry.content.toFloat()
				let made = current()
				let places = carets()
				let high = lineHigh()
				let (_, whole) = places.rows(places.count() - 1, high)
				let seenHigh = inside.bottom - inside.top
				shift = shift.min((whole - seenHigh).max(0.0)).max(0.0)
				let top = inside.top - shift
				ctx.draw.save()
				ctx.draw.clip(inside)
				if edit.hasSelection() {
					// One box a line: from the selection's start or the line's left edge to
					// its end or the line's last position.
					let (from, to) = edit.range()
					let (startX, first) = places.place(from)
					let (endX, last) = places.place(to)
					let marked = focused ?? (style.selection.background, style.selection.inactive)
					for let line = first; line <= last; line++ {
						let (above, below) = places.rows(line, high)
						continue when top + below < inside.top || top + above > inside.bottom
						let left = line == first ?? (startX, 0.0)
						let (right, _) = line == last ?? ((endX, 0), places.place(places.at(line, pastLine)))
						// A line that goes on shows its line break as selected.
						right += high / 4.0 when line != last
						ctx.draw.fill(Rect{left: inside.left + left, top: top + above, right: inside.left + right, bottom: top + below}, marked)
					}
				}
				if edit.composing != "" {
					// A line under what is being composed, on each line it is on.
					let (startX, first) = places.place(edit.caret)
					let (endX, last) = places.place(edit.caret + edit.composing.len())
					for let line = first; line <= last; line++ {
						let (_, below) = places.rows(line, high)
						let left = line == first ?? (startX, 0.0)
						let (right, _) = line == last ?? ((endX, 0), places.place(places.at(line, pastLine)))
						ctx.draw.fill(Rect{left: inside.left + left, top: top + below - 1.0, right: inside.left + right, bottom: top + below}, palette.foreground)
					}
				}
				if edit.text.len() == 0 && edit.composing == "" && placeholder.len() > 0 {
					let dim = wrapped(hint, placeholder, palette.foregroundMuted)
					hint = dim
					paint.drawBlock(ctx.draw, dim, inside, Align{}, false, ctx.scale)
				} else {
					paint.drawBlock(ctx.draw, made, Rect{left: inside.left, top: top, right: inside.right, bottom: top + whole.max(high)}, Align{}, false, ctx.scale)
				}
				let period = caretPeriod()
				caretWakes(period, moved, ctx.draw.frameTime) when focused && !disabled
				if focused && !disabled && caretShows(period, moved, ctx.draw.frameTime) {
					let (x, line) = places.place(edit.drawn(edit.caret))
					let (above, below) = places.rows(line, high)
					let ink = style.caret.paint
					let bar = Rect{left: inside.left + x, top: top + above, right: inside.left + x + float(style.caret.width), bottom: top + below}
					if ink is none {
						ctx.draw.fill(bar, palette.foreground)
					} else {
						ctx.draw.fill(bar, ink)
					}
				}
				ctx.draw.restore()

				// The bar at the end edge: its thumb says how much of a taller text is shown and
				// where, wider while the pointer is on it or drags it.
				let (_, track, thumb, length) = bar()
				if track > 0.0 {
					let thick = overBar || sliding ?? (6.0, 3.0)
					let right = ctx.direction == Direction.RightToLeft ?? (box.left + 2.0 + thick, box.right - 2.0)
					ctx.draw.fill(Rect{left: right - thick, top: thumb, right: right, bottom: thumb + length}, thick / 2.0, palette.foreground.withOpacity(sliding ?? (0.6, overBar ?? (0.5, 0.35))))
				}
				ctx.childNodes()
				ctx.innerShadows()
			}
		}

		view {
			// Built the first time it is asked for.
			if menuAsked {
				FieldMenu(ref = menu, marked = marked(), onCut = cutText, onCopy = copyText, onPaste = pasteText, onSelectAll = selectText)
			}
		}

		style {
			TextFieldStyle
			width = 280(px)
			// The edge is part of the box: the padding is what is left of the room around the text.
			padding = new Edges<Extent>(theme.metrics.unit * 1.5 - theme.metrics.borderWidth, theme.metrics.unit * 2.0 - theme.metrics.borderWidth)
		}
	}
}
