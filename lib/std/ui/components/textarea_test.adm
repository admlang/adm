partial module std.ui.components {
	use (
		std.gfx.canvas
		std.math.geom::Size
		std.testing
		std.ui.runtime::Scene
		std.ui.styles::*
		std.units::Pixels
	)

	check "TextArea" {
		// With `lineNumbers` a gutter as wide as the largest number takes the start of
		// the content box: the text starts after it, a point in it is the line's start,
		// and the numbers are drawn; without, the text has the whole box.
		@test()
		def TestLineNumbersTakeAGutter() {
			let numbered = TextArea(value = "ab\ncd\n\ne", lineNumbers = true)
			let plain = TextArea(value = "ab\ncd\n\ne")
			let size = new Size<Pixels>(300(px), 300(px))
			let scene = new Scene(numbered)
			scene.arrange(size)
			scene.arrange(size)
			let other = new Scene(plain)
			other.arrange(size)
			other.arrange(size)
			assert numbered.lineStarts().join(",") == "0,3,6,7"
			let gutter = numbered.gutter()
			assert gutter > 0.0 && plain.gutter() == 0.0
			assert numbered.room() == plain.room() - gutter
			let area = numbered.style.geom.content
			let y = float(area.top) + 1.0
			// Through the gutter and the first pixel of the text alike, the caret stands
			// before the first character; a point in the plain area's first pixel too.
			assert numbered.indexAt(float(area.left) + 1.0, y) == 0
			assert numbered.indexAt(float(area.left) + gutter + 1.0, y) == 0
			assert plain.indexAt(float(plain.style.geom.content.left) + 1.0, y) == 0
			// The gutter has ink where the plain area's start is bare.
			let surface = new canvas.Canvas(300, 300)
			scene.paint(surface)
			// An blank text still has its first line's number, and nothing after the gutter.
			let blank = TextArea(lineNumbers = true)
			let third = new Scene(blank)
			third.arrange(size)
			third.arrange(size)
			let bare = new canvas.Canvas(300, 300)
			third.paint(bare)
			let inkIn = def (painted canvas.Canvas, field TextArea, left float, right float) bool {
				let box = field.style.geom.frame
				let content = field.style.geom.content
				let top = int(float(box.top) + float(content.top))
				let bottom = int(float(box.top) + float(content.top) + float(content.height))
				// The background: the last pixel of the content box's middle row, past the text.
				let background = painted.pixels[(int(float(box.top) + float(content.top) + float(content.height) / 2.0) * 300 + int(float(box.left) + float(content.left) + float(content.width)) - 2) * 4]
				for let row = top; row < bottom; row++ {
					for let x = int(float(box.left) + left); x < int(float(box.left) + right); x++ {
						return true when painted.pixels[(row * 300 + x) * 4] != background
					}
				}
				return false
			}
			let start = float(numbered.style.geom.content.left)
			assert inkIn(surface, numbered, start, start + gutter)
			let emptyStart = float(blank.style.geom.content.left)
			let emptyGutter = blank.gutter()
			assert inkIn(bare, blank, emptyStart, emptyStart + emptyGutter)
			assert !inkIn(bare, blank, emptyStart + emptyGutter, emptyStart + float(blank.style.geom.content.width) - 4.0)
			scene.close()
			other.close()
			third.close()
		}
	}
}
