partial module std.ui.components {
	use (
		std.gfx.color::Color
		std.math.geom::(Corners, Edges, Point, Rect, Size)
		std.time
		std.ui::(DragData, DropEffect, Key, KeyEvent, Limit, MouseButton, PointerEvent, PointerPhase, RenderContext, TextKind, TextRange, Theme, UI)
		std.ui.paint
		std.ui.runtime::(afterArrange, drawIcon, wakeBy)
		std.ui.styles::*
		std.units::(Extent, Pixels)
	)

	// How long an arrow of a field is held before it steps again, and how often it steps
	// from then on.
	internal const stepDelay = 400ms
	internal const stepEvery = 60ms

	// The style of a `TextField` and of a `TextArea`: a sunken surface with a strong
	// edge, which takes the foreground under the pointer and the focus colour while the
	// field has the keyboard focus.
	style TextFieldStyle {
		Box
		Control
		Editable
		cursor = Cursor.Text
		radius = new Corners<Extent>(theme.metrics.radius)
		background = new BackgroundFill(theme.palette.surfaceSunken)
		border = controlEdge(theme.palette.borderStrong)
		selection = Selection{background: theme.palette.selection, inactive: theme.palette.selectionInactive}
		on = {
			hover:   {border: controlEdge(theme.palette.foreground)},
			focused: {border: controlEdge(theme.palette.focus)},
		}
	}

	// One line of editable text: `TextField(email, placeholder = "Email", kind = TextKind.Email)`.
	// It takes the keyboard focus on a press or with Tab; a press puts the caret, a drag
	// selects, the arrows, Home and End move (with Shift they select, with Control or
	// Command the arrows go by words), Backspace and Delete erase, and Control or Command
	// with A, C, X and V select all, copy, cut and paste. Text longer than the field
	// scrolls to keep the caret in sight.
	component TextField {
		type {
			// The text. Typing writes it back to what the caller passed when that is
			// bindable; otherwise the field edits its own copy.
			@input(value = true, bind = true)
			value string = ""

			// Shown while the text is empty.
			@input
			placeholder string = ""

			// What the on-screen keyboard and autofill offer. `Password` shows a dot for
			// each character and does not copy or cut.
			@input
			kind TextKind = TextKind.Text

			// Runs when Enter is pressed.
			@input
			onSubmit ?(def()) = none

			// Tells every listener Enter was pressed in it, after the handler ran: heard with
			// `@on(TextField.submitted)`.
			@emit()
			def submitted() bool {
				return true
			}

			// Runs with the new text when the user changes it.
			@input
			onChange ?(def(string)) = none

			// Tells every listener its new text, after the handler ran: heard with
			// `@on(TextField.changed)`.
			@emit()
			def changed(text string) string {
				return text
			}

			// The name of an icon shown inside the field, before the text; empty: none.
			@input
			leading string = ""

			// The name of an icon shown inside the field, after the text; empty: none.
			@input
			trailing string = ""

			// Runs when the trailing icon is pressed; none: the icon is only shown.
			@input
			onTrailing ?(def()) = none

			// Tells every listener the icon at its end was pressed, after the handler ran: heard with
			// `@on(TextField.trailingClicked)`.
			@emit()
			def trailingClicked() bool {
				return true
			}

			// Given, the field shows an up and a down arrow at its end, and a press on one
			// runs this with 1 or -1.
			@input
			onStep ?(def(int)) = none

			// Tells every listener an arrow at its end was pressed: 1 up, -1 down, after the handler ran: heard with
			// `@on(TextField.stepped)`.
			@emit()
			def stepped(by int) int {
				return by
			}

			// The icons as looked up last, the part at the field's end the pointer is over
			// and the one it went down on: 0 none, 1 the trailing icon, 2 the up arrow, 3
			// the down arrow.
			before    IconSlot = new IconSlot()
			after     IconSlot = new IconSlot()
			up        IconSlot = new IconSlot()
			down      IconSlot = new IconSlot()
			// Whether its menu was asked for (it is built then), and where it opens once it
			// is there.
			menuAsked bool
			menuAt    ?Point<Pixels> = none
			pointed   int
			held      int
			// When a held arrow steps next.
			again     time.Time

			// The text being edited with its caret and selection, and the `value` it was
			// last in step with.
			edit      paint.TextEdit
			seen      string
			// The text as set last, the placeholder, and a block that gives the height of
			// a line.
			block     ?paint.TextBlock = none
			hint      ?paint.TextBlock = none
			ruler     ?paint.TextBlock = none
			// Where a caret can stand on the line, and the block and text that was found for.
			map       ?paint.CaretMap = none
			mapBlock  ?paint.TextBlock = none
			mapText   string
			look      Theme = UI.theme()
			// How far the text is moved left so the caret stays in sight.
			shift     float
			// A drag is selecting.
			selecting bool
			// A press landed on the selection: a move away drags the selected text, a
			// release puts the caret there. Then: the text is dragged; it was dropped
			// on this field itself, which moved it.
			lifting   bool
			lifted    bool
			settled   bool
			// When the caret was last moved: it shows steadily from then, and blinks after.
			moved     time.Time
			blink     duration

			def new() {
				focusable = true
				tabStop   = true
				edit      = new paint.TextEdit(value)
				seen      = value
				moved     = time.now()
				blink     = UI.appearance().caretBlink
			}

			// Takes a `value` the caller changed into the edit.
			def take() {
				return when value == seen
				edit.set(value)
				seen  = value
				shift = 0.0
			}

			// After an edit or a caret move: the value follows the edit, the caret shows.
			def report() {
				let before = value
				value = edit.text
				seen  = value
				moved = time.now()
				reveal()
				// A caret that only moved changed no text.
				return when value == before
				let tell = onChange
				tell(value) unless tell is none
				changed(value)
			}

			// What is drawn for the text: the text with what an input method is edit.composing
			// at the caret, or a dot per character of a password.
			def shown() string {
				let text = edit.shown()
				return text when kind != TextKind.Password
				return "•".repeat(text.len())
			}

			// A block for `text` in the field's typography, on one line.
			def lineBlock(held ?paint.TextBlock, text string, ink Color) paint.TextBlock {
				let made = labelBlock(held, text, style.font, style.foreground, style.paragraph, ink)
				made.layout.wrap = Wrap.None when style.paragraph is none
				return made
			}

			// The block for the text as it is now.
			def current() paint.TextBlock {
				take()
				let palette = look.palette
				let made = lineBlock(block, shown(), !disabled ?? (palette.foreground, palette.foregroundDisabled))
				block = made
				return made
			}

			// A block whose line is as high as the field's text.
			def line() paint.TextBlock {
				let made = lineBlock(ruler, "Ag", look.palette.foreground)
				ruler = made
				return made
			}

			// A line high; its width is the style's.
			def measure(limit Limit) Size<Pixels> {
				return new Size<Pixels>(0(px), line().measure(Limit{}).height)
			}

			def firstBaseline() ?Pixels {
				let lines = line().paragraph(0.0).lines()
				return none when lines.len() == 0
				let high = float(line().measure(Limit{}).height)
				let room = float(style.geom.content.height)
				return (lines[0].baseline + ((room - high) / 2.0).max(0.0)) * 1(px)
			}

			// The room an icon takes inside the field: its square and the space beside it.
			def iconRoom() float {
				return float(look.metrics.iconSize) + float(look.metrics.unit) * 1.5
			}

			// Where the text goes in the component: the content box less the icons' room.
			def textSpan() (float, float) {
				let area = style.geom.content
				let left = float(area.left) + (leading != "" ?? (iconRoom(), 0.0))
				let right = float(area.right) - (trailing != "" ?? (iconRoom(), 0.0)) - (onStep is none ?? (0.0, iconRoom()))
				return (left, right.max(left))
			}

			// The square of the trailing icon and of the arrows, each `iconSize` wide and
			// as high as the content box, the arrows outermost.
			def endBoxes() (Rect, Rect) {
				let area = style.geom.content.toFloat()
				let side = float(look.metrics.iconSize)
				let steps = onStep is none ?? (0.0, iconRoom())
				let arrows = Rect{left: area.right - side, top: area.top, right: area.right, bottom: area.bottom}
				let icon = Rect{left: area.right - steps - side, top: area.top, right: area.right - steps, bottom: area.bottom}
				return (icon, arrows)
			}

			// The part at the field's end a point of the component is on: 0 none, 1 a
			// trailing icon that can be pressed, 2 the up arrow, 3 the down arrow.
			def endPart(x float, y float) int {
				let (icon, arrows) = endBoxes()
				if !(onStep is none) && x >= arrows.left - 2.0 {
					return y < (arrows.top + arrows.bottom) / 2.0 ?? (2, 3)
				}
				return 1 when trailing != "" && !(onTrailing is none) && x >= icon.left - 2.0 && x < icon.right + 2.0
				return 0
			}

			// Runs what a part at the field's end is for.
			def runPart(part int) {
				if part == 1 {
					let run = onTrailing
					run() unless run is none
					trailingClicked()
					return
				}
				let step = onStep
				step(part == 2 ?? (1, -1)) unless step is none
				stepped(part == 2 ?? (1, -1))
			}

			// Notes the part under the pointer: over one the pointer is an arrow, over the
			// text an I-beam.
			def point(part int) {
				return when part == pointed
				pointed = part
				style.cursor = part == 0 ?? (Cursor.Text, Cursor.Default)
				redraw()
			}

			// Where a caret can stand in the text as it is shown now.
			def carets() paint.CaretMap {
				let made = current()
				let held = map
				let from = mapBlock
				if !(held is none) && !(from is none) {
					return held when from == made && mapText == made.text
				}
				let fresh = new paint.CaretMap(made)
				map      = fresh
				mapBlock = made
				mapText  = made.text
				return fresh
			}

			// How far from the text's left edge the caret before character `index` stands.
			def caretX(index int) float {
				let (x, _) = carets().place(index)
				return x
			}

			// Moves the text so the caret is inside the content box.
			def reveal() {
				let (spanLeft, spanRight) = textSpan()
				let room = spanRight - spanLeft
				return when room <= 0.0
				let made = current()
				let x = caretX(edit.drawn(edit.caret))
				let whole = float(made.measure(Limit{}).width)
				shift = x - room + 1.0 when x - shift > room - 1.0
				shift = x when x - shift < 0.0
				shift = shift.min((whole - room + 1.0).max(0.0)).max(0.0)
			}

			// The caret position nearest a point of the component.
			def indexAt(x float) int {
				let (spanLeft, _) = textSpan()
				let at = carets().at(0, x - spanLeft + shift)
				return edit.written(at)
			}

			// What the lines of its menu do.
			def cutText() {
				take()
				report() when editCut(edit, kind == TextKind.Password)
			}

			def copyText() {
				let _ = editCopy(edit, kind == TextKind.Password)
			}

			def pasteText() {
				take()
				report() when editPaste(edit, true)
			}

			def selectText() {
				edit.selectAll()
				report()
			}

			// Whether there is something to cut or copy.
			def marked() bool {
				return edit.hasSelection() && kind != TextKind.Password
			}

			// Opens the menu once the views ran again and built it.
			def openMenu() {
				let at = menuAt
				let built = menu
				return when at is none || built is none
				built.context(at)
				menuAt = none
			}

			// A press puts the caret and starts a selection that a drag extends; the
			// secondary button asks for the menu.
			def pointer(e PointerEvent) bool {
				return false when disabled
				match e.phase {
					case PointerPhase.Down:
						return false when e.button != MouseButton.Left
						e.capture()
						// A press on an icon or an arrow at the end is that part's.
						held = endPart(float(e.position.x), float(e.position.y))
						if held != 0 {
							// An arrow steps as it goes down, and again while it is held;
							// an icon runs when the button comes up over it.
							if held > 1 {
								runPart(held)
								again = time.now() + stepDelay
								wakeBy(again)
							}
							redraw()
							return true
						}
						// A second press selects the word under it, a third everything; a drag
						// extends a single press only.
						if e.clicks == 2 {
							edit.selectWord(indexAt(float(e.position.x)))
							report()
							return true
						}
						if e.clicks >= 3 {
							edit.selectAll()
							report()
							return true
						}
						// A press on the selected text may be the start of dragging it.
						if marked() && !e.modifiers.shift {
							let (from, to) = edit.range()
							let at = indexAt(float(e.position.x))
							if at >= from && at < to {
								lifting = true
								return true
							}
						}
						selecting = true
						edit.move(indexAt(float(e.position.x)), e.modifiers.shift)
						report()
						return true
					case PointerPhase.Move, PointerPhase.Enter:
						// Left to the window, which starts the drag once the pointer is far
						// enough from the press.
						return false when lifting
						if !selecting {
							point(endPart(float(e.position.x), float(e.position.y)))
							return held != 0
						}
						edit.move(indexAt(float(e.position.x)), true)
						report()
						return true
					case PointerPhase.Leave:
						point(0)
						return false
					case PointerPhase.Up, PointerPhase.Cancel:
						// The first release of the secondary button builds the menu and opens
						// it there; from then on the menu opens by itself.
						if e.phase == PointerPhase.Up && e.button == MouseButton.Right && !menuAsked {
							menuAsked = true
							menuAt    = e.windowPosition
							redraw()
							afterArrange(openMenu)
							return true
						}
						if held != 0 {
							let part = held
							held = 0
							redraw()
							runPart(part) when part == 1 && e.phase == PointerPhase.Up && endPart(float(e.position.x), float(e.position.y)) == part
							return true
						}
						// The selection was pressed and not dragged: the caret goes there.
						if lifting && e.phase == PointerPhase.Up {
							lifting = false
							edit.move(indexAt(float(e.position.x)))
							report()
							return true
						}
						let was = selecting
						selecting = false
						return was
					default:
						return false
				}
			}

			def drags() bool {
				return lifting && !disabled
			}

			// What a drag of the selection carries: its text.
			def dragData() DragData {
				return DragData{text: edit.selected()}
			}

			def dragMoved(at Point<Pixels>) {}

			def dragBegan() {
				lifting = false
				lifted  = true
				settled = false
			}

			// Dropped on something that took it, the text moved there: it leaves this
			// field, unless the field itself took it and moved it already.
			def dragEnded(dropped bool) {
				if dropped && lifted && !settled && edit.hasSelection() {
					let _ = edit.erase(false)
					report()
				}
				lifting = false
				lifted  = false
				settled = false
			}

			// Text dragged over it is taken: from another field, a `Draggable` or another
			// application.
			def takes(data DragData) bool {
				return !disabled && data.text != ""
			}

			def dropEffect(data DragData, at Point<Pixels>) DropEffect {
				return DropEffect.Move
			}

			// The dropped text goes in at the place under the pointer. Its own selection
			// dropped on itself stays; dropped elsewhere in the field it moves there.
			def dropOn(data DragData, at Point<Pixels>) {
				take()
				let index = indexAt(float(at.x) - float(style.geom.frame.left))
				if lifted {
					settled = true
					let (from, to) = edit.range()
					return when index >= from && index <= to
					let _ = edit.erase(false)
					index -= to - from when index > to
				}
				edit.move(index)
				edit.insert(data.text)
				report()
				focus()
			}

			// The editing keys. Keys that type a
			// character are taken, so they do not reach a shortcut further up; the
			// character itself arrives through `commit`.
			def key(e KeyEvent) bool {
				return false when !e.down
				return false when disabled
				take()
				let extend = e.modifiers.shift
				let word = e.modifiers.mod
				match e.key {
					case Key.Left:
						let (from, _) = edit.range()
						edit.move(edit.hasSelection() && !extend ?? (from, edit.step(false, word)), extend)
					case Key.Right:
						let (_, to) = edit.range()
						edit.move(edit.hasSelection() && !extend ?? (to, edit.step(true, word)), extend)
					case Key.Home:
						edit.move(0, extend)
					case Key.End:
						edit.move(edit.text.len(), extend)
					case Key.Backspace:
						let _ = edit.erase(false, word)
					case Key.Delete:
						let _ = edit.erase(true, word)
					case Key.Enter, Key.KeypadEnter:
						let run = onSubmit
						run() unless run is none
						submitted()
						return true
					default:
						return shortcut(e)
				}
				report()
				return true
			}

			// Select all, copy, cut and paste, and the keys that type.
			def shortcut(e KeyEvent) bool {
				let taken = editShortcut(edit, e, secret = kind == TextKind.Password, oneLine = true)
				report() when taken == KeyTaken.Changed
				return taken != KeyTaken.No
			}

			// Text from the platform's input: in place of the selection, or at the caret.
			def commit(text string) {
				return when disabled
				take()
				edit.insert(text)
				report()
			}

			// What an input method is edit.composing: shown underlined at the caret until it
			// is committed or taken back (an empty `text`). It takes the place of the
			// selection. `caret` is where the method's caret is in it, in characters;
			// negative: at its end.
			def compose(text string, caret int) {
				return when disabled
				take()
				report() when edit.compose(text, caret)
				moved = time.now()
				redraw()
			}

			def surrounding() string {
				return edit.text
			}

			def selection() TextRange {
				let (from, to) = edit.range()
				return TextRange{start: from, end: to}
			}

			def deleteSurrounding(before int, after int) {
				take()
				let at = edit.caret
				edit.move(at - before)
				edit.move(at + after, true)
				let _ = edit.erase(false)
				report()
			}

			// The caret in the window.
			def caretRect() Rect<Pixels> {
				let frame = style.geom.frame
				let area = style.geom.content
				let (spanLeft, _) = textSpan()
				let x = float(frame.left) + spanLeft + caretX(edit.drawn(edit.caret)) - shift
				return Rect<Pixels>{left: x * 1(px), top: frame.top + area.top, right: (x + 1.0) * 1(px), bottom: frame.top + area.bottom}
			}

			// The input `kind`, for the platform's keyboard.
			def inputKind() TextKind {
				return kind
			}

			def render(ctx RenderContext) {
				let palette = look.palette
				let metrics = look.metrics
				ctx.outerShadows()
				ctx.background()
				ctx.borders()

				let area = ctx.geometry.content
				let inside = area.toFloat()
				// The icons inside the field, at its two ends, then the text between them.
				let side = float(metrics.iconSize)
				let muted = !disabled ?? (palette.foregroundMuted, palette.foregroundDisabled)
				let strong = !disabled ?? (palette.foreground, palette.foregroundDisabled)
				let middle = (inside.top + inside.bottom) / 2.0
				let first = before.get(leading)
				drawIcon(ctx.draw, first, Rect{left: inside.left, top: middle - side / 2.0, right: inside.left + side, bottom: middle + side / 2.0}, muted) unless first is none
				let (iconBox, arrows) = endBoxes()
				let last = after.get(trailing)
				drawIcon(ctx.draw, last, Rect{left: iconBox.left, top: middle - side / 2.0, right: iconBox.right, bottom: middle + side / 2.0}, pointed == 1 || held == 1 ?? (strong, muted)) unless last is none
				if !(onStep is none) {
					// Two arrows, one above the other, each in half the height.
					let small = side * 0.75
					let (upper, lower) = (up.get("chevron-up"), down.get("chevron-down"))
					let across = (arrows.left + arrows.right) / 2.0
					drawIcon(ctx.draw, upper, Rect{left: across - small / 2.0, top: middle - small + 1.0, right: across + small / 2.0, bottom: middle + 1.0}, pointed == 2 || held == 2 ?? (strong, muted)) unless upper is none
					drawIcon(ctx.draw, lower, Rect{left: across - small / 2.0, top: middle - 1.0, right: across + small / 2.0, bottom: middle + small - 1.0}, pointed == 3 || held == 3 ?? (strong, muted)) unless lower is none
				}
				// An arrow that is held steps again each time its turn comes.
				if held > 1 {
					if ctx.draw.frameTime >= again {
						runPart(held)
						again = ctx.draw.frameTime + stepEvery
					}
					wakeBy(again)
				}
				let (spanLeft, spanRight) = textSpan()
				inside = Rect{left: spanLeft, top: inside.top, right: spanRight, bottom: inside.bottom}
				let made = current()
				let high = float(line().measure(Limit{}).height)
				let top = inside.top + ((inside.bottom - inside.top - high) / 2.0).max(0.0)
				let left = inside.left - shift
				ctx.draw.save()
				ctx.draw.clip(inside)
				if edit.hasSelection() {
					let (from, to) = edit.range()
					let marked = Rect{left: left + caretX(from), top: top, right: left + caretX(to), bottom: top + high}
					ctx.draw.fill(marked, focused ?? (style.selection.background, style.selection.inactive))
				}
				let line = Rect{left: left, top: top, right: left + float(made.measure(Limit{}).width) + 1.0, bottom: top + high}
				if edit.text.len() == 0 && edit.composing == "" && placeholder.len() > 0 {
					let dim = lineBlock(hint, placeholder, palette.foregroundMuted)
					hint = dim
					paint.drawBlock(ctx.draw, dim, Rect{left: inside.left, top: top, right: inside.right, bottom: top + high}, Align{}, false, ctx.scale)
				} else {
					paint.drawBlock(ctx.draw, made, line, Align{}, false, ctx.scale)
				}
				if edit.composing != "" {
					// A line under what is being composed.
					let under = Rect{left: left + caretX(edit.caret), top: top + high - 1.0, right: left + caretX(edit.caret + edit.composing.len()), bottom: top + high}
					ctx.draw.fill(under, strong)
				}
				// The caret's next blink is a frame nothing else asks for.
				let period = caretPeriod()
				caretWakes(period, moved, ctx.draw.frameTime) when focused && !disabled
				if focused && !disabled && caretShows(period, moved, ctx.draw.frameTime) {
					let x = left + caretX(edit.drawn(edit.caret))
					let ink = style.caret.paint
					let width = float(style.caret.width)
					let bar = Rect{left: x, top: top, right: x + width, bottom: top + high}
					if ink is none {
						ctx.draw.fill(bar, palette.foreground)
					} else {
						ctx.draw.fill(bar, ink)
					}
				}
				ctx.draw.restore()
				ctx.childNodes()
				ctx.innerShadows()
			}

			// How long the caret is shown, then hidden: the style's, else the desktop's; 0s
			// does not blink.
			def caretPeriod() duration {
				let own = style.caret.blink
				return own unless own is none
				return blink
			}
		}

		view {
			// Built the first time it is asked for.
			if menuAsked {
				FieldMenu(ref = menu, marked = marked(), onCut = cutText, onCopy = copyText, onPaste = pasteText, onSelectAll = selectText)
			}
		}

		style {
			TextFieldStyle
			width     = 200(px)
			minHeight = theme.metrics.controlHeight
			// The edge is part of the box: the padding is what is left of the room around the text.
			padding = new Edges<Extent>(0(px), theme.metrics.unit * 2.0 - theme.metrics.borderWidth)
		}
	}
}
