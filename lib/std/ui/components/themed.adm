partial module std.ui.components {
	use (
		std.ui::Theme
	)

	// Gives what it holds a theme of its own: `Themed(theme = dark) { ... }`. The styles
	// of the components under it read that theme where they name `theme`, in place of
	// the window's or `UI.theme()`; a `Themed` inside another takes over for what it
	// holds. It has no box of its own: what it holds is laid out as if it were not there.
	@scoped
	component Themed {
		type {
			// The theme of what it holds. Another one given later takes its place on
			// the next frame.
			@input
			theme Theme
		}

		view {
			provide<Theme>(theme)
			children()
		}
	}

	// Gives what it holds a value they find with `context<V>()`: `Provide(document) {
	// ... }` makes `document` the `Document` of every component under it. For a value a
	// controller has, `provide<V>(value)` in its `attached()` does the same without a
	// component. It has no box of its own.
	@scoped
	component Provide<V> {
		type {
			// What the components under it find.
			@input(value = true)
			value V
		}

		view {
			provide<V>(value)
			children()
		}
	}
}
