partial module std.ui.components {
	use (
		std.gfx.color::(Color, RGBA)
		std.math.geom::Size
		std.testing
		std.ui::(Appearance, ColorScheme, Theme, UI, themeOf)
		std.ui.runtime
		std.ui.runtime::Scene
		std.ui.styles::*
		std.units::Pixels
	)

	// What a style keeps of the theme it reads.
	datatype Inked {
		ink Color
	}

	component ThemeProbe {
		type {}

		view {}

		style {
			Box
			@styleProperty
			let ink Color = new Color(RGBA{r: 0, g: 0, b: 0, a: 255})

			width  = 10(px)
			height = 10(px)
			ink    = theme.palette.foreground
			on     = {
				hover: {ink: theme.palette.accent},
			}
		}
	}

	component ThemeHolder {
		type {
			@input
			inner Theme

			deep Theme = new Theme(Appearance{scheme: ColorScheme.Light})
		}

		view {
			ThemeProbe(ref = plain)
			Themed(theme = inner) {
				ThemeProbe(ref = inside)
				Themed(theme = deep) {
					ThemeProbe(ref = deepest)
				}
			}
		}

		style {
			Box
		}
	}

	type Chapter {
		title string = ""

		def new(title string) {
			self.title = title
		}
	}

	component ChapterReader {
		type {
			def title() string {
				let chapter = context<Chapter>()
				return "none" when chapter is none
				return chapter.title
			}
		}

		view {}

		style {
			Box
		}
	}

	component Book {
		type {
			@input
			chapter Chapter
		}

		view {
			ChapterReader(ref = outside)
			Provide(chapter) {
				ChapterReader(ref = inside)
			}
		}

		style {
			Box
		}
	}

	internal def inkOf(probe ?ThemeProbe) Color {
		return new Color(RGBA{r: 1, g: 2, b: 3, a: 4}) when probe is none
		return probe.style.ink
	}

	check "Themed" {
		// A style reads the theme of the nearest component that provides one: `Themed`
		// for what it holds, the inner of two for its own, `UI.theme()` elsewhere. Another
		// theme given to a `Themed`, and one given to `UI.setTheme`, reach the styles that
		// read them on the next layout and no others.
		@test()
		def TestStylesReadTheNearestTheme() {
			let global = UI.theme()
			global.follow(Appearance{scheme: ColorScheme.Light})
			let dark = new Theme(Appearance{scheme: ColorScheme.Dark})
			let holder = ThemeHolder(inner = dark)
			let scene = new Scene(holder)
			let size = new Size<Pixels>(100(px), 100(px))
			scene.arrange(size)
			assert global.palette.foreground != dark.palette.foreground
			assert inkOf(holder.plain) == global.palette.foreground
			assert inkOf(holder.inside) == dark.palette.foreground
			assert inkOf(holder.deepest) == holder.deep.palette.foreground
			assert themeOf(holder.inside) == dark && themeOf(holder.plain) == global && themeOf(holder.deepest) == holder.deep

			// A state's look reads that theme too.
			let inside = holder.inside
			assert !(inside is none)
			return when inside is none
			inside.isHover = true
			let look = runtime.stateLook(scene.tree.children[1], inside)
			assert look is Inked && look.ink == dark.palette.accent
			inside.isHover = false

			// Another theme for the `Themed`: what it holds follows, the rest stays.
			let tinted = new Theme(Appearance{scheme: ColorScheme.Dark})
			tinted.palette.foreground = new Color(RGBA{r: 9, g: 8, b: 7, a: 255})
			holder.inner = tinted
			scene.arrange(size)
			assert inkOf(holder.inside) == tinted.palette.foreground
			assert inkOf(holder.plain) == global.palette.foreground
			assert inkOf(holder.deepest) == holder.deep.palette.foreground

			// Another theme for the program: only what read the old one follows.
			let mine = new Theme(Appearance{scheme: ColorScheme.Dark})
			mine.palette.foreground = new Color(RGBA{r: 1, g: 1, b: 1, a: 255})
			UI.setTheme(mine)
			assert UI.theme() == mine
			scene.arrange(size)
			assert inkOf(holder.plain) == mine.palette.foreground
			assert inkOf(holder.inside) == tinted.palette.foreground
			UI.setTheme(global)
			global.follow(Appearance{})
		}

		// `Provide(value) { ... }` gives what it holds a value they find by its type.
		@test()
		def TestProvideGivesAValue() {
			let book = Book(chapter = new Chapter("one"))
			let scene = new Scene(book)
			scene.arrange(new Size<Pixels>(100(px), 100(px)))
			let outside = book.outside
			let inside = book.inside
			assert !(outside is none) && !(inside is none)
			return when outside is none || inside is none
			assert outside.title() == "none" && inside.title() == "one"
			book.chapter = new Chapter("two")
			scene.arrange(new Size<Pixels>(100(px), 100(px)))
			assert inside.title() == "two"
		}
	}
}
