partial module std.ui.components {
	use (
		std.gfx.canvas
		std.gfx.color::(Color, RGBA)
		std.math.geom::(Axes, Circle, Corners, Edges, Point, Size, Vec2)
		std.time
		std.ui::(PointerEvent, PointerPhase, RenderContext, Theme, UI, themeOf)
		std.ui.frames::askFrame
		std.ui.runtime::(afterArrange, wakeBy)
		std.ui.styles::*
		std.units::(Extent, Pixels)
	)

	// What a notice is about: it has a light shade of the theme's colour for it, and a
	// dot of that colour before its text.
	enum ToastKind {
		Info,
		Success,
		Warning,
		Danger,
	}

	// How wide a `Toast` may be, in pixels, in a window that has the room.
	internal const toastWide = 360.0

	// A short notice in the window's end corner that goes by itself:
	// `Toast(text = "Saved", open = saved, onClose = seen)`. It is over everything but a
	// drag, takes no focus, and closes after `lasts`, or at once when pressed. A press
	// elsewhere and Escape leave it. With `action` it holds a button that runs `onAction`
	// and closes it: `Toast("Deleted", action = "Undo", onAction = restore, open = gone)`.
	// Notices open at once under one parent stand one above another, the first lowest.
	//
	// Code that only wants to say something asks the `Toasts` above it: see `ToastHost`.
	component Toast {
		type {
			// What it says.
			@input(value = true)
			text string = ""

			// What it is about.
			@input
			kind ToastKind = ToastKind.Info

			// What its button says; empty: no button.
			@input
			action string = ""

			// Runs when its button is pressed, before it closes.
			@input
			onAction ?(def()) = none

			// Whether it is shown.
			@input(bind = true)
			@state
			open bool = false

			// How long it stays; 0s: until it is pressed or the caller closes it.
			@input
			lasts duration = 4s

			// Runs when it closes itself: its time is up, or it was pressed.
			@input
			onClose ?(def()) = none

			// Tells every listener it closed, after the handler ran: heard with
			// `@on(Toast.closed)`.
			@emit()
			def closed() bool {
				return true
			}

			// Tells the caller and the listeners that it closed.
			def tellClosed() {
				let run = onClose
				run() unless run is none
				closed()
			}

			look  Theme = UI.theme()
			// Whether it was open when it was placed last, and when it opened.
			shown bool
			since time.Time

			// Hides itself.
			def close() {
				return when !open
				open = false
				redraw()
				tellClosed()
			}

			// Runs what its button is for and closes.
			def act() {
				let run = onAction
				run() unless run is none
				close()
			}

			// The room the open notices before it under its parent take, each with the
			// gap above it. One of them not laid out yet is counted on the next frame.
			def lifted() float {
				let above = parent()
				return 0.0 when above is none
				let me component = self
				let gap = float(look.metrics.unit) * 2.0
				let sum = 0.0
				for let child in above.childNodes {
					return sum when child == me
					if child is Toast {
						continue when !child.open
						let high = float(child.style.geom.frame.height)
						askFrame(true) when high <= 0.0
						sum += high + gap
					}
				}
				return sum
			}

			// Shows or hides itself in the end corner of the window, above the notices
			// open before it, and closes when its time is up.
			def place(window Size<Pixels>) {
				if open && !shown {
					since = time.now()
				}
				shown = open
				if open && lasts > 0s {
					let due = since + lasts
					if time.now() >= due {
						// The caller is told once the frame's tree is in step.
						open  = false
						shown = false
						redraw()
						afterArrange(tellClosed)
					} else {
						wakeBy(due, self)
					}
				}
				style.visible = open
				return when !open
				let me component = self
				let root = windowRoot(me)
				let margin = float(look.metrics.unit) * 4.0
				// In a window narrower than a notice may be, it keeps its margin on both sides.
				let widest Extent = toastWide.min(float(window.width) - margin * 2.0).max(0.0) * 1(px)
				style.maxWidth = widest
				let away Extent = -margin * 1(px)
				let up Extent = -(margin + lifted()) * 1(px)
				let under = new AnchorLine(root, AnchorEdge.Bottom)
				under.offset = up
				if style.geom.direction == Direction.RightToLeft {
					let side = new AnchorLine(root, AnchorEdge.Left)
					let inward Extent = margin * 1(px)
					side.offset = inward
					style.anchors = Anchors{left: side, bottom: under}
				} else {
					let side = new AnchorLine(root, AnchorEdge.Right)
					side.offset = away
					style.anchors = Anchors{right: side, bottom: under}
				}
			}

			def pointer(e PointerEvent) bool {
				return false when e.phase != PointerPhase.Down
				close()
				return true
			}

			// The theme's colour for what it is about.
			def tint() Color {
				let palette = themeOf(self).palette
				match kind {
					case ToastKind.Success:
						return palette.success
					case ToastKind.Warning:
						return palette.warning
					case ToastKind.Danger:
						return palette.danger
					default:
						return palette.info
				}
			}

			// A light shade of its colour, on the theme's overlay.
			def shade() Color {
				return themeOf(self).palette.overlay.mix(tint(), 0.14)
			}

			def render(ctx RenderContext) {
				ctx.outerShadows()
				ctx.background()
				// A dot of its colour before the text.
				let box = frameBox(ctx)
				let unit = float(themeOf(self).metrics.unit)
				let reach = unit * 1.25
				let across = ctx.direction == Direction.RightToLeft ?? (box.right - unit * 4.0, unit * 4.0)
				ctx.draw.fill(new Circle(new Point(across, box.bottom / 2.0), reach), tint())
				ctx.childNodes()
				ctx.innerShadows()
			}
		}

		view {
			Text(text)
			if action != "" {
				// The button stands at the end.
				Spacer()
				Button(label = action, onClick = act)
			}
		}

		style {
			DialogStyle
			Shadows
			layer    = Layer.Notification
			maxWidth = toastWide * 1(px)
			minWidth = 240(px)
			// Room for the dot of its colour before the text.
			padding    = new Edges<Extent>(theme.metrics.unit * 3.0, theme.metrics.unit * 4.0, theme.metrics.unit * 3.0, theme.metrics.unit * 7.5)
			arrange    = Arrange.Row
			gap        = new Axes<Extent>(theme.metrics.unit * 3.0)
			align      = Align{horizontal: Alignment.Start, vertical: Alignment.Center}
			background = new BackgroundFill(self.shade())
			radius     = new Corners<Extent>(theme.metrics.radius * 1.5)
			shadows    = [canvas.DropShadow{offset: new Vec2(0.0, 3.0), blur: 12(px), color: new Color(RGBA{r: 0, g: 0, b: 0, a: 48})}]
			transition = Transition{duration: theme.motion.normal, easing: theme.motion.enter}
			// It rises into its place and fades where it is.
			enter = {opacity: 0.0, transform: {translate: {y: theme.metrics.unit * 4.0}}}
			exit  = {opacity: 0.0}
		}
	}
}
