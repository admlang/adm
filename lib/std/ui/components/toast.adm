partial module std.ui.components {
	use (
		std.math.geom::(Edges, Size)
		std.time
		std.ui::(Limit, PointerEvent, PointerPhase, RenderContext, Theme, UI)
		std.ui.paint
		std.ui.runtime::(afterArrange, wakeBy)
		std.ui.styles::*
		std.units::(Extent, Pixels)
	)

	// A short notice in the window's end corner that goes by itself:
	// `Toast(text = "Saved", open = saved, onClose = seen)`. It is over everything but a
	// drag, takes no focus, and closes after `lasts`, or at once when pressed. A press
	// elsewhere and Escape leave it.
	component Toast {
		type {
			// What it says.
			@input(value = true)
			text string = ""

			// Whether it is shown.
			@input(bind = true)
			@state
			open bool = false

			// How long it stays; 0s: until it is pressed or the caller closes it.
			@input
			lasts duration = 4s

			// Runs when it closes itself: its time is up, or it was pressed.
			@input
			onClose ?(def()) = none

			// Tells every listener it closed, after the handler ran: heard with
			// `@on(Toast.closed)`.
			@emit()
			def closed() bool {
				return true
			}

			// Tells the caller and the listeners that it closed.
			def tellClosed() {
				let run = onClose
				run() unless run is none
				closed()
			}

			look    Theme = UI.theme()
			block   ?paint.TextBlock = none
			// Whether it was open when it was placed last, and when it opened.
			shown   bool
			since   time.Time

			// Hides itself.
			def close() {
				return when !open
				open = false
				redraw()
				tellClosed()
			}

			// Shows or hides itself in the end corner of the window, and closes when its
			// time is up.
			def place(window Size<Pixels>) {
				if open && !shown {
					since = time.now()
				}
				shown = open
				if open && lasts > 0s {
					let due = since + lasts
					if time.now() >= due {
						// The caller is told once the frame's tree is in step.
						open  = false
						shown = false
						redraw()
						afterArrange(tellClosed)
					} else {
						wakeBy(due)
					}
				}
				style.visible = open
				return when !open
				let me component = self
				let root = windowRoot(me)
				let margin = float(look.metrics.unit) * 4.0
				let away Extent = -margin * 1(px)
				let under = new AnchorLine(root, AnchorEdge.Bottom)
				under.offset = away
				if style.geom.direction == Direction.RightToLeft {
					let side = new AnchorLine(root, AnchorEdge.Left)
					let inward Extent = margin * 1(px)
					side.offset = inward
					style.anchors = Anchors{left: side, bottom: under}
				} else {
					let side = new AnchorLine(root, AnchorEdge.Right)
					side.offset = away
					style.anchors = Anchors{right: side, bottom: under}
				}
			}

			def current() paint.TextBlock {
				let made = labelBlock(block, text, style.font, style.foreground, style.paragraph, look.palette.foreground)
				block = made
				return made
			}

			def measure(limit Limit) Size<Pixels> {
				return current().measure(limit)
			}

			def pointer(e PointerEvent) bool {
				return false when e.phase != PointerPhase.Down
				close()
				return true
			}

			def render(ctx RenderContext) {
				ctx.outerShadows()
				ctx.background()
				ctx.borders()
				drawEdge(ctx, look, frameBox(ctx), float(look.metrics.radius), true)
				paint.drawBlock(ctx.draw, current(), ctx.geometry.content.toFloat(), Align{}, ctx.direction == Direction.RightToLeft, ctx.scale)
				ctx.innerShadows()
			}
		}

		view {}

		style {
			DialogStyle
			layer    = Layer.Notification
			maxWidth = 360(px)
			padding  = new Edges<Extent>(theme.metrics.unit * 3.0)
		}
	}
}
