partial module std.ui.components {
	use std.ui.frames::askFrame

	// Shows notices to the user. A component asks the one above it:
	// `let toasts = context<Toasts>()`, then `toasts.show("Saved") unless toasts is none`.
	// A `ToastHost` provides the standard one; an application that shows its notices
	// another way provides a type of its own with these methods (`provide<Toasts>(mine)`).
	// Where nothing provides one, `context<Toasts>()` is none.
	interface Toasts {
		// Shows a notice and returns its number. `lasts` is how long it stays (0s: until
		// it is pressed or dismissed); with `action` it has a button that runs
		// `onAction` and closes it.
		def show(text string, kind ToastKind = ToastKind.Info, lasts duration = 4s, action string = "", onAction ?(def()) = none) int
		// Takes the notice with this number away, shown or still waiting; a number
		// that is gone does nothing.
		def dismiss(notice int)
		// Takes every notice away.
		def clear()
	}

	// One notice a `ToastHost` holds.
	internal struct Notice {
		id       int
		text     string
		kind     ToastKind
		lasts    duration
		action   string
		onAction ?(def())
	}

	// The notices of a `ToastHost`, in the order they were asked for.
	internal type ToastQueue {
		held Notice[] = []
		last int      = 0

		// The host, whose view shows them.
		weak owner ?component = none

		def show(text string, kind ToastKind = ToastKind.Info, lasts duration = 4s, action string = "", onAction ?(def()) = none) int {
			last++
			held.push(Notice{id: last, text: text, kind: kind, lasts: lasts, action: action, onAction: onAction})
			changed()
			return last
		}

		def dismiss(notice int) {
			let kept Notice[]
			for let one in held {
				kept.push(one) unless one.id == notice
			}
			return when kept.len() == held.len()
			held = kept
			changed()
		}

		def clear() {
			return when held.len() == 0
			held = []
			changed()
		}

		// The first `limit` notices: those that show.
		def first(limit int) Notice[] {
			return held when held.len() <= limit
			return held.slice(0, limit.max(0))
		}

		// Has the host show what there is now.
		def changed() {
			let host = owner
			return when host is none
			host.rerun()
			askFrame(true)
		}
	}

	// Gives everything under it a `Toasts` and shows its notices in the window's end
	// corner, one above another: `ToastHost() { Workbench() }`, placed once around what
	// may ask. At most `limit` show at a time; the others wait for one to go, and a
	// small notice above the stack says how many do: a press on it shows them all. A
	// notice goes when its time is up, when it or its button is pressed, or when it is
	// dismissed.
	@scoped
	component ToastHost {
		type {
			// How many notices show at once.
			@input
			limit int = 3

			queue ToastQueue = new ToastQueue()

			// Whether the notices past `limit` show too: the user pressed the count of
			// those waiting. It lasts until no more than `limit` are left.
			all bool = false

			// The notices that show.
			def shown() Notice[] {
				all = false when queue.held.len() <= limit
				return queue.held when all
				return queue.first(limit)
			}

			// How many wait for their turn.
			def waiting() int {
				return queue.held.len() - shown().len()
			}

			// Shows the waiting ones as well.
			def unfold() {
				all = true
				rerun()
			}

			// The `Toasts` it provides.
			def toasts() Toasts {
				let me component = self
				queue.owner = me
				return queue
			}
		}

		view {
			provide<Toasts>(toasts())
			children()
			for let notice in shown() {
				Toast(notice.text, kind = notice.kind, lasts = notice.lasts, action = notice.action, onAction = notice.onAction, open = true, key = notice.id, onClose = () => queue.dismiss(notice.id))
			}
			// Those that wait are counted above the others; a press shows them all.
			if waiting() > 0 {
				Toast("{waiting()} more", lasts = 0s, open = true, key = -waiting(), onClose = unfold)
			}
		}
	}
}
