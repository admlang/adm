partial module std.ui.components {
	// Shows notices to the user. A component asks the one above it:
	// `let toasts = context<Toasts>()`, then `toasts.show("Saved") unless toasts is none`.
	// A `ToastHost` provides the standard one; an application that shows its notices
	// another way provides a type of its own with these methods (`provide<Toasts>(mine)`).
	// Where nothing provides one, `context<Toasts>()` is none.
	interface Toasts {
		// Shows a notice of one line and returns its number. `lasts` is how long it
		// stays (0s: until it is pressed or dismissed); with `action` it has a button
		// that runs `onAction` and closes it. The same as `show(ToastNotice{title:
		// text, kind: kind, lasts: lasts, actions: [ToastAction{label: action, run: onAction}]})`.
		def show(text string, kind ToastKind = ToastKind.Info, lasts duration = 4s, action string = "", onAction ?(def()) = none) int
		// Shows a notice and returns its number: that of the notice it `replaces` when
		// one of that number is still held, which takes the new title, body, buttons
		// and progress in its place ("Fetching…" becoming "Fetched"); else a new one.
		def show(notice ToastNotice) int
		// Takes the notice with this number away, shown or still waiting; a number
		// that is gone does nothing.
		def dismiss(notice int)
		// Takes every notice away.
		def clear()
	}

	// A button of a notice: `label` on it; pressing it runs `run`, then the notice
	// closes.
	struct ToastAction {
		label string
		run   ?(def()) = none
	}

	// A notice as `Toasts.show` takes it, the way `std.services.notifications.Notification`
	// reads: `toasts.show(ToastNotice{title: "Fetched", body: "412 packages", actions:
	// [ToastAction{label: "Open", run: openList}]})`.
	struct ToastNotice {
		// Its first line.
		title    string
		// Text under the title; empty: none.
		body     string        = ""
		// What it is about: the shade and the dot of the theme's colour for it.
		kind     ToastKind     = ToastKind.Info
		// How long it stays; 0s: until it is pressed or dismissed. Not counted while
		// `progress` is set and below 1.0: what is under way stays until it is done.
		lasts    duration      = 4s
		// Its buttons, in order.
		actions  ToastAction[] = []
		// How far along what it reports is, 0 to 1, drawn as a bar; none: no bar.
		progress ?float        = none
		// The number of a shown notice to take the place of; 0: a new notice.
		replaces int           = 0
	}

	// One notice a `ToastHost` holds.
	internal struct Notice {
		id     int
		notice ToastNotice
	}

	// The notices of a `ToastHost`, in the order they were asked for. Its methods are
	// atomic: a notice is shown from any task (a fetch finishing), and the host's view
	// reads the list on the UI's.
	internal type ToastQueue {
		held Notice[] = []
		last int      = 0

		// The host, whose view shows them.
		weak owner ?component = none

		def show(text string, kind ToastKind = ToastKind.Info, lasts duration = 4s, action string = "", onAction ?(def()) = none) int {
			let actions ToastAction[] = []
			actions.push(ToastAction{label: action, run: onAction}) when action != ""
			return show(ToastNotice{title: text, kind: kind, lasts: lasts, actions: actions})
		}

		atomic def show(notice ToastNotice) int {
			if notice.replaces != 0 {
				for let (i, one) in held {
					continue unless one.id == notice.replaces
					held[i] = Notice{id: one.id, notice: notice}
					changed()
					return one.id
				}
			}
			last++
			held.push(Notice{id: last, notice: notice})
			changed()
			return last
		}

		atomic def dismiss(notice int) {
			let kept Notice[]
			for let one in held {
				kept.push(one) unless one.id == notice
			}
			return when kept.len() == held.len()
			held = kept
			changed()
		}

		atomic def clear() {
			return when held.len() == 0
			held = []
			changed()
		}

		// How many notices it holds.
		atomic def count() int {
			return held.len()
		}

		// The first `limit` notices, those that show, or all of them with `limit` below
		// 0: a copy of the list as it is now.
		atomic def first(limit int) Notice[] {
			return held.clone() when limit < 0 || held.len() <= limit
			return held.slice(0, limit)
		}

		// Has the host show what there is now: its view runs again on the next frame,
		// asked for from whatever task this is.
		def changed() {
			let host = owner
			return when host is none
			host.redraw()
		}
	}

	// Gives everything under it a `Toasts` and shows its notices in the window's end
	// corner, one above another: `ToastHost() { Workbench() }`, placed once around what
	// may ask. At most `limit` show at a time; the others wait for one to go, and a
	// small notice above the stack says how many do: a press on it shows them all. A
	// notice goes when its time is up, when it or its button is pressed, or when it is
	// dismissed.
	@scoped
	component ToastHost {
		type {
			// How many notices show at once.
			@input
			limit int = 3

			queue ToastQueue = new ToastQueue()

			// Whether the notices past `limit` show too: the user pressed the count of
			// those waiting. It lasts until no more than `limit` are left.
			all bool = false

			// The notices that show.
			def shown() Notice[] {
				all = false when queue.count() <= limit
				return queue.first(all ?? (-1, limit))
			}

			// How many wait for their turn.
			def waiting() int {
				return queue.count() - shown().len()
			}

			// Shows the waiting ones as well.
			def unfold() {
				all = true
				rerun()
			}

			// The `Toasts` it provides.
			def toasts() Toasts {
				let me component = self
				queue.owner = me
				return queue
			}
		}

		view {
			provide<Toasts>(toasts())
			children()
			for let held in shown() {
				Toast(held.notice.title, body = held.notice.body, kind = held.notice.kind, lasts = held.notice.lasts, actions = held.notice.actions, progress = held.notice.progress, open = true, key = held.id, onClose = () => queue.dismiss(held.id))
			}
			// Those that wait are counted above the others; a press shows them all.
			if waiting() > 0 {
				Toast("{waiting()} more", lasts = 0s, open = true, key = -waiting(), onClose = unfold)
			}
		}
	}
}
