partial module std.ui.components {
	use (
		std.math.geom::(Point, Size)
		std.testing
		std.time
		std.ui::PointerPhase
		std.ui.runtime::Scene
		std.ui.styles::*
		std.units::Pixels
	)

	internal let toastLog = string[]

	// Something that says what it is told through the `Toasts` above it.
	component Announcer {
		type {
			// The number of the notice; -1 when nothing above provides `Toasts`.
			def say(text string, kind ToastKind = ToastKind.Info, action string = "") int {
				let toasts = context<Toasts>()
				return -1 when toasts is none
				return toasts.show(text, kind = kind, lasts = 0s, action = action, onAction = undone)
			}

			def undone() {
				toastLog.push("undone")
			}

			// Shows a notice of the richer kind through the `Toasts` above it.
			def tell(notice ToastNotice) int {
				let toasts = context<Toasts>()
				return -1 when toasts is none
				return toasts.show(notice)
			}

			def opened() {
				toastLog.push("opened")
			}

			def retried() {
				toastLog.push("retried")
			}

			def take(notice int) {
				let toasts = context<Toasts>()
				toasts.dismiss(notice) unless toasts is none
			}

			def wipe() {
				let toasts = context<Toasts>()
				toasts.clear() unless toasts is none
			}
		}

		view {}

		style {
			Box
		}
	}

	// A host that shows two notices at a time around an announcer.
	component AnnouncedPage {
		type {
			def new() {
				style.width = 400(px)
				style.height = 400(px)
			}
		}

		view {
			ToastHost(limit = 2, ref = host) {
				Announcer(ref = inside)
			}
			Announcer(ref = outside)
		}

		style StageStyle
	}

	// An application's own way of showing notices: it writes them down.
	type WrittenToasts {
		def show(text string, kind ToastKind = ToastKind.Info, lasts duration = 4s, action string = "", onAction ?(def()) = none) int {
			toastLog.push("written {text}")
			return 7
		}

		def show(notice ToastNotice) int {
			toastLog.push("written {notice.title}: {notice.body}")
			return 8
		}

		def dismiss(notice int) {
			toastLog.push("dismissed {notice}")
		}

		def clear() {}
	}

	// A page with one notice of a long text, shown.
	component LongNotice {
		type {
			def new() {
				style.width = fill
				style.height = fill
			}
		}

		view {
			Toast(text = "Saved. This notice goes by itself, or when pressed.", open = true, lasts = 0s, ref = toast)
		}

		style StageStyle
	}

	component WrittenPage {
		type {
			written WrittenToasts = new WrittenToasts()

			def mine() Toasts {
				return written
			}
		}

		view {
			ToastHost() {
				Provide<Toasts>(mine()) {
					Announcer(ref = inside)
				}
			}
		}

		style StageStyle
	}

	check "Toasts" {
		// The notices a host shows now, in order.
		def shownBy(host component) Toast[] {
			let all Toast[]
			for let child in host.childNodes {
				all.push(child) when child is Toast
			}
			return all
		}

		def middleOf(c component) Point<Pixels> {
			let box = c.style.geom.frame
			return new Point<Pixels>((box.left + box.right) / 2.0, (box.top + box.bottom) / 2.0)
		}

		// A component under a host shows notices through `context<Toasts>()`; one that
		// has no host above it finds none. Notices stand one above another, at most
		// `limit` at a time; a press takes one away and the next one waiting shows.
		@test()
		def TestToastHostShowsWhatIsAsked() {
			toastLog.len(0)
			let page = AnnouncedPage()
			let scene = new Scene(page)
			let size = new Size<Pixels>(400(px), 400(px))
			let frames = def () {
				scene.arrange(size)
				scene.arrange(size)
				scene.arrange(size)
			}
			frames()
			let host = page.host
			let inside = page.inside
			let outside = page.outside
			assert !(host is none) && !(inside is none) && !(outside is none)
			return when host is none || inside is none || outside is none

			assert outside.say("lost") == -1
			assert shownBy(host).len() == 0
			assert inside.say("one") == 1 && inside.say("two", kind = ToastKind.Danger) == 2 && inside.say("three") == 3
			frames()
			// Two show; a third notice above them counts the one that waits.
			let shown = shownBy(host)
			assert shown.len() == 3 && shown[0].text == "one" && shown[1].text == "two" && shown[2].text == "1 more"
			assert shown[1].kind == ToastKind.Danger
			let (low, high) = (shown[0].style.geom.frame, shown[1].style.geom.frame)
			assert float(low.height) > 0.0 && float(high.height) > 0.0
			// The first in the end corner, the second above it.
			assert float(low.right) == 400.0 - 16.0 && float(low.bottom) == 400.0 - 16.0
			assert float(high.right) == 400.0 - 16.0 && float(high.bottom) == float(low.top) - 8.0
			assert float(shown[2].style.geom.frame.bottom) == float(high.top) - 8.0

			// A press on the first takes it away: the second comes down, the third shows.
			let at = middleOf(shown[0])
			scene.pointer(PointerPhase.Down, at)
			scene.pointer(PointerPhase.Up, at)
			frames()
			shown = shownBy(host)
			assert shown.len() == 2 && shown[0].text == "two" && shown[1].text == "three"
			assert float(shown[0].style.geom.frame.bottom) == 400.0 - 16.0

			// With more than the limit again, a press on the count shows them all.
			assert inside.say("four") == 4 && inside.say("five") == 5
			frames()
			shown = shownBy(host)
			assert shown.len() == 3 && shown[2].text == "2 more"
			let count = middleOf(shown[2])
			scene.pointer(PointerPhase.Down, count)
			scene.pointer(PointerPhase.Up, count)
			frames()
			shown = shownBy(host)
			assert shown.len() == 4 && shown[3].text == "five"
			inside.take(4)
			inside.take(5)
			frames()

			// Dismissed by its number, then all of them.
			inside.take(3)
			frames()
			shown = shownBy(host)
			assert shown.len() == 1 && shown[0].text == "two"
			inside.take(3)
			inside.wipe()
			frames()
			assert shownBy(host).len() == 0
			scene.close()
		}

		// A notice with an action holds a button: a press on it runs the handler and
		// takes the notice away.
		@test()
		def TestToastAction() {
			toastLog.len(0)
			let page = AnnouncedPage()
			let scene = new Scene(page)
			let size = new Size<Pixels>(400(px), 400(px))
			let frames = def () {
				nextFrame(scene, size)
				nextFrame(scene, size)
				nextFrame(scene, size)
			}
			frames()
			let host = page.host
			let inside = page.inside
			return when host is none || inside is none
			assert inside.say("Deleted", action = "Undo") == 1
			frames()
			let shown = shownBy(host)
			let head = shown[0].head
			assert shown.len() == 1 && shown[0].childNodes.len() == 1 && !(head is none)
			return when head is none
			// The button of a notice of one line stands at its end.
			assert head.childNodes.len() == 3
			let button = head.childNodes[2]
			assert button is Button && button.label == "Undo"
			let at = middleOf(button)
			scene.pointer(PointerPhase.Down, at)
			scene.pointer(PointerPhase.Up, at)
			frames()
			assert toastLog.join(",") == "undone"
			assert shownBy(host).len() == 0
			scene.close()
		}

		// A notice of the richer kind shows its title, body, progress bar and buttons in
		// a row at its foot; one with progress under way stays past its time, and goes
		// once the progress is done; a notice that `replaces` another keeps its number
		// and place and shows the new text; a button runs its handler and closes it.
		@test()
		def TestRichNotice() {
			toastLog.len(0)
			let page = AnnouncedPage()
			let scene = new Scene(page)
			let size = new Size<Pixels>(400(px), 400(px))
			let frames = def () {
				nextFrame(scene, size)
				nextFrame(scene, size)
				nextFrame(scene, size)
			}
			frames()
			let host = page.host
			let inside = page.inside
			return when host is none || inside is none
			let fetching = inside.tell(ToastNotice{title: "Fetching registry", body: "github.com/admlang/registry", lasts: 1ms, progress: 0.25})
			assert fetching == 1
			assert inside.tell(ToastNotice{title: "Saved", lasts: 0s}) == 2
			frames()
			let shown = shownBy(host)
			assert shown.len() == 2 && shown[0].text == "Fetching registry" && shown[1].text == "Saved"
			let first = shown[0]
			let (head, detail, bar) = (first.head, first.detail, first.bar)
			assert !(head is none) && !(detail is none) && !(bar is none) && first.foot is none
			return when head is none || detail is none || bar is none
			let part = bar.value
			assert detail.text == "github.com/admlang/registry" && !(part is none)
			return when part is none
			assert part == 0.25
			// Under way, it stays past its millisecond; the body stands under the title and
			// the bar under the body.
			let (titleBox, bodyBox, barBox) = (head.style.geom.frame, detail.style.geom.frame, bar.style.geom.frame)
			assert float(bodyBox.top) >= float(titleBox.bottom) && float(barBox.top) >= float(bodyBox.bottom)
			assert float(barBox.height) == 4.0 && float(barBox.width) > 100.0

			// Replaced in place: the same number, the same slot, the new text, two buttons
			// at the foot.
			let done = inside.tell(ToastNotice{title: "Fetched", body: "412 packages", lasts: 0s, replaces: fetching, actions: [ToastAction{label: "Open", run: inside.opened}, ToastAction{label: "Retry", run: inside.retried}]})
			assert done == fetching
			frames()
			shown = shownBy(host)
			assert shown.len() == 2 && shown[0].text == "Fetched" && shown[1].text == "Saved"
			let fetched = shown[0]
			let (foot, gone) = (fetched.foot, fetched.bar)
			assert !(foot is none) && gone is none
			return when foot is none
			assert foot.childNodes.len() == 3
			let (open, retry) = (foot.childNodes[1], foot.childNodes[2])
			assert open is Button && open.label == "Open" && retry is Button && retry.label == "Retry"
			let at = middleOf(retry)
			scene.pointer(PointerPhase.Down, at)
			scene.pointer(PointerPhase.Up, at)
			frames()
			assert toastLog.join(",") == "retried"
			shown = shownBy(host)
			assert shown.len() == 1 && shown[0].text == "Saved"

			// A notice whose progress reaches 1.0 goes once its time is up; a number
			// nothing holds any more starts a new notice.
			let late = inside.tell(ToastNotice{title: "Done", lasts: 1ms, progress: 1.0, replaces: fetching})
			assert late == 3
			frames()
			assert shownBy(host).len() == 2
			// Its time is the wall clock's.
			time.sleep(5ms)
			frames()
			shown = shownBy(host)
			assert shown.len() == 1 && shown[0].text == "Saved"
			scene.close()
		}

		// A notice with more text than fits its width breaks the text into lines inside
		// its box, and in a window narrower than a notice may be it keeps its margins.
		@test()
		def TestToastHoldsItsText() {
			let page = LongNotice()
			let scene = new Scene(page)
			for let wide in [1000.0, 300.0] {
				let size = new Size<Pixels>(wide * 1(px), 300(px))
				scene.arrange(size)
				scene.arrange(size)
				scene.arrange(size)
				let toast = page.toast
				return when toast is none
				let box = toast.style.geom.frame
				let text = toast.childNodes[0].style.geom.frame
				assert float(box.left) >= 16.0 && float(box.right) == wide - 16.0 && float(box.width) <= 360.0
				assert float(text.left) > float(box.left) && float(text.right) <= float(box.right) - 16.0
				assert float(text.top) >= float(box.top) && float(text.bottom) <= float(box.bottom)
				// More than one line of it.
				assert float(text.height) > 40.0
			}
			scene.close()
		}

		// Another `Toasts` provided under a host is the one found there.
		@test()
		def TestToastsOfAnotherKind() {
			toastLog.len(0)
			let page = WrittenPage()
			let scene = new Scene(page)
			let size = new Size<Pixels>(400(px), 400(px))
			scene.arrange(size)
			scene.arrange(size)
			let inside = page.inside
			return when inside is none
			assert inside.say("kept") == 7
			inside.take(7)
			assert toastLog.join(",") == "written kept,dismissed 7"
			scene.close()
		}
	}
}
