partial module std.ui.components {
	use (
		std.math.geom::Size
		std.ui::(KeyEvent, Limit, PointerEvent, RenderContext, Theme, UI)
		std.ui.paint
		std.ui.styles::*
		std.units::Pixels
	)

	// The style of a `ToggleButton`: a button's look while off, filled with the accent
	// while on, a step further under the pointer and while held down.
	style ToggleButtonStyle {
		ButtonStyle
		on = {
			on:             {background: new BackgroundFill(theme.palette.accent), border: controlEdge(theme.palette.accent)},
			[on, hover]:    {background: new BackgroundFill(theme.palette.accentHover), border: controlEdge(theme.palette.accentHover)},
			[on, pressed]:  {background: new BackgroundFill(theme.palette.accentPressed), border: controlEdge(theme.palette.accentPressed)},
			[on, disabled]: {background: new BackgroundFill(theme.palette.foregroundDisabled), border: controlEdge(theme.palette.foregroundDisabled)},
		}
	}

	// A button that stays down: `ToggleButton(on = bold, label = "Bold", onChange = setBold)`.
	// A click, Space or Enter turns it on or off; on, it is filled with the accent.
	component ToggleButton {
		type {
			// Whether it is on.
			@input(value = true, bind = true)
			@state
			on bool = false

			// The text on it.
			@input
			label string = ""

			// Runs with the new state when the user changes it.
			@input
			onChange ?(def(bool)) = none

			// Tells every listener its new value, after the handler ran: heard with
			// `@on(ToggleButton.changed)`.
			@emit()
			def changed(now bool) bool {
				return now
			}

			block  ?paint.TextBlock = none
			// The theme its text is drawn from.
			look Theme = UI.theme()

			def new() {
				focusable = true
				tabStop   = true
			}

			// Changes the state as a click does.
			def toggle() {
				return when disabled
				on = !on
				let tell = onChange
				tell(on) unless tell is none
				changed(on)
			}

			def current() paint.TextBlock {
				let palette = look.palette
				// On, the label is drawn on the accent, or on the fill that stands for it while
				// not enabled.
				let ink = on ?? (palette.onAccent, disabled ?? (palette.foregroundDisabled, palette.foreground))
				let made = labelBlock(block, label, style.font, style.foreground, style.paragraph, ink)
				block = made
				return made
			}

			def measure(limit Limit) Size<Pixels> {
				return current().measure(limit)
			}

			def pointer(e PointerEvent) bool {
				return pressRuns(e, style.geom, !disabled, toggle)
			}

			def key(e KeyEvent) bool {
				return false when !e.down
				return keyRuns(e, !disabled, toggle)
			}

			def render(ctx RenderContext) {
				ctx.outerShadows()
				ctx.background()
				ctx.borders()
				paint.drawBlock(ctx.draw, current(), ctx.geometry.content.toFloat(), Align{horizontal: Alignment.Center, vertical: Alignment.Center}, ctx.direction == Direction.RightToLeft, ctx.scale)
				ctx.childNodes()
				ctx.innerShadows()
			}
		}

		view {}

		style ToggleButtonStyle
	}
}
