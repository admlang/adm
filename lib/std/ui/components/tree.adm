partial module std.ui.components {
	use (
		std.math.geom::(Edges, Rect)
		std.ui::(Key, KeyEvent, PointerEvent, PointerPhase, RenderContext, themeOf)
		std.ui.runtime::(drawIcon, warn)
		std.ui.styles::*
		std.units::(Extent, Pixels)
	)

	// What a tree tells when a node opens or closes.
	struct NodeToggle<T> {
		// The node, and whether its children show now.
		content  T
		expanded bool
	}

	// The style of a `Tree`.
	style TreeStyle {
		Box
		Layout
		width = fill
		height = fill
	}

	// What takes the presses on the arrows of a tree's rows.
	internal interface NodeHost {
		// The arrow of row `index` was pressed.
		def nodePressed(index int)
	}

	// The row of one node: room for its depth, the arrow of a node that has children, then
	// what the caller draws for it.
	internal component TreeRow {
		type {
			// Which row it is.
			@input
			index int = 0

			// How many nodes are above it.
			@input
			depth int = 0

			// Whether the node has children to show, and whether they show.
			@input
			branch bool = false

			@input
			@state
			open bool = false

			arrow IconSlot = new IconSlot()

			def new() {
				role = Role.TreeItem
			}

			// How wide the arrow's square is.
			def side() float {
				return float(themeOf(self).metrics.iconSize)
			}

			// How far the arrow is from the row's start.
			def lead() float {
				return float(depth) * side()
			}

			// The room before the caller's row: the depth, the arrow and a gap.
			def before() Pixels {
				return (lead() + side() + float(themeOf(self).metrics.unit)) * 1(px)
			}

			def pointer(e PointerEvent) bool {
				return false when !branch || e.phase != PointerPhase.Down
				let x = float(e.position.x)
				x = float(style.geom.frame.width) - x when style.geom.direction == Direction.RightToLeft
				return false when x < lead() || x >= lead() + side()
				let above = parent()
				for {
					return false when above is none
					if above is NodeHost {
						above.nodePressed(index)
						return true
					}
					above = above.parent()
				}
				return false
			}

			def render(ctx RenderContext) {
				if branch {
					let rtl = ctx.direction == Direction.RightToLeft
					let mark = arrow.get(open ?? ("chevron-down", rtl ?? ("chevron-left", "chevron-right")))
					let box = frameBox(ctx)
					let wide = side()
					let at = rtl ?? (box.right - lead() - wide, lead())
					let look = themeOf(self)
					drawIcon(ctx.draw, mark, Rect{left: at, top: (box.bottom - wide) / 2.0, right: at + wide, bottom: (box.bottom + wide) / 2.0}, disabled ?? (look.palette.foregroundDisabled, look.palette.foregroundMuted)) unless mark is none
				}
				ctx.childNodes()
			}
		}

		view {
			children()
		}

		style {
			Box
			Layout
			width   = fill
			padding = new Edges<Extent>(0(px), 0(px), 0(px), self.before())
		}
	}

	// Shows nodes that hold other nodes, one row each, and scrolls them as a `List` does:
	// `Tree(roots, expand = (n Folder) => n.children) { rowRenderer = (it RowItem<Folder>) => FolderRow(it.content) }`.
	// A node that has children shows an arrow. With `leaf` the tree asks that and reads a
	// node's children (`expand`) when it first opens, so it can be far larger than what was
	// ever read; without it the children of every node that shows are read, to know. When
	// `roots` is another array, they are read again. Without `rowRenderer` a row is the
	// node as text.
	//
	// Nodes are told apart as the items of a `List` are: a node is its own identity, or
	// `id` gives one. `expanded` and `selected` hold those identities, and one identity
	// shows once: a node met again under another parent is left out.
	//
	// A press on a node's arrow opens or closes it. Right opens the node the keyboard is
	// on, or goes to its first child when it is open; Left closes it, or goes to its
	// parent. The rows are selected, moved through and opened as those of a `List`.
	component Tree<T, I = T> {
		type {
			// The nodes at the top.
			@input(value = true)
			roots T[] = []

			// A node's identity; none: the node itself. A tree whose ids are of another
			// type than its nodes must pass it.
			@input
			id ?(def(T) I) = none

			// A node's children: asked for once, when the node first opens, or, without
			// `leaf`, when it first shows.
			@input
			expand ?(def(T) T[]) = none

			// Whether a node has no children, so it gets no arrow, without reading them:
			// for a tree whose children are costly to read. None: a node's children are
			// read when it shows, and it gets an arrow when it has some.
			@input
			leaf ?(def(T) bool) = none

			// The ids of the open nodes. The tree assigns a new array when one opens or
			// closes; code that changes it passes another array too.
			@input(bind = true)
			@state
			expanded I[] = []

			// The ids of the selected rows, as on a `List`.
			@input(bind = true)
			@state
			selected I[] = []

			// How many rows can be selected.
			@input
			selection SelectionMode = SelectionMode.Single

			// The height every row has; none: each row is as high as its content.
			@input
			rowHeight ?Pixels = none

			// Draws the row of a node, after its arrow.
			@input
			rowRenderer ?(def(RowItem<T>) view) = none

			// Runs when the selection changed, with the ids now selected.
			@input
			onChange ?(def(I[])) = none

			// Tells every listener the selection changed, after the handler ran.
			@emit()
			def changed(ids I[]) I[] {
				return ids
			}

			// Runs when a row is opened: Enter, or a double click on it.
			@input
			onOpen ?(def(T)) = none

			// Tells every listener a row was opened, after the handler ran.
			@emit()
			def opened(item T) T {
				return item
			}

			// Runs when a node opened (true) or closed.
			@input
			onToggle ?(def(T, bool)) = none

			// Tells every listener a node opened or closed, after the handler ran.
			@emit()
			def toggled(item T, open bool) NodeToggle<T> {
				return NodeToggle<T>{content: item, expanded: open}
			}

			// The rows that show, top to bottom, and for each how deep it is, the row of
			// its parent (below 0: a root), and whether it has an arrow.
			rows     T[]
			depths   int[]
			parents  int[]
			branches bool[]

			// The children each node gave when it was asked, by its id.
			kids map<I, T[]>

			// The open nodes as a set, and the array it was built from with its length then.
			open     map<I, bool>
			openFrom ?I[] = none
			openSize int = -1

			// What the rows were laid out from: the roots and their number; whether
			// something changed since.
			laidFrom ?T[] = none
			laidSize int = -1
			dirty    bool = true

			// The node to scroll to once its row is there.
			sought ?I = none

			// Whether the tree said that it needs `id`, and that an id came twice.
			warned bool = false
			twice  bool = false

			def new() {
				role = Role.Tree
			}

			// The identity of a node.
			def idOf(item T) I {
				let tell = id
				return tell(item) unless tell is none
				let own any = item
				return own when own is I
				warn("Tree: `id` is needed when the ids are not the nodes") unless warned
				warned = true
				let unset I
				return unset
			}

			// The id of the row the keyboard is on.
			def current() ?I {
				let inner = list
				return none when inner is none
				return inner.current()
			}

			// The children of a node, asked for once.
			def childrenOf(item T, key I) T[] {
				return kids[key] when kids.hasKey(key)
				let ask = expand
				let found T[]
				found = ask(item) unless ask is none
				kids[key] = found
				return found
			}

			// Whether a node gets an arrow: it has children.
			def branchy(item T, key I) bool {
				let tell = leaf
				return !tell(item) unless tell is none
				return childrenOf(item, key).len() > 0
			}

			// Builds the set of the open nodes when `expanded` is another array or another
			// length than the one it was built from.
			def index() {
				let from = openFrom
				return when !(from is none) && from == expanded && openSize == expanded.len()
				open = map<I, bool>{}
				for let key in expanded {
					open[key] = true
				}
				openFrom = expanded
				openSize = expanded.len()
				dirty    = true
			}

			// Adds `nodes` and, under each that is open, its children.
			def lay(nodes T[], depth int, above int, met map<I, bool>) {
				for let node in nodes {
					let key = idOf(node)
					if met.hasKey(key) {
						warn("Tree: two nodes have one id; the second is left out") unless twice
						twice = true
						continue
					}
					met[key] = true
					let at = rows.len()
					rows.push(node)
					depths.push(depth)
					parents.push(above)
					if open.hasKey(key) {
						let under = childrenOf(node, key)
						branches.push(branchy(node, key))
						lay(under, depth + 1, at, met)
					} else {
						branches.push(branchy(node, key))
					}
				}
			}

			// The rows to show on this run of the view. They are laid out again when the
			// roots or the open nodes changed; the list then gets another array.
			def flat() T[] {
				index()
				let from = laidFrom
				if from is none || from != roots || laidSize != roots.len() {
					kids     = map<I, T[]>{}
					laidFrom = roots
					laidSize = roots.len()
					dirty    = true
				}
				return rows unless dirty
				dirty    = false
				rows     = []
				depths   = []
				parents  = []
				branches = []
				lay(roots, 0, -1, map<I, bool>{})
				return rows
			}

			// Opens or closes the node with this id and tells the caller; no more when it
			// is so already.
			def set(item T, key I, now bool) {
				index()
				return when open.hasKey(key) == now
				let one = map<I, bool>{}
				one[key] = true
				let ids I[]
				for let held in expanded {
					ids.push(held) unless one.hasKey(held)
				}
				ids.push(key) when now
				expanded = ids
				index()
				let tell = onToggle
				tell(item, now) unless tell is none
				toggled(item, now)
				redraw()
			}

			// Opens the node of row `index` when it is closed and closes it when open. The
			// keyboard goes to a node that closes over the row it was on.
			def flip(index int) {
				return when index < 0 || index >= rows.len() || !branches[index]
				let item = rows[index]
				let key = idOf(item)
				let now = !open.hasKey(key)
				let inner = list
				if !now && !(inner is none) && inner.cursorAt > index {
					let end = index + 1
					for end < rows.len() && depths[end] > depths[index] {
						end++
					}
					inner.place(index, key) when inner.cursorAt < end
				}
				set(item, key, now)
			}

			// The arrow of row `index` was pressed.
			def nodePressed(index int) {
				return when disabled
				let inner = list
				inner.focus() unless inner is none
				flip(index)
			}

			// Finds the node with this id among the nodes read so far, and notes in `path`
			// the nodes above it, the top one last.
			def find(nodes T[], sought map<I, bool>, path T[]) bool {
				for let node in nodes {
					let key = idOf(node)
					return true when sought.hasKey(key)
					continue unless kids.hasKey(key)
					if find(kids[key], sought, path) {
						path.push(node)
						return true
					}
				}
				return false
			}

			// Opens the nodes above the node with this id and scrolls so it shows. Only
			// nodes the tree has read are found: the roots, and the children of every node
			// that was opened once.
			def reveal(key I) {
				let one = map<I, bool>{}
				one[key] = true
				let path T[]
				return unless find(roots, one, path)
				for let i = path.len() - 1; i >= 0; i-- {
					set(path[i], idOf(path[i]), true)
				}
				sought = key
				redraw()
			}

			// The list selected other rows. What the list was given is a copy of
			// `selected`, so the tree's own is assigned here.
			def picked(ids I[]) {
				selected = ids
				let tell = onChange
				tell(ids) unless tell is none
				changed(ids)
			}

			def entered(item T) {
				let tell = onOpen
				tell(item) unless tell is none
				opened(item)
			}

			// Right and Left, as they come up from the rows.
			def key(e KeyEvent) bool {
				return false when !e.down || disabled
				let inner = list
				return false when inner is none
				let (forward, back) = style.geom.direction == Direction.RightToLeft ?? ((Key.Left, Key.Right), (Key.Right, Key.Left))
				return false unless e.key == forward || e.key == back
				let at = inner.cursorAt
				// The rows the list has are those laid out last.
				return false when at < 0 || at >= rows.len() || dirty
				let shown = branches[at] && open.hasKey(idOf(rows[at]))
				if e.key == forward {
					return false when !branches[at]
					if !shown {
						flip(at)
					} else if at + 1 < rows.len() && parents[at + 1] == at {
						inner.moveTo(at + 1, extend = false, toggle = false)
					}
					return true
				}
				if shown {
					flip(at)
				} else if parents[at] >= 0 {
					inner.moveTo(parents[at], extend = false, toggle = false)
				}
				return true
			}

			// The row of one node, around what the caller draws for it.
			def row(it RowItem<T>) view {
				let at = it.index
				let inside = at < rows.len()
				let deep = inside ?? (depths[at], 0)
				let more = inside && branches[at]
				let shown = more && open.hasKey(idOf(it.content))
				return view {
					TreeRow(index = at, depth = deep, branch = more, open = shown) {
						let make = rowRenderer
						if make is none {
							Text("{it.content}")
						} else {
							make(RowItem<T>{content: it.content, index: at, selected: it.selected, current: it.current, depth: deep, expanded: shown})
						}
					}
				}
			}

			def render(ctx RenderContext) {
				ctx.childNodes()
				// The list has the row of a revealed node once its own view ran.
				let key = sought
				let inner = list
				if !(key is none) && !(inner is none) && !dirty {
					sought = none
					inner.reveal(key)
				}
			}
		}

		view {
			List(flat(), id = id, selected = selected, selection = selection, rowHeight = rowHeight, rowRenderer = row, onChange = picked, onOpen = entered, ref = list)
		}

		style TreeStyle
	}
}
