partial module std.ui.components {
	use (
		std.math.geom::(Edges, Rect)
		std.time
		std.ui::(Key, KeyEvent, PointerEvent, PointerPhase, RenderContext, themeOf)
		std.ui.frames
		std.ui.runtime::(drawIcon, warn)
		std.ui.styles::*
		std.units::(Extent, Pixels)
	)

	// What a tree tells when a node opens or closes.
	struct NodeToggle<T> {
		// The node, and whether its children show now.
		content  T
		expanded bool
	}

	// The style of a `Tree`.
	style TreeStyle {
		Box
		Layout
		width = fill
		height = fill
	}

	// What takes the presses on the arrows of a tree's rows.
	internal interface NodeHost {
		// The arrow of row `index` was pressed.
		def nodePressed(index int)
	}

	// The row of one node: room for its depth, the arrow of a node that has children, then
	// what the caller draws for it.
	internal component TreeRow {
		type {
			// Which row it is.
			@input
			index int = 0

			// How many nodes are above it.
			@input
			depth int = 0

			// Whether the node has children to show, and whether they show.
			@input
			branch bool = false

			@input
			@state
			open bool = false

			// Whether its children are being read: a spinner takes the arrow's place.
			@input
			loading bool = false

			arrow IconSlot = new IconSlot()
			started time.Time = time.now()

			def new() {
				role = Role.TreeItem
			}

			// How wide the arrow's square is.
			def side() float {
				return float(themeOf(self).metrics.iconSize)
			}

			// How far the arrow is from the row's start.
			def lead() float {
				return float(depth) * side()
			}

			// The room before the caller's row: the depth, the arrow and a gap.
			def before() Pixels {
				return (lead() + side() + float(themeOf(self).metrics.unit)) * 1(px)
			}

			def pointer(e PointerEvent) bool {
				return false when !branch || e.phase != PointerPhase.Down
				let x = float(e.position.x)
				x = float(style.geom.frame.width) - x when style.geom.direction == Direction.RightToLeft
				return false when x < lead() || x >= lead() + side()
				let above = parent()
				for {
					return false when above is none
					if above is NodeHost {
						above.nodePressed(index)
						return true
					}
					above = above.parent()
				}
				return false
			}

			def render(ctx RenderContext) {
				if branch {
					let rtl = ctx.direction == Direction.RightToLeft
					let box = frameBox(ctx)
					let wide = side()
					let at = rtl ?? (box.right - lead() - wide, lead())
					let look = themeOf(self)
					let place = Rect{left: at, top: (box.bottom - wide) / 2.0, right: at + wide, bottom: (box.bottom + wide) / 2.0}
					if loading {
						drawSpinner(ctx, place, look, started)
					} else {
						let mark = arrow.get(open ?? ("chevron-down", rtl ?? ("chevron-left", "chevron-right")))
						drawIcon(ctx.draw, mark, place, disabled ?? (look.palette.foregroundDisabled, look.palette.foregroundMuted)) unless mark is none
					}
				}
				ctx.childNodes()
			}
		}

		view {
			children()
		}

		style {
			Box
			Layout
			width   = fill
			padding = new Edges<Extent>(0(px), 0(px), 0(px), self.before())
		}
	}

	// Shows nodes that hold other nodes, one row each, and scrolls them as a `List` does:
	// `Tree(roots, expand = (n Folder) => n.children) { rowRenderer = (it RowItem<Folder>) => FolderRow(it.content) }`.
	// A node that has children shows an arrow. With `leaf` the tree asks that and reads a
	// node's children (`expand`) when it first opens, so it can be far larger than what was
	// ever read; without it the children of every node that shows are read, to know. When
	// `roots` is another array, they are read again. Without `rowRenderer` a row is the
	// node as text.
	//
	// Nodes are told apart as the items of a `List` are: a node is its own identity, or
	// `id` gives one. `expanded` and `selected` hold those identities, and one identity
	// shows once: a node met again under another parent is left out. `reread(ids)` asks
	// the named nodes for their children again when a folder changed, without reading
	// the rest.
	//
	// A press on a node's arrow opens or closes it. Right opens the node the keyboard is
	// on, or goes to its first child when it is open; Left closes it, or goes to its
	// parent. The rows are selected, moved through and opened as those of a `List`.
	component Tree<T, I = T> {
		type {
			// The nodes at the top.
			@input(value = true)
			roots T[] = []

			// A node's identity; none: the node itself. A tree whose ids are of another
			// type than its nodes must pass it.
			@input
			id ?(def(T) I) = none

			// A node's children: asked for once, when the node first opens, or, without
			// `leaf`, when it first shows.
			@input
			expand ?(def(T) T[]) = none

			// A node's children read on a task of the tree's own, when the node first
			// opens, for a lister that is slow (a folder of many entries, a database, the
			// network); `expand` is then not called, and a node not read yet has an arrow
			// unless `leaf` says otherwise. The row shows a spinner in place of its arrow
			// until the children arrive; a lister that fails leaves the node with none
			// and reports the failure with the frame's warnings.
			@input
			expandLater ?(def(T) !T[]) = none

			// Whether a node has no children, so it gets no arrow, without reading them:
			// for a tree whose children are costly to read. None: a node's children are
			// read when it shows, and it gets an arrow when it has some.
			@input
			leaf ?(def(T) bool) = none

			// The ids of the open nodes. The tree assigns a new array when one opens or
			// closes; code that changes it passes another array too.
			@input(bind = true)
			@state
			expanded I[] = []

			// The ids of the selected rows, as on a `List`.
			@input(bind = true)
			@state
			selected I[] = []

			// How many rows can be selected.
			@input
			selection SelectionMode = SelectionMode.Single

			// The height every row has; none: each row is as high as its content.
			@input
			rowHeight ?Pixels = none

			// Draws the row of a node, after its arrow.
			@input
			rowRenderer ?(def(RowItem<T>) view) = none

			// Which nodes are section headers that never leave the view, as `List.sticky`
			// has it: held at the top once scrolled past, at the bottom while below,
			// stacked there in row order, a line above each but the first; a held
			// header's arrow opens and closes it.
			@input
			sticky ?(def(T) bool) = none

			// Which headers draw the line, as `List.divided` has it; none: every header
			// but the first.
			@input
			divided ?(def(T) bool) = none

			// Runs when the selection changed, with the ids now selected.
			@input
			onChange ?(def(I[])) = none

			// Tells every listener the selection changed, after the handler ran.
			@emit()
			def changed(ids I[]) I[] {
				return ids
			}

			// Runs when a row is opened: Enter, or a double click on it.
			@input
			onOpen ?(def(T)) = none

			// Tells every listener a row was opened, after the handler ran.
			@emit()
			def opened(item T) T {
				return item
			}

			// Runs when a node opened (true) or closed.
			@input
			onToggle ?(def(T, bool)) = none

			// Tells every listener a node opened or closed, after the handler ran.
			@emit()
			def toggled(item T, open bool) NodeToggle<T> {
				return NodeToggle<T>{content: item, expanded: open}
			}

			// Which nodes the user can drag, once `onMove` is set; none: every node.
			@input
			movable ?(def(T) bool) = none

			// Whether the dragged nodes may go where the pointer is, before, after or
			// inside the node there (`RowPlace`), asked as the pointer moves: a place
			// refused shows no mark and takes no drop. The tree itself refuses a drop
			// into the subtree of a dragged node. None: every other place.
			@input
			accepts ?(def(RowDrop<T>) bool) = none

			// Runs when nodes dragged with the pointer are let go of on another node:
			// with the dragged nodes in row order (the selection when a selected row was
			// dragged, else that node alone), the node the pointer is on and the place
			// against it. The tree moves nothing itself: the caller changes its nodes
			// and passes other `roots`. A drag that rests on a closed node with the drop
			// inside it opens the node; near the top or bottom of the rows, they scroll.
			// Unset: nodes are not dragged.
			@input
			onMove ?(def(RowDrop<T>)) = none

			// Tells every listener nodes were dragged to another place, after the handler
			// ran.
			@emit()
			def moved(drop RowDrop<T>) RowDrop<T> {
				return drop
			}

			// The rows that show, top to bottom, and for each how deep it is, the row of
			// its parent (below 0: a root), and whether it has an arrow.
			rows     T[]
			depths   int[]
			parents  int[]
			branches bool[]

			// The children each node gave when it was asked, by its id, and the node
			// each id names among those asked.
			kids  map<I, T[]>
			known map<I, T>

			// The nodes whose children a task of the tree's is reading, and what the
			// tasks brought that the next layout takes; `again` names those read again
			// by `reread`, whose rows keep their children meanwhile.
			pending map<I, bool>
			again   map<I, bool>
			@state
			arrivedKeys I[] = []
			@state
			arrivedKids T[][] = []

			// The open nodes as a set, and the array it was built from with its length then.
			open     map<I, bool>
			openFrom ?I[] = none
			openSize int = -1

			// What the rows were laid out from: the roots and their number; whether
			// something changed since.
			laidFrom ?T[] = none
			laidSize int = -1
			dirty    bool = true

			// The node to scroll to once its row is there.
			sought ?I = none

			// The ids on the way to a node `revealPath` was given, the node's own last;
			// empty: none.
			way I[] = []

			// Whether the tree said that it needs `id`, and that an id came twice.
			warned bool = false
			twice  bool = false

			def new() {
				role = Role.Tree
			}

			// The identity of a node.
			def idOf(item T) I {
				let tell = id
				return tell(item) unless tell is none
				let own any = item
				return own when own is I
				warn("Tree: `id` is needed when the ids are not the nodes") unless warned
				warned = true
				let unset I
				return unset
			}

			// The id of the row the keyboard is on.
			def current() ?I {
				let inner = list
				return none when inner is none
				return inner.current()
			}

			// The children of a node, asked for once; none yet while a task reads them.
			def childrenOf(item T, key I) T[] {
				known[key] = item
				return kids[key] when kids.hasKey(key)
				let later = expandLater
				if !(later is none) {
					if !pending.hasKey(key) {
						pending[key] = true
						async<tasks> read(item, key, later)
					}
					return []
				}
				let ask = expand
				let found T[]
				found = ask(item) unless ask is none
				kids[key] = found
				return found
			}

			// Reads a node's children on a task of the tree's and hands them to the next
			// layout.
			async def read(item T, key I, lister def(T) !T[]) {
				let got T[] = []
				got = lister(item) onerror (err error) {
					warn("Tree: the children of a node could not be read: {err.message}")
					recover got
				}
				arrivedKeys.push(key)
				arrivedKids.push(got)
				// The next frame runs the view, which lays the children out; a
				// `redraw()` would be lost when the view is running as they arrive.
				let me component = self
				frames.askRebuild(me)
			}

			// Takes what the reading tasks brought since the last layout: a node read
			// again loses the children no longer among the new ones, with all under
			// them.
			def arrivals() {
				return when arrivedKeys.len() == 0
				for let (i, key) in arrivedKeys {
					let fresh = arrivedKids[i]
					if again.hasKey(key) {
						again.delete(key)
						dropGone(key, fresh)
					}
					kids[key] = fresh
					pending.delete(key)
				}
				arrivedKeys = []
				arrivedKids = []
				dirty       = true
				walk()
			}

			// Forgets the children of `key` that are not among `fresh`, and everything
			// read under them.
			def dropGone(key I, fresh T[]) {
				return unless kids.hasKey(key)
				let kept = map<I, bool>{}
				for let node in fresh {
					kept[idOf(node)] = true
				}
				for let node in kids[key] {
					let id = idOf(node)
					forget(id) unless kept.hasKey(id)
				}
			}

			// Forgets what was read for the node with this id and for every node under it.
			def forget(key I) {
				if kids.hasKey(key) {
					for let node in kids[key] {
						forget(idOf(node))
					}
					kids.delete(key)
				}
				known.delete(key)
				pending.delete(key)
				again.delete(key)
			}

			// Reads the children of the nodes with these ids again, for a folder whose
			// files changed: with `expandLater` on a task of the tree's while the old
			// children keep showing (no spinner), the new ones taking their place when
			// they arrive; with `expand` at once. The open and selected nodes still
			// there stay so; a node gone from the new children leaves the rows with
			// everything under it. An id whose children were never read does nothing,
			// as does one a task is reading.
			def reread(ids I[]) {
				let ask = expand
				let later = expandLater
				let changed = false
				for let key in ids {
					continue unless kids.hasKey(key) && known.hasKey(key)
					continue when pending.hasKey(key)
					let node = known[key]
					if !(later is none) {
						pending[key] = true
						again[key] = true
						async<tasks> read(node, key, later)
						continue
					}
					continue when ask is none
					let fresh = ask(node)
					dropGone(key, fresh)
					kids[key] = fresh
					changed = true
				}
				return unless changed
				dirty = true
				let me component = self
				frames.askRebuild(me)
			}

			// Whether a node gets an arrow: it has children, or is not read yet.
			def branchy(item T, key I) bool {
				let tell = leaf
				return !tell(item) unless tell is none
				return true when !(expandLater is none) && !kids.hasKey(key)
				return childrenOf(item, key).len() > 0
			}

			// Builds the set of the open nodes when `expanded` is another array or another
			// length than the one it was built from.
			def index() {
				let from = openFrom
				return when !(from is none) && from == expanded && openSize == expanded.len()
				open = map<I, bool>{}
				for let key in expanded {
					open[key] = true
				}
				openFrom = expanded
				openSize = expanded.len()
				dirty    = true
			}

			// Adds `nodes` and, under each that is open, its children.
			def lay(nodes T[], depth int, above int, met map<I, bool>) {
				for let node in nodes {
					let key = idOf(node)
					if met.hasKey(key) {
						warn("Tree: two nodes have one id; the second is left out") unless twice
						twice = true
						continue
					}
					met[key] = true
					let at = rows.len()
					rows.push(node)
					depths.push(depth)
					parents.push(above)
					if open.hasKey(key) {
						let under = childrenOf(node, key)
						branches.push(branchy(node, key))
						lay(under, depth + 1, at, met)
					} else {
						branches.push(branchy(node, key))
					}
				}
			}

			// The rows to show on this run of the view. They are laid out again when the
			// roots or the open nodes changed; the list then gets another array.
			def flat() T[] {
				index()
				arrivals()
				let from = laidFrom
				if from is none || from != roots || laidSize != roots.len() {
					kids     = map<I, T[]>{}
					known    = map<I, T>{}
					pending  = map<I, bool>{}
					again    = map<I, bool>{}
					laidFrom = roots
					laidSize = roots.len()
					dirty    = true
				}
				return rows unless dirty
				dirty    = false
				rows     = []
				depths   = []
				parents  = []
				branches = []
				lay(roots, 0, -1, map<I, bool>{})
				return rows
			}

			// Opens or closes the node with this id and tells the caller; no more when it
			// is so already.
			def set(item T, key I, now bool) {
				index()
				return when open.hasKey(key) == now
				let one = map<I, bool>{}
				one[key] = true
				let ids I[]
				for let held in expanded {
					ids.push(held) unless one.hasKey(held)
				}
				ids.push(key) when now
				expanded = ids
				index()
				let tell = onToggle
				tell(item, now) unless tell is none
				toggled(item, now)
				redraw()
			}

			// Opens the node of row `index` when it is closed and closes it when open. The
			// keyboard goes to a node that closes over the row it was on.
			def flip(index int) {
				return when index < 0 || index >= rows.len() || !branches[index]
				let item = rows[index]
				let key = idOf(item)
				let now = !open.hasKey(key)
				let inner = list
				if !now && !(inner is none) && inner.cursorAt > index {
					let end = index + 1
					for end < rows.len() && depths[end] > depths[index] {
						end++
					}
					inner.place(index, key) when inner.cursorAt < end
				}
				set(item, key, now)
			}

			// The arrow of row `index` was pressed.
			def nodePressed(index int) {
				return when disabled
				let inner = list
				inner.focus() unless inner is none
				flip(index)
			}

			// Gives the keyboard to its rows: the list takes the focus, as a press on a
			// row does, so a caller can put the keys back on the tree (after a filter
			// field is left, a dialog closed).
			def focus() {
				let inner = list
				inner.focus() unless inner is none
			}

			// Finds the node with this id among the nodes read so far, and notes in `path`
			// the nodes above it, the top one last.
			def find(nodes T[], sought map<I, bool>, path T[]) bool {
				for let node in nodes {
					let key = idOf(node)
					return true when sought.hasKey(key)
					continue unless kids.hasKey(key)
					if find(kids[key], sought, path) {
						path.push(node)
						return true
					}
				}
				return false
			}

			// Opens the nodes above the node with this id and scrolls so it shows. Only
			// nodes the tree has read are found: the roots, and the children of every node
			// that was opened once.
			def reveal(key I) {
				let one = map<I, bool>{}
				one[key] = true
				let path T[]
				return unless find(roots, one, path)
				for let i = path.len() - 1; i >= 0; i-- {
					set(path[i], idOf(path[i]), true)
				}
				sought = key
				redraw()
			}

			// Opens the nodes on the way from a root down to the node with the last of
			// `ids` and scrolls so it shows, for a node under nodes not read yet (a file
			// deep in folders never opened, with `expandLater`): a node whose children a
			// task is reading is waited for, and the way goes on when they arrive. An id
			// that is not among its parent's children ends the way quietly. A later call
			// replaces the way.
			def revealPath(ids I[]) {
				way = ids
				walk()
			}

			// Follows `way` as far as the read nodes go, opening each node on it; the
			// last reached scrolls to it. Stops at a node whose children are being read
			// (`childrenOf` started it), to go on from `arrivals`.
			def walk() {
				return when way.len() == 0
				let tier = roots
				for let (i, key) in way {
					let node = among(tier, key)
					if node is none {
						way = []
						return
					}
					if i == way.len() - 1 {
						way    = []
						sought = key
						redraw()
						return
					}
					set(node, key, true)
					tier = childrenOf(node, key)
					return unless kids.hasKey(key)
				}
			}

			// The node with this id among `nodes`; none when it is not there.
			def among(nodes T[], key I) ?T {
				for let node in nodes {
					return node when idOf(node) == key
				}
				return none
			}

			// The list selected other rows. What the list was given is a copy of
			// `selected`, so the tree's own is assigned here.
			def picked(ids I[]) {
				selected = ids
				let tell = onChange
				tell(ids) unless tell is none
				changed(ids)
			}

			def entered(item T) {
				let tell = onOpen
				tell(item) unless tell is none
				opened(item)
			}

			// Right and Left, as they come up from the rows.
			def key(e KeyEvent) bool {
				return false when !e.down || disabled
				let inner = list
				return false when inner is none
				let (forward, back) = style.geom.direction == Direction.RightToLeft ?? ((Key.Left, Key.Right), (Key.Right, Key.Left))
				return false unless e.key == forward || e.key == back
				let at = inner.cursorAt
				// The rows the list has are those laid out last.
				return false when at < 0 || at >= rows.len() || dirty
				let shown = branches[at] && open.hasKey(idOf(rows[at]))
				if e.key == forward {
					return false when !branches[at]
					if !shown {
						flip(at)
					} else if at + 1 < rows.len() && parents[at + 1] == at {
						inner.moveTo(at + 1, extend = false, toggle = false)
					}
					return true
				}
				if shown {
					flip(at)
				} else if parents[at] >= 0 {
					inner.moveTo(parents[at], extend = false, toggle = false)
				}
				return true
			}

			// Whether rows `items` may go to `place` against row `target`: not into the
			// subtree of one of them (the row itself the list refuses).
			def dropAllowed(items int[], target int, place RowPlace) bool {
				return false when dirty || target < 0 || target >= rows.len()
				let above = parents[target]
				for above >= 0 {
					return false when items.includes(above)
					above = parents[above]
				}
				return true
			}

			// Where the content of row `index` starts: after its depth and its arrow.
			def dropLead(index int) float {
				return 0.0 when index < 0 || index >= depths.len()
				let look = themeOf(self)
				let side = float(look.metrics.iconSize)
				return float(depths[index]) * side + side + float(look.metrics.unit)
			}

			// A drag rested on row `index` with the drop inside it: a closed node opens,
			// and the next frame lays its children out.
			def dragRested(index int) {
				return when index < 0 || index >= rows.len() || !branches[index] || open.hasKey(idOf(rows[index]))
				flip(index)
				frames.askFrame(true)
			}

			// The drop handler the list gets: none without `onMove`, so that nothing is
			// dragged.
			def mover() ?(def(RowDrop<T>)) {
				return none when onMove is none
				return dropped
			}

			def dropped(drop RowDrop<T>) {
				let tell = onMove
				tell(drop) unless tell is none
				moved(drop)
			}

			// The row of one node, around what the caller draws for it.
			def row(it RowItem<T>) view {
				let at = it.index
				let inside = at < rows.len()
				let deep = inside ?? (depths[at], 0)
				let more = inside && branches[at]
				let shown = more && open.hasKey(idOf(it.content))
				// A node read again keeps its rows and shows no spinner meanwhile.
				let waiting = shown && pending.hasKey(idOf(it.content)) && !again.hasKey(idOf(it.content))
				return view {
					TreeRow(index = at, depth = deep, branch = more, open = shown, loading = waiting) {
						let make = rowRenderer
						if make is none {
							Text("{it.content}")
						} else {
							make(RowItem<T>{content: it.content, index: at, selected: it.selected, current: it.current, depth: deep, expanded: shown, docked: it.docked})
						}
					}
				}
			}

			def render(ctx RenderContext) {
				ctx.childNodes()
				// The list has the row of a revealed node once its own view ran.
				let key = sought
				let inner = list
				if !(key is none) && !(inner is none) && !dirty {
					sought = none
					inner.reveal(key)
				}
			}
		}

		view {
			List(flat(), id = id, selected = selected, selection = selection, rowHeight = rowHeight, rowRenderer = row, sticky = sticky, divided = divided, movable = movable, accepts = accepts, onChange = picked, onOpen = entered, onMove = mover(), ref = list)
		}

		style TreeStyle
	}
}
