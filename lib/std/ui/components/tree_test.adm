partial module std.ui.components {
	use (
		std.gfx.canvas
		std.math.geom::(Point, Size)
		std.testing
		std.time
		std.ui::(Key, KeyEvent, PointerPhase, themeOf)
		std.ui.runtime::Scene
		std.ui.styles::*
		std.units::Pixels
	)

	internal let treeLog = string[]

	// A node told from another by being that object.
	type Branch {
		name  string   = ""
		under Branch[] = []
		// How many times its children were asked for.
		asked int      = 0

		def new(name string, under Branch[] = []) {
			self.name = name
			self.under = under
		}
	}

	// src (a, b (deep)) and docs (guide), in rows 20 high.
	component BranchesPage {
		type {
			@bindable
			open string[] = []

			@bindable
			picked string[] = []

			tops Branch[] = []

			def new() {
				style.width = 200(px)
				style.height = 100(px)
				tops = [
					new Branch("src", [new Branch("a"), new Branch("b", [new Branch("deep")])]),
					new Branch("docs", [new Branch("guide")]),
				]
			}

			def named(node Branch) string {
				return node.name
			}

			def below(node Branch) Branch[] {
				node.asked++
				return node.under
			}

			def flipped(node Branch, now bool) {
				treeLog.push("{node.name} {now}")
			}

			def shown(node Branch) {
				treeLog.push("opened {node.name}")
			}
		}

		view {
			Tree(tops, id = named, expand = below, expanded = open, selected = picked, rowHeight = 20(px), onToggle = flipped, onOpen = shown, ref = tree) {
				rowRenderer = (it RowItem<Branch>) => Text("{it.content.name} {it.depth} {it.expanded}")
			}
		}

		style StageStyle
	}

	// src (a, b (deep)) and docs (guide), whose rows are dragged: "src" stays where it
	// is, and nothing goes inside a node that holds nothing.
	component MovableTreePage {
		type {
			@bindable
			open string[] = ["src"]

			@bindable
			picked string[] = []

			tops Branch[] = []

			def new() {
				style.width = 200(px)
				style.height = 200(px)
				tops = [
					new Branch("src", [new Branch("a"), new Branch("b", [new Branch("deep")])]),
					new Branch("docs", [new Branch("guide")]),
				]
			}

			def named(node Branch) string {
				return node.name
			}

			def below(node Branch) Branch[] {
				return node.under
			}

			def loose(node Branch) bool {
				return node.name != "src"
			}

			def takes(drop RowDrop<Branch>) bool {
				return drop.place != RowPlace.Inside || drop.target.under.len() > 0
			}

			def dropped(drop RowDrop<Branch>) {
				let names string[]
				for let node in drop.items {
					names.push(node.name)
				}
				treeLog.push("{names.join(",")} {drop.place} {drop.target.name}")
			}
		}

		view {
			Tree(tops, id = named, expand = below, expanded = open, selected = picked, selection = SelectionMode.Multiple, rowHeight = 20(px), movable = loose, accepts = takes, onMove = dropped, ref = tree) {
				rowRenderer = (it RowItem<Branch>) => Text("{it.content.name}")
			}
		}

		style StageStyle
	}

	// Words that are their own identity, each holding the same word with a mark more; a
	// word of five letters holds nothing.
	component WordsPage {
		type {
			@bindable
			open string[] = []

			words string[] = ["x", "y"]

			def new() {
				style.width = 200(px)
				style.height = 100(px)
			}

			def longer(word string) string[] {
				return ["{word}1", "{word}2"]
			}

			def last(word string) bool {
				return word.len() >= 3
			}
		}

		view {
			Tree(words, expand = longer, leaf = last, expanded = open, rowHeight = 20(px), ref = tree)
		}

		style StageStyle
	}

	// Branches read by a slow lister on a task of the tree's: a node of five
	// children, one that fails.
	component LaterPage {
		type {
			@bindable
			open string[] = []

			tops Branch[] = []

			// How many children the lister gives a node.
			count int = 5

			def new() {
				style.width = 200(px)
				style.height = 200(px)
				tops = [new Branch("slow"), new Branch("broken")]
			}

			def named(node Branch) string {
				return node.name
			}

			def later(node Branch) !Branch[] {
				node.asked++
				time.sleep(40ms)
				fail "the disk went away" when node.name == "broken"
				let under Branch[] = []
				for let i = 0; i < count; i++ {
					under.push(new Branch("{node.name}{i}"))
				}
				return under
			}
		}

		view {
			Tree(tops, id = named, expandLater = later, expanded = open, rowHeight = 20(px), ref = tree) {
				rowRenderer = (it RowItem<Branch>) => Text("{it.content.name}")
			}
		}

		style StageStyle
	}

	// A lazy tree built with a node already open.
	component PresetPage {
		type {
			@bindable
			open string[] = ["slow"]

			tops Branch[] = []

			def new() {
				style.width = 200(px)
				style.height = 200(px)
				tops = [new Branch("slow"), new Branch("other")]
			}

			def named(node Branch) string {
				return node.name
			}

			def notLeaf(node Branch) bool {
				return false
			}

			def later(node Branch) !Branch[] {
				node.asked++
				time.sleep(20ms)
				return [new Branch("{node.name}0"), new Branch("{node.name}1")]
			}
		}

		view {
			Tree(tops, id = named, expandLater = later, leaf = notLeaf, expanded = open, rowHeight = 20(px), ref = tree) {
				rowRenderer = (it RowItem<Branch>) => Text("{it.content.name}")
			}
		}

		style StageStyle
	}

	check "Tree" {
		// Nodes are dragged as the rows of a list are, with a third place: the middle
		// of a row drops inside its node, which the tree refuses for a dragged node's
		// own subtree and the caller's `accepts` for a node that holds nothing (the
		// nearer edge is taken then). A drag that rests on a closed node with the drop
		// inside it opens the node. The tree moves nothing itself.
		@test()
		def TestTreeDragsNodes() {
			treeLog = string[]
			let page = MovableTreePage()
			let scene = new Scene(page)
			let size = new Size<Pixels>(200(px), 200(px))
			scene.arrange(size)
			scene.arrange(size)
			let tree = page.tree
			assert !(tree is none)
			return when tree is none
			let list = tree.list
			assert !(list is none)
			return when list is none
			let port = list.port
			assert !(port is none)
			return when port is none
			// Rows: src, a, b, docs.
			assert textOf(port) == "src,a,b,docs"
			let at = def (row int, part float) Point<Pixels> {
				return new Point<Pixels>(150(px), (float(row) * 20.0 + 20.0 * part) * 1(px))
			}
			// "a" into the middle of "b": inside it, with the drop line indented by the
			// row's depth.
			scene.pointer(PointerPhase.Down, at(1, 0.5))
			scene.pointer(PointerPhase.Move, at(2, 0.5))
			assert list.inDrag && list.dropAt == 2 && list.dropPlace == RowPlace.Inside
			assert tree.dropLead(2) > tree.dropLead(0) && tree.dropLead(0) > 0.0
			// Drawn with the mark of the drop inside the row.
			scene.paint(new canvas.Canvas(200, 200))
			// Onto the upper third of "docs": before it.
			scene.pointer(PointerPhase.Move, at(3, 0.1))
			assert list.dropAt == 3 && list.dropPlace == RowPlace.Before
			scene.pointer(PointerPhase.Up, at(3, 0.1))
			assert treeLog.join(";") == "a Before docs" && textOf(port) == "src,a,b,docs"
			// "src" is not movable; "b" dragged goes nowhere in its own subtree: not
			// before "deep" once it shows.
			scene.pointer(PointerPhase.Down, at(0, 0.5))
			scene.pointer(PointerPhase.Move, at(3, 0.5))
			assert !list.inDrag
			scene.pointer(PointerPhase.Up, at(3, 0.5))
			page.open = ["src", "b"]
			scene.arrange(size)
			scene.arrange(size)
			assert textOf(port) == "src,a,b,deep,docs"
			scene.pointer(PointerPhase.Down, at(2, 0.5))
			scene.pointer(PointerPhase.Move, at(3, 0.2))
			assert list.inDrag && list.dropAt < 0
			// The middle of "a", which holds nothing: the nearer edge, after it.
			scene.pointer(PointerPhase.Move, at(1, 0.6))
			assert list.dropAt == 1 && list.dropPlace == RowPlace.After
			// Rested on closed "docs" with the drop inside it, the node opens.
			scene.pointer(PointerPhase.Move, at(4, 0.5))
			assert list.dropAt == 4 && list.dropPlace == RowPlace.Inside
			let now = time.now()
			list.tick(now)
			assert page.open.join(",") == "src,b"
			list.tick(now + 1s)
			assert page.open.join(",") == "src,b,docs"
			scene.arrange(size)
			scene.arrange(size)
			assert textOf(port) == "src,a,b,deep,docs,guide"
			scene.pointer(PointerPhase.Up, at(4, 0.5))
			assert treeLog.len() == 2 && treeLog[1] == "b Inside docs"
			scene.close()
		}

		// A node open when the tree is built has its children read by `expandLater`
		// as soon as it is laid out; the rows after it keep their own depth meanwhile.
		@test()
		def TestTreeReadsPresetOpenNodes() !none {
			let page = PresetPage()
			let scene = new Scene(page)
			let size = new Size<Pixels>(200(px), 200(px))
			scene.arrange(size)
			scene.arrange(size)
			let tree = page.tree
			return none when tree is none
			let list = tree.list
			return none when list is none
			let port = list.port
			return none when port is none
			// The children come from the tree's task; the row shows `loading` until
			// then.
			for let i = 0; i < 200 && textOf(port) != "slow,slow0,slow1,other"; i++ {
				time.sleep(5ms)
				scene.arrange(size)
			}
			assert textOf(port) == "slow,slow0,slow1,other"
			let rows = nodesOf(port)
			assert rows[0].open && !rows[0].loading && rows[0].depth == 0
			assert rows[1].depth == 1 && rows[2].depth == 1 && rows[3].depth == 0
			assert page.tops[0].asked == 1
			scene.close()
			return none
		}

		// A lister given as `expandLater` runs on a task when a node opens: the row
		// shows a spinner until the children arrive, which the next frame lays out; a
		// lister that fails leaves the node empty and is reported with the frame.
		@test()
		def TestTreeReadsChildrenLater() !none {
			let page = LaterPage()
			let scene = new Scene(page)
			let size = new Size<Pixels>(200(px), 200(px))
			scene.arrange(size)
			scene.arrange(size)
			let tree = page.tree
			assert !(tree is none)
			return none when tree is none
			let list = tree.list
			assert !(list is none)
			return none when list is none
			let port = list.port
			assert !(port is none)
			return none when port is none
			// Not read yet: arrows, and nothing asked.
			assert textOf(port) == "slow,broken"
			let rows = nodesOf(port)
			assert rows[0].branch && rows[1].branch && page.tops[0].asked == 0

			page.open = ["slow", "broken"]
			let warnings = scene.arrange(size)
			rows = nodesOf(port)
			assert rows[0].open
			// In a suite the tasks run as they are started, so the children are
			// there by the next frame; in a window the rows show `loading` until then.
			time.sleep(200ms)
			warnings.push(...scene.arrange(size))
			warnings.push(...scene.arrange(size))
			assert textOf(port) == "slow,slow0,slow1,slow2,slow3,slow4,broken"
			rows = nodesOf(port)
			assert !rows[0].loading && !rows[6].loading && !rows[6].branch
			assert page.tops[0].asked == 1 && page.tops[1].asked == 1
			let reported = 0
			for let line in warnings {
				reported++ when line.contains("the disk went away")
			}
			assert reported == 1
			scene.close()
			return none
		}

		// `reread` asks the named nodes for their children again and nothing else: a
		// node added shows, a node gone leaves with what was read under it, an id never
		// read does nothing.
		@test()
		def TestTreeRereadsNodesAtOnce() {
			let page = BranchesPage()
			page.open = ["src"]
			let scene = new Scene(page)
			let size = new Size<Pixels>(200(px), 100(px))
			scene.arrange(size)
			scene.arrange(size)
			let tree = page.tree
			assert !(tree is none)
			return when tree is none
			let list = tree.list
			assert !(list is none)
			return when list is none
			let port = list.port
			assert !(port is none)
			return when port is none
			assert textOf(port) == "src 0 true,a 1 false,b 1 false,docs 0 false"
			let (src, docs) = (page.tops[0], page.tops[1])
			let (srcAsked, docsAsked) = (src.asked, docs.asked)
			assert tree.kids.hasKey("b")

			src.under.push(new Branch("c"))
			tree.reread(["src", "nowhere"])
			scene.arrange(size)
			scene.arrange(size)
			assert textOf(port) == "src 0 true,a 1 false,b 1 false,c 1 false,docs 0 false"
			assert src.asked == srcAsked + 1 && docs.asked == docsAsked

			// "b" goes with what was read under it; "a" stays.
			src.under = [src.under[0], src.under[2]]
			tree.reread(["src"])
			scene.arrange(size)
			scene.arrange(size)
			assert textOf(port) == "src 0 true,a 1 false,c 1 false,docs 0 false"
			assert !tree.kids.hasKey("b") && tree.kids.hasKey("src")
			scene.close()
		}

		// With `expandLater`, `reread` reads on a task while the old children keep
		// showing without a spinner, then the new ones take their place.
		@test()
		def TestTreeRereadsNodesLater() !none {
			let page = LaterPage()
			page.open = ["slow"]
			let scene = new Scene(page)
			let size = new Size<Pixels>(200(px), 200(px))
			scene.arrange(size)
			scene.arrange(size)
			let tree = page.tree
			return none when tree is none
			let list = tree.list
			return none when list is none
			let port = list.port
			return none when port is none
			time.sleep(200ms)
			scene.arrange(size)
			scene.arrange(size)
			assert textOf(port) == "slow,slow0,slow1,slow2,slow3,slow4,broken"
			let slow = page.tops[0]
			assert slow.asked == 1

			page.count = 3
			tree.reread(["slow"])
			scene.arrange(size)
			// The old children stay, and the arrow shows no spinner.
			let rows = nodesOf(port)
			assert textOf(port) == "slow,slow0,slow1,slow2,slow3,slow4,broken" || textOf(port) == "slow,slow0,slow1,slow2,broken"
			assert !rows[0].loading
			time.sleep(200ms)
			scene.arrange(size)
			scene.arrange(size)
			assert textOf(port) == "slow,slow0,slow1,slow2,broken"
			assert slow.asked == 2
			scene.close()
			return none
		}

		// The rows of a tree as mounted now, top to bottom.
		def nodesOf(port component) TreeRow[] {
			let rows TreeRow[]
			for let child in port.childNodes {
				continue unless child is ListRow
				let inside = child.childNodes[0]
				rows.push(inside) when inside is TreeRow
			}
			return rows
		}

		// What the mounted rows say, joined with commas.
		def textOf(port component) string {
			let said string[]
			for let row in nodesOf(port) {
				let label = row.childNodes[0]
				said.push(label.text) when label is Text
			}
			return said.join(",")
		}

		// A point on the arrow of the row that shows `nth` from the top, `depth` deep.
		def onArrow(nth int, depth int, side float) Point<Pixels> {
			return new Point<Pixels>((float(depth) * side + side / 2.0) * 1(px), (float(nth) * 20.0 + 10.0) * 1(px))
		}

		// A point on what the row that shows `nth` from the top says.
		def onLabel(nth int) Point<Pixels> {
			return new Point<Pixels>(150(px), (float(nth) * 20.0 + 10.0) * 1(px))
		}

		// `focus()` on the tree puts the keyboard on its rows.
		@test()
		def TestTreeFocusGoesToItsRows() {
			let page = BranchesPage()
			let scene = new Scene(page)
			let size = new Size<Pixels>(200(px), 100(px))
			scene.arrange(size)
			scene.arrange(size)
			let tree = page.tree
			assert !(tree is none)
			return when tree is none
			let list = tree.list
			assert !(list is none)
			return when list is none
			let rows component = list
			assert scene.focused() != rows
			tree.focus()
			scene.arrange(size)
			assert scene.focused() == rows
		}

		// A tree shows its roots; a press on a node's arrow shows its children under it,
		// one step further in, and asks for them once.
		@test()
		def TestTreeOpensAndClosesNodes() {
			treeLog.len(0)
			let page = BranchesPage()
			let scene = new Scene(page)
			let size = new Size<Pixels>(200(px), 100(px))
			scene.arrange(size)
			scene.arrange(size)
			let tree = page.tree
			assert !(tree is none)
			return when tree is none
			let list = tree.list
			assert !(list is none)
			return when list is none
			let port = list.port
			assert !(port is none)
			return when port is none

			assert textOf(port) == "src 0 false,docs 0 false"
			let rows = nodesOf(port)
			assert rows[0].branch && !rows[0].open && rows[0].depth == 0
			let side = rows[0].side()
			assert float(rows[0].childNodes[0].style.geom.frame.left) == side + float(themeOf(page).metrics.unit)

			scene.pointer(PointerPhase.Down, onArrow(0, 0, side))
			scene.pointer(PointerPhase.Up, onArrow(0, 0, side))
			scene.arrange(size)
			scene.arrange(size)
			assert page.open.join(",") == "src"
			assert textOf(port) == "src 0 true,a 1 false,b 1 false,docs 0 false"
			assert treeLog.join(",") == "src true"
			// The press on the arrow selected nothing.
			assert page.picked.len() == 0
			rows = nodesOf(port)
			assert rows[0].open && rows[1].depth == 1
			assert float(rows[1].childNodes[0].style.geom.frame.left) == 2.0 * side + float(themeOf(page).metrics.unit)

			// A press beside the arrow selects the row and leaves the node as it is.
			scene.pointer(PointerPhase.Down, onLabel(2))
			scene.pointer(PointerPhase.Up, onLabel(2))
			scene.arrange(size)
			assert page.picked.join(",") == "b" && page.open.join(",") == "src"

			// `a` has no children: it has no arrow, and a press where one would be is a
			// press on the row.
			rows = nodesOf(port)
			assert !rows[1].branch && rows[2].branch
			scene.pointer(PointerPhase.Down, onArrow(1, 1, side))
			scene.pointer(PointerPhase.Up, onArrow(1, 1, side))
			scene.arrange(size)
			scene.arrange(size)
			assert page.open.join(",") == "src" && page.picked.join(",") == "a"
			scene.pointer(PointerPhase.Down, onLabel(2))
			scene.pointer(PointerPhase.Up, onLabel(2))
			scene.arrange(size)

			// Closing `src` hides what is under it; opening it again asks nothing.
			scene.pointer(PointerPhase.Down, onArrow(0, 0, side))
			scene.pointer(PointerPhase.Up, onArrow(0, 0, side))
			scene.arrange(size)
			scene.arrange(size)
			assert textOf(port) == "src 0 false,docs 0 false"
			assert treeLog[-1] == "src false"
			// The keyboard was on `b`: it is on `src` now.
			let current = tree.current()
			assert !(current is none) && current == "src"
			scene.pointer(PointerPhase.Down, onArrow(0, 0, side))
			scene.pointer(PointerPhase.Up, onArrow(0, 0, side))
			scene.arrange(size)
			scene.arrange(size)
			assert textOf(port) == "src 0 true,a 1 false,b 1 false,docs 0 false"
			assert page.tops[0].asked == 1
			scene.close()
		}

		// Right opens a node and then goes to its first child; Left goes to the parent
		// and then closes it. The other keys are the list's.
		@test()
		def TestTreeKeys() {
			treeLog.len(0)
			let page = BranchesPage()
			let scene = new Scene(page)
			let size = new Size<Pixels>(200(px), 100(px))
			scene.arrange(size)
			scene.arrange(size)
			let tree = page.tree
			return when tree is none
			let list = tree.list
			return when list is none
			let port = list.port
			return when port is none

			scene.pointer(PointerPhase.Down, onLabel(0))
			scene.pointer(PointerPhase.Up, onLabel(0))
			assert page.picked.join(",") == "src"
			scene.key(KeyEvent{target: list, key: Key.Right})
			scene.arrange(size)
			scene.arrange(size)
			assert page.open.join(",") == "src" && page.picked.join(",") == "src"
			scene.key(KeyEvent{target: list, key: Key.Right})
			assert page.picked.join(",") == "a"
			scene.key(KeyEvent{target: list, key: Key.Down})
			assert page.picked.join(",") == "b"
			scene.key(KeyEvent{target: list, key: Key.Right})
			scene.arrange(size)
			scene.arrange(size)
			scene.key(KeyEvent{target: list, key: Key.Right})
			assert page.picked.join(",") == "deep"
			assert textOf(port) == "src 0 true,a 1 false,b 1 true,deep 2 false,docs 0 false"
			scene.key(KeyEvent{target: list, key: Key.Enter})
			assert treeLog[-1] == "opened deep"

			// Left on a node that shows no children goes to its parent, then closes it.
			scene.key(KeyEvent{target: list, key: Key.Left})
			assert page.picked.join(",") == "b" && page.open.join(",") == "src,b"
			scene.key(KeyEvent{target: list, key: Key.Left})
			assert page.open.join(",") == "src"
			scene.arrange(size)
			scene.arrange(size)
			scene.key(KeyEvent{target: list, key: Key.Left})
			assert page.picked.join(",") == "src" && page.open.join(",") == "src"
			scene.key(KeyEvent{target: list, key: Key.Left})
			assert page.open.len() == 0
			scene.arrange(size)
			scene.arrange(size)
			assert textOf(port) == "src 0 false,docs 0 false"
			scene.close()
		}

		// A node is its own identity when there is no `id`; `leaf` says which nodes get no
		// arrow; `expanded` set from outside opens nodes.
		@test()
		def TestTreeOfValuesWithLeaves() {
			let page = WordsPage()
			page.open = ["x", "x1"]
			let scene = new Scene(page)
			let size = new Size<Pixels>(200(px), 100(px))
			scene.arrange(size)
			scene.arrange(size)
			let tree = page.tree
			return when tree is none
			let list = tree.list
			return when list is none
			let port = list.port
			return when port is none
			assert textOf(port) == "x,x1,x11,x12,x2,y"
			let rows = nodesOf(port)
			assert rows[1].open && rows[2].depth == 2 && !rows[2].branch && rows[4].branch

			page.open = ["y"]
			scene.arrange(size)
			scene.arrange(size)
			assert textOf(port) == "x,y,y1,y2"
			scene.close()
		}

		// `revealPath` opens the nodes on the way it is given down to the last and
		// scrolls to it, waiting for children a task reads; an id that is not there ends
		// the way quietly.
		@test()
		def TestTreeRevealsAPath() !none {
			let page = BranchesPage()
			let scene = new Scene(page)
			let size = new Size<Pixels>(200(px), 100(px))
			scene.arrange(size)
			scene.arrange(size)
			let tree = page.tree
			return none when tree is none
			tree.revealPath(["src", "b", "deep"])
			assert page.open.join(",") == "src,b"
			scene.arrange(size)
			scene.arrange(size)
			page.open = []
			scene.arrange(size)
			tree.revealPath(["src", "nowhere", "deep"])
			assert page.open.join(",") == "src"
			scene.close()

			let later = LaterPage()
			let shown = new Scene(later)
			let room = new Size<Pixels>(200(px), 200(px))
			shown.arrange(room)
			shown.arrange(room)
			let lazy = later.tree
			return none when lazy is none
			lazy.revealPath(["slow", "slow3"])
			assert later.open.join(",") == "slow"
			time.sleep(200ms)
			shown.arrange(room)
			shown.arrange(room)
			let list = lazy.list
			return none when list is none
			let port = list.port
			return none when port is none
			assert textOf(port) == "slow,slow0,slow1,slow2,slow3,slow4,broken"
			assert lazy.way.len() == 0
			shown.close()
			return none
		}

		// `reveal` opens the nodes above a node that was read and scrolls to it; a node
		// never read is not found. The children of a node that shows are read.
		@test()
		def TestTreeReveals() {
			let fresh = BranchesPage()
			let first = new Scene(fresh)
			let room = new Size<Pixels>(200(px), 100(px))
			first.arrange(room)
			first.arrange(room)
			let unread = fresh.tree
			return when unread is none
			// `deep` is under `b`, which never showed.
			unread.reveal("deep")
			assert fresh.open.len() == 0
			unread.reveal("guide")
			assert fresh.open.join(",") == "docs"
			first.close()

			let page = BranchesPage()
			page.open = ["src", "b"]
			let scene = new Scene(page)
			let size = new Size<Pixels>(200(px), 100(px))
			scene.arrange(size)
			scene.arrange(size)
			let tree = page.tree
			return when tree is none
			let list = tree.list
			return when list is none
			let port = list.port
			return when port is none
			page.open = []
			scene.arrange(size)
			scene.arrange(size)
			assert textOf(port) == "src 0 false,docs 0 false"

			tree.reveal("deep")
			assert page.open.join(",") == "src,b"
			scene.arrange(size)
			scene.arrange(size)
			scene.arrange(size)
			assert textOf(port) == "src 0 true,a 1 false,b 1 true,deep 2 false,docs 0 false"
			scene.close()
		}
	}
}
