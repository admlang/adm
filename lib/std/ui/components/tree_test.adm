partial module std.ui.components {
	use (
		std.math.geom::(Point, Size)
		std.testing
		std.ui::(Key, KeyEvent, PointerPhase, themeOf)
		std.ui.runtime::Scene
		std.ui.styles::*
		std.units::Pixels
	)

	internal let treeLog = string[]

	// A node told from another by being that object.
	type Branch {
		name  string   = ""
		under Branch[] = []
		// How many times its children were asked for.
		asked int      = 0

		def new(name string, under Branch[] = []) {
			self.name = name
			self.under = under
		}
	}

	// src (a, b (deep)) and docs (guide), in rows 20 high.
	component BranchesPage {
		type {
			@bindable
			open string[] = []

			@bindable
			picked string[] = []

			tops Branch[] = []

			def new() {
				style.width = 200(px)
				style.height = 100(px)
				tops = [
					new Branch("src", [new Branch("a"), new Branch("b", [new Branch("deep")])]),
					new Branch("docs", [new Branch("guide")]),
				]
			}

			def named(node Branch) string {
				return node.name
			}

			def below(node Branch) Branch[] {
				node.asked++
				return node.under
			}

			def flipped(node Branch, now bool) {
				treeLog.push("{node.name} {now}")
			}

			def shown(node Branch) {
				treeLog.push("opened {node.name}")
			}
		}

		view {
			Tree(tops, id = named, expand = below, expanded = open, selected = picked, rowHeight = 20(px), onToggle = flipped, onOpen = shown, ref = tree) {
				rowRenderer = (it RowItem<Branch>) => Text("{it.content.name} {it.depth} {it.expanded}")
			}
		}

		style StageStyle
	}

	// Words that are their own identity, each holding the same word with a mark more; a
	// word of five letters holds nothing.
	component WordsPage {
		type {
			@bindable
			open string[] = []

			words string[] = ["x", "y"]

			def new() {
				style.width = 200(px)
				style.height = 100(px)
			}

			def longer(word string) string[] {
				return ["{word}1", "{word}2"]
			}

			def last(word string) bool {
				return word.len() >= 3
			}
		}

		view {
			Tree(words, expand = longer, leaf = last, expanded = open, rowHeight = 20(px), ref = tree)
		}

		style StageStyle
	}

	check "Tree" {
		// The rows of a tree as mounted now, top to bottom.
		def nodesOf(port component) TreeRow[] {
			let rows TreeRow[]
			for let child in port.childNodes {
				continue unless child is ListRow
				let inside = child.childNodes[0]
				rows.push(inside) when inside is TreeRow
			}
			return rows
		}

		// What the mounted rows say, joined with commas.
		def textOf(port component) string {
			let said string[]
			for let row in nodesOf(port) {
				let label = row.childNodes[0]
				said.push(label.text) when label is Text
			}
			return said.join(",")
		}

		// A point on the arrow of the row that shows `nth` from the top, `depth` deep.
		def onArrow(nth int, depth int, side float) Point<Pixels> {
			return new Point<Pixels>((float(depth) * side + side / 2.0) * 1(px), (float(nth) * 20.0 + 10.0) * 1(px))
		}

		// A point on what the row that shows `nth` from the top says.
		def onLabel(nth int) Point<Pixels> {
			return new Point<Pixels>(150(px), (float(nth) * 20.0 + 10.0) * 1(px))
		}

		// A tree shows its roots; a press on a node's arrow shows its children under it,
		// one step further in, and asks for them once.
		@test()
		def TestTreeOpensAndClosesNodes() {
			treeLog.len(0)
			let page = BranchesPage()
			let scene = new Scene(page)
			let size = new Size<Pixels>(200(px), 100(px))
			scene.arrange(size)
			scene.arrange(size)
			let tree = page.tree
			assert !(tree is none)
			return when tree is none
			let list = tree.list
			assert !(list is none)
			return when list is none
			let port = list.port
			assert !(port is none)
			return when port is none

			assert textOf(port) == "src 0 false,docs 0 false"
			let rows = nodesOf(port)
			assert rows[0].branch && !rows[0].open && rows[0].depth == 0
			let side = rows[0].side()
			assert float(rows[0].childNodes[0].style.geom.frame.left) == side + float(themeOf(page).metrics.unit)

			scene.pointer(PointerPhase.Down, onArrow(0, 0, side))
			scene.pointer(PointerPhase.Up, onArrow(0, 0, side))
			scene.arrange(size)
			scene.arrange(size)
			assert page.open.join(",") == "src"
			assert textOf(port) == "src 0 true,a 1 false,b 1 false,docs 0 false"
			assert treeLog.join(",") == "src true"
			// The press on the arrow selected nothing.
			assert page.picked.len() == 0
			rows = nodesOf(port)
			assert rows[0].open && rows[1].depth == 1
			assert float(rows[1].childNodes[0].style.geom.frame.left) == 2.0 * side + float(themeOf(page).metrics.unit)

			// A press beside the arrow selects the row and leaves the node as it is.
			scene.pointer(PointerPhase.Down, onLabel(2))
			scene.pointer(PointerPhase.Up, onLabel(2))
			scene.arrange(size)
			assert page.picked.join(",") == "b" && page.open.join(",") == "src"

			// `a` has no children: it has no arrow, and a press where one would be is a
			// press on the row.
			rows = nodesOf(port)
			assert !rows[1].branch && rows[2].branch
			scene.pointer(PointerPhase.Down, onArrow(1, 1, side))
			scene.pointer(PointerPhase.Up, onArrow(1, 1, side))
			scene.arrange(size)
			scene.arrange(size)
			assert page.open.join(",") == "src" && page.picked.join(",") == "a"
			scene.pointer(PointerPhase.Down, onLabel(2))
			scene.pointer(PointerPhase.Up, onLabel(2))
			scene.arrange(size)

			// Closing `src` hides what is under it; opening it again asks nothing.
			scene.pointer(PointerPhase.Down, onArrow(0, 0, side))
			scene.pointer(PointerPhase.Up, onArrow(0, 0, side))
			scene.arrange(size)
			scene.arrange(size)
			assert textOf(port) == "src 0 false,docs 0 false"
			assert treeLog[-1] == "src false"
			// The keyboard was on `b`: it is on `src` now.
			let current = tree.current()
			assert !(current is none) && current == "src"
			scene.pointer(PointerPhase.Down, onArrow(0, 0, side))
			scene.pointer(PointerPhase.Up, onArrow(0, 0, side))
			scene.arrange(size)
			scene.arrange(size)
			assert textOf(port) == "src 0 true,a 1 false,b 1 false,docs 0 false"
			assert page.tops[0].asked == 1
			scene.close()
		}

		// Right opens a node and then goes to its first child; Left goes to the parent
		// and then closes it. The other keys are the list's.
		@test()
		def TestTreeKeys() {
			treeLog.len(0)
			let page = BranchesPage()
			let scene = new Scene(page)
			let size = new Size<Pixels>(200(px), 100(px))
			scene.arrange(size)
			scene.arrange(size)
			let tree = page.tree
			return when tree is none
			let list = tree.list
			return when list is none
			let port = list.port
			return when port is none

			scene.pointer(PointerPhase.Down, onLabel(0))
			scene.pointer(PointerPhase.Up, onLabel(0))
			assert page.picked.join(",") == "src"
			scene.key(KeyEvent{target: list, key: Key.Right})
			scene.arrange(size)
			scene.arrange(size)
			assert page.open.join(",") == "src" && page.picked.join(",") == "src"
			scene.key(KeyEvent{target: list, key: Key.Right})
			assert page.picked.join(",") == "a"
			scene.key(KeyEvent{target: list, key: Key.Down})
			assert page.picked.join(",") == "b"
			scene.key(KeyEvent{target: list, key: Key.Right})
			scene.arrange(size)
			scene.arrange(size)
			scene.key(KeyEvent{target: list, key: Key.Right})
			assert page.picked.join(",") == "deep"
			assert textOf(port) == "src 0 true,a 1 false,b 1 true,deep 2 false,docs 0 false"
			scene.key(KeyEvent{target: list, key: Key.Enter})
			assert treeLog[-1] == "opened deep"

			// Left on a node that shows no children goes to its parent, then closes it.
			scene.key(KeyEvent{target: list, key: Key.Left})
			assert page.picked.join(",") == "b" && page.open.join(",") == "src,b"
			scene.key(KeyEvent{target: list, key: Key.Left})
			assert page.open.join(",") == "src"
			scene.arrange(size)
			scene.arrange(size)
			scene.key(KeyEvent{target: list, key: Key.Left})
			assert page.picked.join(",") == "src" && page.open.join(",") == "src"
			scene.key(KeyEvent{target: list, key: Key.Left})
			assert page.open.len() == 0
			scene.arrange(size)
			scene.arrange(size)
			assert textOf(port) == "src 0 false,docs 0 false"
			scene.close()
		}

		// A node is its own identity when there is no `id`; `leaf` says which nodes get no
		// arrow; `expanded` set from outside opens nodes.
		@test()
		def TestTreeOfValuesWithLeaves() {
			let page = WordsPage()
			page.open = ["x", "x1"]
			let scene = new Scene(page)
			let size = new Size<Pixels>(200(px), 100(px))
			scene.arrange(size)
			scene.arrange(size)
			let tree = page.tree
			return when tree is none
			let list = tree.list
			return when list is none
			let port = list.port
			return when port is none
			assert textOf(port) == "x,x1,x11,x12,x2,y"
			let rows = nodesOf(port)
			assert rows[1].open && rows[2].depth == 2 && !rows[2].branch && rows[4].branch

			page.open = ["y"]
			scene.arrange(size)
			scene.arrange(size)
			assert textOf(port) == "x,y,y1,y2"
			scene.close()
		}

		// `reveal` opens the nodes above a node that was read and scrolls to it; a node
		// never read is not found. The children of a node that shows are read.
		@test()
		def TestTreeReveals() {
			let fresh = BranchesPage()
			let first = new Scene(fresh)
			let room = new Size<Pixels>(200(px), 100(px))
			first.arrange(room)
			first.arrange(room)
			let unread = fresh.tree
			return when unread is none
			// `deep` is under `b`, which never showed.
			unread.reveal("deep")
			assert fresh.open.len() == 0
			unread.reveal("guide")
			assert fresh.open.join(",") == "docs"
			first.close()

			let page = BranchesPage()
			page.open = ["src", "b"]
			let scene = new Scene(page)
			let size = new Size<Pixels>(200(px), 100(px))
			scene.arrange(size)
			scene.arrange(size)
			let tree = page.tree
			return when tree is none
			let list = tree.list
			return when list is none
			let port = list.port
			return when port is none
			page.open = []
			scene.arrange(size)
			scene.arrange(size)
			assert textOf(port) == "src 0 false,docs 0 false"

			tree.reveal("deep")
			assert page.open.join(",") == "src,b"
			scene.arrange(size)
			scene.arrange(size)
			scene.arrange(size)
			assert textOf(port) == "src 0 true,a 1 false,b 1 true,deep 2 false,docs 0 false"
			scene.close()
		}
	}
}
