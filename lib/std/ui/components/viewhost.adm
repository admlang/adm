partial module std.ui.components {
	use std.ui.styles::*

	// The style of a `ViewHost`: a box that lays out what it holds in a column.
	style ViewHostStyle {
		Box
		Layout
	}

	// Content known only when the program runs, placed by key from code: plugin panels,
	// the panes of a dock layout. `insert`, `remove`, `move` and `replace` each change
	// what it shows at once, on the next frame. `take` lets go of a mounted view and
	// what it built, which `insert` then gives to this host or another in the same
	// window: the components keep their state, and are told `detached` and `attached`.
	//
	//     weak tools ?ViewHost
	//     def install(tool Tool) {
	//         return when tools is none
	//         tools.insert(tool.id, tool.panel())
	//     }
	component ViewHost {
		style ViewHostStyle

		type {
			// The keys in the order the views are shown, and the hosted view of each.
			order string[] = []
			hosted map<string, HostedView> = map<string, HostedView>{}

			// Shows `content` under `key`, at `at` among the views (the end when it is
			// out of range). False, and nothing changes, when `key` is held already.
			def insert(key string, content view, at int = -1) bool {
				return false when hosted.hasKey(key)
				return place(key, HostedView(content), at)
			}

			// Shows what `take` let go of under `key`, at `at` among the views. False,
			// and nothing changes, when `key` is held already or `taken` was given to a
			// host since it was taken.
			def insert(key string, taken TakenView, at int = -1) bool {
				return false when hosted.hasKey(key)
				let held = taken.held
				return false when held is none
				taken.held = none
				return place(key, held, at)
			}

			// Unmounts the view under `key` and what it built. False when there is none.
			def remove(key string) bool {
				return false unless hosted.hasKey(key)
				hosted.delete(key)
				order = without(key)
				show()
				return true
			}

			// Moves the view under `key` to `to` among the views, keeping what it
			// built. False when there is none.
			def move(key string, to int) bool {
				return false unless hosted.hasKey(key)
				let rest = without(key)
				order = into(rest, key, to)
				show()
				return true
			}

			// Shows `content` under `key` in place of what it showed: the components
			// the old view built leave, unless the new one is written by the same
			// `view { ... }` and builds them again. False when there is none.
			def replace(key string, content view) bool {
				return false unless hosted.hasKey(key)
				let held = hosted[key]
				held.shown = content
				held.rerun()
				return true
			}

			// Lets go of the view under `key` without unmounting it: it leaves this
			// host with what it built, to be given to a host with `insert`. None when
			// there is no view under `key`.
			def take(key string) ?TakenView {
				return none unless hosted.hasKey(key)
				let held = hosted[key]
				hosted.delete(key)
				order = without(key)
				let _ = _release(held)
				show()
				return new TakenView(held)
			}

			// Whether a view is shown under `key`.
			def has(key string) bool {
				return hosted.hasKey(key)
			}

			// The keys of the views it shows, in order.
			def keys() string[] {
				return order.clone()
			}

			internal def place(key string, held HostedView, at int) bool {
				hosted.set(key, held)
				order = into(order, key, at)
				show()
				return true
			}

			internal def without(key string) string[] {
				let next string[] = []
				for let held in order {
					next.push(held) when held != key
				}
				return next
			}

			internal def into(keys string[], key string, at int) string[] {
				let next string[] = []
				let placed = false
				for let (i, held) in keys {
					if i == at {
						next.push(key)
						placed = true
					}
					next.push(held)
				}
				next.push(key) unless placed
				return next
			}

			// Gives the hosted views, in order, to what its view places.
			internal def show() {
				let given component[] = []
				for let key in order {
					given.push(hosted[key])
				}
				setChildren(given)
			}
		}

		view {
			children()
		}
	}

	// A view `ViewHost.take` let go of, with what it built, until a host's `insert` takes
	// it.
	type TakenView {
		internal held ?HostedView

		internal def new(held HostedView) {
			self.held = held
		}
	}

	// One view a `ViewHost` shows. It has no box: what the view places is laid out as
	// the host's own content.
	@scoped
	internal component HostedView {
		type {
			@input(value = true)
			shown view = view {}
		}

		view {
			shown()
		}
	}
}
