partial module std.ui.components {
	use (
		std.math.geom::Size
		std.testing
		std.ui.runtime::Scene
		std.ui.styles::*
		std.units::Pixels
	)

	internal let hostLog = string[]

	// Counts the times it is built, attached and detached, and keeps a number of its own.
	component HostedPanel {
		style {
			Box
			height = 20(px)
		}

		type {
			@input(value = true)
			name string

			kept int = 0

			def new() {
				hostLog.push("new {name}")
			}

			def attached() {
				hostLog.push("attached {name}")
			}

			def detached() {
				hostLog.push("detached {name}")
			}
		}

		view {}
	}

	// Two hosts side by side.
	component TwoHosts {
		style {
			Box
			Layout
			width  = 200(px)
			height = 200(px)
		}

		type {}

		view {
			ViewHost(ref = left)
			ViewHost(ref = right)
		}
	}

	// The names of the panels a host shows, in order.
	internal def shownIn(host ViewHost) string {
		let names = string[]
		for let held in host.childNodes {
			for let inner in held.childNodes {
				names.push(inner.name) when inner is HostedPanel
			}
		}
		return names.join(",")
	}

	check "ViewHost" {
		// Views inserted by key show in order; moved, removed and replaced they change
		// on the next frame, and a moved one keeps what it built.
		@test()
		def TestHostsViewsByKey() {
			hostLog = string[]
			let page = TwoHosts()
			let scene = new Scene(page)
			let size = new Size<Pixels>(400(px), 400(px))
			scene.arrange(size)
			let left = page.left
			assert !(left is none)
			if !(left is none) {
				assert left.insert("a", view { HostedPanel("a") })
				assert left.insert("b", view { HostedPanel("b") })
				assert left.insert("c", view { HostedPanel("c") }, at = 0)
				assert !left.insert("a", view { HostedPanel("again") })
				scene.arrange(size)
				assert shownIn(left) == "c,a,b" && left.keys().join(",") == "c,a,b"

				let a = left.childNodes[1].childNodes[0]
				if a is HostedPanel {
					a.kept = 7
				}
				assert left.move("a", 2)
				scene.arrange(size)
				assert shownIn(left) == "c,b,a"
				let moved = left.childNodes[2].childNodes[0]
				assert moved == a
				assert left.remove("c") && !left.remove("c")
				assert left.replace("b", view { HostedPanel("d") })
				scene.arrange(size)
				assert shownIn(left) == "d,a" && hostLog.join(",").contains("detached c")
			}
		}

		// A taken view leaves its host with what it built and shows in another, its
		// components told `detached` and then `attached`, their state kept.
		@test()
		def TestTakenViewsMove() {
			hostLog = string[]
			let page = TwoHosts()
			let scene = new Scene(page)
			let size = new Size<Pixels>(400(px), 400(px))
			scene.arrange(size)
			let left = page.left
			let right = page.right
			assert !(left is none) && !(right is none)
			if !(left is none) && !(right is none) {
				assert left.insert("editor", view { HostedPanel("editor") })
				scene.arrange(size)
				let panel = left.childNodes[0].childNodes[0]
				if panel is HostedPanel {
					panel.kept = 3
				}
				let taken = left.take("editor")
				assert !(taken is none) && left.take("editor") is none
				scene.arrange(size)
				assert shownIn(left) == ""
				if !(taken is none) {
					assert right.insert("editor", taken)
					assert !right.insert("other", taken)
				}
				scene.arrange(size)
				assert shownIn(right) == "editor"
				let there = right.childNodes[0].childNodes[0]
				assert there == panel
				if there is HostedPanel {
					assert there.kept == 3
				}
				assert hostLog.join(",") == "new editor,attached editor,detached editor,attached editor"
			}
		}
	}
}
