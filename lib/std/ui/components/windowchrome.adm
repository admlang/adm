partial module std.ui.components {
	use (
		std.math.geom::(Axes, Edges, Rect)
		std.ui::(RenderContext, WindowState, themeOf)
		std.ui.renderer::Window
		std.ui.runtime::drawIcon
		std.ui.styles::*
		std.units::Extent
	)

	// The header of a `WindowChrome`: a row the window is moved by.
	internal component ChromeBar {
		type {
			def gripsWindow() bool {
				return !disabled
			}

			def render(ctx RenderContext) {
				ctx.background()
				ctx.childNodes()
				// A line under it.
				let look = themeOf(self)
				let box = frameBox(ctx)
				let thick = float(look.metrics.borderWidth)
				ctx.draw.fill(Rect{left: 0.0, top: box.bottom - thick, right: box.right, bottom: box.bottom}, look.palette.divider)
			}
		}

		view {
			children()
		}

		style {
			Box
			Layout
			Background
			arrange   = Arrange.Row
			width     = fill
			minHeight = theme.metrics.controlHeight + theme.metrics.unit * 2.0
			gap       = new Axes<Extent>(theme.metrics.unit * 2.0)
			// The buttons reach the header's edges.
			padding    = new Edges<Extent>(0(px), 0(px), 0(px), theme.metrics.unit * 3.0)
			align      = Align{horizontal: Alignment.Start, vertical: Alignment.Center}
			background = new BackgroundFill(theme.palette.surface)
		}
	}

	// One of a chrome's buttons: an icon on a plain square that is filled under the pointer,
	// in the danger colour for the one that closes. It can take the focus, which is what
	// tells the window's header that a press on it is the button's and moves nothing; Tab
	// does not stop on it: the keys that close or minimize a window are the desktop's.
	internal component ChromeButton {
		type {
			@input(value = true)
			icon string = ""

			// Whether it closes the window.
			@input
			closes bool = false

			mark IconSlot = new IconSlot()

			def new() {
				role    = Role.Button
				tabStop = false
			}

			def render(ctx RenderContext) {
				let palette = themeOf(self).palette
				let box = frameBox(ctx)
				let ink = palette.foreground
				if hover && !disabled {
					let fill = closes ?? (palette.danger, palette.surface.mix(pressed ?? (palette.pressed, palette.hover)))
					ctx.draw.fill(box, fill)
					ink = palette.onAccent when closes
				}
				let found = mark.get(icon)
				return when found is none
				let side = float(themeOf(self).metrics.iconSize)
				let (left, top) = ((box.right - side) / 2.0, (box.bottom - side) / 2.0)
				drawIcon(ctx.draw, found, Rect{left: left, top: top, right: left + side, bottom: top + side}, ink)
			}
		}

		view {}

		style {
			Box
			Interaction
			width  = theme.metrics.controlHeight + theme.metrics.unit * 3.0
			height = fill
		}
	}

	// What a `WindowChrome` holds under its header: the window's root, in the room left.
	internal component ChromeBody {
		view {
			children()
		}

		style {
			Box
			Layout
			width  = fill
			height = fill
		}
	}

	// The frame of a window, drawn by the application in place of the desktop's: a line
	// around the window, a header with a title that the window is moved by, and buttons
	// that minimize it, maximize or restore it, and close it. What it holds is under the
	// header.
	//
	// A window takes it as its chrome: `config.chrome = WindowChrome(title = "Notes")`
	// opens the window without the desktop's frame and puts the window's root in it.
	// Any component whose view calls `children()` can be a window's chrome; this is the
	// standard one. Its buttons act on the window it is in (`context<Window>()`), and
	// closing asks as the desktop's button does (`Window.close()`): a handler of
	// `UI.closeRequested` may keep the window open.
	component WindowChrome {
		type {
			// What the header says.
			@input
			title string = ""

			// An icon before the title, by name; empty: none.
			@input
			icon string = ""

			// What stands in the header between the title and the buttons: a menu bar, a
			// search field.
			@input
			header ?view = none

			// Which of the buttons it has.
			@input
			minimize bool = true

			@input
			maximize bool = true

			@input
			close bool = true

			// Whether the window it is in is maximized.
			def maximized() bool {
				let own = context<Window>()
				return false when own is none
				return own.state == WindowState.Maximized
			}

			// Minimizes the window.
			def shrink() {
				let own = context<Window>()
				return when own is none
				own.state = WindowState.Minimized
			}

			// Maximizes the window, or brings a maximized one back.
			def grow() {
				let own = context<Window>()
				return when own is none
				own.state = own.state == WindowState.Maximized ?? (WindowState.Normal, WindowState.Maximized)
			}

			// Asks for the window to be closed.
			def shut() {
				let own = context<Window>()
				return when own is none
				own.close()
			}

			def render(ctx RenderContext) {
				ctx.background()
				ctx.childNodes()
				ctx.borders()
			}
		}

		view {
			ChromeBar() {
				if icon != "" {
					Icon(icon)
				}
				Text(title)
				if !(header is none) {
					header()
				}
				Spacer()
				if minimize {
					ChromeButton("minimize", tooltip = "Minimize", onClick = shrink)
				}
				if maximize {
					ChromeButton(maximized() ?? ("restore", "maximize"), tooltip = maximized() ?? ("Restore", "Maximize"), onClick = grow)
				}
				if close {
					ChromeButton("close", closes = true, tooltip = "Close", onClick = shut)
				}
			}
			ChromeBody() {
				children()
			}
		}

		style {
			Box
			Layout
			Background
			Borders
			arrange    = Arrange.Column
			width      = fill
			height     = fill
			background = new BackgroundFill(theme.palette.window)
			border     = controlEdge(theme.palette.borderStrong)
		}
	}
}
