partial module std.ui.components {
	use (
		std.math.geom::(Point, Size)
		std.testing
		std.ui::(PointerPhase, WindowState)
		std.ui.renderer::Window
		std.ui.runtime::Scene
		std.ui.styles::*
		std.units::Pixels
	)

	// A chrome around a text, in a window the page makes up and provides as the service
	// does for a real one.
	component ChromedPage {
		type {
			own Window = new Window(uint(7))

			// Which buttons the chrome has.
			small bool = true
			large bool = true
			shuts bool = true

			def new() {
				style.width = 300(px)
				style.height = 200(px)
			}
		}

		view {
			provide<Window>(own)
			WindowChrome(title = "Notes", minimize = small, maximize = large, close = shuts, ref = chrome) {
				Text("The page")
			}
		}

		style StageStyle
	}

	// A chrome with no window above it.
	component LooseChromePage {
		type {}

		view {
			WindowChrome(title = "Loose", ref = chrome) {
				Text("The page")
			}
		}

		style StageStyle
	}

	check "WindowChrome" {
		// The buttons of a chrome's header, in order.
		def buttonsOf(chrome component) ChromeButton[] {
			let all ChromeButton[]
			for let child in chrome.childNodes[0].childNodes {
				all.push(child) when child is ChromeButton
			}
			return all
		}

		def press(scene Scene, c component) {
			let box = c.style.geom.frame
			let at = new Point<Pixels>((box.left + box.right) / 2.0, (box.top + box.bottom) / 2.0)
			scene.pointer(PointerPhase.Down, at)
			scene.pointer(PointerPhase.Up, at)
		}

		// A header with the title and three buttons over what it holds; the buttons
		// minimize, maximize and restore, and ask to close the window it is in.
		@test()
		def TestWindowChromeActsOnItsWindow() {
			let page = ChromedPage()
			let scene = new Scene(page)
			let size = new Size<Pixels>(300(px), 200(px))
			scene.arrange(size)
			scene.arrange(size)
			let chrome = page.chrome
			assert !(chrome is none)
			return when chrome is none
			let (bar, body) = (chrome.childNodes[0], chrome.childNodes[1])
			let label = bar.childNodes[0]
			assert label is Text && label.text == "Notes"
			// The header is as wide as the window, what it holds fills the rest under it.
			assert float(bar.style.geom.frame.width) >= 298.0
			assert body.style.geom.frame.top >= bar.style.geom.frame.bottom && float(body.style.geom.frame.bottom) >= 198.0
			let shown = body.childNodes[0]
			assert shown is Text && shown.text == "The page"

			let buttons = buttonsOf(chrome)
			assert buttons.len() == 3 && buttons[0].icon == "minimize" && buttons[1].icon == "maximize" && buttons[2].icon == "close"
			// The header moves the window by its title and its empty room; a press on a
			// button, or on what the chrome holds, is no drag.
			let titleBox = label.style.geom.frame
			assert scene.dragsWindow(new Point<Pixels>((titleBox.left + titleBox.right) / 2.0, (titleBox.top + titleBox.bottom) / 2.0))
			assert scene.dragsWindow(new Point<Pixels>(150(px), (titleBox.top + titleBox.bottom) / 2.0))
			for let button in buttons {
				let box = button.style.geom.frame
				assert !scene.dragsWindow(new Point<Pixels>((box.left + box.right) / 2.0, (box.top + box.bottom) / 2.0))
			}
			let shownBox = shown.style.geom.frame
			assert !scene.dragsWindow(new Point<Pixels>((shownBox.left + shownBox.right) / 2.0, (shownBox.top + shownBox.bottom) / 2.0))
			// The buttons stand at the end of the header.
			assert float(buttons[2].style.geom.frame.right) > 280.0

			press(scene, buttons[1])
			assert page.own.state == WindowState.Maximized
			scene.arrange(size)
			scene.arrange(size)
			assert buttonsOf(chrome)[1].icon == "restore"
			press(scene, buttonsOf(chrome)[1])
			assert page.own.state == WindowState.Normal
			press(scene, buttonsOf(chrome)[0])
			assert page.own.state == WindowState.Minimized
			assert !page.own.closing
			press(scene, buttonsOf(chrome)[2])
			assert page.own.closing

			// A chrome without some of its buttons.
			page.small = false
			page.large = false
			page.rerun()
			scene.arrange(size)
			scene.arrange(size)
			let left = buttonsOf(chrome)
			assert left.len() == 1 && left[0].icon == "close"
			scene.close()
		}

		// Outside a window its buttons do nothing.
		@test()
		def TestWindowChromeWithoutAWindow() {
			let page = LooseChromePage()
			let scene = new Scene(page)
			let size = new Size<Pixels>(300(px), 200(px))
			scene.arrange(size)
			scene.arrange(size)
			let chrome = page.chrome
			return when chrome is none
			assert !chrome.maximized()
			for let button in buttonsOf(chrome) {
				press(scene, button)
			}
			scene.arrange(size)
			assert buttonsOf(chrome).len() == 3
			scene.close()
		}
	}
}
