partial module std.ui.components {
	use (
		std.math.geom::Axes
		std.ui.styles::*
		std.units::Extent
	)

	// The style of a `WindowDrag`: its box and how it arranges its children.
	style WindowDragStyle {
		Box
		Layout
	}

	// The part of a window the user moves it by, for a window opened without decorations
	// (`WindowConfig.decorated = false`), which draws its own title bar:
	// `WindowDrag() { Text("Notes"); Spacer(); Button(icon = "close", onClick = quit) }`.
	// A press on it, or on anything in it that does not take the focus (a text, an icon),
	// drags the window; a button in it is pressed as anywhere else. It is as wide as what
	// it is in and places what it holds in a row.
	component WindowDrag {
		type {
			// The space between neighbouring children.
			@input
			gap Extent = 0(px)

			def gripsWindow() bool {
				return !disabled
			}
		}

		view {
			children()
		}

		style {
			WindowDragStyle
			arrange = Arrange.Row
			width   = fill
			gap     = new Axes<Extent>(self.gap)
		}
	}
}
