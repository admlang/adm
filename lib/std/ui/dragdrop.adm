partial module std.ui {
	// What dropping on a `DropTarget` would do with what is dragged: its `onOver` says it
	// and the pointer shows it.
	enum DropEffect {
		// Nothing: it is not taken here.
		None,
		Copy,
		Move,
		Link,
	}

	// What is dragged: what a `DropTarget` is asked about and given. `item` is for the
	// application itself; the rest is what other applications understand.
	struct DragData {
		// The value dragged inside the application (`data.item is File`); none when it
		// comes from another application.
		item    any                 = none
		// The text dragged; "" when there is none.
		text    string
		// The paths of the files dragged, as the system gives them; empty when there are
		// none.
		files   string[]
		// Other forms of what is dragged, by MIME type.
		formats map<string, byte[]> = map<string, byte[]>{}
	}
}
