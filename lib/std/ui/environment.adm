partial module std.ui {
	use (
		std.gfx.color::(Color, RGBA)
		std.math.geom::Rect
		std.ui.renderer as r
		std.ui.styles::Font
		std.units::Resolution
	)

	// Light or dark: the colour scheme the user picked for the desktop or browser.
	enum ColorScheme {
		Light,
		Dark,
	}

	// Whether the user asked for higher contrast than the normal look.
	enum Contrast {
		Normal,
		High,
	}

	// A monitor attached to the machine, as `UI.displays()` reports it.
	//
	// Positions and sizes are in logical pixels, in the desktop's coordinate space:
	// a display to the left of the primary one has a negative `bounds.left`.
	struct Display {
		// The name the platform gives the monitor ("DP-1", "Built-in Retina Display").
		name        string
		// The whole display.
		bounds      Rect<Pixels>
		// The part windows should use: `bounds` minus the taskbar, dock or menu bar.
		workArea    Rect<Pixels>
		// Device pixels per logical pixel: 1.0 on a standard display, 2.0 on HiDPI.
		scale       float        = 1.0
		// The physical pixel density, `96(dpi)` when the platform does not report it.
		dpi         Resolution   = 96(dpi)
		// Refresh rate in Hz, 60 when the platform does not report it.
		refreshRate float        = 60.0
		// Whether this is the display the platform treats as the main one.
		primary     bool
	}

	// The platform's look settings, as `UI.appearance()` reports them. A window's
	// root style takes its font, foreground colour, accent and motion from here.
	//
	// Every field always has a value: a platform that does not provide a setting
	// leaves the default written below.
	struct Appearance {
		// Light or dark.
		scheme             ColorScheme = ColorScheme.Light
		// The user's highlight colour, for selections, focus rings and default buttons.
		accent             Color       = new Color(RGBA{r: 53, g: 132, b: 228, a: 255})
		// Normal or high contrast.
		contrast           Contrast    = Contrast.Normal
		// The user asked for less animation: transitions should jump to their end.
		reduceMotion       bool
		// The user asked for opaque surfaces instead of blur and translucency.
		reduceTransparency bool
		// The "text size" accessibility setting: 1.0 is the default size.
		textScale          float       = 1.0
		// The system UI font, with `textScale` already applied to its size.
		font               Font        = Font{family: "system-ui"}
		// The system monospace font, with `textScale` applied.
		monospaceFont      Font        = Font{family: "monospace"}
		// The longest gap between two clicks that still counts as a double click.
		doubleClickTime    duration    = 500ms
		// The time the text caret stays on, then off. `0s` means it does not blink.
		caretBlink         duration    = 530ms
	}

	// A window moved to another display, or its display changed scale.
	struct WindowDisplayEvent {
		window  r.Window
		display Display
	}

	// The display holding most of the bounds; the first (primary) one when
	// none overlaps them.
	def displayAt(bounds Rect<Pixels>, displays Display[]) Display {
		return Display{primary: true} when displays.len() == 0
		let best = displays[0]
		let bestArea = 0.0
		for let (_, d) in displays {
			let width = float(bounds.right).min(float(d.bounds.right)) - float(bounds.left).max(float(d.bounds.left))
			let height = float(bounds.bottom).min(float(d.bounds.bottom)) - float(bounds.top).max(float(d.bounds.top))
			continue when width <= 0.0 || height <= 0.0
			if width * height > bestArea {
				best = d
				bestArea = width * height
			}
		}
		return best
	}

	// One line naming everything a displaysChange reports.
	internal def displayKey(d Display) string {
		let b = d.bounds
		let w = d.workArea
		return "{d.name} {float(b.left)} {float(b.top)} {float(b.right)} {float(b.bottom)} {float(w.left)} {float(w.top)} {float(w.right)} {float(w.bottom)} {d.scale} {d.refreshRate} {d.primary}"
	}
}
