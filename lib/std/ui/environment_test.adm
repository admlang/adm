partial module std.ui {
	use (
		std.testing
		std.gfx.color::(Color, RGBA)
		std.math.geom::Rect
		std.units
		std.units::Pixels
	)

	check "Theme" {
		// A dotted name falls back to its parents, then to the fallback, then to the
		// palette's foreground.
		@test()
		def TestThemeColorLookup() {
			let theme = new Theme(Appearance{})
			let keyword = new Color(RGBA{r: 200, g: 0, b: 0, a: 255})
			let ink = new Color(RGBA{r: 1, g: 2, b: 3, a: 255})
			theme.colors = theme.colors.set("syntax.keyword", keyword)
			theme.palette.foreground = ink
			assert theme.color("syntax.keyword").rgba.r == byte(200)
			assert theme.color("syntax.keyword.control").rgba.r == byte(200)
			assert theme.color("syntax.comment").rgba.b == byte(3)
			assert theme.color("syntax.comment", keyword).rgba.r == byte(200)
			assert theme.run("editor.lineNumber").font is none
		}

		// A theme made from the platform's look takes its scheme, accent and fonts.
		@test()
		def TestThemeFromAppearance() {
			let look = Appearance{scheme: ColorScheme.Dark}
			let theme = new Theme(look)
			assert theme.scheme == ColorScheme.Dark
			assert theme.fonts.code.family == "monospace"
			assert theme.fonts.body.family == "system-ui"
		}

		// Both palettes keep text readable on every background, whatever the accent, and
		// high contrast strengthens lines and muted text.
		@test()
		def TestPalettes() {
			let accents = [new Color("#3584E4"), new Color("#F6D32D"), new Color("#1C1C1C"), new Color("#E01B24"), new Color("#FFFFFF")]
			for let scheme in [ColorScheme.Light, ColorScheme.Dark] {
				for let accent in accents {
					let p = new Theme(Appearance{scheme: scheme, accent: accent}).palette
					for let ground in [p.window, p.surface, p.surfaceRaised, p.surfaceSunken, p.overlay] {
						assert p.foreground.isReadableOn(ground, 7.0) && p.foregroundMuted.isReadableOn(ground) && p.link.isReadableOn(ground)
						assert p.borderStrong.contrastRatio(ground) > 2.7
					}
					assert p.onAccent.isReadableOn(p.accentHover) && p.onAccent.isReadableOn(p.accentPressed)
					assert p.accentHover != p.accent && p.accentPressed != p.accentHover
					assert p.hover.rgba.a == 255 && p.pressed.rgba.a == 255
					let hovered = p.surfaceRaised.mix(p.hover)
					assert hovered != p.surfaceRaised && p.foreground.isReadableOn(hovered, 7.0) && p.foreground.isReadableOn(p.surfaceRaised.mix(p.pressed), 7.0)
					let sharp = new Theme(Appearance{scheme: scheme, accent: accent, contrast: Contrast.High}).palette
					assert sharp.onAccent.isReadableOn(sharp.accent, 7.0) && sharp.focus.contrastRatio(sharp.surface) >= 4.5
					assert p.onAccent.isReadableOn(p.accent) && p.onSelection.isReadableOn(p.selection) && p.onSelection.isReadableOn(p.selectionInactive)
					assert p.onDanger.isReadableOn(p.danger) && p.onWarning.isReadableOn(p.warning) && p.onSuccess.isReadableOn(p.success) && p.onInfo.isReadableOn(p.info)
					assert p.focus.contrastRatio(p.surface) >= 3.0
				}
			}
			let light = new Theme(Appearance{}).palette
			assert light.accent.hex.code == "#3077CD" && light.onAccent.hex.code == "#FFF" && light.focus.hex.code == "#3584E4"
			assert new Theme(Appearance{accent: new Color("#F6D32D")}).palette.onAccent.hex.code == "#1D1D20"
			let sharp = new Theme(Appearance{contrast: Contrast.High}).palette
			assert sharp.border == sharp.borderStrong && sharp.foregroundMuted == sharp.foreground
		}
	}

	check "Environment" {
		def screen(name string, left float, width float) Display {
			let bounds = Rect<Pixels>{left: left * 1(px), top: 0(px), right: (left + width) * 1(px), bottom: 1080(px)}
			return Display{name: name, bounds: bounds, workArea: bounds, primary: left == 0.0}
		}

		// The display holding most of the window wins; none overlapping falls
		// back to the first.
		@test()
		def TestDisplayAtPicksMostOverlap() {
			let displays = [screen("left", 0.0, 1920.0), screen("right", 1920.0, 2560.0)]
			let window = Rect<Pixels>{left: 1800(px), top: 100(px), right: 2400(px), bottom: 700(px)}
			assert displayAt(window, displays).name == "right"
			let offscreen = Rect<Pixels>{left: -900(px), top: 0(px), right: -100(px), bottom: 600(px)}
			assert displayAt(offscreen, displays).name == "left"
			assert displayAt(window, []).primary
		}

		// Every field has its documented fallback.
		@test()
		def TestFallbacks() {
			let look = Appearance{}
			assert look.scheme == ColorScheme.Light
			assert look.contrast == Contrast.Normal
			assert look.textScale == 1.0
			assert look.font.family == "system-ui"
			assert look.monospaceFont.family == "monospace"
			assert look.doubleClickTime == 500ms
			assert look.caretBlink == 530ms
			let display = Display{}
			assert display.scale == 1.0
			assert display.refreshRate == 60.0
			assert float(display.dpi) == float(96(dpi))
		}

		// Without a renderer, one fallback display; the appearance reads the
		// platform directly.
		@test()
		def TestReadsWithoutRenderer() {
			let displays = UI.displays()
			assert displays.len() >= 1
			assert displays[0].primary
			assert UI.appearance().textScale > 0.0
		}
	}
}
