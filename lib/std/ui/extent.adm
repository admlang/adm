partial module std.ui {
	use std.units::Length

	// Logical pixels: device pixels scaled by the display's DPI.
	@dimension(unit = "px")
	type Pixels

	// A share of the parent's size along the same axis.
	@dimension(unit = "%")
	type Percent

	// A share of the window's height: `100(vh)` is the whole height.
	@dimension(unit = "vh")
	type ViewportHeight

	// A share of the window's width: `100(vw)` is the whole width.
	@dimension(unit = "vw")
	type ViewportWidth

	// Multiples of the current font size: `1(em)` is the font size.
	@dimension(unit = "em")
	type FontRelative

	// A size or offset in any of the UI's units: `8(px)`, `50(%)`, `80(vh)`,
	// `2(cm)`. The renderer converts each case when it lays out.
	type Extent = Pixels | Percent | ViewportHeight | ViewportWidth | FontRelative | Length
}
