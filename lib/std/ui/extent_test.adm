partial module std.ui {
	use (
		std.testing
		std.units::Length
	)

	check "Extent" {
		def unitOf(e Extent) string {
			match e {
				case Pixels:
					return "px"
				case Percent:
					return "%"
				case ViewportHeight:
					return "vh"
				case ViewportWidth:
					return "vw"
				case FontRelative:
					return "em"
				case Length:
					return "m"
			}
			return ""
		}

		@test()
		def eachUnitIsItsOwnCase() {
			assert unitOf(8(px)) == "px"
			assert unitOf(50(%)) == "%"
			assert unitOf(80(vh)) == "vh"
			assert unitOf(100(vw)) == "vw"
			assert unitOf(1.5(em)) == "em"
			assert unitOf(2(m)) == "m"
			assert unitOf(2(cm)) == "m"
		}

		@test()
		def valueSurvivesTheUnion() {
			let e Extent = 50(%)
			match e {
				case Percent:
					assert float(e) == 50.0
				default:
					assert false
			}
		}
	}
}
