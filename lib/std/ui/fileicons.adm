partial module std.ui {
	use (
		std.formats.image
		std.gfx.canvas
		std.math.geom::Rect
		std.os
		std.units::Pixels
	)

	// The icon the system shows for a file like this one, in the system's current icon
	// theme: none when the system has none for it, or this platform has no icons to ask.
	// `path` is a path or a bare name; only its name decides, except that a folder that
	// exists, or a path ending in a separator, gets the folder icon. The file need not exist.
	//
	// The picture is drawn in a square 16 on a side, as `Icon` takes one, in its own
	// colours; `side` is the size it will show at, which picks the artwork made for that
	// size and the displays' density. One picture is made per kind of file and size.
	//
	// ```example
	// Icon(picture = systemFileIcon("notes.md", 16(px)))
	// ```
	def systemFileIcon(path string, side Pixels) ?canvas.Picture {
		let scale = 1.0
		for let display in UI.displays() {
			scale = scale.max(display.scale)
		}
		return fileIconAt(path, int(float(side).ceil()).max(1), int(scale.ceil()).max(1))
	}

	// The icon of `path` for `size` logical pixels at a whole `scale`, through the cache.
	internal def fileIconAt(path string, size int, scale int) ?canvas.Picture {
		let kind = fileIconKind(path)
		let key = "{kind}@{size}x{scale}"
		if fileIcons.knows(key) {
			return fileIcons.get(key)
		}
		let made = loadFileIcon(kind, size, scale)
		fileIcons.put(key, made)
		return made
	}

	// The pictures made so far, by kind of file and size, none for a kind the system has
	// no icon for. atomic: a view on any task may ask.
	internal type FileIconCache {
		held map<string, ?canvas.Picture> = map<string, ?canvas.Picture>{}

		atomic def knows(key string) bool {
			return held.hasKey(key)
		}

		atomic def get(key string) ?canvas.Picture {
			return held.get(key)
		}

		atomic def put(key string, icon ?canvas.Picture) {
			held[key] = icon
		}
	}

	internal let fileIcons = new FileIconCache()

	// Whether the icon asked for is a folder's: said by a trailing separator, or by the
	// file system when the path exists.
	internal def fileIconIsFolder(path string) bool {
		return true when path.endsWith("/") || path.endsWith("\\")
		let info = os.stat(path) onerror (err error) {
			return false
		}
		return info.isDir
	}

	// What the native icon lookups ask by: `folder`, the lower-case `.extension`, or
	// `file` for a name without one.
	internal def fileIconExtensionKind(path string) string {
		return "folder" when fileIconIsFolder(path)
		let extension = os.extension(path).lower()
		return extension == "" ?? ("file", ".{extension}")
	}

	// A picture of an image, drawn in the square of an icon.
	internal def iconOfImage(img image.Image) canvas.Picture {
		return canvas.record(def (p canvas.Painter) {
			p.drawImage(img, Rect{left: 0.0, top: 0.0, right: iconBox, bottom: iconBox})
		})
	}

	// A picture `wide` by `high` scaled to the square of an icon, in proportion and centred.
	internal def iconOfPicture(drawn canvas.Picture, wide float, high float) canvas.Picture {
		let by = wide > 0.0 && high > 0.0 ?? ((iconBox / wide).min(iconBox / high), 1.0)
		return canvas.record(def (p canvas.Painter) {
			p.save()
			p.translate((iconBox - wide * by) / 2.0, (iconBox - high * by) / 2.0)
			p.scale(by, by)
			drawn.replay(p)
			p.restore()
		})
	}
}
