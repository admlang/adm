@os("darwin")
@link("AppKit")
@link("CoreGraphics")
@link("UniformTypeIdentifiers")
partial module std.ui {
	use (
		std.formats.image
		std.gfx.canvas
	)

	// Fills `out`, `side` squared RGBA pixels with straight alpha, with the icon of a kind
	// of file: 1 when it did, 0 when the system has none (fileicons_darwin.h).
	@c("fileicons_darwin.h", symbol = "adm_file_icon_read", ret = "int32_t", params = ["const char*", "int64_t", "uint8_t*"])
	internal def macFileIconRead(kind string, side int, out byte[]) int32;

	internal def fileIconKind(path string) string {
		return fileIconExtensionKind(path)
	}

	internal def loadFileIcon(kind string, size int, scale int) ?canvas.Picture {
		let side = size * scale
		let img = new image.Image(side, side)
		return none when macFileIconRead(kind, side, img.raw()) == 0
		return iconOfImage(img)
	}
}
