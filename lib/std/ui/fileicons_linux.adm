@os("linux")
partial module std.ui {
	use (
		std.formats.image
		std.gfx.canvas
		std.os
		std.ui.platform as desktop
	)

	// One directory of an icon theme, as the theme's index.theme describes it.
	internal type IconThemeDir {
		path      string
		size      int    = 0
		scale     int    = 1
		kind      string = "Threshold"
		minSize   int    = 0
		maxSize   int    = 0
		threshold int    = 2
		context   string = ""

		// Whether the directory holds artwork for this size and scale.
		def holds(wanted int, wantedScale int) bool {
			return false unless scale == wantedScale
			match kind {
				case "Fixed":
					return size == wanted
				case "Scalable":
					return minSize <= wanted && wanted <= maxSize
			}
			return size - threshold <= wanted && wanted <= size + threshold
		}

		// How far its artwork is from this size and scale, in device pixels.
		def distance(wanted int, wantedScale int) int {
			let want = wanted * wantedScale
			match kind {
				case "Fixed":
					return (size * scale - want).abs()
				case "Scalable":
					return minSize * scale - want when want < minSize * scale
					return want - maxSize * scale when want > maxSize * scale
					return 0
			}
			return (size - threshold) * scale - want when want < (size - threshold) * scale
			return want - (size + threshold) * scale when want > (size + threshold) * scale
			return 0
		}
	}

	internal struct IconTheme {
		name     string
		inherits string[]
		dirs     IconThemeDir[]
	}

	// The sections of an index.theme: names to keys to values.
	internal def iniSections(text string) map<string, map<string, string>> {
		let out = map<string, map<string, string>>{}
		let section = ""
		for let raw in text.split("\n") {
			let line = raw.trim()
			continue when line == "" || line.startsWith("#")
			if line.startsWith("[") && line.endsWith("]") {
				section = line[1:line.len() - 1]
				out[section] = map<string, string>{} unless out.hasKey(section)
				continue
			}
			let eq = line.indexOf("=")
			continue when eq < 0 || section == ""
			let keys = out[section]
			keys[line[:eq].trim()] = line[eq + 1:].trim()
		}
		return out
	}

	// A theme from its index.theme. Only the artwork of files and folders is looked up, so
	// a directory of another context (actions, apps, ...) is left out: its contents are
	// never read.
	internal def iconThemeFrom(name string, text string) IconTheme {
		let theme = new IconTheme(name = name, inherits = [], dirs = [])
		let sections = iniSections(text)
		let head = sections.get("Icon Theme")
		return theme when head is none
		let number = def (keys map<string, string>, key string, otherwise int) int {
			let raw = keys.get(key)
			return otherwise when raw is none
			return parseInt<int>(raw)
		}
		let inherits = head.get("Inherits")
		if !(inherits is none) {
			for let parent in inherits.split(",") {
				theme.inherits.push(parent.trim()) unless parent.trim() == ""
			}
		}
		let listed string[]
		for let key in ["Directories", "ScaledDirectories"] {
			let names = head.get(key)
			continue when names is none
			for let dir in names.split(",") {
				listed.push(dir.trim()) unless dir.trim() == ""
			}
		}
		for let dir in listed {
			let keys = sections.get(dir)
			continue when keys is none
			let named = keys.get("Context")
			let context = named is none ?? ("", named.lower())
			continue unless context == "" || context == "mimetypes" || context == "places"
			let size = number(keys, "Size", 0)
			let entry = new IconThemeDir(path = dir, size = size, context = context)
			entry.scale = number(keys, "Scale", 1)
			entry.minSize = number(keys, "MinSize", size)
			entry.maxSize = number(keys, "MaxSize", size)
			entry.threshold = number(keys, "Threshold", 2)
			let kind = keys.get("Type")
			entry.kind = kind unless kind is none
			theme.dirs.push(entry)
		}
		return theme
	}

	// A file name's rule of the shared MIME database.
	internal struct MimeGlob {
		weight        int
		mime          string
		pattern       string
		caseSensitive bool
	}

	// Whether `pattern` covers all of `name`, as `fnmatch`: `*`, `?` and `[...]` with ranges
	// and `!`. `std.glob` has no bracket, and a bracket is an ordinary character there.
	internal def mimeGlobMatches(pattern string, name string) bool {
		let (p, n, star, resume) = (0, 0, -1, 0)
		for n < name.len() {
			if p < pattern.len() && pattern[p] == '*' {
				star = p
				resume = n
				p++
				continue
			}
			let step = p < pattern.len() ?? (globStep(pattern, p, name[n]), -1)
			if step > 0 {
				p += step
				n++
				continue
			}
			return false when star < 0
			p = star + 1
			resume++
			n = resume
		}
		for p < pattern.len() && pattern[p] == '*' {
			p++
		}
		return p == pattern.len()
	}

	// How many characters of `pattern` at `at` took `c`, 0 when they do not.
	internal def globStep(pattern string, at int, c char) int {
		let token = pattern[at]
		return 1 when token == '?'
		return token == c ?? (1, 0) unless token == '['
		let i = at + 1
		let negated = i < pattern.len() && (pattern[i] == '!' || pattern[i] == '^')
		i++ when negated
		let start = i
		let found = false
		for i < pattern.len() && (pattern[i] != ']' || i == start) {
			if i + 2 < pattern.len() && pattern[i + 1] == '-' && pattern[i + 2] != ']' {
				found = true when pattern[i] <= c && c <= pattern[i + 2]
				i += 3
				continue
			}
			found = true when pattern[i] == c
			i++
		}
		return token == c ?? (1, 0) when i >= pattern.len()
		return found != negated ?? (i - at + 1, 0)
	}

	// The shared MIME database's answers, read from its `mime` folders, the most
	// important first: which type a file name is, and what its icon is called.
	internal type MimeDatabase {
		// By whole name, and by what follows a dot (`tar.gz`, `gz`). A rule that cares
		// about case comes first: `*.C` is C++ and `*.c` is C. The others are kept under
		// lower case.
		exactNames map<string, MimeGlob> = map<string, MimeGlob>{}
		exactTails map<string, MimeGlob> = map<string, MimeGlob>{}
		looseNames map<string, MimeGlob> = map<string, MimeGlob>{}
		looseTails map<string, MimeGlob> = map<string, MimeGlob>{}
		complex    MimeGlob[]            = []
		icons      map<string, string>   = map<string, string>{}
		generics   map<string, string>   = map<string, string>{}
		aliases    map<string, string>   = map<string, string>{}

		def new(roots string[]) {
			let silenced = map<string, bool>{}
			for let root in roots {
				let seenHere string[]
				for let line in lines(root, "globs2") {
					let parts = line.split(":")
					continue when parts.len() < 3
					let mime = parts[1]
					if parts[2] == "__NOGLOBS__" {
						seenHere.push(mime)
						continue
					}
					continue when silenced.hasKey(mime)
					let weight = parseInt<int>(parts[0])
					let exact = parts.len() > 3 && parts[3].split(",").includes("cs")
					add(MimeGlob{weight: weight, mime: mime, pattern: parts[2], caseSensitive: exact})
				}
				for let mime in seenHere {
					silenced[mime] = true
				}
				pairs(root, "icons", ":", icons)
				pairs(root, "generic-icons", ":", generics)
				pairs(root, "aliases", " ", aliases)
			}
		}

		def lines(root string, name string) string[] {
			let raw = os.readFile("{root}/{name}") onerror recover byte[]
			let out string[]
			for let line in string(raw).split("\n") {
				out.push(line) unless line == "" || line.startsWith("#")
			}
			return out
		}

		// Reads `a<separator>b` lines; a folder read earlier wins.
		def pairs(root string, name string, separator string, into map<string, string>) {
			for let line in lines(root, name) {
				let at = line.indexOf(separator)
				continue when at <= 0
				let key = line[:at]
				into[key] = line[at + separator.len():] unless into.hasKey(key)
			}
		}

		def add(rule MimeGlob) {
			let pattern = rule.caseSensitive ?? (rule.pattern, rule.pattern.lower())
			let wild = pattern.indexOf("*") >= 0 || pattern.indexOf("?") >= 0 || pattern.indexOf("[") >= 0
			if !wild {
				keep(rule.caseSensitive ?? (exactNames, looseNames), pattern, rule)
				return
			}
			let tail = pattern.startsWith("*.") ?? (pattern[2:], "")
			if tail != "" && tail.indexOf("*") < 0 && tail.indexOf("?") < 0 && tail.indexOf("[") < 0 {
				keep(rule.caseSensitive ?? (exactTails, looseTails), tail, rule)
				return
			}
			complex.push(rule)
		}

		// A key keeps its heaviest rule, the first of those as heavy.
		def keep(into map<string, MimeGlob>, key string, rule MimeGlob) {
			let held = into.get(key)
			into[key] = rule when held is none || held.weight < rule.weight
		}

		// The type of a file name: its whole name, else the longest of what follows a dot,
		// else the heaviest and longest pattern. `application/octet-stream` when none does.
		def typeOf(name string) string {
			let lower = name.lower()
			let named = exactNames.get(name)
			return named.mime unless named is none
			named = looseNames.get(lower)
			return named.mime unless named is none
			let at = name.indexOf(".")
			for at >= 0 {
				let tail = exactTails.get(name[at + 1:])
				return tail.mime unless tail is none
				tail = looseTails.get(lower[at + 1:])
				return tail.mime unless tail is none
				let next = name[at + 1:].indexOf(".")
				at = next < 0 ?? (-1, at + 1 + next)
			}
			let best ?MimeGlob = none
			for let rule in complex {
				let matched = rule.caseSensitive ?? (mimeGlobMatches(rule.pattern, name), mimeGlobMatches(rule.pattern.lower(), lower))
				continue unless matched
				if best is none || rule.weight > best.weight || (rule.weight == best.weight && rule.pattern.len() > best.pattern.len()) {
					best = rule
				}
			}
			return best is none ?? ("application/octet-stream", best.mime)
		}

		// The names of a type's icon, the most exact first: what the database says, the
		// type's own, its generic one, its media's, and the one for anything.
		def iconNames(type_ string) string[] {
			let canonical = aliases.get(type_)
			let mime = canonical is none ?? (type_, canonical)
			let names string[]
			let own = icons.get(mime)
			names.push(own) unless own is none
			names.push(mime.replace("/", "-"))
			let generic = generics.get(mime)
			names.push(generic) unless generic is none
			let slash = mime.indexOf("/")
			names.push("{mime[:slash]}-x-generic") when slash > 0
			names.push("folder") when mime == "inode/directory"
			names.push("unknown")
			return names
		}
	}

	// Finds the file of an icon as the Icon Theme Specification says.
	internal type IconFinder {
		bases   string[]
		themes  map<string, IconTheme>           = map<string, IconTheme>{}
		listing map<string, map<string, string>> = map<string, map<string, string>>{}
		first   string

		def new(bases string[], first string) {
			self.bases = bases
			self.first = first
		}

		// A theme by name, read from the first base folder that has its index.
		def theme(name string) IconTheme {
			let held = themes.get(name)
			return held unless held is none
			let made = new IconTheme(name = name, inherits = [], dirs = [])
			for let base in bases {
				let raw = os.readFile("{base}/{name}/index.theme") onerror recover byte[]
				if raw.len() > 0 {
					made = iconThemeFrom(name, string(raw))
					break
				}
			}
			themes[name] = made
			return made
		}

		// The themes to look in: the theme, what it inherits, depth first, and hicolor.
		def chain() string[] {
			let out string[]
			visit(first, out)
			visit("hicolor", out)
			return out
		}

		def visit(name string, out string[]) {
			return when out.includes(name)
			out.push(name)
			for let parent in theme(name).inherits {
				visit(parent, out)
			}
		}

		// What a folder holds: icon names to their file's extension, png before svg before
		// xpm. Read once, as a theme has thousands of icons.
		def contents(folder string) map<string, string> {
			let held = listing.get(folder)
			return held unless held is none
			let out = map<string, string>{}
			for let entry in os.readDir(folder) onerror recover [] {
				let name = os.base(entry.path)
				let dot = name.lastIndexOf(".")
				continue when dot <= 0
				let (stem, extension) = (name[:dot], name[dot + 1:])
				continue unless extension == "png" || extension == "svg" || extension == "xpm"
				let had = out.get(stem)
				out[stem] = extension when had is none || extension == "png" || (extension == "svg" && had == "xpm")
			}
			listing[folder] = out
			return out
		}

		def fileIn(folder string, name string) ?string {
			let extension = contents(folder).get(name)
			return none when extension is none
			return "{folder}/{name}.{extension}"
		}

		// The icon in one theme: a directory made for the size, else the nearest.
		def inTheme(from IconTheme, name string, size int, scale int) ?string {
			for let dir in from.dirs {
				continue unless dir.holds(size, scale)
				for let base in bases {
					let found = fileIn("{base}/{from.name}/{dir.path}", name)
					return found unless found is none
				}
			}
			let nearest ?string = none
			let least = -1
			for let dir in from.dirs {
				let far = dir.distance(size, scale)
				continue unless least < 0 || far < least
				for let base in bases {
					let found = fileIn("{base}/{from.name}/{dir.path}", name)
					if !(found is none) {
						nearest = found
						least = far
						break
					}
				}
			}
			return nearest
		}

		// The file of the first of the names any theme has, else one lying in a base
		// folder itself.
		def find(names string[], size int, scale int) ?string {
			let themes = chain()
			for let name in names {
				for let from in themes {
					let found = inTheme(theme(from), name, size, scale)
					return found unless found is none
				}
				for let base in bases {
					let found = fileIn(base, name)
					return found unless found is none
				}
			}
			return none
		}
	}

	// The picture of an icon file, in the square of an icon. None when it cannot be read.
	internal def iconFromFile(path string) ?canvas.Picture {
		let data = os.readFile(path) onerror recover byte[]
		return none when data.len() == 0
		if path.endsWith(".svg") {
			let codec = new image.SVG()
			let info = codec.info(data) onerror (err error) {
				return none
			}
			let drawn = codec.picture(path) onerror (err error) {
				return none
			}
			return iconOfPicture(drawn, float(info.size.width), float(info.size.height))
		}
		if path.endsWith(".png") {
			let decoded = new image.PNG().decode(data) onerror (err error) {
				return none
			}
			return iconOfImage(decoded)
		}
		let decoded = new image.XPM().decode(data) onerror (err error) {
			return none
		}
		return iconOfImage(decoded)
	}

	internal def splitDirs(value ?string, otherwise string) string[] {
		let dirs string[]
		let text = value is none || value == "" ?? (otherwise, value)
		for let dir in text.split(":") {
			dirs.push(dir) unless dir == ""
		}
		return dirs
	}

	// The folders the data of the desktop is under, the most important first.
	internal def dataDirs() string[] {
		let dirs string[]
		let own = __env_get("XDG_DATA_HOME")
		let home = __env_get("HOME")
		if !(own is none) && own != "" {
			dirs.push(own)
		} else if !(home is none) {
			dirs.push("{home}/.local/share")
		}
		dirs = dirs.concat(splitDirs(__env_get("XDG_DATA_DIRS"), "/usr/local/share:/usr/share"))
		return dirs
	}

	// The Linux desktop's answers, read when first asked.
	internal type LinuxFileIcons {
		database MimeDatabase
		finder   IconFinder

		def new(database MimeDatabase, finder IconFinder) {
			self.database = database
			self.finder = finder
		}

		atomic def typeOf(name string) string {
			return database.typeOf(name)
		}

		atomic def file(kind string, size int, scale int) ?string {
			return finder.find(database.iconNames(kind), size, scale)
		}
	}

	internal def readLinuxFileIcons() LinuxFileIcons {
		let data = dataDirs()
		let mimeRoots string[]
		let bases string[]
		let home = __env_get("HOME")
		bases.push("{home}/.icons") unless home is none
		for let dir in data {
			mimeRoots.push("{dir}/mime")
			bases.push("{dir}/icons")
		}
		bases.push("/usr/share/pixmaps")
		return new LinuxFileIcons(new MimeDatabase(mimeRoots), new IconFinder(bases, desktop.readIconTheme()))
	}

	internal let linuxFileIcons = readLinuxFileIcons()

	internal def fileIconKind(path string) string {
		return "inode/directory" when fileIconIsFolder(path)
		return linuxFileIcons.typeOf(os.base(path))
	}

	internal def loadFileIcon(kind string, size int, scale int) ?canvas.Picture {
		let file = linuxFileIcons.file(kind, size, scale)
		return none when file is none
		return iconFromFile(file)
	}
}
