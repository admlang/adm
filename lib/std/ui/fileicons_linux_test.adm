@os("linux")
partial module std.ui {
	use (
		std.gfx.canvas
		std.os
		std.testing
		std.time
	)

	check "File icons on Linux" {
		// A folder of its own under the temporary folder, removed by the test.
		def scratch(name string) !string {
			let dir = os.join(os.tempDir(), "adm-fileicons-{name}-{time.now().unixNs()}")
			try os.mkdir(dir, parents = true)
			return dir
		}

		def write(dir string, name string, text string) !none {
			let path = os.join(dir, name)
			try os.mkdir(os.dir(path), parents = true)
			try os.writeFile(path, text.bytes())
		}

		def square(fill string) string {
			return "<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"8\" height=\"8\"><rect width=\"8\" height=\"8\" fill=\"{fill}\"/></svg>"
		}

		def database(globs string) !MimeDatabase {
			let dir = try scratch("mime")
			try write(dir, "globs2", globs)
			try write(dir, "icons", "text/x-own:own-icon\n")
			try write(dir, "generic-icons", "text/markdown:x-office-document\n")
			try write(dir, "aliases", "text/x-old text/markdown\n")
			let made = new MimeDatabase([dir])
			try os.remove(dir, recursive = true)
			return made
		}

		@test()
		def TestTypeOfAName() !none {
			let db = try database("60:text/x-readme:README:cs\n50:text/plain:*.txt\n50:text/x-c++src:*.C:cs\n50:text/x-c++src:*.C\n50:text/x-csrc:*.c:cs\n50:text/x-csrc:*.c\n50:application/x-tar:*.tar\n50:application/gzip:*.gz\n50:application/x-compressed-tar:*.tar.gz\n60:application/x-sharedlib:*.so.[0-9]*\n50:video/x-anim:*.anim[1-9j]\n40:text/low:core.*\n60:text/high:core.a*\n")
			assert db.typeOf("README") == "text/x-readme"
			assert db.typeOf("readme") == "application/octet-stream"
			assert db.typeOf("NOTES.TXT") == "text/plain"
			assert db.typeOf("main.C") == "text/x-c++src"
			assert db.typeOf("main.c") == "text/x-csrc"
			assert db.typeOf("x.tar.gz") == "application/x-compressed-tar"
			assert db.typeOf("x.gz") == "application/gzip"
			assert db.typeOf("libz.so.1") == "application/x-sharedlib"
			assert db.typeOf("a.anim5") == "video/x-anim"
			assert db.typeOf("a.animx") == "application/octet-stream"
			assert db.typeOf("core.abc") == "text/high"
			assert db.typeOf("core.xyz") == "text/low"
			assert db.typeOf("nothing") == "application/octet-stream"
		}

		// A folder later in the list has no say over a type an earlier one silenced.
		@test()
		def TestNoGlobsSilencesLaterFolders() !none {
			let first = try scratch("first")
			let second = try scratch("second")
			try write(first, "globs2", "50:text/x-silenced:__NOGLOBS__\n")
			try write(second, "globs2", "50:text/x-silenced:*.quiet\n50:text/x-kept:*.kept\n")
			let db = new MimeDatabase([first, second])
			try os.remove(first, recursive = true)
			try os.remove(second, recursive = true)
			assert db.typeOf("a.quiet") == "application/octet-stream"
			assert db.typeOf("a.kept") == "text/x-kept"
		}

		@test()
		def TestIconNamesOfAType() !none {
			let db = try database("")
			assert db.iconNames("text/markdown").join(" ") == "text-markdown x-office-document text-x-generic unknown"
			assert db.iconNames("text/x-old").join(" ") == "text-markdown x-office-document text-x-generic unknown"
			assert db.iconNames("text/x-own").join(" ") == "own-icon text-x-own text-x-generic unknown"
			assert db.iconNames("inode/directory").includes("folder")
		}

		@test()
		def TestGlobBrackets() {
			assert mimeGlobMatches("[0-9][0-9].vdr", "12.vdr") && !mimeGlobMatches("[0-9][0-9].vdr", "1a.vdr")
			assert mimeGlobMatches("*.[!a]", "x.b") && !mimeGlobMatches("*.[!a]", "x.a")
			assert mimeGlobMatches("[]x]y", "]y") && mimeGlobMatches("a?c*", "abcdef") && !mimeGlobMatches("a?c", "abcd")
			assert mimeGlobMatches("[abc", "[abc")
		}

		@test()
		def TestThemeDirectoryMatching() {
			let fixed = new IconThemeDir(path = "16", size = 16, kind = "Fixed")
			assert fixed.holds(16, 1) && !fixed.holds(17, 1) && !fixed.holds(16, 2)
			assert fixed.distance(22, 1) == 6
			let doubled = new IconThemeDir(path = "16@2", size = 16, scale = 2, kind = "Fixed")
			assert doubled.holds(16, 2) && doubled.distance(16, 1) == 16
			let scalable = new IconThemeDir(path = "sc", size = 48, minSize = 8, maxSize = 512, kind = "Scalable")
			assert scalable.holds(8, 1) && scalable.holds(512, 1) && !scalable.holds(600, 1)
			assert scalable.distance(600, 1) == 88 && scalable.distance(4, 1) == 4
			let near = new IconThemeDir(path = "th", size = 32)
			assert near.holds(30, 1) && near.holds(34, 1) && !near.holds(35, 1)
			assert near.distance(40, 1) == 6
		}

		@test()
		def TestIndexThemeSkipsOtherContexts() {
			let theme = iconThemeFrom("t", "# a comment\n[Icon Theme]\nName=T\nInherits=a, b\nDirectories=mimetypes/16,actions/16,places/22\nScaledDirectories=mimetypes/16@2\n[mimetypes/16]\nSize=16\nContext=MimeTypes\nType=Fixed\n[actions/16]\nSize=16\nContext=Actions\n[places/22]\nSize=22\nContext=Places\nType=Threshold\nThreshold=3\n[mimetypes/16@2]\nSize=16\nScale=2\nContext=Mimetypes\nType=Scalable\nMinSize=8\nMaxSize=32\n")
			assert theme.inherits.join(" ") == "a b"
			assert theme.dirs.len() == 3
			assert theme.dirs[0].path == "mimetypes/16" && theme.dirs[0].kind == "Fixed"
			assert theme.dirs[1].path == "places/22" && theme.dirs[1].threshold == 3
			assert theme.dirs[2].scale == 2 && theme.dirs[2].maxSize == 32
		}

		// A theme with artwork at two sizes, a parent, and hicolor beneath them.
		def themes() !string {
			let base = try scratch("themes")
			try write(base, "mine/index.theme", "[Icon Theme]\nInherits=parent\nDirectories=m/16,m/32,s\n[m/16]\nSize=16\nContext=MimeTypes\nType=Fixed\n[m/32]\nSize=32\nContext=MimeTypes\nType=Fixed\n[s]\nSize=48\nMinSize=8\nMaxSize=256\nContext=MimeTypes\nType=Scalable\n")
			try write(base, "parent/index.theme", "[Icon Theme]\nDirectories=m/16\n[m/16]\nSize=16\nContext=MimeTypes\nType=Fixed\n")
			try write(base, "hicolor/index.theme", "[Icon Theme]\nDirectories=m/16\n[m/16]\nSize=16\nContext=MimeTypes\nType=Fixed\n")
			try write(base, "mine/m/16/text-plain.svg", square("#ff0000"))
			try write(base, "mine/m/32/text-plain.svg", square("#00ff00"))
			try write(base, "mine/m/16/both.svg", square("#ff0000"))
			try write(base, "mine/m/16/both.png", "not read")
			try write(base, "mine/s/only-big.svg", square("#0000ff"))
			try write(base, "parent/m/16/from-parent.svg", square("#ff0000"))
			try write(base, "hicolor/m/16/from-hicolor.svg", square("#ff0000"))
			try write(base, "lying-loose.svg", square("#ff0000"))
			return base
		}

		def found(finder IconFinder, names string[], size int) string {
			let file = finder.find(names, size, 1)
			return file is none ?? ("", file)
		}

		@test()
		def TestFindingAnIconFile() !none {
			let base = try themes()
			let finder = new IconFinder([base], "mine")
			assert found(finder, ["text-plain"], 16) == "{base}/mine/m/16/text-plain.svg"
			assert found(finder, ["text-plain"], 32) == "{base}/mine/m/32/text-plain.svg"
			// No artwork made for 20: the nearest.
			assert found(finder, ["text-plain"], 20) == "{base}/mine/m/16/text-plain.svg"
			assert found(finder, ["only-big"], 16) == "{base}/mine/s/only-big.svg"
			assert found(finder, ["both"], 16) == "{base}/mine/m/16/both.png"
			assert found(finder, ["from-parent"], 16) == "{base}/parent/m/16/from-parent.svg"
			assert found(finder, ["from-hicolor"], 16) == "{base}/hicolor/m/16/from-hicolor.svg"
			assert found(finder, ["lying-loose"], 16) == "{base}/lying-loose.svg"
			// The first name any theme has wins over one further down the list.
			assert found(finder, ["nothing", "from-parent", "text-plain"], 16) == "{base}/parent/m/16/from-parent.svg"
			assert finder.find(["nothing"], 16, 1) is none
			try os.remove(base, recursive = true)
		}

		// A theme that inherits itself ends.
		@test()
		def TestThemesThatInheritInACircle() !none {
			let base = try scratch("circle")
			try write(base, "a/index.theme", "[Icon Theme]\nInherits=b\nDirectories=\n")
			try write(base, "b/index.theme", "[Icon Theme]\nInherits=a\nDirectories=\n")
			let finder = new IconFinder([base], "a")
			assert finder.chain().join(" ") == "a b hicolor"
			assert finder.find(["x"], 16, 1) is none
			try os.remove(base, recursive = true)
		}

		// An icon file as a picture: in the square of an icon, whatever its own size.
		@test()
		def TestPictureOfAnIconFile() !none {
			let base = try themes()
			let icon = iconFromFile("{base}/mine/m/16/text-plain.svg")
			assert !(icon is none)
			return when icon is none
			let c = new canvas.Canvas(16, 16)
			icon.replay(c)
			let at = (8 * 16 + 8) * 4
			assert c.pixels[at] == 255 && c.pixels[at + 1] == 0 && c.pixels[at + 3] == 255
			let last = (15 * 16 + 15) * 4
			assert c.pixels[last + 3] == 255
			assert iconFromFile("{base}/mine/m/16/both.png") is none
			assert iconFromFile("{base}/missing.svg") is none
			try os.remove(base, recursive = true)
		}

		@test()
		def TestKindOfAPath() !none {
			let dir = try scratch("kind")
			assert fileIconIsFolder(dir)
			assert fileIconIsFolder("no/such/folder/")
			assert !fileIconIsFolder(os.join(dir, "no-such-file"))
			try write(dir, "a.txt", "")
			assert !fileIconIsFolder(os.join(dir, "a.txt"))
			assert fileIconExtensionKind(os.join(dir, "a.TXT")) == ".txt"
			assert fileIconExtensionKind("Makefile") == "file"
			assert fileIconExtensionKind(dir) == "folder"
			try os.remove(dir, recursive = true)
		}

		// One picture per kind of file and size, and none is remembered too.
		@test()
		def TestCacheHoldsOneIconPerKind() {
			let held = new FileIconCache()
			assert !held.knows("a")
			held.put("a", none)
			assert held.knows("a") && held.get("a") is none
		}
	}
}
