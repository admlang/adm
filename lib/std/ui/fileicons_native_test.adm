@os("windows", "darwin")
partial module std.ui {
	use (
		std.gfx.canvas
		std.testing
	)

	check "File icons from the system" {
		// How many pixels of an icon of this kind show, drawn in the square it is made for.
		def inkOf(kind string, size int) int {
			let icon = loadFileIcon(kind, size, 1)
			assert !(icon is none)
			return 0 when icon is none
			let c = new canvas.Canvas(16, 16)
			icon.replay(c)
			let ink = 0
			for let i = 3; i < c.pixels.len(); i += 4 {
				ink++ when c.pixels[i] > 0
			}
			return ink
		}

		// A kind the system knows, one it does not, and no kind at all each have an icon,
		// the file existing or not, at a small size and a large one.
		@test()
		def TestEveryKindHasAnIcon() {
			for let kind in ["folder", "file", ".txt", ".zzz-no-such-type"] {
				assert inkOf(kind, 16) > 0
				assert inkOf(kind, 256) > 0
			}
		}

		@test()
		def TestAFileByItsPath() {
			assert fileIconKind("C:/no/such/folder/notes.TXT") == ".txt"
			assert fileIconKind("no/such/folder/") == "folder"
			assert !(fileIconAt("no/such/notes.txt", 16, 1) is none)
		}
	}
}
