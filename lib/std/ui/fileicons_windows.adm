@os("windows")
@link("gdi32")
@link("ole32")
partial module std.ui {
	use (
		std.formats.image
		std.gfx.canvas
	)

	// The side of the system's image list that holds an icon of `want` pixels
	// (fileicons_win32.h).
	@c("fileicons_win32.h", symbol = "adm_file_icon_side", ret = "int64_t", params = ["int64_t"])
	internal def winFileIconSide(want int) int;

	// Fills `out`, `side` squared RGBA pixels with straight alpha, with the icon of a kind
	// of file: 1 when it did, 0 when the system has none.
	@c("fileicons_win32.h", symbol = "adm_file_icon_read", ret = "int32_t", params = ["const char*", "int32_t", "int64_t", "uint8_t*"])
	internal def winFileIconRead(name string, folder int32, side int, out byte[]) int32;

	internal def fileIconKind(path string) string {
		return fileIconExtensionKind(path)
	}

	internal def loadFileIcon(kind string, size int, scale int) ?canvas.Picture {
		let side = winFileIconSide(size * scale)
		return none when side <= 0
		let img = new image.Image(side, side)
		return none when winFileIconRead(kind, kind == "folder" ?? (int32(1), int32(0)), side, img.raw()) == 0
		return iconOfImage(img)
	}
}
