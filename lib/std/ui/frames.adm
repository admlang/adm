// Frames asked for outside the windows' loop. `Component.redraw()` in the prelude calls
// `askFrame`; the UI service takes the request on its next pass and is woken for it.
// This file names nothing else, so that a program without a window loads it alone.
//
// It is the plumbing between the prelude and the UI service: applications call `redraw()`
// and `focus()` on a component, or `UI.redraw()`.
internal module std.ui.frames {
	// What was asked since the loop last looked, how the loop is woken, and the task that
	// is running a frame's views again (0: none).
	internal type FrameAsks {
		asked    bool
		// Whether a scene asked for the layout after one that moved something (`askSettle`).
		settle   bool
		// How many times the theme changed (`themeChanged`).
		themes   int
		wake     ?(def())    = none
		running  uint
		// Whether a window is being drawn, the task that draws it (0 off any task), and
		// how many times a component asked for a frame from its `render` on that task.
		painting bool
		painter  uint
		repaints int
		// The component that asked for the keyboard focus last and does not have it yet.
		focus    ?component  = none
		// How many windows looked at that request in the pass under way and found the
		// component was not theirs.
		looks    int
		// The components that asked to be scrolled into view and were not yet, and how
		// many passes over the windows they waited.
		reveals  component[]
		waited   int
	}

	internal let asks = new FrameAsks()

	// The task the caller runs on, as the scheduler names it; 0 off any task.
	@c("", symbol = "adm_sched_current", ret = "void*")
	internal def currentTask() uint;

	// Asks for the windows to be drawn again, from any task.
	//
	// A call from the task that is running a frame's views again asks for nothing: a view
	// that passes a child a changed argument has the child ask to be drawn, and the frame
	// under way is that drawing. A call from a component's `render` asks for that
	// component to be drawn again and nothing else; with `whole`, for a frame that runs
	// the views, the styles and the layout too, as a call from anywhere else does.
	def askFrame(whole bool = false) {
		return when asks.running != 0 && currentTask() == asks.running
		// The drawing under way notes which component asked, and the window draws it alone.
		if !whole && asks.painting && currentTask() == asks.painter {
			asks.repaints++
			return
		}
		asks.asked = true
		let wake = asks.wake
		wake() unless wake is none
	}

	// Asks for the keyboard focus to go to `wanted` once the frame that lays it out has
	// run; a later call replaces an earlier one. Unlike `askFrame`, only from the task
	// that runs the windows: the request is a reference that task reads and clears.
	def askFocus(wanted component) {
		asks.focus = wanted
		asks.looks = 0
		askFrame()
	}

	// Asks for `wanted` to be scrolled into view once the frame that lays it out has run.
	// From the task that runs the windows, as `askFocus`.
	def askReveal(wanted component) {
		asks.reveals.push(wanted)
		asks.waited = 0
		askFrame()
	}

	// The components `askReveal` was called for that no window has shown yet. For the
	// view runtime, which gives back with `revealsLeft` those that are not its own.
	def revealsAsked() component[] {
		return asks.reveals
	}

	def revealsLeft(left component[]) {
		asks.reveals = left
	}

	// The component `askFocus` was last called for; none when none waits. For the view
	// runtime, which calls `focusGiven` once it gave that component the focus.
	def focusAsked() ?component {
		return asks.focus
	}

	// Says that the component `focusAsked` named has the focus or cannot take it.
	def focusGiven() {
		asks.focus = none
		asks.looks = 0
	}

	// Says that a window found the component `focusAsked` named is not in it. For the
	// view runtime.
	def focusLooked() {
		asks.looks += 1
	}

	// Ends a pass over the program's `windows` windows: a request every one of them
	// looked at in this pass and none took is for a component in no window, and is
	// dropped. One a window has not looked at yet (it is hidden, or the request came
	// after its turn) waits. For the UI service.
	def focusPassed(windows int) {
		// A component no window showed in a whole pass is in none.
		if asks.reveals.len() > 0 {
			asks.waited++
			asks.reveals.len(0) when asks.waited > 1
		}
		if asks.looks >= windows && windows > 0 {
			focusGiven()
			return
		}
		asks.looks = 0
	}

	// Asks for one more frame because a layout moved something that a style reads from
	// another component (`$parent.geom`). Kept apart from `askFrame`: a frame drawn for this
	// alone continues a chain of such layouts, which the view runtime counts. For the view
	// runtime, from the task that runs the windows.
	def askSettle() {
		asks.settle = true
		let wake = asks.wake
		wake() unless wake is none
	}

	// Whether `askSettle` was called since the last call. For the UI service.
	def settleAsked() bool {
		let was = asks.settle
		asks.settle = false
		return was
	}

	// Says that the theme styles read has other values now, and asks for a frame: every
	// style then takes again what its body assigns from `theme`. `Theme.follow` calls it;
	// code that changes a theme's fields by hand calls it after.
	def themeChanged() {
		asks.themes += 1
		askFrame(true)
	}

	// How many times `themeChanged` was called. For the view runtime.
	def themeVersion() int {
		return asks.themes
	}

	// Whether a frame was asked for since the last call. For the UI service.
	def frameAsked() bool {
		let was = asks.asked
		asks.asked = false
		return was
	}

	// Says that the calling task starts (`on`) or finished running a frame's views again.
	// For the view runtime.
	def frameRunning(on bool) {
		asks.running = on ?? (currentTask(), 0)
	}

	// Says that the calling task starts (`on`) or finished drawing a window. For the view
	// runtime.
	def framePainting(on bool) {
		asks.painting = on
		asks.painter = on ?? (currentTask(), 0)
	}

	// How many times a component asked for a frame from its `render` so far: a count
	// that changed across a `render` means that component asked. For the view runtime.
	def repaintsAsked() int {
		return asks.repaints
	}

	// Sets what `askFrame` calls to wake the windows' loop; none: nothing. For the UI
	// service.
	def onFrameAsked(wake ?(def())) {
		asks.wake = wake
	}
}
