// Frames asked for outside the windows' loop. `Component.redraw()` in the prelude calls
// `askFrame`; the UI service takes the request on its next pass and is woken for it.
// This file names nothing else, so that a program without a window loads it alone.
//
// It is the plumbing between the prelude and the UI service: applications call `redraw()`
// and `focus()` on a component, or `UI.redraw()`.
internal module std.ui.frames {
	use (
		std.math.geom::Rect
		std.units::Pixels
	)

	// What was asked since the loop last looked, how the loop is woken, and the task that
	// is running a frame's views again (0: none).
	internal type FrameAsks {
		asked     bool
		// The components that asked for part of them to be drawn again (`redraw(rect)`)
		// and the part each asked for, in logical pixels of the window.
		parted    component[]
		parts     Rect<Pixels>[]
		// Whether a scene asked for the layout after one that moved something (`askSettle`).
		settle    bool
		// How many times the theme changed (`themeChanged`).
		themes    int
		wake      ?(def())       = none
		// Whether a frame's views are running again, and the task that runs them (0 off
		// any task: the windows' loop runs on the main thread).
		viewing   bool
		running   uint
		// Whether a window is being drawn, the task that draws it (0 off any task), and
		// how many times a component asked for a frame from its `render` on that task.
		painting  bool
		painter   uint
		repaints  int
		// The component whose `render` runs, and those that asked from it for a whole
		// frame (`askFrame(true)`): the frame after runs their views again.
		rendering ?component     = none
		rebuilds  component[]
		// The components whose view reads a component that was marked (`ref`), to run
		// again after the frame's layout; whether the view runtime is marking those of the
		// frame before, which follows nothing further.
		follows   component[]
		following bool
		// The task that brings a frame's nodes in step, lays them out or draws them (0:
		// none): what a field store there leaves is that frame's own (`frameWorking`).
		working   bool
		worker    uint
		// The components whose view runs are under way, the innermost last: what they
		// store is never the frame's own work.
		viewers   component[]
		// Whether the frame under way runs every view (`rebuildingAll`), and how many
		// times something asked for that (`askAll`).
		all       bool
		wholes    int
		// The component that asked for the keyboard focus last and does not have it yet.
		focus     ?component     = none
		// How many windows looked at that request in the pass under way and found the
		// component was not theirs.
		looks     int
		// The components that asked to be scrolled into view and were not yet, and how
		// many passes over the windows they waited.
		reveals   component[]
		waited    int
	}

	internal let asks = new FrameAsks()

	// The task the caller runs on, as the scheduler names it; 0 off any task.
	@c("", symbol = "adm_sched_current", ret = "void*")
	def currentTask() uint;

	// Asks for the windows to be drawn again, from any task.
	//
	// A call from the task that is running a frame's views again asks for nothing: a view
	// that passes a child a changed argument has the child ask to be drawn, and the frame
	// under way is that drawing. A call from a component's `render` asks for that
	// component to be drawn again and nothing else; with `whole`, for a frame that runs
	// the views, the styles and the layout too, as a call from anywhere else does.
	def askFrame(whole bool = false) {
		return when asks.viewing && currentTask() == asks.running
		if asks.painting && currentTask() == asks.painter {
			// The drawing under way notes which component asked, and the window draws it
			// alone.
			if !whole {
				asks.repaints++
				return
			}
			// What its view and style read changed in its drawing (a list's rows did not
			// fit): the next frame runs them again.
			let who = asks.rendering
			asks.rebuilds.push(who) unless who is none
		}
		// Asked already and not taken yet: the loop was woken for it.
		return when asks.asked
		asks.asked = true
		let wake = asks.wake
		wake() unless wake is none
	}

	// Where a `redraw()` was called from: the run of a frame's views (a view passed the
	// component another argument), a `render`, anywhere else.
	enum RedrawFrom {
		View,
		Render,
		Elsewhere,
	}

	// Asks for `who` to be drawn again (`Component.redraw()`): as `askFrame`, and marks
	// the component (`isRedrawn`), whose drawing then counts as changed however it
	// compares with the last one: what it draws may have changed in place. Says where
	// it was called from, which tells the component what to mark.
	def askRedraw(who component) RedrawFrom {
		who.isRedrawn = true
		// All of it: a part asked for before the frame is of no account any more.
		dropPart(who)
		return redrawFrom()
	}

	// `askRedraw` for part of the component (`redraw(rect)`, the rect in logical pixels of
	// the window as `style.geom.frame` is): the frame's drawing diff (`redrawPartOf`) shows
	// that much of the component again rather than all of it. A second part asked before
	// the frame widens it to the box around both; a `redraw()` of all of it drops it.
	def askRedrawPart(who component, part Rect<Pixels>) RedrawFrom {
		who.isRedrawn = true
		let at = asks.parted.len()
		for let (i, held) in asks.parted {
			at = i when held == who
		}
		if at == asks.parted.len() {
			asks.parted.push(who)
			asks.parts.push(part)
		} else {
			asks.parts[at] = around(asks.parts[at], part)
		}
		return redrawFrom()
	}

	// The part the component asked to be drawn again since the last drawing, taken out;
	// none when it asked for all of it, or for nothing.
	def redrawPartOf(who component) ?Rect<Pixels> {
		for let (i, held) in asks.parted {
			continue unless held == who
			let part = asks.parts[i]
			dropPart(who)
			return part
		}
		return none
	}

	// Forgets the part the component asked for.
	internal def dropPart(who component) {
		let whos component[]
		let parts Rect<Pixels>[]
		for let (i, held) in asks.parted {
			continue when held == who
			whos.push(held)
			parts.push(asks.parts[i])
		}
		asks.parted = whos
		asks.parts = parts
	}

	// The box around two parts.
	internal def around(a Rect<Pixels>, b Rect<Pixels>) Rect<Pixels> {
		return Rect<Pixels>{left: float(a.left).min(float(b.left)) * 1(px), top: float(a.top).min(float(b.top)) * 1(px), right: float(a.right).max(float(b.right)) * 1(px), bottom: float(a.bottom).max(float(b.bottom)) * 1(px)}
	}

	// Where a redraw was asked from: a view run, a render, or elsewhere, which asks for
	// a frame.
	internal def redrawFrom() RedrawFrom {
		if asks.viewing && currentTask() == asks.running {
			return RedrawFrom.View
		}
		if asks.painting && currentTask() == asks.painter {
			asks.repaints++
			return RedrawFrom.Render
		}
		askFrame()
		return RedrawFrom.Elsewhere
	}

	// Asks for a frame that runs every view, brings every node in step and draws the
	// whole window: `UI.redraw()`, for what changed where no component says.
	def askAll() {
		asks.wholes += 1
		askFrame(true)
	}

	// How many times `askAll` was called. For the view runtime.
	def allVersion() int {
		return asks.wholes
	}

	// Says that the calling task starts (`on`) or finished running every view of a
	// frame. For the view runtime.
	def rebuildAll(on bool) {
		asks.all = on
	}

	// Whether the frame under way runs every view.
	def rebuildingAll() bool {
		return asks.all
	}

	// Says that the calling task starts (`on`) or finished bringing a frame's nodes in
	// step and laying them out. For the view runtime.
	def frameWorks(on bool) {
		asks.working = on
		asks.worker = on ?? (currentTask(), 0)
	}

	// Says that the view of `who` starts a run (`on`) or ended it. The compiler has every
	// run say so.
	def viewRunning(on bool, who component) {
		if on {
			asks.viewers.push(who)
		} else {
			let _ = asks.viewers.pop()
		}
	}

	// Whether the view of `who` is running, itself or a view or caller's block inside its
	// run: what is marked now is that run's doing (the arguments it passes, the styles it
	// gives, where the block of a call of its runs).
	def runsView(who component) bool {
		for let running in asks.viewers {
			return true when running == who
		}
		return false
	}

	// Whether the caller is the frame's own work: bringing its nodes in step, laying
	// them out, drawing them.
	def frameWorking() bool {
		return false unless asks.working || asks.painting
		return false when asks.viewers.len() > 0
		let task = currentTask()
		return (asks.working && task == asks.worker) || (asks.painting && task == asks.painter)
	}

	// Whether a store of a field of `who` marks it (`Component._touched`). What the frame's
	// own work keeps marks nothing, since the frame shows it: any store while it brings its
	// nodes in step and lays them out, and while it draws, one of the component whose
	// `render` runs. A `render` that changes another component (scrolls a scroll view to an
	// anchor) changes what the frame laid out: that one is marked, and the frame after the
	// drawing shows it.
	def storeMarks(who component) bool {
		return true unless frameWorking()
		return false unless asks.painting && currentTask() == asks.painter
		let drawing = asks.rendering
		return false when !(drawing is none) && drawing == who
		asks.asked = true
		let wake = asks.wake
		wake() unless wake is none
		return true
	}

	// Asks for the keyboard focus to go to `wanted` once the frame that lays it out has
	// run; a later call replaces an earlier one. Unlike `askFrame`, only from the task
	// that runs the windows: the request is a reference that task reads and clears.
	def askFocus(wanted component) {
		asks.focus = wanted
		asks.looks = 0
		askFrame()
	}

	// Asks for `wanted` to be scrolled into view once the frame that lays it out has run.
	// From the task that runs the windows, as `askFocus`.
	def askReveal(wanted component) {
		asks.reveals.push(wanted)
		asks.waited = 0
		askFrame()
	}

	// The components `askReveal` was called for that no window has shown yet. For the
	// view runtime, which gives back with `revealsLeft` those that are not its own.
	def revealsAsked() component[] {
		return asks.reveals
	}

	def revealsLeft(left component[]) {
		asks.reveals = left
	}

	// The component `askFocus` was last called for; none when none waits. For the view
	// runtime, which calls `focusGiven` once it gave that component the focus.
	def focusAsked() ?component {
		return asks.focus
	}

	// Says that the component `focusAsked` named has the focus or cannot take it.
	def focusGiven() {
		asks.focus = none
		asks.looks = 0
	}

	// Says that a window found the component `focusAsked` named is not in it. For the
	// view runtime.
	def focusLooked() {
		asks.looks += 1
	}

	// Ends a pass over the program's `windows` windows: a request every one of them
	// looked at in this pass and none took is for a component in no window, and is
	// dropped. One a window has not looked at yet (it is hidden, or the request came
	// after its turn) waits. For the UI service.
	def focusPassed(windows int) {
		// A component no window showed in a whole pass is in none.
		if asks.reveals.len() > 0 {
			asks.waited++
			asks.reveals.len(0) when asks.waited > 1
		}
		if asks.looks >= windows && windows > 0 {
			focusGiven()
			return
		}
		asks.looks = 0
	}

	// Asks for one more frame because a layout moved something that a style reads from
	// another component (`$parent.geom`). Kept apart from `askFrame`: a frame drawn for this
	// alone continues a chain of such layouts, which the view runtime counts. For the view
	// runtime, from the task that runs the windows.
	def askSettle() {
		asks.settle = true
		let wake = asks.wake
		wake() unless wake is none
	}

	// Whether `askSettle` was called since the last call. For the UI service.
	def settleAsked() bool {
		let was = asks.settle
		asks.settle = false
		return was
	}

	// Says that the theme styles read has other values now, and asks for a frame: every
	// style then takes again what its body assigns from `theme`. `Theme.follow` calls it;
	// code that changes a theme's fields by hand calls it after.
	def themeChanged() {
		asks.themes += 1
		askFrame(true)
	}

	// How many times `themeChanged` was called. For the view runtime.
	def themeVersion() int {
		return asks.themes
	}

	// Whether a frame was asked for since the last call. For the UI service.
	def frameAsked() bool {
		let was = asks.asked
		asks.asked = false
		return was
	}

	// Says that the calling task starts (`on`) or finished running a frame's views again.
	// For the view runtime.
	def frameRunning(on bool) {
		asks.viewing = on
		asks.running = on ?? (currentTask(), 0)
	}

	// Says that the calling task starts (`on`) or finished drawing a window. For the view
	// runtime.
	def framePainting(on bool) {
		asks.painting = on
		asks.painter = on ?? (currentTask(), 0)
	}

	// Says that the `render` of `who` starts, while a window is drawn; returns the
	// component whose `render` it runs inside, for `rendered`. For the render passes.
	def rendering(who component) ?component {
		let outer = asks.rendering
		asks.rendering = who
		return outer
	}

	// Says that the `render` `rendering` named ended, inside that of `outer`.
	def rendered(outer ?component) {
		asks.rendering = outer
	}

	// The components that asked from their `render` for a whole frame since the last
	// call. For the view runtime, which marks them.
	def takeRebuilds() component[] {
		return asks.rebuilds when asks.rebuilds.len() == 0
		let taken = asks.rebuilds
		asks.rebuilds = []
		return taken
	}

	// Notes that the view of `who` reads a component that was just marked, as the next
	// layout leaves it: the frame after that layout runs it again (`takeFollows`).
	def follow(who component) {
		// No windows' loop (`onFrameAsked`), no frame to take it: kept, it would
		// keep the component alive for good.
		return when asks.following || asks.wake is none
		for let held in asks.follows {
			return when held == who
		}
		asks.follows.push(who)
	}

	// The components `follow` noted since the last call. For the view runtime.
	def takeFollows() component[] {
		return asks.follows when asks.follows.len() == 0
		let taken = asks.follows
		asks.follows = []
		return taken
	}

	// Says that the view runtime marks (`on`) or finished marking the components it took
	// with `takeFollows`.
	def marksFollows(on bool) {
		asks.following = on
	}

	// How many times a component asked for a frame from its `render` so far: a count
	// that changed across a `render` means that component asked. For the view runtime.
	def repaintsAsked() int {
		return asks.repaints
	}

	// Sets what `askFrame` calls to wake the windows' loop; none: nothing. For the UI
	// service.
	def onFrameAsked(wake ?(def())) {
		asks.wake = wake
		// The loop stopped: what it was to follow goes, as `follow` keeps nothing
		// from now on.
		asks.follows = [] when wake is none
	}
}
