partial module std.ui {
	use (
		std.math.geom::Rect
		std.testing
		std.ui.frames
		std.units::Pixels
	)

	component Redrawn {
		view {}
		style {}
		type {}
	}

	check "Frames" {
		// A `redraw()` from the component's own `render` asks for that render alone;
		// from another component's `render` it is as from anywhere else: the component
		// is marked and a frame is asked for.
		@test()
		def TestRedrawFromAnotherRender() {
			let a = Redrawn()
			let b = Redrawn()
			let _ = frames.frameAsked()
			frames.framePainting(true)
			let outer = frames.rendering(a)
			assert frames.askRedraw(a) == frames.RedrawFrom.Render
			assert !frames.frameAsked()
			assert frames.askRedraw(b) == frames.RedrawFrom.Elsewhere
			assert frames.frameAsked()
			let part = Rect<Pixels>{left: 0(px), top: 0(px), right: 1(px), bottom: 1(px)}
			assert frames.askRedrawPart(b, part) == frames.RedrawFrom.Elsewhere
			assert frames.frameAsked()
			frames.rendered(outer)
			frames.framePainting(false)
			assert frames.askRedraw(b) == frames.RedrawFrom.Elsewhere
			assert frames.frameAsked()
		}
	}
}
