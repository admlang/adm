partial module std.ui {
	use (
		std.math.geom::Rect
		std.ui.styles::(AnchorEdge, AnchorLine, Direction)
		std.units::Pixels
	)

	// The most space on offer to a component being measured; none on an axis means
	// unbounded.
	struct Limit {
		width  ?Pixels = none
		height ?Pixels = none
	}

	// Where layout put a component, in logical pixels. A component reads its own as
	// `style.geom`.
	struct Geometry {
		// The border box in the parent's content coordinates.
		bounds    Rect<Pixels>
		// The border box in window coordinates.
		frame     Rect<Pixels>
		// The area children and text are placed in: the border box minus border and padding,
		// in the component's own coordinates.
		content   Rect<Pixels>
		// The distance from the top of the border box to the first text baseline; none when
		// the component has no text.
		baseline  ?Pixels      = none
		// The direction it lays its content out in: its style's, or the one it inherits.
		direction Direction    = Direction.LeftToRight

		// Its lines, for another component's anchors: `anchors = {top: $trigger.geom.bottom}`.
		// For the numbers, read `bounds` or `frame`.
		left    AnchorLine = new AnchorLine(none, AnchorEdge.Left)
		top     AnchorLine = new AnchorLine(none, AnchorEdge.Top)
		right   AnchorLine = new AnchorLine(none, AnchorEdge.Right)
		bottom  AnchorLine = new AnchorLine(none, AnchorEdge.Bottom)
		centerX AnchorLine = new AnchorLine(none, AnchorEdge.CenterX)
		centerY AnchorLine = new AnchorLine(none, AnchorEdge.CenterY)
	}
}
