internal std.ui partial module std.ui.host.browser {
	use (
		std.math.geom::(Point, Size)
		std.ui
		std.ui.renderer as r
		std.ui.styles::Cursor
	)

	// One event of the page's windows as the loader reports it
	// (internal/backend/web/loader.js, PageHost): positions and sizes in device
	// pixels of the window's canvas, the kind, keys and state by their names in
	// `PlatformEventKind`, `std.ui.Key` and `WindowState`.
	struct PageEvent {
		kind   string
		window uint
		x, y   float
		dx, dy float
		width  float
		height float
		// `MouseButton`'s value: 0 left, 1 right, 2 middle.
		button int
		clicks int          = 1
		key    string       = ""
		code   string       = ""
		repeat bool
		text   string       = ""
		caret  int
		files  string[]     = []
		state  string       = ""
		mods   ui.Modifiers = ui.Modifiers{}
		// Device pixels per CSS pixel where the event happened.
		scale  float        = 1.0
	}

	// The events `hostPoll` answers with.
	internal struct PageEvents {
		value PageEvent[] = []
	}

	// The names the page gives keys and event kinds, read from the enums
	// themselves so that the two sides cannot drift apart.
	type PageNames {
		keys  map<string, ui.Key>
		kinds map<string, r.PlatformEventKind>

		def new() {
			keys = map<string, ui.Key>{}
			for let (at, name) in ui.Key.keys() {
				keys = keys.set(name, ui.Key(at))
			}
			kinds = map<string, r.PlatformEventKind>{}
			for let (at, name) in r.PlatformEventKind.keys() {
				kinds = kinds.set(name, r.PlatformEventKind(at))
			}
		}

		// The key the page names; `Unknown` for a name `Key` does not have.
		def key(name string) ui.Key {
			let found = keys.get(name)
			return found is none ?? (ui.Key.Unknown, found)
		}

		// The platform event the page's event is, or none for a kind the UI has no
		// event for.
		def platformEvent(e PageEvent) ?r.PlatformEvent {
			let kind = kinds.get(e.kind)
			return none when kind is none || kind == r.PlatformEventKind.None
			let event = r.PlatformEvent{kind: kind, window: e.window}
			event.position = new Point(e.x, e.y)
			event.delta = new Point(e.dx, e.dy)
			event.size = new Size(e.width, e.height)
			event.modifiers = e.mods
			event.text = e.text
			event.files = e.files
			event.caret = e.caret
			event.clicks = e.clicks
			match kind {
				case r.PlatformEventKind.MouseDown, r.PlatformEventKind.MouseUp:
					event.button = e.button == 1 ?? (ui.MouseButton.Right, e.button == 2 ?? (ui.MouseButton.Middle, ui.MouseButton.Left))
				case r.PlatformEventKind.KeyDown, r.PlatformEventKind.KeyUp:
					event.key = key(e.key)
					event.code = key(e.code)
					event.repeat = e.repeat
				case r.PlatformEventKind.StateChange:
					event.state = stateNamed(e.state)
				default:
			}
			return event
		}
	}

	// The window state the page names; Normal for any other name.
	internal def stateNamed(name string) ui.WindowState {
		switch name {
			case "Fullscreen":
				return ui.WindowState.Fullscreen
			case "Maximized":
				return ui.WindowState.Maximized
			case "Minimized":
				return ui.WindowState.Minimized
			default:
				return ui.WindowState.Normal
		}
	}

	// The CSS cursor that shows the pointer shape.
	internal def cssCursor(cursor Cursor) string {
		match cursor {
			case Cursor.Pointer, Cursor.Link:
				return "pointer"
			case Cursor.Text:
				return "text"
			case Cursor.Crosshair:
				return "crosshair"
			case Cursor.Move:
				return "move"
			case Cursor.Grab:
				return "grab"
			case Cursor.Grabbing:
				return "grabbing"
			case Cursor.NotAllowed:
				return "not-allowed"
			case Cursor.Wait:
				return "wait"
			case Cursor.Progress:
				return "progress"
			case Cursor.Help:
				return "help"
			case Cursor.ResizeHorizontal:
				return "ew-resize"
			case Cursor.ResizeVertical:
				return "ns-resize"
			case Cursor.ResizeDiagonalDown:
				return "nwse-resize"
			case Cursor.ResizeDiagonalUp:
				return "nesw-resize"
			case Cursor.ResizeColumn:
				return "col-resize"
			case Cursor.ResizeRow:
				return "row-resize"
			case Cursor.ZoomIn:
				return "zoom-in"
			case Cursor.ZoomOut:
				return "zoom-out"
			case Cursor.Copy:
				return "copy"
			case Cursor.Hidden:
				return "none"
			default:
				return "default"
		}
	}
}
