internal std.ui partial module std.ui.host.browser {
	use (
		std.data.encoding::(JSON)
		std.testing
		std.ui
		std.ui.renderer as r
		std.ui.styles::Cursor
	)

	check "browser host events" {
		// The platform events for the page's `hostPoll` answer; one of kind None
		// stands for an event that gives none.
		def decode(answer string) !r.PlatformEvent[] {
			let queued = PageEvents{}
			try new JSON().decode(answer, queued)
			let names = new PageNames()
			let out r.PlatformEvent[]
			for let e in queued.value {
				let found = names.platformEvent(e)
				out.push(found is none ?? (r.PlatformEvent{kind: r.PlatformEventKind.None}, found))
			}
			return out
		}

		// Keys and event kinds arrive by their member names, positions in device
		// pixels, the modifiers as `Modifiers`' fields.
		@test()
		def TestKeyEvents() !none {
			let events = try decode("\{\"value\": [\{\"kind\": \"KeyDown\", \"window\": 3, \"key\": \"C\", \"code\": \"C\", \"repeat\": true, \"text\": \"c\", \"mods\": \{\"shift\": false, \"control\": true, \"alt\": false, \"command\": false, \"mod\": true\}\}, \{\"kind\": \"KeyUp\", \"window\": 3, \"key\": \"KeypadEnter\", \"code\": \"KeypadEnter\"\}]\}")
			assert events.len() == 2
			let down = events[0]
			assert down.kind == r.PlatformEventKind.KeyDown && down.window == uint(3)
			assert down.key == ui.Key.C && down.code == ui.Key.C && down.repeat && down.text == "c"
			assert down.modifiers.control && down.modifiers.mod && !down.modifiers.shift
			assert events[1].kind == r.PlatformEventKind.KeyUp && events[1].key == ui.Key.KeypadEnter && !events[1].repeat
		}

		// A name `Key` does not have is Unknown; a kind the UI has no event for gives
		// none.
		@test()
		def TestUnknownNames() !none {
			let events = try decode("\{\"value\": [\{\"kind\": \"KeyDown\", \"window\": 1, \"key\": \"AudioVolumeUp\", \"code\": \"\"\}, \{\"kind\": \"Vibrate\", \"window\": 1\}, \{\"kind\": \"None\", \"window\": 1\}]\}")
			assert events.len() == 3
			assert events[0].kind == r.PlatformEventKind.KeyDown && events[0].key == ui.Key.Unknown && events[0].code == ui.Key.Unknown
			assert events[1].kind == r.PlatformEventKind.None && events[2].kind == r.PlatformEventKind.None
		}

		// Buttons by `MouseButton`'s value, clicks, the wheel's delta, a resize's size.
		@test()
		def TestPointerAndWindowEvents() !none {
			let events = try decode("\{\"value\": [\{\"kind\": \"MouseDown\", \"window\": 2, \"x\": 10.5, \"y\": 20, \"button\": 1, \"clicks\": 2\}, \{\"kind\": \"MouseUp\", \"window\": 2, \"button\": 2\}, \{\"kind\": \"MouseWheel\", \"window\": 2, \"x\": 4, \"y\": 5, \"dx\": 0, \"dy\": 96\}, \{\"kind\": \"Resize\", \"window\": 2, \"width\": 1600, \"height\": 900\}, \{\"kind\": \"StateChange\", \"window\": 2, \"state\": \"Fullscreen\"\}, \{\"kind\": \"Drop\", \"window\": 2, \"files\": [\"/tmp/dropped/a.png\"], \"text\": \"\"\}]\}")
			assert events.len() == 6
			let press = events[0]
			assert press.kind == r.PlatformEventKind.MouseDown && press.button == ui.MouseButton.Right && press.clicks == 2
			assert press.position.x == 10.5 && press.position.y == 20.0
			assert events[1].button == ui.MouseButton.Middle && events[1].clicks == 1
			assert events[2].kind == r.PlatformEventKind.MouseWheel && events[2].delta.y == 96.0 && events[2].position.x == 4.0
			assert events[3].size.width == 1600.0 && events[3].size.height == 900.0
			assert events[4].state == ui.WindowState.Fullscreen
			assert events[5].kind == r.PlatformEventKind.Drop && events[5].files.len() == 1 && events[5].files[0] == "/tmp/dropped/a.png"
		}

		@test()
		def TestStatesAndCursors() {
			assert stateNamed("Maximized") == ui.WindowState.Maximized && stateNamed("Minimized") == ui.WindowState.Minimized
			assert stateNamed("Normal") == ui.WindowState.Normal && stateNamed("") == ui.WindowState.Normal
			assert cssCursor(Cursor.Default) == "default" && cssCursor(Cursor.Link) == "pointer" && cssCursor(Cursor.Hidden) == "none"
			assert cssCursor(Cursor.ResizeDiagonalDown) == "nwse-resize" && cssCursor(Cursor.NotAllowed) == "not-allowed"
		}
	}
}
