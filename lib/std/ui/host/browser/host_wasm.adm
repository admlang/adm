@os("wasm")
internal std.ui partial module std.ui.host.browser {
	use (
		std.data.encoding::(Base64, JSON)
		std.formats.image
		std.math.geom::(Point, Rect, Size)
		std.ui
		std.ui.renderer as r
		std.ui.styles::Cursor
		std.units::Pixels
	)

	// The host on the web: each window is a canvas of the page with a WebGL 2
	// context. The first window takes the page's own canvas, which fills the page;
	// a window opened after it floats above the page. The page's viewport is the
	// desktop: `displays` reports it, and windows are placed in its CSS pixels,
	// which are the logical pixels of the UI.
	//
	// The page's loader (internal/backend/web/loader.js, PageHost) owns the
	// canvases and queues their DOM events; this host reads them in `poll`.
	type BrowserHost {
		internal names     PageNames
		internal windows   map<uint, bool>
		// What says, for each window that has one, where the window is dragged by.
		internal dragTests map<uint, def(Point<Pixels>) bool>
		// A frame was shown since the page last drew: `poll` waits for the next
		// animation frame before reading events, which paces the windows' loop to
		// the display as a swap with vsync does on the desktop.
		internal presented bool

		def new() {
			names = new PageNames()
			windows = map<uint, bool>{}
			dragTests = map<uint, def(Point<Pixels>) bool>{}
		}

		// Fails when the window is not one this host has open.
		internal def known(win r.Window) !uint {
			fail "unknown window {win.id()}" unless windows.hasKey(win.id())
			return win.id()
		}

		// Opens a window: the page's canvas first, a canvas floating above the page
		// after it.
		//
		// Fails when the page cannot give the canvas a WebGL 2 context.
		def openWindow(cfg r.WindowConfig) !r.Window {
			let args = OpenArgs{
				title:        cfg.title,
				width:        cfg.size.width,
				height:       cfg.size.height,
				decorated:    cfg.decorated,
				transparent:  cfg.transparent,
				alwaysOnTop:  cfg.alwaysOnTop,
				clickThrough: cfg.clickThrough == r.ClickThrough.All,
			}
			let place = cfg.position
			if !(place is none) {
				args.placed = true
				args.left = float(place.x)
				args.top = float(place.y)
			}
			let opened = HandleAnswer{}
			try decodeAnswer(try sync("hostOpen", encode(args)), opened)
			windows = windows.set(opened.handle, true)
			let win = new r.Window(opened.handle)
			let icon = cfg.icon
			return win when icon is none
			setWindowIcon(win, icon) onerror (refused error) {
				closeWindow(win) onerror recover none
				fail refused
			}
			return win
		}

		// Takes the canvas off the page; the page's own canvas is hidden again.
		//
		// Fails when the window is unknown.
		def closeWindow(win r.Window) !none {
			let handle = try known(win)
			let _ = try sync("hostClose", encode(WindowArgs{handle: handle}))
			windows = windows.delete(handle)
			dragTests = dragTests.delete(handle) when dragTests.hasKey(handle)
			return none
		}

		// Sets the page's title, for the page's canvas; a floating window has no title
		// to show.
		//
		// Fails when the window is unknown.
		def setWindowTitle(win r.Window, title string) !none {
			let handle = try known(win)
			let _ = try sync("hostTitle", encode(TitleArgs{handle: handle, title: title}))
			return none
		}

		// Sets the page's icon from an RGBA image.
		//
		// Fails when the window is unknown or the image is empty or short of pixels.
		def setWindowIcon(win r.Window, icon image.Image) !none {
			let _ = try known(win)
			let width = int(icon.size().width)
			let height = int(icon.size().height)
			let pixels = icon.raw()
			fail "the icon is empty" when width <= 0 || height <= 0 || pixels.len() < width * height * 4
			let rgba = new Base64().encode(pixels[:width * height * 4])
			let _ = try sync("hostIcon", encode(IconArgs{width: width, height: height, rgba: rgba}))
			return none
		}

		// Shows or hides the window's canvas.
		//
		// Fails when the window is unknown.
		def setWindowVisible(win r.Window, visible bool) !none {
			let handle = try known(win)
			let _ = try sync("hostVisible", encode(VisibleArgs{handle: handle, visible: visible}))
			return none
		}

		// Fullscreen and back for any window; a floating window is maximized to the
		// page. The page's canvas already fills the page, and a page has no
		// minimized windows.
		//
		// Fails when the window is unknown, for Minimized, or when the browser
		// refuses fullscreen (it allows it only right after a click or key press).
		def setWindowState(win r.Window, state ui.WindowState) !none {
			let handle = try known(win)
			fail "a page has no minimized windows" when state == ui.WindowState.Minimized
			let _ = try later("hostState", encode(StateArgs{handle: handle, state: state.name}))
			return none
		}

		// Gives the pointer that shape over the window.
		//
		// Fails when the window is unknown.
		def setCursor(win r.Window, cursor Cursor) !none {
			let handle = try known(win)
			let _ = try sync("hostCursor", encode(CursorArgs{handle: handle, css: cssCursor(cursor)}))
			return none
		}

		// Where the window's canvas is in the page's viewport, in CSS pixels.
		//
		// Fails when the window is unknown.
		def windowBounds(win r.Window) !Rect<Pixels> {
			let handle = try known(win)
			let box = BoundsArgs{}
			try decodeAnswer(try sync("hostBounds", encode(WindowArgs{handle: handle})), box)
			return Rect<Pixels>{left: box.left * 1(px), top: box.top * 1(px), right: (box.left + box.width) * 1(px), bottom: (box.top + box.height) * 1(px)}
		}

		// Moves and sizes a floating window's canvas; the page's canvas stays as
		// the page lays it out.
		//
		// Fails when the window is unknown or the size is empty.
		def setWindowBounds(win r.Window, bounds Rect<Pixels>) !none {
			let handle = try known(win)
			let (wide, high) = (float(bounds.width), float(bounds.height))
			fail "a window cannot be {wide} by {high}" when wide <= 0.0 || high <= 0.0
			let args = BoundsArgs{handle: handle, left: float(bounds.left), top: float(bounds.top), width: wide, height: high}
			let _ = try sync("hostSetBounds", encode(args))
			return none
		}

		// Puts a floating window above the others.
		//
		// Fails when the window is unknown.
		def raiseWindow(win r.Window) !none {
			let handle = try known(win)
			let _ = try sync("hostRaise", encode(WindowArgs{handle: handle}))
			return none
		}

		// The events the page queued for every window, oldest first. A press where
		// the window's drag test says the window is dragged starts moving it and
		// reaches no component.
		//
		// Fails when the page does not answer.
		def poll() !r.PlatformEvent[] {
			let out r.PlatformEvent[]
			return out when windows.len() == 0
			if presented {
				presented = false
				let _ = try later("hostFrame")
			}
			let queued = PageEvents{}
			try decodeAnswer(try sync("hostPoll"), queued)
			for let e in queued.value {
				continue unless windows.hasKey(e.window)
				let event = names.platformEvent(e)
				continue when event is none
				if event.kind == r.PlatformEventKind.MouseDown && event.button == ui.MouseButton.Left && dragsAt(e) {
					let _ = try sync("hostDrag", encode(WindowArgs{handle: e.window}))
					continue
				}
				out.push(event)
			}
			return out
		}

		// Whether the press is where its window's drag test says the window is
		// dragged by.
		internal def dragsAt(e PageEvent) bool {
			let test = dragTests.get(e.window)
			return false when test is none
			let scale = e.scale <= 0.0 ?? (1.0, e.scale)
			return test(new Point<Pixels>(e.x / scale * 1(px), e.y / scale * 1(px)))
		}

		// Returns when the page has an event, `wake` was called, or `limit` passed.
		//
		// Fails when the page does not answer.
		def wait(limit duration) !none {
			let ms = (float(limit) / float(1ms)).max(0.0)
			let _ = try later("hostWait", encode(WaitArgs{ms: ms}))
			return none
		}

		// Ends a `wait` in progress.
		def wake() {
			let _ = sync("hostWake") onerror recover ""
		}

		// The page's viewport, as the one display windows go on.
		//
		// Fails when the page does not answer.
		def displays() !ui.Display[] {
			let area = DisplayAnswer{}
			try decodeAnswer(try sync("hostDisplays"), area)
			let bounds = Rect<Pixels>{left: 0(px), top: 0(px), right: area.width * 1(px), bottom: area.height * 1(px)}
			let page = ui.Display{name: "page", bounds: bounds, workArea: bounds, scale: area.scale, primary: true}
			page.refreshRate = area.refreshRate when area.refreshRate > 0.0
			return [page]
		}

		// The clipboard's text.
		//
		// Fails when the browser refuses: most read it only after the user allows it.
		def clipboardText() !string {
			let status = __webClipboardRead()
			fail "clipboard: {refusal(int(status))}" unless status == 0
			return __webAnswer()
		}

		// Puts the text on the clipboard.
		//
		// Fails when the browser refuses: most write it only right after a click or
		// key press.
		def setClipboardText(text string) !none {
			let status = __webClipboardWrite(text)
			fail "clipboard: {refusal(int(status))}" unless status == 0
			return none
		}

		// Moves the keyboard to a hidden text field of the page, through which typed
		// text and input-method compositions arrive and which brings up a touch
		// screen's keyboard for the kind of text.
		//
		// Fails when the window is unknown.
		def startTextInput(win r.Window, kind ui.TextKind) !none {
			let handle = try known(win)
			let _ = try sync("hostTextInput", encode(TextInputArgs{handle: handle, on: true, kind: kind.name}))
			return none
		}

		// Gives the keyboard back to the window's canvas.
		//
		// Fails when the window is unknown.
		def stopTextInput(win r.Window) !none {
			let handle = try known(win)
			let _ = try sync("hostTextInput", encode(TextInputArgs{handle: handle, on: false}))
			return none
		}

		// Puts the hidden text field at the caret, where the input method shows its
		// candidates.
		//
		// Fails when the window is unknown.
		def setTextInputCaret(win r.Window, caret Rect<Pixels>) !none {
			let handle = try known(win)
			let args = BoundsArgs{handle: handle, left: float(caret.left), top: float(caret.top), width: float(caret.width), height: float(caret.height)}
			let _ = try sync("hostCaret", encode(args))
			return none
		}

		// Sets what says whether a point of the window, in logical pixels, is where
		// the user drags a floating window by; none: no point is.
		//
		// Fails when the window is unknown.
		def setWindowDragTest(win r.Window, test ?(def(Point<Pixels>) bool)) !none {
			let handle = try known(win)
			if test is none {
				dragTests = dragTests.delete(handle) when dragTests.hasKey(handle)
				return none
			}
			dragTests = dragTests.set(handle, test)
			return none
		}

		// Fails: a page cannot let presses through a canvas by its pixels.
		def setWindowShape(win r.Window, width int, height int, pixels byte[]) !none {
			let _ = try known(win)
			fail "the browser cannot shape a window"
		}

		// Fails: a page has no system tray.
		def showTray(icon image.Image, tooltip string, menu ui.MenuEntry[]) !none {
			fail "tray: the browser has no system tray"
		}

		// No tray is ever shown. Does not fail.
		def hideTray() !none {
			return none
		}

		// Makes the window's WebGL 2 context the one OpenGL calls draw in. False
		// when the window is unknown or its context is lost.
		def makeCurrent(window uint) bool {
			return false unless windows.hasKey(window)
			let flag = FlagAnswer{}
			let answer = sync("hostCurrent", encode(WindowArgs{handle: window})) onerror recover ""
			decodeAnswer(answer, flag) onerror recover none
			return flag.value
		}

		// The page shows what WebGL drew once control returns to it: the next `poll`
		// waits for that.
		def present(window uint) {
			presented = true when windows.hasKey(window)
		}

		// The size of the window's drawing buffer in device pixels.
		def surfaceSize(window uint) Size {
			let size = SizeAnswer{}
			if windows.hasKey(window) {
				let answer = sync("hostSize", encode(WindowArgs{handle: window})) onerror recover ""
				decodeAnswer(answer, size) onerror recover none
			}
			return new Size(size.width, size.height)
		}
	}

	// Runs the loader's operation that answers at once; its JSON answer.
	//
	// Fails when the page refuses or lacks it.
	internal def sync(op string, args string = "\{}") !string {
		let status = __webSync(op, args)
		fail "{op}: {refusal(int(status))}" unless status == 0
		return __webAnswer()
	}

	// Runs the loader's operation that answers later, the task waiting meanwhile;
	// its JSON answer.
	//
	// Fails when the page refuses or lacks it.
	internal def later(op string, args string = "\{}") !string {
		let status = __webBrowser(op, args)
		fail "{op}: {refusal(int(status))}" unless status == 0
		return __webAnswer()
	}

	// Why the page refused, by the bridge's code (internal/runtime/c/adm_web.h).
	internal def refusal(code int) string {
		switch code {
			case - 1:
				return "not running in a browser"
			case - 3:
				return "the user or the browser refused"
			case - 4:
				return "it needs a click or key press to have just happened"
			default:
				return "the browser lacks the feature"
		}
	}

	internal def encode(value any) string {
		return string(new JSON().encode(value))
	}

	internal def decodeAnswer(text string, into any) !none {
		try new JSON().decode(text, into)
		return none
	}

	// --- what crosses to the page's loader, as JSON ---

	internal struct OpenArgs {
		title        string
		width        float
		height       float
		placed       bool
		left         float
		top          float
		decorated    bool
		transparent  bool
		alwaysOnTop  bool
		clickThrough bool
	}

	internal struct WindowArgs {
		handle uint
	}

	internal struct TitleArgs {
		handle uint
		title  string
	}

	internal struct IconArgs {
		width  int
		height int
		rgba   string
	}

	internal struct VisibleArgs {
		handle  uint
		visible bool
	}

	internal struct StateArgs {
		handle uint
		state  string
	}

	internal struct CursorArgs {
		handle uint
		css    string
	}

	internal struct BoundsArgs {
		handle uint
		left   float
		top    float
		width  float
		height float
	}

	internal struct WaitArgs {
		ms float
	}

	internal struct TextInputArgs {
		handle uint
		on     bool
		kind   string = ""
	}

	internal struct HandleAnswer {
		handle uint
	}

	internal struct FlagAnswer {
		value bool
	}

	internal struct SizeAnswer {
		width  float
		height float
	}

	internal struct DisplayAnswer {
		width       float
		height      float
		scale       float = 1.0
		refreshRate float
	}

	@c("adm_web.h", symbol = "adm_web_sync", ret = "int32_t", params = ["const char*", "const char*"])
	def __webSync(op string, args string) int32;

	@c("adm_web.h", symbol = "adm_web_browser", ret = "int32_t", params = ["const char*", "const char*"])
	def __webBrowser(op string, args string) int32;

	@c("adm_web.h", symbol = "adm_web_answer", ret = "const char*", params = [])
	def __webAnswer() string;

	@c("adm_web.h", symbol = "adm_web_clipboard_read", ret = "int32_t", params = [])
	def __webClipboardRead() int32;

	@c("adm_web.h", symbol = "adm_web_clipboard_write", ret = "int32_t", params = ["const char*"])
	def __webClipboardWrite(text string) int32;
}
