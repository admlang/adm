partial module std.ui.host.preview {
	use (
		std.data.encoding::MsgPackValue
		std.math.geom::Rect
		std.net
		std.os
		std.proto.msgpackrpc
		std.services.storage::MapAccess
		std.testing
		std.time
		std.ui
		std.ui.host.browser::PageEvent
		std.ui.renderer as r
		std.ui.runtime
		std.ui.styles::Cursor
	)

	// The notices the IDE's end of a test receives, in order.
	type SeenNotes {
		internal methods string[]
		internal values  MsgPackValue[]
		internal taken   int
		internal arrived channel<none>

		def new() {
			arrived = new channel<none>(1)
		}

		atomic def add(method string, value MsgPackValue) {
			methods.push(method)
			values.push(value)
			let _ = arrived.offer(none)
		}

		atomic def firstFrom(method string, from int) int {
			for let i = from; i < methods.len(); i++ {
				return i when methods[i] == method
			}
			return -1
		}

		atomic def valueAt(i int) MsgPackValue {
			return values[i]
		}

		// The next notice of `method` after those taken; fails after 5 s without one.
		def next(method string) !MsgPackValue {
			let deadline = time.now() + 5s
			for time.now() < deadline {
				let i = firstFrom(method, taken)
				if i >= 0 {
					taken = i + 1
					return valueAt(i)
				}
				let wait = time.sleepChan(50ms)
				select {
					case arrived:
						let _ = <-arrived
					case wait:
				}
			}
			fail "no {method} notice within 5 s"
		}
	}

	// A host connected to a test's end of the socket, the IDE's.
	internal struct Linked {
		host PreviewHost
		ide  msgpackrpc.Peer
		seen SeenNotes
		conn net.Connection
		ln   net.Listener
		path string
	}

	internal def link() !Linked {
		let path = os.join(os.tempDir(), "adm-preview-{time.now().unixNs()}.sock")
		let sock = try net.socket(net.SocketDomain.Unix, net.SocketType.Stream)
		try sock.bind(path)
		let ln = try sock.listen(1)
		let host = new PreviewHost()
		host.targets = ["app.Button"]
		host.blocked = [BlockedTarget{name: "app.List", input: "onPick", reason: "its input `onPick` is a project type (Picker) the preview cannot make up"}]
		host.mount = def (target string, cfg r.WindowConfig) !r.Window {
			fail "no such component {target}" unless target == "app.Button"
			return try host.openWindow(cfg)
		}
		try host.connect(path)
		let conn = try ln.accept()
		let ide = new msgpackrpc.Peer(conn, conn)
		ide.timeout = 5s
		let seen = new SeenNotes()
		for let method in ["hello", "buffers", "frame", "cursor", "problem", "textInput", "setClipboard"] {
			ide.handle(method, def (req msgpackrpc.Request) !any {
				seen.add(req.method, req.arg(0))
				return none
			})
		}
		ide.handle("clipboard", def (req msgpackrpc.Request) !any {
			return "from the IDE"
		})
		ide.start()
		return Linked{host: host, ide: ide, seen: seen, conn: conn, ln: ln, path: path}
	}

	internal def unlink(l Linked) {
		l.ide.close()
		l.conn.close() onerror recover none
		l.ln.close() onerror recover none
		os.remove(l.path) onerror recover none
	}

	// Polls the host, as the windows' loop does, until `done` or 5 s.
	internal def pollUntil(host PreviewHost, done def() bool) !r.PlatformEvent[] {
		let out r.PlatformEvent[]
		let deadline = time.now() + 5s
		for !done() && time.now() < deadline {
			out.push(...try host.poll())
			time.sleep(5ms)
		}
		out.push(...try host.poll())
		return out
	}

	// Opens pane `pane` of `target` through the IDE's `open`, polling the host meanwhile.
	internal async def openPane(l Linked, pane int, target string) !MsgPackValue {
		return try l.ide.call("open", [OpenArgs{pane: pane, target: target, width: 40.0, height: 20.0}])
	}

	// The bytes of the slot a frame names, from the memory file the host told of.
	internal def slotBytes(buffers MsgPackValue, frame MsgPackValue) !byte[] {
		let pid = try buffers.get("pid").asInt()
		let fd = try buffers.get("fd").asInt()
		let size = try buffers.get("slotBytes").asInt()
		let mapped = try os.mapFile("/proc/{pid}/fd/{fd}", MapAccess.ReadWrite)
		defer mapped.close()
		let slot = try frame.get("slot").asInt()
		return try mapped.read(slot * size, size)
	}

	// A picture `width` by `height` whose pixel at (x, y) is (x, y, `tint`, 255).
	internal def picture(width int, height int, tint int) byte[] {
		let out byte[]
		out.len(width * height * 4)
		for let y = 0; y < height; y++ {
			for let x = 0; x < width; x++ {
				let at = (y * width + x) * 4
				out[at] = byte(x)
				out[at + 1] = byte(y)
				out[at + 2] = byte(tint)
				out[at + 3] = byte(255)
			}
		}
		return out
	}

	check "PreviewHost" {
		@os("linux")
		@test()
		def TestHelloNamesTheProcessAndItsTargets() !none {
			let l = try link()
			defer unlink(l)
			let hello = try l.seen.next("hello")
			assert (try hello.get("protocol").asInt()) == protocol
			assert (try hello.get("pid").asInt()) == parseInt<int>(try os.readLink("/proc/self"), 10)
			assert (try hello.get("targets").at(0).asString()) == "app.Button"
			let blocked = hello.get("blocked").at(0)
			assert (try blocked.get("name").asString()) == "app.List" && (try blocked.get("input").asString()) == "onPick" && (try blocked.get("reason").asString()).contains("Picker")
			return none
		}

		@os("linux")
		@test()
		async def TestOpenMountsTheTargetAndRefusesOthers() !none {
			let l = try link()
			defer unlink(l)
			let opened = openPane(l, 7, "app.Button")
			let _ = try pollUntil(l.host, () => l.host.windows.len() == 1)
			assert (try (try await opened).asBool())
			let w = l.host.windowOfPane(7)
			assert !(w is none) && w.width == 40.0 && w.height == 20.0
			// Another target: the program's mount says why not, and no window opens.
			let failed = false
			let refused = openPane(l, 8, "app.Missing")
			let _ = try pollUntil(l.host, () => false)
			let _ = await refused onerror (err error) {
				failed = err.message.contains("no such component")
				recover new MsgPackValue()
			}
			assert failed && l.host.windows.len() == 1
			return none
		}

		@os("linux")
		@test()
		async def TestFramesSendWhatChangedPackedAndWaitForASlot() !none {
			let l = try link()
			defer unlink(l)
			let opened = openPane(l, 1, "app.Button")
			let _ = try pollUntil(l.host, () => l.host.windows.len() == 1)
			let _ = try await opened
			let w = l.host.windowOfPane(1)
			assert !(w is none)
			return none when w is none
			// The first picture goes whole, in a memory file made for it.
			try l.host.presentPixels(w.handle, 40, 20, picture(40, 20, 1))
			let buffers = try l.seen.next("buffers")
			let first = try l.seen.next("frame")
			assert (try first.get("left").asInt()) == 0 && (try first.get("right").asInt()) == 40 && (try first.get("bottom").asInt()) == 20
			let whole = try slotBytes(buffers, first)
			assert whole[(19 * 40 + 39) * 4] == byte(39) && whole[(19 * 40 + 39) * 4 + 1] == byte(19)
			// A part: only its box, its rows packed.
			try l.host.presentDamage(w.handle, 40, 20, picture(40, 20, 2), Rect{left: 10.0, top: 5.0, right: 13.5, bottom: 7.0})
			let part = try l.seen.next("frame")
			assert (try part.get("left").asInt()) == 10 && (try part.get("right").asInt()) == 14 && (try part.get("top").asInt()) == 5 && (try part.get("bottom").asInt()) == 7
			let box = try slotBytes(buffers, part)
			// Row 6, column 13: the second row's fourth pixel.
			assert box[(1 * 4 + 3) * 4] == byte(13) && box[(1 * 4 + 3) * 4 + 1] == byte(6) && box[(1 * 4 + 3) * 4 + 2] == byte(2)
			// Every slot held by the IDE: the next parts wait, gathered into one box.
			try l.host.presentDamage(w.handle, 40, 20, picture(40, 20, 3), Rect{left: 0.0, top: 0.0, right: 2.0, bottom: 2.0})
			let _ = try l.seen.next("frame")
			try l.host.presentDamage(w.handle, 40, 20, picture(40, 20, 4), Rect{left: 30.0, top: 10.0, right: 32.0, bottom: 12.0})
			try l.host.presentDamage(w.handle, 40, 20, picture(40, 20, 5), Rect{left: 1.0, top: 1.0, right: 3.0, bottom: 3.0})
			assert w.pending && w.freeSlot() < 0
			try l.ide.notify("release", [ReleaseArgs{pane: 1, slot: try first.get("slot").asInt()}])
			let _ = try pollUntil(l.host, () => !w.pending)
			let gathered = try l.seen.next("frame")
			assert (try gathered.get("left").asInt()) == 1 && (try gathered.get("top").asInt()) == 1 && (try gathered.get("right").asInt()) == 32 && (try gathered.get("bottom").asInt()) == 12
			assert (try slotBytes(buffers, gathered))[2] == byte(5)
			return none
		}

		@os("linux")
		@test()
		async def TestInputResizeCloseAndQuitBecomeEvents() !none {
			let l = try link()
			defer unlink(l)
			let opened = openPane(l, 3, "app.Button")
			let _ = try pollUntil(l.host, () => l.host.windows.len() == 1)
			let _ = try await opened
			let w = l.host.windowOfPane(3)
			assert !(w is none)
			return none when w is none
			try l.ide.notify("setup", [SetupArgs{scale: 2.0}])
			try l.ide.notify("input", [InputArgs{pane: 3, events: [PageEvent{kind: "MouseDown", x: 5.0, y: 6.0, button: 1}, PageEvent{kind: "KeyDown", key: "A", text: "a"}]}])
			try l.ide.notify("resize", [ResizeArgs{pane: 3, width: 50.0, height: 25.0}])
			try l.ide.notify("close", [PaneArgs{pane: 3}])
			let events = try pollUntil(l.host, () => false)
			let kinds r.PlatformEventKind[]
			for let e in events {
				kinds.push(e.kind)
			}
			assert kinds.includes(r.PlatformEventKind.Resize) && kinds.includes(r.PlatformEventKind.MouseDown) && kinds.includes(r.PlatformEventKind.KeyDown) && kinds.includes(r.PlatformEventKind.Close)
			for let e in events {
				assert e.window == w.handle
				assert e.button == ui.MouseButton.Right && e.position.x == 5.0 when e.kind == r.PlatformEventKind.MouseDown
				assert e.key == ui.Key.A && e.text == "a" when e.kind == r.PlatformEventKind.KeyDown
			}
			// The last Resize: the new size at the IDE's scale.
			let sizes = events.filter((e) => e.kind == r.PlatformEventKind.Resize)
			assert sizes[sizes.len() - 1].size.width == 100.0 && sizes[sizes.len() - 1].size.height == 50.0
			let surface = l.host.surfaceSize(w.handle)
			assert surface.width == 100.0 && surface.height == 50.0
			try l.ide.notify("quit")
			let _ = try pollUntil(l.host, () => l.host.ended())
			assert l.host.ended()
			return none
		}

		@os("linux")
		@test()
		def TestPinsReplaceThePinnedStates() !none {
			let l = try link()
			defer unlink(l)
			defer runtime.pinStates(map<string, string[]>{})
			let before = runtime.statePins.version
			try l.ide.notify("pins", [PinsArgs{pins: [PinNote{target: "app.Button", states: ["hover", "picked"]}, PinNote{target: "app.Label", states: []}]}])
			let _ = try pollUntil(l.host, () => runtime.statePins.version != before)
			let pinned = runtime.statePins.byType
			assert pinned.len() == 1 && pinned["app.Button"].join(",") == "hover,picked"
			return none
		}

		@os("linux")
		@test()
		async def TestTheClipboardAndTheCursorAreTheIDEs() !none {
			let l = try link()
			defer unlink(l)
			let opened = openPane(l, 2, "app.Button")
			let _ = try pollUntil(l.host, () => l.host.windows.len() == 1)
			let _ = try await opened
			let w = l.host.windowOfPane(2)
			assert !(w is none)
			return none when w is none
			assert (try l.host.clipboardText()) == "from the IDE"
			try l.host.setCursor(new r.Window(w.handle), Cursor.Pointer)
			let shape = try l.seen.next("cursor")
			assert (try shape.get("pane").asInt()) == 2 && (try shape.get("cursor").asString()) == "Pointer"
			return none
		}
	}
}
