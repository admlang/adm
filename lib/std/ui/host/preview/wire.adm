// The messages a preview host and the IDE send each other: MessagePack-RPC methods whose
// one argument is a map with these fields.
partial module std.ui.host.preview {
	use std.ui.host.browser::PageEvent

	// The preview protocol's version, sent in `hello`.
	const protocol = 1

	// `hello`: the host's first message. `pid` names the process whose memory files the
	// IDE maps (`/proc/<pid>/fd/<n>`); `targets` the components the program can mount,
	// `blocked` those it cannot, and why.
	internal struct Hello {
		protocol int
		pid      int
		targets  string[]
		blocked  BlockedTarget[]
	}

	// A component of the project the preview cannot mount: its qualified name, the input
	// that stops it ("" when the component itself does: generic, internal), and why, in
	// words the IDE shows in its pane ("its input `onPick` is a project type (Picker) the
	// preview cannot make up").
	struct BlockedTarget {
		name   string
		input  string
		reason string
	}

	// `setup`: device pixels per logical pixel of the IDE.
	internal type SetupArgs {
		scale float = 1.0
	}

	// `open`: mount `target` in a new window for the IDE's pane numbered `pane`, `width` by
	// `height` logical pixels.
	internal type OpenArgs {
		pane   int
		target string
		width  float
		height float
	}

	// `close`.
	internal type PaneArgs {
		pane int
	}

	// `resize`: the space the editor gives the pane, in logical pixels.
	internal type ResizeArgs {
		pane   int
		width  float
		height float
	}

	// `input`: events of the pane, oldest first, in device pixels of its frames.
	internal type InputArgs {
		pane   int
		events PageEvent[]
	}

	// `pins`: the states pinned, for each component type (qualified name) that has some;
	// they replace those pinned before.
	internal type PinsArgs {
		pins PinNote[]
	}

	internal struct PinNote {
		target string
		states string[]
	}

	// `release`: the IDE has copied the frame in `slot`.
	internal type ReleaseArgs {
		pane int
		slot int
	}

	// `buffers`: the memory file the pane's frames are in, as the descriptor `fd` of
	// process `pid`: `slots` slots of `slotBytes` bytes each.
	internal struct BuffersNote {
		pane      int
		pid       int
		fd        int
		slots     int
		slotBytes int
	}

	// `frame`: the changed box of a frame of the pane, `width` by `height` device pixels,
	// is in `slot`, packed: its rows one after another, `(right - left) * 4` bytes each,
	// straight red, green, blue and alpha.
	internal struct FrameNote {
		pane   int
		slot   int
		width  int
		height int
		left   int
		top    int
		right  int
		bottom int
	}

	// `content`: the size the pane's component was laid out to, in logical pixels: less
	// than the pane's where it does not fill it.
	internal struct ContentNote {
		pane   int
		width  float
		height float
	}

	// `cursor`: the pointer's shape over the pane, a `Cursor` member's name.
	internal struct CursorNote {
		pane   int
		cursor string
	}

	// `textInput`: text input on or off for the pane, of `kind` (a `TextKind` member's
	// name), the caret where the input method puts its list, in logical pixels.
	internal struct TextInputNote {
		pane   int
		on     bool
		kind   string
		left   float
		top    float
		right  float
		bottom float
	}

	// `problem`: something of the pane (-1: of none) went wrong and the preview goes on.
	internal struct ProblemNote {
		pane    int
		message string
	}
}
