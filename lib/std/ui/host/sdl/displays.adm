internal std.ui partial module std.ui.host.sdl {
	use (
		std.math.geom::(Point, Rect)
		std.ui
		std.ui.host.sdl.lib
		std.units::Pixels
	)

	// The connected monitors, the primary one first.
	internal def sdlDisplays() ui.Display[] {
		let out ui.Display[] = []
		let ids = displayIds()
		let primary = lib.SDL_GetPrimaryDisplay()
		for let id in ids {
			out.push(sdlDisplay(id, true)) when id == primary
		}
		for let id in ids {
			out.push(sdlDisplay(id, false)) when id != primary
		}
		return out
	}

	// SDL's numbers for the connected monitors.
	internal def displayIds() uint32[] {
		let ids uint32[]
		let count int32[]
		count.len(1)
		let list = lib.SDL_GetDisplays(count)
		return ids when list == 0
		let n = int(count[0])
		ids.len(n)
		if n > 0 {
			let _ = lib.copyInts(ids, list, uint(n * 4))
		}
		lib.SDL_free(list)
		return ids
	}

	// How many of SDL's desktop coordinates one logical pixel is on the display that
	// holds the point `at` (logical pixels, as `Display.bounds` are); on the primary
	// display when none holds it or no point is given. A window's size and place go to
	// SDL in desktop coordinates.
	internal def desktopUnitAt(at ?Point<Pixels>) float {
		let primary = lib.SDL_GetPrimaryDisplay()
		let unit = 1.0
		for let id in displayIds() {
			let shown = sdlDisplay(id, id == primary)
			let own = shown.scale / displayDensity(id)
			unit = own when id == primary
			continue when at is none
			let held = shown.bounds
			return own when at.x >= held.left && at.x < held.right && at.y >= held.top && at.y < held.bottom
		}
		return unit
	}

	// The pixel density of a display's desktop mode: device pixels per desktop coordinate.
	internal def displayDensity(id uint32) float {
		let modeAt = lib.SDL_GetDesktopDisplayMode(id)
		return 1.0 when modeAt == 0
		// SDL_DisplayMode: display id, format, width, height, pixel density, refresh rate.
		let mode byte[]
		mode.len(24)
		let _ = lib.copyBytes(mode, modeAt, uint(24))
		let density = fieldF32(mode, 16)
		return density <= 0.0 ?? (1.0, density)
	}

	// One monitor as a Display. SDL's desktop coordinates are device pixels on X11 and
	// logical pixels on Wayland and macOS: the desktop mode's pixel density tells them
	// apart, and the content scale over it is what one desktop coordinate holds in
	// logical pixels.
	internal def sdlDisplay(id uint32, primary bool) ui.Display {
		let content = float(lib.SDL_GetDisplayContentScale(id))
		content = 1.0 when content <= 0.0
		let density = 1.0
		let refresh = 0.0
		let modeAt = lib.SDL_GetDesktopDisplayMode(id)
		if modeAt != 0 {
			// SDL_DisplayMode: display id, format, width, height, pixel density, refresh rate.
			let mode byte[]
			mode.len(24)
			let _ = lib.copyBytes(mode, modeAt, uint(24))
			density = fieldF32(mode, 16)
			density = 1.0 when density <= 0.0
			refresh = fieldF32(mode, 20)
		}
		let unit = content / density

		let area int32[]
		area.len(4)
		let display = ui.Display{name: lib.SDL_GetDisplayName(id), scale: content, primary: primary}
		if lib.SDL_GetDisplayBounds(id, area) {
			display.bounds = desktopRect(area, unit)
			display.workArea = display.bounds
		}
		display.workArea = desktopRect(area, unit) when lib.SDL_GetDisplayUsableBounds(id, area) && area[2] > 0 && area[3] > 0
		display.refreshRate = refresh when refresh > 0.0
		return display
	}

	// An SDL_Rect in desktop coordinates as logical pixels, `unit` desktop coordinates
	// to the logical pixel.
	internal def desktopRect(area int32[], unit float) Rect<Pixels> {
		let left = float(area[0]) / unit
		let top = float(area[1]) / unit
		return Rect<Pixels>{left: left * 1(px), top: top * 1(px), right: (left + float(area[2]) / unit) * 1(px), bottom: (top + float(area[3]) / unit) * 1(px)}
	}
}
