internal std.ui partial module std.ui.host.sdl {
	use (
		std.math.geom::Point
		std.ui.host.sdl.lib
		std.units::Pixels
	)

	// What SDL is told about the points of one window when it asks, while it handles a
	// press, whether the desktop should move or resize the window from there.
	internal type WindowAreas {
		// Whether a point, in logical pixels, is a place the user drags the window by;
		// none: no point is.
		drags ?(def(Point<Pixels>) bool) = none
		// Whether the window's edges resize it: a window without decorations that can
		// be resized.
		edges bool
		// Window coordinates per logical pixel.
		unit  float                      = 1.0
	}

	// The windows SDL asks about, by handle.
	internal type AreasAsked {
		of map<uint, WindowAreas> = map<uint, WindowAreas>{}
	}

	internal let asked = new AreasAsked()

	// How far from an edge of a window without decorations a press resizes it, in window
	// coordinates.
	internal const edgeBand = 6.0

	// SDL's hit test: what the point `area` (an SDL_Point of the window) is for. 0: the
	// window's own content; 1: a place it is dragged by; 2 to 9: an edge or corner it is
	// resized by, clockwise from the top left corner.
	internal def windowAreaAsked(window uint, area uint, data uint) int32 {
		let held = asked.of.get(window)
		return int32(0) when held is none
		let point uint32[] = [uint32(0), uint32(0)]
		let _ = lib.copyInts(point, area, 8)
		let (x, y) = (float(int32(point[0])), float(int32(point[1])))
		if held.edges {
			let wide int32[] = [int32(0)]
			let high int32[] = [int32(0)]
			let _ = lib.SDL_GetWindowSize(window, wide, high)
			let (left, right) = (x < edgeBand, x >= float(wide[0]) - edgeBand)
			let (top, bottom) = (y < edgeBand, y >= float(high[0]) - edgeBand)
			return int32(2) when top && left
			return int32(4) when top && right
			return int32(6) when bottom && right
			return int32(8) when bottom && left
			return int32(3) when top
			return int32(5) when right
			return int32(7) when bottom
			return int32(9) when left
		}
		let drags = held.drags
		return int32(0) when drags is none
		return drags(new Point<Pixels>(x / held.unit * 1(px), y / held.unit * 1(px))) ?? (int32(1), int32(0))
	}
}
