internal std.ui partial module std.ui.host.sdl {
	use (
		std.math.geom::(Point, Size)
		std.ui
		std.ui.host.sdl.lib
		std.ui.renderer as r
	)

	// How far one wheel step scrolls, in logical pixels.
	internal const wheelStep = 48.0

	// The unsigned 32-bit field of an SDL structure at byte `at`.
	internal def fieldU32(data byte[], at int) uint32 {
		return uint32(data[at]) | uint32(data[at + 1]) << 8 | uint32(data[at + 2]) << 16 | uint32(data[at + 3]) << 24
	}

	// The signed 32-bit field of an SDL structure at byte `at`.
	internal def fieldI32(data byte[], at int) int {
		return int(int32(fieldU32(data, at)))
	}

	// The float field of an SDL structure at byte `at`.
	internal def fieldF32(data byte[], at int) float {
		return float(__bitcast_f32_from_u32(fieldU32(data, at)))
	}

	// The pointer field of an SDL structure at byte `at`.
	internal def fieldPointer(data byte[], at int) uint {
		return uint(uint64(fieldU32(data, at)) | uint64(fieldU32(data, at + 4)) << 32)
	}

	// A copy of the C string at `text`; "" for a null pointer.
	internal def cString(text uint) string {
		return "" when text == 0
		let size = lib.cStringLength(text)
		return "" when size == 0
		let bytes byte[]
		bytes.len(int(size))
		let _ = lib.copyBytes(bytes, text, size)
		return string(bytes)
	}

	// The modifier keys of an SDL_Keymod value.
	internal def modifiersOf(held int) ui.Modifiers {
		let control = (held & lib.SDL_KMOD_CTRL) != 0
		let command = (held & lib.SDL_KMOD_GUI) != 0
		return ui.Modifiers{
			shift:   (held & lib.SDL_KMOD_SHIFT) != 0,
			control: control,
			alt:     (held & lib.SDL_KMOD_ALT) != 0,
			command: command,
			mod:     primaryModifier(control, command),
		}
	}

	// The keys SDL numbers in a row, in its order: the letters, the digits, F1 to F12,
	// F13 to F24, and the keypad's 1 to 9.
	internal const letterKeys ui.Key[] = [ui.Key.A, ui.Key.B, ui.Key.C, ui.Key.D, ui.Key.E, ui.Key.F, ui.Key.G, ui.Key.H, ui.Key.I, ui.Key.J, ui.Key.K, ui.Key.L, ui.Key.M, ui.Key.N, ui.Key.O, ui.Key.P, ui.Key.Q, ui.Key.R, ui.Key.S, ui.Key.T, ui.Key.U, ui.Key.V, ui.Key.W, ui.Key.X, ui.Key.Y, ui.Key.Z]
	internal const digitKeys ui.Key[] = [ui.Key.Digit0, ui.Key.Digit1, ui.Key.Digit2, ui.Key.Digit3, ui.Key.Digit4, ui.Key.Digit5, ui.Key.Digit6, ui.Key.Digit7, ui.Key.Digit8, ui.Key.Digit9]
	internal const functionKeys ui.Key[] = [ui.Key.F1, ui.Key.F2, ui.Key.F3, ui.Key.F4, ui.Key.F5, ui.Key.F6, ui.Key.F7, ui.Key.F8, ui.Key.F9, ui.Key.F10, ui.Key.F11, ui.Key.F12]
	internal const moreFunctionKeys ui.Key[] = [ui.Key.F13, ui.Key.F14, ui.Key.F15, ui.Key.F16, ui.Key.F17, ui.Key.F18, ui.Key.F19, ui.Key.F20, ui.Key.F21, ui.Key.F22, ui.Key.F23, ui.Key.F24]
	internal const keypadKeys ui.Key[] = [ui.Key.Keypad1, ui.Key.Keypad2, ui.Key.Keypad3, ui.Key.Keypad4, ui.Key.Keypad5, ui.Key.Keypad6, ui.Key.Keypad7, ui.Key.Keypad8, ui.Key.Keypad9]

	// The ASCII code of what the keys with scancodes 4 to 56 type on a US keyboard, in
	// SDL's order; 0 for a key `Key` has no name for there.
	internal const usPlaces int[] = [97, 98, 99, 100, 101, 102, 103, 104, 105, 106, 107, 108, 109, 110, 111, 112, 113, 114, 115, 116, 117, 118, 119, 120, 121, 122, 49, 50, 51, 52, 53, 54, 55, 56, 57, 48, 13, 27, 8, 9, 32, 45, 61, 91, 93, 92, 0, 59, 39, 96, 44, 46, 47]

	// The `std.ui.Key` a US keyboard has at the place of an SDL scancode.
	internal def placeOf(place uint32) ui.Key {
		let at = int(place)
		return ui.Key.Unknown when at < 4
		if at <= 56 {
			let typed = usPlaces[at - 4]
			return ui.Key.Unknown when typed == 0
			return keyOf(uint32(typed))
		}
		// The keys without a character have their scancode as their key code.
		return keyOf(place | uint32(0x40000000))
	}

	// The text a key code types by itself: its character when it is one that prints.
	internal def typedBy(code uint32) string {
		let point = int(code)
		return "" when point < 32 || point == 127 || point >= 0x110000
		return string(char(point))
	}

	// The `std.ui.Key` of an SDL key code, with the scancode (the key's place) of the same
	// event. A code that is a character outside ASCII (a layout without Latin letters, a
	// letter with an accent) is named by its place when that is a letter's or a digit's
	// on a US keyboard, so that Control+C is the same key on every layout; any other
	// character with no name in `Key` is `Character`; a key SDL names by its place that
	// `Key` does not have, and SDL's extended codes, are `Unknown`.
	internal def keyOf(code uint32, place uint32 = uint32(0)) ui.Key {
		// Keys with no character and no place: a second Tab, the level shifts, soft keys.
		return ui.Key.Unknown when (code & uint32(0x20000000)) != uint32(0)
		if (code & uint32(0x40000000)) == uint32(0) {
			let plain = int(code)
			if plain > 127 {
				// Scancodes 4 to 29 are A to Z, 30 to 38 the digits 1 to 9, 39 is 0.
				let at = int(place)
				return letterKeys[at - 4] when at >= 4 && at <= 29
				return digitKeys[(at - 29) % 10] when at >= 30 && at <= 39
				return ui.Key.Character
			}
			return letterKeys[plain - 97] when plain >= 97 && plain <= 122
			return digitKeys[plain - 48] when plain >= 48 && plain <= 57
			switch plain {
				case 27:
					return ui.Key.Escape
				case 13:
					return ui.Key.Enter
				case 9:
					return ui.Key.Tab
				case 8:
					return ui.Key.Backspace
				case 127:
					return ui.Key.Delete
				case 32:
					return ui.Key.Space
				case 39:
					return ui.Key.Apostrophe
				case 44:
					return ui.Key.Comma
				case 45:
					return ui.Key.Minus
				case 46:
					return ui.Key.Period
				case 47:
					return ui.Key.Slash
				case 59:
					return ui.Key.Semicolon
				case 61:
					return ui.Key.Equal
				case 91:
					return ui.Key.LeftBracket
				case 92:
					return ui.Key.Backslash
				case 93:
					return ui.Key.RightBracket
				case 96:
					return ui.Key.Backquote
				default:
			}
			// Any other character a layout has a key for.
			return plain > 32 ?? (ui.Key.Character, ui.Key.Unknown)
		}
		let scan = int(code & uint32(0x3FFFFFFF))
		return functionKeys[scan - 0x3A] when scan >= 0x3A && scan <= 0x45
		return keypadKeys[scan - 0x59] when scan >= 0x59 && scan <= 0x61
		return moreFunctionKeys[scan - 0x68] when scan >= 0x68 && scan <= 0x73
		switch scan {
			case 0x49:
				return ui.Key.Insert
			case 0x4F:
				return ui.Key.Right
			case 0x50:
				return ui.Key.Left
			case 0x51:
				return ui.Key.Down
			case 0x52:
				return ui.Key.Up
			case 0x4B:
				return ui.Key.PageUp
			case 0x4E:
				return ui.Key.PageDown
			case 0x4A:
				return ui.Key.Home
			case 0x4D:
				return ui.Key.End
			case 0x39:
				return ui.Key.CapsLock
			case 0x47:
				return ui.Key.ScrollLock
			case 0x53:
				return ui.Key.NumLock
			case 0x46:
				return ui.Key.PrintScreen
			case 0x48:
				return ui.Key.Pause
			case 0x62:
				return ui.Key.Keypad0
			case 0x63:
				return ui.Key.KeypadDecimal
			case 0x54:
				return ui.Key.KeypadDivide
			case 0x55:
				return ui.Key.KeypadMultiply
			case 0x56:
				return ui.Key.KeypadSubtract
			case 0x57:
				return ui.Key.KeypadAdd
			case 0x58:
				return ui.Key.KeypadEnter
			case 0x67:
				return ui.Key.KeypadEqual
			case 0xE1:
				return ui.Key.LeftShift
			case 0xE0:
				return ui.Key.LeftControl
			case 0xE2:
				return ui.Key.LeftAlt
			case 0xE3:
				return ui.Key.LeftSuper
			case 0xE5:
				return ui.Key.RightShift
			case 0xE4:
				return ui.Key.RightControl
			case 0xE6:
				return ui.Key.RightAlt
			case 0xE7:
				return ui.Key.RightSuper
			case 0x65:
				return ui.Key.Menu
			default:
		}
		return ui.Key.Unknown
	}

	// The platform event for one SDL event, or none for an event the UI has no use for.
	// `window` is the handle of the window the event names, `density` its device pixels
	// per window coordinate and `scale` its device pixels per logical pixel.
	internal def platformEvent(data byte[], window uint, density float, scale float) ?r.PlatformEvent {
		let kind = fieldU32(data, 0)
		let event = r.PlatformEvent{kind: r.PlatformEventKind.None, window: window}
		switch kind {
			case lib.SDL_EVENT_WINDOW_CLOSE_REQUESTED:
				event.kind = r.PlatformEventKind.Close
			case lib.SDL_EVENT_WINDOW_PIXEL_SIZE_CHANGED:
				event.kind = r.PlatformEventKind.Resize
				event.size = new Size(float(fieldI32(data, 20)), float(fieldI32(data, 24)))
			case lib.SDL_EVENT_WINDOW_SHOWN, lib.SDL_EVENT_WINDOW_EXPOSED:
				event.kind = r.PlatformEventKind.Expose
			case lib.SDL_EVENT_WINDOW_FOCUS_GAINED:
				event.kind = r.PlatformEventKind.Focus
			case lib.SDL_EVENT_WINDOW_FOCUS_LOST:
				event.kind = r.PlatformEventKind.Blur
			case lib.SDL_EVENT_WINDOW_MOUSE_ENTER:
				event.kind = r.PlatformEventKind.MouseEnter
			case lib.SDL_EVENT_WINDOW_MOUSE_LEAVE:
				event.kind = r.PlatformEventKind.MouseLeave
			case lib.SDL_EVENT_WINDOW_MINIMIZED:
				event.kind = r.PlatformEventKind.StateChange
				event.state = ui.WindowState.Minimized
			case lib.SDL_EVENT_WINDOW_MAXIMIZED:
				event.kind = r.PlatformEventKind.StateChange
				event.state = ui.WindowState.Maximized
			case lib.SDL_EVENT_WINDOW_ENTER_FULLSCREEN:
				event.kind = r.PlatformEventKind.StateChange
				event.state = ui.WindowState.Fullscreen
			case lib.SDL_EVENT_WINDOW_RESTORED, lib.SDL_EVENT_WINDOW_LEAVE_FULLSCREEN:
				event.kind = r.PlatformEventKind.StateChange
				event.state = stateOf(lib.SDL_GetWindowFlags(window))
			case lib.SDL_EVENT_MOUSE_MOTION:
				event.kind = r.PlatformEventKind.MouseMove
				event.position = new Point(fieldF32(data, 28) * density, fieldF32(data, 32) * density)
				event.delta = new Point(fieldF32(data, 36) * density, fieldF32(data, 40) * density)
				event.modifiers = modifiersOf(int(lib.SDL_GetModState()))
			case lib.SDL_EVENT_MOUSE_BUTTON_DOWN, lib.SDL_EVENT_MOUSE_BUTTON_UP:
				let button = int(data[24])
				return none when button != lib.SDL_BUTTON_LEFT && button != lib.SDL_BUTTON_MIDDLE && button != lib.SDL_BUTTON_RIGHT
				event.kind = kind == lib.SDL_EVENT_MOUSE_BUTTON_DOWN ?? (r.PlatformEventKind.MouseDown, r.PlatformEventKind.MouseUp)
				event.button = button == lib.SDL_BUTTON_LEFT ?? (ui.MouseButton.Left, button == lib.SDL_BUTTON_RIGHT ?? (ui.MouseButton.Right, ui.MouseButton.Middle))
				event.clicks = int(data[26])
				event.position = new Point(fieldF32(data, 28) * density, fieldF32(data, 32) * density)
				event.modifiers = modifiersOf(int(lib.SDL_GetModState()))
			case lib.SDL_EVENT_MOUSE_WHEEL:
				// SDL's steps are positive right and away from the user; a flipped
				// wheel reports them reversed.
				let turn = fieldU32(data, 32) == uint32(1) ?? (-1.0, 1.0)
				event.kind = r.PlatformEventKind.MouseWheel
				event.position = new Point(fieldF32(data, 36) * density, fieldF32(data, 40) * density)
				event.delta = new Point(fieldF32(data, 24) * turn * wheelStep * scale, -fieldF32(data, 28) * turn * wheelStep * scale)
				event.modifiers = modifiersOf(int(lib.SDL_GetModState()))
			case lib.SDL_EVENT_KEY_DOWN, lib.SDL_EVENT_KEY_UP:
				event.kind = kind == lib.SDL_EVENT_KEY_DOWN ?? (r.PlatformEventKind.KeyDown, r.PlatformEventKind.KeyUp)
				let held = int(data[32]) | int(data[33]) << 8
				event.key = keyOf(fieldU32(data, 28), fieldU32(data, 24))
				event.code = placeOf(fieldU32(data, 24))
				event.repeat = data[37] != byte(0)
				event.modifiers = modifiersOf(held)
				if kind == lib.SDL_EVENT_KEY_DOWN && (held & (lib.SDL_KMOD_CTRL | lib.SDL_KMOD_ALT | lib.SDL_KMOD_GUI)) == 0 {
					event.text = typedBy(lib.SDL_GetKeyFromScancode(int32(fieldU32(data, 24)), uint16(held), false))
				}
			case lib.SDL_EVENT_TEXT_INPUT:
				event.kind = r.PlatformEventKind.TextInput
				event.text = cString(fieldPointer(data, 24))
			case lib.SDL_EVENT_TEXT_EDITING:
				event.kind = r.PlatformEventKind.TextCompose
				event.text = cString(fieldPointer(data, 24))
				// SDL counts the caret in characters; -1 when the input method does not say.
				let start = fieldI32(data, 32)
				event.caret = start < 0 ?? (event.text.len(), start)
			default:
				return none
		}
		return event
	}

	// The window state SDL's window flags describe.
	internal def stateOf(flags uint64) ui.WindowState {
		return ui.WindowState.Fullscreen when (flags & lib.SDL_WINDOW_FULLSCREEN) != uint64(0)
		return ui.WindowState.Minimized when (flags & lib.SDL_WINDOW_MINIMIZED) != uint64(0)
		return ui.WindowState.Maximized when (flags & lib.SDL_WINDOW_MAXIMIZED) != uint64(0)
		return ui.WindowState.Normal
	}
}
