internal std.ui partial module std.ui.host.sdl {
	use (
		std.testing
		std.ui
		std.ui.host.sdl.lib
		std.ui.renderer as r
	)

	check "SDL host events" {
		// An SDL event of the given type for window id 7, all other bytes zero.
		def blank(kind uint32) byte[] {
			let data byte[]
			data.len(lib.SDL_EVENT_SIZE)
			put32(data, 0, kind)
			put32(data, 16, uint32(7))
			return data
		}

		def put32(data byte[], at int, value uint32) {
			data[at] = byte(value & uint32(0xFF))
			data[at + 1] = byte((value >> 8) & uint32(0xFF))
			data[at + 2] = byte((value >> 16) & uint32(0xFF))
			data[at + 3] = byte((value >> 24) & uint32(0xFF))
		}

		// The platform event for the SDL event; one of kind None when it gives none.
		def decode(data byte[], window int, density float = 1.0, scale float = 1.0) r.PlatformEvent {
			let found = platformEvent(data, uint(window), density, scale)
			return r.PlatformEvent{kind: r.PlatformEventKind.None} when found is none
			return found
		}

		def putFloat(data byte[], at int, value float) {
			put32(data, at, __bitcast_u32_from_f32(float32(value)))
		}

		// SDL's key codes become `Key` members; a character outside ASCII is named by its
		// key's place when that is a letter's or a digit's, else it is `Character`; a key
		// without a name is `Unknown`.
		@test()
		def TestKeyNumbers() {
			// A key's place is the key a US keyboard has there, and a key code that
			// prints is the text of its press.
			assert placeOf(uint32(4)) == ui.Key.A && placeOf(uint32(29)) == ui.Key.Z && placeOf(uint32(30)) == ui.Key.Digit1 && placeOf(uint32(39)) == ui.Key.Digit0
			assert placeOf(uint32(40)) == ui.Key.Enter && placeOf(uint32(44)) == ui.Key.Space && placeOf(uint32(56)) == ui.Key.Slash && placeOf(uint32(79)) == ui.Key.Right
			assert placeOf(uint32(50)) == ui.Key.Unknown && placeOf(uint32(0)) == ui.Key.Unknown
			assert typedBy(uint32(0x41)) == "A" && typedBy(uint32(0xE9)) == "é" && typedBy(uint32(13)) == "" && typedBy(uint32(0x4000004F)) == ""
			assert keyOf(uint32(0x61)) == ui.Key.A && keyOf(uint32(0x7A)) == ui.Key.Z
			assert keyOf(uint32(0x20)) == ui.Key.Space && keyOf(uint32(0x31)) == ui.Key.Digit1 && keyOf(uint32(0x2F)) == ui.Key.Slash
			assert keyOf(uint32(0x1B)) == ui.Key.Escape && keyOf(uint32(0x0D)) == ui.Key.Enter && keyOf(uint32(0x09)) == ui.Key.Tab
			assert keyOf(uint32(0x08)) == ui.Key.Backspace && keyOf(uint32(0x7F)) == ui.Key.Delete
			assert keyOf(uint32(0x4000004F)) == ui.Key.Right && keyOf(uint32(0x40000050)) == ui.Key.Left
			assert keyOf(uint32(0x4000004A)) == ui.Key.Home && keyOf(uint32(0x4000004D)) == ui.Key.End
			assert keyOf(uint32(0x4000003A)) == ui.Key.F1 && keyOf(uint32(0x40000045)) == ui.Key.F12
			assert keyOf(uint32(0x40000059)) == ui.Key.Keypad1 && keyOf(uint32(0x40000062)) == ui.Key.Keypad0 && keyOf(uint32(0x40000058)) == ui.Key.KeypadEnter
			assert keyOf(uint32(0x400000E1)) == ui.Key.LeftShift && keyOf(uint32(0x400000E0)) == ui.Key.LeftControl && keyOf(uint32(0x400000E7)) == ui.Key.RightSuper
			assert keyOf(uint32(0xE9)) == ui.Key.Character && keyOf(uint32(0x40000101)) == ui.Key.Unknown
			// The Cyrillic letter on the key where C is, é on the key where 2 is, 0 by place.
			assert keyOf(uint32(0x441), uint32(6)) == ui.Key.C && keyOf(uint32(0xE9), uint32(31)) == ui.Key.Digit2
			assert keyOf(uint32(0x439), uint32(39)) == ui.Key.Digit0 && keyOf(uint32(0xE9), uint32(47)) == ui.Key.Character
			assert keyOf(uint32(0x20000001)) == ui.Key.Unknown && keyOf(uint32(0x21)) == ui.Key.Character
		}

		// A key event carries its number, its repeat flag and the modifiers held; either
		// side of a modifier counts.
		@test()
		def TestKeyEvent() {
			let data = blank(lib.SDL_EVENT_KEY_DOWN)
			put32(data, 28, uint32(0x63))
			data[32] = byte(0x82)
			data[33] = byte(0x01)
			data[36] = byte(1)
			data[37] = byte(1)
			let event = decode(data, 99)
			assert event.kind == r.PlatformEventKind.KeyDown && event.window == uint(99)
			assert event.key == ui.Key.C && event.repeat
			assert event.modifiers.shift && event.modifiers.control && event.modifiers.alt && !event.modifiers.command
			let up = decode(blank(lib.SDL_EVENT_KEY_UP), 99)
			assert up.kind == r.PlatformEventKind.KeyUp && !up.repeat
		}

		// Pointer positions are in device pixels: window coordinates times the density.
		// A wheel step scrolls down for a turn towards the user, and a flipped wheel
		// the other way.
		@test()
		def TestPointerEvents() {
			let press = blank(lib.SDL_EVENT_MOUSE_BUTTON_DOWN)
			press[24] = byte(lib.SDL_BUTTON_RIGHT)
			press[26] = byte(2)
			putFloat(press, 28, 10.0)
			putFloat(press, 32, 20.0)
			let down = decode(press, 1, 2.0, 2.0)
			assert down.kind == r.PlatformEventKind.MouseDown && down.button == ui.MouseButton.Right && down.clicks == 2
			assert down.position.x == 20.0 && down.position.y == 40.0

			let extra = blank(lib.SDL_EVENT_MOUSE_BUTTON_UP)
			extra[24] = byte(4)
			assert decode(extra, 1).kind == r.PlatformEventKind.None

			let moved = blank(lib.SDL_EVENT_MOUSE_MOTION)
			putFloat(moved, 28, 5.0)
			putFloat(moved, 32, 6.0)
			putFloat(moved, 36, -1.0)
			putFloat(moved, 40, 2.0)
			let move = decode(moved, 1, 1.5, 1.5)
			assert move.position.x == 7.5 && move.position.y == 9.0 && move.delta.x == -1.5 && move.delta.y == 3.0

			let turned = blank(lib.SDL_EVENT_MOUSE_WHEEL)
			putFloat(turned, 24, 1.0)
			putFloat(turned, 28, -1.0)
			let wheel = decode(turned, 1, 1.0, 1.25)
			assert wheel.kind == r.PlatformEventKind.MouseWheel
			assert wheel.delta.x == wheelStep * 1.25 && wheel.delta.y == wheelStep * 1.25
			put32(turned, 32, uint32(1))
			let flipped = decode(turned, 1)
			assert flipped.delta.x == -wheelStep && flipped.delta.y == -wheelStep
		}

		// Window events: close, the frame's new size, and the states the desktop puts a
		// window in. An event the UI has no use for gives none.
		@test()
		def TestWindowEvents() {
			let close = decode(blank(lib.SDL_EVENT_WINDOW_CLOSE_REQUESTED), 3)
			assert close.kind == r.PlatformEventKind.Close && close.window == uint(3)

			let sized = blank(lib.SDL_EVENT_WINDOW_PIXEL_SIZE_CHANGED)
			put32(sized, 20, uint32(640))
			put32(sized, 24, uint32(480))
			let resize = decode(sized, 3)
			assert resize.kind == r.PlatformEventKind.Resize && resize.size.width == 640.0 && resize.size.height == 480.0

			let small = decode(blank(lib.SDL_EVENT_WINDOW_MINIMIZED), 3)
			assert small.kind == r.PlatformEventKind.StateChange && small.state == ui.WindowState.Minimized
			let whole = decode(blank(lib.SDL_EVENT_WINDOW_ENTER_FULLSCREEN), 3)
			assert whole.state == ui.WindowState.Fullscreen

			assert stateOf(lib.SDL_WINDOW_MAXIMIZED | lib.SDL_WINDOW_RESIZABLE) == ui.WindowState.Maximized
			assert stateOf(lib.SDL_WINDOW_FULLSCREEN | lib.SDL_WINDOW_MAXIMIZED) == ui.WindowState.Fullscreen
			assert stateOf(lib.SDL_WINDOW_OPENGL) == ui.WindowState.Normal

			// SDL_EVENT_QUIT.
			assert platformEvent(blank(uint32(256)), uint(3), 1.0, 1.0) is none
		}

		// A host with no window open has nothing to poll, refuses the clipboard, and does
		// not know a window it did not open.
		@test()
		def TestHostWithoutWindows() !none {
			let host = new SDLHost()
			assert (try host.poll()).len() == 0
			// A drop: its start says nothing, its place is a DragOver in device pixels,
			// and an end with nothing dropped is a drag that left the window.
			assert host.dropEvent(blank(lib.SDL_EVENT_DROP_BEGIN), 1, 2.0) is none
			let place = blank(lib.SDL_EVENT_DROP_POSITION)
			putFloat(place, 20, 10.0)
			putFloat(place, 24, 20.0)
			let over = host.dropEvent(place, 1, 2.0)
			assert !(over is none)
			if !(over is none) {
				assert over.kind == r.PlatformEventKind.DragOver && over.position.x == 20.0 && over.position.y == 40.0 && over.window == uint(1)
			}
			let gone = host.dropEvent(blank(lib.SDL_EVENT_DROP_COMPLETE), 1, 2.0)
			assert !(gone is none)
			if !(gone is none) {
				assert gone.kind == r.PlatformEventKind.DragLeave && gone.files.len() == 0
			}
			let refused = false
			host.clipboardText() onerror (e error) {
				refused = true
				recover ""
			}
			assert refused
			let unknown = false
			host.setWindowTitle(new r.Window(uint(5)), "x") onerror (e error) {
				unknown = true
				recover none
			}
			assert unknown
			assert !host.makeCurrent(uint(5)) && host.surfaceSize(uint(5)).width == 0.0
		}
	}
}
