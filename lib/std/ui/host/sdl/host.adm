@os("linux", "darwin", "windows", "android", "ios")
internal std.ui partial module std.ui.host.sdl {
	use (
		std.formats.image
		std.math.geom::(Point, Rect, Size)
		std.time
		std.ui
		std.ui.host.sdl.lib
		std.ui.renderer as r
		std.ui.styles::Cursor
		std.units::Pixels
	)

	// Which API the host opens its windows for: OpenGL with a context per
	// window, Vulkan surfaces once a Vulkan renderer is attached, or plain
	// windows that take their picture as pixels (the CPU renderer).
	internal enum SurfaceApi {
		OpenGL,
		Vulkan,
		Pixels,
	}

	// The desktop host on Linux, macOS and Windows: an SDL3 window with an OpenGL
	// context per Window handle, or a Vulkan surface when the renderer asks
	// (`vulkanInstanceExtensions`).
	//
	// SDL's windows, events and contexts belong to the OS thread that opened the first
	// window; the task that calls the host is bound to its thread from its first call on.
	type SDLHost {
		internal started      bool
		// What the windows are opened for.
		internal api          SurfaceApi                = SurfaceApi.OpenGL
		// The OpenGL context of each window, by handle (0 for a Vulkan window).
		internal contexts     map<uint, uint>
		// Whether each window was opened with vsync, by handle.
		internal vsyncs       map<uint, bool>
		// The windows opened transparent.
		internal transparent  map<uint, bool>
		// The window handle for each id SDL's events name windows by.
		internal handles      map<uint32, uint>
		// Device pixels per window coordinate and per logical pixel of each window, read
		// again when SDL reports the window's surface or display changed.
		internal scaled       map<uint, (float, float)>
		// The windows text input is on for.
		internal typing       map<uint, bool>
		internal tray         ?Tray                     = none
		// The files and text of the drop under way, and where it was last, in device
		// pixels of its window.
		internal dropFiles    string[]
		internal dropText     string
		internal dropAt       Point                     = new Point(0.0, 0.0)
		// The system's pointer shapes made so far, by SDL's number for each.
		internal cursors      map<int, uint>
		internal pointerOff   bool
		// The OS thread the windows live on, 0 before the first window.
		internal windowThread uint
		internal event        byte[]
		// The event `wake` pushes: of SDL's user type, for no window.
		internal nudge        byte[]

		def new() {
			contexts = map<uint, uint>{}
			vsyncs = map<uint, bool>{}
			transparent = map<uint, bool>{}
			handles = map<uint32, uint>{}
			typing = map<uint, bool>{}
			scaled = map<uint, (float, float)>{}
			event.len(lib.SDL_EVENT_SIZE)
			nudge.len(lib.SDL_EVENT_SIZE)
			// SDL_EVENT_USER, low byte first.
			nudge[1] = byte(0x80)
		}

		// Starts SDL's video and events on the caller's thread.
		//
		// Fails when SDL cannot start: no display, no video driver.
		internal def start() !none {
			return none when started
			lib.bindTaskToThread()
			// An application's window leaves the desktop's compositor on: with it off,
			// every other window loses its shadows and transparency while this one is
			// open. A hint that cannot be set changes nothing else.
			let _ = lib.SDL_SetHint(lib.SDL_HINT_VIDEO_X11_NET_WM_BYPASS_COMPOSITOR, "0")
			fail "the window system cannot start: {lib.SDL_GetError()}" unless lib.SDL_Init(lib.SDL_INIT_VIDEO)
			windowThread = lib.currentThread()
			started = true
			return none
		}

		// Fails when the window is not one this host has open.
		internal def known(win r.Window) !uint {
			fail "unknown window" unless contexts.hasKey(win.id())
			return win.id()
		}

		// Opens a window with an OpenGL context (or for a Vulkan surface) and
		// returns its handle.
		//
		// Fails when SDL cannot start or cannot create the window or its context.
		def openWindow(cfg r.WindowConfig) !r.Window {
			try start()
			let vulkan = api == SurfaceApi.Vulkan
			let flags = lib.SDL_WINDOW_HIGH_PIXEL_DENSITY
			flags = flags | lib.SDL_WINDOW_VULKAN when vulkan
			flags = flags | lib.SDL_WINDOW_OPENGL when api == SurfaceApi.OpenGL
			flags = flags | lib.SDL_WINDOW_RESIZABLE when cfg.resizable
			flags = flags | lib.SDL_WINDOW_BORDERLESS unless cfg.decorated
			flags = flags | lib.SDL_WINDOW_TRANSPARENT when cfg.transparent
			flags = flags | lib.SDL_WINDOW_ALWAYS_ON_TOP when cfg.alwaysOnTop
			// A window that lets every press through only shows something: it takes no
			// focus and is not among the desktop's windows.
			flags = flags | lib.SDL_WINDOW_NOT_FOCUSABLE | lib.SDL_WINDOW_UTILITY when cfg.clickThrough == r.ClickThrough.All
			flags = flags | lib.SDL_WINDOW_UTILITY when cfg.kind == ui.WindowKind.Utility
			// A surface with alpha for a window that shows what is behind it; the setting
			// stays for the windows created after, so it is given for each.
			let _ = lib.SDL_GL_SetAttribute(lib.SDL_GL_ALPHA_SIZE, cfg.transparent ?? (8, 0))
			// The size, the smallest size and the place are in logical pixels; SDL takes
			// them in the desktop's coordinates of the display the window goes to.
			let unit = desktopUnitAt(cfg.position)
			// Under X11 SDL gives a 32-bit visual (an alpha channel) to transparent
			// OpenGL windows only: a transparent Vulkan or pixel window is asked for
			// one by id.
			let visual = api != SurfaceApi.OpenGL && cfg.transparent ?? (lib.transparentVisualId(), uint(0))
			if visual != 0 {
				let _ = lib.SDL_SetHint(lib.SDL_HINT_VIDEO_X11_WINDOW_VISUALID, "{visual}")
			}
			let handle = lib.SDL_CreateWindow(cfg.title, int((cfg.size.width * unit).round()), int((cfg.size.height * unit).round()), flags)
			if visual != 0 {
				let _ = lib.SDL_ResetHint(lib.SDL_HINT_VIDEO_X11_WINDOW_VISUALID)
			}
			fail "the window cannot be created: {lib.SDL_GetError()}" when handle == 0
			let context = uint(0)
			if api == SurfaceApi.OpenGL {
				context = lib.SDL_GL_CreateContext(handle)
				if context == 0 {
					let why = lib.SDL_GetError()
					lib.SDL_DestroyWindow(handle)
					fail "the window's OpenGL context cannot be created: {why}"
				}
				if !lib.glDraws() {
					lib.SDL_GL_DestroyContext(context)
					lib.SDL_DestroyWindow(handle)
					fail "the window cannot be drawn in: this display's OpenGL has no framebuffer objects (OpenGL 3.0 or newer is needed; a virtual machine or remote desktop without GPU acceleration gives Windows' OpenGL 1.1)"
				}
				let _ = lib.SDL_GL_SetSwapInterval(cfg.vsync ?? (1, 0))
			}
			vsyncs = vsyncs.set(handle, cfg.vsync)
			transparent = transparent.set(handle, true) when cfg.transparent
			// A desktop that refuses a place or a smallest size leaves the window as it is.
			let least = cfg.minSize
			if !(least is none) {
				let _ = lib.SDL_SetWindowMinimumSize(handle, int((float(least.width) * unit).round()), int((float(least.height) * unit).round()))
			}
			let place = cfg.position
			if !(place is none) {
				let _ = lib.SDL_SetWindowPosition(handle, int((float(place.x) * unit).round()), int((float(place.y) * unit).round()))
				// The desktop places a window after it is asked: `windowBounds` is right
				// only once it has.
				let _ = lib.SDL_SyncWindow(handle)
			}
			// A window with an owner stays above it; a desktop keeps such a window out of
			// its taskbar. One that refuses leaves an ordinary window.
			let owner = cfg.owner
			if !(owner is none) {
				let above = owner.id()
				if contexts.hasKey(above) {
					let _ = lib.SDL_SetWindowParent(handle, above)
				}
			}
			contexts = contexts.set(handle, context)
			handles = handles.set(lib.SDL_GetWindowID(handle), handle)
			// A window without a frame is resized by its own edges, unless it lets every
			// press through.
			if !cfg.decorated && cfg.resizable && cfg.clickThrough != r.ClickThrough.All {
				let areas = areasOf(handle)
				areas.edges = true
			}

			let win = new r.Window(handle)
			let icon = cfg.icon
			return win when icon is none
			// A window whose icon is refused is closed again: the caller gets no handle to
			// close it with.
			setWindowIcon(win, icon) onerror (refused error) {
				closeWindow(win) onerror recover none
				fail refused
			}
			return win
		}

		// What SDL is told about the window's points, made and given to SDL on first use.
		internal def areasOf(handle uint) WindowAreas {
			let held = asked.of.get(handle)
			return held unless held is none
			let made = new WindowAreas()
			asked.of = asked.of.set(handle, made)
			let (density, scale) = scales(handle)
			made.unit = scale / density
			let _ = lib.SDL_SetWindowHitTest(handle, windowAreaAsked, 0)
			return made
		}

		// Sets what says whether a point of the window, in logical pixels, is a place the
		// user drags the window by; none: no point is.
		//
		// Fails when the window is unknown.
		def setWindowDragTest(win r.Window, test ?(def(Point<Pixels>) bool)) !none {
			let handle = try known(win)
			let areas = areasOf(handle)
			areas.drags = test
			return none
		}

		// The shape `pixels` for a window whose edges resize it: a copy with the band
		// along each edge there for the pointer, whatever is drawn in it, so that the
		// window can be resized where it shows nothing. Any other window: `pixels`.
		internal def withEdges(handle uint, width int, height int, pixels byte[]) byte[] {
			let areas = asked.of.get(handle)
			return pixels when areas is none || !areas.edges
			let wide int32[] = [int32(0)]
			let high int32[] = [int32(0)]
			let _ = lib.SDL_GetWindowSize(handle, wide, high)
			return pixels when wide[0] <= 0 || high[0] <= 0
			// The band in pixels of the shape, which is stretched over the window.
			let across = int((edgeBand * float(width) / float(wide[0])).ceil())
			let down = int((edgeBand * float(height) / float(high[0])).ceil())
			return pixels when across * 2 >= width || down * 2 >= height
			let shape = pixels.clone()
			for let y = 0; y < height; y++ {
				let edge = y < down || y >= height - down
				for let x = 0; x < width; x++ {
					// Inside the top and bottom bands every pixel; else the two ends.
					if !edge && x == across {
						x = width - across
					}
					shape[(y * width + x) * 4 + 3] = byte(255)
				}
			}
			return shape
		}

		// Says where the window is there for the pointer: where the alpha of `pixels`
		// (`width` by `height`, four bytes a pixel) is not 0.
		//
		// Fails when the window is unknown, the pixels are too few, or SDL or the
		// desktop cannot shape the window.
		def setWindowShape(win r.Window, width int, height int, pixels byte[]) !none {
			let handle = try known(win)
			fail "the shape is empty" when width <= 0 || height <= 0 || pixels.len() < width * height * 4
			let shape = withEdges(handle, width, height, pixels)
			let surface = lib.SDL_CreateSurfaceFrom(width, height, lib.SDL_PIXELFORMAT_RGBA32, shape, width * 4)
			fail "the shape cannot be used: {lib.SDL_GetError()}" when surface == 0
			let shaped = lib.SDL_SetWindowShape(handle, surface)
			let why = shaped ?? ("", lib.SDL_GetError())
			lib.SDL_DestroySurface(surface)
			// The surface read `shape` in place: it is held until the surface is gone.
			fail "the window cannot be shaped: {why}" unless shaped && shape.len() > 0
			return none
		}

		// Destroys the window and its context; SDL shuts down with the last one.
		//
		// Fails when the window is unknown.
		def closeWindow(win r.Window) !none {
			let handle = try known(win)
			if typing.hasKey(handle) {
				let _ = lib.SDL_StopTextInput(handle)
				typing = typing.delete(handle)
			}
			let context = contexts.get(handle)
			if !(context is none) && context != 0 {
				let _ = lib.SDL_GL_DestroyContext(context)
			}
			contexts = contexts.delete(handle)
			vsyncs = vsyncs.delete(handle) when vsyncs.hasKey(handle)
			transparent = transparent.delete(handle) when transparent.hasKey(handle)
			asked.of = asked.of.delete(handle) when asked.of.hasKey(handle)
			scaled = scaled.delete(handle) when scaled.hasKey(handle)
			let id = lib.SDL_GetWindowID(handle)
			handles = handles.delete(id) when handles.hasKey(id)
			lib.SDL_DestroyWindow(handle)
			stopWhenIdle()
			return none
		}

		// SDL's number for a pointer shape; -1 for one that hides the pointer. A shape
		// the system does not have is the plain arrow.
		internal def systemCursor(cursor Cursor) int {
			match cursor {
				case Cursor.Pointer, Cursor.Link:
					return 11
				case Cursor.Text:
					return 1
				case Cursor.Wait:
					return 2
				case Cursor.Crosshair:
					return 3
				case Cursor.Progress:
					return 4
				case Cursor.ResizeDiagonalDown:
					return 5
				case Cursor.ResizeDiagonalUp:
					return 6
				case Cursor.ResizeHorizontal, Cursor.ResizeColumn:
					return 7
				case Cursor.ResizeVertical, Cursor.ResizeRow:
					return 8
				case Cursor.Move, Cursor.Grab, Cursor.Grabbing:
					return 9
				case Cursor.NotAllowed:
					return 10
				case Cursor.Hidden:
					return -1
				default:
					return 0
			}
		}

		// Gives the pointer that shape. The shape is the program's, not one window's:
		// the service asks for the window the pointer is over.
		//
		// Fails when the window is unknown.
		def setCursor(win r.Window, cursor Cursor) !none {
			let _ = try known(win)
			let id = systemCursor(cursor)
			if id < 0 {
				pointerOff = true
				let _ = lib.SDL_HideCursor()
				return none
			}
			if pointerOff {
				pointerOff = false
				let _ = lib.SDL_ShowCursor()
			}
			if !cursors.hasKey(id) {
				cursors = cursors.set(id, lib.SDL_CreateSystemCursor(id))
			}
			let shape = cursors[id]
			// A system without that shape keeps the one it shows.
			if shape != uint(0) {
				let _ = lib.SDL_SetCursor(shape)
			}
			return none
		}

		// Shuts SDL down once no window and no tray icon is left.
		internal def stopWhenIdle() {
			return when !started || contexts.len() > 0 || !(tray is none)
			lib.SDL_Quit()
			started = false
			cursors = map<int, uint>{}
			windowThread = 0
		}

		// Sets the window's title.
		//
		// Fails when the window is unknown.
		def setWindowTitle(win r.Window, title string) !none {
			let handle = try known(win)
			let _ = lib.SDL_SetWindowTitle(handle, title)
			return none
		}

		// The window as the window system knows it (`r.WindowHandles`): the X11 window id
		// under X11, the HWND on Windows, the NSWindow on macOS. A Wayland surface has no
		// name another process can use, so there the handle stays 0; so does a window the
		// host does not know.
		def nativeWindow(win r.Window) r.NativeWindow {
			let handle = known(win) onerror recover uint(0)
			return r.NativeWindow{} when handle == 0
			let system = lib.SDL_GetCurrentVideoDriver()
			let props = lib.SDL_GetWindowProperties(handle)
			if system == "x11" {
				return r.NativeWindow{system: system, handle: uint(lib.SDL_GetNumberProperty(props, "SDL.window.x11.window", 0))}
			}
			if system == "windows" {
				return r.NativeWindow{system: system, handle: lib.SDL_GetPointerProperty(props, "SDL.window.win32.hwnd", 0)}
			}
			if system == "cocoa" {
				return r.NativeWindow{system: system, handle: lib.SDL_GetPointerProperty(props, "SDL.window.cocoa.window", 0)}
			}
			return r.NativeWindow{system: system}
		}

		// Sets the window's icon from an RGBA image.
		//
		// Fails when the window is unknown or the image is empty or short of pixels.
		def setWindowIcon(win r.Window, icon image.Image) !none {
			let handle = try known(win)
			let surface = try surfaceOf(icon)
			let _ = lib.SDL_SetWindowIcon(handle, surface)
			lib.SDL_DestroySurface(surface)
			return none
		}

		// Puts the window on the screen and in the taskbar, or takes it off both.
		//
		// Fails when the window is unknown.
		def setWindowVisible(win r.Window, visible bool) !none {
			let handle = try known(win)
			let done = visible ?? (lib.SDL_ShowWindow(handle), lib.SDL_HideWindow(handle))
			fail "the window cannot be {visible ?? ("shown", "hidden")}: {lib.SDL_GetError()}" unless done
			return none
		}

		// Minimizes, maximizes, makes fullscreen or brings back to Normal.
		//
		// Fails when the window is unknown or the desktop refuses.
		def setWindowState(win r.Window, state ui.WindowState) !none {
			let handle = try known(win)
			let now = stateOf(lib.SDL_GetWindowFlags(handle))
			return none when now == state
			let done = true
			done = lib.SDL_SetWindowFullscreen(handle, false) when now == ui.WindowState.Fullscreen
			match state {
				case ui.WindowState.Normal:
					done = lib.SDL_RestoreWindow(handle) when now != ui.WindowState.Fullscreen
				case ui.WindowState.Minimized:
					done = lib.SDL_MinimizeWindow(handle)
				case ui.WindowState.Maximized:
					done = lib.SDL_MaximizeWindow(handle)
				case ui.WindowState.Fullscreen:
					done = lib.SDL_SetWindowFullscreen(handle, true)
			}
			fail "the window's state cannot be changed: {lib.SDL_GetError()}" unless done
			return none
		}

		// Puts the pointer at `at` of the window, in logical pixels.
		//
		// Fails when the window is not one this host has open.
		def warpPointer(win r.Window, at Point<Pixels>) !none {
			let handle = try known(win)
			lib.bindTaskToThread()
			let (density, scale) = scales(handle)
			let unit = scale / density
			lib.SDL_WarpMouseInWindow(handle, float32(float(at.x) * unit), float32(float(at.y) * unit))
			return none
		}

		// Device pixels per window coordinate, and per logical pixel, of the window.
		internal def scales(handle uint) (float, float) {
			let known = scaled.get(handle)
			return known unless known is none
			let density = float(lib.SDL_GetWindowPixelDensity(handle))
			density = 1.0 when density <= 0.0
			let scale = float(lib.SDL_GetWindowDisplayScale(handle))
			scale = density when scale <= 0.0
			scaled = scaled.set(handle, (density, scale))
			// The hit test reads its points in the same unit.
			let areas = asked.of.get(handle)
			areas.unit = scale / density unless areas is none
			return (density, scale)
		}

		// The window's position and size on the desktop, in logical pixels.
		//
		// Fails when the window is unknown.
		def windowBounds(win r.Window) !Rect<Pixels> {
			let handle = try known(win)
			let x int32[]
			let y int32[]
			let w int32[]
			let h int32[]
			x.len(1)
			y.len(1)
			w.len(1)
			h.len(1)
			let _ = lib.SDL_GetWindowPosition(handle, x, y)
			let _ = lib.SDL_GetWindowSize(handle, w, h)
			let (density, scale) = scales(handle)
			// Window coordinates to the logical pixel.
			let unit = scale / density
			return desktopRect([x[0], y[0], w[0], h[0]], unit)
		}

		// Takes one of SDL's drop events: SDL sends the start of a drop, where it is while
		// it is over the window, then each file or text dropped, then the end. The files
		// and text are kept until the end, which is one Drop; an end with nothing kept
		// is a drag that left the window.
		def dropEvent(data byte[], window uint, density float) ?r.PlatformEvent {
			let kind = fieldU32(data, 0)
			let at = new Point(fieldF32(data, 20) * density, fieldF32(data, 24) * density)
			switch kind {
				case lib.SDL_EVENT_DROP_BEGIN:
					dropFiles = string[]
					dropText = ""
					return none
				case lib.SDL_EVENT_DROP_FILE:
					dropFiles.push(cString(fieldPointer(data, 40)))
					dropAt = at
					return none
				case lib.SDL_EVENT_DROP_TEXT:
					dropText = cString(fieldPointer(data, 40))
					dropAt = at
					return none
				case lib.SDL_EVENT_DROP_POSITION:
					dropAt = at
					let over = r.PlatformEvent{kind: r.PlatformEventKind.DragOver, window: window}
					over.position = at
					return over
				default:
			}
			let done = r.PlatformEvent{kind: r.PlatformEventKind.DragLeave, window: window}
			done.position = dropAt
			if dropFiles.len() > 0 || dropText != "" {
				done.kind = r.PlatformEventKind.Drop
				done.files = dropFiles
				done.text = dropText
			}
			dropFiles = string[]
			dropText = ""
			return done
		}

		// Moves the window and sizes what it shows.
		//
		// Fails when the window is unknown or SDL refuses the place or the size.
		def setWindowBounds(win r.Window, bounds Rect<Pixels>) !none {
			let handle = try known(win)
			let unit = desktopUnitAt(new Point<Pixels>(bounds.left, bounds.top))
			let (wide, high) = (int((float(bounds.width) * unit).round()), int((float(bounds.height) * unit).round()))
			fail "a window cannot be {wide} by {high}" when wide <= 0 || high <= 0
			fail "the window cannot be sized: {lib.SDL_GetError()}" unless lib.SDL_SetWindowSize(handle, wide, high)
			fail "the window cannot be moved: {lib.SDL_GetError()}" unless lib.SDL_SetWindowPosition(handle, int((float(bounds.left) * unit).round()), int((float(bounds.top) * unit).round()))
			// `windowBounds` answers with the old place until the desktop has moved it.
			let _ = lib.SDL_SyncWindow(handle)
			return none
		}

		// Puts the window above the others.
		//
		// Fails when the window is unknown or the desktop refuses.
		def raiseWindow(win r.Window) !none {
			let handle = try known(win)
			fail "the window cannot be raised: {lib.SDL_GetError()}" unless lib.SDL_RaiseWindow(handle)
			return none
		}

		// The events waiting for every window, oldest first. Tray menu lines chosen
		// meanwhile run their `onSelect` before it returns.
		//
		// Does not fail.
		def poll() !r.PlatformEvent[] {
			let out r.PlatformEvent[]
			return out unless started
			for lib.SDL_PollEvent(event) {
				let handle = handles.get(fieldU32(event, 16))
				continue when handle is none
				if lib.changesScale(fieldU32(event, 0)) && scaled.hasKey(handle) {
					scaled = scaled.delete(handle)
				}
				let (density, scale) = scales(handle)
				let kind = fieldU32(event, 0)
				if kind >= lib.SDL_EVENT_DROP_FILE && kind <= lib.SDL_EVENT_DROP_POSITION {
					let about = dropEvent(event, handle, density)
					out.push(about) unless about is none
					continue
				}
				let found = platformEvent(event, handle, density, scale)
				continue when found is none
				out.push(found)
			}
			let shown = tray
			if !(shown is none) && trayChosen.len() > 0 {
				let chosen = trayChosen
				trayChosen = []
				for let line in chosen {
					shown.choose(line)
				}
			}
			return out
		}

		// Returns when an event is waiting or `limit` has passed. Tray menu lines chosen
		// meanwhile are run by the next `poll`.
		//
		// Does not fail.
		def wait(limit duration) !none {
			return none unless started
			let _ = lib.SDL_WaitEventTimeout(0, int32((float(limit) / float(1ms)).max(0.0)))
			return none
		}

		// Ends a `wait` in progress by putting an event of no window in SDL's queue, which
		// SDL allows from any thread; `poll` drops it.
		def wake() {
			return unless started
			let _ = lib.SDL_PushEvent(nudge)
		}

		// The connected monitors, the primary one first, in logical pixels.
		//
		// Fails when SDL cannot start.
		def displays() !ui.Display[] {
			try start()
			return sdlDisplays()
		}

		// Fails when no window is open or the caller is on another thread than the windows'.
		internal def clipboardReady() !none {
			fail "clipboard: no window is open" when contexts.len() == 0
			fail "clipboard: only the task that runs the windows can use their clipboard" when lib.currentThread() != windowThread
			return none
		}

		// The text on the system clipboard, "" when it holds none.
		//
		// Fails when no window is open or the caller is not on the thread that runs the windows.
		def clipboardText() !string {
			try clipboardReady()
			let held = lib.SDL_GetClipboardText()
			let text = cString(held)
			lib.SDL_free(held)
			return text
		}

		// Puts the text on the system clipboard, replacing what was there.
		//
		// Fails when no window is open, the caller is not on the thread that runs the
		// windows, or the window system refuses the text.
		def setClipboardText(text string) !none {
			try clipboardReady()
			fail "clipboard: {lib.SDL_GetError()}" unless lib.SDL_SetClipboardText(text)
			return none
		}

		// Turns text input on for the window, for a text of the given kind.
		//
		// Fails when the window is unknown or the window system refuses.
		def startTextInput(win r.Window, kind ui.TextKind) !none {
			let handle = try known(win)
			let about = lib.SDL_CreateProperties()
			let what = lib.SDL_TEXTINPUT_TYPE_TEXT
			match kind {
				case ui.TextKind.Number, ui.TextKind.Decimal, ui.TextKind.Phone:
					what = lib.SDL_TEXTINPUT_TYPE_NUMBER
				case ui.TextKind.Email:
					what = lib.SDL_TEXTINPUT_TYPE_TEXT_EMAIL
				case ui.TextKind.Password:
					what = lib.SDL_TEXTINPUT_TYPE_TEXT_PASSWORD_HIDDEN
				default:
			}
			let _ = lib.SDL_SetNumberProperty(about, lib.SDL_PROP_TEXTINPUT_TYPE_NUMBER, int64(what))
			let _ = lib.SDL_SetBooleanProperty(about, lib.SDL_PROP_TEXTINPUT_MULTILINE_BOOLEAN, kind == ui.TextKind.Multiline)
			let done = lib.SDL_StartTextInputWithProperties(handle, about)
			lib.SDL_DestroyProperties(about)
			fail "text input cannot start: {lib.SDL_GetError()}" unless done
			typing = typing.set(handle, true)
			return none
		}

		// Turns text input off for the window.
		//
		// Fails when the window is unknown.
		def stopTextInput(win r.Window) !none {
			let handle = try known(win)
			return none unless typing.hasKey(handle)
			let _ = lib.SDL_StopTextInput(handle)
			typing = typing.delete(handle)
			return none
		}

		// Tells the input method where the caret is, in logical pixels of the window.
		//
		// Fails when the window is unknown.
		def setTextInputCaret(win r.Window, caret Rect<Pixels>) !none {
			let handle = try known(win)
			let (density, scale) = scales(handle)
			let unit = scale / density
			let area int32[] = [
				int32(float(caret.left) * unit),
				int32(float(caret.top) * unit),
				int32(float(caret.width) * unit) + int32(1),
				int32(float(caret.height) * unit) + int32(1),
			]
			let _ = lib.SDL_SetTextInputArea(handle, area, 0)
			return none
		}

		// Shows the tray icon with its tooltip and menu, or replaces what it shows.
		//
		// Fails when SDL cannot start, the icon is empty, or the desktop has no tray.
		def showTray(icon image.Image, tooltip string, menu ui.MenuEntry[]) !none {
			try start()
			let made = try openTray(icon, tooltip, menu)
			let before = tray
			before.close() unless before is none
			tray = made
			return none
		}

		// Removes the tray icon. Does not fail.
		def hideTray() !none {
			let shown = tray
			return none when shown is none
			shown.close()
			tray = none
			trayChosen = []
			stopWhenIdle()
			return none
		}

		// Makes the host open its windows for pixels.
		//
		// Fails when SDL cannot start or a window is open for another API already.
		def pixelWindows() !none {
			try start()
			return none when api == SurfaceApi.Pixels
			fail "a window is open for another API already: the CPU renderer is attached before windows open" when contexts.len() > 0
			api = SurfaceApi.Pixels
			return none
		}

		// Shows the picture in the window through its own surface: the pixels
		// converted to the surface's format over black (and multiplied by their
		// alpha for a transparent window, as the desktop reads them).
		//
		// Fails when the window is unknown or has no surface.
		def presentPixels(window uint, width int, height int, pixels byte[]) !none {
			fail "unknown window" unless contexts.hasKey(window)
			fail "the picture is short of pixels" when width <= 0 || height <= 0 || pixels.len() < width * height * 4
			lib.bindTaskToThread()
			let dst = lib.SDL_GetWindowSurface(window)
			fail "the window has no surface: {lib.SDL_GetError()}" when dst == 0
			let src = lib.SDL_CreateSurfaceFrom(width, height, lib.SDL_PIXELFORMAT_RGBA32, pixels, width * 4)
			fail "the picture cannot be wrapped: {lib.SDL_GetError()}" when src == 0
			let _ = lib.SDL_SetSurfaceBlendMode(src, lib.SDL_BLENDMODE_NONE)
			let _ = lib.SDL_FillSurfaceRect(dst, 0, 0)
			let copied = lib.SDL_BlitSurface(src, 0, dst, 0)
			lib.SDL_DestroySurface(src)
			fail "the picture cannot be copied to the window: {lib.SDL_GetError()}" unless copied
			if transparent.hasKey(window) {
				let _ = lib.SDL_PremultiplySurfaceAlpha(dst, false)
			}
			fail "the window cannot be shown: {lib.SDL_GetError()}" unless lib.SDL_UpdateWindowSurface(window)
			return none
		}

		// Makes the host open its windows for Vulkan, and names the instance
		// extensions their surfaces need.
		//
		// Fails when SDL cannot start, the machine has no Vulkan loader, or a
		// window is open for OpenGL already.
		def vulkanInstanceExtensions() !string[] {
			try start()
			if api != SurfaceApi.Vulkan {
				fail "a window is open for OpenGL already: a Vulkan renderer is attached before windows open" when contexts.len() > 0
				fail "Vulkan cannot be loaded: {lib.SDL_GetError()}" unless lib.SDL_Vulkan_LoadLibrary(0)
				api = SurfaceApi.Vulkan
			}
			let count uint32[]
			count.len(1)
			let names = lib.SDL_Vulkan_GetInstanceExtensions(count)
			fail "the Vulkan instance extensions are not known: {lib.SDL_GetError()}" when names == 0
			// SDL's desktop targets have 8-byte pointers.
			let pointers uint[]
			pointers.len(int(count[0]))
			let _ = lib.copyPointers(pointers, names, uint(pointers.len() * 8))
			let out string[]
			for let (_, p) in pointers {
				let n = lib.cStringLength(p)
				let bytes byte[]
				bytes.len(int(n))
				let _ = lib.copyBytes(bytes, p, n)
				out.push(string(bytes))
			}
			return out
		}

		// Whether the device's queue family can present to this host's windows.
		def vulkanPresents(instance uint, physical uint, family uint32) bool {
			return lib.SDL_Vulkan_GetPresentationSupport(instance, physical, family)
		}

		// A VkSurfaceKHR of the window on the instance.
		//
		// Fails when the window is unknown or SDL cannot make the surface.
		def createVulkanSurface(window uint, instance uint) !uint {
			fail "unknown window" unless contexts.hasKey(window)
			lib.bindTaskToThread()
			let out uint[]
			out.len(1)
			fail "the window's Vulkan surface cannot be created: {lib.SDL_GetError()}" unless lib.SDL_Vulkan_CreateSurface(window, instance, 0, out)
			return out[0]
		}

		// Frees a surface createVulkanSurface made.
		def destroyVulkanSurface(instance uint, surface uint) {
			return when surface == 0
			lib.SDL_Vulkan_DestroySurface(instance, surface, 0)
		}

		// Whether the window was opened with vsync.
		def vsync(window uint) bool {
			let on = vsyncs.get(window)
			return true when on is none
			return on
		}

		// Makes the window's context current on the calling thread, which the calling
		// task is bound to from here on.
		def makeCurrent(window uint) bool {
			let context = contexts.get(window)
			return false when context is none || context == 0
			lib.bindTaskToThread()
			return lib.SDL_GL_MakeCurrent(window, context)
		}

		// Shows what was drawn into the window since the last call.
		def present(window uint) {
			return unless contexts.hasKey(window) && contexts[window] != 0
			lib.bindTaskToThread()
			let _ = lib.SDL_GL_SwapWindow(window)
		}

		// The size of the window's drawing surface in device pixels.
		def surfaceSize(window uint) Size {
			let w int32[]
			let h int32[]
			w.len(1)
			h.len(1)
			if contexts.hasKey(window) {
				let _ = lib.SDL_GetWindowSizeInPixels(window, w, h)
			}
			return new Size(float(w[0]), float(h[0]))
		}
	}
}
