@link("SDL3")
module std.ui.host.sdl.lib {
	// The part of SDL3 the desktop host calls. Pointers are `uint`; a structure SDL fills
	// or reads is an array of its fields.

	// SDL_Init: the video subsystem, which brings events with it.
	const SDL_INIT_VIDEO uint32 = 0x20

	// The window covers its whole display.
	const SDL_WINDOW_FULLSCREEN uint64 = 0x1
	// The window can hold an OpenGL context.
	const SDL_WINDOW_OPENGL uint64 = 0x2
	// The window is not on the screen.
	const SDL_WINDOW_HIDDEN uint64 = 0x8
	// The window has no title bar and no frame.
	const SDL_WINDOW_BORDERLESS uint64 = 0x10
	// The user can resize the window.
	const SDL_WINDOW_RESIZABLE uint64 = 0x20
	// The window is minimized.
	const SDL_WINDOW_MINIMIZED uint64 = 0x40
	// The window is maximized.
	const SDL_WINDOW_MAXIMIZED uint64 = 0x80
	// The window's surface has the display's full pixel density.
	const SDL_WINDOW_HIGH_PIXEL_DENSITY uint64 = 0x2000
	// The window stays above the others.
	const SDL_WINDOW_ALWAYS_ON_TOP uint64 = 0x10000
	// A tool window: not in the taskbar or the window switcher.
	const SDL_WINDOW_UTILITY uint64 = 0x20000
	// The window never takes the keyboard focus.
	const SDL_WINDOW_NOT_FOCUSABLE uint64 = 0x80000000
	// What is behind the window shows where its surface is not opaque.
	const SDL_WINDOW_TRANSPARENT uint64 = 0x40000000

	// SDL_GLAttr: the bits of alpha an OpenGL context's surface has.
	const SDL_GL_ALPHA_SIZE int = 3

	// The window was put on the screen.
	const SDL_EVENT_WINDOW_SHOWN uint32 = 514
	// What the window shows must be drawn again.
	const SDL_EVENT_WINDOW_EXPOSED uint32 = 516
	// The window's surface changed size in pixels: `data1` by `data2`.
	const SDL_EVENT_WINDOW_PIXEL_SIZE_CHANGED uint32 = 519
	// The window was minimized.
	const SDL_EVENT_WINDOW_MINIMIZED uint32 = 521
	// The window was maximized.
	const SDL_EVENT_WINDOW_MAXIMIZED uint32 = 522
	// The window came back from minimized or maximized.
	const SDL_EVENT_WINDOW_RESTORED uint32 = 523
	// The pointer came over the window.
	const SDL_EVENT_WINDOW_MOUSE_ENTER uint32 = 524
	// The pointer left the window.
	const SDL_EVENT_WINDOW_MOUSE_LEAVE uint32 = 525
	// The window got the keyboard focus.
	const SDL_EVENT_WINDOW_FOCUS_GAINED uint32 = 526
	// The window lost the keyboard focus.
	const SDL_EVENT_WINDOW_FOCUS_LOST uint32 = 527
	// The user asked to close the window.
	const SDL_EVENT_WINDOW_CLOSE_REQUESTED uint32 = 528
	// The window went fullscreen.
	const SDL_EVENT_WINDOW_ENTER_FULLSCREEN uint32 = 535
	// The window left fullscreen.
	const SDL_EVENT_WINDOW_LEAVE_FULLSCREEN uint32 = 536
	// A key went down, or repeats while held.
	const SDL_EVENT_KEY_DOWN uint32 = 768
	// A key went up.
	const SDL_EVENT_KEY_UP uint32 = 769
	// An input method changed the text it is composing.
	const SDL_EVENT_TEXT_EDITING uint32 = 770
	// The keyboard or an input method produced final text.
	const SDL_EVENT_TEXT_INPUT uint32 = 771
	// The pointer moved.
	const SDL_EVENT_MOUSE_MOTION uint32 = 1024
	// A mouse button went down.
	const SDL_EVENT_MOUSE_BUTTON_DOWN uint32 = 1025
	// A mouse button went up.
	const SDL_EVENT_MOUSE_BUTTON_UP uint32 = 1026
	// A wheel or a trackpad scrolled.
	const SDL_EVENT_MOUSE_WHEEL uint32 = 1027

	// The window moved to another display.
	const SDL_EVENT_WINDOW_DISPLAY_CHANGED uint32 = 531
	// The display scale of the window changed.
	const SDL_EVENT_WINDOW_DISPLAY_SCALE_CHANGED uint32 = 532

	// Whether an event of that type can change a window's pixel density or display scale.
	def changesScale(kind uint32) bool {
		return kind := SDL_EVENT_WINDOW_PIXEL_SIZE_CHANGED || SDL_EVENT_WINDOW_DISPLAY_CHANGED || SDL_EVENT_WINDOW_DISPLAY_SCALE_CHANGED
	}

	// The first event type an application may use for its own events.
	// A file, then a text, dropped on a window; a drop starts, ends, and moves.
	const SDL_EVENT_DROP_FILE uint32 = 0x1000
	const SDL_EVENT_DROP_TEXT uint32 = 0x1001
	const SDL_EVENT_DROP_BEGIN uint32 = 0x1002
	const SDL_EVENT_DROP_COMPLETE uint32 = 0x1003
	const SDL_EVENT_DROP_POSITION uint32 = 0x1004
	const SDL_EVENT_USER uint32 = 0x8000

	// The size of an SDL_Event in bytes.
	const SDL_EVENT_SIZE int = 128

	// The left mouse button, as a button event numbers it.
	const SDL_BUTTON_LEFT int = 1
	// The middle mouse button.
	const SDL_BUTTON_MIDDLE int = 2
	// The right mouse button.
	const SDL_BUTTON_RIGHT int = 3

	// Either Shift key is held (SDL_Keymod).
	const SDL_KMOD_SHIFT int = 0x0003
	// Either Control key is held.
	const SDL_KMOD_CTRL int = 0x00C0
	// Either Alt key is held.
	const SDL_KMOD_ALT int = 0x0300
	// Either Windows, Super or Command key is held.
	const SDL_KMOD_GUI int = 0x0C00

	// The pixel format of four bytes a pixel in the order red, green, blue, alpha.
	const SDL_PIXELFORMAT_RGBA32 uint32 = 376840196

	// A tray menu line that is chosen.
	const SDL_TRAYENTRY_BUTTON uint32 = 0x1
	// A tray menu line with a check mark.
	const SDL_TRAYENTRY_CHECKBOX uint32 = 0x2
	// A tray menu line that opens a submenu.
	const SDL_TRAYENTRY_SUBMENU uint32 = 0x4
	// The line is greyed out and cannot be chosen.
	const SDL_TRAYENTRY_DISABLED uint32 = 0x80000000
	// The line's check mark is set.
	const SDL_TRAYENTRY_CHECKED uint32 = 0x40000000

	// Text input of ordinary text (SDL_TextInputType).
	const SDL_TEXTINPUT_TYPE_TEXT int = 0
	// Text input of an e-mail address.
	const SDL_TEXTINPUT_TYPE_TEXT_EMAIL int = 2
	// Text input of a password, not shown.
	const SDL_TEXTINPUT_TYPE_TEXT_PASSWORD_HIDDEN int = 4
	// Text input of a number.
	const SDL_TEXTINPUT_TYPE_NUMBER int = 6

	// Property of SDL_StartTextInputWithProperties: the SDL_TextInputType.
	const SDL_PROP_TEXTINPUT_TYPE_NUMBER string = "SDL.textinput.type"
	// Property of SDL_StartTextInputWithProperties: whether Enter makes a new line.
	const SDL_PROP_TEXTINPUT_MULTILINE_BOOLEAN string = "SDL.textinput.multiline"

	// Hint: "0" keeps an X11 window from asking the window manager to stop compositing
	// while it is open. SDL asks by default, which suits a fullscreen game.
	const SDL_HINT_VIDEO_X11_NET_WM_BYPASS_COMPOSITOR string = "SDL_VIDEO_X11_NET_WM_BYPASS_COMPOSITOR"

	// Sets a configuration hint; false when it could not be set.
	@c("SDL3/SDL.h", ret = "bool")
	def SDL_SetHint(name string, value string) bool;

	// Starts the subsystems named by `flags`; false on failure, `SDL_GetError` says why.
	@c("SDL3/SDL.h", ret = "bool", params = ["SDL_InitFlags"])
	def SDL_Init(flags uint32) bool;

	// Shuts every subsystem down.
	@c("SDL3/SDL.h", ret = "void")
	def SDL_Quit();

	// Why the last SDL call on this thread failed.
	@c("SDL3/SDL.h", ret = "const char*")
	def SDL_GetError() string;

	// Frees memory SDL allocated for the caller.
	@c("SDL3/SDL.h", ret = "void", params = ["void*"])
	def SDL_free(memory uint);

	// The length in bytes of the C string at `text`.
	@c("string.h", symbol = "strlen", ret = "size_t", params = ["const char*"])
	def cStringLength(text uint) uint;

	// Copies `size` bytes at `from` into `to`.
	@c("string.h", symbol = "memcpy", ret = "void*", params = ["void*", "const void*", "size_t"])
	def copyBytes(to byte[], from uint, size uint) uint;

	// Copies `size` bytes of 32-bit values at `from` into `to`.
	@c("string.h", symbol = "memcpy", ret = "void*", params = ["void*", "const void*", "size_t"])
	def copyInts(to uint32[], from uint, size uint) uint;

	// Binds the calling task to the OS thread it runs on, for good. SDL's windows,
	// events and OpenGL contexts belong to one thread, and a task otherwise moves
	// between threads whenever it waits.
	@c("", symbol = "adm_gl_bind_current_task", ret = "void")
	def bindTaskToThread();

	// The calling OS thread.
	@c("pthread.h", symbol = "pthread_self", ret = "pthread_t")
	def currentThread() uint;

	// Creates a window; 0 on failure.
	@c("SDL3/SDL.h", ret = "SDL_Window*", params = ["const char*", "int", "int", "SDL_WindowFlags"])
	def SDL_CreateWindow(title string, width int, height int, flags uint64) uint;

	// A pointer shape of the system's by its SDL_SystemCursor number; 0 when it has none.
	// SDL keeps it: it is not freed.
	@c("SDL3/SDL.h", ret = "SDL_Cursor*", params = ["SDL_SystemCursor"])
	def SDL_CreateSystemCursor(id int) uint;

	// Makes that the pointer's shape.
	@c("SDL3/SDL.h", ret = "bool", params = ["SDL_Cursor*"])
	def SDL_SetCursor(cursor uint) bool;

	// Shows the pointer again, or hides it.
	@c("SDL3/SDL.h", ret = "bool")
	def SDL_ShowCursor() bool;

	@c("SDL3/SDL.h", ret = "bool")
	def SDL_HideCursor() bool;

	// Destroys the window.
	@c("SDL3/SDL.h", ret = "void", params = ["SDL_Window*"])
	def SDL_DestroyWindow(window uint);

	// The number events name the window by; 0 on failure.
	@c("SDL3/SDL.h", ret = "SDL_WindowID", params = ["SDL_Window*"])
	def SDL_GetWindowID(window uint) uint32;

	// The window's flags: its state among them.
	@c("SDL3/SDL.h", ret = "SDL_WindowFlags", params = ["SDL_Window*"])
	def SDL_GetWindowFlags(window uint) uint64;

	// Sets the window's title.
	@c("SDL3/SDL.h", ret = "bool", params = ["SDL_Window*", "const char*"])
	def SDL_SetWindowTitle(window uint, title string) bool;

	// Makes `window` belong to `parent`: it stays above it. 0 as the parent ends that.
	@c("SDL3/SDL.h", ret = "bool", params = ["SDL_Window*", "SDL_Window*"])
	def SDL_SetWindowParent(window uint, parent uint) bool;

	// Sets the window's icon from a surface, which SDL copies.
	@c("SDL3/SDL.h", ret = "bool", params = ["SDL_Window*", "SDL_Surface*"])
	def SDL_SetWindowIcon(window uint, icon uint) bool;

	// Puts the window on the screen and in the taskbar.
	@c("SDL3/SDL.h", ret = "bool", params = ["SDL_Window*"])
	def SDL_ShowWindow(window uint) bool;

	// Takes the window off the screen and out of the taskbar; it stays open.
	@c("SDL3/SDL.h", ret = "bool", params = ["SDL_Window*"])
	def SDL_HideWindow(window uint) bool;

	// Minimizes the window.
	@c("SDL3/SDL.h", ret = "bool", params = ["SDL_Window*"])
	def SDL_MinimizeWindow(window uint) bool;

	// Maximizes the window.
	@c("SDL3/SDL.h", ret = "bool", params = ["SDL_Window*"])
	def SDL_MaximizeWindow(window uint) bool;

	// Brings a minimized or maximized window back to its size.
	@c("SDL3/SDL.h", ret = "bool", params = ["SDL_Window*"])
	def SDL_RestoreWindow(window uint) bool;

	// Sets the function SDL asks, while it handles a press, what the pressed point of the
	// window is for (SDL_HitTestResult): 0 its content, 1 a place it is dragged by, 2 to 9
	// an edge or corner it is resized by.
	@c("SDL3/SDL.h", ret = "bool", params = ["SDL_Window*", "SDL_HitTest", "void*"])
	def SDL_SetWindowHitTest(window uint, @callback test def(uint, uint, uint) int32, data uint) bool;

	// Says where the window is there for the pointer, by the alpha of a surface stretched
	// over it: nowhere the alpha is 0. A surface of 0 gives the whole window back.
	@c("SDL3/SDL.h", ret = "bool", params = ["SDL_Window*", "SDL_Surface*"])
	def SDL_SetWindowShape(window uint, shape uint) bool;

	// Sets the smallest size the user can give the window.
	@c("SDL3/SDL.h", ret = "bool", params = ["SDL_Window*", "int", "int"])
	def SDL_SetWindowMinimumSize(window uint, width int, height int) bool;

	// Moves the window's top left corner on the desktop.
	@c("SDL3/SDL.h", ret = "bool", params = ["SDL_Window*", "int", "int"])
	def SDL_SetWindowPosition(window uint, x int, y int) bool;

	// Makes the window cover its display, or brings it back.
	@c("SDL3/SDL.h", ret = "bool", params = ["SDL_Window*", "bool"])
	def SDL_SetWindowFullscreen(window uint, fullscreen bool) bool;

	// Waits until the desktop has done what was asked of the window (a place, a size, a
	// state) or refused it: until then SDL answers with what the window had before.
	// False when the desktop did not answer in time.
	@c("SDL3/SDL.h", ret = "bool", params = ["SDL_Window*"])
	def SDL_SyncWindow(window uint) bool;

	// Sets the size of what the window shows, in window coordinates.
	@c("SDL3/SDL.h", ret = "bool", params = ["SDL_Window*", "int", "int"])
	def SDL_SetWindowSize(window uint, width int, height int) bool;

	// Puts the window above the others and asks for the keyboard focus.
	@c("SDL3/SDL.h", ret = "bool", params = ["SDL_Window*"])
	def SDL_RaiseWindow(window uint) bool;

	// Reads the window's position on the desktop, in window coordinates.
	@c("SDL3/SDL.h", ret = "bool", params = ["SDL_Window*", "int*", "int*"])
	def SDL_GetWindowPosition(window uint, x int32[], y int32[]) bool;

	// Reads the window's size in window coordinates.
	@c("SDL3/SDL.h", ret = "bool", params = ["SDL_Window*", "int*", "int*"])
	def SDL_GetWindowSize(window uint, width int32[], height int32[]) bool;

	// Reads the size of the window's drawing surface in device pixels.
	@c("SDL3/SDL.h", ret = "bool", params = ["SDL_Window*", "int*", "int*"])
	def SDL_GetWindowSizeInPixels(window uint, width int32[], height int32[]) bool;

	// Device pixels per window coordinate.
	@c("SDL3/SDL.h", ret = "float", params = ["SDL_Window*"])
	def SDL_GetWindowPixelDensity(window uint) float32;

	// Device pixels per logical pixel: the pixel density times the display's content scale.
	@c("SDL3/SDL.h", ret = "float", params = ["SDL_Window*"])
	def SDL_GetWindowDisplayScale(window uint) float32;

	// Sets what the OpenGL surface of the next window created must have.
	@c("SDL3/SDL.h", ret = "bool", params = ["SDL_GLAttr", "int"])
	def SDL_GL_SetAttribute(attribute int, value int) bool;

	// Creates an OpenGL context for the window and makes it current; 0 on failure.
	@c("SDL3/SDL.h", ret = "SDL_GLContext", params = ["SDL_Window*"])
	def SDL_GL_CreateContext(window uint) uint;

	// Destroys an OpenGL context.
	@c("SDL3/SDL.h", ret = "bool", params = ["SDL_GLContext"])
	def SDL_GL_DestroyContext(context uint) bool;

	// Makes the context current on the calling thread, drawing into the window.
	@c("SDL3/SDL.h", ret = "bool", params = ["SDL_Window*", "SDL_GLContext"])
	def SDL_GL_MakeCurrent(window uint, context uint) bool;

	// Shows what was drawn into the window since the last swap.
	@c("SDL3/SDL.h", ret = "bool", params = ["SDL_Window*"])
	def SDL_GL_SwapWindow(window uint) bool;

	// How many vertical blanks a swap of the current context waits for; 0 turns vsync off.
	@c("SDL3/SDL.h", ret = "bool", params = ["int"])
	def SDL_GL_SetSwapInterval(interval int) bool;

	// Takes the next waiting event into `event` (SDL_EVENT_SIZE bytes); false when
	// none waits.
	@c("SDL3/SDL.h", ret = "bool", params = ["SDL_Event*"])
	def SDL_PollEvent(event byte[]) bool;

	// Blocks until an event is waiting or `milliseconds` passed; the event stays in the
	// queue (`event` is 0). True when one is waiting.
	@c("SDL3/SDL.h", ret = "bool", params = ["SDL_Event*", "Sint32"])
	def SDL_WaitEventTimeout(event uint, milliseconds int32) bool;

	// Adds a copy of `event` (SDL_EVENT_SIZE bytes) to the queue.
	@c("SDL3/SDL.h", ret = "bool", params = ["SDL_Event*"])
	def SDL_PushEvent(event byte[]) bool;

	// The key code a scancode gives in the current layout with those modifiers held.
	@c("SDL3/SDL.h", ret = "SDL_Keycode", params = ["SDL_Scancode", "SDL_Keymod", "bool"])
	def SDL_GetKeyFromScancode(place int32, held uint16, forEvent bool) uint32;

	// The modifier keys held now.
	@c("SDL3/SDL.h", ret = "SDL_Keymod")
	def SDL_GetModState() uint16;

	// Turns text input on for the window: text events arrive and the input method is active.
	@c("SDL3/SDL.h", ret = "bool", params = ["SDL_Window*", "SDL_PropertiesID"])
	def SDL_StartTextInputWithProperties(window uint, properties uint32) bool;

	// Turns text input off for the window.
	@c("SDL3/SDL.h", ret = "bool", params = ["SDL_Window*"])
	def SDL_StopTextInput(window uint) bool;

	// Tells the input method where the text being typed is: `area` is x, y, width and
	// height in window coordinates, `caret` the caret's distance from its left edge.
	@c("SDL3/SDL.h", ret = "bool", params = ["SDL_Window*", "const SDL_Rect*", "int"])
	def SDL_SetTextInputArea(window uint, area int32[], caret int) bool;

	// A new, empty set of properties; 0 on failure.
	@c("SDL3/SDL.h", ret = "SDL_PropertiesID")
	def SDL_CreateProperties() uint32;

	// Sets a number in a set of properties.
	@c("SDL3/SDL.h", ret = "bool", params = ["SDL_PropertiesID", "const char*", "Sint64"])
	def SDL_SetNumberProperty(properties uint32, name string, value int64) bool;

	// Sets a boolean in a set of properties.
	@c("SDL3/SDL.h", ret = "bool", params = ["SDL_PropertiesID", "const char*", "bool"])
	def SDL_SetBooleanProperty(properties uint32, name string, value bool) bool;

	// Frees a set of properties.
	@c("SDL3/SDL.h", ret = "void", params = ["SDL_PropertiesID"])
	def SDL_DestroyProperties(properties uint32);

	// Puts the text on the system clipboard.
	@c("SDL3/SDL.h", ret = "bool", params = ["const char*"])
	def SDL_SetClipboardText(text string) bool;

	// The clipboard's text as a C string the caller frees with SDL_free; empty when it
	// holds none.
	@c("SDL3/SDL.h", ret = "char*")
	def SDL_GetClipboardText() uint;

	// The connected displays: `count` ids the caller frees with SDL_free; 0 on failure.
	@c("SDL3/SDL.h", ret = "SDL_DisplayID*", params = ["int*"])
	def SDL_GetDisplays(count int32[]) uint;

	// The id of the primary display; 0 on failure.
	@c("SDL3/SDL.h", ret = "SDL_DisplayID")
	def SDL_GetPrimaryDisplay() uint32;

	// The display's name.
	@c("SDL3/SDL.h", ret = "const char*", params = ["SDL_DisplayID"])
	def SDL_GetDisplayName(display uint32) string;

	// Reads the display's area on the desktop: x, y, width and height.
	@c("SDL3/SDL.h", ret = "bool", params = ["SDL_DisplayID", "SDL_Rect*"])
	def SDL_GetDisplayBounds(display uint32, area int32[]) bool;

	// Reads the part of the display not taken by taskbars, docks and menu bars.
	@c("SDL3/SDL.h", ret = "bool", params = ["SDL_DisplayID", "SDL_Rect*"])
	def SDL_GetDisplayUsableBounds(display uint32, area int32[]) bool;

	// How much larger the desktop asks content to be drawn on the display; 0 on failure.
	@c("SDL3/SDL.h", ret = "float", params = ["SDL_DisplayID"])
	def SDL_GetDisplayContentScale(display uint32) float32;

	// The display's desktop mode, an SDL_DisplayMode owned by SDL; 0 on failure.
	@c("SDL3/SDL.h", ret = "const SDL_DisplayMode*", params = ["SDL_DisplayID"])
	def SDL_GetDesktopDisplayMode(display uint32) uint;

	// A surface over the caller's pixels, which must outlive it; 0 on failure.
	@c("SDL3/SDL.h", ret = "SDL_Surface*", params = ["int", "int", "SDL_PixelFormat", "void*", "int"])
	def SDL_CreateSurfaceFrom(width int, height int, format uint32, pixels byte[], pitch int) uint;

	// Frees a surface; the pixels it was made over stay the caller's.
	@c("SDL3/SDL.h", ret = "void", params = ["SDL_Surface*"])
	def SDL_DestroySurface(surface uint);

	// Shows an icon in the system tray; 0 when the desktop has no tray.
	@c("SDL3/SDL.h", ret = "SDL_Tray*", params = ["SDL_Surface*", "const char*"])
	def SDL_CreateTray(icon uint, tooltip string) uint;

	// Removes the tray icon and its menus.
	@c("SDL3/SDL.h", ret = "void", params = ["SDL_Tray*"])
	def SDL_DestroyTray(tray uint);

	// The menu that opens from the tray icon.
	@c("SDL3/SDL.h", ret = "SDL_TrayMenu*", params = ["SDL_Tray*"])
	def SDL_CreateTrayMenu(tray uint) uint;

	// The menu an entry made with SDL_TRAYENTRY_SUBMENU opens.
	@c("SDL3/SDL.h", ret = "SDL_TrayMenu*", params = ["SDL_TrayEntry*"])
	def SDL_CreateTraySubmenu(entry uint) uint;

	// Adds a line to a menu; position -1 is the end.
	@c("SDL3/SDL.h", ret = "SDL_TrayEntry*", params = ["SDL_TrayMenu*", "int", "const char*", "SDL_TrayEntryFlags"])
	def SDL_InsertTrayEntryAt(menu uint, position int, label string, flags uint32) uint;

	// Adds a dividing line to a menu: SDL_InsertTrayEntryAt with no label (`label` 0).
	@c("SDL3/SDL.h", symbol = "SDL_InsertTrayEntryAt", ret = "SDL_TrayEntry*", params = ["SDL_TrayMenu*", "int", "const char*", "SDL_TrayEntryFlags"])
	def SDL_InsertTraySeparatorAt(menu uint, position int, label uint, flags uint32) uint;

	// Sets the function SDL calls with `userdata` and the entry when the line is chosen.
	@c("SDL3/SDL.h", ret = "void", params = ["SDL_TrayEntry*", "SDL_TrayCallback", "void*"])
	def SDL_SetTrayEntryCallback(entry uint, @callback chosen def(uint, uint), userdata uint);

	// Chooses the line as a click would.
	@c("SDL3/SDL.h", ret = "void", params = ["SDL_TrayEntry*"])
	def SDL_ClickTrayEntry(entry uint);
}
