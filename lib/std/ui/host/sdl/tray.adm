internal std.ui partial module std.ui.host.sdl {
	use (
		std.formats.image
		std.ui
		std.ui.host.sdl.lib
	)

	// The numbers of the tray menu lines chosen since the last poll. SDL calls
	// `trayLineChosen` while it handles events; the host runs their `onSelect` after.
	internal let trayChosen = int[]

	// SDL's tray callback: `line` is the number the entry was given.
	internal def trayLineChosen(line uint, entry uint) {
		trayChosen.push(int(line))
	}

	// An SDL surface over the image's RGBA pixels, which must outlive it; the caller
	// frees it with SDL_DestroySurface.
	//
	// Fails when the image is empty or short of pixels, or SDL refuses it.
	internal def surfaceOf(icon image.Image) !uint {
		let width = int(icon.size().width)
		let height = int(icon.size().height)
		let pixels = icon.raw()
		fail "the icon is empty" when width <= 0 || height <= 0 || pixels.len() < width * height * 4
		let surface = lib.SDL_CreateSurfaceFrom(width, height, lib.SDL_PIXELFORMAT_RGBA32, pixels, width * 4)
		fail "the icon cannot be used: {lib.SDL_GetError()}" when surface == 0
		return surface
	}

	// Shows the icon in the system tray with its tooltip and menu.
	//
	// Fails when the icon is empty or the desktop has no tray.
	internal def openTray(icon image.Image, tooltip string, menu ui.MenuEntry[]) !Tray {
		let tray = new Tray()
		tray.pixels = icon.raw()
		tray.surface = try surfaceOf(icon)
		tray.handle = lib.SDL_CreateTray(tray.surface, tooltip)
		if tray.handle == 0 {
			let why = lib.SDL_GetError()
			lib.SDL_DestroySurface(tray.surface)
			fail "tray: this desktop has no system tray ({why})"
		}
		tray.fill(lib.SDL_CreateTrayMenu(tray.handle), menu) when menu.len() > 0
		return tray
	}

	// The tray icon the host shows, with what its menu lines run.
	internal type Tray {
		handle  uint
		// The icon's surface and the pixels under it, kept while the tray shows them.
		surface uint
		pixels  byte[]
		// The menu lines that run something, by the number SDL hands back.
		lines   ui.MenuEntry[]

		// Adds the lines to an SDL menu, submenus included.
		def fill(into uint, lines ui.MenuEntry[]) {
			return when into == 0
			for let line in lines {
				if line.separator {
					let _ = lib.SDL_InsertTraySeparatorAt(into, -1, 0, uint32(0))
					continue
				}
				let flags = lib.SDL_TRAYENTRY_BUTTON
				flags = lib.SDL_TRAYENTRY_SUBMENU when line.children.len() > 0
				let checked = line.checked
				if !(checked is none) && line.children.len() == 0 {
					flags = lib.SDL_TRAYENTRY_CHECKBOX
					flags = flags | lib.SDL_TRAYENTRY_CHECKED when checked
				}
				flags = flags | lib.SDL_TRAYENTRY_DISABLED unless line.enabled
				let entry = lib.SDL_InsertTrayEntryAt(into, -1, line.label, flags)
				continue when entry == 0
				if line.children.len() > 0 {
					fill(lib.SDL_CreateTraySubmenu(entry), line.children)
					continue
				}
				self.lines.push(line)
				lib.SDL_SetTrayEntryCallback(entry, trayLineChosen, uint(self.lines.len() - 1))
			}
		}

		// Runs what the line with that number does.
		def choose(line int) {
			return when line < 0 || line >= lines.len()
			let action = lines[line].onSelect
			return when action is none
			action()
		}

		// Removes the icon and its menu.
		def close() {
			lib.SDL_DestroyTray(handle) when handle != 0
			lib.SDL_DestroySurface(surface) when surface != 0
			handle = 0
			surface = 0
		}
	}
}
