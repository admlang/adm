@os("linux")
partial module std.ui.host.sdl.lib {
	// Where a Wayland window is there for the pointer. SDL shapes a window under X11
	// only; under Wayland the surface's input region is set through the connection and
	// the surface SDL holds for the window.

	// Makes the surface take the pointer where the alpha of `pixels` (`width` by
	// `height`, four bytes a pixel, stretched over the window's `wide` by `high` window
	// coordinates) is not 0; false when the compositor's regions cannot be reached.
	@c("wayland.h", symbol = "adm_sdl_wayland_input_shape", ret = "bool", params = ["void*", "void*", "const uint8_t*", "int", "int", "int", "int"])
	def waylandInputShape(display uint, surface uint, pixels byte[], width int, height int, wide int, high int) bool;

	// Gives up what was bound on the Wayland connection: called before SDL closes it.
	@c("wayland.h", symbol = "adm_sdl_wayland_forget", ret = "void")
	def waylandForget();

	// Shapes a Wayland window by the alpha of `pixels`, as `waylandInputShape` does.
	// False when the window has no Wayland surface or the region cannot be set.
	def shapeWaylandWindow(window uint, pixels byte[], width int, height int, wide int, high int) bool {
		let props = SDL_GetWindowProperties(window)
		let display = SDL_GetPointerProperty(props, "SDL.window.wayland.display", 0)
		let surface = SDL_GetPointerProperty(props, "SDL.window.wayland.surface", 0)
		return false when display == 0 || surface == 0
		return waylandInputShape(display, surface, pixels, width, height, wide, high)
	}
}
