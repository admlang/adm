@os("linux")
partial module std.ui.host.sdl.lib {
	// Xlib, loaded at the first call as SDL loads it (a program never links it):
	// what finds a 32-bit visual for a transparent window opened for Vulkan,
	// which SDL gives its OpenGL windows only (`transparentVisualId`).

	// Opens a connection to the display `name` names (0: the one DISPLAY
	// names); 0 when there is none.
	@native("libX11.so.6", lazy = true, symbol = "XOpenDisplay")
	def xOpenDisplay(name uint) uint;

	// The connection's default screen.
	@native("libX11.so.6", lazy = true, symbol = "XDefaultScreen")
	def xDefaultScreen(display uint) int32;

	// Fills `info` (an XVisualInfo, 64 bytes are enough) with a visual of the
	// screen having the depth and class; 0 when there is none.
	@native("libX11.so.6", lazy = true, symbol = "XMatchVisualInfo")
	def xMatchVisualInfo(display uint, screen int32, depth int32, kind int32, info byte[]) int32;

	// Closes the connection.
	@native("libX11.so.6", lazy = true, symbol = "XCloseDisplay")
	def xCloseDisplay(display uint) int32;

	// XVisualInfo's class of a visual with separate red, green and blue.
	internal const xTrueColor int32 = 4

	// The id of a 32-bit true-colour visual of the display's default screen (the
	// alpha channel a transparent window needs under X11), or 0 when the X
	// server has none or the window system is not X11.
	def transparentVisualId() uint {
		return 0 unless SDL_GetCurrentVideoDriver() == "x11"
		let display = xOpenDisplay(0)
		return 0 when display == 0
		let info byte[]
		info.len(64)
		let id = uint(0)
		if xMatchVisualInfo(display, xDefaultScreen(display), 32, xTrueColor, info) != 0 {
			// XVisualInfo: the visual's pointer, then its id, 8 bytes each.
			for let i = 7; i >= 0; i-- {
				id = (id << 8) | uint(info[8 + i])
			}
		}
		let _ = xCloseDisplay(display)
		return id
	}
}
