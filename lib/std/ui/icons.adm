partial module std.ui {
	use std.gfx.canvas

	// Named icons: small vector pictures, drawn in one colour unless they bring their own.
	// `UI.addIcons(set)` makes a set's icons known by name to `Icon("save")`, to
	// `Button(icon = "save")` and to every other input that names an icon; `set/name`
	// picks one set when two hold the name.
	struct IconSet {
		name   string
		// The pictures by name, each drawn in a square 16 on a side.
		icons  map<string, canvas.Picture>
		// Whether its icons are shapes that take the colour of the text around them
		// (whatever colour they were drawn in); false: they keep their own colours.
		tinted bool                        = true
	}

	// The side of the square an icon's picture is drawn in.
	const iconBox = 16.0
}
