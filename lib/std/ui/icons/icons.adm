partial module std.ui.icons {
	use (
		std.formats.image::SVG
		std.gfx.canvas
		std.gfx.color::Color
		std.ui::(IconPainter, IconSet, iconBox)
	)

	// An icon set called `name` from SVG documents: `names[i]` is the icon drawn by
	// `documents[i]`, as large as fits the square an icon is drawn in and in its
	// middle. A tinted icon is drawn in the colour of the text around it the way a
	// browser draws an inline SVG in a page's colour: `currentColor` and a fill no
	// element sets take the colour, a fill or stroke the document sets (on the element
	// or a group above it) stays as written, and an unset stroke stays none. `tinted`
	// false keeps the documents' colours as they are, an unset fill black. Fails when
	// the two arrays differ in length or a document is not SVG, naming the icon.
	def fromSvg(name string, names string[], documents byte[][], tinted bool = true) !IconSet {
		fail "icons: {names.len()} names for {documents.len()} documents" when names.len() != documents.len()
		let icons = map<string, canvas.Picture>{}
		let inked = map<string, IconPainter>{}
		let svg = new SVG()
		for let (i, data) in documents {
			let info = svg.info(data) onerror (err error) {
				fail "icons: {name}/{names[i]}: {err.message}"
			}
			let size = info.size
			let drawn = try svg.picture(data)
			let by = (iconBox / size.width).min(iconBox / size.height)
			let (left, top) = ((iconBox - size.width * by) / 2.0, (iconBox - size.height * by) / 2.0)
			let fitted = def (picture canvas.Picture) canvas.Picture {
				return canvas.record(def (painter canvas.Painter) {
					painter.translate(left, top)
					painter.scale(by, by)
					picture.replay(painter)
				})
			}
			icons = icons.set(names[i], fitted(drawn))
			continue unless tinted
			// The same bytes parsed once already: they cannot fail now. (A lambda
			// here gets no parameter type from `set`: the def states it.)
			inked = inked.set(names[i], def (ink Color) canvas.Picture {
				return fitted(svg.picture(data, foreground = ink) onerror recover drawn)
			})
		}
		return IconSet{name: name, icons: icons, tinted: tinted, inked: inked}
	}
}
