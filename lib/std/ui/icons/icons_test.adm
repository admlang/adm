partial module std.ui.icons {
	use (
		std.gfx.canvas
		std.gfx.color::(Color, RGBA)
		std.testing
		std.ui::IconSet
	)

	@icons("testdata/set")
	partial type TestIcons {}

	@icons("testdata/set", name = "flags", tinted = false)
	partial type FlagIcons {}

	check "Icons" {
		@test()
		def TestMembersNameTheIcons() {
			let held = new TestIcons()
			assert held.ArrowLeft == "set/arrow-left"
			assert held.Dot == "set/dot"
			assert new FlagIcons().Dot == "flags/dot"
		}

		@test()
		def TestSetHoldsEveryFile() !none {
			let set = try new TestIcons().set()
			assert set.name == "set"
			assert set.tinted
			assert set.icons.len() == 2
			assert set.icons.hasKey("arrow-left") && set.icons.hasKey("dot")
			let flags = try new FlagIcons().set()
			assert flags.name == "flags"
			assert !flags.tinted
		}

		// A document is drawn as large as fits the icon's square, in its middle: one
		// twice as wide as high fills the width and half the height.
		@test()
		def TestPicturesFitTheBox() !none {
			let set = try new TestIcons().set()
			let box = set.icons["dot"].bounds()
			assert box.left == 4.0 && box.right == 12.0
			assert box.top == 6.0 && box.bottom == 10.0
			let arrow = set.icons["arrow-left"].bounds()
			assert arrow.left >= 0.0 && arrow.right <= 16.0 && arrow.top >= 0.0 && arrow.bottom <= 16.0
			assert arrow.right - arrow.left > 4.0
		}

		@test()
		def TestFromSvgRefuses() {
			let refused = ""
			fromSvg("x", ["a"], [byte[]]) onerror (err error) {
				refused = err.message
				recover IconSet{name: "", icons: map<string, canvas.Picture>{}}
			}
			assert refused.startsWith("icons: x/a: ")
			refused = ""
			fromSvg("x", ["a", "b"], [byte[]]) onerror (err error) {
				refused = err.message
				recover IconSet{name: "", icons: map<string, canvas.Picture>{}}
			}
			assert refused == "icons: 2 names for 1 documents"
		}

		// A tinted icon drawn in an ink keeps the colours its document sets; a set that
		// keeps its colours has no painters.
		@test()
		def TestInkedIconsKeepTheirColours() !none {
			let mixed = "<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 16 16\"><rect width=\"8\" height=\"16\" fill=\"currentColor\"/><rect x=\"8\" width=\"8\" height=\"16\" fill=\"#00f\"/></svg>".bytes()
			let set = try fromSvg("t", ["mixed"], [mixed])
			assert set.inked.len() == 1 && set.inked.hasKey("mixed")
			let paint = set.inked["mixed"]
			let c = new canvas.Canvas(16, 16)
			paint(new Color(RGBA{r: 255, g: 0, b: 0, a: 255})).replay(c)
			let left = (8 * 16 + 4) * 4
			let right = (8 * 16 + 12) * 4
			assert c.pixels[left] == 255 && c.pixels[left + 2] == 0 && c.pixels[left + 3] == 255
			assert c.pixels[right] == 0 && c.pixels[right + 2] == 255 && c.pixels[right + 3] == 255
			let kept = try fromSvg("k", ["mixed"], [mixed], tinted = false)
			assert kept.inked.len() == 0
		}

		@test()
		def TestMemberNames() {
			assert memberName("arrow-left") == "ArrowLeft"
			assert memberName("check") == "Check"
			assert memberName("2fa") == "Icon2fa"
			assert memberName("vcs_branch") == "VcsBranch"
		}
	}
}
