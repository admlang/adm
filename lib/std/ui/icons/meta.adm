// Icon sets made from folders of SVG files while the program is built.
partial module std.ui.icons {
	use (
		std.formats.image::(ImageInfo, SVG)
		std.reflection::(BuildMetaContext, EmbeddedEntry, TypeDescriptor)
		// Named by the code `icons` writes, which sees what this file imports.
		std.ui::IconSet
	)

	// Turns a folder of SVG files into an icon set, on a `partial type`:
	//
	//     @icons("assets/icons")
	//     partial type AppIcons {}
	//
	//     let app = new AppIcons()
	//     UI.addIcons(try app.set())
	//     Button("Save", icon = app.Save)
	//
	// The type gets `set() !IconSet`, the set to hand to `UI.addIcons`, and one
	// read-only string per file, named after it in Pascal case (`arrow-left.svg` is
	// `ArrowLeft`), holding the icon's name in the set (`icons/arrow-left`). `dir` is
	// relative to the annotated source file; files in folders under it and files that
	// are not `.svg` are left out. The set is called `name`, the folder's name when
	// that is left out. `tinted` false keeps the files' own colours.
	//
	// The files are baked into the program. One that is not an SVG document, two that
	// give the same member name, and a folder without SVG files are build errors.
	meta def icons(ctx BuildMetaContext<TypeDescriptor>, dir string, name string = "", tinted bool = true) {
		let files EmbeddedEntry[] = []
		for let entry in ctx.files.readDir(dir) {
			files.push(entry) when entry.path.lower().endsWith(".svg")
		}
		if files.len() == 0 {
			ctx.diagnostics.error("no .svg files in \"{dir}\"")
			return
		}
		files.sort(def (a EmbeddedEntry, b EmbeddedEntry) bool {
			return a.path < b.path
		})
		let folder = dir.trimSuffix("/")
		let setName = name == "" ?? (folder[folder.lastIndexOf("/") + 1:], name)
		let typeName = ctx.descriptor.node.name
		let prefix = typeName[:1].lower() + typeName[1:]
		let (names, consts) = (string[], string[])
		let taken = map<string, string>{}
		for let entry in files {
			new SVG().info(entry.data) onerror (err error) {
				ctx.diagnostics.error("{folder}/{entry.path}: {err.message}")
				recover ImageInfo{}
			}
			let icon = entry.path[:entry.path.len() - 4]
			let member = memberName(icon)
			if taken.hasKey(member) {
				ctx.diagnostics.error("{entry.path} and {taken[member]} both give the member {member}")
				continue
			}
			taken = taken.set(member, entry.path)
			names.push("\"{icon}\"")
			consts.push("{prefix}{member}")
			ctx.source.addDeclaration("\t@embed(\"{folder}/{entry.path}\")\n\tinternal const {prefix}{member} byte[]")
			ctx.source.addMember("\t\t// The name of the icon of {entry.path}.\n\t\t{member} string \{\n\t\t\tdef get() string \{ return \"{setName}/{icon}\" \}\n\t\t\}")
		}
		ctx.source.addMember("\t\t// The icons of {folder} as a set, decoded on each call.\n\t\tdef set() !IconSet \{\n\t\t\treturn try fromSvg(\"{setName}\", [{names.join(", ")}], [{consts.join(", ")}], {tinted})\n\t\t\}")
	}

	// The member of the icon in the file called `icon`: its words in Pascal case, with
	// `Icon` before a name that would not start with a letter.
	internal def memberName(icon string) string {
		let words = icon.camelCase()
		return "Icon{words}" when words == "" || !words[0].isLetter()
		return words[:1].upper() + words[1:]
	}
}
