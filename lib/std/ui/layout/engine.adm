internal partial module std.ui.layout {
	use (
		std.ui::Limit
		std.ui.styles::*
		std.units::(Extent, FontRelative, Length, Percent, Pixels, ViewportHeight, ViewportWidth)
	)

	// No value: an unbounded limit, a size not decided yet, a percent with nothing to take a
	// share of.
	const unset float = -1.0e30

	// Logical pixels in a metre, at the 96 per inch a `px` is defined by.
	const pixelsPerMetre float = 96.0 / 0.0254

	def isSet(value float) bool {
		return value > -1.0e29
	}

	// The state of one `arrange` call.
	type Pass {
		windowWidth  float
		windowHeight float
		// Nodes placed by anchors, in the order layout met them.
		anchored     Node[]
		// Nodes that belong to a component, for named anchor lines.
		owned        Node[]
		warnings     string[]
		// The natural content size the last arrangement call found.
		contentW     float
		contentH     float
		// Whether an anchor of the node being placed names a line that is not final yet.
		waiting      bool
		// The two halves of the extent `split` read last.
		abs          float
		pct          float
		// The limit handed to leaves, one object for the whole pass.
		room         Limit    = Limit{}

		def new(width float, height float) {
			windowWidth = width
			windowHeight = height
		}
	}

	// `extent` in pixels. `reference` is what a percent takes its share of; the result is
	// unset for a percent when there is none.
	def toPixels(pass Pass, extent Extent, reference float, em float) float {
		match extent {
			case Pixels:
				return float(extent)
			case Percent:
				return unset when !isSet(reference)
				return reference * float(extent) / 100.0
			case ViewportHeight:
				return pass.windowHeight * float(extent) / 100.0
			case ViewportWidth:
				return pass.windowWidth * float(extent) / 100.0
			case FontRelative:
				return em * float(extent)
			case Length:
				return float(extent) * pixelsPerMetre
		}
	}

	// `extent` in pixels, 0 for a percent without a reference.
	def spacing(pass Pass, extent Extent, reference float, em float) float {
		let value = toPixels(pass, extent, reference, em)
		return isSet(value) ?? (value, 0.0)
	}

	// A min or max limit in pixels; unset when the style sets none or it cannot be resolved.
	def limit(pass Pass, extent ?Extent, reference float, em float) float {
		return unset when extent is none
		return toPixels(pass, extent, reference, em)
	}

	// The size a fixed `sizing` asks for; unset for `auto`, `fill` and a percent without a
	// reference.
	def fixedSize(pass Pass, sizing Sizing, reference float, em float) float {
		match sizing {
			case Auto:
				return unset
			case Fill:
				return unset
			case Pixels:
				return float(sizing)
			case Percent:
				return unset when !isSet(reference)
				return reference * float(sizing) / 100.0
			case ViewportHeight:
				return pass.windowHeight * float(sizing) / 100.0
			case ViewportWidth:
				return pass.windowWidth * float(sizing) / 100.0
			case FontRelative:
				return em * float(sizing)
			case Length:
				return float(sizing) * pixelsPerMetre
			default:
				return unset
		}
	}

	// The weight of a `fill`; 0 for anything else.
	def fillWeight(sizing Sizing) float {
		match sizing {
			case Fill:
				return sizing.weight
			default:
				return 0.0
		}
	}

	// `value` held between the limits; an unset limit does not apply, and the minimum wins
	// over the maximum.
	def bound(value float, least float, most float) float {
		let result = value
		result = most when isSet(most) && result > most
		result = least when isSet(least) && result < least
		return result
	}

	// How far content of `size` moves inside `room` for that alignment.
	def alignOffset(alignment Alignment, room float, size float) float {
		match alignment {
			case Alignment.Center:
				return (room - size) / 2.0
			case Alignment.End:
				return room - size
			default:
				return 0.0
		}
	}

	// The alignment of `child` on one axis of the slot `container` gives it.
	def slotAlign(container Node, child Node, horizontal bool) Alignment {
		let own = child.alignSelf
		return horizontal ?? (own.horizontal, own.vertical) unless (own is none)
		let shared = container.box.align
		return horizontal ?? (shared.horizontal, shared.vertical)
	}

	// Resolves the node's border and padding. Padding percents take the parent's content
	// width on all four sides.
	def resolveInsets(node Node, referenceW float) {
		let padding = node.box.padding
		let border = node.border
		node.insetStart = share(node.insetLeftAbs, node.insetLeftPct, referenceW, 0.0)
		node.insetEnd = share(node.insetRightAbs, node.insetRightPct, referenceW, 0.0)
		node.insetTop = share(node.insetTopAbs, node.insetTopPct, referenceW, 0.0)
		node.insetBottom = share(node.insetBottomAbs, node.insetBottomPct, referenceW, 0.0)
		if node.scrollbarKept && !(node.scroll is none) {
			node.insetEnd += node.scrollbar when node.scrollAxes.vertical
			node.insetBottom += node.scrollbar when node.scrollAxes.horizontal
		}
	}

	// The natural size of a scrolling container's content in a content box of `width` by
	// `height`: unbounded on the axes that scroll.
	def scrollNatural(pass Pass, node Node, width float, height float) (float, float) {
		let axes = node.scrollAxes
		arrangeContent(pass, node, axes.horizontal ?? (unset, width), axes.vertical ?? (unset, height), knownW = !axes.horizontal, knownH = !axes.vertical, commit = false)
		return (pass.contentW, pass.contentH)
	}

	// Sizes the content of a scrolling container whose content box is `width` by `height`:
	// takes the room of the scrollbars the content needs out of the box and leaves the
	// size to lay the content out in as `extentW` and `extentH`. Returns the content box
	// that is left.
	def scrollContent(pass Pass, node Node, width float, height float) (float, float) {
		let axes = node.scrollAxes
		let bar = node.scrollbarKept ?? (0.0, node.scrollbar)
		let (naturalW, naturalH) = scrollNatural(pass, node, width, height)
		let barV = axes.vertical && naturalH > height
		if barV && bar > 0.0 {
			width = (width - bar).max(0.0)
			node.insetEnd += bar
			(naturalW, naturalH) = scrollNatural(pass, node, width, height)
		}
		if axes.horizontal && naturalW > width && bar > 0.0 {
			height = (height - bar).max(0.0)
			node.insetBottom += bar
			// The horizontal bar may be what makes the content too tall.
			if axes.vertical && !barV && naturalH > height {
				width = (width - bar).max(0.0)
				node.insetEnd += bar
				(naturalW, naturalH) = scrollNatural(pass, node, width, height)
			}
		}
		node.extentW = axes.horizontal ?? (width.max(naturalW), width)
		node.extentH = axes.vertical ?? (height.max(naturalH), height)
		return (width, height)
	}

	// Resolves the child's margins into its parent's start-relative space. Margin percents
	// take the parent's content width on all four sides. A child that reads the other way
	// than its parent has its left margin on the parent's end side.
	def resolveMargins(child Node, parentRtl bool, referenceW float) {
		return when child.marginSet && child.marginRef == referenceW
		let margin = child.box.margin
		let left = share(child.marginLeftAbs, child.marginLeftPct, referenceW, 0.0)
		let right = share(child.marginRightAbs, child.marginRightPct, referenceW, 0.0)
		let same = child.rtl == parentRtl
		child.marginStart = same ?? (left, right)
		child.marginEnd = same ?? (right, left)
		child.marginTop = share(child.marginTopAbs, child.marginTopPct, referenceW, 0.0)
		child.marginBottom = share(child.marginBottomAbs, child.marginBottomPct, referenceW, 0.0)
		child.marginRef = referenceW
		child.marginSet = true
	}

	// Sizes `node` the way its parent's arrangement sees it and leaves the border-box size
	// in `measuredW` and `measuredH`. `availW`/`availH` are the most room on offer (unset:
	// unbounded), `referenceW`/`referenceH` the parent's content size where the parent does
	// not size to its content (else unset), `forceW`/`forceH` a size the parent has decided.
	def sizeNode(pass Pass, node Node, availW float, availH float, referenceW float, referenceH float, forceW float, forceH float) {
		let cache = node.cache
		for let i = 0; i < cache.len(); i += 8 {
			if cache[i] == availW && cache[i + 1] == availH && cache[i + 2] == referenceW && cache[i + 3] == referenceH && cache[i + 4] == forceW && cache[i + 5] == forceH {
				node.measuredW = cache[i + 6]
				node.measuredH = cache[i + 7]
				return
			}
		}

		resolveInsets(node, referenceW)
		let box = node.box
		let em = node.em
		let insetsW = node.insetStart + node.insetEnd
		let insetsH = node.insetTop + node.insetBottom
		let leastW = minWidthOf(node, referenceW)
		let mostW = maxWidthOf(node, referenceW)
		let leastH = minHeightOf(node, referenceH)
		let mostH = maxHeightOf(node, referenceH)

		let width = forceW
		if !isSet(width) {
			width = fixedOf(node, true, referenceW)
			width = bound(width, leastW, mostW) when isSet(width)
		}
		let height = forceH
		if !isSet(height) {
			height = fixedOf(node, false, referenceH)
			height = bound(height, leastH, mostH) when isSet(height)
		}
		node.autoWidth = !node.pinWidth && autoOf(node, true, referenceW)
		node.autoHeight = !node.pinHeight && autoOf(node, false, referenceH)

		if !isSet(width) || !isSet(height) {
			let roomW = contentRoom(width, availW, mostW, insetsW)
			let roomH = contentRoom(height, availH, mostH, insetsH)
			arrangeContent(pass, node, roomW, roomH, isSet(width), isSet(height), false)
			if !isSet(width) {
				let natural = pass.contentW + insetsW
				width = bound(natural, leastW, mostW)
				// A set minimum replaces the content's own: the box may go under its
				// content when there is not enough room.
				width = availW.max(leastW) when isSet(leastW) && isSet(availW) && width > availW
				arrangeContent(pass, node, (width - insetsW).max(0.0), roomH, knownW = true, knownH = false, commit = false) when width != natural && !isSet(height)
			}
			if !isSet(height) {
				height = bound(pass.contentH + insetsH, leastH, mostH)
				height = availH.max(leastH) when isSet(leastH) && isSet(availH) && height > availH
			}
		}

		node.measuredW = width
		node.measuredH = height
		if cache.len() < 32 {
			cache.push(availW, availH, referenceW, referenceH, forceW, forceH, width, height)
		} else {
			let at = node.cacheNext * 8
			cache[at] = availW
			cache[at + 1] = availH
			cache[at + 2] = referenceW
			cache[at + 3] = referenceH
			cache[at + 4] = forceW
			cache[at + 5] = forceH
			cache[at + 6] = width
			cache[at + 7] = height
			node.cacheNext = (node.cacheNext + 1) % 4
		}
	}

	// The room a box's content gets on one axis while the box is being sized: its content
	// size when the box size is known, else what is on offer inside the insets.
	def contentRoom(size float, avail float, most float, insets float) float {
		return (size - insets).max(0.0) when isSet(size)
		let room = avail
		room = most when isSet(most) && (!isSet(room) || most < room)
		return unset when !isSet(room)
		return (room - insets).max(0.0)
	}

	// Gives `node` its final border-box size and arranges its children inside it. The
	// caller sets `x` and `y` afterwards.
	def placeNode(pass Pass, node Node, width float, height float, referenceW float, referenceH float) {
		resolveInsets(node, referenceW)
		let box = node.box
		node.width = width
		node.height = height
		node.autoWidth = !node.pinWidth && autoOf(node, true, referenceW)
		node.autoHeight = !node.pinHeight && autoOf(node, false, referenceH)
		let contentW = (width - node.insetStart - node.insetEnd).max(0.0)
		let contentH = (height - node.insetTop - node.insetBottom).max(0.0)
		if node.scroll is none {
			arrangeContent(pass, node, contentW, contentH, knownW = true, knownH = true, commit = true)
		} else {
			let _ = scrollContent(pass, node, contentW, contentH)
			arrangeContent(pass, node, node.extentW, node.extentH, knownW = true, knownH = true, commit = true)
		}

		node.firstBaseline = unset
		let own = node.baseline
		if !(own is none) {
			node.firstBaseline = node.insetTop + float(own)
			return
		}
		for let child in node.items {
			if isSet(child.firstBaseline) {
				node.firstBaseline = node.insetTop + child.y + child.firstBaseline
				return
			}
		}
	}

	// Arranges the content of `node` in a content box of `width` by `height` and leaves the
	// content's natural size in the pass. A size that is not `known` is the room on offer
	// (unset: unbounded). With `commit` both are known and the children get their final
	// sizes and positions.
	def arrangeContent(pass Pass, node Node, width float, height float, knownW bool, knownH bool, commit bool) {
		// Nothing in the flow: the node is as large as it measures itself. Children out
		// of the flow are placed by their anchors.
		if node.children.len() == 0 || (node.items.len() == 0 && !(node.measure is none)) {
			pass.contentW = 0.0
			pass.contentH = 0.0
			let measure = node.measure
			return when commit || measure is none
			let room = pass.room
			room.width = none
			room.height = none
			room.width = width * 1(px) when isSet(width)
			room.height = height * 1(px) when isSet(height)
			let size = measure(room)
			pass.contentW = float(size.width)
			pass.contentH = float(size.height)
			return
		}
		match node.layout.arrange {
			case Arrange.Grid:
				arrangeGrid(pass, node, width, height, knownW, knownH, commit)
			case Arrange.Layered:
				arrangeLayered(pass, node, width, height, knownW, knownH, commit)
			default:
				arrangeFlow(pass, node, width, height, knownW, knownH, commit)
		}
	}

	// Layered: every child gets the whole content box and is aligned inside it.
	def arrangeLayered(pass Pass, node Node, width float, height float, knownW bool, knownH bool, commit bool) {
		let referenceW = (knownW && !node.autoWidth) ?? (width, unset)
		let referenceH = (knownH && !node.autoHeight) ?? (height, unset)
		let naturalW = 0.0
		let naturalH = 0.0
		for let child in node.items {
			resolveMargins(child, node.rtl, referenceW)
			let marginsW = child.marginStart + child.marginEnd
			let marginsH = child.marginTop + child.marginBottom
			let alignH = slotAlign(node, child, true)
			let alignV = slotAlign(node, child, false)
			let availW = isSet(width) ?? ((width - marginsW).max(0.0), unset)
			let availH = isSet(height) ?? ((height - marginsH).max(0.0), unset)
			let forceW = unset
			forceW = bound(availW, minWidthOf(child, referenceW), maxWidthOf(child, referenceW)) when knownW && stretchOf(child, true, alignH, referenceW)
			let forceH = unset
			forceH = bound(availH, minHeightOf(child, referenceH), maxHeightOf(child, referenceH)) when knownH && stretchOf(child, false, alignV, referenceH)
			sizeNode(pass, child, availW, availH, referenceW, referenceH, forceW, forceH)
			let childW = child.measuredW
			let childH = child.measuredH
			naturalW = naturalW.max(childW + marginsW)
			naturalH = naturalH.max(childH + marginsH)
			if commit {
				placeNode(pass, child, childW, childH, referenceW, referenceH)
				child.x = child.marginStart + alignOffset(alignH, width - marginsW, childW)
				child.y = child.marginTop + alignOffset(alignV, height - marginsH, childH)
			}
		}
		pass.contentW = naturalW
		pass.contentH = naturalH
	}
}
