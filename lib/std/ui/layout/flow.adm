internal partial module std.ui.layout {
	use std.ui.styles::*

	// Sizes a child of a Row (`row`) or Column along the container's main and cross axes.
	def sizeItem(pass Pass, child Node, row bool, availMain float, availCross float, referenceW float, referenceH float, forceMain float, forceCross float) {
		if row {
			sizeNode(pass, child, availMain, availCross, referenceW, referenceH, forceMain, forceCross)
			child.base = child.measuredW
			child.cross = child.measuredH
		} else {
			sizeNode(pass, child, availCross, availMain, referenceW, referenceH, forceCross, forceMain)
			child.base = child.measuredH
			child.cross = child.measuredW
		}
	}

	def marginsMain(child Node, row bool) float {
		return row ?? (child.marginStart + child.marginEnd, child.marginTop + child.marginBottom)
	}

	def marginsCross(child Node, row bool) float {
		return row ?? (child.marginTop + child.marginBottom, child.marginStart + child.marginEnd)
	}

	// Row and Column. Children keep their content size on the main axis, `fill` children
	// share what is left by weight, and when there is too little room children shrink toward
	// their minimum in proportion to how far each is above it. With `wrap`, children that do
	// not fit start a new line.
	def arrangeFlow(pass Pass, node Node, width float, height float, knownW bool, knownH bool, commit bool) {
		let layout = node.layout
		let row = layout.arrange == Arrange.Row
		let main = row ?? (width, height)
		let cross = row ?? (height, width)
		let knownCross = row ?? (knownH, knownW)
		let referenceW = (knownW && !node.autoWidth) ?? (width, unset)
		let referenceH = (knownH && !node.autoHeight) ?? (height, unset)
		let referenceMain = row ?? (referenceW, referenceH)
		let referenceCross = row ?? (referenceH, referenceW)
		let gap = layout.gap
		let gapW = share(node.gapWidthAbs, node.gapWidthPct, referenceW, 0.0)
		let gapH = share(node.gapHeightAbs, node.gapHeightPct, referenceH, 0.0)
		let gapMain = row ?? (gapW, gapH)
		let gapCross = row ?? (gapH, gapW)
		let wrap = layout.wrap && isSet(main)
		let items = node.items
		let count = items.len()

		// Content sizes, and which children stretch across the line.
		for let child in items {
			resolveMargins(child, node.rtl, referenceW)
			let alignment = slotAlign(node, child, !row)
			child.weight = isSet(referenceMain) ?? (fillOf(child, row), 0.0)
			// A `fill` across the line takes the line's size: the container's when it has
			// one, else the largest child's.
			child.stretch = stretchOf(child, !row, alignment, referenceCross) || fillOf(child, !row) > 0.0
			child.resized = false
			child.least = unset
			if child.weight > 0.0 {
				child.base = limitMain(pass, child, row, true, referenceMain).max(0.0)
				child.cross = 0.0
				child.resized = true
				continue
			}
			sizeItem(pass, child, row, unset, crossRoom(cross, child, row), referenceW, referenceH, unset, crossForce(pass, child, row, cross, knownCross && !wrap, referenceCross))
		}

		// Lines: the index of the first child of each.
		// The first child of a line keeps where the line ends and, further down, its sizes.
		let lines = 0
		if count > 0 {
			let head = 0
			lines = 1
			if wrap {
				let used = 0.0
				for let i = 0; i < count; i++ {
					let outer = items[i].base + marginsMain(items[i], row)
					if i > head && used + gapMain + outer > main {
						items[head].lineEnd = i
						head = i
						lines++
						used = outer
						continue
					}
					used += (i > head) ?? (gapMain + outer, outer)
				}
			}
			items[head].lineEnd = count
		}
		let naturalMain = 0.0
		let naturalCross = 0.0

		for let from = 0; from < count; from = items[from].lineEnd {
			let to = items[from].lineEnd
			let used = gapMain * float(to - from - 1)
			let weights = 0.0
			for let i = from; i < to; i++ {
				used += items[i].base + marginsMain(items[i], row)
				weights += items[i].weight
			}
			if isSet(main) && weights > 0.0 && main > used {
				shareFill(pass, items, from, to, row, main - used, referenceMain)
			} else if isSet(main) && used > main {
				shrinkLine(pass, items, from, to, row, used - main, cross, referenceW, referenceH)
			}

			// Children whose main size was decided here are sized again for their cross size.
			used = gapMain * float(to - from - 1)
			let tallest = 0.0
			let ascent = 0.0
			let descent = 0.0
			for let i = from; i < to; i++ {
				let child = items[i]
				if child.resized {
					let decided = child.base
					sizeItem(pass, child, row, unset, crossRoom(cross, child, row), referenceW, referenceH, decided, crossForce(pass, child, row, cross, knownCross && !wrap, referenceCross))
				}
				used += child.base + marginsMain(child, row)
				tallest = tallest.max(child.cross + marginsCross(child, row))
				if row && slotAlign(node, child, false) == Alignment.Baseline {
					let first = baselineOf(pass, child, referenceW, referenceH)
					ascent = ascent.max(child.marginTop + first)
					descent = descent.max(child.cross - first + child.marginBottom)
				}
			}
			tallest = tallest.max(ascent + descent)
			items[from].lineCross = tallest
			items[from].lineUsed = used
			items[from].lineAscent = ascent
			naturalMain = naturalMain.max(used)
			naturalCross += tallest
		}
		naturalCross += gapCross * float((lines - 1).max(0))
		pass.contentW = row ?? (naturalMain, naturalCross)
		pass.contentH = row ?? (naturalCross, naturalMain)
		return when !commit

		// Where the group of lines goes on the cross axis.
		let alignCross = row ?? (node.box.align.vertical, node.box.align.horizontal)
		let alignMain = row ?? (node.box.align.horizontal, node.box.align.vertical)
		let spare = (cross - naturalCross).max(0.0)
		let offsetCross = 0.0
		let grow = 0.0
		if lines == 1 && !wrap {
			items[0].lineCross = cross
		} else if lines > 0 {
			match alignCross {
				case Alignment.Center:
					offsetCross = spare / 2.0
				case Alignment.End:
					offsetCross = spare
				case Alignment.Fill:
					grow = spare / float(lines)
				default:
					offsetCross = 0.0
			}
		}

		for let from = 0; from < count; from = items[from].lineEnd {
			let to = items[from].lineEnd
			let size = items[from].lineCross + grow
			let free = (main - items[from].lineUsed).max(0.0)
			let cursor = 0.0
			let between = 0.0
			let inLine = float(to - from)
			match layout.distribute {
				case Distribute.Between:
					between = (to - from > 1) ?? (free / (inLine - 1.0), 0.0)
				case Distribute.Around:
					between = free / inLine
					cursor = between / 2.0
				case Distribute.Evenly:
					between = free / (inLine + 1.0)
					cursor = between
				default:
					cursor = alignOffset(alignMain, free, 0.0)
			}
			for let i = from; i < to; i++ {
				let child = items[i]
				let alignment = slotAlign(node, child, !row)
				let outerCross = marginsCross(child, row)
				let childCross = child.cross
				childCross = bound((size - outerCross).max(0.0), limitCross(pass, child, row, true, referenceCross), limitCross(pass, child, row, false, referenceCross)) when child.stretch
				let childMain = child.base
				let baseline = 0.0
				if row {
					placeNode(pass, child, childMain, childCross, referenceW, referenceH)
					baseline = isSet(child.firstBaseline) ?? (child.firstBaseline, childCross)
				} else {
					placeNode(pass, child, childCross, childMain, referenceW, referenceH)
				}
				let across = offsetCross + alignOffset(alignment, size - outerCross, childCross)
				across = offsetCross + items[from].lineAscent - child.marginTop - baseline when row && alignment == Alignment.Baseline
				if row {
					child.x = cursor + child.marginStart
					child.y = across + child.marginTop
				} else {
					child.x = across + child.marginStart
					child.y = cursor + child.marginTop
				}
				cursor += childMain + marginsMain(child, row) + gapMain + between
			}
			offsetCross += size + gapCross
		}
	}

	// The room a child has across the line: the container's cross size inside the child's
	// margins, unset when the container has none yet.
	def crossRoom(cross float, child Node, row bool) float {
		return unset when !isSet(cross)
		return (cross - marginsCross(child, row)).max(0.0)
	}

	// The cross size a stretched child is given when the line is as large as the container.
	def crossForce(pass Pass, child Node, row bool, cross float, lineIsContainer bool, referenceCross float) float {
		return unset when !child.stretch || !lineIsContainer
		return bound((cross - marginsCross(child, row)).max(0.0), limitCross(pass, child, row, true, referenceCross), limitCross(pass, child, row, false, referenceCross))
	}

	// The child's set minimum (`least`) or maximum on the container's main axis.
	def limitMain(pass Pass, child Node, row bool, least bool, reference float) float {
		return limitOf(child, row, least, reference)
	}

	// The child's set minimum (`least`) or maximum on the container's cross axis.
	def limitCross(pass Pass, child Node, row bool, least bool, reference float) float {
		return limitMain(pass, child, !row, least, reference)
	}

	// Shares `free` main-axis space between the `fill` children of a line by weight. A share
	// under a child's minimum or over its maximum is held at the limit and the rest is
	// shared again.
	def shareFill(pass Pass, items Node[], from int, to int, row bool, free float, referenceMain float) {
		let room = free
		for let i = from; i < to; i++ {
			let child = items[i]
			continue when child.weight <= 0.0
			child.frozen = false
			// The minimum is already counted in the line.
			room += child.base
		}
		for {
			let weights = 0.0
			let left = room
			for let i = from; i < to; i++ {
				let child = items[i]
				continue when child.weight <= 0.0
				if child.frozen {
					left -= child.base
				} else {
					weights += child.weight
				}
			}
			break when weights <= 0.0
			let held = false
			for let i = from; i < to; i++ {
				let child = items[i]
				continue when child.weight <= 0.0 || child.frozen
				let share = left.max(0.0) * child.weight / weights
				let kept = bound(share, limitMain(pass, child, row, true, referenceMain), limitMain(pass, child, row, false, referenceMain))
				child.base = kept
				if kept != share {
					child.frozen = true
					held = true
				}
			}
			break when !held
		}
	}

	// Takes `excess` main-axis space out of a line. `fill` children are at their minimum
	// already; the others shrink toward theirs in proportion to how far each is above it.
	// The minimum is the set one, else the size itself for a fixed size and the content's
	// minimum for a content-sized child.
	def shrinkLine(pass Pass, items Node[], from int, to int, row bool, excess float, cross float, referenceW float, referenceH float) {
		let referenceMain = row ?? (referenceW, referenceH)
		let slack = 0.0
		for let i = from; i < to; i++ {
			let child = items[i]
			continue when child.weight > 0.0
			let natural = child.base
			let least = limitMain(pass, child, row, true, referenceMain)
			if !isSet(least) {
				least = natural
				if autoOf(child, row, referenceMain) {
					let across = child.cross
					sizeItem(pass, child, row, 0.0, crossRoom(cross, child, row), referenceW, referenceH, unset, unset)
					least = child.base
					child.base = natural
					child.cross = across
				}
			}
			child.least = least.min(natural)
			slack += natural - child.least
		}
		return when slack <= 0.0
		let factor = (excess / slack).min(1.0)
		for let i = from; i < to; i++ {
			let child = items[i]
			continue when child.weight > 0.0 || child.base <= child.least
			child.base -= (child.base - child.least) * factor
			child.resized = true
		}
	}

	// The distance from the top of `child` to its first baseline at its current size, or its
	// height when it has no text.
	def baselineOf(pass Pass, child Node, referenceW float, referenceH float) float {
		let height = child.cross
		let own = child.baseline
		if !(own is none) && child.children.len() == 0 {
			resolveInsets(child, referenceW)
			return child.insetTop + float(own)
		}
		placeNode(pass, child, child.base, height, referenceW, referenceH)
		return isSet(child.firstBaseline) ?? (child.firstBaseline, height)
	}
}
