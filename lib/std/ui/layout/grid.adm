internal partial module std.ui.layout {
	use std.ui.styles::*

	// The tracks a style declares on one axis. A `TrackFit` becomes as many equal `fill`
	// tracks as fit in `room`, each at least its `min`; without a known room it makes
	// `count` tracks, or one per child.
	def declaredTracks(pass Pass, list TrackList, room float, gap float, children int, reference float, em float) Track[] {
		match list {
			case TrackFit:
				let least = spacing(pass, list.min, reference, em)
				let fit = children.max(1)
				let most = list.count
				if isSet(room) {
					fit = int(((room + gap) / (least + gap).max(1.0)).floor()).max(1)
					fit = fit.min(most.max(1)) unless (most is none)
				} else if !(most is none) {
					fit = most.max(1)
				}
				fit = fit.min(children.max(1)) unless list.keep
				let made = Track[]
				for let i = 0; i < fit; i++ {
					made.push(new Track(fill, list.min))
				}
				return made
			default:
				return list
		}
	}

	// The 1-based position a cell names; 0 when it leaves the choice to the flow.
	def cellIndex(position ?int) int {
		return 0 when position is none
		return position.max(0)
	}

	// Whether the cells from (`at`, `line`) are free. `taken` holds one flag per cell, `across`
	// cells per line; lines beyond it are free.
	def cellsFree(taken bool[], across int, at int, line int, span int, lines int) bool {
		for let l = line; l < line + lines; l++ {
			for let a = at; a < at + span; a++ {
				let index = l * across + a
				return false when index < taken.len() && taken[index]
			}
		}
		return true
	}

	def takeCells(taken bool[], across int, at int, line int, span int, lines int) {
		for taken.len() < (line + lines) * across {
			taken.push(false)
		}
		for let l = line; l < line + lines; l++ {
			for let a = at; a < at + span; a++ {
				taken[l * across + a] = true
			}
		}
	}

	// Gives every child its cell. `across` is the number of tracks on the axis the flow
	// fills first (columns when filling row by row). A child that names both positions is
	// placed there; the others take the next free cells in flow order, from the start when
	// `dense`. A position or span beyond `across` is brought back inside it. Returns the
	// number of lines used on the other axis.
	def placeCells(node Node, across int, byRows bool) int {
		let items = node.items
		let taken = bool[]
		let used = 0
		for let child in items {
			let cell = child.cell
			let at = cellIndex(byRows ?? (cell.column, cell.row))
			let line = cellIndex(byRows ?? (cell.row, cell.column))
			let span = (byRows ?? (cell.columnSpan, cell.rowSpan)).max(1).min(across)
			let lines = (byRows ?? (cell.rowSpan, cell.columnSpan)).max(1)
			child.columnSpan = byRows ?? (span, lines)
			child.rowSpan = byRows ?? (lines, span)
			child.frozen = at > 0 && line > 0
			continue when !child.frozen
			let first = (at - 1).min(across - span)
			takeCells(taken, across, first, line - 1, span, lines)
			child.column = byRows ?? (first, line - 1)
			child.row = byRows ?? (line - 1, first)
			used = used.max(line - 1 + lines)
		}

		let cursorAt = 0
		let cursorLine = 0
		for let child in items {
			continue when child.frozen
			let cell = child.cell
			let wantAt = cellIndex(byRows ?? (cell.column, cell.row))
			let wantLine = cellIndex(byRows ?? (cell.row, cell.column))
			let span = byRows ?? (child.columnSpan, child.rowSpan)
			let lines = byRows ?? (child.rowSpan, child.columnSpan)
			let at = 0
			let line = 0
			if wantLine > 0 {
				// The line is given: the first free place in it, the start when it is full.
				line = wantLine - 1
				for let a = 0; a + span <= across; a++ {
					if cellsFree(taken, across, a, line, span, lines) {
						at = a
						break
					}
				}
			} else if wantAt > 0 {
				at = (wantAt - 1).min(across - span)
				line = (at < cursorAt) ?? (cursorLine + 1, cursorLine) unless node.tracks.dense
				for !cellsFree(taken, across, at, line, span, lines) {
					line++
				}
				if !node.tracks.dense {
					cursorAt = at + span
					cursorLine = line
				}
			} else {
				if !node.tracks.dense {
					at = cursorAt
					line = cursorLine
				}
				for {
					if at + span > across {
						at = 0
						line++
					}
					break when cellsFree(taken, across, at, line, span, lines)
					at++
				}
				if !node.tracks.dense {
					cursorAt = at + span
					cursorLine = line
				}
			}
			takeCells(taken, across, at, line, span, lines)
			child.column = byRows ?? (at, line)
			child.row = byRows ?? (line, at)
			used = used.max(line + lines)
		}
		return used
	}

	// Sizes the tracks of one axis. A fixed track has its size, an `auto` track the largest
	// child that sits in it alone, `fill` tracks share what is left by weight. A child over
	// several tracks widens their `auto` tracks equally when it needs more than they have,
	// unless one of them is a `fill`. Columns that do not fit shrink their `auto` tracks
	// toward the smallest their children can be. Inside a grid that sizes to its content a
	// percent track acts as `auto`, and the `fill` tracks are as large as the largest of
	// them needs, by weight: equal columns stay equal.
	def sizeTracks(pass Pass, node Node, declared Track[], count int, room float, reference float, gap float, horizontal bool, referenceW float, referenceH float) float[] {
		let sizes = float[]
		let weights = float[]
		// The `fill` weight of each track of a grid that sizes to its content, else 0.
		let shares = float[]
		let flexible = bool[]
		let least = float[]
		let most = float[]
		let em = node.em
		for let t = 0; t < count; t++ {
			let track = (t < declared.len()) ?? (declared[t], node.tracks.autoTrack)
			let fixed = fixedSize(pass, track.size, reference, em)
			let weight = isSet(reference) ?? (fillWeight(track.size), 0.0)
			shares.push(isSet(reference) ?? (0.0, fillWeight(track.size)))
			let low = limit(pass, track.min, reference, em)
			let high = limit(pass, track.max, reference, em)
			least.push(low)
			most.push(high)
			if isSet(fixed) {
				sizes.push(bound(fixed, low, high))
				weights.push(0.0)
				flexible.push(false)
			} else if weight > 0.0 {
				sizes.push(isSet(low) ?? (low, 0.0))
				weights.push(weight)
				flexible.push(false)
			} else {
				sizes.push(0.0)
				weights.push(0.0)
				flexible.push(true)
			}
		}

		// What each child needs: its content width for columns, its height at the width
		// its columns gave it for rows.
		for let child in node.items {
			if horizontal {
				resolveMargins(child, node.rtl, referenceW)
				sizeNode(pass, child, unset, unset, referenceW, referenceH, unset, unset)
				child.least = child.measuredW + child.marginStart + child.marginEnd
			} else {
				sizeNode(pass, child, unset, unset, referenceW, referenceH, child.base, unset)
				child.least = child.measuredH + child.marginTop + child.marginBottom
			}
			let at = horizontal ?? (child.column, child.row)
			let span = horizontal ?? (child.columnSpan, child.rowSpan)
			sizes[at] = sizes[at].max(child.least) when span == 1 && flexible[at]
		}
		for let child in node.items {
			let at = horizontal ?? (child.column, child.row)
			let span = horizontal ?? (child.columnSpan, child.rowSpan)
			continue when span == 1
			let have = gap * float(span - 1)
			let growing = 0
			let filled = false
			for let t = at; t < at + span; t++ {
				have += sizes[t]
				filled = filled || weights[t] > 0.0
				if flexible[t] {
					growing++
				}
			}
			continue when filled || growing == 0 || child.least <= have
			let more = (child.least - have) / float(growing)
			for let t = at; t < at + span; t++ {
				sizes[t] += more when flexible[t]
			}
		}

		// One unit of weight is what the neediest `fill` track asks for its own.
		let unit = 0.0
		for let t = 0; t < count; t++ {
			unit = unit.max(sizes[t] / shares[t]) when flexible[t] && shares[t] > 0.0
		}
		let total = gap * float((count - 1).max(0))
		let weight = 0.0
		for let t = 0; t < count; t++ {
			sizes[t] = unit * shares[t] when flexible[t] && shares[t] > 0.0
			sizes[t] = bound(sizes[t], least[t], most[t]) when flexible[t]
			total += sizes[t]
			weight += weights[t]
		}
		return sizes when !isSet(room)

		if weight > 0.0 && room > total {
			shareTracks(sizes, weights, least, most, room - total)
		} else if horizontal && total > room {
			shrinkTracks(pass, node, sizes, flexible, least, total - room, referenceW, referenceH)
		}
		return sizes
	}

	// Shares `free` space between the `fill` tracks by weight; a share outside a track's
	// limits is held there and the rest shared again.
	def shareTracks(sizes float[], weights float[], least float[], most float[], free float) {
		let count = sizes.len()
		let held = bool[]
		let room = free
		for let t = 0; t < count; t++ {
			held.push(false)
			room += sizes[t] when weights[t] > 0.0
		}
		for {
			let total = 0.0
			let left = room
			for let t = 0; t < count; t++ {
				continue when weights[t] <= 0.0
				if held[t] {
					left -= sizes[t]
				} else {
					total += weights[t]
				}
			}
			break when total <= 0.0
			let again = false
			for let t = 0; t < count; t++ {
				continue when weights[t] <= 0.0 || held[t]
				let share = left.max(0.0) * weights[t] / total
				sizes[t] = bound(share, least[t], most[t])
				if sizes[t] != share {
					held[t] = true
					again = true
				}
			}
			break when !again
		}
	}

	// Takes `excess` out of the `auto` columns, each in proportion to how far it is above
	// the smallest its single-column children can be.
	def shrinkTracks(pass Pass, node Node, sizes float[], flexible bool[], least float[], excess float, referenceW float, referenceH float) {
		let count = sizes.len()
		let floors = float[]
		for let t = 0; t < count; t++ {
			floors.push(isSet(least[t]) ?? (least[t], 0.0))
		}
		for let child in node.items {
			continue when child.columnSpan != 1 || !flexible[child.column]
			sizeNode(pass, child, 0.0, unset, referenceW, referenceH, unset, unset)
			let smallest = child.measuredW + child.marginStart + child.marginEnd
			floors[child.column] = floors[child.column].max(smallest)
		}
		let slack = 0.0
		for let t = 0; t < count; t++ {
			slack += sizes[t] - floors[t] when flexible[t] && sizes[t] > floors[t]
		}
		return when slack <= 0.0
		let factor = (excess / slack).min(1.0)
		for let t = 0; t < count; t++ {
			sizes[t] -= (sizes[t] - floors[t]) * factor when flexible[t] && sizes[t] > floors[t]
		}
	}

	// Where each track starts, with one more entry for the end of the last.
	def trackStarts(sizes float[], gap float) float[] {
		let starts = float[]
		let at = 0.0
		for let size in sizes {
			starts.push(at)
			at += size + gap
		}
		starts.push((sizes.len() > 0) ?? (at - gap, 0.0))
		return starts
	}

	// Grid: children sit in the cells of `Tracks`, each aligned inside the area its cell
	// and spans cover. Columns are sized first, then rows from the heights the children
	// have at their column widths.
	def arrangeGrid(pass Pass, node Node, width float, height float, knownW bool, knownH bool, commit bool) {
		let tracks = node.tracks
		let items = node.items
		let referenceW = (knownW && !node.autoWidth) ?? (width, unset)
		let referenceH = (knownH && !node.autoHeight) ?? (height, unset)
		let gap = node.layout.gap
		let gapW = share(node.gapWidthAbs, node.gapWidthPct, referenceW, 0.0)
		let gapH = share(node.gapHeightAbs, node.gapHeightPct, referenceH, 0.0)
		let byRows = tracks.flow == GridFlow.Rows
		let columns = declaredTracks(pass, tracks.columns, width, gapW, items.len(), referenceW, node.em)
		let rows = declaredTracks(pass, tracks.rows, height, gapH, items.len(), referenceH, node.em)
		let across = (byRows ?? (columns.len(), rows.len())).max(1)
		let used = placeCells(node, across, byRows)
		let columnCount = byRows ?? (across, used.max(columns.len()))
		let rowCount = byRows ?? (used.max(rows.len()), across)

		let widths = sizeTracks(pass, node, columns, columnCount, width, referenceW, gapW, true, referenceW, referenceH)
		let lefts = trackStarts(widths, gapW)
		for let child in items {
			let area = lefts[child.column + child.columnSpan] - lefts[child.column] - gapW * float((child.columnSpan > 0 && child.column + child.columnSpan < columnCount) ?? (1, 0))
			let room = (area - child.marginStart - child.marginEnd).max(0.0)
			if stretchOf(child, true, slotAlign(node, child, true), referenceW) {
				child.base = bound(room, minWidthOf(child, referenceW), maxWidthOf(child, referenceW))
			} else {
				sizeNode(pass, child, room, unset, referenceW, referenceH, unset, unset)
				child.base = child.measuredW
			}
			child.weight = room
		}

		let heights = sizeTracks(pass, node, rows, rowCount, height, referenceH, gapH, false, referenceW, referenceH)
		let tops = trackStarts(heights, gapH)
		pass.contentW = lefts[columnCount]
		pass.contentH = tops[rowCount]
		return when !commit

		let offsetX = alignOffset(node.box.align.horizontal, (width - lefts[columnCount]).max(0.0), 0.0)
		let offsetY = alignOffset(node.box.align.vertical, (height - tops[rowCount]).max(0.0), 0.0)
		for let child in items {
			let area = tops[child.row + child.rowSpan] - tops[child.row] - gapH * float((child.row + child.rowSpan < rowCount) ?? (1, 0))
			let room = (area - child.marginTop - child.marginBottom).max(0.0)
			let alignV = slotAlign(node, child, false)
			let childW = child.base
			let childH = 0.0
			if stretchOf(child, false, alignV, referenceH) {
				childH = bound(room, minHeightOf(child, referenceH), maxHeightOf(child, referenceH))
			} else {
				sizeNode(pass, child, child.weight, room, referenceW, referenceH, childW, unset)
				childH = child.measuredH
			}
			let roomW = child.weight
			placeNode(pass, child, childW, childH, referenceW, referenceH)
			child.x = offsetX + lefts[child.column] + child.marginStart + alignOffset(slotAlign(node, child, true), roomW, childW)
			child.y = offsetY + tops[child.row] + child.marginTop + alignOffset(alignV, room, childH)
		}
	}
}
