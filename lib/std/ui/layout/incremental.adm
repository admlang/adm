// What a layout pass reads of each node, kept from one pass to the next: a pass whose nodes
// read the same as the last one's keeps the geometry the last one gave, and one that differs
// only by how far scrolling containers are scrolled moves what they hold.
internal partial module std.ui.layout {
	use (
		std.ui::Limit
		std.ui.styles::*
		std.units::(Extent, Pixels)
		std.math.geom::Size
	)

	// Notes what the pass reads of `node`, which `prepare` has resolved: the numbers its
	// style gave, how it is placed and arranged, its tracks, the leaf sizes it measured last
	// time measured again, its scroll offset apart. Sets `pass.changed` when any of it is
	// not what the pass before read. With `kept` the box resolved to what it did last
	// time, and the numbers it gives are the ones noted then.
	def noteInputs(pass Pass, node Node, kept bool = false) {
		pass.noted = 0
		let before = pass.changed
		pass.changed = false
		if kept {
			pass.noted = node.boxNotes
		} else {
			noteBox(pass, node)
			node.boxNotes = pass.noted
		}
		// What its box gives its parent reads otherwise (its size, margins, place).
		pass.boxChanged = pass.changed
		pass.changed = pass.changed || before
		let box = node.box
		let layout = node.layout
		let baseline = node.baseline
		note(pass, node, baseline is none ?? (unset, float(baseline)))
		note(pass, node, node.scroll is none ?? (0.0, 1.0))
		note(pass, node, node.scrollAxes.horizontal ?? (1.0, 0.0))
		note(pass, node, node.scrollAxes.vertical ?? (1.0, 0.0))
		note(pass, node, node.scrollbar)
		note(pass, node, node.scrollbarKept ?? (1.0, 0.0))
		note(pass, node, node.measure is none ?? (0.0, 1.0))
		pass.targets = 0
		let anchors = box.anchors
		noteLine(pass, node, anchors.left)
		noteLine(pass, node, anchors.top)
		noteLine(pass, node, anchors.right)
		noteLine(pass, node, anchors.bottom)
		noteLine(pass, node, anchors.centerX)
		noteLine(pass, node, anchors.centerY)
		if node.laidTargets.len() > pass.targets {
			node.laidTargets.len(pass.targets)
			pass.changed = true
		}
		if layout.arrange == Arrange.Grid {
			let tracks = node.tracks
			noteTracks(pass, node, tracks.columns)
			noteTracks(pass, node, tracks.rows)
			noteTrack(pass, node, tracks.autoTrack)
			note(pass, node, float(int(tracks.flow)))
			note(pass, node, tracks.dense ?? (1.0, 0.0))
		}
		if node.inputs.len() > pass.noted {
			node.inputs.len(pass.noted)
			pass.changed = true
		}
		noteScroll(pass, node)
		noteMeasures(pass, node)
	}

	// Notes the numbers the node's resolved box gives the pass: direction, `em`, sizes,
	// insets, margins, gaps, arrangement, its own alignment and cell.
	def noteBox(pass Pass, node Node) {
		let box = node.box
		note(pass, node, node.rtl ?? (1.0, 0.0))
		note(pass, node, node.em)
		note(pass, node, box.visible ?? (1.0, 0.0))
		note(pass, node, float(int(box.position)))
		note(pass, node, float(int(box.layer)))
		note(pass, node, float(int(box.align.horizontal)))
		note(pass, node, float(int(box.align.vertical)))
		note(pass, node, node.widthFill)
		note(pass, node, node.widthAuto ?? (1.0, 0.0))
		note(pass, node, node.widthAbs)
		note(pass, node, node.widthPct)
		note(pass, node, node.heightFill)
		note(pass, node, node.heightAuto ?? (1.0, 0.0))
		note(pass, node, node.heightAbs)
		note(pass, node, node.heightPct)
		note(pass, node, node.minWidthSet ?? (node.minWidthAbs, unset))
		note(pass, node, node.minWidthPct)
		note(pass, node, node.maxWidthSet ?? (node.maxWidthAbs, unset))
		note(pass, node, node.maxWidthPct)
		note(pass, node, node.minHeightSet ?? (node.minHeightAbs, unset))
		note(pass, node, node.minHeightPct)
		note(pass, node, node.maxHeightSet ?? (node.maxHeightAbs, unset))
		note(pass, node, node.maxHeightPct)
		note(pass, node, node.insetLeftAbs)
		note(pass, node, node.insetLeftPct)
		note(pass, node, node.insetRightAbs)
		note(pass, node, node.insetRightPct)
		note(pass, node, node.insetTopAbs)
		note(pass, node, node.insetTopPct)
		note(pass, node, node.insetBottomAbs)
		note(pass, node, node.insetBottomPct)
		note(pass, node, node.marginLeftAbs)
		note(pass, node, node.marginLeftPct)
		note(pass, node, node.marginRightAbs)
		note(pass, node, node.marginRightPct)
		note(pass, node, node.marginTopAbs)
		note(pass, node, node.marginTopPct)
		note(pass, node, node.marginBottomAbs)
		note(pass, node, node.marginBottomPct)
		note(pass, node, node.gapWidthAbs)
		note(pass, node, node.gapWidthPct)
		note(pass, node, node.gapHeightAbs)
		note(pass, node, node.gapHeightPct)
		let layout = node.layout
		note(pass, node, float(int(layout.arrange)))
		note(pass, node, float(int(layout.distribute)))
		note(pass, node, layout.wrap ?? (1.0, 0.0))
		note(pass, node, layout.reverse ?? (1.0, 0.0))
		let own = node.alignSelf
		note(pass, node, own is none ?? (-1.0, float(int(own.horizontal))))
		note(pass, node, own is none ?? (-1.0, float(int(own.vertical))))
		let cell = node.cell
		let (column, row) = (cell.column, cell.row)
		note(pass, node, column is none ?? (-1.0, float(column)))
		note(pass, node, row is none ?? (-1.0, float(row)))
		note(pass, node, float(cell.columnSpan))
		note(pass, node, float(cell.rowSpan))
	}

	// Notes one number of what the pass reads of `node`.
	def note(pass Pass, node Node, value float) {
		let at = pass.noted
		pass.noted = at + 1
		if at < node.inputs.len() {
			return when node.inputs[at] == value
			node.inputs[at] = value
			pass.changed = true
			return
		}
		node.inputs.push(value)
		pass.changed = true
	}

	// Notes an extent as the pixels and the percent `split` makes of it.
	def noteExtent(pass Pass, node Node, extent ?Extent) {
		if extent is none {
			note(pass, node, unset)
			note(pass, node, unset)
			return
		}
		split(pass, extent, node.em)
		note(pass, node, pass.abs)
		note(pass, node, pass.pct)
	}

	def noteSizing(pass Pass, node Node, size Sizing) {
		note(pass, node, fillWeight(size))
		match size {
			case Auto:
				note(pass, node, 1.0)
				noteExtent(pass, node, none)
			case Fill:
				note(pass, node, 2.0)
				noteExtent(pass, node, none)
			default:
				note(pass, node, 0.0)
				let extent Extent = size
				noteExtent(pass, node, extent)
		}
	}

	def noteTrack(pass Pass, node Node, track Track) {
		noteSizing(pass, node, track.size)
		noteExtent(pass, node, track.min)
		noteExtent(pass, node, track.max)
	}

	def noteTracks(pass Pass, node Node, list TrackList) {
		match list {
			case TrackFit:
				note(pass, node, -1.0)
				noteExtent(pass, node, list.min)
				let count = list.count
				note(pass, node, count is none ?? (-1.0, float(count)))
				note(pass, node, list.keep ?? (1.0, 0.0))
			default:
				let tracks Track[] = list
				note(pass, node, float(tracks.len()))
				for let track in tracks {
					noteTrack(pass, node, track)
				}
		}
	}

	// Notes one anchor line: its edge, its offset and the component whose line it names,
	// by identity (`laidTargets`).
	def noteLine(pass Pass, node Node, line ?AnchorLine) {
		if line is none {
			note(pass, node, 0.0)
			return
		}
		note(pass, node, 1.0)
		let edge = line.edge
		note(pass, node, edge is none ?? (-1.0, float(int(edge))))
		noteExtent(pass, node, line.offset)
		let target = line.target
		return when target is none
		let at = pass.targets
		pass.targets = at + 1
		if at < node.laidTargets.len() {
			return when node.laidTargets[at] == target
			node.laidTargets[at] = target
			pass.changed = true
			return
		}
		node.laidTargets.push(target)
		pass.changed = true
	}

	// Notes how far a scrolling container is scrolled, apart from the rest: one that only
	// scrolled moves what it holds (`shiftScrolled`). The offset is kept for the next pass.
	def noteScroll(pass Pass, node Node) {
		let scroll = node.scroll
		if scroll is none {
			pass.changed = true when node.laidScrolled
			node.laidScrolled = false
			return
		}
		let (x, y) = (float(scroll.x), float(scroll.y))
		if !node.laidScrolled {
			pass.changed = true
			node.reachChanged()
		} else if x != node.laidScrollX || y != node.laidScrollY {
			pass.scrolls.push(node)
			// Content moves the other way; under RightToLeft scrolling brings in what is
			// further left, so it moves the same way on that axis.
			pass.shifts.push(node.rtl ?? (x - node.laidScrollX, node.laidScrollX - x))
			pass.shifts.push(node.laidScrollY - y)
			// What it holds moves inside it: what the container reaches changes, what each
			// child reaches does not.
			node.reachChanged()
		}
		node.laidScrolled = true
		node.laidScrollX = x
		node.laidScrollY = y
	}

	// Measures a leaf again with each limit the pass before measured it with: a size that
	// differs changes the pass.
	def noteMeasures(pass Pass, node Node) {
		let measure = node.measure
		// What an older pass measured: the last whole one did not measure the leaf.
		return when measure is none || node.measured.len() == 0 || node.measuredOf != pass.laidSerial
		let held = node.measured
		let room = pass.room
		for let i = 0; i + 5 < held.len() && !pass.changed; i += 6 {
			room.width = none
			room.height = none
			room.width = held[i + 1] * 1(px) when held[i] != 0.0
			room.height = held[i + 3] * 1(px) when held[i + 2] != 0.0
			let size = measure(room)
			pass.changed = true when float(size.width) != held[i + 4] || float(size.height) != held[i + 5]
		}
	}

	// Keeps what a leaf measured in pass `serial`, for the next pass to measure again.
	def recordMeasure(node Node, serial int, room Limit, size Size<Pixels>) {
		if node.measuredOf != serial {
			node.measured.len(0)
			node.measuredOf = serial
		}
		let (width, height) = (room.width, room.height)
		let (wSet, w) = (width is none ?? (0.0, 1.0), width is none ?? (0.0, float(width)))
		let (hSet, h) = (height is none ?? (0.0, 1.0), height is none ?? (0.0, float(height)))
		// A limit measured again in the pass gives what it gave.
		let held = node.measured
		for let i = 0; i + 5 < held.len(); i += 6 {
			return when held[i] == wSet && held[i + 1] == w && held[i + 2] == hSet && held[i + 3] == h
		}
		held.push(wSet)
		held.push(w)
		held.push(hSet)
		held.push(h)
		held.push(float(size.width))
		held.push(float(size.height))
	}

	// Notes the children `node` has against those of the pass before.
	def noteChildren(pass Pass, node Node) {
		let children = node.children
		let laid = node.laid
		let same = children.len() == laid.len()
		if same {
			for let (i, child) in children {
				if child != laid[i] {
					same = false
					break
				}
			}
		}
		return when same
		pass.changed = true
		node.laid = children.clone()
		node.reachChanged()
	}

	// Moves the window frames of what each scrolled container of `pass.scrolls` holds by
	// how far it scrolled, then places every node anchors place again (one may name a line
	// of what moved), as a whole pass would. False, with nothing moved, when a scrolled
	// container holds a Sticky node, whose place depends on the offset otherwise.
	def shiftScrolled(pass Pass, root Node) bool {
		for let scroller in pass.scrolls {
			return false when holdsSticky(pass, scroller)
		}
		for let (i, scroller) in pass.scrolls {
			let (dx, dy) = (pass.shifts[i * 2], pass.shifts[i * 2 + 1])
			for let child in scroller.children {
				shiftFrames(child, dx, dy)
			}
		}
		if pass.rechecked {
			placeKept(pass, root)
		} else {
			markPlaced(pass, root, true)
		}
		settle(pass)
		return true
	}

	// Whether what the scrolling container holds has a Sticky node, as of the last whole
	// pass: found once per such pass.
	def holdsSticky(pass Pass, scroller Node) bool {
		if scroller.stickyOf != pass.laidSerial {
			scroller.holdsSticky = false
			for let child in scroller.children {
				scroller.holdsSticky = true when hasSticky(child)
			}
			scroller.stickyOf = pass.laidSerial
		}
		return scroller.holdsSticky
	}

	// For a pass that did not prepare the whole tree (`recheck`): the nodes anchors place,
	// as the last layout left the tree (`keptLists`), are prepared again with what is
	// under them and listed for `settle`; the lines they name are those of the visible
	// nodes of a component. Everything else is final as it is.
	def placeKept(pass Pass, root Node) {
		keptLists(pass, root) when root.anchoredOf != pass.laidSerial || !root.ownedFresh
		return when root.anchoredKept.len() == 0
		pass.owned = root.ownedKept.clone()
		for let node in root.anchoredKept {
			let above = node.parent
			if above is none {
				prepare(pass, node, node.rtl, node.em, true)
			} else {
				prepare(pass, node, above.rtl, above.em, true)
			}
			pass.anchored.push(node)
		}
	}

	// Finds, in the tree as the last layout left it, the visible nodes anchors place
	// (the topmost: placing one lists the anchored nodes under it) and the visible nodes
	// of a component.
	def keptLists(pass Pass, root Node) {
		root.anchoredKept = []
		root.ownedKept = []
		collectKept(root, root, true)
		root.anchoredOf = pass.laidSerial
		root.ownedFresh = true
	}

	def collectKept(root Node, node Node, shown bool) {
		let visible = shown && node.box.visible
		return unless visible
		root.ownedKept.push(node) unless node.owner is none
		let pinned = node != root && (node.box.position := Position.Relative || Position.Absolute)
		root.anchoredKept.push(node) when pinned
		for let child in node.children {
			if pinned {
				collectOwned(root, child, true)
			} else {
				collectKept(root, child, true)
			}
		}
	}

	def collectOwned(root Node, node Node, shown bool) {
		return unless shown && node.box.visible
		root.ownedKept.push(node) unless node.owner is none
		for let child in node.children {
			collectOwned(root, child, true)
		}
	}

	def hasSticky(node Node) bool {
		return true when node.box.position == Position.Sticky
		for let child in node.children {
			return true when hasSticky(child)
		}
		return false
	}

	// Takes what the pass before placed as final, for the lines anchors name, and lists the
	// visible nodes anchors place, which are placed again with what is under them (placing
	// one lists the anchored nodes under it).
	def markPlaced(pass Pass, node Node, shown bool) {
		let visible = shown && node.box.visible
		if visible && (node.box.position := Position.Relative || Position.Absolute) {
			pass.anchored.push(node)
			return
		}
		node.placedX = true
		node.placedY = true
		node.settled = true
		for let child in node.children {
			markPlaced(pass, child, visible)
		}
	}

	// Moves the frames of `node` and what is under it; one that is not visible stays at
	// zero.
	def shiftFrames(node Node, dx float, dy float) {
		return unless node.box.visible
		let frame = node.geom.frame
		frame.left = (float(frame.left) + dx) * 1(px)
		frame.right = (float(frame.right) + dx) * 1(px)
		frame.top = (float(frame.top) + dy) * 1(px)
		frame.bottom = (float(frame.bottom) + dy) * 1(px)
		for let child in node.children {
			shiftFrames(child, dx, dy)
		}
	}
}
