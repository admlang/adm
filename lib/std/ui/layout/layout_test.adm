internal partial module std.ui.layout {
	use (
		std.math.geom::(Axes, Edges, Point, Size)
		std.testing
		std.ui::Limit
		std.ui.styles::*
		std.units::(Extent, Pixels)
	)

	def near(value Pixels, expected float) bool {
		let delta = float(value) - expected
		return delta < 0.01 && delta > -0.01
	}

	// Whether the node's border box sits at (`left`, `top`) in its parent's content box
	// with that size.
	def sits(node Node, left float, top float, width float, height float) bool {
		let bounds = node.geom.bounds
		return near(bounds.left, left) && near(bounds.top, top) && near(bounds.width, width) && near(bounds.height, height)
	}

	// Whether the node's border box starts at (`left`, `top`) in the window.
	def framed(node Node, left float, top float) bool {
		let frame = node.geom.frame
		return near(frame.left, left) && near(frame.top, top)
	}

	// A leaf of a fixed size.
	def block(width float, height float) Node {
		return new Node(Box{width: width * 1(px), height: height * 1(px)})
	}

	// A leaf that measures like text: `words` words 40 wide on lines 20 high, wrapped to the
	// width on offer but never inside a word.
	def words(count int) Node {
		let node = new Node()
		node.baseline = 15(px)
		node.measure = def (limit Limit) Size<Pixels> {
			let perLine = count
			let room = limit.width
			perLine = int((float(room) / 40.0).floor()).max(1).min(count) unless (room is none)
			let lines = (count + perLine - 1) / perLine
			return new Size<Pixels>(float(perLine) * 40.0 * 1(px), float(lines) * 20.0 * 1(px))
		}
		return node
	}

	def gap(size float) Axes<Extent> {
		return new Axes<Extent>(size * 1(px))
	}

	def rowTrack(height float) Track {
		let size Sizing = height * 1(px)
		return new Track(size)
	}

	// A button: padding around a one-word label.
	def button() Node {
		let node = new Node(Box{padding: new Edges<Extent>(8(px))})
		return node.add(words(1))
	}

	// A page of `rows` rows of ten cards, each a padded column of a wrapping text and two
	// fixed blocks: 41 nodes per row.
	def cardPage(rows int) Node {
		let page = new Node(Box{width: fill, height: fill, padding: new Edges<Extent>(12(px))}, Layout{gap: gap(6.0)})
		for let r = 0; r < rows; r++ {
			let row = new Node(Box{width: fill}, Layout{arrange: Arrange.Row, gap: gap(6.0)})
			for let c = 0; c < 10; c++ {
				let card = new Node(Box{width: fill, padding: new Edges<Extent>(4(px))}, Layout{gap: gap(2.0)})
				card.add(words(6), block(40.0, 12.0), block(24.0, 8.0))
				row.add(card)
			}
			page.add(row)
		}
		return page
	}

	let benchPage ?Node = none

	def window(width float, height float) Size<Pixels> {
		return new Size<Pixels>(width * 1(px), height * 1(px))
	}

	check "Layout" {
		component Trigger {
			view {}
			style {}
			type {}
		}

		// Children stack top to bottom inside the padding; gap and margins add up, margins
		// never collapse.
		@test()
		def TestColumn() {
			let a = block(50.0, 20.0)
			let b = block(80.0, 30.0)
			let c = block(10.0, 10.0)
			a.box = Box{...a.box, margin: new Edges<Extent>(0(px), 0(px), 16(px), 0(px))}
			b.box = Box{...b.box, margin: new Edges<Extent>(16(px), 0(px), 0(px), 4(px))}
			let column = new Node(Box{padding: new Edges<Extent>(10(px))}, Layout{gap: gap(5.0)})
			column.add(a, b, c)
			let warnings = column.arrange(window(400.0, 300.0))
			assert warnings.len() == 0
			// Sized to content: widest child plus padding, heights plus margins and gaps.
			assert sits(column, 0.0, 0.0, 104.0, 20.0 + 16.0 + 5.0 + 16.0 + 30.0 + 5.0 + 10.0 + 20.0)
			assert sits(a, 0.0, 0.0, 50.0, 20.0)
			assert sits(b, 4.0, 57.0, 80.0, 30.0)
			assert sits(c, 0.0, 92.0, 10.0, 10.0)
			assert framed(b, 14.0, 67.0)
			assert near(column.geom.content.left, 10.0) && near(column.geom.content.right, 94.0)
		}

		// `fill` children share what fixed and auto siblings leave, by weight; a share over
		// a maximum is held and the rest shared again.
		// A `fill` across a column or a row that is as large as its content takes the
		// size of the largest child: a rule under a heading, a line between two words.
		@test()
		def TestFillAcrossContentSized() {
			let wide = block(80.0, 20.0)
			let rule = new Node(Box{width: fill, height: 2(px)})
			let column = new Node(Box{}, Layout{})
			column.add(wide, rule)
			column.arrange(window(400.0, 300.0))
			assert sits(column, 0.0, 0.0, 80.0, 22.0) && sits(rule, 0.0, 20.0, 80.0, 2.0)

			let tall = block(30.0, 40.0)
			let bar = new Node(Box{width: 1(px), height: fill})
			let row = new Node(Box{}, Layout{arrange: Arrange.Row})
			row.add(tall, bar)
			row.arrange(window(400.0, 300.0))
			assert sits(row, 0.0, 0.0, 31.0, 40.0) && sits(bar, 30.0, 0.0, 1.0, 40.0)
		}

		// In a grid as large as its content the `fill` columns are as wide as the widest
		// of them needs, by weight.
		@test()
		def TestFillTracksInContentSizedGrid() {
			let narrow = block(30.0, 10.0)
			let wide = block(50.0, 10.0)
			let last = block(20.0, 10.0)
			let grid = new Node(Box{}, Layout{arrange: Arrange.Grid}, Tracks{columns: [new Track(fill), new Track(fill * 2)]})
			grid.add(narrow, wide, last)
			grid.arrange(window(400.0, 300.0))
			// The second column needs 50 for a weight of 2, the first 30 for 1: a unit is 30.
			assert sits(grid, 0.0, 0.0, 90.0, 20.0)
			assert sits(wide, 30.0, 0.0, 50.0, 10.0) && sits(last, 0.0, 10.0, 20.0, 10.0)
		}

		@test()
		def TestFillWeights() {
			let fixed = block(60.0, 10.0)
			let one = new Node(Box{width: fill, height: 10(px)})
			let two = new Node(Box{width: fill * 2, height: 10(px)})
			let row = new Node(Box{width: 300(px)}, Layout{arrange: Arrange.Row})
			row.add(fixed, one, two)
			row.arrange(window(800.0, 600.0))
			assert sits(one, 60.0, 0.0, 80.0, 10.0)
			assert sits(two, 140.0, 0.0, 160.0, 10.0)

			two.box = Box{...two.box, maxWidth: 100(px)}
			row.arrange(window(800.0, 600.0))
			assert sits(one, 60.0, 0.0, 140.0, 10.0)
			assert sits(two, 200.0, 0.0, 100.0, 10.0)

			// Inside a parent that sizes to its content, fill acts as auto.
			let loose = new Node(Box{}, Layout{arrange: Arrange.Row})
			let inner = new Node(Box{width: fill, height: 10(px)})
			loose.add(block(60.0, 10.0), inner)
			loose.arrange(window(800.0, 600.0))
			assert sits(loose, 0.0, 0.0, 60.0, 10.0)
			assert sits(inner, 60.0, 0.0, 0.0, 10.0)
		}

		// Too little room: children shrink toward their minimum in proportion to how far
		// each is above it; a fixed size without a set minimum does not shrink.
		@test()
		def TestShrink() {
			let fixed = block(150.0, 10.0)
			fixed.box = Box{...fixed.box, minWidth: 50(px)}
			let text = words(5)
			let row = new Node(Box{width: 200(px)}, Layout{arrange: Arrange.Row})
			row.add(fixed, text)
			row.arrange(window(800.0, 600.0))
			// 150 over: 100 of slack in the fixed child, 160 in the text (200 down to one word).
			let factor = 150.0 / 260.0
			assert sits(fixed, 0.0, 0.0, 150.0 - 100.0 * factor, 10.0)
			// Five words at 107 wide are three lines.
			assert sits(text, 150.0 - 100.0 * factor, 0.0, 200.0 - 160.0 * factor, 60.0)

			let stiff = new Node(Box{width: 100(px)}, Layout{arrange: Arrange.Row})
			let first = block(80.0, 10.0)
			let second = block(80.0, 10.0)
			stiff.add(first, second)
			stiff.arrange(window(800.0, 600.0))
			assert sits(first, 0.0, 0.0, 80.0, 10.0)
			assert sits(second, 80.0, 0.0, 80.0, 10.0)
		}

		// A percent is a share of the parent's content size; against a parent that sizes to
		// its content it acts as auto. Margin and padding percents take the parent's content
		// width on all four sides.
		@test()
		def TestPercent() {
			let half = new Node(Box{width: 50(%), height: 25(%), padding: new Edges<Extent>(10(%))})
			let parent = new Node(Box{width: 220(px), height: 120(px), padding: new Edges<Extent>(10(px))})
			parent.add(half)
			parent.arrange(window(800.0, 600.0))
			assert sits(half, 0.0, 0.0, 100.0, 25.0)
			assert near(half.geom.content.left, 20.0) && near(half.geom.content.top, 20.0)

			let loose = new Node()
			let child = new Node(Box{width: 50(%), height: 50(%)})
			child.add(block(30.0, 12.0))
			loose.add(child)
			loose.arrange(window(800.0, 600.0))
			assert sits(child, 0.0, 0.0, 30.0, 12.0)
			assert sits(loose, 0.0, 0.0, 30.0, 12.0)
		}

		// Limits hold the size; a set minimum over the maximum wins.
		@test()
		def TestLimits() {
			let wide = new Node(Box{minWidth: 200(px), maxWidth: 120(px), maxHeight: 15(px)})
			wide.add(block(50.0, 40.0))
			let capped = new Node(Box{width: fill, maxWidth: 90(px), height: 10(px)})
			let column = new Node(Box{width: 300(px)})
			column.add(wide, capped)
			column.arrange(window(800.0, 600.0))
			assert sits(wide, 0.0, 0.0, 200.0, 15.0)
			assert sits(capped, 0.0, 15.0, 90.0, 10.0)
		}

		// Children that do not fit move to a new line; lines stack with the other gap.
		@test()
		def TestWrap() {
			let row = new Node(Box{width: 200(px)}, Layout{arrange: Arrange.Row, wrap: true, gap: new Axes<Extent>(10(px), 4(px))})
			let cells = Node[]
			for let i = 0; i < 5; i++ {
				let cell = block(80.0, 20.0 + float(i))
				cells.push(cell)
				row.add(cell)
			}
			row.arrange(window(800.0, 600.0))
			assert sits(cells[0], 0.0, 0.0, 80.0, 20.0)
			assert sits(cells[1], 90.0, 0.0, 80.0, 21.0)
			assert sits(cells[2], 0.0, 25.0, 80.0, 22.0)
			assert sits(cells[3], 90.0, 25.0, 80.0, 23.0)
			assert sits(cells[4], 0.0, 52.0, 80.0, 24.0)
			assert sits(row, 0.0, 0.0, 200.0, 76.0)
		}

		// `distribute` shares free main-axis space; with Packed, `align` places the group.
		// `reverse` lays out last to first.
		@test()
		def TestDistribute() {
			let a = block(20.0, 10.0)
			let b = block(20.0, 10.0)
			let c = block(20.0, 10.0)
			let row = new Node(Box{width: 120(px)}, Layout{arrange: Arrange.Row, distribute: Distribute.Between})
			row.add(a, b, c)
			row.arrange(window(800.0, 600.0))
			assert near(a.geom.bounds.left, 0.0) && near(b.geom.bounds.left, 50.0) && near(c.geom.bounds.left, 100.0)

			row.layout = Layout{...row.layout, distribute: Distribute.Around}
			row.arrange(window(800.0, 600.0))
			assert near(a.geom.bounds.left, 10.0) && near(b.geom.bounds.left, 50.0) && near(c.geom.bounds.left, 90.0)

			row.layout = Layout{...row.layout, distribute: Distribute.Evenly}
			row.arrange(window(800.0, 600.0))
			assert near(a.geom.bounds.left, 15.0) && near(b.geom.bounds.left, 50.0) && near(c.geom.bounds.left, 85.0)

			row.layout = Layout{...row.layout, distribute: Distribute.Packed, reverse: true}
			row.box = Box{...row.box, align: Align{horizontal: Alignment.End}}
			row.arrange(window(800.0, 600.0))
			assert near(c.geom.bounds.left, 60.0) && near(b.geom.bounds.left, 80.0) && near(a.geom.bounds.left, 100.0)
		}

		// `align` places each child across its line; `alignSelf` overrides it for one child;
		// Fill stretches a content-sized child, and a cross-axis `fill` is as large as the
		// container.
		@test()
		def TestCrossAlignment() {
			let a = block(20.0, 10.0)
			let b = block(20.0, 30.0)
			b.alignSelf = Align{vertical: Alignment.End}
			let c = new Node(Box{width: 20(px)})
			c.alignSelf = Align{vertical: Alignment.Fill}
			let d = new Node(Box{width: 20(px), height: fill})
			let row = new Node(Box{height: 100(px), align: Align{vertical: Alignment.Center}}, Layout{arrange: Arrange.Row})
			row.add(a, b, c, d)
			row.arrange(window(800.0, 600.0))
			assert sits(a, 0.0, 45.0, 20.0, 10.0)
			assert sits(b, 20.0, 70.0, 20.0, 30.0)
			assert sits(c, 40.0, 0.0, 20.0, 100.0)
			assert sits(d, 60.0, 0.0, 20.0, 100.0)
		}

		// Baseline lines the children of a Row up on their first text baseline; a child
		// without text stands on it with its bottom edge.
		@test()
		def TestBaseline() {
			let label = words(1)
			let button = new Node(Box{padding: new Edges<Extent>(8(px))})
			button.add(words(1))
			let icon = block(10.0, 10.0)
			let row = new Node(Box{align: Align{vertical: Alignment.Baseline}}, Layout{arrange: Arrange.Row})
			row.add(label, button, icon)
			row.arrange(window(800.0, 600.0))
			// The button's baseline is 8 + 15 from its top, the label's 15.
			assert sits(button, 40.0, 0.0, 56.0, 36.0)
			assert sits(label, 0.0, 8.0, 40.0, 20.0)
			assert sits(icon, 96.0, 13.0, 10.0, 10.0)
			let baseline = button.geom.baseline
			assert !(baseline is none)
			if !(baseline is none) {
				assert near(baseline, 23.0)
			}
			assert icon.geom.baseline is none
		}

		// Fixed, fill and auto tracks; children fill the grid row by row; rows beyond the
		// declared ones are `autoTrack` rows.
		@test()
		def TestGridTracks() {
			let grid = new Node(Box{width: 400(px)}, Layout{arrange: Arrange.Grid, gap: new Axes<Extent>(10(px), 5(px))}, Tracks{columns: Track[100(px), fill, auto]})
			let a = block(30.0, 20.0)
			let b = new Node(Box{width: fill, height: 10(px)})
			let c = block(70.0, 40.0)
			let d = block(30.0, 15.0)
			let e = block(20.0, 15.0)
			e.alignSelf = Align{horizontal: Alignment.End, vertical: Alignment.Center}
			let f = block(50.0, 25.0)
			grid.add(a, b, c, d, e, f)
			grid.arrange(window(800.0, 600.0))
			// Columns: 100, 400 - 100 - 70 - 20 = 210, 70 (the widest auto child).
			assert sits(a, 0.0, 0.0, 30.0, 20.0)
			assert sits(b, 110.0, 0.0, 210.0, 10.0)
			assert sits(c, 330.0, 0.0, 70.0, 40.0)
			assert sits(d, 0.0, 45.0, 30.0, 15.0)
			assert sits(e, 300.0, 50.0, 20.0, 15.0)
			assert sits(f, 330.0, 45.0, 50.0, 25.0)
			assert sits(grid, 0.0, 0.0, 400.0, 70.0)
		}

		// A cell names its column and row from 1; spans cover several tracks and the gaps
		// between them; Fill alignment stretches content-sized children over their cells;
		// `dense` lets later children fill the holes.
		@test()
		def TestGridCells() {
			let grid = new Node(Box{width: 300(px), align: Align{horizontal: Alignment.Fill, vertical: Alignment.Fill}}, Layout{arrange: Arrange.Grid}, Tracks{columns: Track[fill, fill, fill], autoTrack: rowTrack(20.0)})
			let header = new Node()
			header.cell = Cell{column: 1, row: 1, columnSpan: 3}
			let wide = new Node()
			wide.cell = Cell{columnSpan: 2}
			let tall = new Node()
			tall.cell = Cell{rowSpan: 2}
			let big = new Node()
			big.cell = Cell{columnSpan: 2}
			let small = block(10.0, 10.0)
			grid.add(header, wide, tall, big, small)
			grid.arrange(window(800.0, 600.0))
			assert sits(header, 0.0, 0.0, 300.0, 20.0)
			assert sits(wide, 0.0, 20.0, 200.0, 20.0)
			assert sits(tall, 200.0, 20.0, 100.0, 40.0)
			assert sits(big, 0.0, 40.0, 200.0, 20.0)
			// Without dense the cursor has moved past the row with the hole: none here, so
			// the small one starts row 4.
			assert sits(small, 0.0, 60.0, 10.0, 10.0)

			let holes = new Node(Box{width: 300(px)}, Layout{arrange: Arrange.Grid}, Tracks{columns: Track[fill, fill, fill], autoTrack: rowTrack(20.0)})
			let one = block(10.0, 10.0)
			let three = new Node(Box{width: fill, height: 10(px)})
			three.cell = Cell{columnSpan: 3}
			let last = block(10.0, 10.0)
			holes.add(one, three, last)
			holes.arrange(window(800.0, 600.0))
			assert sits(last, 0.0, 40.0, 10.0, 10.0)
			holes.tracks = Tracks{...holes.tracks, dense: true}
			holes.arrange(window(800.0, 600.0))
			assert sits(last, 100.0, 0.0, 10.0, 10.0)
		}

		// `TrackFit` makes as many equal columns as fit.
		@test()
		def TestGridFit() {
			let grid = new Node(Box{width: fill}, Layout{arrange: Arrange.Grid}, Tracks{columns: TrackFit{min: 240(px)}})
			let cards = Node[]
			for let i = 0; i < 6; i++ {
				let card = new Node(Box{width: fill, height: 50(px)})
				cards.push(card)
				grid.add(card)
			}
			grid.arrange(window(1000.0, 600.0))
			assert sits(cards[3], 750.0, 0.0, 250.0, 50.0)
			assert sits(cards[4], 0.0, 50.0, 250.0, 50.0)
			grid.arrange(window(300.0, 600.0))
			assert sits(cards[1], 0.0, 50.0, 300.0, 50.0)

			// Fewer children than columns: stretched over the width, unless `keep`.
			let few = new Node(Box{width: fill}, Layout{arrange: Arrange.Grid}, Tracks{columns: TrackFit{min: 240(px)}})
			let left = new Node(Box{width: fill, height: 50(px)})
			let right = new Node(Box{width: fill, height: 50(px)})
			few.add(left, right)
			few.arrange(window(1000.0, 600.0))
			assert sits(right, 500.0, 0.0, 500.0, 50.0)
			few.tracks = Tracks{columns: TrackFit{min: 240(px), keep: true}}
			few.arrange(window(1000.0, 600.0))
			assert sits(right, 250.0, 0.0, 250.0, 50.0)
		}

		// Layered children each get the whole content box.
		@test()
		def TestLayered() {
			let back = new Node(Box{width: fill, height: fill})
			let badge = block(10.0, 10.0)
			badge.alignSelf = Align{horizontal: Alignment.End, vertical: Alignment.Start}
			let stack = new Node(Box{width: 100(px), height: 60(px), align: Align{horizontal: Alignment.Center, vertical: Alignment.Center}}, Layout{arrange: Arrange.Layered})
			let centred = block(20.0, 20.0)
			stack.add(back, centred, badge)
			stack.arrange(window(800.0, 600.0))
			assert sits(back, 0.0, 0.0, 100.0, 60.0)
			assert sits(centred, 40.0, 20.0, 20.0, 20.0)
			assert sits(badge, 90.0, 0.0, 10.0, 10.0)
		}

		// Relative is placed against the parent's padding box, Absolute against the
		// window, both out of the flow. Opposite anchors stretch; a centre anchor is the
		// offset of the centres; margin applies on top.
		@test()
		def TestAnchors() {
			let parent = new Node(Box{width: 200(px), height: 100(px), padding: new Edges<Extent>(10(px)), margin: new Edges<Extent>(50(px))})
			let flow = block(40.0, 20.0)
			let corner = block(30.0, 10.0)
			corner.box = Box{...corner.box, position: Position.Relative, anchors: Anchors{bottom: 10(px), right: 5(px)}}
			let across = new Node(Box{height: 4(px), position: Position.Relative, anchors: Anchors{left: 0(px), right: 0(px), top: 0(px)}, margin: new Edges<Extent>(2(px))})
			let centre = block(20.0, 20.0)
			centre.box = Box{...centre.box, position: Position.Relative, anchors: Anchors{centerX: 0(px), centerY: 10(px)}}
			let plain = block(8.0, 8.0)
			plain.box = Box{...plain.box, position: Position.Relative}
			let overlay = block(60.0, 30.0)
			overlay.box = Box{...overlay.box, position: Position.Absolute, anchors: Anchors{right: 20(px), top: 5(%)}}
			parent.add(flow, corner, across, centre, plain, overlay)
			parent.arrange(window(800.0, 600.0))
			assert framed(parent, 50.0, 50.0)
			assert sits(flow, 0.0, 0.0, 40.0, 20.0)
			assert framed(corner, 50.0 + 200.0 - 5.0 - 30.0, 50.0 + 100.0 - 10.0 - 10.0)
			// Bounds are in the parent's content box, which starts 10 inside the padding box.
			assert sits(corner, 155.0, 70.0, 30.0, 10.0)
			assert framed(across, 52.0, 52.0)
			assert near(across.geom.bounds.width, 196.0)
			assert framed(centre, 50.0 + 90.0, 50.0 + 40.0 + 10.0)
			assert framed(plain, 50.0, 50.0)
			assert framed(overlay, 800.0 - 20.0 - 60.0, 30.0)
		}

		// A named line is an edge of another component, wherever layout put it.
		@test()
		def TestNamedLines() {
			let help = block(60.0, 24.0)
			let trigger = new Trigger()
			help.owner = trigger
			let row = new Node(Box{}, Layout{arrange: Arrange.Row, gap: gap(8.0)})
			row.add(block(100.0, 24.0), help)
			let below = new AnchorLine(trigger, AnchorEdge.Bottom)
			below.offset = 4(px)
			let popover = block(120.0, 40.0)
			popover.box = Box{...popover.box, position: Position.Relative, layer: Layer.Popup, anchors: Anchors{top: below, left: new AnchorLine(trigger, AnchorEdge.Left)}}
			let page = new Node(Box{width: fill, height: fill, padding: new Edges<Extent>(20(px))})
			page.add(block(10.0, 50.0), row, popover)
			let warnings = page.arrange(window(800.0, 600.0))
			assert warnings.len() == 0
			assert framed(help, 128.0, 70.0)
			assert framed(popover, 128.0, 98.0)

			// An edge without a component is that edge of the box the node is placed against.
			let line = new AnchorLine(none, AnchorEdge.Bottom)
			popover.box = Box{...popover.box, anchors: Anchors{bottom: line}}
			page.arrange(window(800.0, 600.0))
			assert framed(popover, 0.0, 560.0)

			// Lines that wait for each other: placed by distance, and reported.
			popover.owner = trigger
			popover.box = Box{...popover.box, anchors: Anchors{top: below}}
			help.owner = none
			let stuck = page.arrange(window(800.0, 600.0))
			assert stuck.len() == 1
			assert framed(popover, 0.0, 4.0)
		}

		// A Sticky node is laid out in the flow and held at the edge of the scrolling
		// ancestor once scrolled past it.
		@test()
		def TestSticky() {
			let header = block(100.0, 20.0)
			header.box = Box{...header.box, position: Position.Sticky}
			let footer = block(100.0, 20.0)
			footer.box = Box{...footer.box, position: Position.Sticky, anchors: Anchors{bottom: 5(px)}}
			let scroller = new Node(Box{width: 100(px), height: 100(px)})
			scroller.scroll = new Point<Pixels>(0(px), 0(px))
			scroller.add(block(100.0, 30.0), header, block(100.0, 300.0), footer)
			scroller.arrange(window(800.0, 600.0))
			assert framed(header, 0.0, 30.0)
			assert framed(footer, 0.0, 75.0)
			scroller.scroll = new Point<Pixels>(0(px), 200(px))
			scroller.arrange(window(800.0, 600.0))
			assert framed(header, 0.0, 0.0)
			assert sits(header, 0.0, 200.0, 100.0, 20.0)
			assert framed(footer, 0.0, 75.0)
			scroller.scroll = new Point<Pixels>(0(px), 290(px))
			scroller.arrange(window(800.0, 600.0))
			assert framed(footer, 0.0, 60.0)
		}

		// Not visible: no space, no geometry, for the node and what is under it.
		@test()
		def TestVisible() {
			let hidden = block(50.0, 50.0)
			let inside = block(5.0, 5.0)
			hidden.add(inside)
			let after = block(10.0, 10.0)
			let column = new Node()
			column.add(block(10.0, 10.0), hidden, after)
			column.arrange(window(800.0, 600.0))
			assert sits(inside, 0.0, 0.0, 5.0, 5.0)
			hidden.box = Box{...hidden.box, visible: false}
			column.arrange(window(800.0, 600.0))
			assert sits(after, 0.0, 10.0, 10.0, 10.0)
			assert sits(hidden, 0.0, 0.0, 0.0, 0.0)
			assert sits(inside, 0.0, 0.0, 0.0, 0.0)
			assert sits(column, 0.0, 0.0, 10.0, 20.0)
		}

		// RightToLeft: a row runs right to left, Start is the right side, left and right
		// swap in margin, padding and anchors. A subtree that sets LeftToRight is not
		// mirrored inside.
		@test()
		def TestRightToLeft() {
			let a = block(30.0, 10.0)
			a.box = Box{...a.box, margin: new Edges<Extent>(0(px), 0(px), 0(px), 7(px))}
			let b = block(50.0, 10.0)
			let row = new Node(Box{width: 200(px), padding: new Edges<Extent>(0(px), 0(px), 0(px), 20(px))}, Layout{arrange: Arrange.Row})
			let pinned = block(10.0, 10.0)
			pinned.box = Box{...pinned.box, position: Position.Relative, anchors: Anchors{left: 4(px)}}
			row.add(a, b, pinned)
			row.arrange(window(800.0, 600.0), Direction.RightToLeft)
			// The row itself starts at the window's right edge.
			assert framed(row, 600.0, 0.0)
			// Padding "left" is on the right: the content box is the left 180.
			assert near(row.geom.content.left, 0.0) && near(row.geom.content.right, 180.0)
			assert sits(a, 180.0 - 7.0 - 30.0, 0.0, 30.0, 10.0)
			assert sits(b, 180.0 - 37.0 - 50.0, 0.0, 50.0, 10.0)
			assert framed(pinned, 800.0 - 4.0 - 10.0, 0.0)

			let editor = new Node(Box{width: 100(px), direction: Direction.LeftToRight}, Layout{arrange: Arrange.Row})
			let first = block(10.0, 10.0)
			editor.add(first, block(10.0, 10.0))
			let page = new Node(Box{width: 300(px)})
			page.add(editor)
			page.arrange(window(800.0, 600.0), Direction.RightToLeft)
			assert sits(editor, 200.0, 0.0, 100.0, 10.0)
			assert sits(first, 0.0, 0.0, 10.0, 10.0)
		}

		// Every unit of `Extent` resolves: viewport shares against the window, `em` against
		// the inherited font size, lengths at 96 pixels per inch.
		@test()
		def TestUnits() {
			let a = new Node(Box{width: 50(vw), height: 10(vh)})
			let b = new Node(Box{width: 2(em), height: 1(em)})
			let c = new Node(Box{width: 2.54(cm), height: 1(em)})
			c.fontSize = 10(px)
			let column = new Node()
			column.add(a, b, c)
			column.arrange(window(800.0, 600.0), Direction.LeftToRight, 20(px))
			assert sits(a, 0.0, 0.0, 400.0, 60.0)
			assert sits(b, 0.0, 60.0, 40.0, 20.0)
			assert sits(c, 0.0, 80.0, 96.0, 10.0)
		}

		// A scrolling container lays its content out at its natural size on the axes it
		// scrolls, moves it by `scroll`, and gives up the room of the scrollbars it needs.
		@test()
		def TestScrolling() {
			// Without scrolling the text wraps into the row; scrolling sideways it keeps
			// its one line.
			let line = words(4)
			let strip = new Node(Box{width: 100(px), height: 60(px)}, Layout{arrange: Arrange.Row})
			strip.add(line)
			strip.arrange(window(800.0, 600.0))
			assert near(line.geom.bounds.width, 100.0)
			strip.scroll = new Point<Pixels>(30(px), 0(px))
			strip.scrollAxes = new Axes<bool>(true, false)
			strip.arrange(window(800.0, 600.0))
			assert sits(line, 0.0, 0.0, 160.0, 20.0) && framed(line, -30.0, 0.0)
			assert strip.extentW == 160.0 && strip.extentH == 60.0

			// Three blocks in a shorter box: the vertical bar takes 12 from the width.
			let wide = new Node(Box{width: fill, height: 80(px)})
			let list = new Node(Box{width: 100(px), height: 100(px)})
			list.scroll = new Point<Pixels>(0(px), 50(px))
			list.scrollbar = 12.0
			list.add(wide, block(40.0, 80.0), block(40.0, 80.0))
			list.arrange(window(800.0, 600.0))
			assert sits(wide, 0.0, 0.0, 88.0, 80.0) && framed(wide, 0.0, -50.0)
			assert list.extentH == 240.0 && list.extentW == 88.0 && near(list.geom.content.right, 88.0)

			// Content that fits: no bar room unless it is kept; a `fill` child takes what
			// the box has left.
			let rest = new Node(Box{width: fill, height: fill})
			let short = new Node(Box{width: 100(px), height: 100(px)})
			short.scroll = new Point<Pixels>(0(px), 0(px))
			short.scrollbar = 12.0
			short.add(block(40.0, 30.0), rest)
			short.arrange(window(800.0, 600.0))
			assert sits(rest, 0.0, 30.0, 100.0, 70.0) && short.extentH == 100.0
			short.scrollbarKept = true
			short.arrange(window(800.0, 600.0))
			assert sits(rest, 0.0, 30.0, 88.0, 70.0)

			// Both axes: the horizontal bar leaves too little height, so the vertical one
			// comes too.
			let sheet = new Node(Box{width: 100(px), height: 100(px)})
			sheet.scroll = new Point<Pixels>(0(px), 0(px))
			sheet.scrollAxes = new Axes<bool>(true, true)
			sheet.scrollbar = 10.0
			sheet.add(block(150.0, 95.0))
			sheet.arrange(window(800.0, 600.0))
			assert near(sheet.geom.content.right, 90.0) && near(sheet.geom.content.bottom, 90.0)
			assert sheet.extentW == 150.0 && sheet.extentH == 95.0

			// Right to left the content starts at the right edge and scrolling brings in
			// what is further left.
			let first = block(100.0, 20.0)
			let second = block(100.0, 20.0)
			let reel = new Node(Box{width: 100(px), height: 20(px), direction: Direction.RightToLeft}, Layout{arrange: Arrange.Row})
			reel.scroll = new Point<Pixels>(0(px), 0(px))
			reel.scrollAxes = new Axes<bool>(true, false)
			reel.add(first, second)
			reel.arrange(window(800.0, 600.0))
			assert framed(reel, 700.0, 0.0) && framed(first, 700.0, 0.0) && framed(second, 600.0, 0.0)
			reel.scroll = new Point<Pixels>(100(px), 0(px))
			reel.arrange(window(800.0, 600.0))
			assert framed(first, 800.0, 0.0) && framed(second, 700.0, 0.0)
		}

		// One pass over 10,251 nodes.
		@benchmark()
		def ArrangeLargePage() {
			benchPage = cardPage(250) when benchPage is none
			let page = benchPage
			return when page is none
			page.arrange(window(1920.0, 1080.0))
		}

		// The settings panel of docs/requirements/ui/in-use.md: pinned to the window's end
		// side, a column of fields, a row of buttons, and a popover hanging under the
		// Help button by named lines.
		@test()
		def TestSettingsPanel() {
			let trigger = new Trigger()
			let name = new Node(Box{width: fill, height: 32(px)})
			let email = new Node(Box{width: fill, height: 32(px)})
			let help = button()
			help.owner = trigger
			let save = button()
			let buttons = new Node(Box{}, Layout{arrange: Arrange.Row, gap: gap(8.0)})
			buttons.add(help, save)

			let under = new AnchorLine(trigger, AnchorEdge.Bottom)
			under.offset = 4(px)
			let popover = new Node(Box{
				padding:  new Edges<Extent>(8(px)),
				position: Position.Relative,
				layer:    Layer.Popup,
				anchors:  Anchors{top: under, left: new AnchorLine(trigger, AnchorEdge.Left)},
			})
			popover.add(words(4))

			let panel = new Node(Box{
				width:    320(px),
				height:   fill,
				padding:  new Edges<Extent>(16(px)),
				position: Position.Relative,
				anchors:  Anchors{top: 0(px), right: 0(px), bottom: 0(px)},
				layer:    Layer.Floating,
			}, Layout{gap: gap(8.0)})
			panel.add(name, email, buttons, popover)

			let page = new Node(Box{width: fill, height: fill})
			page.add(panel)

			assert page.arrange(window(1280.0, 800.0)).len() == 0
			assert framed(panel, 960.0, 0.0) && near(panel.geom.frame.bottom, 800.0)
			assert framed(name, 976.0, 16.0) && near(name.geom.bounds.width, 288.0)
			assert framed(email, 976.0, 56.0)
			assert framed(help, 976.0, 96.0) && sits(help, 0.0, 0.0, 56.0, 36.0)
			assert framed(save, 1040.0, 96.0)
			assert framed(popover, 976.0, 136.0) && near(popover.geom.bounds.width, 176.0)

			// The same tree in a right-to-left window: the panel pins to the left edge, the
			// row runs right to left, and the popover's left is the Help button's right side.
			page.arrange(window(1280.0, 800.0), Direction.RightToLeft)
			assert framed(panel, 0.0, 0.0)
			assert framed(name, 16.0, 16.0)
			assert framed(help, 248.0, 96.0)
			assert framed(save, 184.0, 96.0)
			assert framed(popover, 128.0, 136.0)
		}
	}
}
