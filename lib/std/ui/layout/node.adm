// The layout engine: sizes and places a tree of nodes from their `Box`, `Layout` and `Tracks`
// values and fills each node's `Geometry`.
internal partial module std.ui.layout {
	use (
		std.math.geom::(Axes, Edges, Point, Size)
		std.ui::(Geometry, Limit, StyleRule, Theme)
		std.ui.paint::Decoration
		std.ui.styles::*
		std.units::Pixels
	)

	// One box of the tree layout works on: a component's resolved style values going in, its
	// `geom` coming out of `arrange`.
	type Node {
		// Size, limits, spacing, placement, visibility and content alignment.
		box           Box            = Box{}
		// How the children are arranged.
		layout        Layout         = Layout{}
		// The columns and rows, read when `layout.arrange` is Grid.
		tracks        Tracks         = Tracks{}
		// The grid cell, read when the parent is a Grid.
		cell          Cell           = Cell{}
		// Where it sits in the slot its parent gives it, when that differs from the parent's
		// `align`. A Row or Column reads only the cross-axis half.
		alignSelf     ?Align         = none
		// The border widths: space between the box's edge and its padding.
		border        Edges<Pixels>  = new Edges<Pixels>(0(px))
		// What `1(em)` is for this node and below; none takes the parent's.
		fontSize      ?Pixels        = none
		// For a leaf with text: the distance from the top of its content to the first
		// baseline. A container's baseline is that of its first child that has one.
		baseline      ?Pixels        = none
		// Set on a scrolling container: how far its content is scrolled from its start
		// corner. Sticky descendants hold against its padding box.
		scroll        ?Point<Pixels> = none
		// The axes a scrolling container scrolls on: there its content is laid out at its
		// natural size, however small the box.
		scrollAxes    Axes<bool>     = new Axes<bool>(false, true)
		// The room a scrollbar takes from the content box of a scrolling container, at the
		// end side for the vertical bar and at the bottom for the horizontal one; 0: none.
		// It is taken on an axis whose content is longer than the box, and with
		// `scrollbarKept` on every axis that scrolls.
		scrollbar     float
		scrollbarKept bool
		// The component this node belongs to: what a named anchor line's `target` is matched
		// with.
		owner         ?component     = none
		// What it is painted with; none draws only its children. The decoration is told
		// whose it is, so that a change to what it draws outside the border box reaches the
		// node (`reachChanged`).
		decoration ?Decoration {
			value ?Decoration = none

			def get() ?Decoration {
				return value
			}

			def set(look ?Decoration) {
				let held = value
				return when !(held is none) && !(look is none) && held == look
				held.attach(none) unless held is none
				value = look
				look.attach(self) unless look is none
				reachChanged()
			}
		}
		// For `std.ui.paint`: the box, in device pixels, that the node and what is under it
		// in its layer drew in the drawing of the whole window numbered `inkOf`, and the
		// number of the last drawing of a part of the window that could not leave it out.
		inkLeft, inkTop, inkRight, inkBottom float
		inkOf                                int
		wantedIn                             int
		// For the view runtime: where its motion is kept (-1: not looked for yet, -2: its
		// style has none), whether it
		// is going (drawn until its exit ends, there for nothing else), and whether its
		// view dropped it: out of the tree for good, its `parent` kept so that what was
		// above it can still be reached from it.
		motionSlot                           int                    = -1
		exiting                              bool
		dropped                              bool
		// For the view runtime: what answers for its component's states by name, made
		// the first time its style's `on` is read.
		stateOf                              ?def(name string) bool = none
		// For the view runtime: the rules of the style sheets around its component that
		// can be for it (`StyleRule.fits`), the less precise first, and what they were
		// found for: the sheets as `rulesOf` numbers them, and the component's role.
		rules                                StyleRule[]            = []
		rulesOf                              int                    = -1
		rulesRole                            int                    = -1
		// For the view runtime: the look last made of its component's style, a copy
		// with what rules and states gave it, and what it was made of: the style's count
		// of assignments, the built-in states held, the component's own states
		// (`statesNow`), which of `rules` applied, and the sheets (as `rulesOf`).
		kept                                 ?style                 = none
		keptVersion, keptHeld, keptStates    int
		keptRules, keptOf                    int
		// For the view runtime: a number for the component's `@state` values as they are
		// now, made with `stateOf`.
		statesNow                            ?def() int             = none
		// For the view runtime: the theme its component's style last took what its body
		// assigns from one; none: `UI.theme()`, which a style reads when it is made.
		theme                                ?Theme                 = none
		// For the view runtime: what its style was copied in from last (`restyle`): the
		// style's count of assignments once in step, the look copied and its count, the
		// `em` above and the one it gave, and the look its children inherited from. A
		// node whose look and what it inherits are as they were is not copied again.
		syncedVersion                        int                    = -1
		syncedLook                           ?style                 = none
		syncedLookVersion                    int                    = -1
		syncedEm, syncedEmOut                float
		syncedShown                          ?style                 = none
		// For the view runtime: the theme the component above read when the node was
		// brought in step last, and whether what is copied into the node can change
		// with no mark on its component (`Component.isStale`), so the node is brought in
		// step on every pass (`syncTree`).
		syncedAbove                          ?Theme                 = none
		live                                 bool                   = true
		// For the view runtime: whether it or a node under it is live, as the last pass
		// over each left it: a subtree with none and nothing marked is passed over whole.
		liveBelow                            bool                   = true
		// For the view runtime: whether its style's `bound` body read another component
		// when it last ran (`$parent`, a ref), which no mark of its own component follows.
		readsOthers                          bool                   = true

		// For a node without children: the size of its content within the limit it is given.
		// Called several times per pass with different limits, so it must depend on nothing
		// but its argument and the node.
		measure ?(def(Limit) Size<Pixels>) = none

		children    Node[]
		weak parent ?Node

		// Where `arrange` put it. Left at zero for a node that is not visible.
		geom         Geometry    = Geometry{}
		// What the last pass read of it (`noteInputs`): its numbers, the components its
		// anchors named, its children, how far
		// it was scrolled, and the leaf sizes it measured (six numbers a measure: whether a
		// width was set, the width, the same for the height, then the size) in the pass
		// numbered `measuredOf`. On the root: how many passes ran, the number, window and
		// warnings of the last whole one.
		inputs       float[]
		// Whether the box was copied from a style again since the last pass; false only
		// when whoever fills the node says it was not (the view runtime). Kept with it:
		// how many of `inputs` the box gave (`noteBox`), and the `em`, direction and window
		// that pass resolved the box with. A box not copied again, resolved under the same,
		// resolves to what it did.
		restyled     bool        = true
		boxNotes     int         = -1
		resolvedEm   float
		resolvedRtl  bool
		resolvedW    float
		resolvedH    float
		laidTargets  component[]
		laid         Node[]
		laidScrolled bool
		laidScrollX  float
		laidScrollY  float
		measured     float[]
		measuredOf   int
		passes       int
		laidSerial   int
		laidWindow   float[]
		laidWarnings string[]
		// Whoever fills the tree says what changed (`layoutChanged`): set on the root, a
		// pass reads only the nodes marked and, when they read as before, lays nothing
		// out. A tree without it is read whole on every pass. Set by the view runtime.
		tracked      bool
		// What `layoutChanged` marked: the node, and some node under it. Cleared by the
		// pass that reads them.
		layoutDirty  bool        = true
		layoutBelow  bool
		// On the root: whether the last `arrange` only moved what scrolled containers
		// hold; the nodes anchors place that the last whole pass found, and its number,
		// for a pass that only scrolls.
		shifted      bool
		relaidParts  bool
		anchoredKept Node[]
		anchoredOf   int         = -1
		// On the root: the visible nodes of a component the last whole pass found, which
		// named anchor lines are matched with.
		ownedKept    Node[]
		// For a scrolling container: whether what it holds has a Sticky node, as of the
		// whole pass numbered `stickyOf`.
		holdsSticky  bool
		stickyOf     int         = -1
		// On the root: whether `ownedKept` is the one the last layout left (a pass that
		// laid out only parts of the tree did not look at the rest).
		ownedFresh   bool
		// The references its last placement resolved percents against, and how many sizes
		// its parent asked of it in the last pass that laid it out (more than its `cache`
		// holds: what it answered can no longer be asked again): what a pass that lays out
		// only a part of the tree reads (`relayoutParts`).
		placedRefW   float
		placedRefH   float
		cacheAsked   int
		// Its border box in the window when `moved` was last asked.
		wasLeft      float
		wasTop       float
		wasRight     float
		wasBottom    float

		// For a scrolling container: the size its content was laid out in, the content box
		// or larger.
		extentW float
		extentH float

		// For `std.ui.paint`: the box that the node and the nodes under it can reach
		// (`subtreeReach`), in logical pixels from the top-left of its border box on device
		// pixels, before its own transform; kept from one drawing to the next while
		// `reachKept`, which layout and the decoration clear through `reachChanged` when
		// something under the node changed. Made at scale `reachScale` for a window
		// `reachWide` by `reachHigh`, with the border box at (`reachX`, `reachY`) in the
		// window; it stands there and, a device pixel larger, a whole number of device
		// pixels away, unless `reachPinned`: it holds a text or a turned box, whose reach
		// depends on where they are, so it stands only where it was made.
		reachLeft, reachTop, reachRight, reachBottom float
		reachX, reachY                               float
		reachScale, reachWide, reachHigh             float
		reachKept                                    bool
		reachPinned                                  bool

		// Scratch of the pass in progress. Sizes are border-box pixels; `x`/`y` run from the
		// start corner of the parent's content box (the right one under RightToLeft).
		rtl             bool
		em              float
		items           Node[]
		autoWidth       bool
		autoHeight      bool
		pinWidth        bool
		pinHeight       bool
		measuredW       float
		measuredH       float
		width           float
		height          float
		x               float
		y               float
		// The style's sizes with everything but percents resolved: a size is `abs` pixels
		// plus `pct` percent of its reference.
		widthAuto       bool
		widthFill       float
		widthAbs        float
		widthPct        float
		heightAuto      bool
		heightFill      float
		heightAbs       float
		heightPct       float
		minWidthSet     bool
		minWidthAbs     float
		minWidthPct     float
		maxWidthSet     bool
		maxWidthAbs     float
		maxWidthPct     float
		minHeightSet    bool
		minHeightAbs    float
		minHeightPct    float
		maxHeightSet    bool
		maxHeightAbs    float
		maxHeightPct    float
		insetLeftAbs    float
		insetLeftPct    float
		insetRightAbs   float
		insetRightPct   float
		insetTopAbs     float
		insetTopPct     float
		insetBottomAbs  float
		insetBottomPct  float
		marginLeftAbs   float
		marginLeftPct   float
		marginRightAbs  float
		marginRightPct  float
		marginTopAbs    float
		marginTopPct    float
		marginBottomAbs float
		marginBottomPct float
		gapWidthAbs     float
		gapWidthPct     float
		gapHeightAbs    float
		gapHeightPct    float

		// Margins in the parent's start-relative space, and the node's own insets (border
		// plus padding).
		marginStart   float
		marginEnd     float
		marginTop     float
		marginBottom  float
		marginRef     float
		marginSet     bool
		insetStart    float
		insetEnd      float
		insetTop      float
		insetBottom   float
		// What a container keeps per child while it sizes a line or a grid.
		base          float
		cross         float
		least         float
		weight        float
		frozen        bool
		resized       bool
		stretch       bool
		lineEnd       int
		lineCross     float
		lineUsed      float
		lineAscent    float
		column        int
		row           int
		columnSpan    int
		rowSpan       int
		// Distance from the top of the border box to the first baseline; unset without text.
		firstBaseline float
		// Whether its frame is final on each axis, for anchors that name its lines.
		placedX       bool
		placedY       bool
		settled       bool
		// Results of sizing in this pass, eight numbers each: the six constraints, then
		// width and height.
		cache         float[]
		cacheNext     int
		// The geometry whose lines name `linedTo` as their target: written when the node
		// gets another geometry or owner, not on every pass (a weak store takes a lock).
		lined         ?Geometry
		linedTo       ?component

		def new(box Box = Box{}, layout Layout = Layout{}, tracks Tracks = Tracks{}) {
			self.box = box
			self.layout = layout
			self.tracks = tracks
		}

		// Appends `nodes` as children and returns this node.
		def add(nodes ...Node) Node {
			for let node in nodes {
				node.parent = self
				children.push(node)
			}
			return self
		}

		// Lays out the tree under this node in a window of that size and fills every visible
		// node's `geom`. `direction` and `fontSize` are what the window gives nodes that set
		// none. Returns one line per anchor that could not follow its named line because the
		// lines form a cycle; such an anchor falls back to its distance from the reference box.
		def arrange(window Size<Pixels>, direction Direction = Direction.LeftToRight, fontSize Pixels = 16(px)) string[] {
			let pass = new Pass(float(window.width), float(window.height))
			run(pass, self, direction, float(fontSize))
			return pass.warnings
		}

		// Notes that what layout reads of this node may have changed (its box, its
		// children, what it measures), for a tree whose root is `tracked`: the next pass
		// reads it again, and lays the tree out when anything reads otherwise.
		def layoutChanged() {
			layoutDirty = true
			let above = parent
			for {
				return when above is none || above.layoutBelow
				above.layoutBelow = true
				above = above.parent
			}
		}

		// Notes that what this node or the nodes under it can reach may have changed: the
		// reach kept of it and of every node above (`reachKept`) is made again when paint
		// next reads it. Stops at a node whose reach is not kept: none above it is, since a
		// node's reach is kept only after those under it.
		def reachChanged() {
			let node = self
			for {
				return unless node.reachKept
				node.reachKept = false
				let above = node.parent
				return when above is none
				node = above
			}
		}

		// Whether this node or one under it is somewhere else in the window than when this
		// was last asked. A style that reads another component's `geom` read what the layout
		// before gave, so it needs one more layout after one that moved something.
		def moved() bool {
			let frame = geom.frame
			let left = float(frame.left)
			let top = float(frame.top)
			let right = float(frame.right)
			let bottom = float(frame.bottom)
			let changed = left != wasLeft || top != wasTop || right != wasRight || bottom != wasBottom
			wasLeft = left
			wasTop = top
			wasRight = right
			wasBottom = bottom
			for let child in children {
				// Every node notes where it is, also once one has moved.
				let under = child.moved()
				changed = changed || under
			}
			return changed
		}
	}
}
