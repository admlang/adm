// The layout engine: sizes and places a tree of nodes from their `Box`, `Layout` and `Tracks`
// values and fills each node's `Geometry`. The rules are those of
// docs/requirements/ui/styles/box.md and layout.md.
internal partial module std.ui.layout {
	use (
		std.math.geom::(Axes, Edges, Point, Size)
		std.ui::(Geometry, Limit)
		std.ui.paint::Decoration
		std.ui.styles::*
		std.units::Pixels
	)

	// One box of the tree layout works on: a component's resolved style values going in, its
	// `geom` coming out of `arrange`.
	type Node {
		// Size, limits, spacing, placement, visibility and content alignment.
		box                                  Box                    = Box{}
		// How the children are arranged.
		layout                               Layout                 = Layout{}
		// The columns and rows, read when `layout.arrange` is Grid.
		tracks                               Tracks                 = Tracks{}
		// The grid cell, read when the parent is a Grid.
		cell                                 Cell                   = Cell{}
		// Where it sits in the slot its parent gives it, when that differs from the parent's
		// `align`. A Row or Column reads only the cross-axis half.
		alignSelf                            ?Align                 = none
		// The border widths: space between the box's edge and its padding.
		border                               Edges<Pixels>          = new Edges<Pixels>(0(px))
		// What `1(em)` is for this node and below; none takes the parent's.
		fontSize                             ?Pixels                = none
		// For a leaf with text: the distance from the top of its content to the first
		// baseline. A container's baseline is that of its first child that has one.
		baseline                             ?Pixels                = none
		// Set on a scrolling container: how far its content is scrolled from its start
		// corner. Sticky descendants hold against its padding box.
		scroll                               ?Point<Pixels>         = none
		// The axes a scrolling container scrolls on: there its content is laid out at its
		// natural size, however small the box.
		scrollAxes                           Axes<bool>             = new Axes<bool>(false, true)
		// The room a scrollbar takes from the content box of a scrolling container, at the
		// end side for the vertical bar and at the bottom for the horizontal one; 0: none.
		// It is taken on an axis whose content is longer than the box, and with
		// `scrollbarKept` on every axis that scrolls.
		scrollbar                            float
		scrollbarKept                        bool
		// The component this node belongs to: what a named anchor line's `target` is matched
		// with.
		owner                                ?component             = none
		// What it is painted with; none draws only its children.
		decoration                           ?Decoration            = none
		// For `std.ui.paint`: the box, in device pixels, that the node and what is under it
		// in its layer drew in the drawing of the whole window numbered `inkOf`, and the
		// number of the last drawing of a part of the window that could not leave it out.
		inkLeft, inkTop, inkRight, inkBottom float
		inkOf                                int
		wantedIn                             int
		// For the view runtime: where its motion is kept (-1: not looked for yet, -2: its
		// style has none), and whether it
		// is going (drawn until its exit ends, there for nothing else).
		motionSlot                           int                    = -1
		exiting                              bool
		// For the view runtime: what answers for its component's states by name, made
		// the first time its style's `on` is read.
		stateOf                              ?def(name string) bool = none

		// For a node without children: the size of its content within the limit it is given.
		// Called several times per pass with different limits, so it must depend on nothing
		// but its argument and the node.
		measure ?(def(Limit) Size<Pixels>) = none

		children    Node[]
		weak parent ?Node

		// Where `arrange` put it. Left at zero for a node that is not visible.
		geom      Geometry = Geometry{}
		// Its border box in the window when `moved` was last asked.
		wasLeft   float
		wasTop    float
		wasRight  float
		wasBottom float

		// For a scrolling container: the size its content was laid out in, the content box
		// or larger.
		extentW float
		extentH float

		// Scratch of the pass in progress. Sizes are border-box pixels; `x`/`y` run from the
		// start corner of the parent's content box (the right one under RightToLeft).
		rtl             bool
		em              float
		items           Node[]
		autoWidth       bool
		autoHeight      bool
		pinWidth        bool
		pinHeight       bool
		measuredW       float
		measuredH       float
		width           float
		height          float
		x               float
		y               float
		// The style's sizes with everything but percents resolved: a size is `abs` pixels
		// plus `pct` percent of its reference.
		widthAuto       bool
		widthFill       float
		widthAbs        float
		widthPct        float
		heightAuto      bool
		heightFill      float
		heightAbs       float
		heightPct       float
		minWidthSet     bool
		minWidthAbs     float
		minWidthPct     float
		maxWidthSet     bool
		maxWidthAbs     float
		maxWidthPct     float
		minHeightSet    bool
		minHeightAbs    float
		minHeightPct    float
		maxHeightSet    bool
		maxHeightAbs    float
		maxHeightPct    float
		insetLeftAbs    float
		insetLeftPct    float
		insetRightAbs   float
		insetRightPct   float
		insetTopAbs     float
		insetTopPct     float
		insetBottomAbs  float
		insetBottomPct  float
		marginLeftAbs   float
		marginLeftPct   float
		marginRightAbs  float
		marginRightPct  float
		marginTopAbs    float
		marginTopPct    float
		marginBottomAbs float
		marginBottomPct float
		gapWidthAbs     float
		gapWidthPct     float
		gapHeightAbs    float
		gapHeightPct    float

		// Margins in the parent's start-relative space, and the node's own insets (border
		// plus padding).
		marginStart   float
		marginEnd     float
		marginTop     float
		marginBottom  float
		marginRef     float
		marginSet     bool
		insetStart    float
		insetEnd      float
		insetTop      float
		insetBottom   float
		// What a container keeps per child while it sizes a line or a grid.
		base          float
		cross         float
		least         float
		weight        float
		frozen        bool
		resized       bool
		stretch       bool
		lineEnd       int
		lineCross     float
		lineUsed      float
		lineAscent    float
		column        int
		row           int
		columnSpan    int
		rowSpan       int
		// Distance from the top of the border box to the first baseline; unset without text.
		firstBaseline float
		// Whether its frame is final on each axis, for anchors that name its lines.
		placedX       bool
		placedY       bool
		settled       bool
		// Results of sizing in this pass, eight numbers each: the six constraints, then
		// width and height.
		cache         float[]
		cacheNext     int

		def new(box Box = Box{}, layout Layout = Layout{}, tracks Tracks = Tracks{}) {
			self.box = box
			self.layout = layout
			self.tracks = tracks
		}

		// Appends `nodes` as children and returns this node.
		def add(nodes ...Node) Node {
			for let node in nodes {
				node.parent = self
				children.push(node)
			}
			return self
		}

		// Lays out the tree under this node in a window of that size and fills every visible
		// node's `geom`. `direction` and `fontSize` are what the window gives nodes that set
		// none. Returns one line per anchor that could not follow its named line because the
		// lines form a cycle; such an anchor falls back to its distance from the reference box.
		def arrange(window Size<Pixels>, direction Direction = Direction.LeftToRight, fontSize Pixels = 16(px)) string[] {
			let pass = new Pass(float(window.width), float(window.height))
			run(pass, self, direction, float(fontSize))
			return pass.warnings
		}

		// Whether this node or one under it is somewhere else in the window than when this
		// was last asked. A style that reads another component's `geom` read what the layout
		// before gave, so it needs one more layout after one that moved something.
		def moved() bool {
			let frame = geom.frame
			let left = float(frame.left)
			let top = float(frame.top)
			let right = float(frame.right)
			let bottom = float(frame.bottom)
			let changed = left != wasLeft || top != wasTop || right != wasRight || bottom != wasBottom
			wasLeft = left
			wasTop = top
			wasRight = right
			wasBottom = bottom
			for let child in children {
				// Every node notes where it is, also once one has moved.
				let under = child.moved()
				changed = changed || under
			}
			return changed
		}
	}
}
