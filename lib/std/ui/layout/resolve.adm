internal partial module std.ui.layout {
	use (
		std.ui.styles::*
		std.units::(Extent, FontRelative, Length, Percent, Pixels, ViewportHeight, ViewportWidth)
	)

	// Splits `extent` into pixels and a percent of its reference, left in `pass.abs` and
	// `pass.pct`.
	def split(pass Pass, extent Extent, em float) {
		pass.abs = 0.0
		pass.pct = 0.0
		match extent {
			case Pixels:
				pass.abs = float(extent)
			case Percent:
				pass.pct = float(extent)
			case ViewportHeight:
				pass.abs = pass.windowHeight * float(extent) / 100.0
			case ViewportWidth:
				pass.abs = pass.windowWidth * float(extent) / 100.0
			case FontRelative:
				pass.abs = em * float(extent)
			case Length:
				pass.abs = float(extent) * pixelsPerMetre
		}
	}

	// `split` for a limit the style may leave out; false when it does.
	def splitLimit(pass Pass, extent ?Extent, em float) bool {
		return false when extent is none
		split(pass, extent, em)
		return true
	}

	// Reads the node's style once for the pass, so sizing works on numbers.
	def resolveStyle(pass Pass, node Node) {
		let box = node.box
		let em = node.em
		node.widthFill = fillWeight(box.width)
		node.widthAuto = false
		node.widthAbs = 0.0
		node.widthPct = 0.0
		let width = box.width
		match width {
			case Auto:
				node.widthAuto = true
			case Fill:
				node.widthAuto = false
			case Pixels:
				node.widthAbs = float(width)
			case Percent:
				node.widthPct = float(width)
			case ViewportHeight:
				node.widthAbs = pass.windowHeight * float(width) / 100.0
			case ViewportWidth:
				node.widthAbs = pass.windowWidth * float(width) / 100.0
			case FontRelative:
				node.widthAbs = em * float(width)
			case Length:
				node.widthAbs = float(width) * pixelsPerMetre
			default:
				node.widthAuto = true
		}
		node.heightFill = fillWeight(box.height)
		node.heightAuto = false
		node.heightAbs = 0.0
		node.heightPct = 0.0
		let height = box.height
		match height {
			case Auto:
				node.heightAuto = true
			case Fill:
				node.heightAuto = false
			case Pixels:
				node.heightAbs = float(height)
			case Percent:
				node.heightPct = float(height)
			case ViewportHeight:
				node.heightAbs = pass.windowHeight * float(height) / 100.0
			case ViewportWidth:
				node.heightAbs = pass.windowWidth * float(height) / 100.0
			case FontRelative:
				node.heightAbs = em * float(height)
			case Length:
				node.heightAbs = float(height) * pixelsPerMetre
			default:
				node.heightAuto = true
		}

		node.minWidthSet = splitLimit(pass, box.minWidth, em)
		node.minWidthAbs = pass.abs
		node.minWidthPct = pass.pct
		node.maxWidthSet = splitLimit(pass, box.maxWidth, em)
		node.maxWidthAbs = pass.abs
		node.maxWidthPct = pass.pct
		node.minHeightSet = splitLimit(pass, box.minHeight, em)
		node.minHeightAbs = pass.abs
		node.minHeightPct = pass.pct
		node.maxHeightSet = splitLimit(pass, box.maxHeight, em)
		node.maxHeightAbs = pass.abs
		node.maxHeightPct = pass.pct

		let padding = box.padding
		let border = node.border
		split(pass, padding.left, em)
		node.insetLeftAbs = pass.abs + float(border.left)
		node.insetLeftPct = pass.pct
		split(pass, padding.right, em)
		node.insetRightAbs = pass.abs + float(border.right)
		node.insetRightPct = pass.pct
		split(pass, padding.top, em)
		node.insetTopAbs = pass.abs + float(border.top)
		node.insetTopPct = pass.pct
		split(pass, padding.bottom, em)
		node.insetBottomAbs = pass.abs + float(border.bottom)
		node.insetBottomPct = pass.pct

		let margin = box.margin
		split(pass, margin.left, em)
		node.marginLeftAbs = pass.abs
		node.marginLeftPct = pass.pct
		split(pass, margin.right, em)
		node.marginRightAbs = pass.abs
		node.marginRightPct = pass.pct
		split(pass, margin.top, em)
		node.marginTopAbs = pass.abs
		node.marginTopPct = pass.pct
		split(pass, margin.bottom, em)
		node.marginBottomAbs = pass.abs
		node.marginBottomPct = pass.pct

		let gap = node.layout.gap
		split(pass, gap.horizontal, em)
		node.gapWidthAbs = pass.abs
		node.gapWidthPct = pass.pct
		split(pass, gap.vertical, em)
		node.gapHeightAbs = pass.abs
		node.gapHeightPct = pass.pct
	}

	// A split size in pixels. A percent without a reference gives `missing`: unset, or 0
	// for spacing.
	def share(abs float, pct float, reference float, missing float = unset) float {
		return abs when pct == 0.0
		return missing when !isSet(reference)
		return abs + reference * pct / 100.0
	}

	// The size a fixed width (`horizontal`) or height asks for; unset for `auto`, `fill`
	// and a percent without a reference.
	def fixedOf(node Node, horizontal bool, reference float) float {
		if horizontal {
			return unset when node.widthAuto || node.widthFill > 0.0
			return share(node.widthAbs, node.widthPct, reference)
		}
		return unset when node.heightAuto || node.heightFill > 0.0
		return share(node.heightAbs, node.heightPct, reference)
	}

	// The weight of a `fill` width or height; 0 for anything else.
	def fillOf(node Node, horizontal bool) float {
		return horizontal ?? (node.widthFill, node.heightFill)
	}

	// Whether the width or height comes out as the content's size: `auto`, and a percent
	// or a `fill` inside a parent that itself sizes to its content on that axis.
	def autoOf(node Node, horizontal bool, reference float) bool {
		return false when isSet(fixedOf(node, horizontal, reference))
		return !(isSet(reference) && fillOf(node, horizontal) > 0.0)
	}

	// Whether a child takes the whole slot on an axis: a `fill` that has something to fill,
	// or a content-sized child under Fill alignment.
	def stretchOf(node Node, horizontal bool, alignment Alignment, reference float) bool {
		return true when isSet(reference) && fillOf(node, horizontal) > 0.0
		return alignment == Alignment.Fill && autoOf(node, horizontal, reference)
	}

	// The set minimum width; unset when the style sets none or it is a percent without a
	// reference. The three below are the same for the other limits.
	def minWidthOf(node Node, reference float) float {
		return node.minWidthSet ?? (share(node.minWidthAbs, node.minWidthPct, reference), unset)
	}

	def maxWidthOf(node Node, reference float) float {
		return node.maxWidthSet ?? (share(node.maxWidthAbs, node.maxWidthPct, reference), unset)
	}

	def minHeightOf(node Node, reference float) float {
		return node.minHeightSet ?? (share(node.minHeightAbs, node.minHeightPct, reference), unset)
	}

	def maxHeightOf(node Node, reference float) float {
		return node.maxHeightSet ?? (share(node.maxHeightAbs, node.maxHeightPct, reference), unset)
	}

	// The set minimum (`least`) or maximum on one axis.
	def limitOf(node Node, horizontal bool, least bool, reference float) float {
		return least ?? (minWidthOf(node, reference), maxWidthOf(node, reference)) when horizontal
		return least ?? (minHeightOf(node, reference), maxHeightOf(node, reference))
	}
}
