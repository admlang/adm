// Maps as components: `MapView(center = here, zoom = level, tiles = new XyzTiles(url)) {
// Marker(at = office) { Badge("HQ") }; Polyline(route); Polygon(area) }`. Positions are
// `std.math.geo` coordinates on the Web Mercator map that `geo.Tile` numbers.
partial module std.ui.maps {
	use (
		std.errors
		std.formats.image::(Image, load)
		std.math
		std.math.geo
		std.net.http
		std.os
	)

	// Half the Web Mercator world's width, in metres: x and y run from minus this to it.
	internal const mercatorHalf = 20037508.342789244

	// Where the map shows a coordinate at `zoom`, in pixels of the whole world map, whose
	// side is `tileSize * 2^zoom`: x from the antimeridian eastwards, y from the top.
	def worldPixel(at geo.Coordinate, zoom float, tileSize float) (float, float) {
		let (mx, my) = geo.toWebMercator(at)
		let world = tileSize * 2.0 ** zoom
		return ((mx + mercatorHalf) / (2.0 * mercatorHalf) * world, (mercatorHalf - my) / (2.0 * mercatorHalf) * world)
	}

	// The coordinate at a pixel of the whole world map at `zoom`.
	def worldCoordinate(x float, y float, zoom float, tileSize float) geo.Coordinate {
		let world = tileSize * 2.0 ** zoom
		return geo.fromWebMercator(x / world * 2.0 * mercatorHalf - mercatorHalf, mercatorHalf - y / world * 2.0 * mercatorHalf)
	}

	// From coordinates to the pixels of a map view and back: the world pixel at its
	// centre, its zoom, the tiles' side and the view's size.
	type MapTransform {
		centerX  float
		centerY  float
		zoom     float
		tileSize float
		width    float
		height   float

		def new(center geo.Coordinate, zoom float, tileSize float, width float, height float) {
			(centerX, centerY) = worldPixel(center, zoom, tileSize)
			self.zoom = zoom
			self.tileSize = tileSize
			self.width = width
			self.height = height
		}

		// The pixel of the view a coordinate is at.
		def point(at geo.Coordinate) (float, float) {
			let (x, y) = worldPixel(at, zoom, tileSize)
			return (x - centerX + width / 2.0, y - centerY + height / 2.0)
		}

		// The coordinate at a pixel of the view.
		def coordinate(x float, y float) geo.Coordinate {
			return worldCoordinate(x + centerX - width / 2.0, y + centerY - height / 2.0, zoom, tileSize)
		}
	}

	// Where a map's tiles come from. `fetch` is called on a task of the map, never on the
	// one that draws, and may wait on the network or a disk.
	interface TileSource {
		// The side of a tile, in pixels.
		def tileSize() int

		// The deepest zoom it has tiles for.
		def maxZoom() int

		// The picture of `tile`. Fails when it cannot be had.
		def fetch(tile geo.Tile) !Image

		// Who the map is by, shown in the view's corner; empty: nothing.
		def attribution() string
	}

	// Raster tiles at an XYZ address: `new XyzTiles("https://tile.openstreetmap.org/{z}/{x}/{y}.png",
	// attribution = "© OpenStreetMap contributors")`, `{z}`, `{x}` and `{y}` replaced by
	// the tile's zoom and numbers, `{s}` by one of `subdomains` in turn. With `cacheDir`
	// each tile fetched is kept there as `<z>/<x>/<y>` and read from there after.
	type XyzTiles {
		url        string
		subdomains string[] = []
		size       int      = 256
		deepest    int      = 19
		credit     string   = ""
		cacheDir   string   = ""
		// The User-Agent the requests carry: tile servers ask for one that names the
		// application.
		userAgent  string   = "adm-maps"

		def new(url string, attribution string = "", maxZoom int = 19, cacheDir string = "", subdomains string[] = [], tileSize int = 256, userAgent string = "adm-maps") {
			self.url = url
			credit = attribution
			deepest = maxZoom
			self.cacheDir = cacheDir
			self.subdomains = subdomains
			size = tileSize
			self.userAgent = userAgent
		}

		// The side of its tiles, in pixels.
		def tileSize() int {
			return size
		}

		// The deepest zoom the server has.
		def maxZoom() int {
			return deepest
		}

		// Who the tiles are by.
		def attribution() string {
			return credit
		}

		// The address of `tile`.
		def urlOf(tile geo.Tile) string {
			let made = url.replace("\{z\}", "{tile.zoom}").replace("\{x\}", "{tile.x}").replace("\{y\}", "{tile.y}")
			return made when subdomains.len() == 0
			return made.replace("\{s\}", subdomains[(tile.x + tile.y) % subdomains.len()])
		}

		// Where `tile` is kept under `cacheDir`.
		def pathOf(tile geo.Tile) string {
			return os.join(cacheDir, "{tile.zoom}", "{tile.x}", "{tile.y}")
		}

		// The picture of `tile`: from `cacheDir` when it is kept there, else from the
		// server, then kept. Fails when the server cannot be reached, answers other than
		// 200 (`MapError` with its `status`), or sends no picture.
		def fetch(tile geo.Tile) !Image {
			if cacheDir != "" {
				let path = pathOf(tile)
				if os.exists(path) onerror recover false {
					let kept = load(try os.readFile(path))
					return kept unless kept is error
				}
			}
			let request = try http.newRequest(http.Method.GET, urlOf(tile))
			request.headers.set("User-Agent", userAgent)
			let response = try new http.Client().do(request)
			fail MapError{message: "maps: {urlOf(tile)} answered {response.status}", status: response.status} unless response.status == 200
			let body = try response.bytes()
			let picture = try load(body)
			if cacheDir != "" {
				// A tile that cannot be kept is still shown.
				let path = pathOf(tile)
				let _ = os.mkdir(os.dir(path), true)
				let _ = os.writeFile(path, body)
			}
			return picture
		}
	}

	// What went wrong fetching a tile: the server's answer when it was no picture.
	struct MapError {
		message string
		code    string            = "maps"
		cause   ?error
		stack   errors.StackTrace
		status  int               = 0
	}
}
