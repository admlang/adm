partial module std.ui.maps {
	use (
		std.formats.image::Image
		std.gfx.canvas
		std.math.geo
		std.math.geom::(Point, Size)
		std.os
		std.testing
		std.time
		std.ui::(MouseButton, PointerPhase)
		std.ui.runtime::Scene
		std.ui.styles::*
		std.units::Pixels
	)

	// Tiles made on the spot: no network.
	type MadeTiles {
		def tileSize() int {
			return 256
		}

		def maxZoom() int {
			return 18
		}

		def fetch(tile geo.Tile) !Image {
			return new Image(256, 256)
		}

		def attribution() string {
			return "made here"
		}
	}

	component Mapped {
		type {
			@bindable
			middle geo.Coordinate = new geo.Coordinate(51.4769, -0.0005)

			@bindable
			level float = 10.0

			source MadeTiles = new MadeTiles()

			def new() {
				style.width = 400(px)
				style.height = 300(px)
			}
		}

		view {
			MapView(middle, zoom = level, tiles = source, style = {width: 400(px), height: 300(px)}) {
				Marker(new geo.Coordinate(51.4769, -0.0005))
				Polyline([new geo.Coordinate(51.47, -0.01), new geo.Coordinate(51.48, 0.01)])
			}
		}

		style {
			Box
		}
	}

	internal def close(a float, b float, within float) bool {
		return (a - b).abs() <= within
	}

	check "Maps" {
		// The world map at zoom 0 is one tile: (0, 0) is its middle; a pixel and its
		// coordinate go back and forth.
		@test()
		def TestProjection() {
			let (x, y) = worldPixel(new geo.Coordinate(0.0, 0.0), 0.0, 256.0)
			assert close(x, 128.0, 1e-9) && close(y, 128.0, 1e-9)
			let at = new MapTransform(new geo.Coordinate(51.4769, -0.0005), 12.5, 256.0, 400.0, 300.0)
			let (px, py) = at.point(new geo.Coordinate(51.4769, -0.0005))
			assert close(px, 200.0, 1e-6) && close(py, 150.0, 1e-6)
			let middle = worldCoordinate(128.0, 128.0, 0.0, 256.0)
			assert close(middle.latitude, 0.0, 1e-9) && close(middle.longitude, 0.0, 1e-9)
			let back = at.coordinate(10.0, 20.0)
			let (bx, by) = at.point(back)
			assert close(bx, 10.0, 1e-6) && close(by, 20.0, 1e-6)
		}

		// An XYZ address takes the tile's numbers and the subdomains in turn; a tile kept
		// under `cacheDir` is read from there.
		@test()
		def TestXyz() !none {
			let source = new XyzTiles("https://\{s\}.tiles.test/\{z\}/\{x\}/\{y\}.png", subdomains = ["a", "b"])
			assert source.urlOf(new geo.Tile(3, 5, 7)) == "https://a.tiles.test/7/3/5.png"
			assert source.urlOf(new geo.Tile(4, 5, 7)) == "https://b.tiles.test/7/4/5.png"
			let dir = os.join(try os.appHome(), "tiles-test")
			let kept = new XyzTiles("https://nowhere.invalid/\{z\}/\{x\}/\{y\}.png", cacheDir = dir)
			let tile = new geo.Tile(1, 2, 3)
			try os.mkdir(os.dir(kept.pathOf(tile)), true)
			let picture = new Image(256, 256)
			let file = kept.pathOf(tile) + ".png"
			try picture.save(file)
			try os.rename(file, kept.pathOf(tile))
			let read = try kept.fetch(tile)
			assert read.size().width == 256
		}

		// Tiles are fetched on the map's tasks and drawn once they come; a drag pans, the
		// wheel zooms round the pointer, a double click zooms in, a marker stands with its
		// bottom middle on its coordinate.
		@test()
		def TestMapView() {
			let page = Mapped()
			let scene = new Scene(page)
			let size = new Size<Pixels>(400(px), 300(px))
			scene.arrange(size)
			let mapped = page.children[0]
			assert mapped is MapView
			if mapped is MapView {
				// The tiles that cover 400 by 300 at one zoom are asked for and come.
				scene.paint(new canvas.Canvas(400, 300))
				let waited = 0
				for mapped.pictures.len() < 4 && waited < 200 {
					time.sleep(10ms)
					scene.arrange(size)
					scene.paint(new canvas.Canvas(400, 300))
					waited++
				}
				assert mapped.pictures.len() >= 4 && mapped.inFlight == 0
				// The marker's bottom middle is on its coordinate, the middle of the mapped.
				scene.arrange(size)
				let marker = mapped.childNodes[0]
				let frame = marker.style.geom.frame
				assert close(float(frame.left) + float(frame.width) / 2.0, 200.0, 1.0) && close(float(frame.bottom), 150.0, 1.0)
				// A drag 100 pixels right shows what is west.
				let from = new Point<Pixels>(200(px), 150(px))
				scene.pointer(PointerPhase.Down, from)
				scene.pointer(PointerPhase.Move, new Point<Pixels>(300(px), 150(px)))
				scene.pointer(PointerPhase.Up, new Point<Pixels>(300(px), 150(px)))
				scene.arrange(size)
				assert page.middle.longitude < -0.0005 && close(page.middle.latitude, 51.4769, 1e-6)
				// A wheel notch zooms in and keeps what is under the pointer there.
				let at = mapped.transform()
				let under = at.coordinate(100.0, 100.0)
				scene.pointer(PointerPhase.Scroll, new Point<Pixels>(100(px), 100(px)), MouseButton.Left, new Point<Pixels>(0(px), 40(px)))
				scene.arrange(size)
				assert page.level > 10.0
				let (ux, uy) = mapped.transform().point(under)
				assert close(ux, 100.0, 0.01) && close(uy, 100.0, 0.01)
				// A double click zooms in by one.
				let before = page.level
				scene.pointer(PointerPhase.Down, from)
				scene.pointer(PointerPhase.Up, from)
				scene.pointer(PointerPhase.Down, from, clicks = 2)
				scene.pointer(PointerPhase.Up, from, clicks = 2)
				scene.arrange(size)
				assert close(page.level, before + 1.0, 1e-9)
			}
			scene.close()
		}
	}
}
