partial module std.ui.maps {
	use (
		std.formats.image::Image
		std.gfx.canvas
		std.gfx.color::Color
		std.math.geo
		std.math.geom::(Circle, LineJoin, Path, Point, Rect, StrokeStyle)
		std.ui::(Key, KeyEvent, Limit, MouseButton, PointerEvent, PointerPhase, RenderContext, Theme, UI)
		std.ui.paint
		std.ui.styles::*
		std.units::Pixels
	)

	// Tiles fetched at once, tiles kept, and how far a press may move before it is a drag.
	internal const tilesInFlight = 6
	internal const tilesKept = 512
	internal const mapSlop = 4.0

	// A tile a task of a map fetched, or failed to.
	internal struct LoadedTile {
		key     string
		picture ?Image
	}

	// The key of a tile in a map's caches.
	internal def tileKey(zoom int, x int, y int) string {
		return "{zoom}/{x}/{y}"
	}

	// What a map draws over its tiles through its transform: a line, an area.
	interface MapPart {
		def drawOn(target canvas.Painter, map MapView, at MapTransform, scale float)
	}

	// The style of a map's parts that draw over it: out of the layout, over the whole
	// map, no part in hit testing.
	style MapPartStyle {
		Box
		Interaction
		position = Position.Relative
		anchors = Anchors{left: new AnchorLine(0(px)), top: new AnchorLine(0(px)), right: new AnchorLine(0(px)), bottom: new AnchorLine(0(px))}
		hitTest = HitTest.None
	}

	// A map of raster tiles with what its block puts on it:
	// `MapView(center = here, zoom = 12.0, tiles = osm) { Marker(at = here); Polyline(route) }`.
	// A drag pans, the wheel zooms round the pointer, a double click zooms in; with the
	// focus the arrows pan and `+`/`-` zoom. `center` and `zoom` are written as it moves.
	// Tiles are fetched on its tasks, at most six at a time, and the 512 seen last are
	// kept; one not there yet shows the part of a tile above it that is.
	component MapView {
		type {
			// The coordinate at the middle of the view.
			@input(value = true, bind = true)
			@state
			center geo.Coordinate = new geo.Coordinate(0.0, 0.0)

			// How far in: the world is `tileSize * 2^zoom` pixels wide.
			@input(bind = true)
			@state
			zoom float = 2.0

			// Where the tiles come from; none: no tiles, the parts on a plain ground.
			@input
			tiles ?TileSource = none

			@input
			minZoom float = 0.0

			// Whether the pointer and the keys move the map.
			@input
			interactive bool = true

			// The tiles kept, by `tileKey`, the order they came in, the ones asked for, the
			// ones that failed, and those waiting for a free fetch.
			pictures map<string, Image> = map<string, Image>{}
			arrived  string[]
			asked    map<string, bool> = map<string, bool>{}
			failed   map<string, bool> = map<string, bool>{}
			waiting  geo.Tile[]
			inFlight int

			// What the tasks hand back; drained on the task that draws.
			done channel<LoadedTile> = new channel<LoadedTile>(size = 64)

			// A press that may become a drag: where it went down and the centre then, in
			// world pixels.
			pressing bool
			moved    bool
			pressAt  Point<Pixels> = new Point<Pixels>(0(px), 0(px))
			pressX   float
			pressY   float

			look   Theme = UI.theme()
			credit ?paint.TextBlock = none

			def new() {
				focusable = true
				tabStop   = true
			}

			def tileSide() float {
				let source = tiles
				return source is none ?? (256.0, float(source.tileSize()))
			}

			def deepest() float {
				let source = tiles
				return source is none ?? (22.0, float(source.maxZoom()))
			}

			// From coordinates to its pixels as it is laid out now.
			def transform() MapTransform {
				let frame = style.geom.frame
				return new MapTransform(center, zoom, tileSide(), float(frame.width), float(frame.height))
			}

			// Shows `at` in the middle at `level`, kept within `minZoom` and the tiles'
			// deepest zoom, and writes `center` and `zoom`.
			def show(at geo.Coordinate, level float) {
				let z = level.max(minZoom).min(deepest())
				center = at
				zoom   = z when z != zoom
			}

			// Zooms by `steps` (1: twice as close) keeping the coordinate under the pixel
			// (`x`, `y`) where it is.
			def zoomAround(steps float, x float, y float) {
				let at = transform()
				let held = at.coordinate(x, y)
				let z = (zoom + steps).max(minZoom).min(deepest())
				let (hx, hy) = worldPixel(held, z, at.tileSize)
				show(worldCoordinate(hx - (x - at.width / 2.0), hy - (y - at.height / 2.0), z, at.tileSize), z)
			}

			// Moves the view by (`dx`, `dy`) pixels.
			def panBy(dx float, dy float) {
				let at = transform()
				show(worldCoordinate(at.centerX + dx, at.centerY + dy, zoom, at.tileSize), zoom)
			}

			def pointer(e PointerEvent) bool {
				return false when disabled || !interactive
				let (x, y) = (float(e.position.x), float(e.position.y))
				match e.phase {
					case PointerPhase.Scroll:
						let notches = float(e.scroll.y)
						return false when notches == 0.0
						zoomAround((notches / 80.0).clamp(-2.0, 2.0), x, y)
						return true
					case PointerPhase.Down:
						return false when e.button != MouseButton.Left
						e.capture()
						pressing = true
						moved    = false
						pressAt  = e.position
						let at = transform()
						(pressX, pressY) = (at.centerX, at.centerY)
						return true
					case PointerPhase.Move:
						return false when !pressing
						let (dx, dy) = (x - float(pressAt.x), y - float(pressAt.y))
						moved = true when dx * dx + dy * dy > mapSlop * mapSlop
						if moved {
							show(worldCoordinate(pressX - dx, pressY - dy, zoom, tileSide()), zoom)
						}
						return true
					case PointerPhase.Up:
						return false when !pressing
						pressing = false
						zoomAround(1.0, x, y) when !moved && e.clicks == 2
						return true
					case PointerPhase.Cancel:
						pressing = false
						return false
					default:
						return false
				}
			}

			def key(e KeyEvent) bool {
				return false when !e.down || disabled || !interactive
				let at = transform()
				let (cx, cy) = (at.width / 2.0, at.height / 2.0)
				match e.key {
					case Key.Left:
						panBy(-64.0, 0.0)
					case Key.Right:
						panBy(64.0, 0.0)
					case Key.Up:
						panBy(0.0, -64.0)
					case Key.Down:
						panBy(0.0, 64.0)
					case Key.Equal, Key.KeypadAdd:
						zoomAround(1.0, cx, cy)
					case Key.Minus, Key.KeypadSubtract:
						zoomAround(-1.0, cx, cy)
					default:
						return false
				}
				return true
			}

			// Takes what the tasks fetched, and starts the fetches waiting for room.
			def drain() {
				for done.len() > 0 {
					let got = <-done
					inFlight--
					asked = asked.delete(got.key) when asked.hasKey(got.key)
					let picture = got.picture
					if picture is none {
						failed[got.key] = true
						continue
					}
					pictures[got.key] = picture
					arrived.push(got.key)
					if arrived.len() > tilesKept {
						let oldest = arrived[0]
						arrived  = arrived.slice(1, arrived.len())
						pictures = pictures.delete(oldest) when pictures.hasKey(oldest)
					}
				}
				for waiting.len() > 0 && inFlight < tilesInFlight {
					let next = waiting[0]
					waiting = waiting.slice(1, waiting.len())
					start(next)
				}
			}

			// Asks for `tile` unless it is kept, asked for or failed.
			def request(tile geo.Tile) {
				let key = tileKey(tile.zoom, tile.x, tile.y)
				return when pictures.hasKey(key) || asked.hasKey(key) || failed.hasKey(key)
				asked[key] = true
				if inFlight < tilesInFlight {
					start(tile)
				} else {
					waiting.push(tile)
				}
			}

			def start(tile geo.Tile) {
				let source = tiles
				return when source is none
				inFlight++
				async<tasks> fetchTile(source, tile)
			}

			async def fetchTile(source TileSource, tile geo.Tile) {
				let key = tileKey(tile.zoom, tile.x, tile.y)
				let fetched = source.fetch(tile)
				if fetched is error {
					done <- LoadedTile{key: key, picture: none}
				} else {
					done <- LoadedTile{key: key, picture: fetched}
				}
				redraw()
			}

			// The kept picture of tile (`x`, `y`) at `level`, or the part of one above it
			// that covers it: the picture and the rectangle of it to draw; none.
			def pictureFor(level int, x int, y int) ?(Image, Rect) {
				let side = tileSide()
				for let up = 0; up <= level && up <= 4; up++ {
					let key = tileKey(level - up, x >> up, y >> up)
					let found = pictures.get(key)
					if !(found is none) {
						let part = side / float(1 << up)
						let (ox, oy) = (float(x % (1 << up)) * part, float(y % (1 << up)) * part)
						return (found, Rect{left: ox, top: oy, right: ox + part, bottom: oy + part})
					}
				}
				return none
			}

			// Draws the tiles that cover the view, asking for those not kept.
			def drawTiles(target canvas.Painter, at MapTransform) {
				let source = tiles
				return when source is none
				let level = int(at.zoom.floor()).max(0).min(source.maxZoom())
				let scale = 2.0 ** (at.zoom - float(level))
				let side = at.tileSize * scale
				let count = 1 << level
				let (cx, cy) = (at.centerX / scale, at.centerY / scale)
				let (firstX, lastX) = (int(((cx - at.width / 2.0 / scale) / at.tileSize).floor()), int(((cx + at.width / 2.0 / scale) / at.tileSize).floor()))
				let (firstY, lastY) = (int(((cy - at.height / 2.0 / scale) / at.tileSize).floor()).max(0), int(((cy + at.height / 2.0 / scale) / at.tileSize).floor()).min(count - 1))
				for let ty = firstY; ty <= lastY; ty++ {
					for let tx = firstX; tx <= lastX; tx++ {
						// The world repeats across: the tile one world over is the same.
						let wrapped = ((tx % count) + count) % count
						let left = (float(tx) * at.tileSize - cx) * scale + at.width / 2.0
						let top = (float(ty) * at.tileSize - cy) * scale + at.height / 2.0
						let box = Rect{left: left, top: top, right: left + side, bottom: top + side}
						request(new geo.Tile(wrapped, ty, level))
						let shown = pictureFor(level, wrapped, ty)
						if !(shown is none) {
							let (picture, part) = shown
							target.drawImage(picture, part, box)
						}
					}
				}
			}

			// Draws one part through `at`.
			def drawPart(target canvas.Painter, part component, at MapTransform, scale float) {
				if part is MapPart {
					part.drawOn(target, self, at, scale)
				}
			}

			// Puts each `Marker` of its block over its coordinate, from where it was laid
			// out last.
			def placeMarkers() {
				let at = transform()
				for let child in childNodes {
					if child is Marker {
						let (x, y) = at.point(child.at)
						let frame = child.style.geom.frame
						child.style.anchors = Anchors{left: new AnchorLine((x - float(frame.width) / 2.0) * 1(px)), top: new AnchorLine((y - float(frame.height)) * 1(px))}
					}
				}
			}

			def render(ctx RenderContext) {
				drain()
				ctx.outerShadows()
				ctx.background()
				let at = transform()
				let frame = frameRect()
				ctx.draw.save()
				ctx.draw.clip(frame)
				drawTiles(ctx.draw, at)
				ctx.childNodes()
				ctx.draw.restore()
				let source = tiles
				if !(source is none) && source.attribution() != "" {
					let made = creditFor(source.attribution())
					let size = made.measure(Limit{})
					let box = Rect{left: frame.right - float(size.width) - 8.0, top: frame.bottom - float(size.height) - 4.0, right: frame.right, bottom: frame.bottom}
					ctx.draw.fill(box, look.palette.surface.withOpacity(0.8))
					paint.drawBlock(ctx.draw, made, Rect{left: box.left + 4.0, top: box.top + 2.0, right: box.right - 4.0, bottom: box.bottom - 2.0}, Align{horizontal: Alignment.End, vertical: Alignment.Center}, false, ctx.scale)
				}
				ctx.borders()
				ctx.innerShadows()
			}

			// The text block of the attribution, kept while the text is the same.
			def creditFor(text string) paint.TextBlock {
				let held = credit
				return held when !(held is none) && held.text == text
				let fresh = new paint.TextBlock(text, Font{family: "system-ui"}, 11(px))
				fresh.foreground = look.palette.foreground
				credit = fresh
				return fresh
			}

			def frameRect() Rect {
				let frame = style.geom.frame
				return Rect{left: 0.0, top: 0.0, right: float(frame.width), bottom: float(frame.height)}
			}
		}

		view {
			placeMarkers()
			children()
		}

		style {
			Box
			Control
			width      = fill
			height     = 320(px)
			background = new BackgroundFill(theme.palette.surfaceSunken)
			on         = {
				focusVisible: {outline: Ring{width: theme.metrics.focusWidth, paint: theme.palette.focus, offset: 1(px)}},
			}
		}
	}

	// Draws a part of the map it is in through the map's transform.
	internal def drawInMap(part component, ctx RenderContext) {
		let map = part.closest<MapView>()
		return when map is none
		map.drawPart(ctx.draw, part, map.transform(), ctx.scale)
	}

	// Something put at a coordinate of a `MapView`, its bottom middle there: what its
	// block holds (`Marker(at = office) { Badge("HQ") }`), else a pin in `color` (the
	// accent without).
	component Marker {
		type {
			@input(value = true)
			at geo.Coordinate = new geo.Coordinate(0.0, 0.0)

			@input
			color ?Color = none

			look Theme = UI.theme()

			def render(ctx RenderContext) {
				ctx.childNodes()
				return when childNodes.len() > 0
				let given = color
				let ink = given is none ?? (look.palette.accent, given)
				let box = Rect{left: 0.0, top: 0.0, right: float(ctx.geometry.frame.width), bottom: float(ctx.geometry.frame.height)}
				let middle = (box.left + box.right) / 2.0
				let pin = new Path().moveTo(middle, box.bottom).lineTo(middle - 5.0, box.bottom - 12.0).lineTo(middle + 5.0, box.bottom - 12.0).close()
				ctx.draw.fill(pin, ink)
				ctx.draw.fill(new Circle(new Point(middle, box.bottom - 15.0), 8.0), ink)
				ctx.draw.fill(new Circle(new Point(middle, box.bottom - 15.0), 3.0), look.palette.surface)
			}
		}

		view {
			children()
		}

		style {
			Box
			Layout
			position  = Position.Relative
			minWidth  = 18(px)
			minHeight = 24(px)
		}
	}

	// A line through coordinates: `Polyline(route, color = blue, width = 4.0)`.
	component Polyline {
		type {
			@input(value = true)
			points geo.Coordinate[] = []

			@input
			color ?Color = none

			@input
			width float = 3.0

			def drawOn(target canvas.Painter, map MapView, at MapTransform, scale float) {
				return when points.len() < 2
				let path = new Path()
				for let (i, point) in points {
					let (x, y) = at.point(point)
					path = i == 0 ?? (path.moveTo(x, y), path.lineTo(x, y))
				}
				let given = color
				target.stroke(path, given is none ?? (map.look.palette.accent, given), StrokeStyle{width: width * 1(px), join: LineJoin.Round})
			}

			def render(ctx RenderContext) {
				drawInMap(self, ctx)
			}
		}

		view {}

		style MapPartStyle
	}

	// An area inside coordinates, its first and last joined: `Polygon(field, fill = green)`.
	// The fill is the accent at a fifth without `fill`, the edge the accent without
	// `stroke`.
	component Polygon {
		type {
			@input(value = true)
			points geo.Coordinate[] = []

			@input
			fill ?Color = none

			@input
			stroke ?Color = none

			def drawOn(target canvas.Painter, map MapView, at MapTransform, scale float) {
				return when points.len() < 3
				let path = new Path()
				for let (i, point) in points {
					let (x, y) = at.point(point)
					path = i == 0 ?? (path.moveTo(x, y), path.lineTo(x, y))
				}
				path = path.close()
				let (inside, edge) = (fill, stroke)
				target.fill(path, inside is none ?? (map.look.palette.accent.withOpacity(0.2), inside))
				target.stroke(path, edge is none ?? (map.look.palette.accent, edge), StrokeStyle{width: 2(px)})
			}

			def render(ctx RenderContext) {
				drawInMap(self, ctx)
			}
		}

		view {}

		style MapPartStyle
	}
}
