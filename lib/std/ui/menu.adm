partial module std.ui {
	// One line of a native menu, such as the tray's: something to choose, a submenu, or a
	// separator.
	struct MenuEntry {
		label     string
		// Runs when the line is chosen.
		onSelect  ?(def())    = none
		// False: shown greyed out and cannot be chosen.
		enabled   bool        = true
		// A check mark beside the label: shown when true, an empty box when false; none:
		// the line has no check mark.
		checked   ?bool       = none
		// Not empty: the line opens a submenu with these lines.
		children  MenuEntry[] = []
		// A dividing line; the other fields are not read.
		separator bool        = false
	}
}
