@os("wasm")
internal partial module std.ui.navigation.platform {
	use (
		std.data.encoding::JSON
		std.math.geom::Point
		std.net.url
		std.services.browser::Browser
		std.ui.navigation::(History, Location, MemoryHistory, Router, locationText, parseLocation)
		std.units::Pixels
	)

	// The page's history: the address bar shows the location.
	def defaultHistory() History {
		return new BrowserHistory()
	}

	// The browser's history of the page: the address bar shows the location, relative to
	// the folder the page is served from (`/docs#intro` at `https://site/app/docs#intro`
	// for a page under `/app/`), and the browser's back and forward buttons walk it. The
	// entries are mirrored in memory with the scrollers' positions beside each; the
	// router's moves write browser entries, and the buttons' come back through
	// `Browser.locationChange`. A location opened directly (a link, a reload) is the
	// first entry; the server answers it with the page (`adm build --base`).
	type BrowserHistory {
		mirror      MemoryHistory
		weak router ?Router

		def new() {
			let start = appLocation()
			mirror = new MemoryHistory(start == "" ?? ("/", start))
			// The buttons' moves arrive as `Browser.locationChange`, emitted while the
			// service runs; starting it again does nothing.
			await Browser.start() onerror recover none
		}

		def current() Location {
			return mirror.current()
		}

		def push(to Location, replace bool) {
			mirror.push(to, replace)
			let _ = call("pushHistory", encode(PushArgs{to: locationText(to), replace: replace})) onerror recover ""
		}

		def back() bool {
			return false unless mirror.back()
			Browser.back() onerror recover none
			return true
		}

		def forward() bool {
			return false unless mirror.forward()
			Browser.forward() onerror recover none
			return true
		}

		def canGoBack() bool {
			return mirror.canGoBack()
		}

		def canGoForward() bool {
			return mirror.canGoForward()
		}

		def scrolls() map<string, Point<Pixels>> {
			return mirror.scrolls()
		}

		def keepScroll(name string, offset Point<Pixels>) {
			mirror.keepScroll(name, offset)
		}

		def attach(router Router) {
			self.router = router
		}

		// The address changed by itself: the back or forward button, or a fragment typed
		// into the address bar. A step to the entry before or after the current one is
		// that step; another location is a new entry. Where the router went itself
		// (`back`, `forward`) the mirror is there already and nothing moves.
		@on(Browser.locationChange)
		def moved(evt Event<url.URL>) {
			let now = appLocation()
			return when now == ""
			let shown = locationText(parseLocation(now))
			return when shown == locationText(mirror.current())
			let at = mirror.at
			if at > 0 && locationText(mirror.entries[at - 1]) == shown {
				let _ = mirror.back()
			} else if at + 1 < mirror.entries.len() && locationText(mirror.entries[at + 1]) == shown {
				let _ = mirror.forward()
			} else {
				mirror.push(parseLocation(now), false)
			}
			let held = router
			held.historyMoved() unless held is none
		}
	}

	// The page's address as a location of the application; "" when the page cannot say.
	def appLocation() string {
		let answer = call("appLocation", "\{}") onerror recover ""
		return "" when answer == ""
		let raw = LocationAnswer{}
		new JSON().decode(answer, raw) onerror recover none
		return raw.value
	}

	internal struct PushArgs {
		to      string
		replace bool
	}

	internal struct LocationAnswer {
		value string
	}

	internal def encode(value any) string {
		return string(new JSON().encode(value))
	}

	// Runs a browser operation of the page's loader; fails with its status when the
	// page refused it.
	internal def call(op string, args string = "\{}") !string {
		let status = __webBrowser(op, args)
		fail "browser operation {op}: status {status}" unless status == 0
		return __webAnswer()
	}

	@c("adm_web.h", symbol = "adm_web_browser", ret = "int32_t", params = ["const char*", "const char*"])
	def __webBrowser(op string, args string) int32;

	@c("adm_web.h", symbol = "adm_web_answer", ret = "const char*", params = [])
	def __webAnswer() string;
}
