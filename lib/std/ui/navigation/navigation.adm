// Pages of an application at paths: `@route` makes a component a page, `Routes()` shows
// the page for the current location and gives the `Router` to what is under it, an
// `Outlet()` in a page's view holds the deeper page, `Link(to = "/docs")` goes there.
partial module std.ui.navigation {
	use (
		std.errors
		std.math.geom::Point
		std.net.url
		std.reflection
		std.units::Pixels
	)

	// Where an application is: a path, the query's values by name, and the fragment.
	struct Location {
		path     string
		query    map<string, string> = map<string, string>{}
		fragment string              = ""
	}

	// The location a text names: `/docs/units?tab=examples#top`. A path that does not start
	// with `/` is taken from the root. Escapes are undone; a query value given twice keeps
	// the last.
	def parseLocation(text string) Location {
		let rest = text
		let fragment = ""
		let hash = rest.indexOf("#")
		if hash >= 0 {
			fragment = url.unescape(rest[hash + 1:]) onerror recover rest[hash + 1:]
			rest = rest[:hash]
		}
		let query = map<string, string>{}
		let mark = rest.indexOf("?")
		if mark >= 0 {
			for let pair in rest[mark + 1:].split("&") {
				continue when pair == ""
				let equal = pair.indexOf("=")
				let (key, value) = equal < 0 ?? ((pair, ""), (pair[:equal], pair[equal + 1:]))
				query[url.queryUnescape(key) onerror recover key] = url.queryUnescape(value) onerror recover value
			}
			rest = rest[:mark]
		}
		let path = url.pathUnescape(rest) onerror recover rest
		path = "/" + path unless path.startsWith("/")
		return Location{path: path, query: query, fragment: fragment}
	}

	// A location as text, the query's names in order.
	def locationText(at Location) string {
		let text = at.path
		let names = at.query.keys()
		names.sort(def (a string, b string) bool {
			return a < b
		})
		for let (i, name) in names {
			text += (i == 0 ?? ("?", "&")) + url.queryEscape(name) + "=" + url.queryEscape(at.query[name])
		}
		text += "#" + at.fragment when at.fragment != ""
		return text
	}

	// What went wrong with a route's path.
	struct RouteError {
		message string
		code    string            = "route"
		cause   ?error
		stack   errors.StackTrace
	}

	// A route's path as `@route` reads it: its segments, `\{name\}` ones standing for a
	// value, and the query parameters it lists.
	struct RoutePattern {
		segments string[]
		params   string[]
		query    string[]
	}

	// Reads a route's path. Fails on a path that does not start with `/`, an empty or
	// unclosed `\{\}`, a name given twice.
	def parsePattern(path string) !RoutePattern {
		fail RouteError{message: "a route's path starts with /: \"{path}\""} unless path.startsWith("/")
		let (rest, listed) = (path, "")
		let mark = path.indexOf("?")
		if mark >= 0 {
			(rest, listed) = (path[:mark], path[mark + 1:])
		}
		let out = RoutePattern{segments: [], params: [], query: []}
		let seen = map<string, bool>{}
		for let part in rest.split("/") {
			continue when part == ""
			if part.startsWith("\{") {
				fail RouteError{message: "unclosed or empty \{\} in \"{path}\""} unless part.endsWith("\}") && part.len() > 2
				let name = part[1:part.len() - 1]
				fail RouteError{message: "{name} is named twice in \"{path}\""} when seen.hasKey(name)
				seen[name] = true
				out.params.push(name)
			}
			out.segments.push(part)
		}
		for let name in listed.split("&") {
			continue when name == ""
			fail RouteError{message: "{name} is named twice in \"{path}\""} when seen.hasKey(name)
			seen[name] = true
			out.query.push(name)
		}
		return out
	}

	// The values of a location's `path` for `pattern` when it matches the whole path, or
	// its start with `prefix`; none when it does not. The listed query parameters the
	// location gives come with them.
	def matchPattern(pattern RoutePattern, at Location, prefix bool = false) ?map<string, string> {
		let parts string[]
		for let part in at.path.split("/") {
			parts.push(part) unless part == ""
		}
		return none when parts.len() < pattern.segments.len() || (!prefix && parts.len() != pattern.segments.len())
		let values = map<string, string>{}
		for let (i, segment) in pattern.segments {
			if segment.startsWith("\{") {
				values[segment[1:segment.len() - 1]] = parts[i]
			} else if segment != parts[i] {
				return none
			}
		}
		for let name in pattern.query {
			let given = at.query.get(name)
			values[name] = given unless given is none
		}
		return values
	}

	// Where an application has been and goes: what `back` and `forward` walk.
	interface History {
		// The location shown now.
		def current() Location
		// Goes to `to`; with `replace` in place of the current entry, else after it,
		// dropping the entries `forward` would have gone to.
		def push(to Location, replace bool)
		// Goes to the entry before or after; false when there is none.
		def back() bool
		def forward() bool
		def canGoBack() bool
		def canGoForward() bool
		// How far each scroller that keeps its position (`ScrollView(persist = "name")`)
		// was scrolled in the current entry, by name: what going back to it restores.
		def scrolls() map<string, Point<Pixels>>
		// Keeps how far the scroller `name` is scrolled in the current entry.
		def keepScroll(name string, offset Point<Pixels>)
		// Told the router that walks it: a history that moves by itself (the browser's
		// back and forward buttons) calls its `historyMoved` then.
		def attach(router Router)
	}

	// The history of a desktop window: its entries in memory, from `start`.
	type MemoryHistory {
		entries       Location[]
		at            int                          = 0
		// Beside each entry, its scrollers' positions.
		internal kept map<string, Point<Pixels>>[]

		def new(start string = "/") {
			entries = [parseLocation(start)]
			kept = [map<string, Point<Pixels>>{}]
		}

		def current() Location {
			return entries[at]
		}

		def push(to Location, replace bool) {
			if replace {
				entries[at] = to
				kept[at] = map<string, Point<Pixels>>{}
				return
			}
			entries.len(at + 1)
			kept.len(at + 1)
			entries.push(to)
			kept.push(map<string, Point<Pixels>>{})
			at++
		}

		def back() bool {
			return false when at == 0
			at--
			return true
		}

		def forward() bool {
			return false when at + 1 >= entries.len()
			at++
			return true
		}

		def canGoBack() bool {
			return at > 0
		}

		def canGoForward() bool {
			return at + 1 < entries.len()
		}

		def scrolls() map<string, Point<Pixels>> {
			return kept[at]
		}

		def keepScroll(name string, offset Point<Pixels>) {
			kept[at][name] = offset
		}

		// Nothing but the router moves it.
		def attach(router Router) {}
	}

	// One page the program declares: its path and the function `@route` wrote for it.
	struct RouteEntry {
		path    string
		pattern RoutePattern
		node    reflection.ReflectionNode
	}

	// The pages of the program, in the order the build lists them. A path that does not
	// read is left out (`@route` reported it when the program was built).
	def declaredRoutes() RouteEntry[] {
		let out RouteEntry[]
		for let (_, hit) in reflection.attrs(routeFactory) {
			let path = hit.attr.arguments.valueOf("path")
			continue unless path is string
			let pattern = parsePattern(path) onerror recover RoutePattern{segments: [], params: [], query: []}
			continue when pattern.segments.len() == 0 && path != "/"
			out.push(RouteEntry{path: path, pattern: pattern, node: hit.node})
		}
		return out
	}

	// What the function `@route` writes returns: the page it made, none when a value of
	// the location did not convert.
	type RoutePage {
		page ?component

		def new(page ?component) {
			self.page = page
		}
	}

	// Makes the page of `entry` from `values`; none when a value does not convert.
	def makePage(entry RouteEntry, values map<string, string>) ?component {
		let made = reflection.call(entry.node, none, [values])
		if made is RoutePage {
			return made.page
		}
		return none
	}

	// Where a window's pages are: the location, the history behind it, and the pages
	// declared. `Routes` makes one and gives it to what is under it
	// (`context<Router>()`).
	type Router {
		history History
		routes  RouteEntry[]
		// Counts the changes of the location.
		version int          = 0
		// Runs after each change of the location: what `Routes` shows by.
		changed ?(def())     = none

		def new(history History, routes RouteEntry[]) {
			self.history = history
			self.routes = routes
			history.attach(self)
		}

		// The location shown.
		location Location {
			def get() Location {
				return history.current()
			}
		}

		// Whether there is somewhere to go back to in the application.
		canGoBack bool {
			def get() bool {
				return history.canGoBack()
			}
		}

		// Goes to a path (`/docs/units?tab=examples`); with `replace` in place of the
		// current history entry.
		def go(to string, replace bool = false) {
			history.push(parseLocation(to), replace)
			moved()
		}

		// How far the scroller `name` was scrolled in the current entry; none when it was
		// not kept there.
		def scrollOf(name string) ?Point<Pixels> {
			return history.scrolls().get(name)
		}

		// Keeps how far the scroller `name` is scrolled in the current entry, for going
		// back to it.
		def keepScroll(name string, offset Point<Pixels>) {
			history.keepScroll(name, offset)
		}

		def back() {
			moved() when history.back()
		}

		def forward() {
			moved() when history.forward()
		}

		// Shows the location the history moved to by itself (the browser's back and
		// forward buttons): what a `History` calls.
		def historyMoved() {
			moved()
		}

		internal def moved() {
			version++
			let tell = changed
			tell() unless tell is none
		}

		// The page for `at` and the pages around it: the route that matches the whole
		// path, its most specific when several do (a fixed segment before a value), then
		// the routes whose paths start it, shortest first, each made from its values. The
		// whole is none when no route matches the path or a value does not convert.
		def pagesFor(at Location) ?component[] {
			let best = -1
			let bestScore = -1
			for let (i, entry) in routes {
				continue when matchPattern(entry.pattern, at) is none
				let score = specificity(entry.pattern)
				if score > bestScore {
					(best, bestScore) = (i, score)
				}
			}
			return none when best < 0
			let chain component[]
			let around RouteEntry[]
			for let (i, entry) in routes {
				continue when i == best || entry.pattern.segments.len() >= routes[best].pattern.segments.len()
				around.push(entry) unless matchPattern(entry.pattern, at, prefix = true) is none
			}
			around.sort(def (a RouteEntry, b RouteEntry) bool {
				return a.pattern.segments.len() < b.pattern.segments.len()
			})
			for let entry in around {
				let values = matchPattern(entry.pattern, at, prefix = true)
				continue when values is none
				let page = makePage(entry, values)
				chain.push(page) unless page is none
			}
			let values = matchPattern(routes[best].pattern, at)
			return none when values is none
			let page = makePage(routes[best], values)
			return none when page is none
			chain.push(page)
			return chain
		}
	}

	// How specific a pattern is: a fixed segment counts more than a value, so
	// `/docs/new` wins over `/docs/\{name\}`.
	internal def specificity(pattern RoutePattern) int {
		let score = 0
		for let segment in pattern.segments {
			score += segment.startsWith("\{") ?? (1, 2)
		}
		return score
	}
}
