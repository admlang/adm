partial module std.ui.navigation {
	use (
		std.math.geom::(Point, Size)
		std.testing
		std.ui.components::(Link, ScrollView, Text)
		std.ui.runtime::Scene
		std.ui.styles::*
		std.units::Pixels
	)

	// The words of the `Text`s at and under `c`, in order.
	internal def textsUnder(c component) string[] {
		let words string[]
		if c is Text {
			words.push(c.text)
		}
		for let child in c.childNodes {
			words.push(...textsUnder(child))
		}
		return words
	}

	@route("/")
	component HomePage {
		type {}

		view {
			Text("home")
			Link("units", to = "/docs/units")
		}

		style {
			Box
			Layout
		}
	}

	@route("/docs")
	component DocsLayout {
		type {}

		view {
			Text("docs")
			Outlet()
		}

		style {
			Box
			Layout
		}
	}

	@route("/docs/\{name\}?tab&count")
	component DocPage {
		type {
			@input
			name string

			@input
			tab string = "overview"

			@input
			count int = 1
		}

		view {
			Text("{name}:{tab}:{count}")
		}

		style {
			Box
		}
	}

	@route("/docs/new")
	component NewDoc {
		type {}

		view {
			Text("new")
		}

		style {
			Box
		}
	}

	// A page taller than the window, in a scroller that keeps its position.
	@route("/list")
	component ListPage {
		type {}

		view {
			ScrollView(persist = "list") {
				for let i in 0..80 {
					Text("row {i}")
				}
			}
		}

		style {
			Box
			Layout
			width  = fill
			height = fill
		}
	}

	component Site {
		type {
			past MemoryHistory = new MemoryHistory("/")

			def new() {
				style.width = 400(px)
				style.height = 300(px)
			}
		}

		view {
			Routes(history = past) {
				notFound = view {
					Text("missing")
				}
			}
		}

		style {
			Box
		}
	}

	check "Navigation" {
		// A location from its text and back: escapes undone, the query by name.
		@test()
		def TestLocations() {
			let at = parseLocation("/docs/a%20b?tab=ex&n=2#top")
			assert at.path == "/docs/a b" && at.query["tab"] == "ex" && at.query["n"] == "2" && at.fragment == "top"
			assert locationText(at) == "/docs/a%20b?n=2&tab=ex#top" || locationText(at).startsWith("/docs/a")
			assert parseLocation("docs").path == "/docs"
		}

		// A route's path: its segments, values and listed query; the paths that do not read.
		@test()
		def TestPatterns() !none {
			let pattern = try parsePattern("/docs/\{name\}?tab&count")
			assert pattern.segments.len() == 2 && pattern.params.join(",") == "name" && pattern.query.join(",") == "tab,count"
			let values = matchPattern(pattern, parseLocation("/docs/units?tab=ex&other=1"))
			assert !(values is none)
			if !(values is none) {
				assert values["name"] == "units" && values["tab"] == "ex" && !values.hasKey("other")
			}
			assert matchPattern(pattern, parseLocation("/docs")) is none
			assert !(matchPattern(try parsePattern("/docs"), parseLocation("/docs/units"), prefix = true) is none)
			let bad = parsePattern("docs") onerror recover RoutePattern{segments: [], params: [], query: []}
			assert bad.segments.len() == 0
			let twelve = routeInt("12")
			assert !(twelve is none) && twelve == 12 && routeInt("1x") is none && routeInt("") is none
			let yes = routeBool("true")
			assert !(yes is none) && yes && routeBool("yes") is none
			let big = routeFloat("1.5e3")
			assert !(big is none) && big == 1500.0 && routeFloat("1.2.3") is none
		}

		// The pages the build found, the page for each location inside its layout, a
		// fixed segment before a value, a value that does not convert, back and forward,
		// and a link going through the router.
		@test()
		def TestRoutes() {
			assert declaredRoutes().len() == 5
			let site = Site()
			let scene = new Scene(site)
			let size = new Size<Pixels>(400(px), 300(px))
			scene.arrange(size)
			scene.arrange(size)
			let routes = site.children[0]
			assert routes is Routes
			if routes is Routes {
				let router = routes.routerOf()
				assert textsUnder(routes).join(",") == "home"
				router.go("/docs/units?tab=ex&count=3")
				scene.arrange(size)
				assert textsUnder(routes).join(",") == "docs,units:ex:3"
				router.go("/docs/new")
				scene.arrange(size)
				assert textsUnder(routes).join(",") == "docs,new"
				router.go("/docs/units?count=x")
				scene.arrange(size)
				assert textsUnder(routes).join(",") == "missing" && routes.missing
				router.back()
				scene.arrange(size)
				assert textsUnder(routes).join(",") == "docs,new" && router.canGoBack
				router.forward()
				router.go("/")
				scene.arrange(size)
				// The home page's link goes to its location.
				let home = routes.childNodes[0]
				let link = home.find<Link>()
				assert !(link is none)
				if !(link is none) {
					link.click()
					scene.arrange(size)
					assert router.location.path == "/docs/units" && textsUnder(routes).join(",") == "docs,units:overview:1"
				}
			}
			scene.close()
		}

		// A scroller that keeps its position is scrolled back when its entry is gone back
		// to, and starts at the top on a page gone to anew.
		@test()
		def TestScrollKeptPerEntry() {
			let site = Site()
			let scene = new Scene(site)
			let size = new Size<Pixels>(400(px), 300(px))
			scene.arrange(size)
			let routes = site.children[0]
			assert routes is Routes
			if routes is Routes {
				let router = routes.routerOf()
				let scroller = def () ?ScrollView {
					return routes.find<ScrollView>()
				}
				router.go("/list")
				scene.arrange(size)
				let first = scroller()
				assert !(first is none)
				if !(first is none) {
					first.scrollTo(new Point<Pixels>(0(px), 200(px)))
					assert float(first.offset.y) == 200.0
				}
				router.go("/")
				scene.arrange(size)
				assert scroller() is none
				router.back()
				scene.arrange(size)
				scene.arrange(size)
				let back = scroller()
				assert !(back is none)
				if !(back is none) {
					assert float(back.offset.y) == 200.0
				}
				router.go("/list")
				scene.arrange(size)
				scene.arrange(size)
				let fresh = scroller()
				assert !(fresh is none)
				if !(fresh is none) {
					assert float(fresh.offset.y) == 0.0
				}
				router.back()
				scene.arrange(size)
				scene.arrange(size)
				let again = scroller()
				assert !(again is none) && float(again.offset.y) == 200.0
			}
			scene.close()
		}
	}
}
