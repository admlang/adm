@os("wasm")
partial module std.ui.navigation {
	use (
		std.services.browser::Browser
		std.testing
		std.time
		std.ui.navigation.platform::(BrowserHistory, appLocation)
	)

	check "Browser history" {
		// The router's moves write the page's address, relative to the folder it is
		// served from; a replaced entry leaves nothing to go back to.
		@test()
		def TestPushWritesTheAddress() {
			let past = new BrowserHistory()
			assert past.current().path == "/" && !past.canGoBack()
			past.push(parseLocation("/docs/units?tab=ex#top"), false)
			assert appLocation() == "/docs/units?tab=ex#top"
			assert past.canGoBack() && past.current().fragment == "top"
			past.push(parseLocation("/memory"), true)
			assert appLocation() == "/memory" && past.canGoBack()
			assert locationText(past.current()) == "/memory"
		}

		// The browser's back button moves the history and tells the router: the page
		// follows the address.
		@test()
		def TestBackButtonMovesTheRouter() {
			let past = new BrowserHistory()
			let router = new Router(past, [])
			past.push(parseLocation("/first"), false)
			past.push(parseLocation("/second"), false)
			let before = router.version
			// What the button does: the address moves, the history is told after.
			Browser.back() onerror recover none
			for let i = 0; i < 200 && past.current().path != "/first"; i++ {
				time.sleep(10ms)
			}
			assert past.current().path == "/first" && appLocation() == "/first"
			assert router.version > before && router.location.path == "/first"
			// The page is shared by the suite's tests: the address goes back to the start.
			past.push(parseLocation("/"), true)
		}
	}
}
