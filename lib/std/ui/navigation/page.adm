partial module std.ui.navigation {
	use (
		std.gfx.color::Color
		std.ui::(RenderContext, UI)
		std.ui.renderer::Window
		std.ui.styles::*
	)

	// What describes the page it holds: `Page(title = "Units: ADM docs", description =
	// doc.summary) { ... }` shows its content and declares the page's head. On the desktop
	// its `title` is the window's title while it is shown, in place of the one the window
	// has (`UI.setWindowTitle`, `WindowConfig.title`); of pages that hold others the inner
	// one's. The rest describes the page on the web and is not used on the desktop.
	component Page {
		type {
			// The window's title while the page is shown; empty: the window's own.
			@input
			title string = ""

			// One or two sentences on what the page holds.
			@input
			description string = ""

			// The address that stands for the page wherever it is reached from.
			@input
			canonical string = ""

			// A picture that stands for the page where it is shared.
			@input
			image string = ""

			// The language the page is written in, as a BCP 47 tag (`en`, `ro-RO`).
			@input
			language string = ""

			// What search engines may do with the page (`noindex, nofollow`).
			@input
			robots string = ""

			// The colour the browser or system paints around the page.
			@input
			themeColor ?Color = none

			// The window its title was given to, and the title given.
			shownIn  ?Window = none
			declared string = ""

			def attached() {
				declare()
			}

			def detached() {
				let win = shownIn
				return when win is none
				shownIn = none
				UI.setPageTitle(win, self, none) onerror recover none
			}

			// Gives the window its title, when that changed since it was last given: a
			// window that is not served by the `UI` service has none to take.
			def declare() {
				let held = shownIn
				let win = context<Window>()
				win = held unless held is none
				return when win is none || (!(held is none) && declared == title)
				shownIn  = win
				declared = title
				let given ?string = none
				given = title when title != ""
				UI.setPageTitle(win, self, given) onerror recover none
			}

			// Its title is checked whenever it is drawn: what runs after its inputs change.
			def render(ctx RenderContext) {
				declare() unless shownIn is none
				ctx.outerShadows()
				ctx.background()
				ctx.borders()
				ctx.childNodes()
				ctx.innerShadows()
			}
		}

		view {
			children()
		}

		style {
			Box
			Layout
			width  = fill
			height = fill
		}
	}
}
