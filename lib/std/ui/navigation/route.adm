partial module std.ui.navigation {
	use std.reflection::(BuildMetaContext, DiscoveryMetaContext, FunctionMetaContext, SourceField, TypeDescriptor)

	// Makes a component a page at a path, which `Routes` shows for a location that
	// matches it:
	//
	//     @route("/docs/\{name\}?tab")
	//     component DocPage {
	//         type {
	//             @input
	//             name string
	//             @input
	//             tab string = "overview"
	//         }
	//         ...
	//     }
	//
	// A `\{name\}` segment of the path, and each query parameter listed after `?`
	// (`?tab&lang`), fills the component's `@input` of that name, converted to its type
	// (`string`, `int`, `float`, `bool`); a value that does not convert makes the location
	// match nothing. A query parameter the location leaves out keeps the input's
	// default. No other input can be set from a location. The braces are escaped since
	// `{name}` in a string is interpolation.
	//
	// It runs during the build and writes, beside the component, a function that makes
	// it from a location's values, marked with `routeFactory`. A parameter with no
	// `@input` of its name, or of a type a location cannot give, is a build error.
	meta def route(ctx BuildMetaContext<TypeDescriptor>, path string) {
		let pattern = parsePattern(path) onerror (err error) {
			ctx.diagnostics.error(err.message)
			return
		}
		let pageName = ctx.descriptor.node.name
		let inputs = map<string, SourceField>{}
		for let field in ctx.source.fields() {
			for let held in field.annotations {
				inputs[field.name] = field when held.name == "input" || held.name.startsWith("input")
			}
		}
		let required string[]
		let lines string[]
		let wanted = pattern.params.clone()
		wanted.push(...pattern.query)
		for let (i, name) in wanted {
			let field = inputs.get(name)
			if field is none {
				ctx.diagnostics.error("the path \"{path}\" names {name}, which {pageName} has no @input of")
				return
			}
			let read = readerOf(field.typeText)
			if read == "" {
				ctx.diagnostics.error("@input {name} of {pageName} is a {field.typeText}: a location gives a string, int, float or bool")
				return
			}
			let local = "__v{i}"
			let isPath = i < pattern.params.len()
			if isPath {
				lines.push("\t\tlet {local} = {read}(values[\"{name}\"])")
				lines.push("\t\treturn new RoutePage(none) when {local} is none")
				required.push("{name} = {local}")
			} else {
				lines.push("\t\tlet {local}Text = values.get(\"{name}\")")
			}
		}
		let made = "\t\tlet page = {pageName}({required.join(", ")})"
		let after string[]
		for let (i, name) in wanted {
			continue when i < pattern.params.len()
			let read = readerOf(inputs[name].typeText)
			after.push("\t\tif !(__v{i}Text is none) \{\n\t\t\tlet __q{i} = {read}(__v{i}Text)\n\t\t\treturn new RoutePage(none) when __q{i} is none\n\t\t\tpage.{name} = __q{i}\n\t\t\}")
		}
		let escaped = path.replace("\\", "\\\\").replace("\"", "\\\"").replace("\{", "\\\{").replace("\}", "\\\}")
		let code = "\t// The {pageName} page of {escaped}, made from a location's values; none in it when one does not convert.\n\t@routeFactory(\"{escaped}\")\n\tinternal def __route_{pageName}(values map<string, string>) RoutePage \{\n{lines.join("\n")}\n{made}\n{after.join("\n")}\n\t\treturn new RoutePage(page)\n\t\}"
		ctx.source.addDeclaration(code)
	}

	// Marks the function `@route` writes for a page: what `Routes` finds the pages by.
	meta def routeFactory(ctx DiscoveryMetaContext<FunctionMetaContext>, path string) {}

	// The function that reads a value of the type written `typeText` from a location's
	// text; "" for a type a location cannot give.
	internal def readerOf(typeText string) string {
		match typeText.trim() {
			case "string":
				return "routeString"
			case "int":
				return "routeInt"
			case "float":
				return "routeFloat"
			case "bool":
				return "routeBool"
			default:
				return ""
		}
	}

	// A location's text as a string input.
	def routeString(text string) ?string {
		return text
	}

	// A location's text as an int: digits, with a sign; none for anything else.
	def routeInt(text string) ?int {
		let digits = text.startsWith("-") || text.startsWith("+") ?? (text[1:], text)
		return none when digits == "" || digits.len() > 18
		for let c in digits {
			return none unless c >= '0' && c <= '9'
		}
		return text.toInt<int>()
	}

	// A location's text as a float: digits with a sign, a point and an exponent; none for
	// anything else.
	def routeFloat(text string) ?float {
		return none when text == ""
		let (digits, points, exponent) = (0, 0, false)
		for let (i, c) in text {
			if c >= '0' && c <= '9' {
				digits++
			} else if c == '.' && !exponent {
				points++
			} else if (c == 'e' || c == 'E') && !exponent && digits > 0 {
				exponent = true
			} else if (c == '-' || c == '+') && (i == 0 || text[i - 1] == 'e' || text[i - 1] == 'E') {
				continue
			} else {
				return none
			}
		}
		return none when digits == 0 || points > 1
		return parseFloat<float>(text)
	}

	// A location's text as a bool: `true`, `false`, `1` or `0`.
	def routeBool(text string) ?bool {
		match text {
			case "true", "1":
				return true
			case "false", "0":
				return false
			default:
				return none
		}
	}
}
