partial module std.ui.navigation {
	use std.ui.styles::*

	// Shows the page for the current location, at the root of a window's view:
	// `Routes(history = new MemoryHistory("/docs")) { notFound = view { Text("No such page") } }`.
	// It makes the `Router` and gives it to everything under it (`context<Router>()`); the
	// page is the `@route` component whose path matches the location, inside the pages
	// whose paths start it and whose views place an `Outlet`. A location no route takes
	// shows `notFound`.
	component Routes {
		type {
			// Where the window has been; a `MemoryHistory` from `/` without.
			@input
			history ?History = none

			// What shows for a location that no route takes.
			@input
			notFound ?view = none

			router ?Router = none

			// Whether the location matches no page.
			@state
			missing bool = false

			// The router of the window, made when first asked for.
			def routerOf() Router {
				let held = router
				return held unless held is none
				let given = history
				let past History = new MemoryHistory("/")
				past = given unless given is none
				let made = new Router(past, declaredRoutes())
				made.changed = show
				router = made
				return made
			}

			// Places the pages for the location: each outer one holds the next in its
			// `Outlet`; one whose view places none is left out.
			def show() {
				let r = routerOf()
				let chain = r.pagesFor(r.location)
				if chain is none {
					missing = true
					setChildren([])
					return
				}
				missing = false
				let pages = chain
				let inner = pages[pages.len() - 1]
				for let i = pages.len() - 2; i >= 0; i-- {
					let outer = pages[i]
					outer.rerun()
					let outlet = outer.find<Outlet>()
					continue when outlet is none
					outlet.setChildren([inner])
					inner = outer
				}
				setChildren([inner])
			}

			def attached() {
				show() when childNodes.len() == 0 && !missing
			}
		}

		view {
			provide(routerOf())
			children()
			if missing && !(notFound is none) {
				notFound()
			}
		}

		style {
			Box
			Layout
			width  = fill
			height = fill
		}
	}

	// Where a page that holds others shows the deeper page: `@route("/docs") component
	// DocsLayout { view { Sidebar(); Outlet() } }` shows `/docs/units` inside it.
	component Outlet {
		type {}

		view {
			children()
		}

		style {
			Box
			Layout
			width  = fill
			height = fill
		}
	}
}
