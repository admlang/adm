partial module std.ui.navigation {
	use (
		std.ui.navigation.platform::defaultHistory
		std.ui.styles::*
	)

	// Shows the page for the current location, at the root of a window's view:
	// `Routes(history = new MemoryHistory("/docs")) { notFound = view { Text("No such page") } }`.
	// It makes the `Router` and gives it to everything under it (`context<Router>()`); the
	// page is the `@route` component whose path matches the location, inside the pages
	// whose paths start it and whose views place an `Outlet`. A location no route takes
	// shows `notFound`. A location with a fragment at the path and query shown keeps the
	// pages, as a browser keeps a page for a link to a part of it (`/docs#intro`); any
	// other location, the same one again included, makes them anew. After each change
	// `located` tells the pages where they are, so one can scroll to the part the
	// fragment names.
	component Routes {
		type {
			// Where the window has been. Without: on the web the browser's history, whose
			// address the page shows; elsewhere a `MemoryHistory` from `/`.
			@input
			history ?History = none

			// What shows for a location that no route takes.
			@input
			notFound ?view = none

			router ?Router = none
			// The location the pages placed last were made for.
			placed ?Location = none

			// Whether the location matches no page.
			@state
			missing bool = false

			// The router of the window, made when first asked for.
			def routerOf() Router {
				let held = router
				return held unless held is none
				let given = history
				let past History = defaultHistory()
				past = given unless given is none
				let made = new Router(past, declaredRoutes())
				made.changed = show
				router = made
				return made
			}

			// Places the pages for the location: each outer one holds the next in its
			// `Outlet`; one whose view places none is left out.
			def show() {
				let r = routerOf()
				let at = r.location
				let before = placed
				if !(before is none) && !missing && childNodes.len() > 0 && at.fragment != "" && samePlace(before, at) {
					placed = at
					let _ = located(at)
					return
				}
				placed = at
				let chain = r.pagesFor(at)
				if chain is none {
					missing = true
					setChildren([])
					let _ = located(at)
					return
				}
				missing = false
				let pages = chain
				let inner = pages[pages.len() - 1]
				for let i = pages.len() - 2; i >= 0; i-- {
					let outer = pages[i]
					// Its view runs before it is in the tree: one that reads the router
					// finds it on the page itself.
					outer.provide(r)
					outer.rerun()
					let outlet = outer.find<Outlet>()
					continue when outlet is none
					outlet.setChildren([inner])
					inner = outer
				}
				setChildren([inner])
				// The outer pages' views ran before they were in the window, where what
				// they read of it (`viewport`, what is provided above) was not there yet:
				// they run again in it.
				redraw()
				let _ = located(at)
			}

			// The location shown now, after a change: heard with `@on(Routes.located)`. A
			// page placed for it is in the tree, not laid out yet.
			@emit()
			def located(at Location) Location {
				return at
			}

			def attached() {
				show() when childNodes.len() == 0 && !missing
			}
		}

		view {
			provide(routerOf())
			children()
			if missing && !(notFound is none) {
				notFound()
			}
		}

		style {
			Box
			Layout
			width  = fill
			height = fill
		}
	}

	// Where a page that holds others shows the deeper page: `@route("/docs") component
	// DocsLayout { view { Sidebar(); Outlet() } }` shows `/docs/units` inside it.
	component Outlet {
		type {}

		view {
			children()
		}

		style {
			Box
			Layout
			width  = fill
			height = fill
		}
	}

	// Whether two locations are one place: the same path and query, whatever their
	// fragments.
	internal def samePlace(a Location, b Location) bool {
		return false when a.path != b.path || a.query.len() != b.query.len()
		for let (name, value) in a.query {
			let other = b.query.get(name)
			return false when other is none || other != value
		}
		return true
	}
}
