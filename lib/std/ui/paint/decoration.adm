// Draws a laid-out tree of layout nodes on a canvas: shadows, backgrounds, borders, children
// and outlines, with each node's clip, mask, opacity, blend, filters and transform around
// them. The order and the rules are those of
// docs/requirements/ui/views-controllers/custom-render.md and styles/effects-and-transform.md.
internal partial module std.ui.paint {
	use (
		std.gfx.canvas
		std.gfx.color::(BlendMode, Color, Transparent)
		std.math.geom::(Corners, Edges)
		std.ui.layout::Node
		std.ui.styles::*
		std.units::(Extent, Pixels)
	)

	// What a node is painted with: the values of its paint style properties after the cascade.
	// A node without one draws nothing itself; its children are still drawn. The values
	// that say how far the node draws outside its border box, or what of it can show
	// (`shadows`, `outline`, `border`, `filters`, `transform`, `clip`, `text`), tell the
	// node when they are assigned (`Node.reachChanged`), so a drawing that left the node
	// out as unable to show reads it again.
	type Decoration {
		// The node it is painted on (`Node.decoration`), told of those changes.
		weak node  ?Node
		// `Shape.radius`. Under RightToLeft the left and right corners swap.
		radius     Corners<Extent> = new Corners<Extent>(0(px))
		// `Shape.corners`. Cut and Smooth are drawn as Round.
		corners    CornerShape     = CornerShape.Round
		// `Background.background`. A paint's coordinates are pixels from the top-left of the
		// border box, whatever `area` is.
		background BackgroundFill  = new BackgroundFill([])

		// `Borders.border`. Under RightToLeft the left and right sides swap.
		border Edges<Border> {
			value Edges<Border> = new Edges<Border>(Border{width: 0(px), paint: new Color(Transparent)})

			def get() Edges<Border> {
				return value
			}

			def set(sides Edges<Border>) {
				value = sides
				reachChanged()
			}
		}
		// `Borders.borderImage`.
		borderImage ?NineSlice = none

		// `Outline.outline`.
		outline Ring {
			value Ring = Ring{}

			def get() Ring {
				return value
			}

			def set(ring Ring) {
				value = ring
				reachChanged()
			}
		}
		// `Shadows.shadows`.
		shadows Shadow[] {
			value Shadow[] = []

			def get() Shadow[] {
				return value
			}

			def set(list Shadow[]) {
				value = list
				reachChanged()
			}
		}
		// `Filters.filters`.
		filters Filter[] {
			value Filter[] = []

			def get() Filter[] {
				return value
			}

			def set(list Filter[]) {
				value = list
				reachChanged()
			}
		}
		// `Backdrop.backdrop`. Only blurs are drawn.
		backdrop Filter[]  = []
		// `Compositing.opacity`.
		opacity  float     = 1.0
		// `Compositing.blend`.
		blend    BlendMode = BlendMode.Normal

		// `Transforms.transform`.
		transform Transform {
			value Transform = Transform{}

			def get() Transform {
				return value
			}

			def set(turn Transform) {
				value = turn
				reachChanged()
			}
		}
		// `Clipping.clip`.
		clip bool {
			value bool

			def get() bool {
				return value
			}

			def set(on bool) {
				value = on
				reachChanged()
			}
		}
		// `Clipping.mask`. The paint's coordinates are pixels from the top-left of the border
		// box.
		mask ?Paint = none

		// The node's text, drawn in its content box before its children. Set it with
		// `setText`. The block is told whose it is, so that its changes reach the node.
		text ?TextBlock {
			value ?TextBlock = none

			def get() ?TextBlock {
				return value
			}

			def set(block ?TextBlock) {
				value = block
				block.node = node unless block is none
				reachChanged()
			}
		}
		// `Interaction.hitTest`.
		hitTest   HitTest       = HitTest.Box
		// `Interaction.hitSlop`. Not mirrored under RightToLeft.
		hitSlop   Edges<Pixels> = new Edges<Pixels>(0(px))
		// `Interaction.minTarget`.
		minTarget Pixels        = 0(px)

		// Takes the node it is painted on, none when it leaves it; the text block follows.
		def attach(to ?Node) {
			node = to
			let block = text
			block.node = to unless block is none
		}

		// Tells the node that what the decoration draws outside the border box, or lets
		// show of what is under it, may have changed.
		def reachChanged() {
			let held = node
			held.reachChanged() unless held is none
		}

		// The space each border side takes, for the node's `border`: a side whose line style
		// is None takes none.
		def borderWidths() Edges<Pixels> {
			return new Edges<Pixels>(sideWidth(border.top) * 1(px), sideWidth(border.right) * 1(px), sideWidth(border.bottom) * 1(px), sideWidth(border.left) * 1(px))
		}
	}

	// The width a border side is drawn with and takes in layout.
	def sideWidth(side Border) float {
		return 0.0 when side.lineStyle == LineStyle.None
		return float(side.width).max(0.0)
	}
}
