// Draws a laid-out tree of layout nodes on a canvas: shadows, backgrounds, borders, children
// and outlines, with each node's clip, mask, opacity, blend, filters and transform around
// them. The order and the rules are those of
// docs/requirements/ui/views-controllers/custom-render.md and styles/effects-and-transform.md.
internal partial module std.ui.paint {
	use (
		std.gfx.canvas
		std.gfx.color::(BlendMode, Color, Transparent)
		std.math.geom::(Corners, Edges)
		std.ui.styles::*
		std.units::(Extent, Pixels)
	)

	// What a node is painted with: the values of its paint style properties after the cascade.
	// A node without one draws nothing itself; its children are still drawn.
	type Decoration {
		// `Shape.radius`. Under RightToLeft the left and right corners swap.
		radius      Corners<Extent> = new Corners<Extent>(0(px))
		// `Shape.corners`. Cut and Smooth are drawn as Round.
		corners     CornerShape     = CornerShape.Round
		// `Background.background`. A paint's coordinates are pixels from the top-left of the
		// border box, whatever `area` is.
		background  BackgroundFill  = new BackgroundFill([])
		// `Borders.border`. Under RightToLeft the left and right sides swap.
		border      Edges<Border>   = new Edges<Border>(Border{width: 0(px), paint: new Color(Transparent)})
		// `Borders.borderImage`.
		borderImage ?NineSlice      = none
		// `Outline.outline`.
		outline     Ring            = Ring{}
		// `Shadows.shadows`.
		shadows     Shadow[]        = []
		// `Filters.filters`.
		filters     Filter[]        = []
		// `Backdrop.backdrop`. Only blurs are drawn.
		backdrop    Filter[]        = []
		// `Compositing.opacity`.
		opacity     float           = 1.0
		// `Compositing.blend`.
		blend       BlendMode       = BlendMode.Normal
		// `Transforms.transform`.
		transform   Transform       = Transform{}
		// `Clipping.clip`.
		clip        bool            = false
		// `Clipping.mask`. The paint's coordinates are pixels from the top-left of the border
		// box.
		mask        ?Paint          = none

		// The node's text, drawn in its content box before its children. Set it with
		// `setText`.
		text      ?TextBlock    = none
		// `Interaction.hitTest`.
		hitTest   HitTest       = HitTest.Box
		// `Interaction.hitSlop`. Not mirrored under RightToLeft.
		hitSlop   Edges<Pixels> = new Edges<Pixels>(0(px))
		// `Interaction.minTarget`.
		minTarget Pixels        = 0(px)

		// The space each border side takes, for the node's `border`: a side whose line style
		// is None takes none.
		def borderWidths() Edges<Pixels> {
			return new Edges<Pixels>(sideWidth(border.top) * 1(px), sideWidth(border.right) * 1(px), sideWidth(border.bottom) * 1(px), sideWidth(border.left) * 1(px))
		}
	}

	// The width a border side is drawn with and takes in layout.
	def sideWidth(side Border) float {
		return 0.0 when side.lineStyle == LineStyle.None
		return float(side.width).max(0.0)
	}
}
