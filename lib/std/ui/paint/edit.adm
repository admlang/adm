internal partial module std.ui.paint {
	use (
		std.gfx.canvas
		std.text.unicode
	)

	// The text, the caret and the selection of an edit at one moment.
	struct EditState {
		text   string
		caret  int
		anchor int
	}

	// The text of an editable field with its caret and selection, and the edits a keyboard
	// makes on it. Positions are character indices, as `string.len` and slices count
	// them, and always lie between two user-perceived characters.
	type TextEdit {
		text      string
		// Where typing goes, and the other end of the selection: the same when nothing is
		// selected.
		caret     int
		anchor    int
		// Where each user-perceived character of `text` ends, found when first asked for
		// after the text changed. Change the text with `set` and `insert`.
		ends      int[]
		known     bool
		// What the text, the caret and the selection were before each change, the latest
		// last, and what `undo` took back, for `redo`.
		past      EditState[]
		ahead     EditState[]
		// Whether the last change was one typed character, and where it ended: the next
		// one typed there joins it, so `undo` takes back a word and not a letter.
		typing    bool
		typed     int
		// What an input method is composing at the caret, not yet part of `text`, and
		// where its own caret is in it; "" when nothing is composed.
		composing string
		composeAt int

		def new(text string = "") {
			self.text = text
			caret = text.len()
			anchor = caret
		}

		// Replaces the whole text; the caret goes to its end.
		def set(text string) {
			self.text = text
			known = false
			past = []
			ahead = []
			typing = false
			caret = text.len()
			anchor = caret
		}

		// The selection, its lower end first.
		def range() (int, int) {
			return caret < anchor ?? ((caret, anchor), (anchor, caret))
		}

		def hasSelection() bool {
			return caret != anchor
		}

		// What is drawn for the text: `text` with what is being composed at the caret.
		def shown() string {
			return text when composing == ""
			return text[:caret] + composing + text[caret:]
		}

		// Where the caret before character `index` of `text` stands in what `shown`
		// gives: after what is being composed when that is behind it. The caret itself
		// stands where the input method has it in the composition.
		def drawn(index int) int {
			return index when composing == ""
			return index + composing.len() when index > caret
			return index + composeAt when index == caret
			return index
		}

		// The place in `text` of a caret position of what `shown` gives: one inside what
		// is being composed is the caret's.
		def written(at int) int {
			return at when composing == "" || at <= caret
			return (at - composing.len()).max(caret)
		}

		// Takes what an input method is composing: `piece` shows at the caret until it
		// is inserted or taken back (an empty `piece`), and takes the place of the
		// selection. `at` is where the method's caret is in it; negative or past its
		// end: at its end. True when a selection was erased for it.
		def compose(piece string, at int) bool {
			let erased = piece != "" && composing == "" && hasSelection() && erase(false)
			composing = piece
			composeAt = at < 0 || at > piece.len() ?? (piece.len(), at)
			return erased
		}

		// The selected text; empty when nothing is selected.
		def selected() string {
			let (from, to) = range()
			return text[from:to]
		}

		// Puts `piece` in place of the selection, or at the caret, and leaves the caret
		// after it.
		def insert(piece string) {
			composing = ""
			let (from, to) = range()
			// A character typed right after the last one, inside a word, belongs to the
			// same step back; anything else starts a new one.
			let joins = typing && from == to && from == typed && piece.len() == 1 && !blank(piece)
			keep() unless joins
			typing = from == to && piece.len() == 1
			typed = from + piece.len()
			text = text[:from] + piece + text[to:]
			known = false
			caret = from + piece.len()
			anchor = caret
		}

		// Removes the selection; with none, the character (or the word) after the caret
		// when `forward`, else the one before it. False when there was nothing to remove.
		def erase(forward bool, word bool = false) bool {
			if !hasSelection() {
				let to = step(forward, word)
				return false when to == caret
				// What `undo` brings back has the caret where it was, nothing selected.
				keep()
				typing = false
				let (from, end) = to < caret ?? ((to, caret), (caret, to))
				text = text[:from] + text[end:]
				known = false
				caret = from
				anchor = from
				return true
			}
			insert("")
			return true
		}

		// Notes the state before a change; what was taken back can no longer come again.
		def keep() {
			past.push(EditState{text: text, caret: caret, anchor: anchor})
			past.remove(0) when past.len() > 200
			ahead = []
		}

		// Takes the last change back. False when there is none.
		def undo() bool {
			return false when past.len() == 0
			ahead.push(EditState{text: text, caret: caret, anchor: anchor})
			restore(past[past.len() - 1])
			past.remove(past.len() - 1)
			return true
		}

		// Makes the change `undo` took back again. False when there is none.
		def redo() bool {
			return false when ahead.len() == 0
			past.push(EditState{text: text, caret: caret, anchor: anchor})
			restore(ahead[ahead.len() - 1])
			ahead.remove(ahead.len() - 1)
			return true
		}

		def restore(state EditState) {
			text = state.text
			caret = state.caret
			anchor = state.anchor
			known = false
			typing = false
		}

		// Moves the caret to `to`, kept inside the text and off the middle of a character;
		// with `extend` the other end of the selection stays where it is.
		def move(to int, extend bool = false) {
			typing = false
			caret = settle(to)
			anchor = caret unless extend
		}

		// Where each user-perceived character ends.
		def breaks() int[] {
			return ends when known
			ends = unicode.graphemeBreaks(text)
			known = true
			return ends
		}

		// How many characters end at or before `index`.
		def endsUpTo(index int) int {
			let all = breaks()
			let (low, high) = (0, all.len())
			for low < high {
				let middle = (low + high) / 2
				if all[middle] <= index {
					low = middle + 1
				} else {
					high = middle
				}
			}
			return low
		}

		// The position one character away from the caret, or one word with `word`: the
		// start of the word before it, the end of the word after it.
		def step(forward bool, word bool = false) int {
			if !word {
				let all = breaks()
				if forward {
					let after = endsUpTo(caret)
					return after < all.len() ?? (all[after], text.len())
				}
				// The last character end before the caret, or the start of the text.
				let before = endsUpTo(caret - 1)
				return before > 0 ?? (all[before - 1], 0)
			}
			let words = unicode.wordBreaks(text)
			if forward {
				let from = caret
				for let end in words {
					continue when end <= caret
					// A stretch of spaces is passed over on the way to the next word.
					if blank(text[from:end]) {
						from = end
						continue
					}
					return end
				}
				return text.len()
			}
			let found = 0
			let start = 0
			for let end in words {
				break when start >= caret
				found = start unless blank(text[start:end])
				start = end
			}
			return found
		}

		// Selects everything.
		def selectAll() {
			anchor = 0
			caret = text.len()
		}

		// Selects the word, or the stretch between words, that holds `index`.
		def selectWord(index int) {
			let start = 0
			for let end in unicode.wordBreaks(text) {
				if index < end || end == text.len() {
					anchor = start
					caret = end
					return
				}
				start = end
			}
		}

		// `index` inside the text and at the start of a user-perceived character.
		def settle(index int) int {
			return 0 when index <= 0
			return text.len() when index >= text.len()
			let before = endsUpTo(index)
			return before > 0 ?? (breaks()[before - 1], 0)
		}
	}

	// Whether the text is nothing but spaces.
	def blank(text string) bool {
		return text.trim().len() == 0
	}

	// Where a caret can stand in a block's text as it is set in a width: for every line, the
	// character index of each position and its distance from the block's left edge. The
	// text is taken as set left to right; a caret inside a ligature stands at the
	// ligature's end. A position at the end of a line that is also the start of the next
	// (a line the width broke) shows on the next.
	type CaretMap {
		lines canvas.TextLine[]
		// The positions of every line, one line after the other.
		stops int[]
		xs    float[]
		// Where each line's positions start in those; the count of them all comes last.
		first int[]

		def new(block TextBlock, width float = 0.0) {
			let text = block.text
			lines = block.paragraph(width).lines()
			if lines.len() == 0 {
				stops = [0]
				xs = [0.0]
				first = [0, 1]
				return
			}
			let breaks = unicode.graphemeBreaks(text)
			// The byte each position starts at: glyphs name their text by byte.
			let bytes = 0
			let next = 0
			let glyph = 0
			let edge = 0.0
			let line = -1
			for let (i, ch) in text {
				for line + 1 < lines.len() && lines[line + 1].start <= i {
					line++
					glyph = 0
					edge = open(line)
				}
				let code = int(ch)
				bytes += code < 0x80 ?? (1, code < 0x800 ?? (2, code < 0x10000 ?? (3, 4)))
				continue when next >= breaks.len() || i + 1 != breaks[next]
				next++
				let glyphs = lines[line].glyphs
				for glyph < glyphs.len() && glyphs[glyph].cluster < bytes {
					edge = glyphs[glyph].x + glyphs[glyph].advance
					glyph++
				}
				stops.push(i + 1)
				xs.push(glyph < glyphs.len() ?? (glyphs[glyph].x, edge))
			}
			// A text that ends with a newline ends with an empty line.
			for line + 1 < lines.len() {
				line++
				let _ = open(line)
			}
			first.push(stops.len())
		}

		// Starts the positions of `line` with the one at its start; returns where that is.
		def open(line int) float {
			let glyphs = lines[line].glyphs
			let x = glyphs.len() > 0 ?? (glyphs[0].x, lines[line].left)
			first.push(stops.len())
			stops.push(lines[line].start)
			xs.push(x)
			return x
		}

		// How many lines it has: one for an empty text.
		def count() int {
			return first.len() - 1
		}

		// The line the caret before character `index` shows on.
		def lineOf(index int) int {
			// The last line that starts at or before the index.
			let (low, high) = (0, lines.len())
			for low < high {
				let middle = (low + high) / 2
				if lines[middle].start <= index {
					low = middle + 1
				} else {
					high = middle
				}
			}
			return (low - 1).max(0)
		}

		// How far from the left edge the caret before character `index` stands, and its line.
		def place(index int) (float, int) {
			let line = lineOf(index)
			// The last of the line's positions at or before the index.
			let (low, high) = (first[line], first[line + 1])
			for low < high {
				let middle = (low + high) / 2
				if stops[middle] <= index {
					low = middle + 1
				} else {
					high = middle
				}
			}
			return (xs[(low - 1).max(first[line])], line)
		}

		// The caret position of `line` nearest `x`, a distance from the left edge.
		def at(line int, x float) int {
			let from = first[line]
			let best = stops[from]
			let least = (xs[from] - x).abs()
			for let i = from + 1; i < first[line + 1]; i++ {
				// That position shows on the next line.
				break when line + 1 < lines.len() && stops[i] >= lines[line + 1].start
				let away = (xs[i] - x).abs()
				if away < least {
					least = away
					best = stops[i]
				}
			}
			return best
		}

		// The line at `y`, a distance from the top of the first line: the first above it,
		// the last below it.
		def lineAt(y float) int {
			for let (i, line) in lines {
				return i when y < line.bottom
			}
			return (lines.len() - 1).max(0)
		}

		// The top and the bottom of `line` from the top of the first; `high` for the one
		// line of an empty text.
		def rows(line int, high float) (float, float) {
			return (0.0, high) when line >= lines.len()
			return (lines[line].top, lines[line].bottom)
		}
	}
}
