internal partial module std.ui.paint {
	use (
		std.testing
		std.ui::Limit
		std.ui.styles::*
	)

	check "TextEdit" {
		// Typing, erasing and replacing a selection.
		@test()
		def TestEdits() {
			let edit = new TextEdit("hello")
			assert edit.caret == 5 && !edit.hasSelection()
			edit.insert(" world")
			assert edit.text == "hello world" && edit.caret == 11
			assert edit.erase(false) && edit.text == "hello worl"
			edit.move(0)
			assert !edit.erase(false) && edit.erase(true) && edit.text == "ello worl" && edit.caret == 0
			edit.move(4, true)
			let (from, to) = edit.range()
			assert edit.selected() == "ello" && from == 0 && to == 4
			edit.insert("J")
			assert edit.text == "J worl" && edit.caret == 1 && !edit.hasSelection()
			edit.selectAll()
			assert edit.erase(false) && edit.text == "" && !edit.erase(true)
		}

		// The caret moves by user-perceived characters and by words, never into one.
		@test()
		def TestSteps() {
			let edit = new TextEdit("café au  lait")
			assert edit.text.len() == 14
			edit.move(3)
			assert edit.step(true) == 5 && edit.step(false) == 2
			edit.move(4)
			assert edit.caret == 3
			edit.move(0)
			assert edit.step(true, true) == 5
			edit.move(5)
			assert edit.step(true, true) == 8 && edit.step(false, true) == 0
			edit.move(8)
			assert edit.step(true, true) == 14 && edit.step(false, true) == 6
			edit.move(14)
			assert edit.step(true) == 14 && edit.step(false, true) == 10
			assert edit.erase(false, true) && edit.text == "café au  "
			edit.selectWord(7)
			assert edit.selected() == "au"
			edit.move(99)
			assert edit.caret == edit.text.len()
		}

		// Caret positions on the set line grow with the index, and a point finds the
		// nearest one.
		@test()
		def TestCaretPlaces() {
			let block = new TextBlock("hello", Font{family: "system-ui"})
			block.layout.wrap = Wrap.None
			let width = float(block.measure(Limit{}).width)
			let map = new CaretMap(block)
			let x = def (index int) float {
				let (across, _) = map.place(index)
				return across
			}
			assert x(0) == 0.0 && x(5) > width - 2.0 && x(5) <= width + 0.5
			assert x(2) > x(1) && x(3) > x(2)
			assert map.at(0, -5.0) == 0 && map.at(0, width + 40.0) == 5
			assert map.at(0, x(3) + 0.4) == 3
		}

		// In a text of several lines every line has its own positions: an index finds its
		// line, a point its index, and a text that ends with a newline ends with an empty
		// line.
		@test()
		def TestCaretMap() {
			let block = new TextBlock("one\ntwo\n", Font{family: "system-ui"})
			let map = new CaretMap(block, 400.0)
			assert map.count() == 3
			let (startX, startLine) = map.place(0)
			let (endX, endLine) = map.place(3)
			let (nextX, nextLine) = map.place(4)
			let (lastX, lastLine) = map.place(8)
			assert startX == 0.0 && startLine == 0 && endLine == 0 && endX > 10.0
			assert nextX == 0.0 && nextLine == 1 && lastX == 0.0 && lastLine == 2
			// Past the end of a line is before its newline, not on the next line.
			assert map.at(0, 900.0) == 3 && map.at(1, 900.0) == 7 && map.at(1, -4.0) == 4 && map.at(2, 50.0) == 8
			let (top, bottom) = map.rows(1, 0.0)
			assert map.lineAt(-3.0) == 0 && map.lineAt((top + bottom) / 2.0) == 1 && map.lineAt(900.0) == 2

			// A line the width broke: the position at the break shows on the next line.
			let long = new TextBlock("aaaa bbbb cccc dddd", Font{family: "system-ui"})
			let narrow = new CaretMap(long, float(long.measure(Limit{}).width) / 2.0)
			assert narrow.count() >= 2
			let second = narrow.lines[1].start
			let (brokenX, brokenLine) = narrow.place(second)
			assert brokenLine == 1 && brokenX == 0.0 && narrow.at(0, 900.0) < second

			let nothing = new CaretMap(new TextBlock("", Font{family: "system-ui"}))
			let (x, line) = nothing.place(0)
			assert nothing.count() == 1 && x == 0.0 && line == 0 && nothing.at(0, 30.0) == 0
		}
		// Undo takes back a typed word with the space before it, an erase and a paste each
		// as one step;
		// redo brings them again, until something new is typed.
		@test()
		def TestUndo() {
			let edit = new TextEdit("")
			for let (_, ch) in "hi you" {
				edit.insert("{ch}")
			}
			assert edit.text == "hi you" && !edit.redo()
			// A space starts a step and the word after it joins that step.
			assert edit.undo() && edit.text == "hi"
			assert edit.undo() && edit.text == "" && !edit.undo()
			assert edit.redo() && edit.redo() && edit.text == "hi you" && edit.caret == 6

			// An erase comes back with the caret where it was and nothing selected.
			edit.move(2)
			assert edit.erase(false) && edit.text == "h you"
			assert edit.undo() && edit.text == "hi you" && edit.caret == 2 && !edit.hasSelection()

			// A selection replaced is one step; typing after an undo drops what was ahead.
			edit.move(0)
			edit.move(2, true)
			edit.insert("hello")
			assert edit.text == "hello you"
			assert edit.undo() && edit.text == "hi you" && edit.selected() == "hi"
			edit.insert("x")
			assert edit.text == "x you" && !edit.redo()

			// A text set from outside starts with nothing to take back.
			edit.set("new")
			assert !edit.undo()
		}
	}
}
