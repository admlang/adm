internal partial module std.ui.paint {
	use (
		std.math.geom::(Point, Size, Transform2D)
		std.ui.layout::Node
		std.ui.styles::*
		std.units::Pixels
	)

	// The node drawn topmost under `at`, a point of the window in logical pixels, or none.
	// It follows what `paint` draws: layers top down, in a layer the node drawn last first,
	// children before their parent, each node through its transform. A child is only hit
	// inside the padding box of an ancestor that clips; a subtree in a layer of its own is
	// not held by its ancestors' clips. A node is hit over its border box with its corners,
	// grown by `hitSlop` and to `minTarget`, as its `hitTest` allows; one that is not
	// visible is never hit, one at opacity 0 is. Outlines and shadows are not hit.
	//
	// `known` is `layerRoots(root)` when the caller kept it since the tree was laid out;
	// without it the tree is walked for them.
	def hit(root Node, at Point<Pixels>, window Size<Pixels>, scale float = 1.0, known ?LayerRoot[] = none) ?Node {
		return none when !root.box.visible || scale <= 0.0
		let measure = new Measure(float(window.width), float(window.height), scale)
		let roots LayerRoot[]
		if known is none {
			roots = layerRoots(root)
		} else {
			roots = known
		}
		let (x, y) = (float(at.x), float(at.y))
		for let i = layerOrder.len() - 1; i >= 0; i-- {
			let layer = layerOrder[i]
			for let j = roots.len() - 1; j >= 0; j-- {
				let entry = roots[j]
				continue when entry.layer != layer
				let parent = entry.node.parent
				if parent is none {
					let found = hitNode(measure, entry.node, layer, x, y, 0.0, 0.0)
					return found unless found is none
					continue
				}
				let inverse = undo(world(measure, parent))
				continue when inverse is none
				let found = hitNode(measure, entry.node, layer, inverse.a * x + inverse.c * y + inverse.tx, inverse.b * x + inverse.d * y + inverse.ty, measure.snap(float(parent.geom.frame.left)), measure.snap(float(parent.geom.frame.top)))
				return found unless found is none
			}
		}
		return none
	}

	// The nodes that start a layer: the root, then those under it drawn in another layer
	// than their parent, in tree order. They change only when the tree, a `layer` or a
	// `visible` does.
	def layerRoots(root Node) LayerRoot[] {
		let roots LayerRoot[] = [LayerRoot{node: root, layer: root.box.layer}]
		collect(root, root.box.layer, roots)
		return roots
	}

	// The transform that undoes `transform`, or none when it flattens everything to a line
	// or a point.
	def undo(transform Transform2D) ?Transform2D {
		let determinant = transform.a * transform.d - transform.b * transform.c
		return none when determinant == 0.0
		return transform.inverse()
	}

	// The node under (`x`, `y`) in `node` or below it in `layer`. The point is in the
	// coordinates of the node's parent, whose border box starts at (`parentLeft`,
	// `parentTop`) in the window.
	def hitNode(measure Measure, node Node, layer Layer, x float, y float, parentLeft float, parentTop float) ?Node {
		let decoration = node.decoration
		let test = HitTest.Box
		test = decoration.hitTest unless decoration is none
		return none when test == HitTest.None
		let (
			left = measure.snap(float(node.geom.frame.left))
			top  = measure.snap(float(node.geom.frame.top))
		)
		// A node without a transform of its own is only moved to its place: no matrix
		// is built or inverted for it.
		let (ownX, ownY) = (x - (left - parentLeft), y - (top - parentTop))
		if !(decoration is none) {
			let turned = matrixOf(measure, decoration.transform, measure.snap(float(node.geom.frame.right)) - left, measure.snap(float(node.geom.frame.bottom)) - top, node.em)
			if !(turned is none) {
				let inverse = undo(local(measure, node, parentLeft, parentTop))
				return none when inverse is none
				ownX = inverse.a * x + inverse.c * y + inverse.tx
				ownY = inverse.b * x + inverse.d * y + inverse.ty
			}
		}
		let (
			width  = measure.snap(float(node.geom.frame.right)) - left
			height = measure.snap(float(node.geom.frame.bottom)) - top
		)
		// The node's shape (its boxes with their corners) is built only where a plain
		// rectangle cannot answer: most nodes the test passes are answered without it.
		let clipped = false
		clipped = decoration.clip unless decoration is none
		let enter = !clipped
		enter = holds(shapeOf(measure, node).padding, ownX, ownY) when clipped && ownX >= 0.0 && ownX < width && ownY >= 0.0 && ownY < height
		if enter {
			for let i = node.children.len() - 1; i >= 0; i-- {
				let child = node.children[i]
				continue when !child.box.visible
				let own = child.box.layer
				continue when own != Layer.Content && own != layer
				let found = hitNode(measure, child, layer, ownX, ownY, left, top)
				return found unless found is none
			}
		}
		return none when test == HitTest.Children
		if decoration is none {
			// No corners, no slop: the border box.
			return node when ownX >= 0.0 && ownX < width && ownY >= 0.0 && ownY < height
			return none
		}
		let slop = decoration.hitSlop
		let least = float(decoration.minTarget)
		let (
			wider  = ((least - (width + float(slop.left) + float(slop.right))) / 2.0).max(0.0)
			taller = ((least - (height + float(slop.top) + float(slop.bottom))) / 2.0).max(0.0)
		)
		// Outside the rectangle around the hit area: not hit, whatever its corners.
		return none when ownX < -float(slop.left) - wider || ownX >= width + float(slop.right) + wider
		return none when ownY < -float(slop.top) - taller || ownY >= height + float(slop.bottom) + taller
		let area = inset(shapeOf(measure, node).border, -float(slop.top), -float(slop.right), -float(slop.bottom), -float(slop.left))
		area = inset(area, -taller, -wider, -taller, -wider) when wider > 0.0 || taller > 0.0
		return node when holds(area, ownX, ownY)
		return none
	}

	// Whether the point is inside the box, corners included. A corner is a quarter of an
	// ellipse: a point in a corner's square is inside when it is inside that ellipse.
	def holds(box Rounded, x float, y float) bool {
		return false when x < box.left || x >= box.right || y < box.top || y >= box.bottom
		let r = box.radii
		return inCorner(x - (box.left + r[0]), y - (box.top + r[1]), r[0], r[1]) when x < box.left + r[0] && y < box.top + r[1]
		return inCorner(x - (box.right - r[2]), y - (box.top + r[3]), r[2], r[3]) when x >= box.right - r[2] && y < box.top + r[3]
		return inCorner(x - (box.right - r[4]), y - (box.bottom - r[5]), r[4], r[5]) when x >= box.right - r[4] && y >= box.bottom - r[5]
		return inCorner(x - (box.left + r[6]), y - (box.bottom - r[7]), r[6], r[7]) when x < box.left + r[6] && y >= box.bottom - r[7]
		return true
	}

	// Whether a point (`dx`, `dy`) from the centre of a corner's ellipse is inside it.
	def inCorner(dx float, dy float, rx float, ry float) bool {
		return true when rx <= 0.0 || ry <= 0.0
		return (dx * dx) / (rx * rx) + (dy * dy) / (ry * ry) <= 1.0
	}
}
