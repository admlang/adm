internal partial module std.ui.paint {
	use (
		std.gfx.canvas
		std.gfx::Raster
		std.gfx.color::(BlendMode, Color, RGBA)
		std.math.geom::(Corners, Edges, FillRule, Path, Point, Rect, Transform2D)
		std.ui.styles::*
		std.units::Pixels
	)

	// What a shape is filled with when only its coverage matters.
	def solid() Color {
		return new Color(RGBA{r: 0, g: 0, b: 0, a: 255})
	}

	// Filters what is already drawn behind the node, inside its border box, in order:
	// frosted glass, a greyed or tinted backdrop.
	def backdrop(frame Frame, shape BoxShape, decoration Decoration) {
		return when isEmpty(shape.border)
		let effects canvas.Effect[]
		for let filter in decoration.backdrop {
			match filter {
				case canvas.Blur:
					effects.push(canvas.Blur{radius: filter.radius, backdrop: true})
				case canvas.ColorAdjust:
					effects.push(canvas.ColorAdjust{brightness: filter.brightness, contrast: filter.contrast, saturation: filter.saturation, hue: filter.hue, backdrop: true})
				case canvas.ColorMatrix:
					effects.push(canvas.ColorMatrix{values: filter.values, backdrop: true})
			}
		}
		return when effects.len() == 0
		// The group only marks where to filter: at opacity 0 nothing of it is drawn.
		frame.canvas.beginGroup(opacity = 0.0, effects = effects)
		frame.canvas.fill(pathOf(shape.border), solid())
		frame.canvas.endGroup()
	}

	// Draws the shadows and glows that fall outside the border box, the first at the bottom.
	def drawOuterShadows(frame Frame, shape BoxShape, decoration Decoration) {
		for let shadow in decoration.shadows {
			match shadow {
				case canvas.DropShadow:
					castOuter(frame, shape.border, shadow.offset.x, shadow.offset.y, float(shadow.blur), float(shadow.spread), shadow.color, shadow.knockout, BlendMode.Normal)
				case canvas.OuterGlow:
					castOuter(frame, shape.border, 0.0, 0.0, float(shadow.blur), float(shadow.spread), shadow.color, false, shadow.blend)
				default:
			}
		}
	}

	// Draws the background layers, the first at the bottom, each over the box `area` names.
	def drawBackground(frame Frame, shape BoxShape, decoration Decoration) {
		let fill = decoration.background
		return when fill.layers.len() == 0
		let box = shape.border
		match fill.area {
			case BoxArea.Padding:
				box = shape.padding
			case BoxArea.Content:
				box = shape.content
			default:
		}
		return when isEmpty(box)
		if isSquare(box) {
			let area = rectOf(box)
			for let paint in fill.layers {
				frame.canvas.fill(area, paint)
			}
			return
		}
		let outline = pathOf(box)
		for let paint in fill.layers {
			frame.canvas.fill(outline, paint)
		}
	}

	// Draws the four border sides, or the border image in their place.
	def drawBorders(frame Frame, shape BoxShape, decoration Decoration) {
		let widths = shape.widths
		return when isEmpty(shape.border) || widths[0] + widths[1] + widths[2] + widths[3] <= 0.0
		let image = decoration.borderImage
		if !(image is none) {
			borderImage(frame, shape, image)
			return
		}
		let sides = decoration.border
		let left = sides.left
		let right = sides.right
		if shape.rtl {
			left = sides.right
			right = sides.left
		}
		let drawn = new Edges<Border>(
			Border{width: widths[0] * 1(px), paint: sides.top.paint, lineStyle: sides.top.lineStyle},
			Border{width: widths[1] * 1(px), paint: right.paint, lineStyle: right.lineStyle},
			Border{width: widths[2] * 1(px), paint: sides.bottom.paint, lineStyle: sides.bottom.lineStyle},
			Border{width: widths[3] * 1(px), paint: left.paint, lineStyle: left.lineStyle}
		)
		frame.canvas.stroke(rectOf(shape.border), drawn, cornersOf(shape.border))
	}

	// Draws the shadows and glows that fall inside the padding box.
	def drawInnerShadows(frame Frame, shape BoxShape, decoration Decoration) {
		for let shadow in decoration.shadows {
			match shadow {
				case canvas.InnerShadow:
					castInner(frame, shape.padding, shadow.offset.x, shadow.offset.y, float(shadow.blur), float(shadow.choke), shadow.color, BlendMode.Normal)
				case canvas.InnerGlow:
					castInner(frame, shape.padding, 0.0, 0.0, float(shadow.blur), 0.0, shadow.color, shadow.blend)
				default:
			}
		}
	}

	// Draws the ring around the border box, `offset` away from it.
	def outline(frame Frame, shape BoxShape, ring Ring) {
		let width = frame.snapWidth(float(ring.width))
		return when width <= 0.0 || ring.line == LineStyle.None
		let outer = inset(shape.border, -(float(ring.offset) + width))
		return when isEmpty(outer)
		let side = Border{width: width * 1(px), paint: ring.paint, lineStyle: ring.line}
		frame.canvas.stroke(rectOf(outer), new Edges<Border>(side), cornersOf(outer))
	}

	// The horizontal radius of each corner, which is what the canvas rounds a border with.
	def cornersOf(box Rounded) Corners<Pixels> {
		let radii = box.radii
		return new Corners<Pixels>(radii[0] * 1(px), radii[2] * 1(px), radii[4] * 1(px), radii[6] * 1(px))
	}

	// A canvas for one shadow of a box `width` by `height`, with `pad` around it, drawn in
	// the box's coordinates moved so that (`left`, `top`) sits `pad` in.
	def scratchFor(frame Frame, left float, top float, width float, height float, pad float) ?canvas.Canvas {
		let (
			across = int(((width + 2.0 * pad) * frame.scale).ceil())
			down   = int(((height + 2.0 * pad) * frame.scale).ceil())
		)
		return none when across <= 0 || down <= 0
		let scratch = new canvas.Canvas(across, down)
		scratch.scale(frame.scale, frame.scale)
		scratch.translate(pad - left, pad - top)
		return scratch
	}

	// `pad` grown to a whole number of device pixels, so a scratch canvas lands on them.
	def wholePad(frame Frame, pad float) float {
		return (pad * frame.scale).ceil() / frame.scale
	}

	// Fills `outline` on the scratch canvas, blurred by a Gaussian of deviation `sigma`.
	def fillBlurred(scratch canvas.Canvas, outline Path, color Color, sigma float, rule FillRule = FillRule.NonZero) {
		if sigma <= 0.0 {
			scratch.fill(outline, color, rule)
			return
		}
		let effects canvas.Effect[] = [canvas.Blur{radius: sigma * 1(px)}]
		scratch.beginGroup(effects = effects)
		scratch.fill(outline, color, rule)
		scratch.endGroup()
	}

	// Draws a scratch canvas with its top-left at (`left`, `top`), one of its pixels per
	// device pixel. Under a transform that only scales by the device scale and moves, the
	// canvas is handed whole device pixels, which it copies without sampling.
	def drawScratch(frame Frame, scratch canvas.Canvas, left float, top float, blend BlendMode) {
		let target = frame.canvas
		let placed = target.state().transform
		target.save()
		target.setBlend(blend) when blend != BlendMode.Normal
		if placed.b == 0.0 && placed.c == 0.0 && placed.a == frame.scale && placed.d == frame.scale {
			target.setTransform(new Transform2D(tx = placed.a * left + placed.tx, ty = placed.d * top + placed.ty))
			target.drawImage(scratch, new Point(0.0, 0.0))
		} else {
			target.drawImage(scratch, Rect{left: left, top: top, right: left + float(scratch.width) / frame.scale, bottom: top + float(scratch.height) / frame.scale})
		}
		target.restore()
	}

	// The rasters of the shadows drawn lately, so a shadow is blurred once and then only
	// drawn: one raster serves every box of the same size, corners and shadow, in this frame
	// and the following ones. The rasters a frame did not draw are kept, the least recently
	// drawn dropped first, while they hold no more than `budget` bytes: what scrolls out
	// of sight and back is not blurred again.
	type ShadowCache {
		recent map<string, canvas.Canvas> = map<string, canvas.Canvas>{}
		older  map<string, canvas.Canvas> = map<string, canvas.Canvas>{}
		budget int
		// The bytes `older` holds.
		held   int

		// A cache that keeps up to `budget` bytes of rasters no frame is drawing; 0 keeps
		// a raster only to the end of the frame after the one that last drew it.
		def new(budget int = 64 * 1024 * 1024) {
			self.budget = budget
		}

		// The raster kept under `key`, if any.
		def find(key string) ?canvas.Canvas {
			let found = recent.get(key)
			return found unless found is none
			let kept = older.get(key)
			return none when kept is none
			older.delete(key)
			held -= bytesOf(kept)
			recent[key] = kept
			return kept
		}

		def keep(key string, raster canvas.Canvas) {
			recent[key] = raster
		}

		// Ends a frame: the rasters it drew join those kept, the least recently drawn
		// of the latter making room for them.
		def turn() {
			let incoming = 0
			for let (_, raster) in recent {
				incoming += bytesOf(raster)
			}
			for held + incoming > budget && older.len() > 0 {
				for let (key, dropped) in older {
					older.delete(key)
					held -= bytesOf(dropped)
					break
				}
			}
			for let (key, raster) in recent {
				older[key] = raster
			}
			held += incoming
			recent = map<string, canvas.Canvas>{}
		}

		def bytesOf(raster canvas.Canvas) int {
			return raster.width * raster.height * 4
		}
	}

	// What tells one shadow raster of a box from another: the box's size and corners, the
	// device scale and the shadow's numbers.
	def shadowKey(frame Frame, kind string, box Rounded, color Color, numbers ...float) string {
		let rgba = color.rgba
		let key = "{kind} {frame.scale} {box.right - box.left} {box.bottom - box.top} {rgba.r} {rgba.g} {rgba.b} {rgba.a}"
		for let radius in box.radii {
			key += " {radius}"
		}
		for let number in numbers {
			key += " {number}"
		}
		return key
	}

	// The shadow `box` casts below itself: the box grown by `spread`, blurred, moved by
	// (`dx`, `dy`), and with `knockout` cut away where the box is. Along a side longer than
	// its corners and the blur need, the shadow is the same across every point of the
	// straight part: the blur is made for the shortest such box (`sliceSpan`) and the
	// raster of a longer one is put together from it, its corners as they are and its
	// middle stretched (`stitch`), so boxes of one look and any size share one blur. The
	// raster drawn is whole either way, as the renderer is used to.
	def castOuter(frame Frame, box Rounded, dx float, dy float, blur float, spread float, color Color, knockout bool, blend BlendMode) {
		let caster = inset(box, -spread)
		return when isEmpty(caster)
		let sigma = blur.max(0.0) / 2.0
		let pad = wholePad(frame, spread.max(0.0) + 3.0 * sigma + 1.0)
		let key = knockout ?? (shadowKey(frame, "cut", box, color, sigma, spread, dx, dy), shadowKey(frame, "outer", box, color, sigma, spread))
		let (left, top) = (box.left + dx - pad, box.top + dy - pad)
		let kept = frame.shadows.find(key)
		if !(kept is none) {
			drawScratch(frame, kept, left, top, blend)
			return
		}
		let radii = box.radii
		let (width, height) = (box.right - box.left, box.bottom - box.top)
		let across = sliceSpan(frame, pad, radii[0].max(radii[6]).max(radii[2].max(radii[4])), dx)
		let down = sliceSpan(frame, pad, radii[1].max(radii[3]).max(radii[5].max(radii[7])), dy)
		let (alongX, alongY) = (across < width, down < height)
		let small = Rounded{left: box.left, top: box.top, right: box.left + (alongX ?? (across, width)), bottom: box.top + (alongY ?? (down, height)), radii: radii}
		let smallKey = knockout ?? (shadowKey(frame, "cut", small, color, sigma, spread, dx, dy), shadowKey(frame, "outer", small, color, sigma, spread))
		let blurred = frame.shadows.find(smallKey)
		let raster canvas.Canvas
		if blurred is none {
			let fresh = scratchFor(frame, small.left, small.top, small.right - small.left, small.bottom - small.top, pad)
			return when fresh is none
			fillBlurred(fresh, pathOf(inset(small, -spread)), color, sigma)
			if knockout {
				fresh.setComposite(canvas.Composite.DestinationOut)
				fresh.fill(pathOf(small, -dx, -dy), solid())
			}
			// Drawn frame after frame as it is: a renderer keeps its picture by its key.
			fresh.freeze()
			frame.shadows.keep(smallKey, fresh)
			raster = fresh
		} else {
			raster = blurred
		}
		if alongX || alongY {
			let whole = scratchFor(frame, box.left, box.top, width, height, pad)
			return when whole is none
			stitch(whole, raster, alongX, alongY, sliceCorner(frame, pad, across) * frame.scale, sliceCorner(frame, pad, down) * frame.scale)
			whole.freeze()
			frame.shadows.keep(key, whole)
			raster = whole
		}
		drawScratch(frame, raster, left, top, blend)
	}

	// The shortest side of a box whose shadow, put together from its corners
	// (`sliceCorner`) and two device pixels of straight edge between them, gives that of
	// any longer one: the raster's padding left out. A side no longer than that is blurred
	// whole.
	def sliceSpan(frame Frame, pad float, radius float, shift float) float {
		let corner = wholePad(frame, 2.0 * pad + radius + shift.abs())
		return 2.0 * corner + 2.0 / frame.scale - 2.0 * pad
	}

	// The length of a corner part of a shadow raster for a side of `span`: the padding, the
	// corner's radius, the shadow's move and a blur's reach (in `pad`) beyond them, so the
	// part past it sees only straight edges.
	def sliceCorner(frame Frame, pad float, span float) float {
		return (span + 2.0 * pad - 2.0 / frame.scale) / 2.0
	}

	// Fills `whole` (device pixels) with `part`: its corner parts (`cornerX` by `cornerY`
	// device pixels) as they are, the parts between stretched along the axes `alongX` and
	// `alongY` say; along any other axis `part` is as long as `whole`.
	def stitch(whole canvas.Canvas, part canvas.Canvas, alongX bool, alongY bool, cornerX float, cornerY float) {
		let (pw, ph, ww, wh) = (float(part.width), float(part.height), float(whole.width), float(whole.height))
		let sx = alongX ?? (float[0.0, cornerX, pw - cornerX, pw], float[0.0, pw])
		let dx = alongX ?? (float[0.0, cornerX, ww - cornerX, ww], float[0.0, ww])
		let sy = alongY ?? (float[0.0, cornerY, ph - cornerY, ph], float[0.0, ph])
		let dy = alongY ?? (float[0.0, cornerY, wh - cornerY, wh], float[0.0, wh])
		whole.save()
		whole.setTransform(new Transform2D())
		for let j = 0; j + 1 < sy.len(); j++ {
			for let i = 0; i + 1 < sx.len(); i++ {
				continue when dx[i + 1] <= dx[i] || dy[j + 1] <= dy[j]
				whole.drawImage(part, Rect{left: sx[i], top: sy[j], right: sx[i + 1], bottom: sy[j + 1]}, Rect{left: dx[i], top: dy[j], right: dx[i + 1], bottom: dy[j + 1]})
			}
		}
		whole.restore()
	}

	// The shadow the edges of `box` cast inside it: everything outside the box shrunk by
	// `choke`, moved by (`dx`, `dy`), blurred, and kept where the box is.
	def castInner(frame Frame, box Rounded, dx float, dy float, blur float, choke float, color Color, blend BlendMode) {
		return when isEmpty(box)
		let sigma = blur.max(0.0) / 2.0
		let pad = wholePad(frame, 3.0 * sigma + dx.abs().max(dy.abs()) + choke.max(0.0) + 1.0)
		let key = shadowKey(frame, "inner", box, color, sigma, choke, dx, dy)
		let raster = frame.shadows.find(key)
		if raster is none {
			let fresh = scratchFor(frame, box.left, box.top, box.right - box.left, box.bottom - box.top, pad)
			return when fresh is none
			let outside = new Path().rect(Rect{left: box.left - 2.0 * pad, top: box.top - 2.0 * pad, right: box.right + 2.0 * pad, bottom: box.bottom + 2.0 * pad})
			let hole = inset(box, choke)
			outside.add(pathOf(hole, dx, dy)) unless isEmpty(hole)
			fillBlurred(fresh, outside, color, sigma, FillRule.EvenOdd)
			fresh.setComposite(canvas.Composite.DestinationIn)
			fresh.fill(pathOf(box), solid())
			fresh.freeze()
			frame.shadows.keep(key, fresh)
			drawScratch(frame, fresh, box.left - pad, box.top - pad, blend)
			return
		}
		drawScratch(frame, raster, box.left - pad, box.top - pad, blend)
	}

	// Draws the image cut in nine over the border: the corners in the corners, the edges
	// along the sides, the centre over the padding box when the slice asks for it.
	def borderImage(frame Frame, shape BoxShape, slice NineSlice) {
		let source = slice.image
		let size = source.size()
		let (
			imageWidth  = float(size.width)
			imageHeight = float(size.height)
			box         = shape.border
			widths      = shape.widths
		)
		let sx float[] = [0.0, float(slice.slice.left).clamp(0.0, imageWidth), 0.0, imageWidth]
		sx[2] = (imageWidth - float(slice.slice.right)).clamp(sx[1], imageWidth)
		let sy float[] = [0.0, float(slice.slice.top).clamp(0.0, imageHeight), 0.0, imageHeight]
		sy[2] = (imageHeight - float(slice.slice.bottom)).clamp(sy[1], imageHeight)
		let dx float[] = [box.left, box.left + widths[3], box.right - widths[1], box.right]
		let dy float[] = [box.top, box.top + widths[0], box.bottom - widths[2], box.bottom]
		for let j = 0; j < 3; j++ {
			for let i = 0; i < 3; i++ {
				continue when i == 1 && j == 1 && !slice.center
				continue when sx[i + 1] <= sx[i] || sy[j + 1] <= sy[j] || dx[i + 1] <= dx[i] || dy[j + 1] <= dy[j]
				let from = Rect{left: sx[i], top: sy[j], right: sx[i + 1], bottom: sy[j + 1]}
				let to = Rect{left: dx[i], top: dy[j], right: dx[i + 1], bottom: dy[j + 1]}
				if slice.repeat && (i == 1 || j == 1) {
					tile(frame.canvas, source, from, to, i == 1, j == 1)
				} else {
					frame.canvas.drawImage(source, from, to)
				}
			}
		}
	}

	// Repeats the `from` part of the image over `to` from its top-left, along the axes
	// named; the other axis stretches. A tile keeps the image's proportions, and the last
	// one on each axis is cut off.
	def tile(target canvas.Painter, source Raster, from Rect, to Rect, across bool, down bool) {
		let (
			pieceWidth  = from.right - from.left
			pieceHeight = from.bottom - from.top
			roomWidth   = to.right - to.left
			roomHeight  = to.bottom - to.top
		)
		let stepX = roomWidth
		let stepY = roomHeight
		if across && down {
			stepX = pieceWidth
			stepY = pieceHeight
		} else {
			stepX = pieceWidth * roomHeight / pieceHeight when across
			stepY = pieceHeight * roomWidth / pieceWidth when down
		}
		return when stepX <= 0.0 || stepY <= 0.0
		for let y = to.top; y < to.bottom; y += stepY {
			let partY = ((to.bottom - y) / stepY).min(1.0)
			for let x = to.left; x < to.right; x += stepX {
				let partX = ((to.right - x) / stepX).min(1.0)
				let piece = Rect{left: from.left, top: from.top, right: from.left + pieceWidth * partX, bottom: from.top + pieceHeight * partY}
				target.drawImage(source, piece, Rect{left: x, top: y, right: x + stepX * partX, bottom: y + stepY * partY})
			}
		}
	}
}
