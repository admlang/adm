internal partial module std.ui.paint {
	use (
		std.formats.fonts
		std.gfx.canvas
		std.gfx.color::(Color, RGBA)
		std.math.geom::(Point, Rect, Size)
		std.ui::Limit
		std.ui.layout::Node
		std.ui.styles::*
		std.units::(Extent, FontRelative, Length, Percent, Pixels, ViewportHeight, ViewportWidth)
	)

	// A node's text with its resolved `Typography` values. Lines are set by the canvas's
	// `Paragraph` and faces come from the installed fonts, so what the paragraph does not
	// do is not done here either: see docs/std/ui/todo.md.
	type TextBlock {
		text       string
		// Ranges with a font or foreground of their own.
		runs       TextRun[]       = []
		// Family, fallback families, weight and slant. `size` is not read: the block's
		// `size` is the resolved one.
		font       Font
		// The em size.
		size       Pixels          = 16(px)
		// `Foreground.foreground`.
		foreground Paint           = new Color(RGBA{r: 0, g: 0, b: 0, a: 255})
		// `Typography.paragraph`.
		layout     ParagraphLayout = ParagraphLayout{}
		// A BCP 47 tag that steers the choice of fallback faces ("ja").
		language   string          = ""
		// The faces to draw with, the preferred one first; empty: found for `font` among
		// the installed fonts.
		faces      fonts.Face[]    = []

		// The paragraphs set last, by the width they were set in.
		widths float[]
		set    canvas.Paragraph[]

		// A one-line text shortened to a width with an ellipsis, and that width.
		shortFor float             = -1.0
		short    ?canvas.Paragraph = none

		def new(text string, font Font, size Pixels = 16(px)) {
			self.text = text
			self.font = font
			self.size = size
		}

		// Forgets the lines set so far. Call it after changing any field.
		def changed() {
			widths.len(0)
			set.len(0)
			shortFor = -1.0
			short = none
		}

		// The text set in lines no wider than `width`; 0 or less never wraps. Lines start
		// at the left edge: alignment is applied when drawing.
		def paragraph(width float) canvas.Paragraph {
			let limit = layout.wrap == Wrap.None ?? (0.0, width.max(0.0))
			for let (i, known) in widths {
				return set[i] when known == limit
			}
			let made = new canvas.Paragraph(spansOf(self), limit, canvas.TextAlign.Start, lineMultiple(self))
			if widths.len() >= 4 {
				widths.len(0)
				set.len(0)
			}
			widths.push(limit)
			set.push(made)
			return made
		}

		// Whether the text is one line that is shortened with an ellipsis where it does
		// not fit: `wrap` None with one of the ellipsis overflows.
		def shortens() bool {
			return false when layout.wrap != Wrap.None
			return layout.overflow := TextOverflow.Ellipsis || TextOverflow.EllipsisStart || TextOverflow.EllipsisMiddle
		}

		// The text as it is drawn in `width`: `paragraph(width)`, or, for a one-line text
		// that shortens and is wider, as many of its characters as fit with an ellipsis
		// where the others were: at the end, at the start or in the middle, as `overflow`
		// says. Characters are counted, so a mark that combines with the one before it
		// may be cut from it.
		def fitted(width float) canvas.Paragraph {
			let whole = paragraph(width)
			return whole when !shortens() || width <= 0.0
			let lines = whole.lines()
			return whole when lines.len() != 1 || lines[0].left + lines[0].width <= width
			let held = short
			return held when !(held is none) && shortFor == width
			// The most characters that fit, by halving: the width grows with them.
			let best = shortened(self, 0)
			let (low, high) = (1, text.len() - 1)
			for low <= high {
				let kept = (low + high) / 2
				let made = shortened(self, kept)
				let line = made.lines()
				if line.len() > 0 && line[0].left + line[0].width <= width {
					best = made
					low = kept + 1
				} else {
					high = kept - 1
				}
			}
			shortFor = width
			short = best
			return best
		}

		// The size the text takes within `limit`: its widest line, and its lines down to
		// `maxLines`. A one-line text that shortens takes no more than the room there is.
		def measure(limit Limit) Size<Pixels> {
			let room = limit.width
			let wide = room is none ?? (0.0, float(room))
			// `paragraph` reads a width of 0 as no limit. With no room at all the text
			// is as narrow as it gets without a word split: what a row that has too
			// little room shrinks it toward.
			wide = paragraph(0.0).narrowest().ceil().max(1.0) when !(room is none) && wide <= 0.0
			let lines = paragraph(wide).lines()
			let widest = 0.0
			for let line in lines {
				widest = widest.max(line.left + line.width)
			}
			widest = widest.min(float(room)) when !(room is none) && shortens()
			return new Size<Pixels>(widest.ceil() * 1(px), shownHeight(self, lines).ceil() * 1(px))
		}
	}

	// Gives `node` that text: its decoration holds the block, layout measures the node by
	// it and lines the node up on its first baseline, and the node's font size is the
	// block's.
	def setText(node Node, block TextBlock) {
		let decoration = node.decoration
		if decoration is none {
			let fresh = new Decoration()
			fresh.text = block
			node.decoration = fresh
		} else {
			decoration.text = block
		}
		node.fontSize = block.size
		node.measure = def (limit Limit) Size<Pixels> {
			return block.measure(limit)
		}
		let lines = block.paragraph(0.0).lines()
		node.baseline = none
		node.baseline = lines[0].baseline * 1(px) when lines.len() > 0
	}

	// Draws the node's text in its content box.
	def drawText(frame Frame, shape BoxShape, block TextBlock, align Align) {
		let area = shape.content
		return when isEmpty(area)
		drawBlock(frame.canvas, block, rectOf(area), align, shape.rtl, frame.scale)
	}

	// Draws a block's text in `area`: across as `align.horizontal` says (Start is the right
	// side when `rtl`), down as `align.vertical` says, starting on a whole device pixel
	// (`scale` of them per unit of `area`).
	def drawBlock(target canvas.Painter, block TextBlock, area Rect, align Align, rtl bool, scale float = 1.0) {
		let set = block.fitted(area.right - area.left)
		let lines = set.lines()
		return when lines.len() == 0
		let height = shownHeight(block, lines)
		let top = area.top
		match align.vertical {
			case Alignment.Center:
				top += (area.bottom - area.top - height) / 2.0
			case Alignment.End:
				top = area.bottom - height
			default:
		}
		let across = align.horizontal
		if rtl {
			match across {
				case Alignment.End:
					across = Alignment.Start
				case Alignment.Center:
				default:
					across = Alignment.End
			}
		}
		// Lines are set from the left edge; a line is moved as a whole when all lines
		// have the same room to share, which is every case but several lines of
		// different lengths.
		let widest = 0.0
		for let line in lines {
			widest = widest.max(line.left + line.width)
		}
		let left = area.left
		match across {
			case Alignment.Center:
				left += (area.right - area.left - widest) / 2.0
			case Alignment.End:
				left = area.right - widest
			default:
		}
		let snappedLeft = (left * scale).round() / scale
		let snappedTop = (top * scale).round() / scale
		let cut = lines.len() > shownLines(block, lines)
		if cut {
			target.save()
			target.clip(Rect{left: area.left, top: snappedTop, right: area.right, bottom: ((top + height) * scale).round() / scale})
		}
		target.fillText(set, new Point(snappedLeft, snappedTop))
		target.restore() when cut
	}

	// How many of the lines are shown.
	def shownLines(block TextBlock, lines canvas.TextLine[]) int {
		let most = block.layout.maxLines
		return lines.len() when most is none
		return most.max(0).min(lines.len())
	}

	// The height of the lines that are shown.
	def shownHeight(block TextBlock, lines canvas.TextLine[]) float {
		let count = shownLines(block, lines)
		return 0.0 when count == 0
		return lines[count - 1].bottom
	}

	// The mark that stands for the characters left out of a shortened text.
	const ellipsis = "…"

	// The part of `runs` that covers the characters from `from` up to `to`, moved by `by`.
	def runsWithin(runs TextRun[], from int, to int, by int) TextRun[] {
		let kept TextRun[]
		for let run in runs {
			let (start, end) = (run.start.max(from), run.end.min(to))
			continue when end <= start
			let moved = run
			moved.start = start + by
			moved.end = end + by
			kept.push(moved)
		}
		return kept
	}

	// `kept` characters of `text` and an ellipsis for the others, placed as `overflow`
	// says: the first ones, the last ones, or half of them at each end.
	def shortText(text string, kept int, overflow TextOverflow) string {
		let count = text.len()
		match overflow {
			case TextOverflow.EllipsisStart:
				return ellipsis + text.slice(count - kept, count)
			case TextOverflow.EllipsisMiddle:
				let head = (kept + 1) / 2
				return text.slice(0, head) + ellipsis + text.slice(count - (kept - head), count)
			default:
				return text.slice(0, kept) + ellipsis
		}
	}

	// One line of `kept` characters of the block's text and an ellipsis for the others
	// (`shortText`); runs keep to the characters they covered.
	def shortened(block TextBlock, kept int) canvas.Paragraph {
		let count = block.text.len()
		let piece = new TextBlock(shortText(block.text, kept, block.layout.overflow), block.font, block.size)
		match block.layout.overflow {
			case TextOverflow.EllipsisStart:
				piece.runs = runsWithin(block.runs, count - kept, count, 1 - (count - kept))
			case TextOverflow.EllipsisMiddle:
				let head = (kept + 1) / 2
				let tail = kept - head
				piece.runs = runsWithin(block.runs, 0, head, 0)
				for let run in runsWithin(block.runs, count - tail, count, head + 1 - (count - tail)) {
					piece.runs.push(run)
				}
			default:
				piece.runs = runsWithin(block.runs, 0, kept, 0)
		}
		piece.foreground = block.foreground
		piece.layout = block.layout
		piece.language = block.language
		piece.faces = block.faces
		return new canvas.Paragraph(spansOf(piece), 0.0, canvas.TextAlign.Start, lineMultiple(block))
	}

	// The distance between baselines as a multiple of the font size.
	def lineMultiple(block TextBlock) float {
		let height = block.layout.lineHeight
		let size = float(block.size)
		match height {
			case float:
				return height
			default:
				let pixels = sizeIn(height, size)
				return 1.0 when size <= 0.0
				return pixels / size
		}
	}

	// An extent of a text in pixels: a percent or an em is of the font size `em`. A
	// viewport share has no window to measure here and is the font size.
	def sizeIn(extent Extent, em float) float {
		match extent {
			case Pixels:
				return float(extent)
			case Percent:
				return em * float(extent) / 100.0
			case FontRelative:
				return em * float(extent)
			case Length:
				return float(extent) * 96.0 / 0.0254
			case ViewportHeight:
				return em
			case ViewportWidth:
				return em
		}
	}

	// The faces for a font, the preferred one first: its family, then its fallback
	// families, among the installed fonts; the sans-serif face when none is installed.
	def facesFor(font Font) fonts.Face[] {
		let installed = fonts.systemFonts()
		let weight = int(font.weight)
		let found fonts.Face[]
		let families = [font.family]
		for let name in font.fallback {
			families.push(name)
		}
		for let name in families {
			let face = installed.find(name, weight, font.italic)
			found.push(face) unless face is none
		}
		if found.len() == 0 {
			let face = installed.find("sans-serif", weight, font.italic)
			found.push(face) unless face is none
		}
		return found
	}

	// The block's text as paragraph spans: cut where a run starts or ends, each piece cut
	// again where another face has to draw it.
	def spansOf(block TextBlock) canvas.TextSpan[] {
		let spans canvas.TextSpan[]
		let count = block.text.len()
		return spans when count == 0
		let own = block.faces
		own = facesFor(block.font) when own.len() == 0
		let cuts int[] = [0, count]
		for let run in block.runs {
			cuts.push(run.start.clamp(0, count))
			cuts.push(run.end.clamp(0, count))
		}
		cuts = cuts.sort((a, b) => a < b)
		let spacing = sizeIn(block.layout.letterSpacing, float(block.size))
		for let i = 0; i + 1 < cuts.len(); i++ {
			let (from, to) = (cuts[i], cuts[i + 1])
			continue when to <= from
			let faces = own
			let size = float(block.size)
			let paint = block.foreground
			// A later run wins where two cover the same characters.
			for let run in block.runs {
				continue when run.start > from || run.end < to
				let font = run.font
				if !(font is none) {
					faces = facesFor(font)
					size = sizeIn(font.size, float(block.size))
				}
				let colour = run.foreground
				paint = colour unless colour is none
			}
			continue when faces.len() == 0
			let piece = block.text.slice(from, to)
			for let part in fonts.systemFonts().faceRuns(piece, faces, block.language) {
				spans.push(canvas.TextSpan{
					text:      piece.slice(part.start, part.end),
					textStyle: canvas.TextStyle{face: part.face, size: size * 1(px), spacing: spacing * 1(px), rootSize: block.size},
					paint:     paint,
				})
			}
		}
		return spans
	}
}
