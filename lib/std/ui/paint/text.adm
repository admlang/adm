internal partial module std.ui.paint {
	use (
		std.formats.fonts
		std.gfx.canvas
		std.gfx.color::(Color, RGBA)
		std.math.geom::(Point, Rect, Size)
		std.text.unicode
		std.ui::Limit
		std.ui.styles
		std.ui.layout::Node
		std.ui.styles::*
		std.units::(Extent, FontRelative, Length, Percent, Pixels, ViewportHeight, ViewportWidth)
	)

	// How many widths a text block keeps its lines set in (`TextBlock.paragraph`).
	const keptWidths = 8

	// A node's text with its resolved `Typography` values. Lines are set by the canvas's
	// `Paragraph` and faces come from the installed fonts, so what the paragraph does not
	// do is not done here either: see docs/std/ui/todo.md.
	type TextBlock {
		text       string
		// Ranges with a font or foreground of their own.
		runs       TextRun[]       = []
		// Family, fallback families, weight and slant. `size` is not read: the block's
		// `size` is the resolved one.
		font       Font
		// The em size.
		size       Pixels          = 16(px)
		// `Foreground.foreground`.
		foreground Paint           = new Color(RGBA{r: 0, g: 0, b: 0, a: 255})
		// `Typography.paragraph`.
		layout     ParagraphLayout = ParagraphLayout{}
		// A BCP 47 tag that steers the choice of fallback faces ("ja").
		language   string          = ""
		// The faces to draw with, the preferred one first; empty: found for `font` among
		// the installed fonts.
		faces      fonts.Face[]    = []

		// The paragraphs set last, by the width they were set in, and where the next one
		// goes once there are `keptWidths` of them: layout measures a text at a few widths
		// and the drawing sets it in its box, every frame, so none is dropped while the
		// widths a frame asks stay the same.
		widths float[]
		set    canvas.Paragraph[]
		next   int

		// A one-line text shortened to a width with an ellipsis, and that width.
		shortFor float             = -1.0
		short    ?canvas.Paragraph = none

		// Whether `firstBaseline` found it since the block last `changed`, and what it
		// found; none: no line.
		baselineKept bool
		baselineAt   ?Pixels = none

		// The paragraph layout `follow` gave it, a style's; none: its own defaults.
		given ?ParagraphLayout = none

		// Where its lines sit across the box, and its direction, as the box it is
		// drawn in says (`arrange`).
		across      Alignment         = Alignment.Start
		rightToLeft bool
		// The lines drawn with the whole text; a run's own wins over it.
		decoration  styles.Decoration = styles.Decoration{}
		// Drawn as it is typed: `whitespace` and `casing` are left aside, as editable
		// text needs, whose carets count its characters.
		asTyped     bool
		// The node whose decoration holds it (`setText`), told when its lines change
		// (`changed`): the text may reach further than its box. A block is one node's.
		weak node   ?Node

		def new(text string, font Font, size Pixels = 16(px)) {
			self.text = text
			self.font = font
			self.size = size
		}

		// Takes the paragraph layout a style gives, none for the defaults. A style keeps
		// one object while its paragraph stands, so the lines set so far are forgotten
		// only when it gives another one.
		def follow(lines ?ParagraphLayout) {
			if lines is none {
				return when given is none
				given = none
				layout = ParagraphLayout{}
			} else {
				let had = given
				return when !(had is none) && had == lines
				given = lines
				layout = lines
			}
			changed()
		}

		// Takes where the lines sit across the box, Start and End being the
		// direction's (Fill justifies them), and whether the box reads right to left.
		def arrange(across Alignment, rightToLeft bool) {
			return when self.across == across && self.rightToLeft == rightToLeft
			self.across = across
			self.rightToLeft = rightToLeft
			changed()
		}

		// Forgets the lines set so far. Call it after changing any field.
		def changed() {
			baselineKept = false
			widths.len(0)
			set.len(0)
			next = 0
			shortFor = -1.0
			short = none
			let held = node
			held.reachChanged() unless held is none
		}

		// The baseline of its first line from its top, set in lines that never wrap
		// (`paragraph(0.0)`); none without a line. Found from the faces' metrics:
		// no line is set for it.
		def firstBaseline() ?Pixels {
			if !baselineKept {
				let found = paragraph(0.0).firstBaseline()
				baselineAt = found is none ?? (none, found * 1(px))
				baselineKept = true
			}
			return baselineAt
		}

		// The text set in lines no wider than `width`; 0 or less never wraps. Lines start
		// at the left edge: alignment is applied when drawing. The text is shaped once,
		// by the first width asked: the others only break and place its lines.
		def paragraph(width float) canvas.Paragraph {
			let limit = layout.wrap == Wrap.None ?? (0.0, width.max(0.0))
			for let (i, known) in widths {
				return set[i] when known == limit
			}
			let made = set.len() > 0 ?? (set[0].withWidth(limit), new canvas.Paragraph(spansOf(self), limit, settingsOf(self)))
			if widths.len() < keptWidths {
				widths.push(limit)
				set.push(made)
				return made
			}
			widths[next] = limit
			set[next] = made
			next = (next + 1) % keptWidths
			return made
		}

		// Whether the text is one line that is shortened with an ellipsis where it does
		// not fit: `wrap` None with one of the ellipsis overflows.
		def shortens() bool {
			return false when layout.wrap != Wrap.None
			return layout.overflow := TextOverflow.Ellipsis || TextOverflow.EllipsisStart || TextOverflow.EllipsisMiddle
		}

		// The text as it is drawn in `width`: `paragraph(width)`, or, for a one-line text
		// that shortens and is wider, as many of its grapheme clusters as fit with an
		// ellipsis where the others were: at the end, at the start or in the middle, as
		// `overflow` says. A letter keeps its accents, an emoji sequence stays whole.
		def fitted(width float) canvas.Paragraph {
			let whole = paragraph(width)
			return whole when !shortens() || width <= 0.0
			let lines = whole.lines()
			return whole when lines.len() != 1 || lines[0].left + lines[0].width <= width
			let held = short
			return held when !(held is none) && shortFor == width
			// The most characters that fit, by halving: the width grows with them.
			let best = shortened(self, 0)
			let (low, high) = (1, unicode.graphemeBreaks(text).len() - 1)
			for low <= high {
				let kept = (low + high) / 2
				let made = shortened(self, kept)
				let line = made.lines()
				if line.len() > 0 && line[0].left + line[0].width <= width {
					best = made
					low = kept + 1
				} else {
					high = kept - 1
				}
			}
			shortFor = width
			short = best
			return best
		}

		// The size the text takes within `limit`: its widest line, and its lines down to
		// `maxLines`. A one-line text that shortens takes no more than the room there is.
		def measure(limit Limit) Size<Pixels> {
			let room = limit.width
			let wide = room is none ?? (0.0, float(room))
			// `paragraph` reads a width of 0 as no limit. With no room at all the text
			// is as narrow as it gets without a word split: what a row that has too
			// little room shrinks it toward.
			wide = paragraph(0.0).narrowest().ceil().max(1.0) when !(room is none) && wide <= 0.0
			let setIn = paragraph(wide)
			let widest = setIn.contentWidth()
			widest = widest.min(float(room)) when !(room is none) && shortens()
			// As tall as its lines: `size()` ends at the last one's bottom.
			return new Size<Pixels>(widest.ceil() * 1(px), setIn.size().height.ceil() * 1(px))
		}
	}

	// Gives `node` that text: its decoration holds the block, layout measures the node by
	// it and lines the node up on its first baseline, and the node's font size is the
	// block's.
	def setText(node Node, block TextBlock) {
		let decoration = node.decoration
		if decoration is none {
			let fresh = new Decoration()
			fresh.text = block
			node.decoration = fresh
		} else {
			decoration.text = block
		}
		node.fontSize = block.size
		node.measure = def (limit Limit) Size<Pixels> {
			return block.measure(limit)
		}
		node.baseline = block.firstBaseline()
	}

	// Draws the node's text in its content box.
	def drawText(frame Frame, shape BoxShape, block TextBlock, align Align) {
		let area = shape.content
		return when isEmpty(area)
		drawBlock(frame.canvas, block, rectOf(area), align, shape.rtl, frame.scale)
	}

	// Where `drawBlock` puts the top left corner of `set`, the block's text as it is drawn
	// in `area`: placed by `align` on both axes, then on whole device pixels.
	def blockOrigin(block TextBlock, set canvas.Paragraph, area Rect, align Align, rtl bool, scale float = 1.0) (float, float) {
		let height = shownHeight(set.lines())
		let top = area.top
		match align.vertical {
			case Alignment.Center:
				top += (area.bottom - area.top - height) / 2.0
			case Alignment.End:
				top = area.bottom - height
			default:
		}
		// A text that wraps is set in the box's width, each line placed in it by the
		// paragraph; one that does not is as wide as its line and moves as a whole.
		let left = area.left
		if block.layout.wrap == Wrap.None {
			let across = align.horizontal
			if rtl {
				match across {
					case Alignment.End:
						across = Alignment.Start
					case Alignment.Center:
					default:
						across = Alignment.End
				}
			}
			let widest = set.contentWidth()
			match across {
				case Alignment.Center:
					left += (area.right - area.left - widest) / 2.0
				case Alignment.End:
					left = area.right - widest
				default:
			}
		}
		return ((left * scale).round() / scale, (top * scale).round() / scale)
	}

	// The character of `block`'s text drawn at `x`, `y` when `drawBlock` draws it in `area`
	// with `align`; -1 when no character is there (beside the lines, between them, or in
	// a text shortened with an ellipsis).
	def characterAt(block TextBlock, area Rect, align Align, rtl bool, x float, y float) int {
		block.arrange(align.horizontal, rtl)
		let width = area.right - area.left
		let set = block.fitted(width)
		return -1 when set.lines().len() == 0 || set != block.paragraph(width)
		let (left, top) = blockOrigin(block, set, area, align, rtl)
		let places = new CaretMap(block, width)
		let line = places.lineAt(y - top)
		let (above, below) = places.rows(line, 0.0)
		return -1 when y - top < above || y - top >= below
		return places.charAt(line, x - left)
	}

	// Draws a block's text in `area`: across as `align.horizontal` says (Start is the right
	// side when `rtl`), down as `align.vertical` says, starting on a whole device pixel
	// (`scale` of them per unit of `area`).
	def drawBlock(target canvas.Painter, block TextBlock, area Rect, align Align, rtl bool, scale float = 1.0) {
		block.arrange(align.horizontal, rtl)
		let set = block.fitted(area.right - area.left)
		let lines = set.lines()
		return when lines.len() == 0
		let height = shownHeight(lines)
		let (snappedLeft, snappedTop) = blockOrigin(block, set, area, align, rtl, scale)
		// `Fade`: a text wider than its box, or cut by `maxLines`, fades out over the
		// last two ems at the end side, through a gradient its group is kept by.
		let fades = block.layout.overflow == TextOverflow.Fade && (set.truncated() || set.contentWidth() > area.right - area.left + 0.5)
		target.beginGroup() when fades
		target.fillText(set, new Point(snappedLeft, snappedTop))
		if fades {
			let reach = float(block.size) * 2.0
			let (from, to) = rtl ?? ((area.left + reach, area.left), (area.right - reach, area.right))
			let opaque = new Color(RGBA{r: 0, g: 0, b: 0, a: 255})
			let clear = new Color(RGBA{r: 0, g: 0, b: 0, a: 0})
			target.setComposite(canvas.Composite.DestinationIn)
			target.fill(Rect{left: area.left, top: snappedTop, right: area.right, bottom: snappedTop + height}, canvas.linear(new Point(from, snappedTop), new Point(to, snappedTop), [opaque, clear]))
			target.endGroup()
		}
	}

	// The height of the lines: those `maxLines` keeps, which the paragraph cut.
	def shownHeight(lines canvas.TextLine[]) float {
		return 0.0 when lines.len() == 0
		return lines[lines.len() - 1].bottom
	}

	// The mark that stands for the characters left out of a shortened text.
	const ellipsis = "…"

	// The part of `runs` that covers the characters from `from` up to `to`, moved by `by`.
	def runsWithin(runs TextRun[], from int, to int, by int) TextRun[] {
		let kept TextRun[]
		for let run in runs {
			let (start, end) = (run.start.max(from), run.end.min(to))
			continue when end <= start
			let moved = run
			moved.start = start + by
			moved.end = end + by
			kept.push(moved)
		}
		return kept
	}

	// How many characters a text shortened to `kept` grapheme clusters keeps at its
	// start and at its end, as `overflow` places the ellipsis: the first clusters, the
	// last ones, or half of them at each end.
	def keptEnds(text string, kept int, overflow TextOverflow) (int, int) {
		let breaks = unicode.graphemeBreaks(text)
		let clusters = breaks.len()
		let count = text.len()
		kept = kept.clamp(0, clusters)
		// The character at which cluster k starts.
		let at = def (k int) int {
			return k <= 0 ?? (0, breaks[k - 1])
		}
		match overflow {
			case TextOverflow.EllipsisStart:
				return (0, count - at(clusters - kept))
			case TextOverflow.EllipsisMiddle:
				let head = (kept + 1) / 2
				return (at(head), count - at(clusters - (kept - head)))
			default:
				return (at(kept), 0)
		}
	}

	// `kept` grapheme clusters of `text` and an ellipsis for the others (`keptEnds`).
	def shortText(text string, kept int, overflow TextOverflow) string {
		let count = text.len()
		let (head, tail) = keptEnds(text, kept, overflow)
		return text.slice(0, head) + ellipsis + text.slice(count - tail, count)
	}

	// One line of `kept` grapheme clusters of the block's text and an ellipsis for the
	// others (`shortText`); runs keep to the characters they covered.
	def shortened(block TextBlock, kept int) canvas.Paragraph {
		let count = block.text.len()
		let (head, tail) = keptEnds(block.text, kept, block.layout.overflow)
		let piece = new TextBlock(shortText(block.text, kept, block.layout.overflow), block.font, block.size)
		piece.runs = runsWithin(block.runs, 0, head, 0)
		for let run in runsWithin(block.runs, count - tail, count, head + 1 - (count - tail)) {
			piece.runs.push(run)
		}
		piece.foreground = block.foreground
		piece.layout = block.layout
		piece.language = block.language
		piece.faces = block.faces
		piece.across = block.across
		piece.rightToLeft = block.rightToLeft
		return new canvas.Paragraph(spansOf(piece), 0.0, settingsOf(piece))
	}

	// How the block's lines are set, from its `layout` and `arrange`. A text that
	// wraps and ends in an ellipsis puts it on the last line `maxLines` keeps.
	def settingsOf(block TextBlock) canvas.ParagraphStyle {
		let layout = block.layout
		let size = float(block.size)
		let settings = canvas.ParagraphStyle{lineHeight: lineMultiple(block), tabSize: float(layout.tabSize), maxLines: layout.maxLines}
		match block.across {
			case Alignment.Center:
				settings.align = canvas.TextAlign.Center
			case Alignment.End:
				settings.align = canvas.TextAlign.End
			case Alignment.Fill:
				settings.justify = true
			default:
		}
		settings.direction = unicode.Direction.RightToLeft when block.rightToLeft
		settings.indent = sizeIn(layout.indent, size)
		settings.wrapIndent = sizeIn(layout.wrapIndent, size)
		settings.wordSpacing = sizeIn(layout.wordSpacing, size)
		settings.balanced = layout.wrap == Wrap.Balanced
		if layout.wrap != Wrap.None && (layout.overflow := TextOverflow.Ellipsis || TextOverflow.EllipsisStart || TextOverflow.EllipsisMiddle) {
			settings.ellipsis = ellipsis
		}
		return settings
	}

	// The distance between baselines as a multiple of the font size.
	def lineMultiple(block TextBlock) float {
		let height = block.layout.lineHeight
		let size = float(block.size)
		match height {
			case float:
				return height
			default:
				let pixels = sizeIn(height, size)
				return 1.0 when size <= 0.0
				return pixels / size
		}
	}

	// An extent of a text in pixels: a percent or an em is of the font size `em`. A
	// viewport share has no window to measure here and is the font size.
	def sizeIn(extent Extent, em float) float {
		match extent {
			case Pixels:
				return float(extent)
			case Percent:
				return em * float(extent) / 100.0
			case FontRelative:
				return em * float(extent)
			case Length:
				return float(extent) * 96.0 / 0.0254
			case ViewportHeight:
				return em
			case ViewportWidth:
				return em
		}
	}

	// The faces for a font, the preferred one first: its family, then its fallback
	// families, among the installed fonts; the sans-serif face when none is installed.
	// Kept by what the font asks for while the installed fonts stay the same: every
	// text of a window asks for one of a few fonts.
	def facesFor(font Font) fonts.Face[] {
		return choices.of(font)
	}

	// The faces `facesFor` found, by font.
	type FaceChoices {
		found map<string, fonts.Face[]>
		// How many faces the installed set held when they were found.
		among int

		atomic def of(font Font) fonts.Face[] {
			let installed = fonts.systemFonts().count()
			if installed != among {
				found = map<string, fonts.Face[]>{}
				among = installed
			}
			let key = "{font.family}\u001E{font.fallback.join("\u001F")}\u001E{int(font.weight)}\u001E{int(font.width)}\u001E{font.italic}"
			for let (tag, value) in font.axes {
				key += "\u001E{tag}={value}"
			}
			let held = found.get(key)
			return held when held is fonts.Face[]
			let made = chooseFaces(font)
			found[key] = made
			return made
		}
	}

	let choices = new FaceChoices()

	def chooseFaces(font Font) fonts.Face[] {
		let installed = fonts.systemFonts()
		let weight = int(font.weight)
		let found fonts.Face[]
		let families = [font.family]
		for let name in font.fallback {
			families.push(name)
		}
		for let name in families {
			let face = installed.find(name, weight, font.italic)
			found.push(varied(face, font)) unless face is none
		}
		if found.len() == 0 {
			let face = installed.find("sans-serif", weight, font.italic)
			found.push(varied(face, font)) unless face is none
		}
		return found
	}

	// The faces made of variable faces at a point of their design space, by face and
	// point: an instance is made once.
	type FaceInstances {
		made map<string, fonts.Face>

		// The instance of `face` at `coords`, made the first time.
		atomic def at(face fonts.VariableFace, coords map<string, float>, key string) fonts.Face {
			let held = made.valueOf(key)
			return held unless held is none
			let instance = face.instance(coords) onerror recover face
			made[key] = instance
			return instance
		}
	}

	let instances = new FaceInstances()

	// The face at the font's axes, when it is a variable face: those `axes` names,
	// and `wght` and `wdth` from `weight` and `width` unless named. A face that is
	// not variable, or has none of those axes, is the face itself; so is one whose
	// instance cannot be made, drawn at its defaults rather than not at all.
	def varied(face fonts.Face, font Font) fonts.Face {
		return face unless face is fonts.VariableFace
		let coords = map<string, float>{}
		let key = face.info().postscript
		for let axis in face.axes() {
			let given = font.axes.valueOf(axis.tag)
			let value = given is none ?? (axisFromFont(axis.tag, font), given)
			continue when value is none
			coords[axis.tag] = value.clamp(axis.min, axis.max)
			key += "|{axis.tag}={coords[axis.tag]}"
		}
		return face when coords.len() == 0
		return instances.at(face, coords, key)
	}

	// What the font's own fields say for a variation axis: `wght` its weight, `wdth`
	// its width (CSS font-stretch percentages); none for any other axis.
	def axisFromFont(tag string, font Font) ?float {
		return float(int(font.weight)) when tag == "wght"
		return none when tag != "wdth"
		match font.width {
			case FontWidth.Condensed:
				return 75.0
			case FontWidth.SemiCondensed:
				return 87.5
			case FontWidth.SemiExpanded:
				return 112.5
			case FontWidth.Expanded:
				return 125.0
			default:
				return 100.0
		}
	}

	// The block's text as paragraph spans: cut where a run starts or ends, each piece cut
	// again where another face has to draw it. The text is drawn as `whitespace` and
	// `casing` say (`shownText`), so the lines' character ranges count it as drawn.
	def spansOf(block TextBlock) canvas.TextSpan[] {
		let spans canvas.TextSpan[]
		let count = block.text.len()
		return spans when count == 0
		let own = block.faces
		own = facesFor(block.font) when own.len() == 0
		let cuts int[] = [0, count]
		for let run in block.runs {
			cuts.push(run.start.clamp(0, count))
			cuts.push(run.end.clamp(0, count))
		}
		cuts = cuts.sort((a, b) => a < b)
		let size = float(block.size)
		let spacing = sizeIn(block.layout.letterSpacing, size)
		let shown = shownText(block)
		let whole = decorationOf(block.decoration)
		for let i = 0; i + 1 < cuts.len(); i++ {
			let (from, to) = (cuts[i], cuts[i + 1])
			continue when to <= from
			let faces = own
			let font = block.font
			let em = size
			let paint = block.foreground
			let background ?Paint = none
			let marks = whole
			let shift = 0.0
			// A later run wins where two cover the same characters.
			for let run in block.runs {
				continue when run.start > from || run.end < to
				let runFont = run.font
				if !(runFont is none) {
					faces = facesFor(runFont)
					font = runFont
					em = sizeIn(runFont.size, size)
				}
				let colour = run.foreground
				paint = colour unless colour is none
				let behind = run.background
				background = behind unless behind is none
				let lines = run.decoration
				marks = decorationOf(lines) unless lines is none
				let raise = run.shift
				shift = sizeIn(raise, em) unless raise is none
			}
			continue when faces.len() == 0
			let piece = shown.slice(from, to)
			continue when piece == ""
			let features = featuresOf(font, block.asTyped ?? (Casing.None, block.layout.casing))
			for let part in fonts.systemFonts().faceRuns(piece, faces, block.language) {
				spans.push(canvas.TextSpan{
					text:       piece.slice(part.start, part.end),
					textStyle:  canvas.TextStyle{face: part.face, size: em * 1(px), spacing: spacing * 1(px), rootSize: block.size, features: features},
					paint:      paint,
					background: background,
					decoration: marks,
					shift:      shift,
				})
			}
		}
		return spans
	}

	// The text as it is drawn, per character of the block's text: kept as it is,
	// replaced (a newline drawn as a space) or left out (a space after a space), as
	// `whitespace` says; then in the case `casing` asks for.
	type ShownText {
		// What each character of the text is drawn as; "" for one left out.
		parts string[]

		// The characters from..to as drawn.
		def slice(from int, to int) string {
			let out = ""
			for let i = from; i < to; i++ {
				out += parts[i]
			}
			return out
		}
	}

	def shownText(block TextBlock) ShownText {
		let shown = new ShownText()
		let mode = block.asTyped ?? (Whitespace.Preserve, block.layout.whitespace)
		let casing = block.asTyped ?? (Casing.None, block.layout.casing)
		// Word starts, for Capitalize: the first cased character after a word break.
		let starts map<int, bool>
		if casing == Casing.Capitalize {
			let at = 0
			let words = unicode.wordBreaks(block.text)
			let chars char[]
			for let (_, ch) in block.text {
				chars.push(ch)
			}
			for let end in words {
				for let k = at; k < end; k++ {
					if unicode.isCased(chars[k]) {
						starts[k] = true
						break
					}
				}
				at = end
			}
		}
		let lastSpace = mode != Whitespace.Preserve
		let i = 0
		for let (_, ch) in block.text {
			let cp = int(ch)
			let blank = cp := 0x20 || 0x09
			let newline = cp := 0x0A || 0x0D || 0x0C
			let part = string(ch)
			if mode != Whitespace.Preserve && (blank || (newline && mode == Whitespace.Collapse)) {
				// A run of spaces (and line breaks, when they collapse) is one space.
				part = lastSpace ?? ("", " ")
				lastSpace = true
			} else {
				lastSpace = newline && mode == Whitespace.PreserveLines
				match casing {
					case Casing.Upper:
						part = unicode.toUpper(part)
					case Casing.Lower:
						part = unicode.toLower(part)
					case Casing.Capitalize:
						part = unicode.toTitle(part) when starts.hasKey(i)
					default:
				}
			}
			shown.parts.push(part)
			i++
		}
		// No space hangs at the end of a collapsed text.
		if mode == Whitespace.Collapse {
			for let k = shown.parts.len() - 1; k >= 0 && (shown.parts[k] == " " || shown.parts[k] == ""); k-- {
				shown.parts[k] = ""
			}
		}
		return shown
	}

	// The OpenType features a font asks for: its own, no ligatures when it turns them
	// off, small capitals for `Casing.SmallCaps`.
	def featuresOf(font Font, casing Casing) map<string, int> {
		let out = map<string, int>{}
		for let (tag, value) in font.features {
			out[tag] = value
		}
		if !font.ligatures {
			out["liga"] = 0
			out["clig"] = 0
			out["dlig"] = 0
		}
		out["smcp"] = 1 when casing == Casing.SmallCaps
		return out
	}

	// The canvas's lines for a decoration; none when it draws no line.
	def decorationOf(d styles.Decoration) ?canvas.TextDecoration {
		return none unless d.underline || d.overline || d.strikethrough
		let marks = canvas.TextDecoration{underline: d.underline, overline: d.overline, strikethrough: d.strikethrough, paint: d.paint, skipDescenders: d.skipDescenders}
		match d.line {
			case DecorationLine.Double:
				marks.line = canvas.DecorationLine.Double
			case DecorationLine.Dotted:
				marks.line = canvas.DecorationLine.Dotted
			case DecorationLine.Dashed:
				marks.line = canvas.DecorationLine.Dashed
			case DecorationLine.Wavy:
				marks.line = canvas.DecorationLine.Wavy
			default:
		}
		let thick = d.thickness
		marks.thickness = sizeIn(thick, 16.0) unless thick is none
		return marks
	}
}
