internal partial module std.ui.paint {
	use (
		std.formats.fonts
		std.gfx.canvas
		std.gfx.color::(Color, RGBA)
		std.math.geom::Rect
		std.os
		std.testing
		std.ui::Limit
		std.ui.styles
		std.ui.styles::*
		std.units::Pixels
	)

	check "TextOverflow" {
		// The width of the one line a paragraph sets.
		def lineWidth(block TextBlock, width float) float {
			let lines = block.fitted(width).lines()
			assert lines.len() == 1
			return lines[0].left + lines[0].width
		}

		// What stands for the characters left out, and where.
		@test()
		def TestShortTextPlacesTheEllipsis() {
			assert shortText("abcdefgh", 3, TextOverflow.Ellipsis) == "abc…"
			assert shortText("abcdefgh", 3, TextOverflow.EllipsisStart) == "…fgh"
			assert shortText("abcdefgh", 3, TextOverflow.EllipsisMiddle) == "ab…h"
			assert shortText("abcdefgh", 0, TextOverflow.Ellipsis) == "…"
			// Grapheme clusters are kept whole: an e with its accent counts as one.
			let accented = "e" + string(char(0x0301)) + "fgh"
			assert shortText(accented, 1, TextOverflow.Ellipsis) == "e" + string(char(0x0301)) + "…"
			let runs = [TextRun{start: 0, end: 2}, TextRun{start: 5, end: 8}]
			let tail = runsWithin(runs, 5, 8, -4)
			assert tail.len() == 1 && tail[0].start == 1 && tail[0].end == 4
			let head = runsWithin(runs, 0, 1, 0)
			assert head.len() == 1 && head[0].start == 0 && head[0].end == 1
		}

		// A one-line text with an ellipsis overflow is drawn no wider than its room, as
		// much of it as fits; one that fits, wraps or only clips is left as it is.
		@test()
		def TestOneLineIsShortenedToItsRoom() {
			let block = new TextBlock("a sentence that is far too long for where it goes", Font{family: "system-ui"})
			block.layout.wrap = Wrap.None
			let whole = float(block.measure(Limit{}).width)
			assert whole > 200.0
			// Clipped: the line keeps its width.
			assert !block.shortens() && lineWidth(block, 100.0) > 200.0

			for let kind in [TextOverflow.Ellipsis, TextOverflow.EllipsisStart, TextOverflow.EllipsisMiddle] {
				block.layout.overflow = kind
				block.changed()
				assert block.shortens()
				let narrow = lineWidth(block, 100.0)
				let wider = lineWidth(block, 160.0)
				assert narrow <= 100.0 && narrow > 60.0 && wider <= 160.0 && wider > narrow
				// Room enough: the text as it is.
				assert lineWidth(block, whole + 1.0) == lineWidth(block, 0.0)
				// It asks for no more than the room it is given.
				assert float(block.measure(Limit{width: 100(px)}).width) <= 100.0
				assert float(block.measure(Limit{}).width) == whole
				// No room for a character: the ellipsis alone.
				assert lineWidth(block, 1.0) < 30.0
			}

			// A text that wraps is not shortened.
			block.layout.wrap = Wrap.Words
			block.changed()
			assert !block.shortens() && block.fitted(100.0).lines().len() > 1
		}
	}

	check "TextLines" {
		def wrapped() TextBlock {
			let block = new TextBlock("one two three four five six seven eight nine ten eleven", Font{family: "system-ui"})
			block.layout.wrap = Wrap.Words
			return block
		}

		// A wrapped text's lines are placed one by one: centred, each in the middle of
		// the width; at the end, each against the right; filled, each but the last
		// reaching both sides.
		@test()
		def TestEachLineIsAligned() {
			let block = wrapped()
			block.arrange(Alignment.Center, false)
			let lines = block.paragraph(120.0).lines()
			assert lines.len() > 2
			for let line in lines {
				assert (line.left - (120.0 - line.width) / 2.0).abs() < 0.01
			}
			block.arrange(Alignment.End, false)
			for let line in block.paragraph(120.0).lines() {
				assert (line.left + line.width - 120.0).abs() < 0.01
			}
			block.arrange(Alignment.Fill, false)
			let filled = block.paragraph(120.0).lines()
			for let i = 0; i + 1 < filled.len(); i++ {
				assert (filled[i].left + filled[i].width - 120.0).abs() < 0.5
			}
			// Measured by its widest line wherever the lines are put.
			block.arrange(Alignment.Center, false)
			let centred = float(block.measure(Limit{width: 120(px)}).width)
			block.arrange(Alignment.Start, false)
			assert centred == float(block.measure(Limit{width: 120(px)}).width) && centred <= 120.0
		}

		// In a box that reads right to left, Start is the right side.
		@test()
		def TestRightToLeftStartsAtTheRight() {
			let block = wrapped()
			block.arrange(Alignment.Start, true)
			for let line in block.paragraph(120.0).lines() {
				assert line.rightToLeft && (line.left + line.width - 120.0).abs() < 0.01
			}
		}

		// `maxLines` keeps that many lines, and an ellipsis overflow ends the last one
		// kept with the ellipsis.
		@test()
		def TestMaxLinesEndInTheEllipsis() {
			let block = wrapped()
			block.layout.maxLines = 2
			let cut = block.paragraph(120.0)
			assert cut.lines().len() == 2 && cut.truncated()
			let plainEnd = cut.lines()[1].end
			block.layout.overflow = TextOverflow.Ellipsis
			block.changed()
			let marked = block.paragraph(120.0)
			let last = marked.lines()[1]
			assert marked.lines().len() == 2 && last.end <= plainEnd && last.left + last.width <= 120.0 + 0.01
			// The ellipsis is the last glyph, at the line's end (the text is ASCII:
			// characters are bytes).
			assert last.glyphs[last.glyphs.len() - 1].cluster == last.end
			assert float(block.measure(Limit{width: 120(px)}).height) == marked.lines()[1].bottom.ceil()
		}
	}

	check "TextShown" {
		def shown(text string, whitespace Whitespace, casing Casing = Casing.None) string {
			let block = new TextBlock(text, Font{family: "system-ui"})
			block.layout.whitespace = whitespace
			block.layout.casing = casing
			return shownText(block).slice(0, text.len())
		}

		// Collapse makes each run of spaces and line breaks one space and drops the one
		// at the end; PreserveLines keeps the breaks; Preserve keeps everything; a block
		// drawn as typed keeps everything too.
		@test()
		def TestWhitespaceIsDrawnAsItSays() {
			assert shown("a  b\n\nc  ", Whitespace.Collapse) == "a b c"
			assert shown("a  b\nc", Whitespace.PreserveLines) == "a b\nc"
			assert shown("a  b\nc", Whitespace.Preserve) == "a  b\nc"
			let typed = new TextBlock("a  b", Font{family: "system-ui"})
			typed.asTyped = true
			assert shownText(typed).slice(0, 4) == "a  b"
		}

		@test()
		def TestCasingChangesWhatIsDrawn() {
			assert shown("straße", Whitespace.Preserve, Casing.Upper) == "STRASSE"
			assert shown("ÉTÉ", Whitespace.Preserve, Casing.Lower) == "été"
			assert shown("hello wide world", Whitespace.Preserve, Casing.Capitalize) == "Hello Wide World"
			// The text itself is left as it was.
			let block = new TextBlock("abc", Font{family: "system-ui"})
			block.layout.casing = Casing.Upper
			assert block.text == "abc" && spansOf(block)[0].text == "ABC"
		}

		@test()
		def TestFontFeaturesReachTheSpans() {
			let off = featuresOf(Font{family: "system-ui", ligatures: false, features: {"tnum": 1}}, Casing.SmallCaps)
			assert off["liga"] == 0 && off["clig"] == 0 && off["tnum"] == 1 && off["smcp"] == 1
			assert featuresOf(Font{family: "system-ui"}, Casing.None).len() == 0
		}

		// A run's background, lowered or raised place and decoration reach its span; the
		// block's decoration is every span's unless a run has its own.
		@test()
		def TestRunsAndDecorationsReachTheSpans() {
			let block = new TextBlock("plain marked", Font{family: "system-ui"})
			block.decoration = styles.Decoration{underline: true}
			let mark = new Color(RGBA{r: 255, g: 240, b: 0, a: 255})
			block.runs = [TextRun{start: 6, end: 12, background: mark, shift: 2(px), decoration: styles.Decoration{strikethrough: true}}]
			let spans = spansOf(block)
			assert spans.len() >= 2
			let (first, last) = (spans[0], spans[spans.len() - 1])
			let under = first.decoration
			let through = last.decoration
			assert !(under is none) && under.underline && !under.strikethrough
			assert !(through is none) && through.strikethrough && !through.underline
			assert first.background is none && !(last.background is none) && last.shift == 2.0 && first.shift == 0.0
		}

		// A variable face is drawn at the font's weight and axes: one instance for each
		// point of its design space.
		@test()
		def TestVariableFacesTakeTheAxes() !none {
			let data = try os.readFile("samples/fonts/ttf/Selawik-VF-Subset.ttf")
			let face = try (try fonts.load(data)).face(0)
			assert face is fonts.VariableFace
			let bold = varied(face, Font{family: "Selawik", weight: FontWeight.Bold})
			let again = varied(face, Font{family: "Selawik", weight: FontWeight.Bold})
			let light = varied(face, Font{family: "Selawik", weight: FontWeight.Light})
			assert bold == again && bold != light
		}

		// A one-line text wider than its box with a Fade overflow fades toward its end:
		// the last columns hold less ink than the same text clipped.
		@test()
		def TestFadeFadesTheEnd() {
			let block = new TextBlock("a sentence far too long for this box", Font{family: "system-ui"})
			block.layout.wrap = Wrap.None
			let area = Rect{left: 0.0, top: 0.0, right: 100.0, bottom: 30.0}
			let clipped = new canvas.Canvas(100, 30)
			drawBlock(clipped, block, area, Align{}, false)
			block.layout.overflow = TextOverflow.Fade
			block.changed()
			let faded = new canvas.Canvas(100, 30)
			drawBlock(faded, block, area, Align{}, false)
			let ink = def (cv canvas.Canvas, from int, to int) int {
				let sum = 0
				for let y = 0; y < 30; y++ {
					for let x = from; x < to; x++ {
						sum += int(cv.pixels[(y * 100 + x) * 4 + 3])
					}
				}
				return sum
			}
			assert ink(faded, 90, 100) < ink(clipped, 90, 100) / 2 && ink(faded, 0, 30) == ink(clipped, 0, 30)
		}
	}
}
