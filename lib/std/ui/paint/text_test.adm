internal partial module std.ui.paint {
	use (
		std.testing
		std.ui::Limit
		std.ui.styles::*
		std.units::Pixels
	)

	check "TextOverflow" {
		// The width of the one line a paragraph sets.
		def lineWidth(block TextBlock, width float) float {
			let lines = block.fitted(width).lines()
			assert lines.len() == 1
			return lines[0].left + lines[0].width
		}

		// What stands for the characters left out, and where.
		@test()
		def TestShortTextPlacesTheEllipsis() {
			assert shortText("abcdefgh", 3, TextOverflow.Ellipsis) == "abc…"
			assert shortText("abcdefgh", 3, TextOverflow.EllipsisStart) == "…fgh"
			assert shortText("abcdefgh", 3, TextOverflow.EllipsisMiddle) == "ab…h"
			assert shortText("abcdefgh", 0, TextOverflow.Ellipsis) == "…"
			let runs = [TextRun{start: 0, end: 2}, TextRun{start: 5, end: 8}]
			let tail = runsWithin(runs, 5, 8, -4)
			assert tail.len() == 1 && tail[0].start == 1 && tail[0].end == 4
			let head = runsWithin(runs, 0, 1, 0)
			assert head.len() == 1 && head[0].start == 0 && head[0].end == 1
		}

		// A one-line text with an ellipsis overflow is drawn no wider than its room, as
		// much of it as fits; one that fits, wraps or only clips is left as it is.
		@test()
		def TestOneLineIsShortenedToItsRoom() {
			let block = new TextBlock("a sentence that is far too long for where it goes", Font{family: "system-ui"})
			block.layout.wrap = Wrap.None
			let whole = float(block.measure(Limit{}).width)
			assert whole > 200.0
			// Clipped: the line keeps its width.
			assert !block.shortens() && lineWidth(block, 100.0) > 200.0

			for let kind in [TextOverflow.Ellipsis, TextOverflow.EllipsisStart, TextOverflow.EllipsisMiddle] {
				block.layout.overflow = kind
				block.changed()
				assert block.shortens()
				let narrow = lineWidth(block, 100.0)
				let wider = lineWidth(block, 160.0)
				assert narrow <= 100.0 && narrow > 60.0 && wider <= 160.0 && wider > narrow
				// Room enough: the text as it is.
				assert lineWidth(block, whole + 1.0) == lineWidth(block, 0.0)
				// It asks for no more than the room it is given.
				assert float(block.measure(Limit{width: 100(px)}).width) <= 100.0
				assert float(block.measure(Limit{}).width) == whole
				// No room for a character: the ellipsis alone.
				assert lineWidth(block, 1.0) < 30.0
			}

			// A text that wraps is not shortened.
			block.layout.wrap = Wrap.Words
			block.changed()
			assert !block.shortens() && block.fitted(100.0).lines().len() > 1
		}
	}
}
