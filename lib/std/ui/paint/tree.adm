internal partial module std.ui.paint {
	use (
		std.gfx.canvas
		std.gfx.color::BlendMode
		std.math::tan
		std.math.geom::(Point, Rect, Size, Transform2D)
		std.time
		std.units::(Extent, Percent, Pixels)
		std.ui::RenderContext
		std.ui.frames
		std.ui.layout::(Node, Pass, toPixels)
		std.ui.styles::*
	)

	// The drawing layers, bottom to top.
	const layerOrder Layer[] = [Layer.Background, Layer.Content, Layer.Floating, Layer.Modal, Layer.Popup, Layer.Tooltip, Layer.Notification, Layer.Drag, Layer.Debug]

	// A node that starts a subtree drawn in `layer` instead of with its parent.
	struct LayerRoot {
		node  Node
		layer Layer
	}

	// An outline waiting for the outline pass of its layer, with the transform its node was
	// drawn under.
	struct PendingRing {
		shape     BoxShape
		ring      Ring
		transform Transform2D
		layer     Layer
	}

	// What a drawing of a tree leaves for the next one of the same tree, so that one can
	// draw only the part of the window that changed: see `paint` with `damage`.
	type Retained {
		// The outlines of the last drawing of the whole window, in the order drawn.
		rings           PendingRing[]
		// The nodes whose component asked from its `render`, in the last drawing, to be
		// drawn again.
		again           Node[]
		// When each of them wants it: at `dues[i]` when `timed[i]`, else on the next
		// frame the display shows.
		timed           bool[]
		dues            time.Time[]
		// What the last drawing of the whole window was for; a scale of 0: none was made.
		window          Size<Pixels>        = new Size<Pixels>(0(px), 0(px))
		scale           float
		// Whether it drew a filter or a backdrop: those read or spread pixels beyond the
		// box of what is under them, so a part of such a window cannot be drawn alone.
		spreads         bool
		// The number of the last drawing of the whole window, and of the last drawing.
		serial          int
		pass            int
		// The recording the last drawing of the whole window was made in, when it was
		// made in one, where that drawing starts in it, and the calls each node's drawing
		// took in it: from `starts[i]` up to `ends[i]` for `spans[i]`, which drew in
		// `boxes[i]` (device pixels, also kept in the node: `measure`).
		recording       ?canvas.DrawContext = none
		paintFrom       int
		spans           Node[]
		starts          int[]
		ends            int[]
		boxes           Rect[]
		// The same of the drawing of the whole window before it, which the last one is
		// compared with (`changedPart`), and the parts of the window drawn alone between
		// the two.
		before          ?canvas.DrawContext = none
		beforePaintFrom int
		beforeSpans     Node[]
		beforeStarts    int[]
		beforeEnds      int[]
		beforeBoxes     Rect[]
		beforeWindow    Size<Pixels>        = new Size<Pixels>(0(px), 0(px))
		beforeScale     float
		beforeSpreads   bool
		sinceBefore     ?DeviceBox          = none
		// The parts of the window drawn alone since the last drawing of the whole window.
		since           ?DeviceBox          = none
		// The nodes that had asked to be drawn again when the last drawing of the whole
		// window began: what they draw may have changed in place.
		forced          Node[]

		// Notes that `node` asked to be drawn again, at `due` or, with none, on the next
		// frame; what it asked before is replaced.
		def ask(node Node, due ?time.Time) {
			let at = again.len()
			for let (i, held) in again {
				at = i when held == node
			}
			if at == again.len() {
				again.push(node)
				timed.push(false)
				dues.push(new time.Time())
			}
			timed[at] = !(due is none)
			dues[at] = due unless due is none
		}

		// Whether the node at `i` of `again` wants to be drawn at `now`; with none, every
		// one does.
		def due(i int, now ?time.Time) bool {
			return true when !timed[i] || now is none
			return dues[i] <= now
		}

		// Forgets every node that asked.
		def settle() {
			again.len(0)
			timed.len(0)
			dues.len(0)
		}

		// Turns the kept recording into the box each node drew, kept in the node too.
		def measure() {
			let held = recording
			return when held is none
			boxes = held.inkBoxes(starts, ends)
			for let (i, node) in spans {
				let box = boxes[i]
				node.inkLeft = box.left
				node.inkTop = box.top
				node.inkRight = box.right
				node.inkBottom = box.bottom
				node.inkOf = serial
			}
		}

		// Makes the last drawing of the whole window the one before, for one that begins.
		def turn() {
			before = recording
			beforePaintFrom = paintFrom
			beforeSpans = spans
			beforeStarts = starts
			beforeEnds = ends
			beforeBoxes = boxes
			beforeWindow = window
			beforeScale = scale
			beforeSpreads = spreads
			sinceBefore = since
			since = none
			recording = none
			paintFrom = 0
			spans = []
			starts = []
			ends = []
			boxes = []
		}

		// Notes a part of the window drawn alone.
		def drew(part DeviceBox) {
			let held = since
			since = held is none ?? (part, spanning(held, part))
		}
	}

	// The box that holds both.
	def spanning(a DeviceBox, b DeviceBox) DeviceBox {
		return DeviceBox{left: a.left.min(b.left), top: a.top.min(b.top), right: a.right.max(b.right), bottom: a.bottom.max(b.bottom)}
	}

	// A rectangle of the window in device pixels.
	struct DeviceBox {
		left, top, right, bottom float
	}

	// The box holding the rectangle (`left`, `top`, `right`, `bottom`) moved by `by`.
	def boundsUnder(by Transform2D, left, top, right, bottom float) DeviceBox {
		let (
			x0 = left * by.a + top * by.c + by.tx
			y0 = left * by.b + top * by.d + by.ty
			x1 = right * by.a + top * by.c + by.tx
			y1 = right * by.b + top * by.d + by.ty
			x2 = right * by.a + bottom * by.c + by.tx
			y2 = right * by.b + bottom * by.d + by.ty
			x3 = left * by.a + bottom * by.c + by.tx
			y3 = left * by.b + bottom * by.d + by.ty
		)
		return DeviceBox{left: x0.min(x1).min(x2.min(x3)), top: y0.min(y1).min(y2.min(y3)), right: x0.max(x1).max(x2.max(x3)), bottom: y0.max(y1).max(y2.max(y3))}
	}

	// The part of `node`'s border box that can show, in device pixels: what is left of it
	// inside the padding box of every ancestor that clips, up to the node that starts its
	// layer (a subtree in a layer of its own is not held by the clips above it). Boxes
	// under a transform are taken by the rectangle that holds them, so the answer errs
	// on the side of showing.
	def shownBox(measure Measure, node Node) DeviceBox {
		let device = new Transform2D(a = measure.scale, d = measure.scale)
		let own = shapeOf(measure, node).border
		let box = boundsUnder(device.then(world(measure, node)), own.left, own.top, own.right, own.bottom)
		let inner = node
		for inner.box.layer == Layer.Content {
			let outer = inner.parent
			break when outer is none
			let look = outer.decoration
			if !(look is none) && look.clip {
				let hole = shapeOf(measure, outer).padding
				let seen = boundsUnder(device.then(world(measure, outer)), hole.left, hole.top, hole.right, hole.bottom)
				box = DeviceBox{left: box.left.max(seen.left), top: box.top.max(seen.top), right: box.right.min(seen.right), bottom: box.bottom.min(seen.bottom)}
			}
			inner = outer
		}
		return box
	}

	// What can show of `node` (`shownBox`) in whole device pixels inside a window `wide`
	// by `high` of them; none when nothing of it can.
	def shownPart(measure Measure, node Node, wide float, high float) ?DeviceBox {
		let part = shownBox(measure, node)
		let box = DeviceBox{left: part.left.floor().max(0.0), top: part.top.floor().max(0.0), right: part.right.ceil().min(wide), bottom: part.bottom.ceil().min(high)}
		return none when box.right <= box.left || box.bottom <= box.top
		return box
	}

	// The part of the window, in whole device pixels, that holds what can show of the
	// border boxes of the nodes in `kept.again`: what a drawing of only what they asked
	// for has to cover. A node of which nothing can show (it is scrolled out of what
	// holds it, or outside the window) adds nothing. None when nothing of any of them can
	// show, when no drawing of the whole window was made for a window of that size and
	// scale, or when that drawing had a filter or a backdrop in it. `kept` is only read.
	def damageOf(kept Retained, window Size<Pixels>, scale float, now ?time.Time = none) ?DeviceBox {
		return none when kept.again.len() == 0 || kept.spreads || kept.scale != scale || scale <= 0.0
		return none when kept.window.width != window.width || kept.window.height != window.height
		let measure = new Measure(float(window.width), float(window.height), scale)
		let (wide, high) = ((float(window.width) * scale).ceil(), (float(window.height) * scale).ceil())
		let all = DeviceBox{}
		let shown = false
		for let (i, node) in kept.again {
			// One that asked for a later time waits.
			continue when !kept.due(i, now)
			let box = shownPart(measure, node, wide, high)
			continue when box is none
			if shown {
				all = DeviceBox{left: all.left.min(box.left), top: all.top.min(box.top), right: all.right.max(box.right), bottom: all.bottom.max(box.bottom)}
			} else {
				all = box
				shown = true
			}
		}
		return none unless shown
		return all
	}

	// What a drawing of the whole window changed against the drawing of the whole window
	// before it, in whole device pixels (`changedPart`): the boxes of the frame before to
	// move first (`moves`, by `shifts`, two numbers a box), then the parts to draw again.
	type Change {
		parts  DeviceBox[]
		moves  DeviceBox[]
		shifts int[]

		// Whether nothing changed.
		def nothing() bool {
			return parts.len() == 0 && moves.len() == 0
		}

		// The box around every part and every place a move lands.
		def reach() DeviceBox {
			let all ?DeviceBox = none
			for let part in parts {
				all = all is none ?? (part, spanning(all, part))
			}
			for let (i, box) in moves {
				let landed = DeviceBox{left: box.left + float(shifts[i * 2]), top: box.top + float(shifts[i * 2 + 1]), right: box.right + float(shifts[i * 2]), bottom: box.bottom + float(shifts[i * 2 + 1])}
				all = all is none ?? (landed, spanning(all, landed))
			}
			return all is none ?? (DeviceBox{}, all)
		}
	}

	// What the last drawing of the whole window changed against the one before it (see
	// `Change`), for a frame that shows only that over the frame before (`partOf`); a
	// Change with nothing in it when nothing changed; none when all of it is to be shown:
	// no drawing before it in a recording, another window size or scale, a filter or a
	// backdrop in either, a node drawn in both in another order, a change in what the
	// drawing does outside every node (the outlines, the veil), or parts over half the
	// window.
	//
	// The two drawings may hold different nodes (`matchSpans`): one drawn now and not
	// then (scrolled into the box that holds it) is drawn whole, one drawn then and not
	// now is drawn over where it was. Each node drawn in both has its own calls (those of
	// its span outside its children's) compared call by call with those of the drawing
	// before (`mapCalls`, `DrawContext.sameCalls`). A stretch of them that differs only in
	// what it draws adds the boxes that stretch drew in both drawings; any other
	// difference adds what the node and the nodes under it drew in both. A node whose
	// only difference is the translation that places it (a scrolled view's content)
	// moved: when its clip is a rectangle, it moved by whole device pixels, nothing
	// before it changed where the clip can see and what is drawn before it paints the
	// clip in one colour (`DrawContext.paintsEvenly`), the frame before is moved inside
	// the clip and only what it does not cover is drawn, with what is drawn over the
	// node there, before and after the move. A node that asked to be drawn again or
	// whose component called `redraw()` since counts as changed whatever it records:
	// what it draws may have changed in place; the parts drawn alone in between are
	// added. Clears the components' `isRedrawn`.
	def changedPart(kept Retained) ?Change {
		let limits DeviceBox[]
		let forced = shownAgain(kept, limits)
		let (now, before) = (kept.recording, kept.before)
		return none when now is none || before is none
		return none when kept.spreads || kept.beforeSpreads || kept.scale != kept.beforeScale || kept.scale <= 0.0
		return none when kept.window.width != kept.beforeWindow.width || kept.window.height != kept.beforeWindow.height
		let (spans, olds) = (kept.spans, kept.beforeSpans)
		return none unless kept.boxes.len() == spans.len() && kept.beforeBoxes.len() == olds.len()
		let pairs int[]
		let backs int[]
		return none unless matchSpans(kept, pairs, backs)
		let fresh = segmentsOf(kept.starts, kept.ends, kept.paintFrom, now.count())
		let stale = segmentsOf(kept.beforeStarts, kept.beforeEnds, kept.beforePaintFrom, before.count())
		let mapped = mapCalls(fresh, stale, pairs, now.count(), spans.len(), olds.len())
		return none when mapped is none
		let count = fresh.len() / 3
		let same bool[]
		// Per span: whether what it and those under it drew changes as a whole, the
		// stretches of its own calls that only draw something else, and the call that
		// places it when that is its only difference (-1: none) with how far it moved. A
		// span whose component asked for part of it (`redraw(rect)`) is drawn again
		// within that part, unless its calls changed in another way.
		let whole bool[]
		let narrowed bool[]
		for let (i, on) in forced {
			let limited = on && limits[i].right > limits[i].left && limits[i].bottom > limits[i].top
			whole.push(on && !limited)
			narrowed.push(limited)
		}
		for let (i, j) in pairs {
			whole[i] = true when j < 0
		}
		let drawn int[]
		let moveAt int[]
		let moveOld int[]
		let moveBy Point[]
		for let i = 0; i < spans.len(); i++ {
			moveAt.push(-1)
			moveOld.push(-1)
			moveBy.push(new Point(0.0, 0.0))
		}
		// The calls of the drawn stretches that differ, each with the call of the
		// drawing before it stands for: a stretch that only draws something else adds
		// the boxes of those calls, not of the whole stretch (the whole stretch is every
		// own call of a component that holds no other, an editor's every line).
		let (drawnNow, drawnOld) = (int[], int[])
		for let k = 0; k < count; k++ {
			let (from, to, owner) = (fresh[k * 3], fresh[k * 3 + 1], fresh[k * 3 + 2])
			let (differing, placing, at, oldAt, unmapped) = (0, 0, -1, -1, false)
			let (changedNow, changedOld) = (int[], int[])
			for let p = from; p < to; p++ {
				let o = mapped[p]
				if o < 0 {
					unmapped = true
					differing++
					continue
				}
				continue when now.sameCalls(p, p + 1, before, o)
				differing++
				changedNow.push(p)
				changedOld.push(o)
				if !now.drawsOnly(p, p + 1) {
					placing++
					at = p
					oldAt = o
				}
			}
			same.push(differing == 0)
			continue when differing == 0
			return none when owner < 0
			if unmapped {
				whole[owner] = true
				continue
			}
			if placing == 0 {
				drawn.push(k)
				for let (i, p) in changedNow {
					drawnNow.push(p)
					drawnOld.push(changedOld[i])
				}
				continue
			}
			// Placed elsewhere: its text, recorded with the whole transform, differs too;
			// both are checked again once the move is known (`planMove`).
			let by = now.movedBy(at, before, oldAt)
			if placing == 1 && moveAt[owner] < 0 && !(by is none) {
				moveAt[owner] = at
				moveOld[owner] = oldAt
				moveBy[owner] = by
				continue
			}
			whole[owner] = true
		}
		let (wide, high) = ((float(kept.window.width) * kept.scale).ceil(), (float(kept.window.height) * kept.scale).ceil())
		let change = new Change()
		let boxes = DeviceBox[]
		let since = kept.sinceBefore
		boxes.push(since) unless since is none
		// The first node that only moved, with the siblings that moved with it
		// (`planMove`, which notes them in `movers`); any other node that moved is drawn
		// whole, and so are all of them when the move cannot be made.
		let moved = -1
		for let (i, at) in moveAt {
			continue when at < 0 || whole[i]
			moved = i
			break
		}
		let movers bool[]
		movers.len(spans.len())
		if moved >= 0 && !planMove(kept, now, before, moved, moveAt, moveOld, moveBy, movers, fresh, mapped, same, whole, forced, pairs, backs, boxes, change, wide, high) {
			for let i = 0; i < movers.len(); i++ {
				movers[i] = false
			}
			moved = -1
		}
		for let (i, at) in moveAt {
			whole[i] = true when at >= 0 && !movers[i]
		}
		if moved < 0 {
			// The calls that only draw something else: their boxes in both drawings.
			let (nowFrom, nowTo, oldFrom, oldTo, oldOf) = (int[], int[], int[], int[], int[])
			for let (i, p) in drawnNow {
				nowFrom.push(p)
				nowTo.push(p + 1)
				oldFrom.push(drawnOld[i])
				oldTo.push(drawnOld[i] + 1)
				oldOf.push(i)
			}
			if nowFrom.len() > 0 {
				for let box in now.inkBoxes(nowFrom, nowTo) {
					boxes.push(deviceBox(box))
				}
				sortPieces(oldFrom, oldTo, oldOf)
				for let box in before.inkBoxes(oldFrom, oldTo) {
					boxes.push(deviceBox(box))
				}
			}
			for let (i, on) in whole {
				continue unless on
				boxes.push(deviceBox(kept.boxes[i]))
				boxes.push(deviceBox(kept.beforeBoxes[pairs[i]])) when pairs[i] >= 0
			}
			for let (i, on) in narrowed {
				continue unless on && !whole[i]
				let cut = overlap(deviceBox(kept.boxes[i]), limits[i])
				boxes.push(cut) unless cut is none
				if pairs[i] >= 0 {
					let old = overlap(deviceBox(kept.beforeBoxes[pairs[i]]), limits[i])
					boxes.push(old) unless old is none
				}
			}
			for let (j, i) in backs {
				boxes.push(deviceBox(kept.beforeBoxes[j])) when i < 0
			}
		}
		for let box in boxes {
			let cut = within(box, wide, high)
			change.parts.push(cut) unless cut is none
		}
		change.parts = merged(change.parts)
		let area = 0.0
		for let part in change.parts {
			area += areaOf(part)
		}
		return none when area * 2.0 > wide * high
		return change
	}

	// Which span of the drawing before each span of the last drawing is of (`pairs`;
	// -1: its node was not drawn then), and the other way round (`backs`; -1: its node is
	// not drawn now). The nodes of the last drawing are told by `inkOf`, which `measure`
	// set. Both drawings list their nodes in tree order; false when a node drawn in both
	// is found out of order (a component moved in the tree).
	def matchSpans(kept Retained, pairs int[], backs int[]) bool {
		let (spans, olds) = (kept.spans, kept.beforeSpans)
		pairs.len(spans.len())
		backs.len(olds.len())
		let i = 0
		for let (j, old) in olds {
			if old.inkOf != kept.serial {
				backs[j] = -1
				continue
			}
			for i < spans.len() && spans[i] != old {
				pairs[i] = -1
				i++
			}
			return false when i >= spans.len()
			pairs[i] = j
			backs[j] = i
			i++
		}
		for i < spans.len() {
			pairs[i] = -1
			i++
		}
		return true
	}

	// For each call of the last drawing (runs `fresh`), the call of the drawing before
	// (runs `stale`) that stands where it stands: at the same place among its node's own
	// calls, the node's span being `pairs`ed, or among the calls outside every node; -1
	// when there is none (the node is new, or its own calls differ in number). None when
	// the calls outside every node differ in number: what the drawing does outside every
	// node changed.
	def mapCalls(fresh int[], stale int[], pairs int[], count int, spanCount int, oldCount int) ?int[] {
		// The runs of each owner, chained in order; the owner -1 is at the last slot.
		let (nowHead, nowNext) = chained(fresh, spanCount)
		let (oldHead, oldNext) = chained(stale, oldCount)
		let out int[]
		out.len(count)
		for let p = 0; p < count; p++ {
			out[p] = -1
		}
		for let i = -1; i < spanCount; i++ {
			let j = i < 0 ?? (-1, pairs[i])
			continue when i >= 0 && j < 0
			let (k, q) = (nowHead[i < 0 ?? (spanCount, i)], oldHead[j < 0 ?? (oldCount, j)])
			let (nowLength, oldLength) = (0, 0)
			for let r = k; r >= 0; r = nowNext[r] {
				nowLength += fresh[r * 3 + 1] - fresh[r * 3]
			}
			for let r = q; r >= 0; r = oldNext[r] {
				oldLength += stale[r * 3 + 1] - stale[r * 3]
			}
			if nowLength != oldLength {
				return none when i < 0
				continue
			}
			let (p, pEnd) = (0, 0)
			let (o, oEnd) = (0, 0)
			(p, pEnd) = (fresh[k * 3], fresh[k * 3 + 1]) when k >= 0
			(o, oEnd) = (stale[q * 3], stale[q * 3 + 1]) when q >= 0
			for {
				for k >= 0 && p >= pEnd {
					k = nowNext[k]
					(p, pEnd) = (fresh[k * 3], fresh[k * 3 + 1]) when k >= 0
				}
				for q >= 0 && o >= oEnd {
					q = oldNext[q]
					(o, oEnd) = (stale[q * 3], stale[q * 3 + 1]) when q >= 0
				}
				break when k < 0 || q < 0
				out[p] = o
				p++
				o++
			}
		}
		return out
	}

	// The runs of `segments` (triples, as `segmentsOf` gives them) chained per owner: the
	// first run of each owner (`head`, the owner -1 at slot `owners`; -1: none) and, per
	// run, the next run of the same owner (-1: none).
	def chained(segments int[], owners int) (int[], int[]) {
		let head int[]
		let tail int[]
		head.len(owners + 1)
		tail.len(owners + 1)
		for let i = 0; i <= owners; i++ {
			head[i] = -1
			tail[i] = -1
		}
		let next int[]
		let count = segments.len() / 3
		next.len(count)
		for let k = 0; k < count; k++ {
			next[k] = -1
			let owner = segments[k * 3 + 2]
			let slot = owner < 0 ?? (owners, owner)
			if head[slot] < 0 {
				head[slot] = k
			} else {
				next[tail[slot]] = k
			}
			tail[slot] = k
		}
		return (head, next)
	}

	// Appends to (`from`, `to`) the stretches of the drawing before that the calls from
	// `start` up to `end` of the last drawing stand for (`mapped`), each a run of
	// consecutive calls, and to `of` the number `owner` for each.
	def pieces(mapped int[], start int, end int, from int[], to int[], of int[], owner int) {
		let p = start
		for p < end {
			let o = mapped[p]
			if o < 0 {
				p++
				continue
			}
			let q = o + 1
			p++
			for p < end && mapped[p] == q {
				p++
				q++
			}
			from.push(o)
			to.push(q)
			of.push(owner)
		}
	}

	// Orders the stretches by their start, for `inkBoxes`; they never overlap.
	def sortPieces(from int[], to int[], of int[]) {
		for let i = 1; i < from.len(); i++ {
			let (f, t, o) = (from[i], to[i], of[i])
			let k = i
			for k > 0 && from[k - 1] > f {
				from[k] = from[k - 1]
				to[k] = to[k - 1]
				of[k] = of[k - 1]
				k--
			}
			from[k] = f
			to[k] = t
			of[k] = o
		}
	}

	// Plans the move of span `moved` of the last drawing and of its siblings that moved
	// with it (noted in `movers`): the children of one node, placed by the calls at
	// `moveAt` (at `moveOld` in the drawing before), which moved what follows by `moveBy`.
	// Adds the move to `change` and the boxes to draw again to `boxes`, as `changedPart`
	// says. False, with nothing added or changed, when the move cannot be made.
	def planMove(kept Retained, now canvas.DrawContext, before canvas.DrawContext, moved int, moveAt int[], moveOld int[], moveBy Point[], movers bool[], fresh int[], mapped int[], same bool[], whole bool[], forced bool[], pairs int[], backs int[], boxes DeviceBox[], change Change, wide float, high float) bool {
		let (spans, olds) = (kept.spans, kept.beforeSpans)
		let (at, oldAt, by) = (moveAt[moved], moveOld[moved], moveBy[moved])
		// The group: the spans of the children of the moved node's parent drawn inside
		// the parent's span (one in a layer of its own is drawn elsewhere), in both
		// drawings.
		let (first, last, oldFirst, oldLast) = (moved, moved, pairs[moved], pairs[moved])
		let parent = spans[moved].parent
		if !(parent is none) {
			let above = -1
			for let i = moved - 1; i >= 0 && above < 0; i-- {
				above = i when spans[i] == parent
			}
			return false when above < 0 || pairs[above] < 0
			first = -1
			for let i = above + 1; i < spans.len() && kept.starts[i] < kept.ends[above]; i++ {
				let held = spans[i].parent
				continue when held is none || held != parent
				first = i when first < 0
				last = i
			}
			let oldAbove = pairs[above]
			oldFirst = -1
			for let j = oldAbove + 1; j < olds.len() && kept.beforeStarts[j] < kept.beforeEnds[oldAbove]; j++ {
				let held = olds[j].parent
				continue when held is none || held != parent
				oldFirst = j when oldFirst < 0
				oldLast = j
			}
			return false when first < 0 || oldFirst < 0
		}
		let (start, end) = (kept.starts[first], kept.ends[last])
		let oldEnd = kept.beforeEnds[oldLast]
		// Under a translation and a uniform scale, by whole device pixels.
		let (t, u) = (now.transformAt(at), before.transformAt(oldAt))
		return false unless t.a == u.a && t.b == u.b && t.c == u.c && t.d == u.d && t.tx == u.tx && t.ty == u.ty
		return false unless t.b == 0.0 && t.c == 0.0 && t.a > 0.0 && t.a == t.d
		let (fx, fy) = (by.x * t.a, by.y * t.d)
		let (dx, dy) = (fx.round(), fy.round())
		return false unless (fx - dx).abs() < 1e-6 && (fy - dy).abs() < 1e-6 && (dx != 0.0 || dy != 0.0)
		// Inside a clip that is a rectangle, the same in both drawings.
		let (clip, oldClip) = (now.clipAt(at), before.clipAt(oldAt))
		return false when clip is none || oldClip is none
		return false unless clip.left == oldClip.left && clip.top == oldClip.top && clip.right == oldClip.right && clip.bottom == oldClip.bottom
		let shown = DeviceBox{left: clip.left.max(0.0), top: clip.top.max(0.0), right: clip.right.min(wide), bottom: clip.bottom.min(high)}
		return false when shown.right <= shown.left || shown.bottom <= shown.top
		let near = (box Rect) => box.right > shown.left && box.left < shown.right && box.bottom > shown.top && box.top < shown.bottom
		let shifted = def (box Rect) DeviceBox {
			return DeviceBox{left: box.left + dx, top: box.top + dy, right: box.right + dx, bottom: box.bottom + dy}
		}
		// Nothing drawn before the group changed where the clip can see: a stretch before
		// it that differs, a node before it drawn whole or drawn then and not now may
		// only draw outside the clip, in both drawings, and is drawn again there. A node
		// above the group drawn whole has the group in it.
		let (nowFrom, nowTo, oldFrom, oldTo, oldOf) = (int[], int[], int[], int[], int[])
		for let k = 0; k < same.len(); k++ {
			break when fresh[k * 3 + 1] > start
			continue when same[k]
			nowFrom.push(fresh[k * 3])
			nowTo.push(fresh[k * 3 + 1])
			pieces(mapped, fresh[k * 3], fresh[k * 3 + 1], oldFrom, oldTo, oldOf, nowFrom.len() - 1)
		}
		let outside = DeviceBox[]
		if nowFrom.len() > 0 {
			for let box in now.inkBoxes(nowFrom, nowTo) {
				return false when near(box)
				outside.push(deviceBox(box))
			}
			sortPieces(oldFrom, oldTo, oldOf)
			for let box in before.inkBoxes(oldFrom, oldTo) {
				return false when near(box)
				outside.push(deviceBox(box))
			}
		}
		for let i = 0; i < first; i++ {
			continue unless whole[i]
			return false when kept.ends[i] > start
			let (box, j) = (kept.boxes[i], pairs[i])
			return false when near(box)
			outside.push(deviceBox(box))
			if j >= 0 {
				let was = kept.beforeBoxes[j]
				return false when near(was)
				outside.push(deviceBox(was))
			}
		}
		for let j = 0; j < oldFirst; j++ {
			continue unless backs[j] < 0
			let was = kept.beforeBoxes[j]
			return false when near(was)
			outside.push(deviceBox(was))
		}
		// Painted evenly under the group.
		return false unless now.paintsEvenly(start, Rect{left: shown.left, top: shown.top, right: shown.right, bottom: shown.bottom})
		// The children that moved by the same amount move together.
		if !(parent is none) {
			for let i = first; i <= last; i++ {
				continue when moveAt[i] < 0 || whole[i]
				let held = spans[i].parent
				continue when held is none || held != parent
				let other = moveBy[i]
				movers[i] = (other.x - by.x).abs() < 1e-6 && (other.y - by.y).abs() < 1e-6
			}
		} else {
			movers[moved] = true
		}
		// Their own calls but the ones that place them, and those of the nodes under
		// them, are the same moved by that much; a node that still differs is drawn
		// whole.
		let still bool[]
		still.len(whole.len())
		for let k = 0; k < same.len(); k++ {
			continue when same[k]
			let (from, to, owner) = (fresh[k * 3], fresh[k * 3 + 1], fresh[k * 3 + 2])
			continue when owner < 0 || kept.starts[owner] < start || kept.ends[owner] > end
			let alike = true
			for let p = from; p < to && alike; p++ {
				continue when movers[owner] && p == moveAt[owner]
				let o = mapped[p]
				alike = o >= 0 && now.sameCalls(p, p + 1, before, o, dx, dy)
			}
			if alike {
				same[k] = true
				continue
			}
			still[owner] = true
		}
		for let i = first; i < whole.len() && kept.starts[i] < end; i++ {
			whole[i] = forced[i] || still[i] || pairs[i] < 0
		}
		// The whole pixels inside the clip, and what of them the frame before fills once moved.
		let inner = DeviceBox{left: shown.left.ceil(), top: shown.top.ceil(), right: shown.right.floor(), bottom: shown.bottom.floor()}
		let landed = DeviceBox{left: inner.left.max(inner.left + dx), top: inner.top.max(inner.top + dy), right: inner.right.min(inner.right + dx), bottom: inner.bottom.min(inner.bottom + dy)}
		return false when landed.right <= landed.left || landed.bottom <= landed.top
		change.moves.push(DeviceBox{left: landed.left - dx, top: landed.top - dy, right: landed.right - dx, bottom: landed.bottom - dy})
		change.shifts.push(int(dx))
		change.shifts.push(int(dy))
		boxes.push(...outside)
		// What the move uncovers, and the partial pixels at the clip's edges.
		boxes.push(DeviceBox{left: inner.left, top: inner.top, right: inner.right, bottom: landed.top}) when landed.top > inner.top
		boxes.push(DeviceBox{left: inner.left, top: landed.bottom, right: inner.right, bottom: inner.bottom}) when landed.bottom < inner.bottom
		boxes.push(DeviceBox{left: inner.left, top: landed.top, right: landed.left, bottom: landed.bottom}) when landed.left > inner.left
		boxes.push(DeviceBox{left: landed.right, top: landed.top, right: inner.right, bottom: landed.bottom}) when landed.right < inner.right
		boxes.push(DeviceBox{left: shown.left.floor(), top: shown.top.floor(), right: inner.left, bottom: shown.bottom.ceil()}) when shown.left < inner.left
		boxes.push(DeviceBox{left: inner.right, top: shown.top.floor(), right: shown.right.ceil(), bottom: shown.bottom.ceil()}) when shown.right > inner.right
		boxes.push(DeviceBox{left: shown.left.floor(), top: shown.top.floor(), right: shown.right.ceil(), bottom: inner.top}) when shown.top < inner.top
		boxes.push(DeviceBox{left: shown.left.floor(), top: inner.bottom, right: shown.right.ceil(), bottom: shown.bottom.ceil()}) when shown.bottom > inner.bottom
		// What changed under the siblings that did not move, and every stretch drawn
		// beside or after the group (the parent's own calls among its children, over the
		// group, or beside it): in both drawings, and where the move took what the frame
		// before showed of it.
		let (afterFrom, afterTo, wasFrom, wasTo, wasOf) = (int[], int[], int[], int[], int[])
		let changedHere bool[]
		for let k = 0; k < same.len(); k++ {
			let (from, to, owner) = (fresh[k * 3], fresh[k * 3 + 1], fresh[k * 3 + 2])
			let inGroup = owner >= 0 && kept.starts[owner] >= start && kept.ends[owner] <= end
			let inside = inGroup && !movers[owner]
			let beside = from >= start && !inGroup
			continue unless beside || inside && !same[k]
			afterFrom.push(from)
			afterTo.push(to)
			changedHere.push(!same[k])
			pieces(mapped, from, to, wasFrom, wasTo, wasOf, afterFrom.len() - 1)
		}
		if afterFrom.len() > 0 {
			sortPieces(wasFrom, wasTo, wasOf)
			let (fresher, staler) = (now.inkBoxes(afterFrom, afterTo), before.inkBoxes(wasFrom, wasTo))
			// A stretch is drawn again when it changed or either of its boxes reaches the
			// clip.
			let drawnAgain bool[]
			for let (e, box) in fresher {
				drawnAgain.push(changedHere[e] || near(box))
			}
			for let (q, was) in staler {
				drawnAgain[wasOf[q]] = true when near(was)
			}
			for let (e, box) in fresher {
				boxes.push(deviceBox(box)) when drawnAgain[e]
			}
			for let (q, was) in staler {
				continue unless drawnAgain[wasOf[q]]
				boxes.push(deviceBox(was))
				boxes.push(shifted(was))
			}
		}
		// Nodes in the group drawn whole, and those drawn then and not now: in both
		// drawings and moved. Nodes drawn whole after the group, and those gone from
		// there, likewise where they reach the clip.
		for let i = first; i < whole.len(); i++ {
			continue unless whole[i]
			let (box, j) = (kept.boxes[i], pairs[i])
			let inside = kept.starts[i] < end
			boxes.push(deviceBox(box))
			continue when j < 0
			let was = kept.beforeBoxes[j]
			boxes.push(deviceBox(was))
			boxes.push(shifted(was)) when inside || near(was)
		}
		for let j = oldFirst; j < backs.len(); j++ {
			continue unless backs[j] < 0
			let was = kept.beforeBoxes[j]
			let inside = kept.beforeStarts[j] < oldEnd
			continue unless inside || near(was)
			boxes.push(deviceBox(was))
			boxes.push(shifted(was))
		}
		// Stretches drawn differently before the group cannot be here (nothing before it
		// changed where the clip sees).
		let since = kept.sinceBefore
		boxes.push(DeviceBox{left: since.left + dx, top: since.top + dy, right: since.right + dx, bottom: since.bottom + dy}) unless since is none
		return true
	}

	def deviceBox(box Rect) DeviceBox {
		return DeviceBox{left: box.left, top: box.top, right: box.right, bottom: box.bottom}
	}

	// `box` in whole device pixels inside a window `wide` by `high` of them; none when
	// nothing of it is.
	def within(box DeviceBox, wide float, high float) ?DeviceBox {
		let cut = DeviceBox{left: box.left.floor().max(0.0), top: box.top.floor().max(0.0), right: box.right.ceil().min(wide), bottom: box.bottom.ceil().min(high)}
		return none when cut.right <= cut.left || cut.bottom <= cut.top
		return cut
	}

	def areaOf(box DeviceBox) float {
		return (box.right - box.left) * (box.bottom - box.top)
	}

	// The boxes with every two joined into the box around them where that box is not much
	// larger than the two (a quarter more): each box left costs a replay of the drawing,
	// each pixel added a pixel drawn.
	def merged(boxes DeviceBox[]) DeviceBox[] {
		let out = boxes.clone()
		let joined = true
		for joined {
			joined = false
			for let i = 0; i < out.len() && !joined; i++ {
				for let k = i + 1; k < out.len(); k++ {
					let (a, b) = (out[i], out[k])
					let around = spanning(a, b)
					continue when areaOf(around) * 4.0 > (areaOf(a) + areaOf(b)) * 5.0
					out[i] = around
					out.remove(k)
					joined = true
					break
				}
			}
		}
		return out
	}

	// Which spans of the last drawing of the whole window are shown again whatever they
	// call: those of the nodes that asked to be drawn again, and of the components that
	// called `redraw()`, whose mark is cleared. `limits` gets, per span, the part of the
	// window its component asked to be drawn again (`redraw(rect)`, taken from
	// `frames`) in device pixels, or a box with its right edge before its left for all
	// of it.
	def shownAgain(kept Retained, limits DeviceBox[]) bool[] {
		let out bool[]
		for let node in kept.spans {
			let owner = node.owner
			let marked = false
			let limit = DeviceBox{left: 1.0, top: 1.0, right: 0.0, bottom: 0.0}
			if !(owner is none) {
				marked = owner.isRedrawn
				owner.isRedrawn = false when marked
				let part = frames.redrawPartOf(owner)
				if marked && !(part is none) {
					limit = DeviceBox{left: (float(part.left) * kept.scale).floor(), top: (float(part.top) * kept.scale).floor(), right: (float(part.right) * kept.scale).ceil(), bottom: (float(part.bottom) * kept.scale).ceil()}
				}
			}
			let asked = false
			for let held in kept.forced {
				asked = true when held == node
			}
			out.push(marked || asked)
			limits.push(limit)
		}
		return out
	}

	// Where two boxes overlap; none when they do not.
	def overlap(a DeviceBox, b DeviceBox) ?DeviceBox {
		let cut = DeviceBox{left: a.left.max(b.left), top: a.top.max(b.top), right: a.right.min(b.right), bottom: a.bottom.min(b.bottom)}
		return none when cut.right <= cut.left || cut.bottom <= cut.top
		return cut
	}

	// The calls of a recording from `from` up to `to` cut into runs that belong to one
	// span alone (the innermost span open there; -1 for none), as (from, to, span)
	// triples, empty runs kept: two recordings of one tree give runs of the same spans in
	// the same order. `starts` and `ends` hold spans ordered by their start, each inside
	// the one before or after its end.
	def segmentsOf(starts int[], ends int[], from int, to int) int[] {
		let out int[]
		let open int[]
		let at = from
		for let (i, start) in starts {
			for open.len() > 0 && ends[open[open.len() - 1]] <= start {
				let top = open.pop()
				out.push(at)
				out.push(ends[top])
				out.push(top)
				at = ends[top]
			}
			out.push(at)
			out.push(start)
			out.push(open.len() > 0 ?? (open[open.len() - 1], -1))
			at = start
			open.push(i)
		}
		for open.len() > 0 {
			let top = open.pop()
			out.push(at)
			out.push(ends[top])
			out.push(top)
			at = ends[top]
		}
		out.push(at)
		out.push(to)
		out.push(-1)
		return out
	}

	// The calls a frame needs that shows only what `change` (from `changedPart`) says
	// changed in the last drawing of the whole window, over the frame before: the moves
	// first, then each part filled with `ground` and the drawing cut off at it, without
	// the nodes (and what is under them) that drew nothing in it and without the calls made
	// before the drawing began (the frame's clear). None when that drawing was not made in
	// a recording.
	def partOf(kept Retained, change Change, ground ?Paint) ?canvas.DrawContext {
		let whole = kept.recording
		return none when whole is none
		let out = new canvas.DrawContext(whole.size())
		for let (i, box) in change.moves {
			out.move(Rect{left: box.left, top: box.top, right: box.right, bottom: box.bottom}, change.shifts[i * 2], change.shifts[i * 2 + 1])
		}
		for let part in change.parts {
			let box = Rect{left: part.left, top: part.top, right: part.right, bottom: part.bottom}
			out.save()
			out.clip(box)
			if !(ground is none) {
				out.save()
				out.setComposite(canvas.Composite.Copy)
				out.fill(box, ground)
				out.restore()
			}
			let leaveFrom int[]
			let leaveTo int[]
			leaveFrom.push(0)
			leaveTo.push(kept.paintFrom)
			let past = 0
			for let (i, start) in kept.starts {
				continue when start < past
				let ink = kept.boxes[i]
				let misses = ink.right <= part.left || ink.left >= part.right || ink.bottom <= part.top || ink.top >= part.bottom
				continue unless misses
				leaveFrom.push(start)
				leaveTo.push(kept.ends[i])
				past = kept.ends[i]
			}
			whole.replay(out, leaveFrom, leaveTo)
			out.restore()
		}
		return out
	}

	// How long from `now` until a node of `kept.again` wants to be drawn, at most `longest`;
	// 0s when one wants the next frame, `longest` when none asked. While a part of the
	// window can be drawn alone (see `damageOf`), a node of which nothing can show does
	// not count.
	def waitOf(kept Retained, window Size<Pixels>, scale float, now time.Time, longest duration) duration {
		let alone = !kept.spreads && kept.scale == scale && scale > 0.0 && kept.window.width == window.width && kept.window.height == window.height
		let measure = new Measure(float(window.width), float(window.height), scale > 0.0 ?? (scale, 1.0))
		let (wide, high) = ((float(window.width) * scale).ceil(), (float(window.height) * scale).ceil())
		let wait = longest
		for let (i, node) in kept.again {
			continue when alone && shownPart(measure, node, wide, high) is none
			return 0s when kept.due(i, now)
			let left = kept.dues[i] - now
			wait = left when left < wait
		}
		return wait
	}

	// The times the component whose `render` runs asked to be drawn again at
	// (`askedBy`): how many it gave, and the earliest.
	type AskTimes {
		count int
		at    ?time.Time = none
	}

	let askTimes = new AskTimes()

	// From a component's `render`, beside its ask to be drawn again: at `at` is soon
	// enough. For the view runtime (`redrawBy`).
	def askedBy(at time.Time) {
		askTimes.count++
		let had = askTimes.at
		return when !(had is none) && had <= at
		askTimes.at = at
	}

	// What turns layout's numbers into the pixels a frame uses: the device scale and the
	// window's size for extents.
	type Measure {
		// Device pixels per logical pixel.
		scale float
		// Resolves extents: holds the window's size in logical pixels.
		pass  Pass

		// A window of that size in logical pixels.
		def new(width float, height float, scale float) {
			self.scale = scale
			pass = new Pass(width, height)
		}

		// `value` moved to the nearest device pixel.
		def snap(value float) float {
			return (value * scale).round() / scale
		}

		// A line width as a whole number of device pixels, at least one for a width above
		// zero.
		def snapWidth(width float) float {
			return 0.0 when width <= 0.0
			return (width * scale).round().max(1.0) / scale
		}
	}

	// One drawing of a tree: the canvas and what the passes share.
	type Frame {
		canvas     canvas.Painter
		measure    Measure
		// Device pixels per logical pixel.
		scale      float
		shadows    ShadowCache
		// What this drawing leaves for the next: its outlines, the nodes that asked again.
		kept       Retained
		// Set when only that part of the window is drawn, over what the drawing before
		// left there.
		damage     ?DeviceBox          = none
		// The part of the window, in device pixels, that what is drawn now can reach:
		// inside the padding box of every clipping node open above, and inside `damage`;
		// none: all of the window. A node that cannot reach it is left out with what is
		// under it (`outside`).
		clipBox    ?DeviceBox          = none
		// How many times the nodes drawn so far inside the `render` under way asked to be
		// drawn again.
		askedBelow int
		// How many of those asks gave a time.
		timedBelow int
		// Set when each node is drawn by its component's `render`: what a render records
		// its own drawing in.
		draw       ?canvas.DrawContext = none
		// The contexts the renders under way draw with, one per depth: a `render` draws
		// the nodes under it inside its own call. Each is filled again for the next node
		// at its depth, as `draw` is reset for it.
		contexts   RenderContext[]
		depth      int

		def new(target canvas.Painter, window Size<Pixels>, scale float, shadows ShadowCache) {
			canvas = target
			self.scale = scale
			self.shadows = shadows
			kept = new Retained()
			measure = new Measure(float(window.width), float(window.height), scale)
		}

		def snap(value float) float {
			return measure.snap(value)
		}

		def snapWidth(width float) float {
			return measure.snapWidth(width)
		}

		// Whether a drawing of a part of the window leaves `node` and what is under it out:
		// the last drawing of the whole window measured what they drew, none of it is in
		// the part, and no node that asked to be drawn again is among them.
		def culls(node Node) bool {
			let part = damage
			return false when part is none || node.inkOf != kept.serial || node.wantedIn == kept.pass
			return node.inkRight <= part.left || node.inkLeft >= part.right || node.inkBottom <= part.top || node.inkTop >= part.bottom
		}

		// Notes where the drawing of `node` starts in the recording a drawing of the whole
		// window is made in; -1 when it is not made in one.
		def openSpan(node Node) int {
			let into = kept.recording
			return -1 when into is none || !(damage is none)
			kept.spans.push(node)
			kept.starts.push(into.count())
			kept.ends.push(-1)
			return kept.spans.len() - 1
		}

		// Notes where the drawing `openSpan` gave `span` for ends.
		def closeSpan(span int) {
			let into = kept.recording
			return when span < 0 || into is none
			kept.ends[span] = into.count()
		}

		// Whether nothing drawn inside `box`, a rectangle in the canvas's coordinates as
		// they are now, can show: the drawing covers only a part of the window and the
		// box is outside it.
		def misses(box Rounded) bool {
			let part = damage
			return false when part is none
			let seen = boundsUnder(canvas.state().transform, box.left, box.top, box.right, box.bottom)
			return seen.right <= part.left || seen.left >= part.right || seen.bottom <= part.top || seen.top >= part.bottom
		}

		// What `clipBox` becomes inside a clip to `box`, a rectangle in the canvas's
		// coordinates as they are now: the box that holds the clip in device pixels, cut
		// by the clip box so far. Under a turn the box holds more than the clip, so a node
		// is only ever left out when it is outside the clip.
		def clipWithin(box Rounded) DeviceBox {
			let seen = boundsUnder(canvas.state().transform, box.left, box.top, box.right, box.bottom)
			let held = clipBox
			return seen when held is none
			return DeviceBox{left: seen.left.max(held.left), top: seen.top.max(held.top), right: seen.right.min(held.right), bottom: seen.bottom.min(held.bottom)}
		}
	}

	// Whether nothing `node` or the nodes under it draw can reach `clip`, a part of the
	// window in device pixels: the box they can reach (`subtreeReach`, one value kept in
	// the node) under the transform that places the node misses it. `by` maps the
	// coordinates of the node's parent to device pixels; the parent's border box starts at
	// (`parentLeft`, `parentTop`) in the window. A node that asked to be drawn again in
	// this pass, or holds one, is never left out: a drawing of a part of the window counts
	// on its `render` to ask again.
	def outside(frame Frame, node Node, clip DeviceBox, by Transform2D, parentLeft float, parentTop float) bool {
		return false when node.wantedIn == frame.kept.pass
		let (l, t, r, b) = subtreeReach(frame, node)
		let measure = frame.measure
		let geom = node.geom
		let (
			left = measure.snap(float(geom.frame.left))
			top  = measure.snap(float(geom.frame.top))
		)
		let (ox, oy) = (left - parentLeft, top - parentTop)
		let decoration = node.decoration
		if !(decoration is none) && !plainTransform(decoration.transform) {
			let own = matrixOf(measure, decoration.transform, measure.snap(float(geom.frame.right)) - left, measure.snap(float(geom.frame.bottom)) - top, node.em)
			if !(own is none) {
				return missesUnder(by.then(new Transform2D(tx = ox, ty = oy)).then(own), l, t, r, b, clip)
			}
		}
		return missesUnder(by, l + ox, t + oy, r + ox, b + oy, clip)
	}

	// Whether (`dx`, `dy`), logical pixels, is a whole number of device pixels each way.
	def wholePixels(scale float, dx float, dy float) bool {
		let (x, y) = (dx * scale, dy * scale)
		return (x - x.round()).abs() < 1e-6 && (y - y.round()).abs() < 1e-6
	}

	// The box, in `node`'s own coordinates (logical pixels from the top-left of its border
	// box on device pixels, before its own transform), that it and the nodes under it can
	// reach: its border box and what its decoration draws outside it (`ownReach`), and the
	// same of every visible node under it, each under the transform that places it (the
	// box that holds a turned box, so a node is only ever left out when it is outside); a
	// blur filter spreads all of it by three radii. A node that clips holds its text and
	// the children drawn with it inside its padding box, so of its children only those
	// that start a layer of their own count.
	//
	// Kept in the node from one drawing to the next (`Node.reachKept`) and made again when
	// layout or the decoration said something under the node changed (`Node.reachChanged`)
	// or the scale or the window is another. It is exact where it was made (`reachX`,
	// `reachY`). Read a whole number of device pixels from there (scrolled), it is a device
	// pixel larger on each side: what snapping a position that sits on a half device pixel
	// can do under a scale that is no power of two. Read a fraction of a device pixel from
	// there it is made again, and so is one that holds a text set in its box or a turned
	// box anywhere else than where it was made (`reachPinned`: how a text is set in its
	// snapped width and how a turned box snaps depend on the place).
	def subtreeReach(frame Frame, node Node) (float, float, float, float) {
		let measure = frame.measure
		let geom = node.geom
		let (x, y) = (float(geom.frame.left), float(geom.frame.top))
		if node.reachKept && node.reachScale == frame.scale && node.reachWide == measure.pass.windowWidth && node.reachHigh == measure.pass.windowHeight {
			return (node.reachLeft, node.reachTop, node.reachRight, node.reachBottom) when x == node.reachX && y == node.reachY
			if !node.reachPinned && wholePixels(frame.scale, x - node.reachX, y - node.reachY) {
				let pad = 1.0 / frame.scale
				return (node.reachLeft - pad, node.reachTop - pad, node.reachRight + pad, node.reachBottom + pad)
			}
		}
		let (
			left   = measure.snap(x)
			top    = measure.snap(y)
			width  = measure.snap(float(geom.frame.right)) - left
			height = measure.snap(float(geom.frame.bottom)) - top
		)
		let decoration = node.decoration
		let clips = !(decoration is none) && decoration.clip
		let (l, t, r, b, pinned) = ownReach(frame, node, decoration, left, top, width, height, !clips)
		for let child in node.children {
			continue when !child.box.visible
			continue when clips && child.box.layer == Layer.Content
			let (cl, ct, cr, cb) = subtreeReach(frame, child)
			pinned = pinned || child.reachPinned
			let placed = child.geom
			let (
				childLeft = measure.snap(float(placed.frame.left))
				childTop  = measure.snap(float(placed.frame.top))
			)
			let look = child.decoration
			if !(look is none) && !plainTransform(look.transform) {
				let own = matrixOf(measure, look.transform, measure.snap(float(placed.frame.right)) - childLeft, measure.snap(float(placed.frame.bottom)) - childTop, child.em)
				if !(own is none) {
					let turned = boundsUnder(own, cl, ct, cr, cb)
					(cl, ct, cr, cb) = (turned.left, turned.top, turned.right, turned.bottom)
					pinned = true
				}
			}
			let (ox, oy) = (childLeft - left, childTop - top)
			l = l.min(cl + ox)
			t = t.min(ct + oy)
			r = r.max(cr + ox)
			b = b.max(cb + oy)
		}
		if !(decoration is none) {
			let spread = 0.0
			for let filter in decoration.filters {
				match filter {
					case canvas.Blur:
						spread += 3.0 * float(filter.radius)
					default:
				}
			}
			(l, t, r, b) = (l - spread, t - spread, r + spread, b + spread)
		}
		node.reachLeft = l
		node.reachTop = t
		node.reachRight = r
		node.reachBottom = b
		node.reachX = x
		node.reachY = y
		node.reachScale = frame.scale
		node.reachWide = measure.pass.windowWidth
		node.reachHigh = measure.pass.windowHeight
		node.reachPinned = pinned
		node.reachKept = true
		return (l, t, r, b)
	}

	// Whether the transform is the one every style starts with, which changes nothing:
	// what `matrixOf` finds out after resolving the units, read off the fields.
	def plainTransform(transform Transform) bool {
		return false unless transform.matrix is none && float(transform.rotate) == 0.0 && transform.scale.x == 1.0 && transform.scale.y == 1.0
		return false unless float(transform.skew.x) == 0.0 && float(transform.skew.y) == 0.0
		return zeroExtent(transform.translate.x) && zeroExtent(transform.translate.y)
	}

	// Whether the extent is a plain zero (in pixels or percent); any other unit is
	// resolved by `matrixOf`.
	def zeroExtent(extent Extent) bool {
		match extent {
			case Pixels:
				return float(extent) == 0.0
			case Percent:
				return float(extent) == 0.0
			default:
				return false
		}
	}

	// Whether the box (`left`, `top`, `right`, `bottom`) moved by `by` lies outside `clip`.
	def missesUnder(by Transform2D, left float, top float, right float, bottom float, clip DeviceBox) bool {
		return true when right <= left || bottom <= top
		let (
			x0 = left * by.a + top * by.c + by.tx
			y0 = left * by.b + top * by.d + by.ty
			x1 = right * by.a + top * by.c + by.tx
			y1 = right * by.b + top * by.d + by.ty
			x2 = right * by.a + bottom * by.c + by.tx
			y2 = right * by.b + bottom * by.d + by.ty
			x3 = left * by.a + bottom * by.c + by.tx
			y3 = left * by.b + bottom * by.d + by.ty
		)
		return x0.max(x1).max(x2.max(x3)) <= clip.left || x0.min(x1).min(x2.min(x3)) >= clip.right || y0.max(y1).max(y2.max(y3)) <= clip.top || y0.min(y1).min(y2.min(y3)) >= clip.bottom
	}

	// The box, in the node's own coordinates, that its own passes can reach: its border
	// box (`width` by `height`, at (`left`, `top`) in the window), the outer shadows and
	// glows as far as `castOuter` draws them, the outline ring, and, with `text`, its text
	// where that is taller or wider than its content box, an em around it for the ink of
	// its glyphs. The last value says whether the text was set for it: how it is set
	// depends on the box's place on device pixels.
	def ownReach(frame Frame, node Node, decoration ?Decoration, left float, top float, width float, height float, text bool) (float, float, float, float, bool) {
		let (l, t, r, b) = (0.0, 0.0, width, height)
		return (l, t, r, b, false) when decoration is none
		for let shadow in decoration.shadows {
			match shadow {
				case canvas.DropShadow:
					let pad = wholePad(frame, float(shadow.spread).max(0.0) + 1.5 * float(shadow.blur).max(0.0) + 1.0)
					l = l.min(shadow.offset.x - pad)
					t = t.min(shadow.offset.y - pad)
					r = r.max(width + shadow.offset.x + pad)
					b = b.max(height + shadow.offset.y + pad)
				case canvas.OuterGlow:
					let pad = wholePad(frame, float(shadow.spread).max(0.0) + 1.5 * float(shadow.blur).max(0.0) + 1.0)
					l = l.min(-pad)
					t = t.min(-pad)
					r = r.max(width + pad)
					b = b.max(height + pad)
				default:
			}
		}
		let ring = decoration.outline
		let ringWidth = frame.snapWidth(float(ring.width))
		if ringWidth > 0.0 && ring.line != LineStyle.None {
			let out = float(ring.offset) + ringWidth
			l = l.min(-out)
			t = t.min(-out)
			r = r.max(width + out)
			b = b.max(height + out)
		}
		let block = decoration.text
		return (l, t, r, b, false) when !text || block is none
		// The content box as `shapeOf` makes it, and the text set in it as `drawBlock`
		// draws it.
		let measure = frame.measure
		let sides = decoration.border
		let (
			edgeTop    = measure.snapWidth(sideWidth(sides.top)).min(height)
			edgeRight  = measure.snapWidth(sideWidth(node.rtl ?? (sides.left, sides.right))).min(width)
			edgeBottom = measure.snapWidth(sideWidth(sides.bottom)).min(height)
			edgeLeft   = measure.snapWidth(sideWidth(node.rtl ?? (sides.right, sides.left))).min(width)
		)
		let geom = node.geom
		let inner = geom.content
		let (
			areaLeft   = (measure.snap(float(geom.frame.left) + float(inner.left)) - left).max(edgeLeft)
			areaTop    = (measure.snap(float(geom.frame.top) + float(inner.top)) - top).max(edgeTop)
			areaRight  = (measure.snap(float(geom.frame.left) + float(inner.right)) - left).min(width - edgeRight)
			areaBottom = (measure.snap(float(geom.frame.top) + float(inner.bottom)) - top).min(height - edgeBottom)
		)
		return (l, t, r, b, false) when areaRight <= areaLeft || areaBottom <= areaTop
		block.arrange(node.box.align.horizontal, node.rtl)
		let set = block.fitted(areaRight - areaLeft)
		let lines = set.lines()
		return (l, t, r, b, false) when lines.len() == 0
		let em = float(block.size)
		let overX = (set.contentWidth() - (areaRight - areaLeft)).max(0.0) + em
		let overY = (shownHeight(lines) - (areaBottom - areaTop)).max(0.0) + em
		return (l.min(areaLeft - overX), t.min(areaTop - overY), r.max(areaRight + overX), b.max(areaBottom + overY), true)
	}

	// Draws the tree under `root`, laid out by `Node.arrange`, on `target`: a canvas, or a
	// renderer's recording. `window` is the window's size in logical pixels, `scale` the
	// device pixels per logical pixel. Each layer is drawn in turn,
	// bottom to top, with its outlines after its nodes. A node whose `layer` is not Content
	// starts a subtree drawn in that layer, which takes its descendants that say Content with
	// it; such a subtree keeps the transforms of its ancestors and nothing else of them: not
	// their clip, mask, opacity, blend or filters. `shadows` kept by the caller from frame to
	// frame saves blurring every shadow again. With `draw`, a node that has an owner is drawn
	// by the owner's `render`, which gets the passes through its `RenderContext`. With `veil`,
	// the window is covered with it under each subtree of the Modal layer: what is behind a
	// dialog is dimmed.
	//
	// `kept`, the same object from frame to frame, takes the nodes whose `render` asked to
	// be drawn again. With `damage` (from `damageOf(kept, ...)`) only that part of the
	// window is drawn, over what the drawing before left on `target`: it is filled with
	// `ground` first, every component is drawn cut off at it, and what a clipping node
	// holds is left out when the node's padding box is outside it, and so is a node when
	// the drawing before was made in a recording and what the node and the nodes under
	// it drew there is outside the part. A component that asks from its `render` to be
	// drawn again must draw what changes inside its border box.
	def paint(target canvas.Painter, root Node, window Size<Pixels>, scale float = 1.0, shadows ?ShadowCache = none, draw ?canvas.DrawContext = none, veil ?Paint = none, kept ?Retained = none, damage ?DeviceBox = none, ground ?Paint = none, now ?time.Time = none) {
		return when !root.box.visible || scale <= 0.0
		let cache = new ShadowCache()
		cache = shadows unless shadows is none
		let frame = new Frame(target, window, scale, cache)
		frame.draw = draw
		frame.kept = kept unless kept is none
		frame.damage = damage
		frame.clipBox = damage
		let memo = frame.kept
		memo.pass++
		if damage is none {
			memo.turn()
			memo.rings.len(0)
			memo.window = window
			memo.scale = scale
			memo.spreads = false
			memo.serial++
			memo.forced = memo.again.clone()
			if target is canvas.DrawContext {
				memo.recording = target
				memo.paintFrom = target.count()
			}
		} else {
			memo.drew(damage)
			// The nodes that asked, and what holds them, are drawn whatever they drew
			// last. Those that asked for a later time stay asked; one of them the part draws
			// anyway asks again from its `render`.
			let (asking, timed, dues) = (memo.again, memo.timed, memo.dues)
			memo.again = []
			memo.timed = []
			memo.dues = []
			for let (i, node) in asking {
				if timed[i] && !(now is none) && dues[i] > now {
					memo.ask(node, dues[i])
					continue
				}
				let up = node
				for {
					up.wantedIn = memo.pass
					let above = up.parent
					break when above is none
					up = above
				}
			}
		}
		memo.settle() when damage is none
		target.save()
		if !(damage is none) {
			let part = Rect{left: damage.left, top: damage.top, right: damage.right, bottom: damage.bottom}
			target.clip(part)
			if !(ground is none) {
				target.save()
				target.setComposite(canvas.Composite.Copy)
				target.fill(part, ground)
				target.restore()
			}
		}
		target.scale(scale, scale)
		let base = target.state().transform
		let roots = layerRoots(root)
		for let layer in layerOrder {
			for let entry in roots {
				continue when entry.layer != layer
				let parent = entry.node.parent
				target.setTransform(base)
				// A subtree in a layer of its own is not held by the clips above it.
				frame.clipBox = damage
				if layer == Layer.Modal && !(veil is none) {
					// The veil comes and goes with what it is under.
					let above = entry.node.decoration
					let shown = above is none ?? (1.0, above.opacity.clamp(0.0, 1.0))
					target.save()
					target.setAlpha(shown)
					target.fill(Rect{left: 0.0, top: 0.0, right: float(window.width), bottom: float(window.height)}, veil)
					target.restore()
				}
				if parent is none {
					paintNode(frame, entry.node, layer, 0.0, 0.0)
				} else {
					target.transform(world(frame.measure, parent))
					paintNode(frame, entry.node, layer, frame.snap(float(parent.geom.frame.left)), frame.snap(float(parent.geom.frame.top)))
				}
			}
			for let pending in memo.rings {
				continue when pending.layer != layer
				target.setTransform(pending.transform)
				outline(frame, pending.shape, pending.ring)
			}
		}
		// A part of the window uses only some of the shadows: none is dropped for it.
		cache.turn() when damage is none
		target.restore()
		// What each node drew is known from here on.
		memo.measure() when damage is none
	}

	// Draws the tree on a canvas that is the whole window, in device pixels.
	def paint(target canvas.Canvas, root Node, scale float = 1.0, shadows ?ShadowCache = none) {
		return when scale <= 0.0
		let painter canvas.Painter = target
		paint(painter, root, new Size<Pixels>(float(target.width) / scale * 1(px), float(target.height) / scale * 1(px)), scale, shadows)
	}

	// Appends the nodes under `node` that start a layer of their own, in tree order: every
	// node in a layer other than Content, so what floats is out of the clips above it even
	// under a float of its own layer (the menu of a line of a menu).
	def collect(node Node, roots LayerRoot[]) {
		for let child in node.children {
			continue when !child.box.visible
			let own = child.box.layer
			roots.push(LayerRoot{node: child, layer: own}) when own != Layer.Content
			collect(child, roots)
		}
	}

	// The transform from the node's own coordinates to the window's logical pixels.
	def world(measure Measure, node Node) Transform2D {
		let parent = node.parent
		return local(measure, node, 0.0, 0.0) when parent is none
		return world(measure, parent).then(local(measure, node, measure.snap(float(parent.geom.frame.left)), measure.snap(float(parent.geom.frame.top))))
	}

	// The transform from the node's own coordinates to its parent's, whose border box
	// starts at (`parentLeft`, `parentTop`) in the window: the node's place, then its
	// `transform`.
	def local(measure Measure, node Node, parentLeft float, parentTop float) Transform2D {
		let geom = node.geom
		let (
			left = measure.snap(float(geom.frame.left))
			top  = measure.snap(float(geom.frame.top))
		)
		let placed = new Transform2D(tx = left - parentLeft, ty = top - parentTop)
		let decoration = node.decoration
		return placed when decoration is none
		let own = matrixOf(measure, decoration.transform, measure.snap(float(geom.frame.right)) - left, measure.snap(float(geom.frame.bottom)) - top, node.em)
		return placed when own is none
		return placed.then(own)
	}

	// The matrix of a `Transform` for a box of that size, or none when it changes nothing. A
	// point is scaled, slanted and turned about `origin`, then moved by `translate`, then
	// put through `matrix`, which works in the box's own coordinates.
	def matrixOf(measure Measure, transform Transform, width float, height float, em float) ?Transform2D {
		let (
			moveX  = toPixels(measure.pass, transform.translate.x, width, em)
			moveY  = toPixels(measure.pass, transform.translate.y, height, em)
			turn   = float(transform.rotate)
			slantX = float(transform.skew.x)
			slantY = float(transform.skew.y)
			extra  = transform.matrix
		)
		let plain = moveX == 0.0 && moveY == 0.0 && turn == 0.0 && slantX == 0.0 && slantY == 0.0 && transform.scale.x == 1.0 && transform.scale.y == 1.0
		return none when plain && extra is none
		let (
			originX = transform.origin.x * width
			originY = transform.origin.y * height
		)
		let matrix = new Transform2D(tx = moveX + originX, ty = moveY + originY)
		matrix = matrix.then(new Transform2D().rotation(turn)) when turn != 0.0
		matrix = matrix.then(new Transform2D(c = tan(slantX), b = tan(slantY))) when slantX != 0.0 || slantY != 0.0
		matrix = matrix.then(new Transform2D(a = transform.scale.x, d = transform.scale.y))
		matrix = matrix.then(new Transform2D(tx = -originX, ty = -originY))
		return matrix when extra is none
		return extra.then(matrix)
	}

	// Draws `node` and what is under it in `layer`. The canvas is in the coordinates of the
	// node's parent, whose border box starts at (`parentLeft`, `parentTop`) in the window.
	// Around the passes go, from the inside out: filters, opacity and blend, the mask, the
	// transform.
	def paintNode(frame Frame, node Node, layer Layer, parentLeft float, parentTop float) {
		return when frame.culls(node)
		let span = frame.openSpan(node)
		drawNode(frame, node, layer, parentLeft, parentTop)
		frame.closeSpan(span)
	}

	// `paintNode`, for a node that is drawn.
	def drawNode(frame Frame, node Node, layer Layer, parentLeft float, parentTop float) {
		let target = frame.canvas
		let shape = shapeOf(frame.measure, node)
		let decoration = node.decoration
		target.save()
		target.transform(local(frame.measure, node, parentLeft, parentTop))
		if decoration is none {
			render(frame, node, shape, none, layer)
			target.restore()
			return
		}
		let ring = decoration.outline
		// The outlines of a part of the window are those of the whole window's drawing.
		frame.kept.rings.push(PendingRing{shape: shape, ring: ring, transform: target.state().transform, layer: layer}) when float(ring.width) > 0.0 && frame.damage is none
		let opacity = decoration.opacity.clamp(0.0, 1.0)
		if opacity <= 0.0 {
			target.restore()
			return
		}
		let effects = effectsOf(decoration.filters)
		frame.kept.spreads = true when effects.len() > 0 || decoration.backdrop.len() > 0
		let mask = decoration.mask
		let grouped = opacity < 1.0 || decoration.blend != BlendMode.Normal
		if mask is none {
			grouped = grouped || effects.len() > 0
			target.beginGroup(opacity = opacity, blend = decoration.blend, effects = effects) when grouped
			render(frame, node, shape, decoration, layer)
			target.endGroup() when grouped
		} else {
			target.beginGroup(opacity = opacity, blend = decoration.blend)
			target.beginGroup(effects = effects) when effects.len() > 0
			render(frame, node, shape, decoration, layer)
			target.endGroup() when effects.len() > 0
			// Keeps what was drawn where the mask paints, by the mask's alpha, and nothing
			// outside the border box.
			target.setComposite(canvas.Composite.DestinationIn)
			target.fill(pathOf(shape.border), mask)
			target.endGroup()
		}
		target.restore()
	}

	// Draws the node inside its groups: through its owner's `render` when the frame has a
	// recording for it, else the passes in their fixed order.
	def render(frame Frame, node Node, shape BoxShape, decoration ?Decoration, layer Layer) {
		let passes = new NodePasses(frame, node, shape, decoration, layer)
		let owner = node.owner
		let draw = frame.draw
		if owner is none || draw is none {
			passes.outerShadows()
			passes.background()
			passes.borders()
			passes.childNodes()
			passes.innerShadows()
			return
		}
		draw.reset()
		frame.contexts.push(new RenderContext(draw)) when frame.contexts.len() <= frame.depth
		let context = frame.contexts[frame.depth]
		context.draw = draw
		// The resolved style: the look of the states that hold, when any does.
		context.style = owner.style
		let look = owner.style.shown
		context.style = look unless look is none
		context.geometry = node.geom
		context.scale = frame.scale
		context.direction = shape.rtl ?? (Direction.RightToLeft, Direction.LeftToRight)
		context.passes = passes
		// The nodes under this one are drawn inside its `render`: what they asked is theirs.
		let (asked, around) = (frames.repaintsAsked(), frame.askedBelow)
		let (gave, gaveAround, outer) = (askTimes.count, frame.timedBelow, askTimes.at)
		frame.askedBelow = 0
		frame.timedBelow = 0
		askTimes.at = none
		frame.depth += 1
		let enclosing = frames.rendering(owner)
		owner.render(context)
		frames.rendered(enclosing)
		frame.depth -= 1
		let all = frames.repaintsAsked() - asked
		let allTimed = askTimes.count - gave
		if all > frame.askedBelow {
			// Every ask of its own gave a time: the earliest; else the next frame.
			let due = askTimes.at
			due = none when all - frame.askedBelow != allTimed - frame.timedBelow
			frame.kept.ask(node, due)
		}
		frame.askedBelow = around + all
		frame.timedBelow = gaveAround + allTimed
		askTimes.at = outer
		passes.flush()
		// Outside the drawing the passes do nothing; the context kept for the next
		// node at this depth (in `frame.contexts`) holding them would also hold the
		// frame, through them, and the frame it: a cycle that kept every frame's
		// drawing alive.
		context.passes = none
	}

	// The passes of one node, as a `RenderContext` calls them. What the component drew
	// itself before a pass is put on the canvas first, so its drawing and the passes land
	// in the order its `render` wrote them.
	type NodePasses {
		frame      Frame
		node       Node
		shape      BoxShape
		decoration ?Decoration
		layer      Layer

		def new(frame Frame, node Node, shape BoxShape, decoration ?Decoration, layer Layer) {
			self.frame = frame
			self.node = node
			self.shape = shape
			self.decoration = decoration
			self.layer = layer
		}

		// Draws what the component recorded so far.
		def flush() {
			let draw = frame.draw
			return when draw is none
			draw.replay(frame.canvas)
			draw.reset()
		}

		// The backdrop, then the shadows that fall outside.
		def outerShadows() {
			flush()
			let look = decoration
			return when look is none
			backdrop(frame, shape, look)
			drawOuterShadows(frame, shape, look)
		}

		def background() {
			flush()
			let look = decoration
			drawBackground(frame, shape, look) unless look is none
		}

		def borders() {
			flush()
			let look = decoration
			drawBorders(frame, shape, look) unless look is none
		}

		// The node's text and children.
		def childNodes() {
			flush()
			let look = decoration
			if look is none {
				drawChildNodes(frame, node, shape, layer, false)
			} else {
				content(frame, node, shape, look, layer)
			}
		}

		def innerShadows() {
			flush()
			let look = decoration
			drawInnerShadows(frame, shape, look) unless look is none
		}
	}

	// Draws what is inside the node: its text, then its child nodes, both cut off at the
	// padding box when the node clips.
	def content(frame Frame, node Node, shape BoxShape, decoration Decoration, layer Layer) {
		let block = decoration.text
		if block is none {
			drawChildNodes(frame, node, shape, layer, decoration.clip)
			return
		}
		return when decoration.clip && frame.misses(shape.padding)
		let target = frame.canvas
		let outerClip = frame.clipBox
		if decoration.clip {
			target.save()
			if isSquare(shape.padding) {
				target.clip(rectOf(shape.padding))
			} else {
				target.clip(pathOf(shape.padding))
			}
			frame.clipBox = frame.clipWithin(shape.padding)
		}
		drawText(frame, shape, block, node.box.align)
		drawChildNodes(frame, node, shape, layer, false)
		if decoration.clip {
			target.restore()
			frame.clipBox = outerClip
		}
	}

	// Draws the children of `node` in the Content layer (the others start a layer of their
	// own, drawn as that layer's), in order, cut off at the padding
	// box when `clipped`. A child that reaches nothing of `frame.clipBox` (scrolled out of
	// the box that holds it, or outside the part of the window drawn) is left out with
	// what is under it: it takes no span of the recording, and its `render` does not run.
	def drawChildNodes(frame Frame, node Node, shape BoxShape, layer Layer, clipped bool) {
		return when node.children.len() == 0
		return when clipped && frame.misses(shape.padding)
		let target = frame.canvas
		let outerClip = frame.clipBox
		if clipped {
			target.save()
			if isSquare(shape.padding) {
				target.clip(rectOf(shape.padding))
			} else {
				target.clip(pathOf(shape.padding))
			}
			frame.clipBox = frame.clipWithin(shape.padding)
		}
		let (
			left = frame.snap(float(node.geom.frame.left))
			top  = frame.snap(float(node.geom.frame.top))
		)
		let clip = frame.clipBox
		let placed = clip is none ?? (new Transform2D(), target.state().transform)
		for let child in node.children {
			continue when !child.box.visible
			// One in a layer of its own is drawn as that layer's.
			continue when child.box.layer != Layer.Content
			continue when !(clip is none) && outside(frame, child, clip, placed, left, top)
			paintNode(frame, child, layer, left, top)
		}
		if clipped {
			target.restore()
			frame.clipBox = outerClip
		}
	}

	// The style's filters as canvas effects. A filter always changes the component itself:
	// what is behind it is `backdrop`'s.
	def effectsOf(filters Filter[]) canvas.Effect[] {
		let effects canvas.Effect[]
		for let filter in filters {
			match filter {
				case canvas.Blur:
					effects.push(canvas.Blur{radius: filter.radius})
				case canvas.ColorAdjust:
					effects.push(canvas.ColorAdjust{brightness: filter.brightness, contrast: filter.contrast, saturation: filter.saturation, hue: filter.hue})
				case canvas.ColorMatrix:
					effects.push(canvas.ColorMatrix{values: filter.values})
			}
		}
		return effects
	}
}
