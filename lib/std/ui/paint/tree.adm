internal partial module std.ui.paint {
	use (
		std.gfx.canvas
		std.gfx.color::BlendMode
		std.math::tan
		std.math.geom::(Rect, Size, Transform2D)
		std.time
		std.units::Pixels
		std.ui::RenderContext
		std.ui.frames
		std.ui.layout::(Node, Pass, toPixels)
		std.ui.styles::*
	)

	// The drawing layers, bottom to top.
	const layerOrder Layer[] = [Layer.Background, Layer.Content, Layer.Floating, Layer.Modal, Layer.Popup, Layer.Tooltip, Layer.Notification, Layer.Drag, Layer.Debug]

	// A node that starts a subtree drawn in `layer` instead of with its parent.
	struct LayerRoot {
		node  Node
		layer Layer
	}

	// An outline waiting for the outline pass of its layer, with the transform its node was
	// drawn under.
	struct PendingRing {
		shape     BoxShape
		ring      Ring
		transform Transform2D
		layer     Layer
	}

	// What a drawing of a tree leaves for the next one of the same tree, so that one can
	// draw only the part of the window that changed: see `paint` with `damage`.
	type Retained {
		// The outlines of the last drawing of the whole window, in the order drawn.
		rings     PendingRing[]
		// The nodes whose component asked from its `render`, in the last drawing, to be
		// drawn again.
		again     Node[]
		// When each of them wants it: at `dues[i]` when `timed[i]`, else on the next
		// frame the display shows.
		timed     bool[]
		dues      time.Time[]
		// What the last drawing of the whole window was for; a scale of 0: none was made.
		window    Size<Pixels>        = new Size<Pixels>(0(px), 0(px))
		scale     float
		// Whether it drew a filter or a backdrop: those read or spread pixels beyond the
		// box of what is under them, so a part of such a window cannot be drawn alone.
		spreads   bool
		// The number of the last drawing of the whole window, and of the last drawing.
		serial    int
		pass      int
		// The recording the last drawing of the whole window was made in, when it was
		// made in one, with the calls each node's drawing took in it: from `starts[i]` up
		// to `ends[i]` for `spans[i]`. Kept until a drawing of a part asks what each node
		// drew (`measure`); a node's box is then in the node.
		recording ?canvas.DrawContext = none
		spans     Node[]
		starts    int[]
		ends      int[]

		// Notes that `node` asked to be drawn again, at `due` or, with none, on the next
		// frame; what it asked before is replaced.
		def ask(node Node, due ?time.Time) {
			let at = again.len()
			for let (i, held) in again {
				at = i when held == node
			}
			if at == again.len() {
				again.push(node)
				timed.push(false)
				dues.push(new time.Time())
			}
			timed[at] = !(due is none)
			dues[at] = due unless due is none
		}

		// Whether the node at `i` of `again` wants to be drawn at `now`; with none, every
		// one does.
		def due(i int, now ?time.Time) bool {
			return true when !timed[i] || now is none
			return dues[i] <= now
		}

		// Forgets every node that asked.
		def settle() {
			again.len(0)
			timed.len(0)
			dues.len(0)
		}

		// Turns the kept recording into the box each node drew, and lets go of it.
		def measure() {
			let held = recording
			return when held is none
			let boxes = held.inkBoxes(starts, ends)
			for let (i, node) in spans {
				let box = boxes[i]
				node.inkLeft = box.left
				node.inkTop = box.top
				node.inkRight = box.right
				node.inkBottom = box.bottom
				node.inkOf = serial
			}
			forget()
		}

		// Lets go of the kept recording.
		def forget() {
			recording = none
			spans.len(0)
			starts.len(0)
			ends.len(0)
		}
	}

	// A rectangle of the window in device pixels.
	struct DeviceBox {
		left, top, right, bottom float
	}

	// The box holding the rectangle (`left`, `top`, `right`, `bottom`) moved by `by`.
	def boundsUnder(by Transform2D, left, top, right, bottom float) DeviceBox {
		let (
			x0 = left * by.a + top * by.c + by.tx
			y0 = left * by.b + top * by.d + by.ty
			x1 = right * by.a + top * by.c + by.tx
			y1 = right * by.b + top * by.d + by.ty
			x2 = right * by.a + bottom * by.c + by.tx
			y2 = right * by.b + bottom * by.d + by.ty
			x3 = left * by.a + bottom * by.c + by.tx
			y3 = left * by.b + bottom * by.d + by.ty
		)
		return DeviceBox{left: x0.min(x1).min(x2.min(x3)), top: y0.min(y1).min(y2.min(y3)), right: x0.max(x1).max(x2.max(x3)), bottom: y0.max(y1).max(y2.max(y3))}
	}

	// The part of `node`'s border box that can show, in device pixels: what is left of it
	// inside the padding box of every ancestor that clips, up to the node that starts its
	// layer (a subtree in a layer of its own is not held by the clips above it). Boxes
	// under a transform are taken by the rectangle that holds them, so the answer errs
	// on the side of showing.
	def shownBox(measure Measure, node Node) DeviceBox {
		let device = new Transform2D(a = measure.scale, d = measure.scale)
		let own = shapeOf(measure, node).border
		let box = boundsUnder(device.then(world(measure, node)), own.left, own.top, own.right, own.bottom)
		let inner = node
		for inner.box.layer == Layer.Content {
			let outer = inner.parent
			break when outer is none
			let look = outer.decoration
			if !(look is none) && look.clip {
				let hole = shapeOf(measure, outer).padding
				let seen = boundsUnder(device.then(world(measure, outer)), hole.left, hole.top, hole.right, hole.bottom)
				box = DeviceBox{left: box.left.max(seen.left), top: box.top.max(seen.top), right: box.right.min(seen.right), bottom: box.bottom.min(seen.bottom)}
			}
			inner = outer
		}
		return box
	}

	// What can show of `node` (`shownBox`) in whole device pixels inside a window `wide`
	// by `high` of them; none when nothing of it can.
	def shownPart(measure Measure, node Node, wide float, high float) ?DeviceBox {
		let part = shownBox(measure, node)
		let box = DeviceBox{left: part.left.floor().max(0.0), top: part.top.floor().max(0.0), right: part.right.ceil().min(wide), bottom: part.bottom.ceil().min(high)}
		return none when box.right <= box.left || box.bottom <= box.top
		return box
	}

	// The part of the window, in whole device pixels, that holds what can show of the
	// border boxes of the nodes in `kept.again`: what a drawing of only what they asked
	// for has to cover. A node of which nothing can show (it is scrolled out of what
	// holds it, or outside the window) adds nothing. None when nothing of any of them can
	// show, when no drawing of the whole window was made for a window of that size and
	// scale, or when that drawing had a filter or a backdrop in it. `kept` is only read.
	def damageOf(kept Retained, window Size<Pixels>, scale float, now ?time.Time = none) ?DeviceBox {
		return none when kept.again.len() == 0 || kept.spreads || kept.scale != scale || scale <= 0.0
		return none when kept.window.width != window.width || kept.window.height != window.height
		let measure = new Measure(float(window.width), float(window.height), scale)
		let (wide, high) = ((float(window.width) * scale).ceil(), (float(window.height) * scale).ceil())
		let all = DeviceBox{}
		let shown = false
		for let (i, node) in kept.again {
			// One that asked for a later time waits.
			continue when !kept.due(i, now)
			let box = shownPart(measure, node, wide, high)
			continue when box is none
			if shown {
				all = DeviceBox{left: all.left.min(box.left), top: all.top.min(box.top), right: all.right.max(box.right), bottom: all.bottom.max(box.bottom)}
			} else {
				all = box
				shown = true
			}
		}
		return none unless shown
		return all
	}

	// How long from `now` until a node of `kept.again` wants to be drawn, at most `longest`;
	// 0s when one wants the next frame, `longest` when none asked. While a part of the
	// window can be drawn alone (see `damageOf`), a node of which nothing can show does
	// not count.
	def waitOf(kept Retained, window Size<Pixels>, scale float, now time.Time, longest duration) duration {
		let alone = !kept.spreads && kept.scale == scale && scale > 0.0 && kept.window.width == window.width && kept.window.height == window.height
		let measure = new Measure(float(window.width), float(window.height), scale > 0.0 ?? (scale, 1.0))
		let (wide, high) = ((float(window.width) * scale).ceil(), (float(window.height) * scale).ceil())
		let wait = longest
		for let (i, node) in kept.again {
			continue when alone && shownPart(measure, node, wide, high) is none
			return 0s when kept.due(i, now)
			let left = kept.dues[i] - now
			wait = left when left < wait
		}
		return wait
	}

	// The times the component whose `render` runs asked to be drawn again at
	// (`askedBy`): how many it gave, and the earliest.
	type AskTimes {
		count int
		at    ?time.Time = none
	}

	let askTimes = new AskTimes()

	// From a component's `render`, beside its ask to be drawn again: at `at` is soon
	// enough. For the view runtime (`redrawBy`).
	def askedBy(at time.Time) {
		askTimes.count++
		let had = askTimes.at
		return when !(had is none) && had <= at
		askTimes.at = at
	}

	// What turns layout's numbers into the pixels a frame uses: the device scale and the
	// window's size for extents.
	type Measure {
		// Device pixels per logical pixel.
		scale float
		// Resolves extents: holds the window's size in logical pixels.
		pass  Pass

		// A window of that size in logical pixels.
		def new(width float, height float, scale float) {
			self.scale = scale
			pass = new Pass(width, height)
		}

		// `value` moved to the nearest device pixel.
		def snap(value float) float {
			return (value * scale).round() / scale
		}

		// A line width as a whole number of device pixels, at least one for a width above
		// zero.
		def snapWidth(width float) float {
			return 0.0 when width <= 0.0
			return (width * scale).round().max(1.0) / scale
		}
	}

	// One drawing of a tree: the canvas and what the passes share.
	type Frame {
		canvas     canvas.Painter
		measure    Measure
		// Device pixels per logical pixel.
		scale      float
		shadows    ShadowCache
		// What this drawing leaves for the next: its outlines, the nodes that asked again.
		kept       Retained
		// Set when only that part of the window is drawn, over what the drawing before
		// left there.
		damage     ?DeviceBox          = none
		// How many times the nodes drawn so far inside the `render` under way asked to be
		// drawn again.
		askedBelow int
		// How many of those asks gave a time.
		timedBelow int
		// Set when each node is drawn by its component's `render`: what a render records
		// its own drawing in.
		draw       ?canvas.DrawContext = none

		def new(target canvas.Painter, window Size<Pixels>, scale float, shadows ShadowCache) {
			canvas = target
			self.scale = scale
			self.shadows = shadows
			kept = new Retained()
			measure = new Measure(float(window.width), float(window.height), scale)
		}

		def snap(value float) float {
			return measure.snap(value)
		}

		def snapWidth(width float) float {
			return measure.snapWidth(width)
		}

		// Whether a drawing of a part of the window leaves `node` and what is under it out:
		// the last drawing of the whole window measured what they drew, none of it is in
		// the part, and no node that asked to be drawn again is among them.
		def culls(node Node) bool {
			let part = damage
			return false when part is none || node.inkOf != kept.serial || node.wantedIn == kept.pass
			return node.inkRight <= part.left || node.inkLeft >= part.right || node.inkBottom <= part.top || node.inkTop >= part.bottom
		}

		// Notes where the drawing of `node` starts in the recording a drawing of the whole
		// window is made in; -1 when it is not made in one.
		def openSpan(node Node) int {
			let into = kept.recording
			return -1 when into is none
			kept.spans.push(node)
			kept.starts.push(into.count())
			kept.ends.push(-1)
			return kept.spans.len() - 1
		}

		// Notes where the drawing `openSpan` gave `span` for ends.
		def closeSpan(span int) {
			let into = kept.recording
			return when span < 0 || into is none
			kept.ends[span] = into.count()
		}

		// Whether nothing drawn inside `box`, a rectangle in the canvas's coordinates as
		// they are now, can show: the drawing covers only a part of the window and the
		// box is outside it.
		def misses(box Rounded) bool {
			let part = damage
			return false when part is none
			let seen = boundsUnder(canvas.state().transform, box.left, box.top, box.right, box.bottom)
			return seen.right <= part.left || seen.left >= part.right || seen.bottom <= part.top || seen.top >= part.bottom
		}
	}

	// Draws the tree under `root`, laid out by `Node.arrange`, on `target`: a canvas, or a
	// renderer's recording. `window` is the window's size in logical pixels, `scale` the
	// device pixels per logical pixel. Each layer is drawn in turn,
	// bottom to top, with its outlines after its nodes. A node whose `layer` is not Content
	// starts a subtree drawn in that layer, which takes its descendants that say Content with
	// it; such a subtree keeps the transforms of its ancestors and nothing else of them: not
	// their clip, mask, opacity, blend or filters. `shadows` kept by the caller from frame to
	// frame saves blurring every shadow again. With `draw`, a node that has an owner is drawn
	// by the owner's `render`, which gets the passes through its `RenderContext`. With `veil`,
	// the window is covered with it under each subtree of the Modal layer: what is behind a
	// dialog is dimmed.
	//
	// `kept`, the same object from frame to frame, takes the nodes whose `render` asked to
	// be drawn again. With `damage` (from `damageOf(kept, ...)`) only that part of the
	// window is drawn, over what the drawing before left on `target`: it is filled with
	// `ground` first, every component is drawn cut off at it, and what a clipping node
	// holds is left out when the node's padding box is outside it, and so is a node when
	// the drawing before was made in a recording and what the node and the nodes under
	// it drew there is outside the part. A component that asks from its `render` to be
	// drawn again must draw what changes inside its border box.
	def paint(target canvas.Painter, root Node, window Size<Pixels>, scale float = 1.0, shadows ?ShadowCache = none, draw ?canvas.DrawContext = none, veil ?Paint = none, kept ?Retained = none, damage ?DeviceBox = none, ground ?Paint = none, now ?time.Time = none) {
		return when !root.box.visible || scale <= 0.0
		let cache = new ShadowCache()
		cache = shadows unless shadows is none
		let frame = new Frame(target, window, scale, cache)
		frame.draw = draw
		frame.kept = kept unless kept is none
		frame.damage = damage
		let memo = frame.kept
		memo.pass++
		if damage is none {
			memo.rings.len(0)
			memo.window = window
			memo.scale = scale
			memo.spreads = false
			memo.serial++
			memo.forget()
			memo.recording = target when target is canvas.DrawContext
		} else {
			// What each node drew last is known from here on; the nodes that asked, and
			// what holds them, are drawn whatever they drew last.
			memo.measure()
			// Those that asked for a later time stay asked; one of them the part draws
			// anyway asks again from its `render`.
			let (asking, timed, dues) = (memo.again, memo.timed, memo.dues)
			memo.again = []
			memo.timed = []
			memo.dues = []
			for let (i, node) in asking {
				if timed[i] && !(now is none) && dues[i] > now {
					memo.ask(node, dues[i])
					continue
				}
				let up = node
				for {
					up.wantedIn = memo.pass
					let above = up.parent
					break when above is none
					up = above
				}
			}
		}
		memo.settle() when damage is none
		target.save()
		if !(damage is none) {
			let part = Rect{left: damage.left, top: damage.top, right: damage.right, bottom: damage.bottom}
			target.clip(part)
			if !(ground is none) {
				target.save()
				target.setComposite(canvas.Composite.Copy)
				target.fill(part, ground)
				target.restore()
			}
		}
		target.scale(scale, scale)
		let base = target.state().transform
		let roots = layerRoots(root)
		for let layer in layerOrder {
			for let entry in roots {
				continue when entry.layer != layer
				let parent = entry.node.parent
				target.setTransform(base)
				if layer == Layer.Modal && !(veil is none) {
					target.fill(Rect{left: 0.0, top: 0.0, right: float(window.width), bottom: float(window.height)}, veil)
				}
				if parent is none {
					paintNode(frame, entry.node, layer, 0.0, 0.0)
				} else {
					target.transform(world(frame.measure, parent))
					paintNode(frame, entry.node, layer, frame.snap(float(parent.geom.frame.left)), frame.snap(float(parent.geom.frame.top)))
				}
			}
			for let pending in memo.rings {
				continue when pending.layer != layer
				target.setTransform(pending.transform)
				outline(frame, pending.shape, pending.ring)
			}
		}
		// A part of the window uses only some of the shadows: none is dropped for it.
		cache.turn() when damage is none
		target.restore()
	}

	// Draws the tree on a canvas that is the whole window, in device pixels.
	def paint(target canvas.Canvas, root Node, scale float = 1.0, shadows ?ShadowCache = none) {
		return when scale <= 0.0
		let painter canvas.Painter = target
		paint(painter, root, new Size<Pixels>(float(target.width) / scale * 1(px), float(target.height) / scale * 1(px)), scale, shadows)
	}

	// Appends the nodes under `node` that start a layer of their own, in tree order.
	def collect(node Node, layer Layer, roots LayerRoot[]) {
		for let child in node.children {
			continue when !child.box.visible
			let own = child.box.layer
			if own == Layer.Content || own == layer {
				collect(child, layer, roots)
			} else {
				roots.push(LayerRoot{node: child, layer: own})
				collect(child, own, roots)
			}
		}
	}

	// The transform from the node's own coordinates to the window's logical pixels.
	def world(measure Measure, node Node) Transform2D {
		let parent = node.parent
		return local(measure, node, 0.0, 0.0) when parent is none
		return world(measure, parent).then(local(measure, node, measure.snap(float(parent.geom.frame.left)), measure.snap(float(parent.geom.frame.top))))
	}

	// The transform from the node's own coordinates to its parent's, whose border box
	// starts at (`parentLeft`, `parentTop`) in the window: the node's place, then its
	// `transform`.
	def local(measure Measure, node Node, parentLeft float, parentTop float) Transform2D {
		let geom = node.geom
		let (
			left = measure.snap(float(geom.frame.left))
			top  = measure.snap(float(geom.frame.top))
		)
		let placed = new Transform2D(tx = left - parentLeft, ty = top - parentTop)
		let decoration = node.decoration
		return placed when decoration is none
		let own = matrixOf(measure, decoration.transform, measure.snap(float(geom.frame.right)) - left, measure.snap(float(geom.frame.bottom)) - top, node.em)
		return placed when own is none
		return placed.then(own)
	}

	// The matrix of a `Transform` for a box of that size, or none when it changes nothing. A
	// point is scaled, slanted and turned about `origin`, then moved by `translate`, then
	// put through `matrix`, which works in the box's own coordinates.
	def matrixOf(measure Measure, transform Transform, width float, height float, em float) ?Transform2D {
		let (
			moveX  = toPixels(measure.pass, transform.translate.x, width, em)
			moveY  = toPixels(measure.pass, transform.translate.y, height, em)
			turn   = float(transform.rotate)
			slantX = float(transform.skew.x)
			slantY = float(transform.skew.y)
			extra  = transform.matrix
		)
		let plain = moveX == 0.0 && moveY == 0.0 && turn == 0.0 && slantX == 0.0 && slantY == 0.0 && transform.scale.x == 1.0 && transform.scale.y == 1.0
		return none when plain && extra is none
		let (
			originX = transform.origin.x * width
			originY = transform.origin.y * height
		)
		let matrix = new Transform2D(tx = moveX + originX, ty = moveY + originY)
		matrix = matrix.then(new Transform2D().rotation(turn)) when turn != 0.0
		matrix = matrix.then(new Transform2D(c = tan(slantX), b = tan(slantY))) when slantX != 0.0 || slantY != 0.0
		matrix = matrix.then(new Transform2D(a = transform.scale.x, d = transform.scale.y))
		matrix = matrix.then(new Transform2D(tx = -originX, ty = -originY))
		return matrix when extra is none
		return extra.then(matrix)
	}

	// Draws `node` and what is under it in `layer`. The canvas is in the coordinates of the
	// node's parent, whose border box starts at (`parentLeft`, `parentTop`) in the window.
	// Around the passes go, from the inside out: filters, opacity and blend, the mask, the
	// transform.
	def paintNode(frame Frame, node Node, layer Layer, parentLeft float, parentTop float) {
		return when frame.culls(node)
		let span = frame.openSpan(node)
		drawNode(frame, node, layer, parentLeft, parentTop)
		frame.closeSpan(span)
	}

	// `paintNode`, for a node that is drawn.
	def drawNode(frame Frame, node Node, layer Layer, parentLeft float, parentTop float) {
		let target = frame.canvas
		let shape = shapeOf(frame.measure, node)
		let decoration = node.decoration
		target.save()
		target.transform(local(frame.measure, node, parentLeft, parentTop))
		if decoration is none {
			render(frame, node, shape, none, layer)
			target.restore()
			return
		}
		let ring = decoration.outline
		// The outlines of a part of the window are those of the whole window's drawing.
		frame.kept.rings.push(PendingRing{shape: shape, ring: ring, transform: target.state().transform, layer: layer}) when float(ring.width) > 0.0 && frame.damage is none
		let opacity = decoration.opacity.clamp(0.0, 1.0)
		if opacity <= 0.0 {
			target.restore()
			return
		}
		let effects = effectsOf(decoration.filters)
		frame.kept.spreads = true when effects.len() > 0 || decoration.backdrop.len() > 0
		let mask = decoration.mask
		let grouped = opacity < 1.0 || decoration.blend != BlendMode.Normal
		if mask is none {
			grouped = grouped || effects.len() > 0
			target.beginGroup(opacity = opacity, blend = decoration.blend, effects = effects) when grouped
			render(frame, node, shape, decoration, layer)
			target.endGroup() when grouped
		} else {
			target.beginGroup(opacity = opacity, blend = decoration.blend)
			target.beginGroup(effects = effects) when effects.len() > 0
			render(frame, node, shape, decoration, layer)
			target.endGroup() when effects.len() > 0
			// Keeps what was drawn where the mask paints, by the mask's alpha, and nothing
			// outside the border box.
			target.setComposite(canvas.Composite.DestinationIn)
			target.fill(pathOf(shape.border), mask)
			target.endGroup()
		}
		target.restore()
	}

	// Draws the node inside its groups: through its owner's `render` when the frame has a
	// recording for it, else the passes in their fixed order.
	def render(frame Frame, node Node, shape BoxShape, decoration ?Decoration, layer Layer) {
		let passes = new NodePasses(frame, node, shape, decoration, layer)
		let owner = node.owner
		let draw = frame.draw
		if owner is none || draw is none {
			passes.outerShadows()
			passes.background()
			passes.borders()
			passes.childNodes()
			passes.innerShadows()
			return
		}
		draw.reset()
		let context = new RenderContext(draw)
		context.style = owner.style
		context.geometry = node.geom
		context.scale = frame.scale
		context.direction = shape.rtl ?? (Direction.RightToLeft, Direction.LeftToRight)
		context.passes = passes
		// The nodes under this one are drawn inside its `render`: what they asked is theirs.
		let (asked, around) = (frames.repaintsAsked(), frame.askedBelow)
		let (gave, gaveAround, outer) = (askTimes.count, frame.timedBelow, askTimes.at)
		frame.askedBelow = 0
		frame.timedBelow = 0
		askTimes.at = none
		owner.render(context)
		let all = frames.repaintsAsked() - asked
		let allTimed = askTimes.count - gave
		if all > frame.askedBelow {
			// Every ask of its own gave a time: the earliest; else the next frame.
			let due = askTimes.at
			due = none when all - frame.askedBelow != allTimed - frame.timedBelow
			frame.kept.ask(node, due)
		}
		frame.askedBelow = around + all
		frame.timedBelow = gaveAround + allTimed
		askTimes.at = outer
		passes.flush()
	}

	// The passes of one node, as a `RenderContext` calls them. What the component drew
	// itself before a pass is put on the canvas first, so its drawing and the passes land
	// in the order its `render` wrote them.
	type NodePasses {
		frame      Frame
		node       Node
		shape      BoxShape
		decoration ?Decoration
		layer      Layer

		def new(frame Frame, node Node, shape BoxShape, decoration ?Decoration, layer Layer) {
			self.frame = frame
			self.node = node
			self.shape = shape
			self.decoration = decoration
			self.layer = layer
		}

		// Draws what the component recorded so far.
		def flush() {
			let draw = frame.draw
			return when draw is none
			draw.replay(frame.canvas)
			draw.reset()
		}

		// The backdrop, then the shadows that fall outside.
		def outerShadows() {
			flush()
			let look = decoration
			return when look is none
			backdrop(frame, shape, look)
			drawOuterShadows(frame, shape, look)
		}

		def background() {
			flush()
			let look = decoration
			drawBackground(frame, shape, look) unless look is none
		}

		def borders() {
			flush()
			let look = decoration
			drawBorders(frame, shape, look) unless look is none
		}

		// The node's text and children.
		def childNodes() {
			flush()
			let look = decoration
			if look is none {
				drawChildNodes(frame, node, shape, layer, false)
			} else {
				content(frame, node, shape, look, layer)
			}
		}

		def innerShadows() {
			flush()
			let look = decoration
			drawInnerShadows(frame, shape, look) unless look is none
		}
	}

	// Draws what is inside the node: its text, then its child nodes, both cut off at the
	// padding box when the node clips.
	def content(frame Frame, node Node, shape BoxShape, decoration Decoration, layer Layer) {
		let block = decoration.text
		if block is none {
			drawChildNodes(frame, node, shape, layer, decoration.clip)
			return
		}
		return when decoration.clip && frame.misses(shape.padding)
		let target = frame.canvas
		if decoration.clip {
			target.save()
			if isSquare(shape.padding) {
				target.clip(rectOf(shape.padding))
			} else {
				target.clip(pathOf(shape.padding))
			}
		}
		drawText(frame, shape, block, node.box.align)
		drawChildNodes(frame, node, shape, layer, false)
		target.restore() when decoration.clip
	}

	// Draws the children of `node` that belong to `layer`, in order, cut off at the padding
	// box when `clipped`.
	def drawChildNodes(frame Frame, node Node, shape BoxShape, layer Layer, clipped bool) {
		return when node.children.len() == 0
		return when clipped && frame.misses(shape.padding)
		let target = frame.canvas
		if clipped {
			target.save()
			if isSquare(shape.padding) {
				target.clip(rectOf(shape.padding))
			} else {
				target.clip(pathOf(shape.padding))
			}
		}
		let (
			left = frame.snap(float(node.geom.frame.left))
			top  = frame.snap(float(node.geom.frame.top))
		)
		for let child in node.children {
			continue when !child.box.visible
			let own = child.box.layer
			continue when own != Layer.Content && own != layer
			paintNode(frame, child, layer, left, top)
		}
		target.restore() when clipped
	}

	// The style's filters as canvas effects. A blur always blurs the component itself.
	def effectsOf(filters Filter[]) canvas.Effect[] {
		let effects canvas.Effect[]
		for let filter in filters {
			match filter {
				case canvas.Blur:
					effects.push(canvas.Blur{radius: filter.radius})
				case canvas.ColorAdjust:
					effects.push(filter)
				case canvas.ColorMatrix:
					effects.push(filter)
			}
		}
		return effects
	}
}
