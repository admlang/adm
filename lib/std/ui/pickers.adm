partial module std.ui {
	use std.ui.renderer as r

	// A kind of file a dialog offers to show: its name as the dialog lists it and the
	// glob patterns of the files it takes: `FileFilter{name: "Images", patterns: ["*.png", "*.jpg"]}`.
	struct FileFilter {
		name     string
		patterns string[]
	}

	// Asks the user for a folder with the system's own dialog, shown over the window that
	// has the keyboard: the folder's path, or none when the user cancelled. `start` is the
	// folder the dialog opens in, when given. The call waits for the dialog, so a handler
	// runs it on a task: `async<tasks> { let folder = try await pickFolder() ... }`.
	//
	// Fails when the system has no file dialog (on Linux: no desktop portal on the session
	// bus) or the dialog fails.
	async def pickFolder(title string = "", start string = "") !?string {
		let picked = try await pickPaths(UI.dialogParent(), DialogKind.Folder, title, start, "", [], false)
		return none when picked.len() == 0
		return picked[0]
	}

	// Asks for a file, or for several with `multiple`, among those the filters show (every
	// file without filters): their paths, empty when the user cancelled.
	//
	// Fails when the system has no file dialog or the dialog fails.
	async def pickFiles(title string = "", start string = "", filters FileFilter[] = [], multiple bool = false) !string[] {
		return try await pickPaths(UI.dialogParent(), DialogKind.Open, title, start, "", filters, multiple)
	}

	// Asks where to save a file, `name` proposed: the path chosen, or none when the user
	// cancelled. The file is not written.
	//
	// Fails when the system has no file dialog or the dialog fails.
	async def saveFile(title string = "", start string = "", name string = "", filters FileFilter[] = []) !?string {
		let picked = try await pickPaths(UI.dialogParent(), DialogKind.Save, title, start, name, filters, false)
		return none when picked.len() == 0
		return picked[0]
	}

	// What a file dialog asks for.
	internal enum DialogKind {
		Folder,
		Open,
		Save,
	}

	// The title a dialog shows when the caller gives none.
	internal def dialogTitle(kind DialogKind, title string) string {
		return title unless title == ""
		return "Choose a folder" when kind == DialogKind.Folder
		return "Save" when kind == DialogKind.Save
		return "Open"
	}
}
