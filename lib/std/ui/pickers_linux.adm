@os("linux")
partial module std.ui {
	use (
		std.net.url
		std.proto::(DBusConnection, DBusMessage, DBusReader, DBusWriter, DBUS_ERROR, DBUS_SIGNAL, dbusConnect, dbusErrorMessage, dbusReadFailure, dbusSessionBusAddress)
		std.ui.renderer as r
	)

	internal const portalDesktop = "org.freedesktop.portal.Desktop"
	internal const portalDesktopPath = "/org/freedesktop/portal/desktop"
	internal const portalFileChooser = "org.freedesktop.portal.FileChooser"
	internal const portalRequest = "org.freedesktop.portal.Request"

	// Shows the desktop portal's file chooser (org.freedesktop.portal.FileChooser: `OpenFile`
	// for files and folders, `SaveFile`) over the parent window and waits for its `Response`
	// signal. Each dialog has a session bus connection of its own, so the request handle the
	// portal makes from the connection's name and the token is its own too.
	//
	// Fails when there is no session bus, no portal answers on it, or the portal refuses
	// the call.
	internal async def pickPaths(parent r.NativeWindow, kind DialogKind, title string, start string, name string, filters FileFilter[], multiple bool) !string[] {
		let address = try dbusSessionBusAddress()
		let bus = try dbusConnect(address)
		defer bus.close()
		try bus.subscribe(portalRequest, "Response", portalDesktop)
		let method = kind == DialogKind.Save ?? ("SaveFile", "OpenFile")
		let body = fileChooserBody(parent, kind, title, start, name, filters, multiple, "adm1")
		let reply = try bus.callSync(portalDesktop, portalDesktopPath, portalFileChooser, method, "ssa\{sv\}", body)
		fail "file dialog: {dbusErrorMessage(reply)}" when reply.kind == DBUS_ERROR
		let handle = new DBusReader(reply.body).readString()
		for {
			let message = bus.readMessage(30s) onerror (err error) {
				recover dbusReadFailure(err.code)
			}
			if message.kind == 0 {
				continue when message.errorName == "ETIMEDOUT"
				fail "file dialog: the session bus connection dropped"
			}
			continue unless message.kind == DBUS_SIGNAL && message.member == "Response" && message.path == handle
			return responsePaths(message.body)
		}
	}

	// The arguments of `OpenFile` and `SaveFile`: the parent window, the title and the
	// options (`ssa{sv}`): `handle_token`, `modal`, `directory` for a folder, `multiple`,
	// `current_folder` as a nul-ended path, `current_name` for a save, and `filters` as
	// `a(sa(us))`, each pattern a glob (kind 0).
	internal def fileChooserBody(parent r.NativeWindow, kind DialogKind, title string, start string, name string, filters FileFilter[], multiple bool, token string) byte[] {
		let w = new DBusWriter()
		w.putString(portalParentName(parent))
		w.putString(dialogTitle(kind, title))
		w.beginDict()
		w.dictString("handle_token", token)
		w.dictBool("modal", true)
		w.dictBool("directory", true) when kind == DialogKind.Folder
		w.dictBool("multiple", true) when kind == DialogKind.Open && multiple
		if start != "" {
			let path = start.bytes()
			path.push(0)
			w.dictBytes("current_folder", path)
		}
		w.dictString("current_name", name) when kind == DialogKind.Save && name != ""
		if filters.len() > 0 {
			w.beginEntry("filters", "a(sa(us))")
			let outer = w.beginArray(8)
			for let filter in filters {
				w.beginStruct()
				w.putString(filter.name)
				let inner = w.beginArray(8)
				for let pattern in filter.patterns {
					w.beginStruct()
					w.putUint32(0)
					w.putString(pattern)
				}
				w.endArray(inner, 8)
			}
			w.endArray(outer, 8)
		}
		w.endDict()
		return w.bytes()
	}

	// The portal's name for the window a dialog is shown over: `x11:` and the window id in
	// hex. "" (no parent) elsewhere: a Wayland surface is named across processes only by an
	// exporter the host does not run.
	internal def portalParentName(parent r.NativeWindow) string {
		return "x11:{parent.handle.hex().lower()}" when parent.system == "x11" && parent.handle != 0
		return ""
	}

	// The paths a `Response` signal carries (`(ua{sv})`): the `uris` of a chosen dialog, as
	// `file:` URIs; empty when the user cancelled (response 1) or the dialog was closed (2).
	internal def responsePaths(body byte[]) string[] {
		let reader = new DBusReader(body)
		let response = reader.readUint32()
		return [] when response != 0
		let end = reader.beginArray("\{sv\}")
		let out string[]
		for reader.pos < end && !reader.failed {
			reader.align(8)
			let key = reader.readString()
			let signature = reader.readVariant()
			if key == "uris" && signature == "as" {
				for let uri in reader.readStringArray() {
					let path = pathOfFileURI(uri)
					out.push(path) when path != ""
				}
			} else {
				reader.skip(signature)
			}
		}
		return out
	}

	// The file system path of a `file:` URI, percent-decoded; "" for any other URI.
	internal def pathOfFileURI(uri string) string {
		return "" unless uri.startsWith("file://")
		let rest = uri[7:]
		// An authority (`file://host/path`) is dropped: the path starts at its slash.
		let slash = rest.indexOf("/")
		return "" when slash < 0
		return url.pathUnescape(rest[slash:]) onerror recover ""
	}
}
