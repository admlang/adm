@os("linux")
partial module std.ui {
	use (
		std.proto::(DBusReader, DBusWriter)
		std.testing
		std.ui.renderer as r
	)

	check "File dialogs" {
		// Reads the `a{sv}` the request carries after the two strings: each key with its
		// value's signature, the values of the kinds the request writes.
		def options(reader DBusReader) map<string, string> {
			let out = map<string, string>{}
			let end = reader.beginArray("\{sv\}")
			for reader.pos < end && !reader.failed {
				reader.align(8)
				let key = reader.readString()
				let signature = reader.readVariant()
				match signature {
					case "s":
						out[key] = reader.readString()
					case "b":
						out[key] = reader.readBool() ?? ("true", "false")
					case "ay":
						let stop = reader.beginArray("y")
						let text = ""
						for reader.pos < stop {
							let b = reader.readByte()
							text += "<nul>" when b == 0
							text += string(char(b)) when b != 0
						}
						out[key] = text
					case "a(sa(us))":
						let stop = reader.beginArray("(sa(us))")
						let text = ""
						for reader.pos < stop && !reader.failed {
							reader.align(8)
							text += reader.readString() + ":"
							let inner = reader.beginArray("(us)")
							for reader.pos < inner && !reader.failed {
								reader.align(8)
								text += "{reader.readUint32()}={reader.readString()} "
							}
						}
						out[key] = text.trim()
					default:
						reader.skip(signature)
						out[key] = "?" + signature
				}
			}
			return out
		}

		@test()
		def TestOpenFileRequestCarriesTheOptions() {
			let parent = r.NativeWindow{system: "x11", handle: 0x3a00007}
			let filters = [FileFilter{name: "Images", patterns: ["*.png", "*.jpg"]}, FileFilter{name: "Text", patterns: ["*.txt"]}]
			let body = fileChooserBody(parent, DialogKind.Open, "Pick", "/home/sy/Pictures", "", filters, true, "adm1")
			let reader = new DBusReader(body)
			assert reader.readString() == "x11:3a00007"
			assert reader.readString() == "Pick"
			let seen = options(reader)
			assert !reader.failed
			assert seen["handle_token"] == "adm1"
			assert seen["modal"] == "true"
			assert seen["multiple"] == "true"
			assert !seen.hasKey("directory")
			assert seen["current_folder"] == "/home/sy/Pictures<nul>"
			assert seen["filters"] == "Images:0=*.png 0=*.jpg Text:0=*.txt"
		}

		@test()
		def TestFolderAndSaveRequests() {
			let noParent = r.NativeWindow{system: "wayland", handle: 12}
			let folder = new DBusReader(fileChooserBody(noParent, DialogKind.Folder, "", "", "", [], true, "adm1"))
			assert folder.readString() == ""
			assert folder.readString() == "Choose a folder"
			let seen = options(folder)
			assert seen["directory"] == "true"
			assert !seen.hasKey("multiple")
			assert !seen.hasKey("filters")
			let save = new DBusReader(fileChooserBody(r.NativeWindow{}, DialogKind.Save, "", "", "notes.txt", [], false, "adm1"))
			assert save.readString() == ""
			assert save.readString() == "Save"
			let saving = options(save)
			assert saving["current_name"] == "notes.txt"
			assert !saving.hasKey("directory")
		}

		@test()
		def TestResponsePathsDecodeTheChosenURIs() {
			let w = new DBusWriter()
			w.putUint32(0)
			w.beginDict()
			w.dictStringArray("uris", ["file:///home/sy/a%20b.txt", "file://localhost/tmp/c.png", "http://example.com/x"])
			w.dictString("current_filter", "Images")
			w.endDict()
			let paths = responsePaths(w.bytes())
			assert paths.len() == 2
			assert paths[0] == "/home/sy/a b.txt"
			assert paths[1] == "/tmp/c.png"

			let cancelled = new DBusWriter()
			cancelled.putUint32(1)
			cancelled.beginDict()
			cancelled.endDict()
			assert responsePaths(cancelled.bytes()).len() == 0
		}
	}
}
