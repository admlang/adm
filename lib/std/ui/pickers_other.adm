@os("darwin", "android", "ios", "wasm")
partial module std.ui {
	use std.ui.renderer as r

	// The system's file dialog is not reached on this platform yet: macOS (NSOpenPanel,
	// NSSavePanel) waits for the UI to run there at all, the web for a file input of
	// the browser's; a call fails saying so.
	internal async def pickPaths(parent r.NativeWindow, kind DialogKind, title string, start string, name string, filters FileFilter[], multiple bool) !string[] {
		fail "file dialogs are not available on this platform yet"
	}
}
