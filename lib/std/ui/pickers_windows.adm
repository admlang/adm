@os("windows")
partial module std.ui {
	use std.ui.renderer as r

	// Shows the common item dialog (pickers_win32.h): kind 0 a folder, 1 files, 2 a save;
	// the filters as "Name|*.a;*.b" lines. The paths chosen, joined by newlines; "" when
	// cancelled or failed, which `winPickStatus` tells apart.
	@c("pickers_win32.h", symbol = "adm_pick_paths", ret = "const char*", params = ["uint64_t", "int", "const char*", "const char*", "const char*", "const char*", "int"])
	internal def winPickPaths(parent uint, kind int, title string, start string, name string, filters string, multiple int) string;

	// The last dialog's outcome: 0 chosen, 1 cancelled, 2 failed.
	@c("pickers_win32.h", symbol = "adm_pick_status", ret = "int")
	internal def winPickStatus() int;

	// Why the last dialog failed.
	@c("pickers_win32.h", symbol = "adm_pick_error", ret = "const char*")
	internal def winPickError() string;

	// Shows the common item dialog over the parent window (its HWND, when the host knows it)
	// and returns the paths chosen, empty when the user cancelled.
	//
	// Fails when COM cannot make the dialog or the dialog fails.
	internal async def pickPaths(parent r.NativeWindow, kind DialogKind, title string, start string, name string, filters FileFilter[], multiple bool) !string[] {
		let code = 1
		code = 0 when kind == DialogKind.Folder
		code = 2 when kind == DialogKind.Save
		let lines string[]
		for let filter in filters {
			lines.push("{filter.name}|{filter.patterns.join(";")}")
		}
		let hwnd = parent.system == "windows" ?? (parent.handle, uint(0))
		let joined = winPickPaths(hwnd, code, dialogTitle(kind, title), start, name, lines.join("\n"), multiple ?? (1, 0))
		let status = winPickStatus()
		fail "file dialog: {winPickError()}" when status == 2
		return [] when status == 1 || joined == ""
		return joined.split("\n")
	}
}
