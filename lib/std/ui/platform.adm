internal partial module std.ui.platform {
	use std.ui::*

	// The appearance last read and the watch that keeps it current. Shared by
	// the UI service and its watcher task, guarded by its own lock.
	type AppearanceState {
		current ?Appearance    = none
		watch   ?SettingsWatch = none
		// The theme made from `current`, once something asked for it.
		theme   ?Theme         = none
		// Set by the watcher when the look changed; the windows' loop clears it.
		changed bool
	}

	// How many reload objects a hot build (`adm run --hot`) has loaded; 0 in any other
	// program.
	@c("", symbol = "adm_hot_generation", ret = "int64_t")
	def hotGeneration() int64;
}
