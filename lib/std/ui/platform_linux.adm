@os("linux")
internal partial module std.ui.platform {
	use (
		std.ui::*
		std.ui.styles::Font
		std.units::Pixels
		std.gfx.color::(Color, RGBA)
		std.proto::(DBusConnection, DBusMessage, DBusReader, DBusWriter, DBUS_ERROR, DBUS_REPLY, DBUS_SIGNAL, dbusConnect, dbusErrorMessage, dbusReadFailure, dbusSessionBusAddress)
	)

	const portalName = "org.freedesktop.portal.Desktop"
	const portalPath = "/org/freedesktop/portal/desktop"
	const portalSettings = "org.freedesktop.portal.Settings"

	// The portal namespaces the look settings come from. GNOME's keys are served
	// by the GNOME and KDE portals alike.
	const freedesktopAppearance = "org.freedesktop.appearance"
	const gnomeInterface = "org.gnome.desktop.interface"
	const gnomeMouse = "org.gnome.desktop.peripherals.mouse"
	const gnomeAccessibility = "org.gnome.desktop.a11y.interface"

	def settingsNamespaces() string[] {
		return [freedesktopAppearance, gnomeInterface, gnomeMouse, gnomeAccessibility]
	}

	// A desktop setting's value: `b`, `u`/`i`, `d`, `s` or a `(ddd)` colour.
	type Setting = bool | int | float | string | float[]

	// The desktop's look settings: the portal's, else GTK's settings.ini, else
	// the fallbacks `Appearance` declares.
	def readAppearance() Appearance {
		let settings = readPortalSettings() onerror recover readGtkSettings()
		return appearanceFrom(settings)
	}

	// Every setting in the look namespaces, keyed `namespace.key`.
	//
	// Fails when there is no session bus or no portal answers on it.
	def readPortalSettings() !map<string, Setting> {
		let address = try dbusSessionBusAddress()
		let bus = try dbusConnect(address)
		let w = new DBusWriter()
		w.putStringArray(settingsNamespaces())
		let reply = bus.callSync(portalName, portalPath, portalSettings, "ReadAll", "as", w.bytes()) onerror (err error) {
			bus.close()
			fail err
		}
		bus.close()
		fail "portal settings: {dbusErrorMessage(reply)}" when reply.kind == DBUS_ERROR
		return decodeReadAll(reply.body)
	}

	// The `a{sa{sv}}` body of `Settings.ReadAll`, flattened to `namespace.key`.
	def decodeReadAll(body byte[]) map<string, Setting> {
		let out = map<string, Setting>{}
		let r = new DBusReader(body)
		let end = r.beginArray("\{sa\{sv}}")
		for r.pos < end && !r.failed {
			r.align(8)
			let namespace = r.readString()
			let inner = r.beginArray("\{sv}")
			for r.pos < inner && !r.failed {
				r.align(8)
				let key = r.readString()
				let value = readSetting(r, r.readVariant())
				out = out.set("{namespace}.{key}", value) unless value is none
			}
		}
		return out
	}

	// One variant's value, or none for a type the look settings never use.
	def readSetting(r DBusReader, signature string) ?Setting {
		match signature {
			case "b":
				return r.readBool()
			case "u":
				return int(r.readUint32())
			case "i":
				return int(r.readInt32())
			case "d":
				return r.readDouble()
			case "s":
				return r.readString()
			case "(ddd)":
				r.align(8)
				return [r.readDouble(), r.readDouble(), r.readDouble()]
			case "v":
				return readSetting(r, r.readVariant())
			default:
				r.skip(signature)
				return none
		}
	}

	// GTK's own settings file, under the keys the portal would use.
	def readGtkSettings() map<string, Setting> {
		let out = map<string, Setting>{}
		let config = ""
		let xdg = __env_get("XDG_CONFIG_HOME")
		let home = __env_get("HOME")
		if !(xdg is none) {
			config = xdg
		} else if !(home is none) {
			let dir string = home
			config = "{dir}/.config"
		}
		return out when config == ""
		let raw = __fs_read_all("{config}/gtk-3.0/settings.ini") onerror recover []
		return out when raw.len() == 0
		return gtkSettingsFrom(string(raw))
	}

	// The `[Settings]` lines of a GTK settings.ini, under the portal's keys.
	def gtkSettingsFrom(text string) map<string, Setting> {
		let out = map<string, Setting>{}
		for let line in text.split("\n") {
			let eq = line.indexOf("=")
			continue when eq < 0
			let key = line[:eq].trim()
			let value = line[eq + 1:].trim()
			let on = value == "true" || value == "1"
			let number = parseInt<int>(value)
			match key {
				case "gtk-application-prefer-dark-theme":
					out = out.set("{gnomeInterface}.color-scheme", on ?? ("prefer-dark", "default"))
				case "gtk-font-name":
					out = out.set("{gnomeInterface}.font-name", value)
				case "gtk-enable-animations":
					out = out.set("{gnomeInterface}.enable-animations", on)
				case "gtk-cursor-blink":
					out = out.set("{gnomeInterface}.cursor-blink", on)
				case "gtk-cursor-blink-time":
					out = out.set("{gnomeInterface}.cursor-blink-time", number) when number > 0
				case "gtk-double-click-time":
					out = out.set("{gnomeMouse}.double-click", number) when number > 0
				default:
			}
		}
		return out
	}

	// The appearance the settings describe; a missing setting keeps its fallback.
	def appearanceFrom(settings map<string, Setting>) Appearance {
		let look = Appearance{}

		let scheme = intSetting(settings, "{freedesktopAppearance}.color-scheme", 0)
		if scheme == 1 {
			look.scheme = ColorScheme.Dark
		} else if scheme == 0 && textSetting(settings, "{gnomeInterface}.color-scheme", "") == "prefer-dark" {
			look.scheme = ColorScheme.Dark
		}

		let accent = colorSetting(settings, "{freedesktopAppearance}.accent-color")
		if !(accent is none) {
			look.accent = accent
		} else {
			let named = namedAccent(textSetting(settings, "{gnomeInterface}.accent-color", ""))
			look.accent = named unless named is none
		}

		if intSetting(settings, "{freedesktopAppearance}.contrast", 0) == 1 || boolSetting(settings, "{gnomeAccessibility}.high-contrast", false) {
			look.contrast = Contrast.High
		}
		look.reduceMotion = intSetting(settings, "{freedesktopAppearance}.reduced-motion", 0) == 1 || !boolSetting(settings, "{gnomeInterface}.enable-animations", true)

		let scale = floatSetting(settings, "{gnomeInterface}.text-scaling-factor", 1.0)
		look.textScale = scale when scale > 0.0
		look.font = pangoFont(textSetting(settings, "{gnomeInterface}.font-name", ""), look.font, look.textScale)
		look.monospaceFont = pangoFont(textSetting(settings, "{gnomeInterface}.monospace-font-name", ""), look.monospaceFont, look.textScale)

		let doubleClick = intSetting(settings, "{gnomeMouse}.double-click", 0)
		look.doubleClickTime = duration(int64(doubleClick) * 1000000) when doubleClick > 0
		// GTK's blink time is a whole on-and-off cycle.
		let cycle = intSetting(settings, "{gnomeInterface}.cursor-blink-time", 0)
		look.caretBlink = duration(int64(cycle / 2) * 1000000) when cycle > 0
		look.caretBlink = 0s unless boolSetting(settings, "{gnomeInterface}.cursor-blink", true)
		return look
	}

	// A Pango font description ("Cantarell Bold Italic 11", "Noto Sans,  10"):
	// family, style words, then the size in points. An empty description keeps
	// the fallback's family and size, scaled.
	def pangoFont(description string, fallback Font, textScale float) Font {
		let words string[] = []
		for let word in description.replace(",", " ").split(" ") {
			words.push(word) when word.len() > 0
		}
		let font = Font{family: fallback.family, size: fallback.size, weight: fallback.weight, italic: fallback.italic}
		let points = 12.0
		if words.len() > 0 {
			let last = words[words.len() - 1]
			let size = parseFloat<float>(last)
			if size > 0.0 {
				points = size
				words = words[:words.len() - 1]
			}
		}
		for words.len() > 1 {
			let word = words[words.len() - 1].lower()
			let weight = pangoWeight(word)
			if weight > 0 {
				font.weight = weight
			} else if word == "italic" || word == "oblique" {
				font.italic = true
			} else if word != "regular" && word != "normal" && word != "book" {
				break
			}
			words = words[:words.len() - 1]
		}
		font.family = words.join(" ") when words.len() > 0
		// A point is 4/3 of a logical pixel: 96 pixels to 72 points.
		font.size = points * 4.0 / 3.0 * textScale * 1(px)
		return font
	}

	// The weight a Pango style word names, 0 when it names none.
	def pangoWeight(word string) int {
		match word {
			case "thin", "hairline":
				return 100
			case "ultra-light", "ultralight", "extra-light", "extralight":
				return 200
			case "light":
				return 300
			case "medium":
				return 500
			case "semi-bold", "semibold", "demi-bold", "demibold":
				return 600
			case "bold":
				return 700
			case "ultra-bold", "ultrabold", "extra-bold", "extrabold":
				return 800
			case "heavy", "black", "ultra-heavy":
				return 900
			default:
				return 0
		}
	}

	// GNOME's named accent colours (GNOME 47).
	def namedAccent(name string) ?Color {
		match name {
			case "blue":
				return rgb(0x35, 0x84, 0xe4)
			case "teal":
				return rgb(0x21, 0x90, 0xa4)
			case "green":
				return rgb(0x3a, 0x94, 0x4a)
			case "yellow":
				return rgb(0xc8, 0x88, 0x00)
			case "orange":
				return rgb(0xed, 0x5b, 0x00)
			case "red":
				return rgb(0xe6, 0x2d, 0x42)
			case "pink":
				return rgb(0xd5, 0x61, 0x99)
			case "purple":
				return rgb(0x91, 0x41, 0xac)
			case "slate":
				return rgb(0x6f, 0x83, 0x96)
			default:
				return none
		}
	}

	def rgb(r int, g int, b int) Color {
		return new Color(RGBA{r: byte(r), g: byte(g), b: byte(b), a: 255})
	}

	def intSetting(settings map<string, Setting>, key string, fallback int) int {
		let value = settings.get(key)
		return value when value is int
		return fallback
	}

	def boolSetting(settings map<string, Setting>, key string, fallback bool) bool {
		let value = settings.get(key)
		return value when value is bool
		return fallback
	}

	def floatSetting(settings map<string, Setting>, key string, fallback float) float {
		let value = settings.get(key)
		return value when value is float
		return fallback
	}

	def textSetting(settings map<string, Setting>, key string, fallback string) string {
		let value = settings.get(key)
		return value when value is string
		return fallback
	}

	// A portal `(ddd)` colour; none when unset (any channel outside 0…1).
	def colorSetting(settings map<string, Setting>, key string) ?Color {
		let value = settings.get(key)
		let channels float[] = []
		match value {
			case float[]:
				channels = value
			default:
				return none
		}
		return none unless channels.len() == 3
		for let channel in channels {
			return none when channel < 0.0 || channel > 1.0
		}
		return rgb(int(channels[0] * 255.0 + 0.5), int(channels[1] * 255.0 + 0.5), int(channels[2] * 255.0 + 0.5))
	}

	// A session bus connection that reports when a look setting changes.
	type SettingsWatch {
		bus DBusConnection

		def new(bus DBusConnection) {
			self.bus = bus
		}

		// Blocks until a look setting changes. Returns false once the watch is
		// closed or the bus connection drops.
		def wait() bool {
			for {
				let message = bus.readMessage(30s) onerror (err error) {
					recover dbusReadFailure(err.code)
				}
				if message.kind == 0 {
					continue when message.errorName == "ETIMEDOUT" && !bus.stopping
					return false
				}
				continue unless message.kind == DBUS_SIGNAL && message.member == "SettingChanged"
				let namespace = new DBusReader(message.body).readString()
				return true when settingsNamespaces().indexOf(namespace) >= 0
			}
		}

		// Stops the watch; a waiting `wait` returns false.
		def close() {
			bus.close()
		}
	}

	// Subscribes to the portal's SettingChanged signal; none without a session bus.
	def watchSettings() ?SettingsWatch {
		let address = dbusSessionBusAddress() onerror recover ""
		return none when address == ""
		let connected = true
		let bus = dbusConnect(address) onerror (err error) {
			connected = false
			recover new DBusConnection(-1)
		}
		return none unless connected
		let subscribed = true
		bus.subscribe(portalSettings, "SettingChanged") onerror (err error) {
			subscribed = false
			recover none
		}
		if !subscribed {
			bus.close()
			return none
		}
		return new SettingsWatch(bus)
	}
}
