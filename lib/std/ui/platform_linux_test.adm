@os("linux")
internal partial module std.ui.platform {
	use (
		std.testing
		std.ui::*
		std.ui.styles::Font
		std.units::(Extent, Pixels)
	)

	check "Linux appearance" {
		def pixels(size Extent) float {
			match size {
				case Pixels:
					return float(size)
				default:
					return -1.0
			}
		}

		// The portal's own keys win over GNOME's; the rest keep their fallbacks.
		@test()
		def TestPortalSettingsMapToAppearance() {
			let settings = map<string, Setting>{}
			settings = settings.set("org.freedesktop.appearance.color-scheme", 1)
			settings = settings.set("org.freedesktop.appearance.accent-color", [0.0, 0.5, 1.0])
			settings = settings.set("org.freedesktop.appearance.contrast", 1)
			settings = settings.set("org.gnome.desktop.interface.text-scaling-factor", 1.25)
			settings = settings.set("org.gnome.desktop.interface.font-name", "Noto Sans Bold Italic 12")
			settings = settings.set("org.gnome.desktop.interface.monospace-font-name", "Noto Sans Mono  10")
			settings = settings.set("org.gnome.desktop.interface.enable-animations", false)
			settings = settings.set("org.gnome.desktop.interface.cursor-blink-time", 1000)
			settings = settings.set("org.gnome.desktop.peripherals.mouse.double-click", 400)

			let look = appearanceFrom(settings)
			assert look.scheme == ColorScheme.Dark
			assert look.contrast == Contrast.High
			assert look.reduceMotion
			assert !look.reduceTransparency
			assert look.textScale == 1.25
			let accent = look.accent.rgba
			assert accent.r == byte(0) && accent.g == byte(128) && accent.b == byte(255)
			assert look.font.family == "Noto Sans"
			assert look.font.weight == 700
			assert look.font.italic
			assert pixels(look.font.size) == 20.0
			assert look.monospaceFont.family == "Noto Sans Mono"
			assert look.monospaceFont.weight == 400
			assert look.doubleClickTime == 400ms
			assert look.caretBlink == 500ms
		}

		// Nothing set: every fallback.
		@test()
		def TestNoSettingsKeepFallbacks() {
			let look = appearanceFrom(map<string, Setting>{})
			assert look.scheme == ColorScheme.Light
			assert look.contrast == Contrast.Normal
			assert !look.reduceMotion
			assert look.textScale == 1.0
			assert look.font.family == "system-ui"
			assert look.doubleClickTime == 500ms
			assert look.caretBlink == 530ms
		}

		// GNOME's own scheme and named accent stand in when the portal's are unset.
		@test()
		def TestGnomeKeysFillIn() {
			let settings = map<string, Setting>{}
			settings = settings.set("org.gnome.desktop.interface.color-scheme", "prefer-dark")
			settings = settings.set("org.gnome.desktop.interface.accent-color", "green")
			settings = settings.set("org.gnome.desktop.interface.cursor-blink", false)
			let look = appearanceFrom(settings)
			assert look.scheme == ColorScheme.Dark
			let accent = look.accent.rgba
			assert accent.r == byte(0x3a) && accent.g == byte(0x94) && accent.b == byte(0x4a)
			assert look.caretBlink == 0s
		}

		// GTK's settings.ini under the portal's keys.
		@test()
		def TestGtkSettingsIni() {
			let text = "[Settings]\ngtk-application-prefer-dark-theme=true\ngtk-font-name=Cantarell,  11\ngtk-enable-animations=0\ngtk-double-click-time=300\n"
			let look = appearanceFrom(gtkSettingsFrom(text))
			assert look.scheme == ColorScheme.Dark
			assert look.font.family == "Cantarell"
			assert look.reduceMotion
			assert look.doubleClickTime == 300ms
		}

		// Pango descriptions: style words come off the end, the size is in points.
		@test()
		def TestPangoFont() {
			let base = Font{family: "system-ui"}
			let light = pangoFont("Source Sans 3 Light 9", base, 1.0)
			assert light.family == "Source Sans 3"
			assert light.weight == 300
			assert pixels(light.size) == 12.0
			let blank = pangoFont("", base, 2.0)
			assert blank.family == "system-ui"
			assert pixels(blank.size) == 32.0
		}

		// The portal's ReadAll reply as the desktop sends it; the live one when a
		// portal answers on this machine.
		@test()
		def TestReadAllFromThisDesktop() {
			let settings = readPortalSettings() onerror recover map<string, Setting>{}
			return when settings.len() == 0
			let look = appearanceFrom(settings)
			assert look.textScale > 0.0
			assert look.font.family.len() > 0
		}
	}
}
