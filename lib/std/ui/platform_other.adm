@os("darwin")
@os("windows")
internal partial module std.ui.platform {
	use std.ui::*

	// The fallbacks `Appearance` declares, until this platform's settings are read.
	def readAppearance() Appearance {
		return Appearance{}
	}

	// Nothing reports setting changes on this platform yet.
	type SettingsWatch {
		def wait() bool {
			return false
		}

		def close() {}
	}

	// None: this platform has no settings watch yet.
	def watchSettings() ?SettingsWatch {
		return none
	}
}
