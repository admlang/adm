@os("wasm")
internal partial module std.ui.platform {
	use (
		std.ui::*
		std.gfx.color::(Color, RGBA)
		std.units::Pixels
	)

	// The look the browser reports: its media queries for the colour scheme,
	// contrast, motion and transparency, the CSS `AccentColor`, and the page's
	// root font size against the browser's 16px default as the text scale.
	def readAppearance() Appearance {
		let look = Appearance{}
		look.scheme = ColorScheme.Dark when __webMedia("(prefers-color-scheme: dark)") != 0
		look.contrast = Contrast.High when __webMedia("(prefers-contrast: more)") != 0
		look.reduceMotion = __webMedia("(prefers-reduced-motion: reduce)") != 0
		look.reduceTransparency = __webMedia("(prefers-reduced-transparency: reduce)") != 0
		let accent = __webAccentColor()
		if accent != 0 {
			look.accent = new Color(RGBA{r: byte(accent >> 24), g: byte(accent >> 16), b: byte(accent >> 8), a: byte(accent)})
		}
		let px = __webRootFontPx()
		if px > 0 {
			look.textScale = float(px) / 16.0
			look.font.size = float(px) * 1(px)
			look.monospaceFont.size = float(px) * 1(px)
		}
		return look
	}

	// The browser's change events for the media queries `readAppearance` reads.
	type SettingsWatch {
		// Blocks until a look setting changes. Returns false once the watch is
		// closed.
		def wait() bool {
			return __webSettingsWait() != 0
		}

		// Stops the watch; a waiting `wait` returns false.
		def close() {
			__webSettingsClose()
		}
	}

	// The browser always reports changes to the look.
	def watchSettings() ?SettingsWatch {
		return new SettingsWatch()
	}

	@c("adm_web.h", symbol = "adm_web_media", ret = "int32_t", params = ["const char*"])
	def __webMedia(query string) int32;

	@c("adm_web.h", symbol = "adm_web_accent_color", ret = "uint32_t", params = [])
	def __webAccentColor() uint32;

	@c("adm_web.h", symbol = "adm_web_root_font_px", ret = "int32_t", params = [])
	def __webRootFontPx() int32;

	@c("adm_web.h", symbol = "adm_web_settings_wait", ret = "int32_t", params = [])
	def __webSettingsWait() int32;

	@c("adm_web.h", symbol = "adm_web_settings_close", ret = "void", params = [])
	def __webSettingsClose();
}
