partial module std.ui {
	use (
		std.math.geom::Point
		std.units::Pixels
	)

	// What moves a pointer.
	enum PointerDevice {
		Mouse,
		Touch,
		Pen,
	}

	// What a pointer event reports.
	enum PointerPhase {
		// The pointer came over the component.
		Enter,
		Move,
		Down,
		Up,
		// The pointer left the component.
		Leave,
		// The gesture was taken away: the window lost the pointer, the component was
		// unmounted.
		Cancel,
		// Wheel or trackpad scroll; `scroll` holds the distance.
		Scroll,
	}

	// The modifier keys held during an event.
	struct Modifiers {
		// `command` is the Command key on macOS, the Windows or Super key elsewhere.
		shift, control, alt, command bool
		// Control on Linux and Windows, Command on macOS: what "Mod+S" means.
		mod                          bool
	}

	// One thing a mouse, a finger or a pen did, as a component's `pointer` receives it.
	type PointerEvent {
		phase          PointerPhase
		device         PointerDevice = PointerDevice.Mouse
		// Tells fingers apart in a multi-touch gesture.
		pointer        int
		// Where it happened, in the receiving component's coordinates and in the window's.
		position       Point<Pixels>
		windowPosition Point<Pixels>
		// The button that went down or up.
		button         MouseButton   = MouseButton.Left
		// 1 single, 2 double, 3 triple.
		clicks         int           = 1
		// For Scroll: how far.
		scroll         Point<Pixels>
		modifiers      Modifiers     = Modifiers{}
		// The component the pointer is over.
		target         component
		internal held  bool

		def new(phase PointerPhase, target component, windowPosition Point<Pixels>) {
			self.phase = phase
			self.target = target
			self.windowPosition = windowPosition
			position = windowPosition
			scroll = new Point<Pixels>(0(px), 0(px))
		}

		// Keeps delivering this pointer to the component receiving the event until Up or
		// Cancel, wherever it moves: a drag that leaves the component.
		def capture() {
			held = true
		}

		// Whether a receiver asked to capture the pointer.
		captured bool {
			def get() bool {
				return held
			}
		}
	}
}
