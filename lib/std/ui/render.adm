partial module std.ui {
	use (
		std.gfx.canvas::DrawContext
		std.math.geom::Rect
		std.ui.styles::Direction
		std.units::Pixels
	)

	// What draws the std passes of one component for a `RenderContext`.
	interface RenderPasses {
		def outerShadows()
		def background()
		def borders()
		def childNodes()
		def innerShadows()
	}

	// What a component's `render` draws with: the canvas, the component's resolved style and
	// place, and the std passes, so a custom `render` draws only its extras.
	type RenderContext {
		// The canvas, in the component's own coordinates: (0, 0) is the top-left of its
		// border box.
		draw      DrawContext
		// The component's resolved style, after the cascade, inheritance and states.
		style     style
		// Where layout put the component.
		geometry  Geometry
		// The part that needs drawing, in the same coordinates. Drawing outside it is wasted,
		// not wrong.
		damage    Rect<Pixels>
		// Device pixels per logical pixel.
		scale     float         = 1.0
		// The reading direction the component was laid out in.
		direction Direction     = Direction.LeftToRight
		// Draws the passes; none outside a frame, where they do nothing.
		passes    ?RenderPasses = none

		def new(draw DrawContext) {
			self.draw = draw
		}

		// Draws the shadows that fall outside the component. Each pass does nothing when the
		// component's style lacks that capability.
		def outerShadows() {
			let target = passes
			target.outerShadows() unless target is none
		}

		// Draws the background.
		def background() {
			let target = passes
			target.background() unless target is none
		}

		// Draws the borders.
		def borders() {
			let target = passes
			target.borders() unless target is none
		}

		// Draws the nodes mounted under the component, in order.
		def childNodes() {
			let target = passes
			target.childNodes() unless target is none
		}

		// Draws the shadows that fall inside the component, over its child nodes, so what is
		// inside looks sunk.
		def innerShadows() {
			let target = passes
			target.innerShadows() unless target is none
		}
	}
}
