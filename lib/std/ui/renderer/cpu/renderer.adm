partial module std.ui.renderer.cpu {
	use (
		std.gfx.canvas
		std.math.geom
		std.ui.renderer as r
	)

	// The CPU renderer: every frame is rasterised by the canvas and handed to
	// the host as pixels (`PixelSurface`), with no GPU in the loop: the
	// desktop host shows them through the window's own surface, the browser
	// host through a 2D canvas, so a program draws where OpenGL and Vulkan are
	// not to be had.
	@r.UIRenderer(name = "cpu")
	type CPURenderer {
		internal host     ?r.PixelSurface          = none
		// The canvas each window's frames are rasterised into, and its size.
		internal canvases map<uint, canvas.Canvas>
		internal sizes    map<uint, geom.Size>
		// The windows whose last committed frame the canvas still holds whole.
		internal held     map<uint, bool>

		def new() {
			canvases = map<uint, canvas.Canvas>{}
			sizes = map<uint, geom.Size>{}
			held = map<uint, bool>{}
		}

		// Takes the host whose windows it draws in: makes it open them for pixels.
		//
		// Fails when the host's windows do not take pixels, or one is open for
		// another API already.
		def attach(host r.Host) !none {
			fail "the CPU renderer needs a host whose windows take pixels" unless host is r.PixelSurface
			let pixels r.PixelSurface = host
			try pixels.pixelWindows()
			self.host = pixels
			return none
		}

		internal def surfaceSize(id uint) (int, int, geom.Size) {
			let h = host
			return (0, 0, new geom.Size(0.0, 0.0)) when h is none
			let size = h.surfaceSize(id)
			return (int(size.width), int(size.height), size)
		}

		// Starts a frame: a draw surface the size of the window's surface.
		//
		// Fails when no host is attached.
		def nextFrame(win r.Window) !r.Frame {
			fail "the CPU renderer has no host" when host is none
			let id = win.id()
			let (w, h, size) = surfaceSize(id)
			sizes = sizes.set(id, size)
			let cv = canvases.get(id)
			if cv is none || cv.width != w || cv.height != h {
				canvases = canvases.set(id, new canvas.Canvas(w, h))
				held = held.delete(id)
			}
			let ctx = new canvas.DrawContext(new geom.Size(float(w), float(h)))
			return r.Frame{ctx: ctx, kept: held.hasKey(id)}
		}

		// Rasterises the frame into the window's canvas and shows the canvas.
		//
		// Fails when the window has no frame started or the host cannot show it.
		def commit(win r.Window, frame r.Frame) !none {
			let id = win.id()
			let cv = canvases.get(id)
			fail "unknown window" when cv is none
			let h = host
			fail "the CPU renderer has no host" when h is none
			cv.apply(frame.ctx)
			let kept = held.hasKey(id)
			held = held.set(id, true)
			// A part drawn over the picture before: a host that takes damage gets its box.
			let damage = frame.damage
			if h is r.DamageSurface && kept && frame.over && !(damage is none) {
				let damaged r.DamageSurface = h
				return try damaged.presentDamage(id, cv.width, cv.height, cv.pixels, damage)
			}
			return try h.presentPixels(id, cv.width, cv.height, cv.pixels)
		}

		// The pixels of the window's last committed frame in a box of it.
		//
		// Fails when no frame is held for the window or the box is not inside it.
		def read(win r.Window, left int, top int, width int, height int) !byte[] {
			let id = win.id()
			let cv = canvases.get(id)
			fail "no frame is held for the window" when cv is none || !held.hasKey(id)
			let (wide, high) = (cv.width, cv.height)
			fail "the box is not inside the frame" when left < 0 || top < 0 || width <= 0 || height <= 0 || left + width > wide || top + height > high
			let from = cv.pixels
			return from.clone() when width == wide && height == high
			let out byte[]
			for let row = 0; row < height; row++ {
				let start = ((top + row) * wide + left) * 4
				out.push(...from[start:start + width * 4])
			}
			return out
		}

		// Frees the canvas held for the window. Does not fail.
		def release(win r.Window) !none {
			let id = win.id()
			canvases = canvases.delete(id) when canvases.hasKey(id)
			sizes = sizes.delete(id) when sizes.hasKey(id)
			held = held.delete(id)
			return none
		}
	}
}
