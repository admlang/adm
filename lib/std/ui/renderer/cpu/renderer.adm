partial module std.ui.renderer.cpu {
	use (
		std.ui.renderer as r
		std.ui.renderer.opengl as glr
	)

	// CPURenderer records draw commands and rasterizes into a CPU canvas before presentation.
	// Presentation currently goes through the OpenGL renderer.
	@r.UIRenderer(name = "cpu")
	type CPURenderer {
		internal initMagic uint32
		internal inner     ?glr.OpenGLRenderer = none

		def new() {
			initMagic = 0x5A454E31
			inner = new glr.OpenGLRenderer(true)
		}

		internal def resetInner() glr.OpenGLRenderer {
			inner = new glr.OpenGLRenderer(true)
			let rend = inner
			return new glr.OpenGLRenderer(true) when rend is none
			return rend
		}

		internal def ensureInner() glr.OpenGLRenderer {
			if initMagic != 0x5A454E31 {
				initMagic = 0x5A454E31
				return resetInner()
			}
			let rend = inner
			return resetInner() when rend is none
			return rend
		}

		// Takes the host whose windows it draws in.
		//
		// Forwards to the OpenGL renderer it wraps and fails when it does.
		def attach(host r.Host) !none {
			let rend = ensureInner()
			return rend.attach(host)
		}

		// Starts a frame: a draw surface the size of the window's framebuffer.
		//
		// Forwards to the OpenGL renderer it wraps and fails when it does.
		def nextFrame(win r.Window) !r.Frame {
			let rend = ensureInner()
			return rend.nextFrame(win)
		}

		// Rasterises the frame and presents it.
		//
		// Forwards to the OpenGL renderer it wraps and fails when it does.
		def commit(win r.Window, frame r.Frame) !none {
			let rend = ensureInner()
			return rend.commit(win, frame)
		}

		// Frees what the renderer holds for the window.
		//
		// Forwards to the OpenGL renderer it wraps and fails when it does.
		def release(win r.Window) !none {
			let rend = ensureInner()
			return rend.release(win)
		}

		// The pixels of the window's last committed frame in a box of it.
		//
		// Forwards to the OpenGL renderer it wraps and fails when it does.
		def read(win r.Window, left int, top int, width int, height int) !byte[] {
			let rend = ensureInner()
			return rend.read(win, left, top, width, height)
		}
	}
}
