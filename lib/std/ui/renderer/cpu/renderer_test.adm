partial module std.ui.renderer.cpu {
	use (
		std.testing
		std.formats.image
		std.gfx.canvas::(Canvas, DrawContext)
		std.gfx.color::(Color, RGBA)
		std.math.geom::(Point, Rect, Size)
		std.time
		std.ui
		std.ui.renderer as r
		std.ui.styles::Cursor
		std.units::Pixels
	)

	// A host of one 64 x 48 window that keeps the pixels it is shown.
	internal type PixelHost {
		opened  int
		shown   byte[]
		shownW  int
		shownH  int
		refused bool

		def pixelWindows() !none {
			fail "a window is open" when refused
			opened++
			return none
		}

		def presentPixels(window uint, width int, height int, pixels byte[]) !none {
			shown = pixels.clone()
			shownW = width
			shownH = height
			return none
		}

		def surfaceSize(window uint) Size {
			return new Size(64.0, 48.0)
		}

		def openWindow(cfg r.WindowConfig) !r.Window {
			return new r.Window(7)
		}

		def closeWindow(win r.Window) !none {
			return none
		}

		def setWindowTitle(win r.Window, title string) !none {
			return none
		}

		def setWindowIcon(win r.Window, icon image.Image) !none {
			return none
		}

		def setWindowVisible(win r.Window, visible bool) !none {
			return none
		}

		def setWindowState(win r.Window, state ui.WindowState) !none {
			return none
		}

		def setCursor(win r.Window, cursor Cursor) !none {
			return none
		}

		def windowBounds(win r.Window) !Rect<Pixels> {
			return Rect<Pixels>{}
		}

		def setWindowBounds(win r.Window, bounds Rect<Pixels>) !none {
			return none
		}

		def raiseWindow(win r.Window) !none {
			return none
		}

		def poll() !r.PlatformEvent[] {
			return r.PlatformEvent[]
		}

		def wait(limit duration) !none {
			return none
		}

		def wake() {}

		def displays() !ui.Display[] {
			return ui.Display[]
		}

		def clipboardText() !string {
			return ""
		}

		def setClipboardText(text string) !none {
			return none
		}

		def startTextInput(win r.Window, kind ui.TextKind) !none {
			return none
		}

		def stopTextInput(win r.Window) !none {
			return none
		}

		def setTextInputCaret(win r.Window, caret Rect<Pixels>) !none {
			return none
		}

		def setWindowDragTest(win r.Window, test ?(def(Point<Pixels>) bool)) !none {
			return none
		}

		def setWindowShape(win r.Window, width int, height int, pixels byte[]) !none {
			return none
		}

		def showTray(icon image.Image, tooltip string, menu ui.MenuEntry[]) !none {
			return none
		}

		def hideTray() !none {
			return none
		}
	}

	check "CPU renderer" {
		def rgba(r int, g int, b int, a int = 255) Color {
			return new Color(RGBA{r: byte(r), g: byte(g), b: byte(b), a: byte(a)})
		}

		// A frame is rasterised by the canvas and shown as its pixels; a part
		// drawn over the last frame shows both; `read` gives what was shown.
		@test()
		def drawsFramesAsPixels() {
			let host = new PixelHost()
			let ren = new CPURenderer()
			ren.attach(host) onerror (err error) {
				println("attach: ", err.message)
				assert false
				return
			}
			assert host.opened == 1
			let win = new r.Window(7)
			let frame = ren.nextFrame(win) onerror (err error) {
				println("nextFrame: ", err.message)
				assert false
				return
			}
			assert !frame.kept
			frame.ctx.clear(rgba(240, 240, 240))
			frame.ctx.fill(Rect{left: 4.0, top: 4.0, right: 30.0, bottom: 20.0}, rgba(200, 30, 30))
			ren.commit(win, frame) onerror (err error) {
				println("commit: ", err.message)
				assert false
				return
			}
			let want = new Canvas(64, 48)
			want.apply(frame.ctx)
			assert host.shownW == 64 && host.shownH == 48
			assert host.shown.equals(want.pixels)
			// The next frame keeps the last; a part over it shows both.
			let part = ren.nextFrame(win) onerror recover r.Frame{ctx: new DrawContext(new Size(0.0, 0.0))}
			assert part.kept
			part.over = true
			part.ctx.fill(Rect{left: 40.0, top: 30.0, right: 60.0, bottom: 44.0}, rgba(30, 30, 200))
			ren.commit(win, part) onerror recover none
			want.apply(part.ctx)
			assert host.shown.equals(want.pixels)
			let box = ren.read(win, 40, 30, 20, 14) onerror recover byte[]
			assert box.len() == 20 * 14 * 4
			assert int(box[0]) == 30 && int(box[2]) == 200
			ren.read(win, 60, 40, 20, 20) onerror (err error) {
				assert err.message.contains("not inside")
				recover byte[]
			}
			ren.release(win) onerror recover none
			ren.read(win, 0, 0, 1, 1) onerror (err error) {
				assert err.message.contains("no frame")
				recover byte[]
			}
		}

		// A host with a window open for another API refuses the renderer.
		@test()
		def refusesAHostWithWindowsOpen() {
			let host = new PixelHost()
			host.refused = true
			let ren = new CPURenderer()
			let failed = false
			ren.attach(host) onerror (err error) {
				failed = true
				recover none
			}
			assert failed
		}
	}
}
