partial module std.ui.renderer.directx {
	use std.ui.renderer as r

	// Placeholder for a Direct3D renderer. Every call fails with not implemented.
	@r.UIRenderer(name = "directx")
	type DirectXRenderer {
		def new() {}

		// Fails: not implemented.
		def attach(host r.Host) !none {
			fail "DirectX renderer not implemented"
		}

		// Fails: not implemented.
		def nextFrame(win r.Window) !r.Frame {
			fail "DirectX renderer not implemented"
		}

		// Fails: not implemented.
		def commit(win r.Window, frame r.Frame) !none {
			fail "DirectX renderer not implemented"
		}

		// Fails: not implemented.
		def release(win r.Window) !none {
			fail "DirectX renderer not implemented"
		}

		// Fails: not implemented.
		def read(win r.Window, left int, top int, width int, height int) !byte[] {
			fail "DirectX renderer not implemented"
		}
	}
}
