partial module std.ui.renderer.directx {
	use (
		std.formats.image
		std.ui.renderer as r
	)

	// Placeholder for a Direct3D renderer. Every call fails with not implemented.
	@r.UIRenderer(name = "directx")
	type DirectXRenderer {
		def new() {}

		// Opens a window for the configuration and returns its handle.
		//
		// Fails always: not implemented.
		def openWindow(cfg r.WindowConfig) !r.Window {
			fail "DirectX renderer not implemented"
		}

		// Sets the window's title.
		//
		// Fails always: not implemented.
		def setWindowTitle(win r.Window, title string) !none {
			fail "DirectX renderer not implemented"
		}

		// Sets the window's icon from an RGBA image.
		//
		// Fails always: not implemented.
		def setWindowIcon(win r.Window, icon image.Image) !none {
			fail "DirectX renderer not implemented"
		}

		// Reads the platform events waiting on the window.
		//
		// Fails always: not implemented.
		def pollEvents(win r.Window) !r.PlatformEvent[] {
			fail "DirectX renderer not implemented"
		}

		// Starts a frame: a draw surface the size of the window's framebuffer.
		//
		// Fails always: not implemented.
		def nextFrame(win r.Window) !r.Frame {
			fail "DirectX renderer not implemented"
		}

		// Rasterises the frame and presents it.
		//
		// Fails always: not implemented.
		def commit(win r.Window, frame r.Frame) !none {
			fail "DirectX renderer not implemented"
		}

		// Destroys the window and everything the renderer held for it.
		//
		// Fails always: not implemented.
		def closeWindow(win r.Window) !none {
			fail "DirectX renderer not implemented"
		}
	}
}
