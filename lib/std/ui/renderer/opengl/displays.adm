partial module std.ui.renderer.opengl {
	use (
		std.math.geom::Rect
		std.ui
		std.units::Pixels
		std.units
		std.ui.renderer.opengl.glfw
	)

	// The connected monitors, the primary one first.
	internal def glfwDisplays() ui.Display[] {
		let out ui.Display[] = []
		let count int32[]
		count.len(1)
		let list = glfw.glfwGetMonitors(count)
		let n = int(count[0])
		return out when list == 0 || n <= 0

		let handles uint64[]
		handles.len(n)
		let _ = glfw.glfwCopyMonitors(handles, list, uint(n * 8))
		let primary = glfw.glfwGetPrimaryMonitor()
		for let (_, handle) in handles {
			out.push(monitorDisplay(uint(handle), true)) when uint(handle) == primary
		}
		for let (_, handle) in handles {
			out.push(monitorDisplay(uint(handle), false)) when uint(handle) != primary
		}
		return out
	}

	// One monitor as a Display. GLFW's screen coordinates are device pixels on
	// X11 and logical pixels on Wayland; its video mode is in device pixels.
	internal def monitorDisplay(monitor uint, primary bool) ui.Display {
		let scaleX float32[]
		let scaleY float32[]
		scaleX.len(1)
		scaleY.len(1)
		glfw.glfwGetMonitorContentScale(monitor, scaleX, scaleY)
		let scale = float(scaleX[0])
		scale = 1.0 when scale <= 0.0
		let wayland = glfwWayland()
		let unit = wayland ?? (1.0, scale)

		let x int32[]
		let y int32[]
		x.len(1)
		y.len(1)
		glfw.glfwGetMonitorPos(monitor, x, y)

		let mode int32[]
		mode.len(6)
		let modeAt = glfw.glfwGetVideoMode(monitor)
		if modeAt != 0 {
			let _ = glfw.glfwCopyVideoMode(mode, modeAt, 24)
		}

		let left = float(x[0]) / unit
		let top = float(y[0]) / unit
		let bounds = pixelRect(left, top, float(mode[0]) / scale, float(mode[1]) / scale)
		let display = ui.Display{name: glfw.glfwGetMonitorName(monitor), bounds: bounds, workArea: bounds, scale: scale, primary: primary}

		// Wayland has no work area; GLFW reports the whole output there.
		if !wayland {
			let w int32[]
			let h int32[]
			w.len(1)
			h.len(1)
			glfw.glfwGetMonitorWorkarea(monitor, x, y, w, h)
			display.workArea = pixelRect(float(x[0]) / unit, float(y[0]) / unit, float(w[0]) / unit, float(h[0]) / unit) when w[0] > 0 && h[0] > 0
		}

		display.refreshRate = float(mode[5]) when mode[5] > 0
		let widthMm int32[]
		let heightMm int32[]
		widthMm.len(1)
		heightMm.len(1)
		glfw.glfwGetMonitorPhysicalSize(monitor, widthMm, heightMm)
		display.dpi = float(mode[0]) * 25.4 / float(widthMm[0]) * 1(dpi) when widthMm[0] > 0 && mode[0] > 0
		return display
	}

	// The window's frame on the desktop, in logical pixels.
	internal def glfwWindowBounds(window uint) Rect<Pixels> {
		let x int32[]
		let y int32[]
		let w int32[]
		let h int32[]
		x.len(1)
		y.len(1)
		w.len(1)
		h.len(1)
		glfw.glfwGetWindowPos(window, x, y)
		glfw.glfwGetWindowSize(window, w, h)
		let unit = 1.0
		if !glfwWayland() {
			// X11 has one scale for the whole screen.
			let scaleX float32[]
			let scaleY float32[]
			scaleX.len(1)
			scaleY.len(1)
			let primary = glfw.glfwGetPrimaryMonitor()
			glfw.glfwGetMonitorContentScale(primary, scaleX, scaleY) when primary != 0
			unit = float(scaleX[0]) when scaleX[0] > float32(0.0)
		}
		return pixelRect(float(x[0]) / unit, float(y[0]) / unit, float(w[0]) / unit, float(h[0]) / unit)
	}

	// Whether GLFW talks to a Wayland compositor: GLFW 3.4 prefers Wayland
	// when WAYLAND_DISPLAY is set, earlier versions only speak X11.
	internal def glfwWayland() bool {
		let major int32[]
		let minor int32[]
		let revision int32[]
		major.len(1)
		minor.len(1)
		revision.len(1)
		glfw.glfwGetVersion(major, minor, revision)
		return false when major[0] < 3 || (major[0] == 3 && minor[0] < 4)
		let display = __env_get("WAYLAND_DISPLAY")
		return false when display is none
		let name string = display
		return name.len() > 0
	}

	internal def pixelRect(left float, top float, width float, height float) Rect<Pixels> {
		return Rect<Pixels>{left: left * 1(px), top: top * 1(px), right: (left + width) * 1(px), bottom: (top + height) * 1(px)}
	}
}
