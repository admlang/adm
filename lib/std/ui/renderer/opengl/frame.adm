partial module std.ui.renderer.opengl {
	use (
		std.gfx.canvas::(Composite, GpuEffectKind, OutlinePosition, GpuBackdropBlur, GpuBackdropMatrix, GpuBeginGroup, GpuBlit, GpuDraw, GpuEndGroup, GpuFragment, GpuFrame, GpuGradient, GpuImage, GpuMove, GpuNoise, GpuOp, GpuPixels, GpuSolid, LiveRaster)
		std.math.geom::(FillRule, Transform2D)
		std.gfx.color::(BlendMode, RGBA)
		std.formats.video as video
		std.services.runtime::(Runtime)
		std.ui.renderer.opengl.gl
	)

	@embed("shaders/canvas.vert")
	internal const canvasVertexSource byte[]

	@embed("shaders/canvas.frag")
	internal const canvasFragmentSource byte[]

	@embed("shaders/effects.frag")
	internal const effectsFragmentSource byte[]

	// The passes of the effects program (shaders/effects.frag).
	enum EffectMode {
		Alpha,
		Covered,
		Copy,
		Inverted,
		Multiply,
		MultiplyInverse,
		Shifted,
		Box,
		Grown,
		Ring,
		Signed,
		DistanceInit,
		DistanceColumns,
		DistanceRows,
		Linear,
		Store,
		Halve,
	}

	// One level of a cached image: an RGBA8 texture and its framebuffer.
	internal struct ImageLevel {
		texture uint32
		fbo     uint32 = 0
		w       int
		h       int
	}

	// An image's levels in the cache, and the frame it was last drawn in.
	internal type CachedImage {
		levels  ImageLevel[]
		used    int          = 0
		// For a live raster's picture: the version of it the base level holds.
		version uint64       = 0

		def new(levels ImageLevel[]) {
			self.levels = levels
		}
	}

	// A float texture an effect pass writes, with its framebuffer.
	internal struct PlaneTex {
		texture uint32
		fbo     uint32
		w       int
		h       int
		format  uint32
	}

	// The region a group's effects work on, and its planes' width.
	internal struct EffectRegion {
		x  int
		y  int
		w  int
		h  int
		pw int
	}

	// A compiled canvas program and its uniform locations by name.
	internal type CanvasProgram {
		internal id          uint32
		internal locations   map<string, int>
		// Built with ADM_TARGET_READ: the shader reads the target it draws into.
		internal readsTarget bool             = false
		// The location of the uniform block's words (CanvasUniforms).
		internal words       int              = -1

		def new(id uint32) {
			self.id = id
		}

		// The location of the uniform, looked up once.
		def at(name string) int {
			let held = locations.get(name)
			return held unless held is none
			let found = gl.glGetUniformLocation(id, name)
			locations[name] = found
			return found
		}
	}

	// The canvas shader's uniform block (shaders/canvas.frag, std140): its
	// size and the byte offsets of its members.
	internal const canvasBlock = 528
	internal const cBox = 0
	internal const cTint = 16
	internal const cPixelsOrigin = 32
	internal const cImageSize = 40
	internal const cImageSpread = 48
	internal const cInvX = 56
	internal const cInvY = 64
	internal const cInvT = 72
	internal const cSolid = 80
	internal const cSolidA = 92
	internal const cAlpha = 96
	internal const cComposite = 100
	internal const cBlend = 104
	internal const cPaired = 108
	internal const cOp = 112
	internal const cPaintKind = 116
	internal const cHasCoverage = 120
	internal const cHasClip = 124
	internal const cCoverageFromPlane = 128
	internal const cHasQuad = 132
	internal const cHardQuad = 136
	internal const cEdgeBands = 140
	internal const cEvenOdd = 144
	internal const cGradKind = 148
	internal const cSpread = 152
	internal const cOctaves = 156
	internal const cSampling = 160
	internal const cTinted = 164
	internal const cEdgeBase = 168
	internal const cTableRow = 172
	internal const cQuad = 176
	internal const cParams = 304
	internal const cMatrix = 432
	internal const cCoverageBase = 512
	internal const cClipBase = 516

	// One draw's canvas uniform block as little-endian 32-bit words, the
	// std140 layout of canvas.frag's `Uniforms`, which OpenGL takes as the
	// shader's `uWords` vectors in one glUniform4uiv a draw. Set by value, a
	// draw's uniforms never make the driver wait: a write into a buffer that
	// queued draws read makes some drivers (Mesa's llvmpipe) finish them all
	// first, and binding another part of a buffer for each draw costs NVIDIA's
	// GPU about a microsecond a draw. A `double` member is a float where the
	// shaders compute in floats (blockDoubles): std140 gives both the same
	// offsets.
	internal type CanvasUniforms {
		internal words uint32[]

		def new() {
			words.len(canvasBlock / 4)
		}

		def int(at int, v int) {
			words[at >> 2] = uint32(int32(v))
		}

		def uint(at int, v uint32) {
			words[at >> 2] = v
		}

		def float(at int, v float32) {
			words[at >> 2] = __bitcast_u32_from_f32(v)
		}

		def double(at int, v float64) {
			if blockDoubles {
				let u = __bitcast_u64_from_f64(v)
				words[at >> 2] = uint32(u & 0xFFFFFFFF)
				words[(at >> 2) + 1] = uint32(u >> 32)
			} else {
				words[at >> 2] = __bitcast_u32_from_f32(float32(v))
			}
		}

		// Every member zero, for the next draw.
		def clear() {
			words.fill(uint32(0))
		}

		// Sets the block as the uniforms of the program, the current one.
		def upload(p CanvasProgram) {
			gl.glUniform4uiv(p.words, canvasBlock / 16, words)
		}
	}

	// The coverage and clip bytes, path edges and gradient tables of a run of
	// draws, each kind in one texture that goes up in one upload before the
	// run's first draw: an upload between two draws makes the GPU finish the
	// first before it starts the second (with NVIDIA's driver about 20 µs a
	// draw). Entry n holds where the run's n-th draw finds its own, -1 for
	// what it does not have.
	internal type DrawStore {
		// Coverage and clip bytes, each over its draw's box row by row, from
		// their base on: an R8 texture as wide as the largest texture side,
		// filled row after row (canvas.frag's storedByte).
		internal bytes      byte[]
		// Each path's band table and edges (addEdges), edgeRow RGBA32F texels
		// a row.
		internal edges      float32[]
		// One table of 1024 RGBA16UI texels a row.
		internal tables     uint16[]
		internal coverageAt int[]
		internal clipAt     int[]
		internal edgesAt    int[]
		internal tableAt    int[]
		// Per entry the first of its rectangles in `regions` (x0 y0 x1 y1
		// each) and how many, -1 when it may change its whole box (addRegion).
		internal regionAt   int[]
		internal regionN    int[]
		internal regions    int[]
		// Scratch for addRegion: the crossings of a draw's middle row.
		internal crossWork  float[]
		internal eventWork  float[]
		internal byteTex    ScratchTexture = new ScratchTexture(gl.GL_R8)
		internal edgeTex    ScratchTexture = new ScratchTexture(gl.GL_RGBA32F, gl.GL_RGBA, gl.GL_FLOAT)
		internal tableTex   ScratchTexture = new ScratchTexture(gl.GL_RGBA16UI, gl.GL_RGBA_INTEGER, gl.GL_UNSIGNED_SHORT)
		// GL_MAX_TEXTURE_SIZE, asked on first use.
		internal largest    int            = 0

		def new() {}

		// Empties it for the next run.
		def reset() {
			bytes.len(0)
			edges.len(0)
			tables.len(0)
			coverageAt.len(0)
			clipAt.len(0)
			edgesAt.len(0)
			tableAt.len(0)
			regionAt.len(0)
			regionN.len(0)
			regions.len(0)
		}

		// Adds the draw as the next entry. False, adding nothing, when the
		// store holds draws already and this one would take it past
		// storeBudget bytes or what its textures hold: the draw then starts
		// the next run.
		def add(d GpuDraw) bool {
			let (b0, e0, t0, r0) = (bytes.len(), edges.len(), tables.len(), regions.len())
			coverageAt.push(d.coverage.len() > 0 ?? (addBytes(d.coverage), -1))
			clipAt.push(d.clip.len() > 0 ?? (addBytes(d.clip), -1))
			edgesAt.push(d.edges.len() > 0 ?? (addEdges(d), -1))
			let paint = d.paint
			let table = -1
			if paint is GpuGradient {
				table = addTable(paint.table)
			} else if paint is GpuNoise {
				table = addTable(paint.table)
			}
			tableAt.push(table)
			regionAt.push(addRegion(d))
			regionN.push((regions.len() - r0) / 4)
			let size = bytes.len() + edges.len() * 4 + tables.len() * 2
			if coverageAt.len() > 1 && (size > storeBudget || !fits()) {
				bytes.len(b0)
				edges.len(e0)
				tables.len(t0)
				regions.len(r0)
				coverageAt.pop()
				clipAt.pop()
				edgesAt.pop()
				tableAt.pop()
				regionAt.pop()
				regionN.pop()
				return false
			}
			return true
		}

		// Adds a composite's coverage as the next entry, without the rest.
		def addCoverage(data byte[]) {
			coverageAt.push(addBytes(data))
			clipAt.push(-1)
			edgesAt.push(-1)
			tableAt.push(-1)
			regionAt.push(-1)
			regionN.push(0)
		}

		// Whether what it holds fits its textures.
		def fits() bool {
			let side = maxSide()
			return bytes.len() <= side * side && edges.len() / 4 <= edgeRow * side && tables.len() / (edgeRow * 4) <= side
		}

		// Uploads what it holds: the bytes on unit 1, the edges on 13, the
		// tables on 11. The textures grow to powers of two rows, so they take
		// a few sizes only: a driver may compile a shader variant per texture
		// size (llvmpipe keys them on it).
		def upload() !none {
			let side = maxSide()
			fail "the GPU canvas cannot hold the coverage of one draw ({bytes.len()} bytes, {edges.len() / 4} edge texels; the largest texture is {side} x {side})" unless fits()
			if bytes.len() > 0 {
				let rows = (bytes.len() + side - 1) / side
				grow(bytes, rows * side)
				gl.glActiveTexture(gl.GL_TEXTURE1)
				byteTex.ensure(side, powerOfTwo(rows))
				byteTex.upload(side, rows, bytes)
			}
			if edges.len() > 0 {
				let rows = (edges.len() / 4 + edgeRow - 1) / edgeRow
				grow(edges, rows * edgeRow * 4)
				gl.glActiveTexture(gl.GL_TEXTURE13)
				edgeTex.ensure(edgeRow, powerOfTwo(rows))
				edgeTex.upload(edgeRow, rows, edges)
			}
			if tables.len() > 0 {
				let rows = tables.len() / (edgeRow * 4)
				gl.glActiveTexture(gl.GL_TEXTURE11)
				tableTex.ensure(edgeRow, powerOfTwo(rows))
				tableTex.upload(edgeRow, rows, tables)
			}
			gl.glActiveTexture(gl.GL_TEXTURE0)
		}

		// Frees the textures.
		def dispose() {
			byteTex.dispose()
			edgeTex.dispose()
			tableTex.dispose()
		}

		internal def maxSide() int {
			if largest == 0 {
				let v int32[]
				v.len(1)
				gl.glGetIntegerv(gl.GL_MAX_TEXTURE_SIZE, v)
				largest = int(v[0]).max(1024)
			}
			return largest
		}

		// The bytes appended: their base.
		internal def addBytes(data byte[]) int {
			let at = bytes.len()
			grow(bytes, at + data.len())
			data.copy(bytes.slice(at, data.len()))
			return at
		}

		// The table appended as a row of 1024 entries: its row.
		internal def addTable(entries uint16[]) int {
			let at = tables.len()
			grow(tables, at + edgeRow * 4)
			entries.copy(tables.slice(at, edgeRow * 4))
			return at / (edgeRow * 4)
		}

		// The rectangles of the path draw `d` that it can change, appended to
		// `regions`: its box but for a hole, unfilled, around the widest gap of
		// its middle row that its rule leaves unfilled (an outline's inside):
		// that gap's columns, from the middle up and down while no edge enters
		// them and the winding there stays unfilled. The edges come without the
		// horizontal ones, which the winding still follows: in columns no edge
		// enters it changes only where an edge to their right starts or ends.
		// A pixel of the hole lies a pixel or more from those bounds, so its
		// coverage is zero and the shader leaves it unwritten. The first
		// rectangle's index, or -1 (none added) when the draw may change
		// anything in its box: an operator that changes what lies outside the
		// shape, or no hole.
		internal def addRegion(d GpuDraw) int {
			return -1 when d.edges.len() == 0 || unboundedComposite(d.composite)
			let e = d.edges
			let mid = float(d.y) + float(d.h / 2) + 0.5
			// The middle row's crossings, x and direction, sorted by x.
			let cross = crossWork
			cross.len(0)
			for let i = 0; i < e.len(); i += 4 {
				let (y0, y1) = (e[i + 1], e[i + 3])
				continue unless y0.min(y1) <= mid && mid < y0.max(y1)
				let x = e[i] + (mid - y0) * (e[i + 2] - e[i]) / (y1 - y0)
				let dir = y1 > y0 ?? (1.0, -1.0)
				let k = cross.len()
				cross.push(x, dir)
				for k > 0 && cross[k - 2] > x {
					cross[k] = cross[k - 2]
					cross[k + 1] = cross[k - 1]
					k -= 2
				}
				cross[k] = x
				cross[k + 1] = dir
			}
			// The widest gap the rule leaves unfilled: left of every crossing a
			// closed path's winding is zero, and passing a crossing takes its
			// direction off the edges still to the right.
			let (ca, cb) = (0.0, 0.0)
			let winding = 0
			for let k = 0; k + 2 < cross.len(); k += 2 {
				winding -= int(cross[k + 1])
				let filled = d.rule == FillRule.EvenOdd ?? (winding % 2 != 0, winding != 0)
				if !filled && cross[k + 2] - cross[k] > cb - ca {
					(ca, cb) = (cross[k], cross[k + 2])
				}
			}
			return -1 when cb - ca < 4.0
			// As far up and down as no edge enters the column between them.
			let (top, bottom) = (float(d.y), float(d.y + d.h))
			for let i = 0; i < e.len(); i += 4 {
				let (x0, y0, x1, y1) = (e[i], e[i + 1], e[i + 2], e[i + 3])
				let (ya, yb) = (0.0, 0.0)
				if x0 == x1 {
					continue unless ca < x0 && x0 < cb
					(ya, yb) = (y0.min(y1), y0.max(y1))
				} else {
					let ta = ((ca - x0) / (x1 - x0)).max(0.0).min(1.0)
					let tb = ((cb - x0) / (x1 - x0)).max(0.0).min(1.0)
					continue when ta == tb
					let (ya0, yb0) = (y0 + (y1 - y0) * ta, y0 + (y1 - y0) * tb)
					(ya, yb) = (ya0.min(yb0), ya0.max(yb0))
				}
				if yb <= mid {
					top = top.max(yb)
				} else if ya >= mid {
					bottom = bottom.min(ya)
				} else {
					return -1
				}
			}
			// The winding in the columns from the middle up and down, as the
			// edges to their right start and end: kept while unfilled.
			let events = eventWork
			events.len(0)
			for let i = 0; i < e.len(); i += 4 {
				let (x0, y0, x1, y1) = (e[i], e[i + 1], e[i + 2], e[i + 3])
				continue when y0 == y1
				let (ya, yb) = (y0.min(y1).max(top), y0.max(y1).min(bottom))
				continue when ya >= yb
				let (xa, xb) = (x0 + (ya - y0) * (x1 - x0) / (y1 - y0), x0 + (yb - y0) * (x1 - x0) / (y1 - y0))
				continue when xa.min(xb) < cb
				let dir = y1 > y0 ?? (1.0, -1.0)
				events.push(ya, dir, yb, -dir)
			}
			sortEvents(events)
			let (up, down) = (top, bottom)
			let w = 0
			for let k = 0; k < events.len(); k += 2 {
				let y = events[k]
				w += int(events[k + 1])
				let next = k + 2 < events.len() ?? (events[k + 2], bottom)
				continue unless next > y
				let filled = d.rule == FillRule.EvenOdd ?? (w % 2 != 0, w != 0)
				if filled {
					if y >= mid {
						down = down.min(y)
					} else {
						up = up.max(next)
					}
				}
			}
			(top, bottom) = (up, down)
			let (hx0, hx1) = (int(ca.ceil()) + 1, int(cb.floor()) - 1)
			let (hy0, hy1) = (int(top.ceil()) + 1, int(bottom.floor()) - 1)
			return -1 when hx0 >= hx1 || hy0 >= hy1
			let (bx0, by0, bx1, by1) = (d.x, d.y, d.x + d.w, d.y + d.h)
			let start = regions.len()
			regions.push(bx0, by0, bx1, hy0) when hy0 > by0
			regions.push(bx0, hy1, bx1, by1) when by1 > hy1
			regions.push(bx0, hy0, hx0, hy1) when hx0 > bx0
			regions.push(hx1, hy0, bx1, hy1) when bx1 > hx1
			return start
		}

		// The draw's path edges appended, as canvas.frag's pathCoverage reads
		// them: per band of edgeBandRows rows of the box, the index of its
		// first edge and how many cross it (counted from the draw's first
		// texel), then the edges, x0 y0 x1 y1 a texel. Its first texel.
		internal def addEdges(d GpuDraw) int {
			let e = d.edges
			let bands = (d.h + edgeBandRows - 1) / edgeBandRows
			let counts int[]
			counts.len(bands)
			for let i = 0; i < e.len(); i += 4 {
				let (first, last) = edgeBands(e, i, d.y, d.h)
				for let b = first; b <= last; b++ {
					counts[b]++
				}
			}
			let starts int[]
			starts.len(bands)
			let total = bands
			for let b = 0; b < bands; b++ {
				starts[b] = total
				total += counts[b]
			}
			let base = edges.len() / 4
			grow(edges, (base + total) * 4)
			let data = edges
			let o = base * 4
			for let b = 0; b < bands; b++ {
				data[o + b * 4] = float32(starts[b])
				data[o + b * 4 + 1] = float32(counts[b])
				data[o + b * 4 + 2] = float32(0)
				data[o + b * 4 + 3] = float32(0)
			}
			for let i = 0; i < e.len(); i += 4 {
				let (first, last) = edgeBands(e, i, d.y, d.h)
				for let b = first; b <= last; b++ {
					let at = o + starts[b] * 4
					data[at] = float32(e[i])
					data[at + 1] = float32(e[i + 1])
					data[at + 2] = float32(e[i + 2])
					data[at + 3] = float32(e[i + 3])
					starts[b]++
				}
			}
			return base
		}
	}

	// Whether the operator changes what lies outside the shape it draws.
	internal def unboundedComposite(c Composite) bool {
		return c := Composite.SourceIn || Composite.SourceOut || Composite.DestinationIn || Composite.DestinationAtop || Composite.Copy
	}

	// Sorts the events (row, change in turn) by row in place.
	internal def sortEvents(events float[]) {
		for let k = 2; k < events.len(); k += 2 {
			let (y, w) = (events[k], events[k + 1])
			let j = k
			for j > 0 && events[j - 2] > y {
				events[j] = events[j - 2]
				events[j + 1] = events[j - 1]
				j -= 2
			}
			events[j] = y
			events[j + 1] = w
		}
	}

	// The least power of two at least `n` (1 for 0).
	internal def powerOfTwo(n int) int {
		let p = 1
		for p < n {
			p *= 2
		}
		return p
	}

	// The most bytes a run of draws stages before it is drawn (DrawStore):
	// a draw past them starts another run.
	internal const storeBudget = 32 * 1024 * 1024

	// Sets the array's length to `n`, its capacity doubling when it grows, so
	// that a run appended to piece by piece copies its contents a few times
	// only. Elements past the old length are not cleared: after a shrink they
	// hold what they held before.
	internal def grow<T>(a T[], n int) {
		if n > a.cap() {
			a.cap(n.max(a.cap() * 2))
		}
		a.len(n)
	}

	// A texture that grows to the largest box asked of it.
	internal type ScratchTexture {
		internal id     uint32 = 0
		internal w      int    = 0
		internal h      int    = 0
		internal format uint32
		// What uploads hold: the pixel format and component type.
		internal pixel  uint32
		internal kind   uint32

		def new(format uint32) {
			self.format = format
			pixel = format == gl.GL_R8 ?? (gl.GL_RED, gl.GL_RGBA)
			kind = gl.GL_UNSIGNED_BYTE
		}

		def new(format uint32, pixel uint32, kind uint32) {
			self.format = format
			self.pixel = pixel
			self.kind = kind
		}

		// The texture bound, at least w x h.
		def ensure(w int, h int) uint32 {
			if id == 0 {
				let ids uint32[]
				ids.len(1)
				gl.glGenTextures(1, ids)
				id = ids[0]
			}
			gl.glBindTexture(gl.GL_TEXTURE_2D, id)
			if w > self.w || h > self.h {
				self.w = w.max(self.w)
				self.h = h.max(self.h)
				gl.glTexParameteri(gl.GL_TEXTURE_2D, gl.GL_TEXTURE_MIN_FILTER, int(gl.GL_NEAREST))
				gl.glTexParameteri(gl.GL_TEXTURE_2D, gl.GL_TEXTURE_MAG_FILTER, int(gl.GL_NEAREST))
				gl.glTexImage2D(gl.GL_TEXTURE_2D, 0, int(format), self.w, self.h, 0, pixel, kind, byte[])
			}
			return id
		}

		// Uploads w x h tightly packed floats (a float texture's) to the
		// texture's corner.
		def upload(w int, h int, data float32[]) uint32 {
			let t = ensure(w, h)
			gl.glPixelStorei(gl.GL_UNPACK_ALIGNMENT, 4)
			gl.glPixelStorei(gl.GL_UNPACK_ROW_LENGTH, w)
			gl.glTexSubImage2D(gl.GL_TEXTURE_2D, 0, 0, 0, w, h, pixel, kind, data)
			gl.glPixelStorei(gl.GL_UNPACK_ROW_LENGTH, 0)
			return t
		}

		// Uploads w x h tightly packed 16-bit values (an integer texture's) to
		// the texture's corner.
		def upload(w int, h int, data uint16[]) uint32 {
			let t = ensure(w, h)
			gl.glPixelStorei(gl.GL_UNPACK_ALIGNMENT, 2)
			gl.glPixelStorei(gl.GL_UNPACK_ROW_LENGTH, w)
			gl.glTexSubImage2D(gl.GL_TEXTURE_2D, 0, 0, 0, w, h, pixel, kind, data)
			gl.glPixelStorei(gl.GL_UNPACK_ROW_LENGTH, 0)
			return t
		}

		// Uploads w x h tightly packed 32-bit values (an integer texture's) to
		// the texture's corner.
		def upload(w int, h int, data int32[]) uint32 {
			let t = ensure(w, h)
			gl.glPixelStorei(gl.GL_UNPACK_ALIGNMENT, 4)
			gl.glPixelStorei(gl.GL_UNPACK_ROW_LENGTH, w)
			gl.glTexSubImage2D(gl.GL_TEXTURE_2D, 0, 0, 0, w, h, pixel, kind, data)
			gl.glPixelStorei(gl.GL_UNPACK_ROW_LENGTH, 0)
			return t
		}

		// Uploads w x h tightly packed bytes to the texture's corner.
		def upload(w int, h int, data byte[]) uint32 {
			let t = ensure(w, h)
			gl.glPixelStorei(gl.GL_UNPACK_ALIGNMENT, 1)
			gl.glPixelStorei(gl.GL_UNPACK_ROW_LENGTH, w)
			gl.glTexSubImage2D(gl.GL_TEXTURE_2D, 0, 0, 0, w, h, pixel, kind, data)
			gl.glPixelStorei(gl.GL_UNPACK_ROW_LENGTH, 0)
			return t
		}

		// Frees the texture.
		def dispose() {
			if id != 0 {
				gl.glDeleteTextures(1, uint32[id])
				id = 0
				w = 0
				h = 0
			}
		}
	}

	// A frame-sized RGBA8 texture with its framebuffer.
	internal struct Target {
		texture uint32
		fbo     uint32
		// When draws read the target in place: the boxes drawn into it since
		// the last texture barrier (FrameRenderer.settle), x0 y0 x1 y1 each,
		// recorded at barrier epoch `drawnAt` (older ones are void).
		drawn   int[]  = []
		drawnAt int    = 0
	}

	// The most boxes a target records between texture barriers: past them
	// they are merged into the one box around them all, which only makes
	// more draws wait for a barrier.
	internal const drawnBoxes = 256

	// FrameRenderer draws GpuFrames (DrawContext.lower) with OpenGL on the
	// current context, into a texture the size of the frame: the canvas's
	// coverage and pixels, the paint, clip, operators, blend modes and
	// groups in a shader that composites as the canvas does.
	internal type FrameRenderer {
		internal width        int                        = 0
		internal height       int                        = 0
		// The frame's target, then one per open group.
		internal stack        Target[]
		// Group targets kept for the next frame.
		internal spare        Target[]
		internal dst          ScratchTexture             = new ScratchTexture(gl.GL_RGBA8)
		internal pixels       ScratchTexture             = new ScratchTexture(gl.GL_RGBA8)
		// Gradient tables (1024 x 1, 16-bit channels), the blue noise they
		// dither with, and noise hashes.
		internal dither       ScratchTexture             = new ScratchTexture(gl.GL_R8)
		internal perm         ScratchTexture             = new ScratchTexture(gl.GL_R32I, gl.GL_RED_INTEGER, gl.GL_INT)
		// The coverage, clip, path edges and gradient tables of a run of draws.
		internal store        DrawStore                  = new DrawStore()
		internal ditherUp     bool                       = false
		// The canvas programs' uniform block for the draw being set up.
		internal uniforms     CanvasUniforms             = new CanvasUniforms()
		// Float planes effects work on, kept for the next group, and the
		// colour tables of colour blurs.
		internal planePool    PlaneTex[]
		// Image textures by their content key, what they take, and the
		// frame each was last drawn in.
		internal images       map<string, CachedImage>
		internal imageBytes   int                        = 0
		internal imageBudget  int                        = 256 * 1024 * 1024
		internal frameCount   int                        = 0
		// The kinds of operations (frameKinds) frames of the checked size used
		// with no GL error; a frame that brings none is not checked.
		internal checkedKinds int                        = 0
		internal checkedW     int                        = -1
		internal checkedH     int                        = -1
		internal linearTable  uint32                     = 0
		internal srgbTable    uint32                     = 0
		// The base program, and one per @fragment function by name.
		internal programs     map<string, CanvasProgram>
		// Whether the canvas programs read the target in place, after a texture
		// barrier, instead of a copy of each draw's box: 1 when the context has
		// glTextureBarrier (and ADM_GL_TARGET_READ is not 0), 0 when not, -1
		// before the first program is built.
		internal targetRead   int                        = -1
		// The program glUseProgram made current during the frame, 0 when not
		// known: the driver may validate the program again on every call, even
		// of the current one (NVIDIA's does), and most draws use one program.
		internal inUse        uint32                     = 0
		// Counts the texture barriers: a target's boxes recorded at the current
		// epoch were drawn since the last one.
		internal epoch        int                        = 1
		// Video frames drawn as image paints: the program that converts
		// Y'CbCr, the planes it reads, and the converted picture with its
		// halved levels, kept while frames have the same size.
		internal videoLayer   ?VideoLayer                = none
		internal videoPlanes  ?VideoTextures             = none
		internal videoLevels  ImageLevel[]

		def new() {}

		// The texture holding the last frame drawn (straight RGBA8, row 0
		// the top of the frame), or 0 before the first.
		def texture() uint32 {
			return stack.len() == 0 ?? (uint32(0), stack[0].texture)
		}

		// Whether it holds a frame of that size: one drawn with `over` then has
		// something to draw on.
		def holds(w int, h int) bool {
			return stack.len() > 0 && w == width && h == height
		}

		// Draws the frame from transparent black; with `over`, on the last
		// frame drawn when it has that size.
		def draw(frame GpuFrame, over bool = false) !none {
			// glGetError waits for the GPU (in a browser, a round trip to its GPU
			// process). What makes a GL call fail is the kind of operation and the
			// target's size, so a frame is checked, its draws together at its end,
			// when it brings a kind or a size not checked yet, and every 64th frame
			// besides (the GPU running out of memory). What was pending before the
			// frame is not the frame's.
			inUse = 0
			let kinds = frameKinds(frame)
			let checked = (kinds & checkedKinds) != kinds || frame.width != checkedW || frame.height != checkedH || frameCount % 64 == 0
			if checked {
				let _ = gl.glGetError()
			}
			try start(frame.width, frame.height, over && holds(frame.width, frame.height))
			frameCount++
			let ops = frame.ops
			let i = 0
			for i < ops.len() {
				let end = try stageRun(ops, i)
				if end == i {
					try apply(ops[i], frame)
					i++
					continue
				}
				for let k = i; k < end; k++ {
					let op = ops[k]
					if op is GpuDraw {
						try drawOp(op, frame, k - i)
					}
				}
				i = end
			}
			// Groups left open are dropped, as endGroup never came.
			for stack.len() > 1 {
				spare.push(stack.pop())
			}
			gl.glDisable(gl.GL_SCISSOR_TEST)
			gl.glBindFramebuffer(gl.GL_FRAMEBUFFER, 0)
			trimImages()
			return none unless checked
			let err = gl.glGetError()
			fail "the GPU canvas draw failed (GL error {err})" when err != 0
			if frame.width != checkedW || frame.height != checkedH {
				(checkedW, checkedH, checkedKinds) = (frame.width, frame.height, 0)
			}
			checkedKinds = checkedKinds | kinds
		}

		// The last frame's pixels, straight RGBA8, row 0 the top.
		def read() byte[] {
			let out byte[]
			return out when stack.len() == 0
			out.len(width * height * 4)
			gl.glBindFramebuffer(gl.GL_READ_FRAMEBUFFER, stack[0].fbo)
			gl.glPixelStorei(gl.GL_PACK_ALIGNMENT, 1)
			gl.glReadPixels(0, 0, width, height, gl.GL_RGBA, gl.GL_UNSIGNED_BYTE, out)
			gl.glBindFramebuffer(gl.GL_READ_FRAMEBUFFER, 0)
			return out
		}

		// The last frame's pixels in a box of it, straight RGBA8, row 0 the box's top.
		def read(left int, top int, wide int, high int) byte[] {
			let out byte[]
			return out when stack.len() == 0
			out.len(wide * high * 4)
			gl.glBindFramebuffer(gl.GL_READ_FRAMEBUFFER, stack[0].fbo)
			gl.glPixelStorei(gl.GL_PACK_ALIGNMENT, 1)
			gl.glReadPixels(left, top, wide, high, gl.GL_RGBA, gl.GL_UNSIGNED_BYTE, out)
			gl.glBindFramebuffer(gl.GL_READ_FRAMEBUFFER, 0)
			return out
		}

		// Frees every texture, framebuffer and program.
		def dispose() {
			for stack.len() > 0 {
				spare.push(stack.pop())
			}
			for let (_, t) in spare {
				freeTarget(t)
			}
			spare.len(0)
			dst.dispose()
			store.dispose()
			pixels.dispose()
			dither.dispose()
			perm.dispose()
			ditherUp = false
			for let (_, t) in planePool {
				gl.glDeleteFramebuffers(1, uint32[t.fbo])
				gl.glDeleteTextures(1, uint32[t.texture])
			}
			planePool.len(0)
			for let (_, c) in images {
				for let (_, l) in c.levels {
					gl.glDeleteFramebuffers(1, uint32[l.fbo])
					gl.glDeleteTextures(1, uint32[l.texture])
				}
			}
			images = map<string, CachedImage>{}
			imageBytes = 0
			freeVideoLevels()
			let planes = videoPlanes
			if planes is VideoTextures {
				gl.glDeleteTextures(4, planes.ids)
				videoPlanes = none
			}
			let layer = videoLayer
			if layer is VideoLayer {
				gl.glDeleteProgram(layer.program)
				videoLayer = none
			}
			if linearTable != 0 {
				gl.glDeleteTextures(2, uint32[linearTable, srgbTable])
				linearTable = 0
				srgbTable = 0
			}
			for let (_, p) in programs {
				gl.glDeleteProgram(p.id)
			}
			programs = map<string, CanvasProgram>{}
			width = 0
			height = 0
		}

		internal def start(w int, h int, keep bool = false) !none {
			if w != width || h != height {
				for stack.len() > 0 {
					freeTarget(stack.pop())
				}
				for let (_, t) in spare {
					freeTarget(t)
				}
				spare.len(0)
				width = w
				height = h
			}
			for stack.len() > 1 {
				spare.push(stack.pop())
			}
			if stack.len() == 0 {
				let t = try newTarget()
				stack.push(t)
			}
			clearTarget(stack[0]) unless keep
			gl.glDisable(gl.GL_BLEND)
		}

		internal def newTarget() !Target {
			if spare.len() > 0 {
				return spare.pop()
			}
			let ids uint32[]
			ids.len(1)
			gl.glGenTextures(1, ids)
			let tex = ids[0]
			gl.glBindTexture(gl.GL_TEXTURE_2D, tex)
			gl.glTexParameteri(gl.GL_TEXTURE_2D, gl.GL_TEXTURE_MIN_FILTER, int(gl.GL_NEAREST))
			gl.glTexParameteri(gl.GL_TEXTURE_2D, gl.GL_TEXTURE_MAG_FILTER, int(gl.GL_NEAREST))
			gl.glTexImage2D(gl.GL_TEXTURE_2D, 0, int(gl.GL_RGBA8), width.max(1), height.max(1), 0, gl.GL_RGBA, gl.GL_UNSIGNED_BYTE, byte[])
			let fbos uint32[]
			fbos.len(1)
			gl.glGenFramebuffers(1, fbos)
			gl.glBindFramebuffer(gl.GL_FRAMEBUFFER, fbos[0])
			gl.glFramebufferTexture2D(gl.GL_FRAMEBUFFER, gl.GL_COLOR_ATTACHMENT0, gl.GL_TEXTURE_2D, tex, 0)
			let status = gl.glCheckFramebufferStatus(gl.GL_FRAMEBUFFER)
			gl.glBindFramebuffer(gl.GL_FRAMEBUFFER, 0)
			if status != gl.GL_FRAMEBUFFER_COMPLETE {
				gl.glDeleteFramebuffers(1, fbos)
				gl.glDeleteTextures(1, ids)
				fail "the GPU canvas could not make a {width}x{height} RGBA8 framebuffer (status {status})"
			}
			return Target{texture: tex, fbo: fbos[0]}
		}

		internal def freeTarget(t Target) {
			gl.glDeleteFramebuffers(1, uint32[t.fbo])
			gl.glDeleteTextures(1, uint32[t.texture])
		}

		internal def clearTarget(t Target) {
			gl.glBindFramebuffer(gl.GL_FRAMEBUFFER, t.fbo)
			gl.glDisable(gl.GL_SCISSOR_TEST)
			gl.glViewport(0, 0, width, height)
			gl.glClearColor(0.0, 0.0, 0.0, 0.0)
			gl.glClear(gl.GL_COLOR_BUFFER_BIT)
			wrote(t, 0, 0, width, height)
		}

		// Records that a draw (or a clear) wrote the box of `t`, unless draws
		// copy their boxes instead of reading targets in place. A renderer's
		// first frame clears its target before its first program says which
		// they do, and the draw after reads what the clear wrote.
		internal def wrote(t Target, x int, y int, w int, h int) {
			return when targetRead == 0
			let (x0, y0) = (x.max(0), y.max(0))
			let (x1, y1) = ((x + w).min(width), (y + h).min(height))
			return when x0 >= x1 || y0 >= y1
			if t.drawnAt != epoch {
				t.drawn.len(0)
				t.drawnAt = epoch
			}
			let boxes = t.drawn
			if boxes.len() == drawnBoxes * 4 {
				let (a, b, c, d) = (x0, y0, x1, y1)
				for let i = 0; i < boxes.len(); i += 4 {
					a = a.min(boxes[i])
					b = b.min(boxes[i + 1])
					c = c.max(boxes[i + 2])
					d = d.max(boxes[i + 3])
				}
				t.drawn.len(0)
				t.drawn.push(a, b, c, d)
				return
			}
			t.drawn.push(x0, y0, x1, y1)
		}

		// Before a draw that reads the box of `t` in place: a texture barrier
		// when a draw since the last one wrote any pixel of the box, so the
		// draw reads what it wrote. Draws side by side (the rows of a list, the
		// glyph runs of a line) then share one. A path draw passes and records
		// the rectangles of its region instead of its box (compositeInto): it
		// leaves the rest unwritten, whatever it reads there.
		internal def settle(t Target, x int, y int, w int, h int) {
			return when t.drawnAt != epoch
			let (x0, y0, x1, y1) = (x, y, x + w, y + h)
			let boxes = t.drawn
			for let i = 0; i < boxes.len(); i += 4 {
				if x0 < boxes[i + 2] && boxes[i] < x1 && y0 < boxes[i + 3] && boxes[i + 1] < y1 {
					gl.adm_gl_texture_barrier()
					epoch++
					return
				}
			}
		}

		// Makes the program current unless it is.
		internal def useProgram(id uint32) {
			return when id == inUse
			gl.glUseProgram(id)
			inUse = id
		}

		internal def apply(op GpuOp, frame GpuFrame) !none {
			match op {
				case GpuDraw:
					try drawOp(op, frame, -1)
				case GpuBlit:
					try blitOp(op)
				case GpuMove:
					try moveOp(op)
				case GpuBeginGroup:
					let t = try newTarget()
					clearTarget(t)
					stack.push(t)
				case GpuEndGroup:
					return none when stack.len() < 2
					if op.effects.len() > 0 || op.margin > 0 {
						try endGroupEffects(op, frame)
						return none
					}
					let g = stack.pop()
					let p = try program(none)
					let n = try stageCoverage(op.coverage)
					try composite(p, op.x, op.y, op.w, op.h, def () {
						bindPaintPixels(g.texture, 0, 0)
						bindStoredCoverage(n)
						uniforms.uint(cAlpha, uint32(op.alpha))
						uniforms.int(cComposite, int(op.composite))
						uniforms.int(cBlend, int(op.blend))
						uniforms.int(cPaired, 0)
						uniforms.int(cOp, 1)
					})
					spare.push(g)
				case GpuBackdropBlur:
					backdropOp(op.x, op.y, op.w, op.h, op.apply)
				case GpuBackdropMatrix:
					backdropOp(op.x, op.y, op.w, op.h, op.apply)
			}
		}

		// Draws `d`, entry `n` of the staged run (stageRun), or staged alone
		// when `n` is -1. `plane` (not 0): coverage is that plane rounded to
		// bytes, and pixel paints cover the box (px, py, pw, ph) rather than
		// the draw's.
		internal def drawOp(d GpuDraw, frame GpuFrame, n int, plane uint32 = 0, px int = 0, py int = 0, pw int = 0, ph int = 0) !none {
			let entry = n
			if entry < 0 {
				store.reset()
				store.add(d)
				try store.upload()
				entry = 0
			}
			let paint = d.paint
			let frag ?GpuFragment = none
			if paint is GpuFragment {
				frag = paint
			}
			let p = try program(frag)
			// An image's level is made before the draw: uploading and halving
			// bind textures and another program.
			let level = ImageLevel{texture: 0, w: 1, h: 1}
			if paint is GpuImage {
				try ensureTables(frame)
				level = try imageLevel(paint, frame)
			}
			try composite(p, d.x, d.y, d.w, d.h, def () {
				match paint {
					case GpuSolid:
						uniforms.int(cPaintKind, 0)
						uniforms.uint(cSolid, uint32(paint.r))
						uniforms.uint(cSolid + 4, uint32(paint.g))
						uniforms.uint(cSolid + 8, uint32(paint.b))
					case GpuPixels:
						if pw > 0 {
							bindUploadedPixels(pw, ph, paint.pixels, px, py)
						} else {
							bindUploadedPixels(d.w, d.h, paint.pixels, d.x, d.y)
						}
					case GpuGradient:
						uniforms.int(cPaintKind, 3)
						bindStoredTable(entry, frame)
						uniforms.int(cGradKind, int(paint.kind))
						uniforms.int(cSpread, int(paint.spread))
						setInverse(paint.inv)
						for let (i, v) in paint.params {
							uniforms.double(cParams + i * 16, float64(v)) when i < 8
						}
					case GpuImage:
						uniforms.int(cPaintKind, 6)
						gl.glActiveTexture(gl.GL_TEXTURE8)
						gl.glBindTexture(gl.GL_TEXTURE_2D, level.texture)
						gl.glActiveTexture(gl.GL_TEXTURE9)
						gl.glBindTexture(gl.GL_TEXTURE_2D, linearTable)
						gl.glActiveTexture(gl.GL_TEXTURE10)
						gl.glBindTexture(gl.GL_TEXTURE_2D, srgbTable)
						gl.glActiveTexture(gl.GL_TEXTURE0)
						uniforms.int(cImageSize, level.w)
						uniforms.int(cImageSize + 4, level.h)
						uniforms.int(cImageSpread, int(paint.repeatX))
						uniforms.int(cImageSpread + 4, int(paint.repeatY))
						uniforms.int(cSampling, int(paint.sampling))
						let inv = paint.inv
						uniforms.double(cParams, float64(inv.a))
						uniforms.double(cParams + 16, float64(inv.b))
						uniforms.double(cParams + 32, float64(inv.c))
						uniforms.double(cParams + 48, float64(inv.d))
						uniforms.double(cParams + 64, float64(inv.tx))
						uniforms.double(cParams + 80, float64(inv.ty))
						let tint = paint.tint
						if tint is RGBA {
							uniforms.int(cTinted, 1)
							uniforms.uint(cTint, uint32(tint.r))
							uniforms.uint(cTint + 4, uint32(tint.g))
							uniforms.uint(cTint + 8, uint32(tint.b))
							uniforms.uint(cTint + 12, uint32(tint.a))
						}
					case GpuNoise:
						uniforms.int(cPaintKind, 4)
						bindStoredTable(entry, frame)
						setInverse(paint.inv)
						uniforms.int(cOctaves, paint.octaves)
						gl.glActiveTexture(gl.GL_TEXTURE12)
						perm.upload(paint.perm.len(), 1, paint.perm)
						gl.glActiveTexture(gl.GL_TEXTURE0)
					case GpuFragment:
						uniforms.int(cPaintKind, 2)
						setInverse(paint.inv)
						setFragmentUniforms(p, paint)
				}
				bindStoredCoverage(entry)
				uniforms.uint(cAlpha, uint32(d.alpha))
				uniforms.int(cComposite, int(d.composite))
				uniforms.int(cBlend, int(d.blend))
				// fillCoverage's pair table, for large shaded fills in a
				// per-channel mode.
				let paired = !(paint is GpuSolid) && !d.layer && d.composite == Composite.SourceOver && perChannelMode(d.blend) && d.w * d.h >= 128 * 128
				uniforms.int(cPaired, paired ?? (1, 0))
				uniforms.int(cOp, d.layer ?? (1, 0))
				if d.quad.len() == 8 {
					uniforms.int(cHasQuad, 1)
					uniforms.int(cHardQuad, d.antialias ?? (0, 1))
					for let (i, v) in d.quad {
						uniforms.double(cQuad + i * 16, float64(v))
					}
				}
				bindStoredEdges(entry, d)
				if plane != 0 {
					bindPlane(plane)
					uniforms.int(cCoverageFromPlane, 1)
				}
			}, entry)
		}

		// Stages the run of draws from ops[from] in the store, as many as it
		// takes (DrawStore.add), and uploads it: the index after the run's last
		// draw, `from` when ops[from] is no draw.
		internal def stageRun(ops GpuOp[], from int) !int {
			store.reset()
			let end = from
			for end < ops.len() {
				let op = ops[end]
				if op is GpuDraw {
					break unless store.add(op)
				} else {
					break
				}
				end++
			}
			try store.upload() when end > from
			return end
		}

		// Stages a composite's coverage alone: its entry, -1 when it has none.
		internal def stageCoverage(bytes byte[]) !int {
			return -1 when bytes.len() == 0
			store.reset()
			store.addCoverage(bytes)
			try store.upload()
			return 0
		}

		// The coverage and clip of entry `n` (none for -1): the store's bytes
		// on unit 1, where the shader reads both.
		internal def bindStoredCoverage(n int) {
			return when n < 0
			let (cov, clip) = (store.coverageAt[n], store.clipAt[n])
			return when cov < 0 && clip < 0
			gl.glActiveTexture(gl.GL_TEXTURE1)
			gl.glBindTexture(gl.GL_TEXTURE_2D, store.byteTex.id)
			gl.glActiveTexture(gl.GL_TEXTURE0)
			if cov >= 0 {
				uniforms.int(cHasCoverage, 1)
				uniforms.int(cCoverageBase, cov)
			}
			if clip >= 0 {
				uniforms.int(cHasClip, 1)
				uniforms.int(cClipBase, clip)
			}
		}

		// The path edges of entry `n` on unit 13, for the shader's coverage.
		internal def bindStoredEdges(n int, d GpuDraw) {
			let at = store.edgesAt[n]
			return when at < 0
			gl.glActiveTexture(gl.GL_TEXTURE13)
			gl.glBindTexture(gl.GL_TEXTURE_2D, store.edgeTex.id)
			gl.glActiveTexture(gl.GL_TEXTURE0)
			uniforms.int(cEdgeBase, at)
			uniforms.int(cEdgeBands, (d.h + edgeBandRows - 1) / edgeBandRows)
			uniforms.int(cEvenOdd, d.rule == FillRule.EvenOdd ?? (1, 0))
			uniforms.int(cHardQuad, d.antialias ?? (0, 1))
		}

		internal def blitOp(b GpuBlit) !none {
			let x0 = b.x.max(0)
			let y0 = b.y.max(0)
			let x1 = (b.x + b.w).min(width)
			let y1 = (b.y + b.h).min(height)
			return none when x0 >= x1 || y0 >= y1
			let p = try program(none)
			try composite(p, x0, y0, x1 - x0, y1 - y0, def () {
				bindUploadedPixels(b.w, b.h, b.pixels, b.x, b.y)
				uniforms.int(cBlend, int(b.blend))
				uniforms.int(cOp, b.copy ?? (2, 3))
			})
		}

		// Moves a box of the current target: copied to a scratch texture,
		// then drawn back at its new place as a copying blit is.
		internal def moveOp(m GpuMove) !none {
			return none when m.w <= 0 || m.h <= 0
			let t = stack[stack.len() - 1]
			gl.glActiveTexture(gl.GL_TEXTURE3)
			let held = pixels.ensure(m.w, m.h)
			gl.glBindFramebuffer(gl.GL_READ_FRAMEBUFFER, t.fbo)
			gl.glCopyTexSubImage2D(gl.GL_TEXTURE_2D, 0, 0, 0, m.x, m.y, m.w, m.h)
			let (x, y) = (m.x + m.dx, m.y + m.dy)
			let p = try program(none)
			try composite(p, x, y, m.w, m.h, def () {
				bindPaintPixels(held, x, y)
				uniforms.int(cBlend, 0)
				uniforms.int(cOp, 2)
			})
		}

		// A backdrop op on the CPU (GpuBackdropBlur, GpuBackdropMatrix): the box
		// read back, changed by `apply` as the canvas does, and written again.
		internal def backdropOp(x int, y int, w int, h int, apply def(byte[])) {
			return when w <= 0 || h <= 0
			let t = stack[stack.len() - 1]
			let box byte[]
			box.len(w * h * 4)
			gl.glBindFramebuffer(gl.GL_READ_FRAMEBUFFER, t.fbo)
			gl.glPixelStorei(gl.GL_PACK_ALIGNMENT, 1)
			gl.glReadPixels(x, y, w, h, gl.GL_RGBA, gl.GL_UNSIGNED_BYTE, box)
			gl.glBindFramebuffer(gl.GL_READ_FRAMEBUFFER, 0)
			apply(box)
			gl.glBindTexture(gl.GL_TEXTURE_2D, t.texture)
			gl.glPixelStorei(gl.GL_UNPACK_ALIGNMENT, 1)
			gl.glTexSubImage2D(gl.GL_TEXTURE_2D, 0, x, y, w, h, gl.GL_RGBA, gl.GL_UNSIGNED_BYTE, box)
		}

		// Runs the program over the box of the current target: copies the
		// box to the destination texture, lets `setup` set the paint and
		// coverage (its uniforms on zeros), and draws.
		internal def composite(p CanvasProgram, x int, y int, w int, h int, setup def(), entry int = -1) !none {
			return try compositeInto(stack[stack.len() - 1], p, x, y, w, h, setup, entry)
		}

		// composite over the box of target `t`. A program that reads the target
		// in place samples its texture after a barrier, which makes the draws
		// before it visible; others get a copy of the box.
		internal def compositeInto(t Target, p CanvasProgram, x int, y int, w int, h int, setup def(), entry int = -1) !none {
			return none when w <= 0 || h <= 0
			useProgram(p.id)
			gl.glActiveTexture(gl.GL_TEXTURE0)
			// What the draw can change: its box, or the store entry's region.
			let at = entry >= 0 ?? (store.regionAt[entry], -1)
			if p.readsTarget {
				gl.glBindTexture(gl.GL_TEXTURE_2D, t.texture)
				if at < 0 {
					settle(t, x, y, w, h)
				} else {
					let rs = store.regions
					let before = epoch
					for let r = 0; r < store.regionN[entry] && epoch == before; r++ {
						let o = at + r * 4
						settle(t, rs[o], rs[o + 1], rs[o + 2] - rs[o], rs[o + 3] - rs[o + 1])
					}
				}
			} else {
				dst.ensure(w, h)
				gl.glBindFramebuffer(gl.GL_READ_FRAMEBUFFER, t.fbo)
				gl.glCopyTexSubImage2D(gl.GL_TEXTURE_2D, 0, 0, 0, x, y, w, h)
			}
			uniforms.clear()
			uniforms.int(cBox, x)
			uniforms.int(cBox + 4, y)
			uniforms.int(cBox + 8, w)
			uniforms.int(cBox + 12, h)
			// Unit 3 may still hold a group's texture from its composite into the
			// layer below, and that texture may be this target now (see useEffects).
			bindNoPixels()
			setup()
			uniforms.upload(p)
			gl.glBindFramebuffer(gl.GL_FRAMEBUFFER, t.fbo)
			gl.glViewport(0, 0, width, height)
			gl.glEnable(gl.GL_SCISSOR_TEST)
			gl.glScissor(x, y, w, h)
			gl.glDrawArrays(gl.GL_TRIANGLES, 0, 3)
			gl.glDisable(gl.GL_SCISSOR_TEST)
			if at < 0 {
				wrote(t, x, y, w, h)
			} else {
				let rs = store.regions
				for let r = 0; r < store.regionN[entry]; r++ {
					let o = at + r * 4
					wrote(t, rs[o], rs[o + 1], rs[o + 2] - rs[o], rs[o + 3] - rs[o + 1])
				}
			}
		}

		internal def bindPaintPixels(texture uint32, ox int, oy int) {
			gl.glActiveTexture(gl.GL_TEXTURE3)
			gl.glBindTexture(gl.GL_TEXTURE_2D, texture)
			uniforms.int(cPixelsOrigin, ox)
			uniforms.int(cPixelsOrigin + 4, oy)
			uniforms.int(cPaintKind, 1)
			gl.glActiveTexture(gl.GL_TEXTURE0)
		}

		// Uploads w x h pixels as the paint, texel (0, 0) at target pixel
		// (ox, oy).
		internal def bindUploadedPixels(w int, h int, bytes byte[], ox int, oy int) {
			gl.glActiveTexture(gl.GL_TEXTURE3)
			bindPaintPixels(pixels.upload(w, h, bytes), ox, oy)
		}

		// Device pixels to the paint's space.
		internal def setInverse(inv Transform2D) {
			uniforms.float(cInvX, float32(inv.a))
			uniforms.float(cInvX + 4, float32(inv.b))
			uniforms.float(cInvY, float32(inv.c))
			uniforms.float(cInvY + 4, float32(inv.d))
			uniforms.float(cInvT, float32(inv.tx))
			uniforms.float(cInvT + 4, float32(inv.ty))
		}

		// The gradient or noise table of entry `n` on unit 11, and the blue
		// noise on unit 5.
		internal def bindStoredTable(n int, frame GpuFrame) {
			gl.glActiveTexture(gl.GL_TEXTURE11)
			gl.glBindTexture(gl.GL_TEXTURE_2D, store.tableTex.id)
			uniforms.int(cTableRow, store.tableAt[n])
			gl.glActiveTexture(gl.GL_TEXTURE5)
			if !ditherUp {
				dither.upload(64, 64, frame.blueNoise())
				ditherUp = true
			} else {
				dither.ensure(64, 64)
			}
			gl.glActiveTexture(gl.GL_TEXTURE0)
		}

		internal def bindNoPixels() {
			gl.glActiveTexture(gl.GL_TEXTURE3)
			gl.glBindTexture(gl.GL_TEXTURE_2D, pixels.ensure(1, 1))
			gl.glActiveTexture(gl.GL_TEXTURE0)
		}

		// The fragment's parameters, from the packed uniforms.
		internal def setFragmentUniforms(p CanvasProgram, f GpuFragment) {
			let u = f.uniforms
			for let (_, param) in f.shader.params {
				let at = p.at("adm_u_" + param.name)
				continue when at < 0
				let o = param.offset
				let v = (i int) => o + i < u.len() ?? (u[o + i], float32(0))
				match param.kind {
					case FragmentKind.Float32:
						gl.glUniform1f(at, v(0))
					case FragmentKind.Int32:
						gl.glUniform1i(at, int(v(0)))
					case FragmentKind.Bool:
						gl.glUniform1i(at, v(0) != float32(0) ?? (1, 0))
					case FragmentKind.Vec2:
						gl.glUniform2f(at, v(0), v(1))
					case FragmentKind.Vec3:
						gl.glUniform3f(at, v(0), v(1), v(2))
					case FragmentKind.Vec4:
						gl.glUniform4f(at, v(0), v(1), v(2), v(3))
				}
			}
		}

		// The texture of the image's level, from the cache while its key
		// stays the same: the window uploaded, then halved on the GPU.
		internal def imageLevel(img GpuImage, frame GpuFrame) !ImageLevel {
			let picture = img.video
			if picture is video.VideoFrame {
				return videoLevel(picture, img.halvings)
			}
			let live = img.live
			if !(live is none) {
				return try liveLevel(live, img)
			}
			let key = "{img.key}"
			if !images.hasKey(key) {
				let base = try newLevel(img.ww, img.wh)
				gl.glBindTexture(gl.GL_TEXTURE_2D, base.texture)
				gl.glPixelStorei(gl.GL_UNPACK_ALIGNMENT, 1)
				gl.glPixelStorei(gl.GL_UNPACK_ROW_LENGTH, img.stride / 4)
				gl.glPixelStorei(gl.GL_UNPACK_SKIP_PIXELS, img.wx)
				gl.glPixelStorei(gl.GL_UNPACK_SKIP_ROWS, img.wy)
				gl.glTexSubImage2D(gl.GL_TEXTURE_2D, 0, 0, 0, img.ww, img.wh, gl.GL_RGBA, gl.GL_UNSIGNED_BYTE, img.pixels)
				gl.glPixelStorei(gl.GL_UNPACK_ROW_LENGTH, 0)
				gl.glPixelStorei(gl.GL_UNPACK_SKIP_PIXELS, 0)
				gl.glPixelStorei(gl.GL_UNPACK_SKIP_ROWS, 0)
				let levels ImageLevel[]
				levels.push(base)
				images = images.set(key, new CachedImage(levels))
				imageBytes += img.ww * img.wh * 4
			}
			let cached = images[key]
			cached.used = frameCount
			for cached.levels.len() <= img.halvings {
				let below = cached.levels[cached.levels.len() - 1]
				let next = try newLevel((below.w + 1) / 2, (below.h + 1) / 2)
				try halveInto(below, next)
				cached.levels.push(next)
				imageBytes += next.w * next.h * 4
			}
			return cached.levels[img.halvings]
		}

		// The texture of a live raster's level, kept under the raster's id: the
		// rectangles marked since the version it holds are uploaded into it, or the
		// whole raster when those marks are no longer kept or its size changed; the
		// halved levels are made again from it after an update.
		internal def liveLevel(live LiveRaster, img GpuImage) !ImageLevel {
			let key = "live {live.id()}"
			let held = images.get(key)
			dropImage(key) when !(held is none) && (held.levels[0].w != img.ww || held.levels[0].h != img.wh)
			if !images.hasKey(key) {
				let base = try newLevel(img.ww, img.wh)
				let levels ImageLevel[]
				levels.push(base)
				let made = new CachedImage(levels)
				// Taken whole below.
				made.version = live.changes() + 1
				images = images.set(key, made)
				imageBytes += img.ww * img.wh * 4
			}
			let cached = images[key]
			cached.used = frameCount
			if cached.version != live.changes() {
				let base = cached.levels[0]
				gl.glBindTexture(gl.GL_TEXTURE_2D, base.texture)
				gl.glPixelStorei(gl.GL_UNPACK_ALIGNMENT, 1)
				gl.glPixelStorei(gl.GL_UNPACK_ROW_LENGTH, img.stride / 4)
				let marked = cached.version < live.changes() ?? (live.marksSince(cached.version), none)
				if marked is none {
					gl.glTexSubImage2D(gl.GL_TEXTURE_2D, 0, 0, 0, img.ww, img.wh, gl.GL_RGBA, gl.GL_UNSIGNED_BYTE, img.pixels)
				} else {
					for let r in marked {
						gl.glPixelStorei(gl.GL_UNPACK_SKIP_PIXELS, r.left)
						gl.glPixelStorei(gl.GL_UNPACK_SKIP_ROWS, r.top)
						gl.glTexSubImage2D(gl.GL_TEXTURE_2D, 0, r.left, r.top, r.right - r.left, r.bottom - r.top, gl.GL_RGBA, gl.GL_UNSIGNED_BYTE, img.pixels)
					}
				}
				gl.glPixelStorei(gl.GL_UNPACK_ROW_LENGTH, 0)
				gl.glPixelStorei(gl.GL_UNPACK_SKIP_PIXELS, 0)
				gl.glPixelStorei(gl.GL_UNPACK_SKIP_ROWS, 0)
				cached.version = live.changes()
				// The halved levels showed the picture before.
				for cached.levels.len() > 1 {
					let gone = cached.levels.pop()
					freeLevel(gone)
					imageBytes -= gone.w * gone.h * 4
				}
			}
			for cached.levels.len() <= img.halvings {
				let below = cached.levels[cached.levels.len() - 1]
				let next = try newLevel((below.w + 1) / 2, (below.h + 1) / 2)
				try halveInto(below, next)
				cached.levels.push(next)
				imageBytes += next.w * next.h * 4
			}
			return cached.levels[img.halvings]
		}

		// The texture of a video frame's level: the picture converted from
		// its planes by the video program, then halved on the GPU. A frame
		// with nothing to show is black.
		internal def videoLevel(frame video.VideoFrame, halvings int) !ImageLevel {
			if videoLayer is none {
				videoLayer = try newVideoLayer()
			}
			if videoPlanes is none {
				videoPlanes = new VideoTextures()
			}
			let layer = videoLayer
			let planes = videoPlanes
			fail "the video program is missing" when layer is none || planes is none
			let w = int(frame.width).max(1)
			let h = int(frame.height).max(1)
			if videoLevels.len() > 0 && (videoLevels[0].w != w || videoLevels[0].h != h) {
				freeVideoLevels()
			}
			if videoLevels.len() == 0 {
				videoLevels.push(try newLevel(w, h))
			}
			let base = videoLevels[0]
			gl.glBindFramebuffer(gl.GL_FRAMEBUFFER, base.fbo)
			gl.glViewport(0, 0, w, h)
			gl.glDisable(gl.GL_SCISSOR_TEST)
			if !layer.convert(planes, frame, w, h) {
				gl.glClearColor(0.0, 0.0, 0.0, 1.0)
				gl.glClear(gl.GL_COLOR_BUFFER_BIT)
			}
			// The video program made itself current.
			inUse = 0
			gl.glActiveTexture(gl.GL_TEXTURE0)
			let err = gl.glGetError()
			fail "converting a video frame on the GPU failed (GL error {err})" when err != 0
			for let k = 1; k <= halvings; k++ {
				if videoLevels.len() <= k {
					let below = videoLevels[k - 1]
					videoLevels.push(try newLevel((below.w + 1) / 2, (below.h + 1) / 2))
				}
				try halveInto(videoLevels[k - 1], videoLevels[k])
			}
			return videoLevels[halvings]
		}

		internal def freeVideoLevels() {
			for let (_, l) in videoLevels {
				gl.glDeleteFramebuffers(1, uint32[l.fbo])
				gl.glDeleteTextures(1, uint32[l.texture])
			}
			videoLevels.len(0)
		}

		// An RGBA8 texture with its framebuffer, for an image level.
		internal def newLevel(w int, h int) !ImageLevel {
			let ids uint32[]
			ids.len(1)
			gl.glGenTextures(1, ids)
			gl.glBindTexture(gl.GL_TEXTURE_2D, ids[0])
			gl.glTexParameteri(gl.GL_TEXTURE_2D, gl.GL_TEXTURE_MIN_FILTER, int(gl.GL_NEAREST))
			gl.glTexParameteri(gl.GL_TEXTURE_2D, gl.GL_TEXTURE_MAG_FILTER, int(gl.GL_NEAREST))
			gl.glTexImage2D(gl.GL_TEXTURE_2D, 0, int(gl.GL_RGBA8), w.max(1), h.max(1), 0, gl.GL_RGBA, gl.GL_UNSIGNED_BYTE, byte[])
			let fbos uint32[]
			fbos.len(1)
			gl.glGenFramebuffers(1, fbos)
			gl.glBindFramebuffer(gl.GL_FRAMEBUFFER, fbos[0])
			gl.glFramebufferTexture2D(gl.GL_FRAMEBUFFER, gl.GL_COLOR_ATTACHMENT0, gl.GL_TEXTURE_2D, ids[0], 0)
			let status = gl.glCheckFramebufferStatus(gl.GL_FRAMEBUFFER)
			gl.glBindFramebuffer(gl.GL_FRAMEBUFFER, 0)
			fail "the GPU canvas could not make a {w}x{h} image texture (status {status})" when status != gl.GL_FRAMEBUFFER_COMPLETE
			return ImageLevel{texture: ids[0], fbo: fbos[0], w: w, h: h}
		}

		// halveLevel on the GPU: `below` averaged 2x2 into `next`.
		internal def halveInto(below ImageLevel, next ImageLevel) !none {
			let e = try useEffects(EffectMode.Halve)
			gl.glUniform1i(e.at("uW"), below.w)
			gl.glUniform1i(e.at("uH"), below.h)
			bindUnit(e, "uImage", 3, below.texture)
			bindUnit(e, "uLinear", 4, linearTable)
			bindUnit(e, "uSrgb", 5, srgbTable)
			gl.glBindFramebuffer(gl.GL_FRAMEBUFFER, next.fbo)
			gl.glViewport(0, 0, next.w, next.h)
			gl.glDisable(gl.GL_SCISSOR_TEST)
			gl.glDrawArrays(gl.GL_TRIANGLES, 0, 3)
			clearEffectUnits()
			let err = gl.glGetError()
			fail "halving an image on the GPU failed (GL error {err})" when err != 0
		}

		// Drops images no frame drew for a while, oldest first, once the
		// cache holds more than its budget.
		internal def trimImages() {
			return when imageBytes <= imageBudget
			let keys = images.keys()
			for let (_, k) in keys {
				let c = images[k]
				continue when frameCount - c.used < 2
				dropImage(k)
				return when imageBytes <= imageBudget
			}
		}

		// Frees the cached image under `key` and its levels.
		internal def dropImage(key string) {
			let c = images.get(key)
			return when c is none
			for let (_, l) in c.levels {
				freeLevel(l)
				imageBytes -= l.w * l.h * 4
			}
			images = images.delete(key)
		}

		internal def freeLevel(l ImageLevel) {
			gl.glDeleteFramebuffers(1, uint32[l.fbo])
			gl.glDeleteTextures(1, uint32[l.texture])
		}

		// A group with effects closed as the canvas's closeGroup does: the
		// exact region from the group's pixels, then the effects as passes
		// over float planes, the planes below and the group composited onto
		// the target below.
		internal def endGroupEffects(op GpuEndGroup, frame GpuFrame) !none {
			let g = stack.pop()
			if op.w <= 0 || op.h <= 0 {
				spare.push(g)
				return none
			}
			// The region lowering found: what the group drew, grown by the effects'
			// margin. Reading the group back to fit it to the pixels drawn would
			// wait for the GPU; past what was drawn there is nothing, at least a
			// margin away, so the effects come out the same over it.
			let r = EffectRegion{x: op.x, y: op.y, w: op.w, h: op.h, pw: (op.w + 7) / 8 * 8}
			let cov = coverageWithin(op, r.x, r.y, r.w, r.h)
			try ensureTables(frame)
			stack.push(g)
			let used PlaneTex[]
			let shape = try alphaOf(r, used, g)
			let dist = shape
			let haveDist = false
			let below PlaneTex[]
			let colors RGBA[]
			let blends BlendMode[]
			let showContent = true
			for let (_, fx) in op.effects {
				match fx.kind {
					case GpuEffectKind.DropShadow:
						let a = shape
						if fx.grow != 0.0 {
							if !haveDist {
								dist = try signedDistance(r, used, shape)
								haveDist = true
							}
							a = try grown(r, used, dist, fx.grow)
						}
						let sh = try shifted(r, used, a, fx.dx, fx.dy, 0.0)
						sh = try blurPlane(r, used, sh, fx.radii)
						if fx.knockout {
							sh = try binary(r, used, EffectMode.MultiplyInverse, sh, shape)
							showContent = false
						}
						below.push(sh)
						colors.push(fx.color)
						blends.push(BlendMode.Normal)
					case GpuEffectKind.OuterGlow:
						let a = try unary(r, used, EffectMode.Copy, shape)
						if fx.grow != 0.0 {
							if !haveDist {
								dist = try signedDistance(r, used, shape)
								haveDist = true
							}
							a = try grown(r, used, dist, fx.grow)
						}
						a = try blurPlane(r, used, a, fx.radii)
						below.push(a)
						colors.push(fx.color)
						blends.push(fx.blend)
					case GpuEffectKind.InnerShadow:
						let outside = try unary(r, used, EffectMode.Inverted, shape)
						if fx.grow != 0.0 {
							if !haveDist {
								dist = try signedDistance(r, used, shape)
								haveDist = true
							}
							let g2 = try grown(r, used, dist, -fx.grow)
							outside = try unary(r, used, EffectMode.Inverted, g2)
						}
						let sh = try shifted(r, used, outside, fx.dx, fx.dy, 1.0)
						sh = try blurPlane(r, used, sh, fx.radii)
						sh = try binary(r, used, EffectMode.Multiply, sh, shape)
						try atop(r, sh, fx.color, BlendMode.Normal)
					case GpuEffectKind.InnerGlow:
						let glow = try unary(r, used, EffectMode.Inverted, shape)
						glow = try blurPlane(r, used, glow, fx.radii)
						glow = try binary(r, used, EffectMode.Multiply, glow, shape)
						try atop(r, glow, fx.color, fx.blend)
					case GpuEffectKind.Outline:
						if !haveDist {
							dist = try signedDistance(r, used, shape)
							haveDist = true
						}
						let w = fx.grow
						let (outer, inner) = (w, 0.0)
						if fx.position == OutlinePosition.Inside {
							(outer, inner) = (0.0, -w)
						} else if fx.position == OutlinePosition.Center {
							(outer, inner) = (w / 2.0, -w / 2.0)
						}
						let ga = try grown(r, used, dist, outer)
						let gb = try grown(r, used, dist, inner)
						let ring = try binary(r, used, EffectMode.Ring, ga, gb)
						let paint = fx.paint
						if !(paint is none) {
							let solidAlpha = 255
							if paint is GpuSolid {
								solidAlpha = int(paint.a)
							}
							try drawOp(GpuDraw{x: r.x, y: r.y, w: r.w, h: r.h, paint: paint, alpha: solidAlpha, composite: Composite.SourceOver, blend: BlendMode.Normal}, frame, -1, ring.texture, op.x, op.y, op.w, op.h)
						}
					case GpuEffectKind.Blur:
						try colourBlur(r, used, g, fx.radii, none)
						shape = try alphaOf(r, used, g)
						haveDist = false
					case GpuEffectKind.BackdropBlur:
						let within = try unary(r, used, EffectMode.Covered, shape)
						try colourBlur(r, used, stack[stack.len() - 2], fx.radii, within)
					case GpuEffectKind.ColorMatrix:
						try colorMatrix(r, stack[stack.len() - 1], fx.matrix, none)
					case GpuEffectKind.BackdropMatrix:
						let within = try unary(r, used, EffectMode.Covered, shape)
						try colorMatrix(r, stack[stack.len() - 2], fx.matrix, within)
				}
			}
			stack.pop()
			let p = try program(none)
			let n = try stageCoverage(cov)
			for let (i, l) in below {
				let c = colors[i]
				let mode = blends[i]
				try composite(p, r.x, r.y, r.w, r.h, def () {
					uniforms.int(cPaintKind, 5)
					uniforms.uint(cSolid, uint32(c.r))
					uniforms.uint(cSolid + 4, uint32(c.g))
					uniforms.uint(cSolid + 8, uint32(c.b))
					uniforms.uint(cSolidA, uint32(c.a))
					bindPlane(l.texture)
					bindStoredCoverage(n)
					uniforms.uint(cAlpha, uint32(op.alpha))
					uniforms.int(cComposite, int(Composite.SourceOver))
					uniforms.int(cBlend, int(mode))
					uniforms.int(cPaired, 0)
					uniforms.int(cOp, 1)
				})
			}
			if showContent {
				try composite(p, r.x, r.y, r.w, r.h, def () {
					bindPaintPixels(g.texture, 0, 0)
					bindStoredCoverage(n)
					uniforms.uint(cAlpha, uint32(op.alpha))
					uniforms.int(cComposite, int(op.composite))
					uniforms.int(cBlend, int(op.blend))
					uniforms.int(cPaired, 0)
					uniforms.int(cOp, 1)
				})
			}
			for let (_, t) in used {
				planePool.push(t)
			}
			spare.push(g)
			return none
		}

		// alphaPlane of the group over the region.
		internal def alphaOf(r EffectRegion, used PlaneTex[], g Target) !PlaneTex {
			return try pass(r, used, EffectMode.Alpha, gl.GL_R32F, def (e CanvasProgram) {
				bindImage(e, g.texture, r)
			})
		}

		// The box of the group's non-transparent pixels within (x, y, w, h).
		// The group's coverage bytes over the region, from its box's.
		internal def coverageWithin(op GpuEndGroup, x int, y int, w int, h int) byte[] {
			return byte[] when op.coverage.len() == 0
			let out byte[]
			out.len(w * h)
			for let j = 0; j < h; j++ {
				let from = (y - op.y + j) * op.w + (x - op.x)
				for let i = 0; i < w; i++ {
					out[j * w + i] = op.coverage[from + i]
				}
			}
			return out
		}

		// A pass of the effects program into a new plane of the region.
		internal def pass(r EffectRegion, used PlaneTex[], mode EffectMode, format uint32, setup def(CanvasProgram)) !PlaneTex {
			let out = try planeOf(r.pw, r.h, format)
			used.push(out)
			let e = try useEffects(mode)
			gl.glUniform1i(e.at("uW"), r.w)
			gl.glUniform1i(e.at("uH"), r.h)
			gl.glUniform1i(e.at("uPW"), r.pw)
			setup(e)
			gl.glBindFramebuffer(gl.GL_FRAMEBUFFER, out.fbo)
			gl.glViewport(0, 0, r.pw, r.h)
			gl.glDisable(gl.GL_SCISSOR_TEST)
			gl.glDrawArrays(gl.GL_TRIANGLES, 0, 3)
			clearEffectUnits()
			return out
		}

		internal def unary(r EffectRegion, used PlaneTex[], mode EffectMode, a PlaneTex) !PlaneTex {
			return try pass(r, used, mode, a.format, def (e CanvasProgram) {
				bindUnit(e, "uA", 0, a.texture)
			})
		}

		internal def binary(r EffectRegion, used PlaneTex[], mode EffectMode, a PlaneTex, b PlaneTex) !PlaneTex {
			return try pass(r, used, mode, gl.GL_R32F, def (e CanvasProgram) {
				bindUnit(e, "uA", 0, a.texture)
				bindUnit(e, "uB", 1, b.texture)
			})
		}

		// shifted: the plane moved by (dx, dy), `outside` coming in.
		internal def shifted(r EffectRegion, used PlaneTex[], a PlaneTex, dx float, dy float, outside float) !PlaneTex {
			if dx == 0.0 && dy == 0.0 {
				return try unary(r, used, EffectMode.Copy, a)
			}
			let (fx, fy) = (dx.floor(), dy.floor())
			return try pass(r, used, EffectMode.Shifted, gl.GL_R32F, def (e CanvasProgram) {
				bindUnit(e, "uA", 0, a.texture)
				gl.glUniform4i(e.at("uI"), int(fx), int(fy), 0, 0)
				gl.glUniform4f(e.at("uF"), float32(dx - fx), float32(dy - fy), float32(outside), float32(0))
			})
		}

		// grown: clamp(0.5 + by - distance, 0, 1).
		internal def grown(r EffectRegion, used PlaneTex[], dist PlaneTex, by float) !PlaneTex {
			return try pass(r, used, EffectMode.Grown, gl.GL_R32F, def (e CanvasProgram) {
				bindUnit(e, "uA", 0, dist.texture)
				gl.glUniform4f(e.at("uF"), float32(0.5 + by), float32(0), float32(0), float32(0))
			})
		}

		// blurPlane: three box passes down, then three across.
		internal def blurPlane(r EffectRegion, used PlaneTex[], a PlaneTex, radii int[]) !PlaneTex {
			let cur = a
			for let dir = 0; dir < 2; dir++ {
				for let (_, br) in radii {
					continue when br <= 0
					let src = cur
					cur = try pass(r, used, EffectMode.Box, a.format, def (e CanvasProgram) {
						bindUnit(e, "uA", 0, src.texture)
						gl.glUniform4i(e.at("uI"), br, dir, 0, 0)
						gl.glUniform4f(e.at("uF"), float32(1.0 / float(2 * br + 1)), float32(0), float32(0), float32(0))
					})
				}
			}
			return cur
		}

		// signedDistance from exact distance transforms to the inside and
		// the outside.
		internal def signedDistance(r EffectRegion, used PlaneTex[], shape PlaneTex) !PlaneTex {
			let toInside = try distanceTo(r, used, shape, true)
			let toOutside = try distanceTo(r, used, shape, false)
			return try pass(r, used, EffectMode.Signed, gl.GL_R32F, def (e CanvasProgram) {
				bindUnit(e, "uA", 0, shape.texture)
				bindUnit(e, "uB", 1, toInside.texture)
				bindUnit(e, "uC", 2, toOutside.texture)
			})
		}

		internal def distanceTo(r EffectRegion, used PlaneTex[], shape PlaneTex, inside bool) !PlaneTex {
			let d = try pass(r, used, EffectMode.DistanceInit, gl.GL_R32F, def (e CanvasProgram) {
				bindUnit(e, "uA", 0, shape.texture)
				gl.glUniform4i(e.at("uI"), inside ?? (1, 0), 0, 0, 0)
			})
			let edge = inside ?? (float32(1e20), float32(0))
			let cols = try pass(r, used, EffectMode.DistanceColumns, gl.GL_R32F, def (e CanvasProgram) {
				bindUnit(e, "uA", 0, d.texture)
				gl.glUniform4f(e.at("uF"), edge, float32(0), float32(0), float32(0))
			})
			return try pass(r, used, EffectMode.DistanceRows, gl.GL_R32F, def (e CanvasProgram) {
				bindUnit(e, "uA", 0, cols.texture)
				gl.glUniform4f(e.at("uF"), edge, float32(0), float32(0), float32(0))
			})
		}

		// blurWhere on the target's region: premultiplied linear light,
		// blurred, written back (as far as `within` covers, when given).
		internal def colourBlur(r EffectRegion, used PlaneTex[], t Target, radii int[], within ?PlaneTex) !none {
			let lin = try pass(r, used, EffectMode.Linear, gl.GL_RGBA32F, def (e CanvasProgram) {
				bindImage(e, t.texture, r)
				bindUnit(e, "uLinear", 4, linearTable)
			})
			let blurred = try blurPlane(r, used, lin, radii)
			let e = try useEffects(EffectMode.Store)
			// The region's pixels before, then the store over them.
			gl.glActiveTexture(gl.GL_TEXTURE6)
			dst.ensure(r.w, r.h)
			gl.glBindFramebuffer(gl.GL_READ_FRAMEBUFFER, t.fbo)
			gl.glCopyTexSubImage2D(gl.GL_TEXTURE_2D, 0, 0, 0, r.x, r.y, r.w, r.h)
			gl.glActiveTexture(gl.GL_TEXTURE0)
			gl.glUniform1i(e.at("uOld"), 6)
			bindUnit(e, "uA", 0, blurred.texture)
			bindUnit(e, "uSrgb", 5, srgbTable)
			gl.glUniform2i(e.at("uOrigin"), r.x, r.y)
			if within is PlaneTex {
				bindUnit(e, "uB", 1, within.texture)
				gl.glUniform4i(e.at("uI"), 1, 0, 0, 0)
			} else {
				gl.glUniform4i(e.at("uI"), 0, 0, 0, 0)
			}
			gl.glBindFramebuffer(gl.GL_FRAMEBUFFER, t.fbo)
			gl.glViewport(0, 0, width, height)
			gl.glEnable(gl.GL_SCISSOR_TEST)
			gl.glScissor(r.x, r.y, r.w, r.h)
			gl.glDrawArrays(gl.GL_TRIANGLES, 0, 3)
			gl.glDisable(gl.GL_SCISSOR_TEST)
			wrote(t, r.x, r.y, r.w, r.h)
			clearEffectUnits()
		}

		// paintAtop over the current target's region.
		internal def atop(r EffectRegion, plane PlaneTex, c RGBA, mode BlendMode) !none {
			let p = try program(none)
			try composite(p, r.x, r.y, r.w, r.h, def () {
				uniforms.int(cPaintKind, 0)
				uniforms.uint(cSolid, uint32(c.r))
				uniforms.uint(cSolid + 4, uint32(c.g))
				uniforms.uint(cSolid + 8, uint32(c.b))
				uniforms.uint(cSolidA, uint32(c.a))
				bindPlane(plane.texture)
				uniforms.int(cBlend, int(mode))
				uniforms.int(cOp, 4)
			})
		}

		// applyMatrix over target `t`'s region (as far as `within` covers, when
		// given).
		internal def colorMatrix(r EffectRegion, t Target, m float[], within ?PlaneTex) !none {
			let p = try program(none)
			try compositeInto(t, p, r.x, r.y, r.w, r.h, def () {
				for let j = 0; j < 5; j++ {
					let at = cMatrix + j * 16
					uniforms.float(at, float32(m[j]))
					uniforms.float(at + 4, float32(m[5 + j]))
					uniforms.float(at + 8, float32(m[10 + j]))
					uniforms.float(at + 12, float32(m[15 + j]))
				}
				if within is PlaneTex {
					bindPlane(within.texture)
					uniforms.int(cCoverageFromPlane, 1)
				}
				uniforms.int(cOp, 5)
			})
		}

		internal def bindPlane(texture uint32) {
			gl.glActiveTexture(gl.GL_TEXTURE7)
			gl.glBindTexture(gl.GL_TEXTURE_2D, texture)
			gl.glActiveTexture(gl.GL_TEXTURE0)
		}

		// The effects program, in use for a pass in `mode` with the units its
		// samplers read (0 to 6) emptied: a pass draws into planes, image levels
		// and the target, which an earlier pass or paint may have left bound
		// there, and a draw into a texture an active sampler's unit holds is an
		// error on WebGL 2 whether or not the pass reads it (undefined on the
		// desktop).
		internal def useEffects(mode EffectMode) !CanvasProgram {
			let e = try effectsProgram()
			useProgram(e.id)
			clearEffectUnits()
			gl.glUniform1i(e.at("uMode"), int(mode))
			return e
		}

		// Unbinds the effects program's units after its draw, so that what it
		// read is not left where the canvas program's samplers look.
		internal def clearEffectUnits() {
			for let unit = 0; unit < 7; unit++ {
				gl.glActiveTexture(gl.GL_TEXTURE0 + uint32(unit))
				gl.glBindTexture(gl.GL_TEXTURE_2D, 0)
			}
			gl.glActiveTexture(gl.GL_TEXTURE0)
		}

		internal def bindUnit(e CanvasProgram, name string, unit int, texture uint32) {
			gl.glActiveTexture(gl.GL_TEXTURE0 + uint32(unit))
			gl.glBindTexture(gl.GL_TEXTURE_2D, texture)
			gl.glUniform1i(e.at(name), unit)
			gl.glActiveTexture(gl.GL_TEXTURE0)
		}

		internal def bindImage(e CanvasProgram, texture uint32, r EffectRegion) {
			bindUnit(e, "uImage", 3, texture)
			gl.glUniform2i(e.at("uOrigin"), r.x, r.y)
		}

		// A float plane of w x h, from the pool when one fits.
		internal def planeOf(w int, h int, format uint32) !PlaneTex {
			for let (i, t) in planePool {
				if t.w == w && t.h == h && t.format == format {
					let last = planePool.len() - 1
					planePool[i] = planePool[last]
					planePool.len(last)
					return t
				}
			}
			let ids uint32[]
			ids.len(1)
			gl.glGenTextures(1, ids)
			gl.glBindTexture(gl.GL_TEXTURE_2D, ids[0])
			gl.glTexParameteri(gl.GL_TEXTURE_2D, gl.GL_TEXTURE_MIN_FILTER, int(gl.GL_NEAREST))
			gl.glTexParameteri(gl.GL_TEXTURE_2D, gl.GL_TEXTURE_MAG_FILTER, int(gl.GL_NEAREST))
			let pixel = format == gl.GL_R32F ?? (gl.GL_RED, gl.GL_RGBA)
			gl.glTexImage2D(gl.GL_TEXTURE_2D, 0, int(format), w, h, 0, pixel, gl.GL_FLOAT, byte[])
			let fbos uint32[]
			fbos.len(1)
			gl.glGenFramebuffers(1, fbos)
			gl.glBindFramebuffer(gl.GL_FRAMEBUFFER, fbos[0])
			gl.glFramebufferTexture2D(gl.GL_FRAMEBUFFER, gl.GL_COLOR_ATTACHMENT0, gl.GL_TEXTURE_2D, ids[0], 0)
			let status = gl.glCheckFramebufferStatus(gl.GL_FRAMEBUFFER)
			gl.glBindFramebuffer(gl.GL_FRAMEBUFFER, 0)
			fail "the GPU canvas could not make a {w}x{h} float plane (status {status})" when status != gl.GL_FRAMEBUFFER_COMPLETE
			return PlaneTex{texture: ids[0], fbo: fbos[0], w: w, h: h, format: format}
		}

		// The colour tables colour blurs read and write through.
		internal def ensureTables(frame GpuFrame) !none {
			return none when linearTable != 0
			let ids uint32[]
			ids.len(2)
			gl.glGenTextures(2, ids)
			gl.glPixelStorei(gl.GL_UNPACK_ALIGNMENT, 1)
			gl.glPixelStorei(gl.GL_UNPACK_ROW_LENGTH, 0)
			gl.glBindTexture(gl.GL_TEXTURE_2D, ids[0])
			gl.glTexParameteri(gl.GL_TEXTURE_2D, gl.GL_TEXTURE_MIN_FILTER, int(gl.GL_NEAREST))
			gl.glTexParameteri(gl.GL_TEXTURE_2D, gl.GL_TEXTURE_MAG_FILTER, int(gl.GL_NEAREST))
			gl.glTexImage2D(gl.GL_TEXTURE_2D, 0, int(gl.GL_R32F), 256, 1, 0, gl.GL_RED, gl.GL_FLOAT, float32Bytes(frame.srgbToLinear()))
			gl.glBindTexture(gl.GL_TEXTURE_2D, ids[1])
			gl.glTexParameteri(gl.GL_TEXTURE_2D, gl.GL_TEXTURE_MIN_FILTER, int(gl.GL_NEAREST))
			gl.glTexParameteri(gl.GL_TEXTURE_2D, gl.GL_TEXTURE_MAG_FILTER, int(gl.GL_NEAREST))
			gl.glTexImage2D(gl.GL_TEXTURE_2D, 0, int(gl.GL_R8), 4096, 1, 0, gl.GL_RED, gl.GL_UNSIGNED_BYTE, frame.linearToSrgb())
			linearTable = ids[0]
			srgbTable = ids[1]
			return none
		}

		// The effects program, built on first use.
		internal def effectsProgram() !CanvasProgram {
			if programs.hasKey("#effects") {
				return programs["#effects"]
			}
			let id = try buildProgram(shaderText(string(canvasVertexSource)), shaderText(string(effectsFragmentSource)), "the GPU canvas effects")
			let p = new CanvasProgram(id)
			// Each sampler on its own unit (see assignSamplerUnits).
			useProgram(id)
			gl.glUniform1i(p.at("uA"), 0)
			gl.glUniform1i(p.at("uB"), 1)
			gl.glUniform1i(p.at("uC"), 2)
			gl.glUniform1i(p.at("uImage"), 3)
			gl.glUniform1i(p.at("uLinear"), 4)
			gl.glUniform1i(p.at("uSrgb"), 5)
			gl.glUniform1i(p.at("uOld"), 6)
			programs = programs.set("#effects", p)
			return p
		}

		// The canvas program, with the fragment's paint compiled in when
		// given; built on first use.
		internal def program(frag ?GpuFragment) !CanvasProgram {
			let key = ""
			if !(frag is none) {
				key = frag.shader.name
			}
			let held = programs.get(key)
			return held unless held is none
			let fragSource = ""
			if !(frag is none) {
				fragSource = "#define ADM_FRAGMENT\n" + frag.shader.glsl + "\n#define ADM_ENTRY " + frag.shader.entry + "\n"
			}
			if targetRead < 0 {
				let off = Runtime.getEnv("ADM_GL_TARGET_READ")
				let refused = !(off is none) && off == "0"
				targetRead = refused || gl.adm_gl_texture_barrier_ready() == 0 ?? (0, 1)
			}
			if targetRead == 1 {
				fragSource = "#define ADM_TARGET_READ\n" + fragSource
			}
			let id = try buildProgram(shaderText(string(canvasVertexSource)), shaderText(fragSource + string(canvasFragmentSource)), key == "" ?? ("the GPU canvas", "the @fragment function {key}"))
			let p = new CanvasProgram(id)
			p.readsTarget = targetRead == 1
			assignSamplerUnits(p)
			inUse = id
			programs = programs.set(key, p)
			return p
		}
	}

	// Finds the program's uniform words, and puts each sampler of the canvas
	// program on its unit for good. A sampler
	// left unset reads unit 0, which uDst holds, and a draw whose samplers of
	// different types (float, unsigned, signed) share a unit is an error:
	// WebGL 2 refuses it. So the integer samplers also get units of their
	// own, 11 and 12, which no float texture is ever bound to.
	internal def assignSamplerUnits(p CanvasProgram) {
		gl.glUseProgram(p.id)
		p.words = p.at("uWords")
		gl.glUniform1i(p.at("uDst"), 0)
		gl.glUniform1i(p.at("uCoverage"), 1)
		gl.glUniform1i(p.at("uClip"), 2)
		gl.glUniform1i(p.at("uPixels"), 3)
		gl.glUniform1i(p.at("uBlueNoise"), 5)
		gl.glUniform1i(p.at("uPlane"), 7)
		gl.glUniform1i(p.at("uImage"), 8)
		gl.glUniform1i(p.at("uToLinear"), 9)
		gl.glUniform1i(p.at("uToSrgb"), 10)
		gl.glUniform1i(p.at("uTable"), 11)
		gl.glUniform1i(p.at("uPerm"), 12)
		gl.glUniform1i(p.at("uEdges"), 13)
	}

	// One bit for each kind of operation the frame does, as the GL calls
	// drawing it differ: a draw's paint and how its coverage comes, as a
	// layer or not; a blit, copying or not; a plain group; each effect kind;
	// a backdrop blur or matrix op.
	internal def frameKinds(frame GpuFrame) int {
		let bits = 0
		for let (_, op) in frame.ops {
			match op {
				case GpuDraw:
					let paint = op.paint
					let kind = paint is GpuSolid ?? (0, paint is GpuPixels ?? (1, paint is GpuFragment ?? (2, paint is GpuGradient ?? (3, paint is GpuNoise ?? (4, 5)))))
					let cover = op.edges.len() > 0 ?? (3, op.quad.len() == 8 ?? (2, op.coverage.len() > 0 ?? (1, 0)))
					bits = bits | (1 << (kind + 6 * cover + (op.layer ?? (24, 0))))
				case GpuBlit:
					bits = bits | (1 << (op.copy ?? (49, 48)))
				case GpuEndGroup:
					bits = bits | (1 << 50)
					for let (_, e) in op.effects {
						bits = bits | (1 << (51 + int(e.kind)))
					}
				case GpuBackdropBlur:
					bits = bits | (1 << 60)
				case GpuBackdropMatrix:
					bits = bits | (1 << 62)
				case GpuMove:
					bits = bits | (1 << 61)
				default:
			}
		}
		return bits
	}

	// The layout of a path's edges texture (DrawStore.addEdges, canvas.frag).
	internal const edgeRow = 1024
	internal const edgeBandRows = 16

	// The first and last band of a box `h` rows high from row `y0` that the
	// edge at `i` crosses; first > last when none.
	internal def edgeBands(e float[], i int, y0 int, h int) (int, int) {
		let ya = e[i + 1].min(e[i + 3]) - float(y0)
		let yb = e[i + 1].max(e[i + 3]) - float(y0)
		return (1, 0) when yb <= 0.0 || ya >= float(h) || ya == yb
		return (int(ya.max(0.0)) / edgeBandRows, (int(yb.ceil()).min(h) - 1) / edgeBandRows)
	}

	// Whether the canvas blends the mode channel by channel.
	internal def perChannelMode(mode BlendMode) bool {
		return !(mode := BlendMode.Normal || BlendMode.DarkerColor || BlendMode.LighterColor || BlendMode.Hue || BlendMode.Saturation || BlendMode.Color || BlendMode.Luminosity)
	}

	// Compiles and links a vertex and fragment shader pair; `what` names it
	// in the error.
	internal def buildProgram(vsrc string, fsrc string, what string) !uint32 {
		let vs = try compileShader(gl.GL_VERTEX_SHADER, vsrc, what)
		let fs = try compileShader(gl.GL_FRAGMENT_SHADER, fsrc, what)
		let prog = gl.glCreateProgram()
		gl.glAttachShader(prog, vs)
		gl.glAttachShader(prog, fs)
		gl.glLinkProgram(prog)
		gl.glDeleteShader(vs)
		gl.glDeleteShader(fs)
		let ok int32[]
		ok.len(1)
		gl.glGetProgramiv(prog, gl.GL_LINK_STATUS, ok)
		if ok[0] == 0 {
			let log = programLog(prog)
			gl.glDeleteProgram(prog)
			fail "{what}: shaders did not link: {log}"
		}
		return prog
	}

	internal def compileShader(kind uint32, src string, what string) !uint32 {
		let s = gl.glCreateShader(kind)
		gl.glShaderSource(s, 1, string[src], int[src.len()])
		gl.glCompileShader(s)
		let ok int32[]
		ok.len(1)
		gl.glGetShaderiv(s, gl.GL_COMPILE_STATUS, ok)
		if ok[0] == 0 {
			let n int32[]
			n.len(1)
			gl.glGetShaderiv(s, gl.GL_INFO_LOG_LENGTH, n)
			let log byte[]
			log.len(int(n[0]).max(1))
			let got int32[]
			got.len(1)
			gl.glGetShaderInfoLog(s, log.len(), got, log)
			gl.glDeleteShader(s)
			let stage = kind == gl.GL_VERTEX_SHADER ?? ("vertex", "fragment")
			fail "{what}: the {stage} shader did not compile: {string(log[0:int(got[0])])}"
		}
		return s
	}

	internal def programLog(prog uint32) string {
		let n int32[]
		n.len(1)
		gl.glGetProgramiv(prog, gl.GL_INFO_LOG_LENGTH, n)
		let log byte[]
		log.len(int(n[0]).max(1))
		let got int32[]
		got.len(1)
		gl.glGetProgramInfoLog(prog, log.len(), got, log)
		return string(log[0:int(got[0])])
	}

	// The values as little-endian bytes, for an upload.
	internal def float32Bytes(v float32[]) byte[] {
		let out byte[]
		out.len(v.len() * 4)
		for let (i, x) in v {
			let u = __bitcast_u32_from_f32(x)
			out[i * 4] = byte(u & 255)
			out[i * 4 + 1] = byte((u >> 8) & 255)
			out[i * 4 + 2] = byte((u >> 16) & 255)
			out[i * 4 + 3] = byte(u >> 24)
		}
		return out
	}
}
