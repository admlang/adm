partial module std.ui.renderer.opengl {
	use (
		std.testing
		std.gfx.canvas::(Composite, DrawContext, GpuDraw, GpuFrame, GpuSolid, linear)
		std.gfx.color::(BlendMode, Color, RGBA)
		std.math.geom::(FillRule, Path, Point, Rect, Size, StrokeStyle)
		std.units::Pixels
		std.ui.renderer.opengl.gl
		std.ui.renderer.scenes
	)

	check "GPU canvas" {
		// The scene lowered and drawn by the GPU, against the frame drawn on
		// the CPU: no channel more than one level off. The number of
		// channels that differ at all is printed. On the web the GPU canvas
		// computes in float, and a steep blend (ColorBurn's division,
		// HardMix's threshold) can turn a one-level difference of what it
		// blends into more: there a thousandth of the channels may be further
		// off.
		def allowed(channels int) int {
			return __os__ == "wasm" ?? (channels / 1000, 0)
		}

		def matches(r FrameRenderer, s scenes.Scene) bool {
			let ctx = new DrawContext(new Size(float(s.w), float(s.h)))
			s.draw(ctx)
			let frame = ctx.lower()
			let want = frame.render().pixels
			r.draw(frame) onerror (err error) {
				println("GPU canvas ", s.name, ": ", err.message)
				return false
			}
			let got = r.read()
			return false when got.len() != want.len()
			let (off, far) = scenes.compare(got, want, 1)
			println("GPU canvas ", s.name, ": ", off, " of ", want.len(), " channels differ, ", far, " by more than one")
			scenes.printFar(got, want, s.w, 1, 6) when far > 0
			return far <= allowed(want.len())
		}

		// Every scene the GPU canvases share (std.ui.renderer.scenes): paints,
		// operators, blend modes, images, a @fragment paint, effects, groups
		// and blits.
		@test()
		def drawsWhatTheCanvasDraws() {
			let win = testGLContext()
			if win == 0 {
				println("GPU canvas: no display, skipped")
				return
			}
			let r = new FrameRenderer()
			let failed = 0
			for let (_, s) in scenes.parityScenes() {
				failed++ unless matches(r, s)
			}
			closeTestGLContext(win)
			assert failed == 0
		}

		// Frames drawn one over the last: a part of a UI window (its box filled
		// with the window's colour with `Copy`, then what lies there, cut off at
		// it), twelve such parts one after another at device scale 1.25 as a
		// moving progress bar draws, and a box of the last frame moved over
		// itself before a strip is drawn. Each ends as every frame applied to a
		// canvas does.
		@test()
		def drawsPartsOverTheLastFrame() {
			let win = testGLContext()
			if win == 0 {
				println("GPU canvas: no display, skipped")
				return
			}
			let r = new FrameRenderer()
			let failed = 0
			for let (_, s) in scenes.paritySequences() {
				let want = scenes.expected(s)
				for let (i, f) in s.frames {
					r.draw(f.lower(), i > 0) onerror (err error) {
						println("GPU canvas ", s.name, ": ", err.message)
						recover none
					}
				}
				let got = r.read()
				let (_, far) = scenes.compare(got, want.pixels, 1)
				println("GPU canvas ", s.name, ": ", far, " channels off by more than one")
				scenes.printFar(got, want.pixels, s.w, 1, 8) when far > 0
				failed++ unless got.len() == want.pixels.len() && far <= allowed(want.pixels.len())
			}
			closeTestGLContext(win)
			assert failed == 0
		}

		// A video frame under a transform: converted and sampled on the GPU,
		// against the frame drawn on the CPU. The two convert Y'CbCr
		// separately (floats in the shader, integers in `video.toImage`), so
		// channels may be a few levels apart; a picture upside down or with
		// its chroma swapped is far off.
		// A live raster changed in parts between frames: only the marked rectangles
		// are uploaded, and every frame still shows what the CPU canvas does.
		@test()
		def drawsLiveRastersByTheirMarks() {
			let win = testGLContext()
			if win == 0 {
				println("GPU canvas: no display, skipped")
				return
			}
			let r = new FrameRenderer()
			let failed = scenes.liveRasterRuns("GPU canvas", (ctx DrawContext) => {
				try r.draw(ctx.lower())
				return r.read()
			})
			closeTestGLContext(win)
			assert failed == 0
		}

		@test()
		def drawsVideoThroughTheCanvas() {
			let win = testGLContext()
			if win == 0 {
				println("GPU canvas: no display, skipped")
				return
			}
			let picture = scenes.videoFrame()
			let r = new FrameRenderer()
			let failed = 0
			for let turn = 0; turn < 2; turn++ {
				let ctx = new DrawContext(new Size(64.0, 48.0))
				// The second turn shows it shrunk past half: halved levels.
				scenes.videoScene(ctx, picture, turn == 1)
				let frame = ctx.lower()
				let want = frame.render().pixels
				r.draw(frame) onerror (err error) {
					println("GPU canvas video: ", err.message)
					failed++
					continue
				}
				let got = r.read()
				let (_, far) = scenes.compare(got, want, 4)
				println("GPU canvas video turn ", turn, ": ", far, " channels more than four levels off")
				scenes.printFar(got, want, 64, 4, 6) when far > 0
				failed++ unless got.len() == want.len() && far == 0
			}
			r.dispose()
			closeTestGLContext(win)
			assert failed == 0
		}

		// A run of draws stages what fits storeBudget: the draw past it starts
		// the next run, and a draw alone is staged whatever it takes.
		@test()
		def stagesRunsWithinTheBudget() {
			let win = testGLContext()
			if win == 0 {
				println("GPU canvas: no display, skipped")
				return
			}
			let half = storeBudget / 2 + 1
			let cover byte[]
			cover.len(half)
			let d = GpuDraw{x: 0, y: 0, w: half, h: 1, coverage: cover, clip: byte[], paint: GpuSolid{r: 0, g: 0, b: 0}, alpha: 255, composite: Composite.SourceOver, blend: BlendMode.Normal}
			let store = new DrawStore()
			assert store.add(d)
			assert !store.add(d)
			assert store.coverageAt.len() == 1 && store.bytes.len() == half
			store.reset()
			assert store.add(d) && store.coverageAt[0] == 0
			store.dispose()
			closeTestGLContext(win)
		}

		// Rows drawn side by side over a fill wait for one texture barrier
		// together: a draw waits only for a draw since the last barrier whose
		// box meets its own, not for one in the same tile of the target. The
		// rows are 4 pixels high, 6 apart.
		@test()
		def drawsSideBySideShareABarrier() {
			let win = testGLContext()
			if win == 0 {
				println("GPU canvas: no display, skipped")
				return
			}
			let ctx = new DrawContext(new Size(200.0, 200.0))
			ctx.fill(Rect{left: 10.0, top: 10.0, right: 190.0, bottom: 190.0}, rgba(200, 200, 200, 255))
			for let row = 0; row < 20; row++ {
				let top = 20.0 + float(row) * 6.0
				ctx.fill(Rect{left: 20.0, top: top, right: 120.0, bottom: top + 4.0}, rgba(40, 44, 52, 200))
			}
			let frame = ctx.lower()
			let want = frame.render().pixels
			let r = new FrameRenderer()
			let before = r.epoch
			r.draw(frame) onerror (err error) {
				println("GPU canvas rows: ", err.message)
				recover none
			}
			let got = r.read()
			let (_, far) = scenes.compare(got, want, 1)
			// One barrier before the fill (over the cleared target), one before
			// the first row.
			let barriers = r.epoch - before
			println("GPU canvas rows: ", barriers, " barriers, ", far, " channels off by more than one")
			r.dispose()
			closeTestGLContext(win)
			assert got.len() == want.len() && far == 0
			assert r.targetRead != 1 || barriers == 2
		}

		// A path draw's region (DrawStore.addRegion) holds every pixel the draw
		// changes: the shape drawn on the CPU over a background, against the
		// background alone, for outlines (sharp, thick, round, a circle), holes
		// left by either rule, a T outline, a dashed rule and a fill.
		@test()
		def regionsHoldWhatDrawsChange() {
			let shapes = [
				(c DrawContext) => c.stroke(new Path().rect(Rect{left: 20.0, top: 20.0, right: 180.0, bottom: 140.0}), rgba(20, 30, 40, 255), StrokeStyle{width: 1(px)}),
				(c DrawContext) => c.stroke(new Path().rect(Rect{left: 20.5, top: 20.25, right: 180.0, bottom: 140.0}), rgba(20, 30, 40, 255), StrokeStyle{width: 3(px)}),
				(c DrawContext) => c.stroke(new Path().roundRect(Rect{left: 20.0, top: 20.0, right: 180.0, bottom: 140.0}, 12(px)), rgba(20, 30, 40, 255), StrokeStyle{width: 1(px)}),
				(c DrawContext) => c.stroke(new Path().circle(new Point(100.0, 80.0), 60.0), rgba(20, 30, 40, 255), StrokeStyle{width: 2(px)}),
				(c DrawContext) => c.fill(new Path().rect(Rect{left: 20.0, top: 20.0, right: 180.0, bottom: 140.0}).rect(Rect{left: 50.0, top: 50.0, right: 150.0, bottom: 110.0}), rgba(20, 30, 40, 255), FillRule.EvenOdd),
				(c DrawContext) => c.fill(new Path().moveTo(100.0, 10.0).lineTo(140.0, 150.0).lineTo(20.0, 60.0).lineTo(180.0, 60.0).lineTo(60.0, 150.0).close(), rgba(20, 30, 40, 255), FillRule.EvenOdd),
				(c DrawContext) => c.fill(new Path().moveTo(100.0, 10.0).lineTo(140.0, 150.0).lineTo(20.0, 60.0).lineTo(180.0, 60.0).lineTo(60.0, 150.0).close(), rgba(20, 30, 40, 255)),
				(c DrawContext) => c.stroke(new Path().moveTo(20.0, 20.0).lineTo(180.0, 20.0).lineTo(180.0, 50.0).lineTo(120.0, 50.0).lineTo(120.0, 150.0).lineTo(80.0, 150.0).lineTo(80.0, 50.0).lineTo(20.0, 50.0).close(), rgba(20, 30, 40, 255), StrokeStyle{width: 1(px)}),
				(c DrawContext) => c.stroke(new Path().moveTo(20.0, 80.5).lineTo(180.0, 80.5), rgba(20, 30, 40, 160), StrokeStyle{width: 1(px), dash: [4(px), 3(px)]}),
				(c DrawContext) => c.fill(new Path().roundRect(Rect{left: 20.0, top: 20.0, right: 180.0, bottom: 140.0}, 12(px)), rgba(20, 30, 40, 255)),
			]
			let failed = 0
			for let (n, shape) in shapes {
				let base = new DrawContext(new Size(200.0, 160.0))
				base.fill(Rect{left: 0.0, top: 0.0, right: 200.0, bottom: 160.0}, rgba(250, 250, 248, 255))
				let before = base.lower().render().pixels
				let ctx = new DrawContext(new Size(200.0, 160.0))
				ctx.fill(Rect{left: 0.0, top: 0.0, right: 200.0, bottom: 160.0}, rgba(250, 250, 248, 255))
				shape(ctx)
				let frame = ctx.lower()
				let after = frame.render().pixels
				let st = new DrawStore()
				let holes = 0
				for let (_, op) in frame.ops {
					continue unless op is GpuDraw
					continue when op.edges.len() == 0
					st.add(op)
					let k = st.regionAt.len() - 1
					let at = st.regionAt[k]
					holes++ when at >= 0
					for let y = 0; y < 160; y++ {
						for let x = 0; x < 200; x++ {
							let i = (y * 200 + x) * 4
							continue when after[i] == before[i] && after[i + 1] == before[i + 1] && after[i + 2] == before[i + 2] && after[i + 3] == before[i + 3]
							let inside = at < 0 && x >= op.x && x < op.x + op.w && y >= op.y && y < op.y + op.h
							for let r = 0; r < st.regionN[k] && !inside; r++ {
								let o = at + r * 4
								inside = x >= st.regions[o] && x < st.regions[o + 2] && y >= st.regions[o + 1] && y < st.regions[o + 3]
							}
							if !inside {
								println("region of shape {n} leaves out changed pixel {x},{y}")
								failed++
							}
						}
					}
				}
				println("shape {n}: {holes} draws with a hole")
			}
			assert failed == 0
		}

		struct Bench {
			win      uint           = 0
			renderer ?FrameRenderer = none
			frame    ?GpuFrame      = none
		}

		let bench = Bench{}

		def rgba(r int, g int, b int, a int) Color {
			return new Color(RGBA{r: byte(r), g: byte(g), b: byte(b), a: byte(a)})
		}

		// A window of forty cards at 1200 x 800, a thousand draws: each card a
		// rounded sheet with a gradient, its outline, a dashed rule and twenty
		// small boxes as rows of text.
		def cardFrame() GpuFrame {
			let ctx = new DrawContext(new Size(1200.0, 800.0))
			ctx.fill(Rect{left: 0.0, top: 0.0, right: 1200.0, bottom: 800.0}, rgba(250, 250, 248, 255))
			for let card = 0; card < 40; card++ {
				let (x, y) = (float(card % 8) * 148.0 + 8.0, float(card / 8) * 158.0 + 8.0)
				let sheet = new Path().roundRect(Rect{left: x, top: y, right: x + 140.0, bottom: y + 150.0}, 8(px))
				ctx.fill(sheet, linear(new Point(x, y), new Point(x, y + 150.0), [rgba(255, 255, 255, 255), rgba(236, 238, 242, 255)]))
				ctx.stroke(sheet, rgba(180, 184, 190, 255), StrokeStyle{width: 1(px)})
				ctx.stroke(new Path().moveTo(x + 8.0, y + 30.0).lineTo(x + 132.0, y + 30.0), rgba(120, 124, 130, 160), StrokeStyle{width: 1(px), dash: [4(px), 3(px)]})
				for let row = 0; row < 20; row++ {
					let w = float(40 + (card * 7 + row * 13) % 80)
					ctx.fill(Rect{left: x + 8.0, top: y + 36.0 + float(row) * 5.5, right: x + 8.0 + w, bottom: y + 40.0 + float(row) * 5.5}, rgba(40, 44, 52, 200))
				}
			}
			return ctx.lower()
		}

		// One frame of it drawn by the GPU, waited for.
		@benchmark()
		def DrawThousandOps() {
			if bench.win == 0 {
				bench.win = testGLContext()
				return when bench.win == 0
				bench.renderer = new FrameRenderer()
				bench.frame = cardFrame()
			}
			let r = bench.renderer
			let f = bench.frame
			return when r is none || f is none
			r.draw(f) onerror recover none
			gl.glFinish()
		}
	}
}
