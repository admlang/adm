partial module std.ui.renderer.opengl {
	use (
		std.testing
		std.gfx.canvas::(DrawContext, GpuFrame)
		std.math.geom::Size
		std.ui.renderer.scenes
	)

	check "GPU canvas" {
		// The scene lowered and drawn by the GPU, against the frame drawn on
		// the CPU: no channel more than one level off. The number of
		// channels that differ at all is printed. On the web the GPU canvas
		// computes in float, and a steep blend (ColorBurn's division,
		// HardMix's threshold) can turn a one-level difference of what it
		// blends into more: there a thousandth of the channels may be further
		// off.
		def allowed(channels int) int {
			return __os__ == "wasm" ?? (channels / 1000, 0)
		}

		def matches(r FrameRenderer, s scenes.Scene) bool {
			let ctx = new DrawContext(new Size(float(s.w), float(s.h)))
			s.draw(ctx)
			let frame = ctx.lower()
			let want = frame.render().pixels
			r.draw(frame) onerror (err error) {
				println("GPU canvas ", s.name, ": ", err.message)
				return false
			}
			let got = r.read()
			return false when got.len() != want.len()
			let (off, far) = scenes.compare(got, want, 1)
			println("GPU canvas ", s.name, ": ", off, " of ", want.len(), " channels differ, ", far, " by more than one")
			scenes.printFar(got, want, s.w, 1, 6) when far > 0
			return far <= allowed(want.len())
		}

		// Every scene the GPU canvases share (std.ui.renderer.scenes): paints,
		// operators, blend modes, images, a @fragment paint, effects, groups
		// and blits.
		@test()
		def drawsWhatTheCanvasDraws() {
			let win = testGLContext()
			if win == 0 {
				println("GPU canvas: no display, skipped")
				return
			}
			let r = new FrameRenderer()
			let failed = 0
			for let (_, s) in scenes.parityScenes() {
				failed++ unless matches(r, s)
			}
			closeTestGLContext(win)
			assert failed == 0
		}

		// Frames drawn one over the last: a part of a UI window (its box filled
		// with the window's colour with `Copy`, then what lies there, cut off at
		// it), twelve such parts one after another at device scale 1.25 as a
		// moving progress bar draws, and a box of the last frame moved over
		// itself before a strip is drawn. Each ends as every frame applied to a
		// canvas does.
		@test()
		def drawsPartsOverTheLastFrame() {
			let win = testGLContext()
			if win == 0 {
				println("GPU canvas: no display, skipped")
				return
			}
			let r = new FrameRenderer()
			let failed = 0
			for let (_, s) in scenes.paritySequences() {
				let want = scenes.expected(s)
				for let (i, f) in s.frames {
					r.draw(f.lower(), i > 0) onerror (err error) {
						println("GPU canvas ", s.name, ": ", err.message)
						recover none
					}
				}
				let got = r.read()
				let (_, far) = scenes.compare(got, want.pixels, 1)
				println("GPU canvas ", s.name, ": ", far, " channels off by more than one")
				scenes.printFar(got, want.pixels, s.w, 1, 8) when far > 0
				failed++ unless got.len() == want.pixels.len() && far <= allowed(want.pixels.len())
			}
			closeTestGLContext(win)
			assert failed == 0
		}

		// A video frame under a transform: converted and sampled on the GPU,
		// against the frame drawn on the CPU. The two convert Y'CbCr
		// separately (floats in the shader, integers in `video.toImage`), so
		// channels may be a few levels apart; a picture upside down or with
		// its chroma swapped is far off.
		@test()
		def drawsVideoThroughTheCanvas() {
			let win = testGLContext()
			if win == 0 {
				println("GPU canvas: no display, skipped")
				return
			}
			let picture = scenes.videoFrame()
			let r = new FrameRenderer()
			let failed = 0
			for let turn = 0; turn < 2; turn++ {
				let ctx = new DrawContext(new Size(64.0, 48.0))
				// The second turn shows it shrunk past half: halved levels.
				scenes.videoScene(ctx, picture, turn == 1)
				let frame = ctx.lower()
				let want = frame.render().pixels
				r.draw(frame) onerror (err error) {
					println("GPU canvas video: ", err.message)
					failed++
					continue
				}
				let got = r.read()
				let (_, far) = scenes.compare(got, want, 4)
				println("GPU canvas video turn ", turn, ": ", far, " channels more than four levels off")
				scenes.printFar(got, want, 64, 4, 6) when far > 0
				failed++ unless got.len() == want.len() && far == 0
			}
			r.dispose()
			closeTestGLContext(win)
			assert failed == 0
		}
	}
}
