@link("GL")
module std.ui.renderer.opengl.gl {
	// Minimal OpenGL bindings (desktop GL). This will expand as the renderer matures.
	// These are raw extern declarations; prefer using `std.ui.renderer.opengl` wrappers.

	// Selects the colour buffer for glClear.
	const GL_COLOR_BUFFER_BIT uint32 = 0x00004000
	// Pixel format: red, green, blue, alpha.
	const GL_RGBA uint32 = 0x00001908
	// Pixel component type: one byte per component.
	const GL_UNSIGNED_BYTE uint32 = 0x00001401
	// Pixel store parameter: row alignment of pixel data read from memory.
	const GL_UNPACK_ALIGNMENT uint32 = 0x00000CF5

	// Textures
	const GL_TEXTURE_2D uint32 = 0x00000DE1
	// Texture parameter: filter used when the texture is drawn smaller.
	const GL_TEXTURE_MIN_FILTER uint32 = 0x00002801
	// Texture parameter: filter used when the texture is drawn larger.
	const GL_TEXTURE_MAG_FILTER uint32 = 0x00002800
	// Texture filter: nearest texel, no interpolation.
	const GL_NEAREST uint32 = 0x00002600
	// Texture filter: linear interpolation between texels.
	const GL_LINEAR uint32 = 0x00002601

	// Fixed-function pipeline (compat contexts).
	const GL_PROJECTION uint32 = 0x00001701
	// Matrix mode: the model-view matrix.
	const GL_MODELVIEW uint32 = 0x00001700
	// Primitive: every three vertices make a triangle.
	const GL_TRIANGLES uint32 = 0x00000004
	// Primitive: triangles sharing the first vertex.
	const GL_TRIANGLE_FAN uint32 = 0x00000006
	// Primitive: every two vertices make a line.
	const GL_LINES uint32 = 0x00000001
	// Primitive: consecutive vertices joined by lines.
	const GL_LINE_STRIP uint32 = 0x00000003
	// Primitive: a line strip closed back to the first vertex.
	const GL_LINE_LOOP uint32 = 0x00000002
	// Primitive: one point per vertex.
	const GL_POINTS uint32 = 0x00000000
	// Component type: 32-bit float.
	const GL_FLOAT uint32 = 0x00001406

	// Client state: vertex positions come from glVertexPointer.
	const GL_VERTEX_ARRAY uint32 = 0x00008074
	// Client state: vertex colours come from glColorPointer.
	const GL_COLOR_ARRAY uint32 = 0x00008076
	// Client state: texture coordinates come from glTexCoordPointer.
	const GL_TEXTURE_COORD_ARRAY uint32 = 0x00008078

	// Capability: blend fragments with the framebuffer.
	const GL_BLEND uint32 = 0x00000BE2
	// Blend factor: the source alpha.
	const GL_SRC_ALPHA uint32 = 0x00000302
	// Blend factor: one minus the source alpha.
	const GL_ONE_MINUS_SRC_ALPHA uint32 = 0x00000303
	// Blend factor: one.
	const GL_ONE uint32 = 1
	// Blend factor: zero.
	const GL_ZERO uint32 = 0
	// Blend factor: the destination colour.
	const GL_DST_COLOR uint32 = 0x00000306
	// Blend factor: one minus the source colour.
	const GL_ONE_MINUS_SRC_COLOR uint32 = 0x00000301
	// Blend factor: the source colour.
	const GL_SRC_COLOR uint32 = 0x00000300
	// Blend factor: one minus the destination alpha.
	const GL_ONE_MINUS_DST_ALPHA uint32 = 0x00000305
	// Blend equation: source plus destination.
	const GL_FUNC_ADD uint32 = 0x00008006
	// Blend equation: source minus destination.
	const GL_FUNC_SUBTRACT uint32 = 0x0000800A
	// Blend equation: destination minus source.
	const GL_FUNC_REVERSE_SUBTRACT uint32 = 0x0000800B

	// Texture unit 0.
	const GL_TEXTURE0 uint32 = 0x000084C0
	// Texture unit 1.
	const GL_TEXTURE1 uint32 = 0x000084C1

	// Shader type: runs per vertex.
	const GL_VERTEX_SHADER uint32 = 0x00008B31
	// Shader type: runs per fragment.
	const GL_FRAGMENT_SHADER uint32 = 0x00008B30
	// Shader parameter: whether the last compile succeeded.
	const GL_COMPILE_STATUS uint32 = 0x00008B81
	// Program parameter: whether the last link succeeded.
	const GL_LINK_STATUS uint32 = 0x00008B82
	// Shader or program parameter: length of the info log.
	const GL_INFO_LOG_LENGTH uint32 = 0x00008B84

	// Framebuffer target: both read and draw.
	const GL_FRAMEBUFFER uint32 = 0x00008D40
	// Framebuffer attachment: the first colour buffer.
	const GL_COLOR_ATTACHMENT0 uint32 = 0x00008CE0
	// glCheckFramebufferStatus answer: the framebuffer can be drawn to.
	const GL_FRAMEBUFFER_COMPLETE uint32 = 0x00008CD5

	// Sets the colour glClear fills the colour buffer with.
	@c("GL/gl.h", ret = "void", params = ["GLfloat", "GLfloat", "GLfloat", "GLfloat"])
	def glClearColor(r, g, b, a float32);

	// Clears the buffers selected by mask.
	@c("GL/gl.h", ret = "void", params = ["GLbitfield"])
	def glClear(mask uint32);

	// Sets the current colour from byte components.
	@c("GL/gl.h", ret = "void", params = ["GLubyte", "GLubyte", "GLubyte", "GLubyte"])
	def glColor4ub(r, g, b, a byte);

	// Maps normalised device coordinates to the given window rectangle.
	@c("GL/gl.h", ret = "void", params = ["GLint", "GLint", "GLsizei", "GLsizei"])
	def glViewport(x, y, width, height int);

	// Sets how pixel data is laid out in memory, such as GL_UNPACK_ALIGNMENT.
	@c("GL/gl.h", ret = "void", params = ["GLenum", "GLint"])
	def glPixelStorei(pname uint32, param int);

	// Sets where glDrawPixels writes.
	@c("GL/gl.h", ret = "void", params = ["GLfloat", "GLfloat"])
	def glRasterPos2f(x, y float32);

	// Scales what glDrawPixels writes.
	@c("GL/gl.h", ret = "void", params = ["GLfloat", "GLfloat"])
	def glPixelZoom(xfactor, yfactor float32);

	// Writes a block of pixels at the raster position.
	@c("GL/gl.h", ret = "void", params = ["GLsizei", "GLsizei", "GLenum", "GLenum", "const void*"])
	def glDrawPixels(width, height int, format, pixelType uint32, data byte[]);

	// Allocates texture names.
	@c("GL/gl.h", ret = "void", params = ["GLsizei", "GLuint*"])
	def glGenTextures(n int, textures uint32[]);

	// Frees texture names and their storage.
	@c("GL/gl.h", ret = "void", params = ["GLsizei", "const GLuint*"])
	def glDeleteTextures(n int, textures uint32[]);

	// Makes the texture current on the target.
	@c("GL/gl.h", ret = "void", params = ["GLenum", "GLuint"])
	def glBindTexture(target uint32, texture uint32);

	// Sets an integer texture parameter, such as a filter.
	@c("GL/gl.h", ret = "void", params = ["GLenum", "GLenum", "GLint"])
	def glTexParameteri(target uint32, pname uint32, param int);

	// Turns a capability on.
	@c("GL/gl.h", ret = "void", params = ["GLenum"])
	def glEnable(cap uint32);

	// Turns a capability off.
	@c("GL/gl.h", ret = "void", params = ["GLenum"])
	def glDisable(cap uint32);

	// Turns a vertex array on.
	@c("GL/gl.h", ret = "void", params = ["GLenum"])
	def glEnableClientState(array uint32);

	// Turns a vertex array off.
	@c("GL/gl.h", ret = "void", params = ["GLenum"])
	def glDisableClientState(array uint32);

	// Points the vertex array at position data.
	@c("GL/gl.h", ret = "void", params = ["GLint", "GLenum", "GLsizei", "const void*"])
	def glVertexPointer(size int, typ uint32, stride int, data float32[]);

	// Points the colour array at colour data.
	@c("GL/gl.h", ret = "void", params = ["GLint", "GLenum", "GLsizei", "const void*"])
	def glColorPointer(size int, typ uint32, stride int, data byte[]);

	// Points the texture coordinate array at its data.
	@c("GL/gl.h", ret = "void", params = ["GLint", "GLenum", "GLsizei", "const void*"])
	def glTexCoordPointer(size int, typ uint32, stride int, data float32[]);

	// Draws primitives from the enabled arrays.
	@c("GL/gl.h", ret = "void", params = ["GLenum", "GLint", "GLsizei"])
	def glDrawArrays(mode uint32, first int, count int);

	// Sets the width lines are drawn with.
	@c("GL/gl.h", ret = "void", params = ["GLfloat"])
	def glLineWidth(width float32);

	// Sets the source and destination blend factors.
	@c("GL/gl.h", ret = "void", params = ["GLenum", "GLenum"])
	def glBlendFunc(sfactor uint32, dfactor uint32);

	// Sets how blended source and destination combine.
	@c("GL/gl.h", ret = "void", params = ["GLenum"])
	def glBlendEquation(mode uint32);

	// Selects the texture unit later texture calls apply to.
	@c("GL/gl.h", ret = "void", params = ["GLenum"])
	def glActiveTexture(texture uint32);

	// Creates an empty shader of the type.
	@c("GL/gl.h", ret = "GLuint", params = ["GLenum"])
	def glCreateShader(shaderType uint32) uint32;

	// Sets a shader's source strings.
	@c("GL/gl.h", ret = "void", params = ["GLuint", "GLsizei", "const char* const*", "const GLint*"])
	def glShaderSource(shader uint32, count int, strings string[], lengths int[]);

	// Compiles a shader; read GL_COMPILE_STATUS for the result.
	@c("GL/gl.h", ret = "void", params = ["GLuint"])
	def glCompileShader(shader uint32);

	// Reads an integer shader parameter.
	@c("GL/gl.h", ret = "void", params = ["GLuint", "GLenum", "GLint*"])
	def glGetShaderiv(shader uint32, pname uint32, params int32[]);

	// Reads a shader's compile log.
	@c("GL/gl.h", ret = "void", params = ["GLuint", "GLsizei", "GLsizei*", "GLchar*"])
	def glGetShaderInfoLog(shader uint32, bufSize int, length int32[], infoLog byte[]);

	// Creates an empty program.
	@c("GL/gl.h", ret = "GLuint")
	def glCreateProgram() uint32;

	// Attaches a shader to a program.
	@c("GL/gl.h", ret = "void", params = ["GLuint", "GLuint"])
	def glAttachShader(program uint32, shader uint32);

	// Links a program; read GL_LINK_STATUS for the result.
	@c("GL/gl.h", ret = "void", params = ["GLuint"])
	def glLinkProgram(program uint32);

	// Reads an integer program parameter.
	@c("GL/gl.h", ret = "void", params = ["GLuint", "GLenum", "GLint*"])
	def glGetProgramiv(program uint32, pname uint32, params int32[]);

	// Reads a program's link log.
	@c("GL/gl.h", ret = "void", params = ["GLuint", "GLsizei", "GLsizei*", "GLchar*"])
	def glGetProgramInfoLog(program uint32, bufSize int, length int32[], infoLog byte[]);

	// Makes the program current for drawing.
	@c("GL/gl.h", ret = "void", params = ["GLuint"])
	def glUseProgram(program uint32);

	// Frees a shader once no program needs it.
	@c("GL/gl.h", ret = "void", params = ["GLuint"])
	def glDeleteShader(shader uint32);

	// Frees a program.
	@c("GL/gl.h", ret = "void", params = ["GLuint"])
	def glDeleteProgram(program uint32);

	// The location of a uniform in a program, or -1.
	@c("GL/gl.h", ret = "GLint", params = ["GLuint", "const char*"])
	def glGetUniformLocation(program uint32, name string) int;

	// Sets an int uniform of the current program.
	@c("GL/gl.h", ret = "void", params = ["GLint", "GLint"])
	def glUniform1i(location int, v0 int);

	// Sets a float uniform of the current program.
	@c("GL/gl.h", ret = "void", params = ["GLint", "GLfloat"])
	def glUniform1f(location int, v0 float32);

	// Sets a two-float uniform of the current program.
	@c("GL/gl.h", ret = "void", params = ["GLint", "GLfloat", "GLfloat"])
	def glUniform2f(location int, v0 float32, v1 float32);

	// The location of a vertex attribute in a program, or -1.
	@c("GL/gl.h", ret = "GLint", params = ["GLuint", "const char*"])
	def glGetAttribLocation(program uint32, name string) int;

	// Turns a vertex attribute array on.
	@c("GL/gl.h", ret = "void", params = ["GLuint"])
	def glEnableVertexAttribArray(index int);

	// Turns a vertex attribute array off.
	@c("GL/gl.h", ret = "void", params = ["GLuint"])
	def glDisableVertexAttribArray(index int);

	// Points a vertex attribute at its data and describes the layout.
	@c("GL/gl.h", ret = "void", params = ["GLuint", "GLint", "GLenum", "GLboolean", "GLsizei", "const void*"])
	def glVertexAttribPointer(index int, size int, typ uint32, normalized bool, stride int, data float32[]);

	// Allocates framebuffer names.
	@c("GL/gl.h", ret = "void", params = ["GLsizei", "GLuint*"])
	def glGenFramebuffers(n int, ids uint32[]);

	// Makes the framebuffer current on the target; 0 restores the window's.
	@c("GL/gl.h", ret = "void", params = ["GLenum", "GLuint"])
	def glBindFramebuffer(target uint32, framebuffer uint32);

	// Attaches a texture to the current framebuffer.
	@c("GL/gl.h", ret = "void", params = ["GLenum", "GLenum", "GLenum", "GLuint", "GLint"])
	def glFramebufferTexture2D(target uint32, attachment uint32, textarget uint32, texture uint32, level int);

	// Whether the current framebuffer is complete; see GL_FRAMEBUFFER_COMPLETE.
	@c("GL/gl.h", ret = "GLenum", params = ["GLenum"])
	def glCheckFramebufferStatus(target uint32) uint32;

	// Frees framebuffer names.
	@c("GL/gl.h", ret = "void", params = ["GLsizei", "const GLuint*"])
	def glDeleteFramebuffers(n int, ids uint32[]);

	// Selects which matrix later matrix calls change.
	@c("GL/gl.h", ret = "void", params = ["GLenum"])
	def glMatrixMode(mode uint32);

	// Resets the current matrix.
	@c("GL/gl.h", ret = "void")
	def glLoadIdentity();

	// Multiplies the current matrix by an orthographic projection.
	@c("GL/gl.h", ret = "void", params = ["GLdouble", "GLdouble", "GLdouble", "GLdouble", "GLdouble", "GLdouble"])
	def glOrtho(left, right, bottom, top, zNear, zFar float64);

	// Starts immediate-mode vertices of the primitive.
	@c("GL/gl.h", ret = "void", params = ["GLenum"])
	def glBegin(mode uint32);

	// Ends the vertices started by glBegin.
	@c("GL/gl.h", ret = "void")
	def glEnd();

	// Sets the texture coordinate of the next vertex.
	@c("GL/gl.h", ret = "void", params = ["GLfloat", "GLfloat"])
	def glTexCoord2f(s, t float32);

	// Adds a vertex in immediate mode.
	@c("GL/gl.h", ret = "void", params = ["GLfloat", "GLfloat"])
	def glVertex2f(x, y float32);

	// Uploads a whole texture image.
	@c("GL/gl.h", ret = "void", params = ["GLenum", "GLint", "GLint", "GLsizei", "GLsizei", "GLint", "GLenum", "GLenum", "const void*"])
	def glTexImage2D(target uint32, level int, internalFormat int, width int, height int, border int, format uint32, pixelType uint32, data byte[]);

	// Replaces part of a texture image.
	@c("GL/gl.h", ret = "void", params = ["GLenum", "GLint", "GLint", "GLint", "GLsizei", "GLsizei", "GLenum", "GLenum", "const void*"])
	def glTexSubImage2D(target uint32, level int, xoffset int, yoffset int, width int, height int, format uint32, pixelType uint32, data byte[]);
}
