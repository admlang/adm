@os("linux", "darwin", "windows", "android", "ios")
partial module std.ui.renderer.opengl {
	use (
		std.ui.host.sdl.lib
	)

	// An OpenGL context on a hidden window for the GPU canvas suites, or 0
	// without a display.
	internal def testGLContext() uint {
		lib.bindTaskToThread()
		return 0 unless lib.SDL_Init(lib.SDL_INIT_VIDEO)
		let win = lib.SDL_CreateWindow("adm test", 64, 48, lib.SDL_WINDOW_OPENGL | lib.SDL_WINDOW_HIDDEN)
		return 0 when win == 0
		if lib.SDL_GL_CreateContext(win) == 0 {
			lib.SDL_DestroyWindow(win)
			return 0
		}
		return win
	}

	// Closes what testGLContext opened.
	internal def closeTestGLContext(win uint) {
		lib.SDL_DestroyWindow(win)
	}
}
