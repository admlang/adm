@os("wasm")
partial module std.ui.renderer.opengl {
	use (
		std.ui.host.browser::BrowserHost
		std.ui.renderer as r
	)

	// The page's window the GPU canvas suites draw in, while one is open.
	internal type TestCanvas {
		host   BrowserHost = new BrowserHost()
		window ?r.Window   = none
	}

	internal let testCanvas = new TestCanvas()

	// The WebGL 2 context of a canvas on the test page for the GPU canvas
	// suites, or 0 when the page cannot give one.
	internal def testGLContext() uint {
		let win = testCanvas.host.openWindow(new r.WindowConfig("adm test", 64, 48)) onerror (err error) {
			return 0
		}
		testCanvas.window = win
		return 0 unless testCanvas.host.makeCurrent(win.id())
		return win.id()
	}

	// Closes what testGLContext opened.
	internal def closeTestGLContext(win uint) {
		let open = testCanvas.window
		return when open is none
		testCanvas.host.closeWindow(open) onerror recover none
		testCanvas.window = none
	}
}
