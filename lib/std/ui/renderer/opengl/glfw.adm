@link("glfw")
module std.ui.renderer.opengl.glfw {
	// Minimal GLFW surface for creating an OpenGL-capable window/context.
	// This module is intentionally tiny; higher-level wrappers live in `std.ui.renderer.opengl`.

	// Common GLFW constants used for polling.
	// Values follow GLFW's public header (`GLFW/glfw3.h`).
	const GLFW_PRESS int = 1
	// Key or button state: up.
	const GLFW_RELEASE int = 0
	// Boolean true as GLFW passes it.
	const GLFW_TRUE int = 1
	// Boolean false as GLFW passes it.
	const GLFW_FALSE int = 0

	// glfwGetWindowAttrib attributes.
	const GLFW_FOCUSED int = 0x00020001
	// Window attribute: whether the cursor is over the window.
	const GLFW_HOVERED int = 0x0002000B

	// Window hints.
	const GLFW_RESIZABLE int = 0x00020003

	// Key range: [0..GLFW_KEY_LAST] (used for polling).
	const GLFW_KEY_LAST int = 348

	// Mouse button range: [0..GLFW_MOUSE_BUTTON_LAST] (used for polling).
	const GLFW_MOUSE_BUTTON_LAST int = 7

	// Initialises GLFW; returns GLFW_TRUE on success.
	@c("GLFW/glfw3.h", ret = "int")
	def glfwInit() int;

	// Shuts GLFW down and destroys every window it still holds.
	def glfwTerminate();

	// Creates a window and its context; returns 0 on failure.
	@c("GLFW/glfw3.h", ret = "GLFWwindow*", params = ["int", "int", "const char*", "GLFWmonitor*", "GLFWwindow*"])
	def glfwCreateWindow(width int, height int, title string, monitor uint, share uint) uint;

	// Resets every window hint.
	@c("GLFW/glfw3.h", ret = "void")
	def glfwDefaultWindowHints();

	// Sets a hint for the next glfwCreateWindow.
	@c("GLFW/glfw3.h", ret = "void", params = ["int", "int"])
	def glfwWindowHint(hint int, value int);

	// Destroys the window and its context.
	@c("GLFW/glfw3.h", ret = "void", params = ["GLFWwindow*"])
	def glfwDestroyWindow(window uint);

	// Routed through a runtime shim rather than straight to GLFW: the shim
	// binds the calling task to its carrier thread first. An OpenGL context
	// belongs to an OS thread, and an `async` render loop is a task that can
	// otherwise migrate off it mid-frame. See adm_gl_bind_current_task.
	@c("", symbol = "adm_glfw_make_context_current", ret = "void", params = ["GLFWwindow*"])
	def glfwMakeContextCurrent(window uint);

	// The window whose context is current on this thread, or 0.
	def glfwGetCurrentContext() uint;

	// Sets the number of vertical blanks glfwSwapBuffers waits for; 0 turns vsync off.
	@c("GLFW/glfw3.h", ret = "void", params = ["int"])
	def glfwSwapInterval(interval int);

	// Both shimmed for the same reason as glfwMakeContextCurrent, and these two
	// are the ones that matter: every render loop reaches them every frame,
	// whichever task it happens to run on.
	@c("", symbol = "adm_glfw_swap_buffers", ret = "void", params = ["GLFWwindow*"])
	def glfwSwapBuffers(window uint);

	// Processes pending events and runs the callbacks they trigger.
	@c("", symbol = "adm_glfw_poll_events", ret = "void")
	def glfwPollEvents();

	// Sets the window's title.
	@c("GLFW/glfw3.h", ret = "void", params = ["GLFWwindow*", "const char*"])
	def glfwSetWindowTitle(window uint, title string);

	// Sets the window's icon from RGBA pixels.
	@c("", symbol = "adm_glfw_set_window_icon", ret = "void", params = ["GLFWwindow*", "int", "int", "const unsigned char*"])
	def glfwSetWindowIcon(window uint, width int, height int, pixels byte[]);

	// Whether the user asked to close the window.
	@c("GLFW/glfw3.h", ret = "int", params = ["GLFWwindow*"])
	def glfwWindowShouldClose(window uint) int;

	// Reads the cursor position in window coordinates into x and y.
	@c("GLFW/glfw3.h", ret = "void", params = ["GLFWwindow*", "double*", "double*"])
	def glfwGetCursorPos(window uint, x float64[], y float64[]);

	// The state of a mouse button: GLFW_PRESS or GLFW_RELEASE.
	@c("GLFW/glfw3.h", ret = "int", params = ["GLFWwindow*", "int"])
	def glfwGetMouseButton(window uint, button int) int;

	// The state of a key: GLFW_PRESS or GLFW_RELEASE.
	@c("GLFW/glfw3.h", ret = "int", params = ["GLFWwindow*", "int"])
	def glfwGetKey(window uint, key int) int;

	// Reads the window's size in screen coordinates into width and height.
	@c("GLFW/glfw3.h", ret = "void", params = ["GLFWwindow*", "int*", "int*"])
	def glfwGetWindowSize(window uint, width int32[], height int32[]);

	// Reads the framebuffer's size in pixels into width and height.
	@c("GLFW/glfw3.h", ret = "void", params = ["GLFWwindow*", "int*", "int*"])
	def glfwGetFramebufferSize(window uint, width int32[], height int32[]);

	// Reads a window attribute, such as GLFW_FOCUSED.
	@c("GLFW/glfw3.h", ret = "int", params = ["GLFWwindow*", "int"])
	def glfwGetWindowAttrib(window uint, attrib int) int;
}
