@os("linux", "darwin", "windows", "android", "ios")
partial module std.ui.renderer.opengl {
	// A GPU canvas shader (shaders/) as the desktop's OpenGL compiles it:
	// GLSL 4.00, whose doubles give the CPU canvas's pixels.
	internal def shaderText(body string) string {
		return "#version 400 core\n" + body
	}

	// The canvas shader's `double` uniforms are doubles in its uniform block.
	internal const blockDoubles = true

	// A fragment shader written without `#version` (the video layer's, GLSL
	// 1.10) as the desktop compiles it: unchanged.
	internal def legacyFragmentText(body string) string {
		return body
	}
}
