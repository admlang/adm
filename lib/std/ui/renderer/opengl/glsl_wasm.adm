@os("wasm")
partial module std.ui.renderer.opengl {
	// What WebGL 2 needs before a GPU canvas shader: GLSL ES 3.00 has no
	// doubles, so the canvas computes in highp float there (its pixels may
	// differ from the CPU canvas's in the last bit of a blend), and no
	// `precise`, which only keeps the desktop from fusing multiply-adds.
	internal const shaderPreamble = "#version 300 es\n" +
		"precision highp float;\n" +
		"precision highp int;\n" +
		"precision highp sampler2D;\n" +
		"precision highp usampler2D;\n" +
		"precision highp isampler2D;\n" +
		"#define double float\n" +
		"#define dvec2 vec2\n" +
		"#define dvec3 vec3\n" +
		"#define dvec4 vec4\n" +
		"#define precise\n"

	// A GPU canvas shader (shaders/) as WebGL 2 compiles it: the shared
	// source after the ES preamble, its double literals (`0.5lf`) made float.
	internal def shaderText(body string) string {
		return shaderPreamble + body.replace(/(\b[0-9]+(?:\.[0-9]*)?(?:[eE][-+]?[0-9]+)?|\.[0-9]+(?:[eE][-+]?[0-9]+)?)lf\b/, "$1")
	}

	// A fragment shader written without `#version` (the video layer's, GLSL
	// 1.10), which WebGL 2 compiles as GLSL ES 1.00: that needs the precision
	// of its floats said.
	internal def legacyFragmentText(body string) string {
		return "precision highp float;\n" + body
	}
}
