partial module std.ui.renderer.opengl {
	use (
		std.formats.models::(AlphaMode, Filter, LightKind, Texture, TextureRef, Wrap)
		std.gfx.canvas::(ModelPicture)
		std.gfx.scene::(GpuMesh, GpuScene, GpuTexture, Viewpoint, modelAlive)
		std.ui.renderer.opengl.gl
	)

	@embed("shaders/model.vert")
	internal const modelVertexSource byte[]

	@embed("shaders/model.frag")
	internal const modelFragmentSource byte[]

	@embed("shaders/modelresolve.frag")
	internal const modelResolveSource byte[]

	// The most lights the model shader takes (shaders/model.frag).
	internal const modelLights = 8

	// How far towards the eye a wireframe edge is drawn, in depth units, as
	// std.gfx.scene's CPU renderer lifts it.
	internal const modelEdgeLift = 2.0e-5

	// How many frames a model's buffers, textures and pictures are kept
	// after they were last drawn.
	internal const modelKeptFrames = 600

	// One mesh's vertex and index buffers, and the stamp of the vertices
	// they hold.
	internal type ModelBuffers {
		stamp     uint64
		positions uint32
		normals   uint32
		tangents  uint32
		uv0       uint32
		uv1       uint32
		colors    uint32
		triangles uint32
		segments  uint32
		points    uint32
		edges     uint32
		// How many indices each index buffer holds.
		counts    int[]

		def new() {
			counts = int[0, 0, 0, 0]
		}

		def ids() uint32[] {
			return uint32[positions, normals, tangents, uv0, uv1, colors, triangles, segments, points, edges]
		}
	}

	// What is kept of one prepared model: its meshes' buffers by mesh id and
	// its textures in the scene's order, for one generation of it.
	internal type ModelStore {
		generation uint64
		meshes     map<uint64, ModelBuffers>
		textures   uint32[]
		sources    Texture[]
		used       int

		def new(generation uint64) {
			self.generation = generation
			meshes = map<uint64, ModelBuffers>{}
		}
	}

	// A model's picture as last drawn: the texture the canvas samples and what
	// it shows (the model by its id, so that the picture does not keep the
	// model).
	internal type ModelDrawn {
		level   ImageLevel
		model   uint64
		changes uint64
		samples int
		from    Viewpoint
		used    int

		def new(level ImageLevel, picture ModelPicture) {
			self.level = level
			keep(picture)
		}

		// Notes what the level now shows.
		def keep(picture ModelPicture) {
			model = picture.model.id()
			changes = picture.changes
			samples = picture.samples
			from = picture.from
		}

		// Whether the level shows the picture as it is asked for.
		def shows(picture ModelPicture) bool {
			return changes == picture.changes && samples == picture.samples && from.equals(picture.from)
		}
	}

	// ModelLayer draws 3D models (std.gfx.scene GpuScene) into textures the
	// GPU canvas samples as images: depth-tested triangles shaded as the CPU
	// renderer shades them, in a target `samples` times the picture's size
	// along each axis, resolved to the picture. A model's vertices and
	// textures are uploaded once and kept while it is drawn; a picture whose
	// model and viewpoint have not changed is not drawn again.
	internal type ModelLayer {
		program   uint32
		resolve   uint32
		locations map<string, int>
		stores    map<uint64, ModelStore>
		drawn     map<string, ModelDrawn>
		// The drawing target: colour texture, depth renderbuffer, framebuffer
		// and their size.
		color     uint32
		depth     uint32
		fbo       uint32
		width     int
		height    int
		// A white texel for the samplers a material leaves unused.
		white     uint32

		def new(program uint32, resolve uint32) {
			self.program = program
			self.resolve = resolve
			locations = map<string, int>{}
			stores = map<uint64, ModelStore>{}
			drawn = map<string, ModelDrawn>{}
		}

		// The location of the model program's uniform or attribute, looked up
		// once.
		def at(name string) int {
			let known = locations.get(name)
			return known unless known is none
			let found = name.startsWith("a") ?? (gl.glGetAttribLocation(program, name), gl.glGetUniformLocation(program, name))
			locations = locations.set(name, found)
			return found
		}

		// The picture's texture: the one kept when the model, the viewpoint,
		// the size and the samples are those it was drawn with, else drawn
		// now into `level()`'s texture. `frame` counts the frames drawn.
		def level(picture ModelPicture, frame int) !ImageLevel {
			let key = "{picture.model.id()} {picture.width}x{picture.height}"
			let kept = drawn.get(key)
			if !(kept is none) {
				kept.used = frame
				return kept.level when kept.shows(picture)
				try draw(picture, kept.level, frame)
				kept.keep(picture)
				return kept.level
			}
			let made = new ModelDrawn(try newTarget(picture.width, picture.height), picture)
			made.used = frame
			drawn = drawn.set(key, made)
			try draw(picture, made.level, frame)
			return made.level
		}

		// An RGBA8 texture with its framebuffer, the size of a picture.
		def newTarget(w int, h int) !ImageLevel {
			let ids uint32[]
			ids.len(1)
			gl.glGenTextures(1, ids)
			gl.glBindTexture(gl.GL_TEXTURE_2D, ids[0])
			gl.glTexParameteri(gl.GL_TEXTURE_2D, gl.GL_TEXTURE_MIN_FILTER, int(gl.GL_NEAREST))
			gl.glTexParameteri(gl.GL_TEXTURE_2D, gl.GL_TEXTURE_MAG_FILTER, int(gl.GL_NEAREST))
			gl.glTexImage2D(gl.GL_TEXTURE_2D, 0, int(gl.GL_RGBA8), w.max(1), h.max(1), 0, gl.GL_RGBA, gl.GL_UNSIGNED_BYTE, byte[])
			let fbos uint32[]
			fbos.len(1)
			gl.glGenFramebuffers(1, fbos)
			gl.glBindFramebuffer(gl.GL_FRAMEBUFFER, fbos[0])
			gl.glFramebufferTexture2D(gl.GL_FRAMEBUFFER, gl.GL_COLOR_ATTACHMENT0, gl.GL_TEXTURE_2D, ids[0], 0)
			let status = gl.glCheckFramebufferStatus(gl.GL_FRAMEBUFFER)
			gl.glBindFramebuffer(gl.GL_FRAMEBUFFER, 0)
			fail "the model layer could not make a {w}x{h} picture texture (status {status})" when status != gl.GL_FRAMEBUFFER_COMPLETE
			return ImageLevel{texture: ids[0], fbo: fbos[0], w: w, h: h}
		}

		// Makes the drawing target at least `w` by `h`.
		def reserve(w int, h int) !none {
			return none when fbo != 0 && width >= w && height >= h
			freeTarget()
			width = w.max(width)
			height = h.max(height)
			let ids uint32[]
			ids.len(1)
			gl.glGenTextures(1, ids)
			color = ids[0]
			gl.glBindTexture(gl.GL_TEXTURE_2D, color)
			gl.glTexParameteri(gl.GL_TEXTURE_2D, gl.GL_TEXTURE_MIN_FILTER, int(gl.GL_NEAREST))
			gl.glTexParameteri(gl.GL_TEXTURE_2D, gl.GL_TEXTURE_MAG_FILTER, int(gl.GL_NEAREST))
			gl.glTexImage2D(gl.GL_TEXTURE_2D, 0, int(gl.GL_RGBA8), width, height, 0, gl.GL_RGBA, gl.GL_UNSIGNED_BYTE, byte[])
			gl.glGenRenderbuffers(1, ids)
			depth = ids[0]
			gl.glBindRenderbuffer(gl.GL_RENDERBUFFER, depth)
			gl.glRenderbufferStorage(gl.GL_RENDERBUFFER, gl.GL_DEPTH_COMPONENT24, width, height)
			gl.glGenFramebuffers(1, ids)
			fbo = ids[0]
			gl.glBindFramebuffer(gl.GL_FRAMEBUFFER, fbo)
			gl.glFramebufferTexture2D(gl.GL_FRAMEBUFFER, gl.GL_COLOR_ATTACHMENT0, gl.GL_TEXTURE_2D, color, 0)
			gl.glFramebufferRenderbuffer(gl.GL_FRAMEBUFFER, gl.GL_DEPTH_ATTACHMENT, gl.GL_RENDERBUFFER, depth)
			let status = gl.glCheckFramebufferStatus(gl.GL_FRAMEBUFFER)
			gl.glBindFramebuffer(gl.GL_FRAMEBUFFER, 0)
			fail "the model layer could not make a {width}x{height} drawing target (status {status})" when status != gl.GL_FRAMEBUFFER_COMPLETE
			return none
		}

		def freeTarget() {
			return when fbo == 0
			gl.glDeleteFramebuffers(1, uint32[fbo])
			gl.glDeleteRenderbuffers(1, uint32[depth])
			gl.glDeleteTextures(1, uint32[color])
			fbo = 0
		}

		// Draws the picture into `into`: the scene into the drawing target,
		// then resolved.
		def draw(picture ModelPicture, into ImageLevel, frame int) !none {
			let samples = picture.samples.clamp(1, 4)
			let w = picture.width * samples
			let h = picture.height * samples
			let scene = picture.model.gpuScene(picture.from, w, h)
			let store = storeOf(scene, frame)
			try reserve(w, h)
			if white == 0 {
				let ids uint32[]
				ids.len(1)
				gl.glGenTextures(1, ids)
				white = ids[0]
				gl.glBindTexture(gl.GL_TEXTURE_2D, white)
				gl.glTexParameteri(gl.GL_TEXTURE_2D, gl.GL_TEXTURE_MIN_FILTER, int(gl.GL_NEAREST))
				gl.glTexParameteri(gl.GL_TEXTURE_2D, gl.GL_TEXTURE_MAG_FILTER, int(gl.GL_NEAREST))
				gl.glTexImage2D(gl.GL_TEXTURE_2D, 0, int(gl.GL_RGBA8), 1, 1, 0, gl.GL_RGBA, gl.GL_UNSIGNED_BYTE, byte[255, 255, 255, 255])
			}
			gl.glBindFramebuffer(gl.GL_FRAMEBUFFER, fbo)
			gl.glViewport(0, 0, w, h)
			gl.glDisable(gl.GL_SCISSOR_TEST)
			gl.glDisable(gl.GL_BLEND)
			gl.glEnable(gl.GL_DEPTH_TEST)
			gl.glDepthFunc(gl.GL_LESS)
			gl.glDepthMask(true)
			gl.glClearColor(0.0, 0.0, 0.0, 0.0)
			gl.glClear(gl.GL_COLOR_BUFFER_BIT | gl.GL_DEPTH_BUFFER_BIT)
			gl.glUseProgram(program)
			shareView(scene)
			// Solid meshes write depth; the blended ones are drawn after, from
			// the farthest, over what is there.
			for let (_, mesh) in scene.meshes {
				drawMesh(scene, store, mesh) unless mesh.blend
			}
			drawLines(scene)
			let blended GpuMesh[]
			for let (_, mesh) in scene.meshes {
				blended.push(mesh) when mesh.blend
			}
			if blended.len() > 0 {
				blended.sort((a GpuMesh, b GpuMesh) => a.depth > b.depth)
				gl.glEnable(gl.GL_BLEND)
				gl.glBlendFunc(gl.GL_ONE, gl.GL_ONE_MINUS_SRC_ALPHA)
				gl.glDepthMask(false)
				for let (_, mesh) in blended {
					drawMesh(scene, store, mesh)
				}
				gl.glDepthMask(true)
				gl.glDisable(gl.GL_BLEND)
			}
			gl.glDisable(gl.GL_DEPTH_TEST)
			gl.glDisable(gl.GL_CULL_FACE)
			gl.glBindBuffer(gl.GL_ARRAY_BUFFER, 0)
			gl.glBindBuffer(gl.GL_ELEMENT_ARRAY_BUFFER, 0)
			for let (_, name) in string["aPosition", "aNormal", "aTangent", "aUV0", "aUV1", "aColor"] {
				let slot = at(name)
				gl.glDisableVertexAttribArray(slot) when slot >= 0
			}
			// Resolve: one triangle over the picture.
			gl.glBindFramebuffer(gl.GL_FRAMEBUFFER, into.fbo)
			gl.glViewport(0, 0, into.w, into.h)
			gl.glUseProgram(resolve)
			gl.glActiveTexture(gl.GL_TEXTURE0)
			gl.glBindTexture(gl.GL_TEXTURE_2D, color)
			gl.glUniform1i(gl.glGetUniformLocation(resolve, "uDrawn"), 0)
			gl.glUniform1i(gl.glGetUniformLocation(resolve, "uSamples"), samples)
			gl.glDrawArrays(gl.GL_TRIANGLES, 0, 3)
			let err = gl.glGetError()
			fail "drawing a model on the GPU failed (GL error {err})" when err != 0
			return none
		}

		// The store of the scene's model, emptied when the model was prepared
		// again, with its textures uploaded.
		def storeOf(scene GpuScene, frame int) ModelStore {
			let kept = stores.get(scene.model)
			if !(kept is none) {
				if kept.generation == scene.generation {
					kept.used = frame
					return kept
				}
				free(kept)
			}
			let made = new ModelStore(scene.generation)
			made.used = frame
			for let (_, t) in scene.textures {
				made.sources.push(t.texture)
				made.textures.push(upload(t))
			}
			stores = stores.set(scene.model, made)
			return made
		}

		// A texture with its smaller levels, sampled as the model's texture
		// says: a colour texture is stored as sRGB, so the GPU reads and
		// averages it in linear light.
		def upload(t GpuTexture) uint32 {
			let ids uint32[]
			ids.len(1)
			gl.glGenTextures(1, ids)
			gl.glBindTexture(gl.GL_TEXTURE_2D, ids[0])
			gl.glPixelStorei(gl.GL_UNPACK_ALIGNMENT, 1)
			gl.glTexImage2D(gl.GL_TEXTURE_2D, 0, int(t.colour ?? (gl.GL_SRGB8_ALPHA8, gl.GL_RGBA8)), t.width, t.height, 0, gl.GL_RGBA, gl.GL_UNSIGNED_BYTE, t.pixels)
			let source = t.texture
			let mipmapped = source.minFilter != Filter.Nearest && source.minFilter != Filter.Linear
			gl.glGenerateMipmap(gl.GL_TEXTURE_2D) when mipmapped
			gl.glTexParameteri(gl.GL_TEXTURE_2D, gl.GL_TEXTURE_MIN_FILTER, int(filterOf(source.minFilter)))
			gl.glTexParameteri(gl.GL_TEXTURE_2D, gl.GL_TEXTURE_MAG_FILTER, int(source.magFilter == Filter.Nearest ?? (gl.GL_NEAREST, gl.GL_LINEAR)))
			gl.glTexParameteri(gl.GL_TEXTURE_2D, gl.GL_TEXTURE_WRAP_S, int(wrapOf(source.wrapS)))
			gl.glTexParameteri(gl.GL_TEXTURE_2D, gl.GL_TEXTURE_WRAP_T, int(wrapOf(source.wrapT)))
			return ids[0]
		}

		def filterOf(f Filter) uint32 {
			switch f {
				case Filter.Nearest:
					return gl.GL_NEAREST
				case Filter.Linear:
					return gl.GL_LINEAR
				case Filter.NearestMipmapNearest:
					return gl.GL_NEAREST_MIPMAP_NEAREST
				case Filter.LinearMipmapNearest:
					return gl.GL_LINEAR_MIPMAP_NEAREST
				case Filter.NearestMipmapLinear:
					return gl.GL_NEAREST_MIPMAP_LINEAR
				default:
					return gl.GL_LINEAR_MIPMAP_LINEAR
			}
		}

		def wrapOf(w Wrap) uint32 {
			return gl.GL_CLAMP_TO_EDGE when w == Wrap.Clamp
			return gl.GL_MIRRORED_REPEAT when w == Wrap.Mirror
			return gl.GL_REPEAT
		}

		// Sets what every mesh of the picture shares: the view and the lights.
		def shareView(scene GpuScene) {
			gl.glUniformMatrix4fv(at("uViewProjection"), 1, true, scene.viewProjection)
			gl.glUniform3f(at("uEye"), float32(scene.eye.x), float32(scene.eye.y), float32(scene.eye.z))
			gl.glUniform3f(at("uForward"), float32(scene.forward.x), float32(scene.forward.y), float32(scene.forward.z))
			gl.glUniform1i(at("uOrtho"), scene.orthographic ?? (1, 0))
			gl.glUniform1f(at("uAmbient"), float32(scene.ambient))
			let edge = scene.edgeColor
			gl.glUniform4f(at("uEdge"), float32(float(edge.red) / 255.0), float32(float(edge.green) / 255.0), float32(float(edge.blue) / 255.0), float32(float(edge.alpha) / 255.0))
			let count = scene.lights.len().min(modelLights)
			let place float32[]
			let aim float32[]
			let colour float32[]
			let cone float32[]
			for let i = 0; i < count; i++ {
				let l = scene.lights[i]
				let kind = l.kind == LightKind.Directional ?? (0.0, l.kind == LightKind.Spot ?? (2.0, 1.0))
				place.push(float32(l.position.x), float32(l.position.y), float32(l.position.z), float32(kind))
				aim.push(float32(l.direction.x), float32(l.direction.y), float32(l.direction.z), float32(l.range))
				colour.push(float32(l.r), float32(l.g), float32(l.b), float32(l.cosInner))
				cone.push(float32(l.cosOuter), float32(0), float32(0), float32(0))
			}
			gl.glUniform1i(at("uLightCount"), count)
			if count > 0 {
				gl.glUniform4fv(at("uLightPlace"), count, place)
				gl.glUniform4fv(at("uLightAim"), count, aim)
				gl.glUniform4fv(at("uLightColor"), count, colour)
				gl.glUniform4fv(at("uLightCone"), count, cone)
			}
			gl.glUniform1i(at("uBaseTex"), 0)
			gl.glUniform1i(at("uRoughTex"), 1)
			gl.glUniform1i(at("uNormalTex"), 2)
			gl.glUniform1i(at("uOcclusionTex"), 3)
			gl.glUniform1i(at("uEmissiveTex"), 4)
		}

		// A buffer holding the array, none (0) for an empty one.
		def vertexBuffer(data float32[]) uint32 {
			return 0 when data.len() == 0
			let ids uint32[]
			ids.len(1)
			gl.glGenBuffers(1, ids)
			gl.glBindBuffer(gl.GL_ARRAY_BUFFER, ids[0])
			gl.glBufferData(gl.GL_ARRAY_BUFFER, data.len() * 4, data, gl.GL_STATIC_DRAW)
			return ids[0]
		}

		def indexBuffer(data uint32[]) uint32 {
			return 0 when data.len() == 0
			let ids uint32[]
			ids.len(1)
			gl.glGenBuffers(1, ids)
			gl.glBindBuffer(gl.GL_ELEMENT_ARRAY_BUFFER, ids[0])
			gl.glBufferData(gl.GL_ELEMENT_ARRAY_BUFFER, data.len() * 4, data, gl.GL_STATIC_DRAW)
			return ids[0]
		}

		// The mesh's buffers, uploaded when it is new or its vertices moved.
		def buffersOf(store ModelStore, mesh GpuMesh) ModelBuffers {
			let kept = store.meshes.get(mesh.id)
			if !(kept is none) {
				if kept.stamp == mesh.stamp {
					// Edges are listed only for a wireframe, which may start
					// after the mesh was first drawn.
					if kept.edges == 0 && mesh.edges.len() > 0 {
						kept.edges = indexBuffer(mesh.edges)
						kept.counts[3] = mesh.edges.len()
					}
					return kept
				}
				freeBuffers(kept)
			}
			let made = new ModelBuffers()
			made.stamp = mesh.stamp
			made.positions = vertexBuffer(mesh.positions)
			made.normals = vertexBuffer(mesh.normals)
			made.tangents = vertexBuffer(mesh.tangents)
			made.uv0 = vertexBuffer(mesh.uvs[0]) when mesh.uvs.len() > 0
			made.uv1 = vertexBuffer(mesh.uvs[1]) when mesh.uvs.len() > 1
			made.colors = vertexBuffer(mesh.colors)
			made.triangles = indexBuffer(mesh.triangles)
			made.segments = indexBuffer(mesh.segments)
			made.points = indexBuffer(mesh.points)
			made.edges = indexBuffer(mesh.edges)
			made.counts = int[mesh.triangles.len(), mesh.segments.len(), mesh.points.len(), mesh.edges.len()]
			store.meshes = store.meshes.set(mesh.id, made)
			return made
		}

		// Points the attribute at the buffer, or turns it off for none.
		def attribute(name string, buffer uint32, size int) {
			let slot = at(name)
			return when slot < 0
			if buffer == 0 {
				gl.glDisableVertexAttribArray(slot)
				return
			}
			gl.glBindBuffer(gl.GL_ARRAY_BUFFER, buffer)
			gl.glEnableVertexAttribArray(slot)
			gl.adm_gl_attrib_buffer(slot, size, gl.GL_FLOAT, false, 0)
		}

		// The model's texture for a material's reference bound to the unit,
		// and its place in the shader's per-texture uniforms: `move` gets the
		// offset, rotation and coordinate set (-1 when the reference draws
		// nothing), `scale` the scale.
		def bind(store ModelStore, mesh GpuMesh, ref ?TextureRef, unit int, move float32[], scale float32[]) {
			gl.glActiveTexture(gl.GL_TEXTURE0 + uint32(unit))
			let texture = white
			let set = -1.0
			let offsetU = 0.0
			let offsetV = 0.0
			let rotation = 0.0
			let scaleU = 1.0
			let scaleV = 1.0
			if !(ref is none) {
				// The shader reads two coordinate sets.
				if ref.uv >= 0 && ref.uv < 2 && ref.uv < mesh.uvs.len() && mesh.uvs[ref.uv].len() > 0 {
					for let (i, source) in store.sources {
						continue when source != ref.texture
						texture = store.textures[i]
						set = float(ref.uv)
						break
					}
				}
				let t = ref.transform
				if !(t is none) {
					offsetU = t.offsetU
					offsetV = t.offsetV
					rotation = t.rotation
					scaleU = t.scaleU
					scaleV = t.scaleV
				}
			}
			gl.glBindTexture(gl.GL_TEXTURE_2D, texture)
			move.push(float32(offsetU), float32(offsetV), float32(rotation), float32(set))
			scale.push(float32(scaleU), float32(scaleV), float32(0), float32(0))
		}

		// Sets the material's uniforms and textures for a lit surface.
		def setMaterial(store ModelStore, mesh GpuMesh) {
			let m = mesh.material
			let move float32[]
			let scale float32[]
			gl.glUniform1i(at("uHasNormal"), mesh.normals.len() > 0 ?? (1, 0))
			gl.glUniform1i(at("uHasTangent"), mesh.tangents.len() > 0 ?? (1, 0))
			gl.glUniform1i(at("uHasColor"), mesh.colors.len() > 0 ?? (1, 0))
			if m is none {
				for let unit = 0; unit < 5; unit++ {
					bind(store, mesh, none, unit, move, scale)
				}
				gl.glUniform4f(at("uBase"), 1.0, 1.0, 1.0, 1.0)
				gl.glUniform3f(at("uEmissive"), 0.0, 0.0, 0.0)
				gl.glUniform1f(at("uMetallic"), 1.0)
				gl.glUniform1f(at("uRoughness"), 1.0)
				gl.glUniform1i(at("uAlphaMode"), 3)
				gl.glUniform1i(at("uUnlit"), 0)
			} else {
				bind(store, mesh, m.baseColorTexture, 0, move, scale)
				bind(store, mesh, m.metallicRoughnessTexture, 1, move, scale)
				bind(store, mesh, m.normalTexture, 2, move, scale)
				bind(store, mesh, m.occlusionTexture, 3, move, scale)
				bind(store, mesh, m.emissiveTexture, 4, move, scale)
				let base = m.baseColor
				gl.glUniform4f(at("uBase"), linear(base.red), linear(base.green), linear(base.blue), float32(float(base.alpha) / 255.0))
				let glow = m.emissive
				let strength = float32(m.emissiveStrength)
				gl.glUniform3f(at("uEmissive"), linear(glow.red) * strength, linear(glow.green) * strength, linear(glow.blue) * strength)
				gl.glUniform1f(at("uMetallic"), float32(m.metallic))
				gl.glUniform1f(at("uRoughness"), float32(m.roughness))
				gl.glUniform1f(at("uCutoff"), float32(m.alphaCutoff))
				gl.glUniform1i(at("uAlphaMode"), m.alphaMode == AlphaMode.Opaque ?? (0, m.alphaMode == AlphaMode.Mask ?? (1, 2)))
				gl.glUniform1i(at("uUnlit"), m.unlit ?? (1, 0))
				let normal = m.normalTexture
				gl.glUniform1f(at("uNormalScale"), normal is none ?? (float32(1), float32(normal.strength)))
				let occlusion = m.occlusionTexture
				gl.glUniform1f(at("uOcclusion"), occlusion is none ?? (float32(1), float32(occlusion.strength)))
			}
			gl.glUniform4fv(at("uTexMove"), 5, move)
			gl.glUniform4fv(at("uTexScale"), 5, scale)
		}

		// An 8-bit sRGB channel as linear light.
		def linear(c uint8) float32 {
			let v = float(c) / 255.0
			return float32(v / 12.92) when v <= 0.04045
			return float32(((v + 0.055) / 1.055) ** 2.4)
		}

		// Draws one mesh: its triangles lit, its segments and points in the
		// base colour, its edges in the edge colour.
		def drawMesh(scene GpuScene, store ModelStore, mesh GpuMesh) {
			let b = buffersOf(store, mesh)
			attribute("aPosition", b.positions, 3)
			attribute("aNormal", b.normals, 3)
			attribute("aTangent", b.tangents, 4)
			attribute("aUV0", b.uv0, 2)
			attribute("aUV1", b.uv1, 2)
			attribute("aColor", b.colors, 4)
			gl.glUniform1f(at("uLift"), 0.0)
			if scene.fill && b.counts[0] > 0 {
				setMaterial(store, mesh)
				gl.glUniform1i(at("uMode"), 0)
				// Front faces are clockwise in the target, which OpenGL calls
				// back faces.
				if mesh.doubleSided {
					gl.glDisable(gl.GL_CULL_FACE)
				} else {
					gl.glEnable(gl.GL_CULL_FACE)
					gl.glCullFace(gl.GL_FRONT)
				}
				gl.glBindBuffer(gl.GL_ELEMENT_ARRAY_BUFFER, b.triangles)
				gl.adm_gl_draw_indices(gl.GL_TRIANGLES, b.counts[0], gl.GL_UNSIGNED_INT)
			}
			gl.glDisable(gl.GL_CULL_FACE)
			if b.counts[1] > 0 || b.counts[2] > 0 {
				// The base colour, with the material's alpha when it blends.
				let m = mesh.material
				gl.glUniform1i(at("uMode"), 1)
				gl.glUniform1i(at("uHasColor"), mesh.colors.len() > 0 ?? (1, 0))
				gl.glUniform1i(at("uAlphaMode"), 3)
				if m is none {
					gl.glUniform4f(at("uBase"), 1.0, 1.0, 1.0, 1.0)
				} else {
					let base = m.baseColor
					gl.glUniform4f(at("uBase"), linear(base.red), linear(base.green), linear(base.blue), m.alphaMode == AlphaMode.Blend ?? (float32(float(base.alpha) / 255.0), float32(1)))
				}
				if b.counts[1] > 0 {
					gl.glBindBuffer(gl.GL_ELEMENT_ARRAY_BUFFER, b.segments)
					gl.adm_gl_draw_indices(gl.GL_LINES, b.counts[1], gl.GL_UNSIGNED_INT)
				}
				if b.counts[2] > 0 {
					gl.glBindBuffer(gl.GL_ELEMENT_ARRAY_BUFFER, b.points)
					gl.adm_gl_draw_indices(gl.GL_POINTS, b.counts[2], gl.GL_UNSIGNED_INT)
				}
			}
			if scene.wire && b.counts[3] > 0 {
				gl.glUniform1i(at("uMode"), 2)
				gl.glUniform1f(at("uLift"), float32(modelEdgeLift))
				gl.glBindBuffer(gl.GL_ELEMENT_ARRAY_BUFFER, b.edges)
				gl.adm_gl_draw_indices(gl.GL_LINES, b.counts[3], gl.GL_UNSIGNED_INT)
			}
		}

		// Draws the scene's own lines, coloured per end, from buffers made
		// for this picture.
		def drawLines(scene GpuScene) {
			let ends = scene.linePositions.len() / 3
			return when ends < 2
			let positions = vertexBuffer(scene.linePositions)
			let colors = vertexBuffer(scene.lineColors)
			attribute("aPosition", positions, 3)
			attribute("aColor", colors, 4)
			attribute("aNormal", 0, 3)
			attribute("aTangent", 0, 4)
			attribute("aUV0", 0, 2)
			attribute("aUV1", 0, 2)
			gl.glUniform1f(at("uLift"), 0.0)
			gl.glUniform1i(at("uMode"), 1)
			gl.glUniform1i(at("uHasColor"), 1)
			gl.glUniform1i(at("uAlphaMode"), 3)
			gl.glUniform4f(at("uBase"), 1.0, 1.0, 1.0, 1.0)
			gl.glBindBuffer(gl.GL_ELEMENT_ARRAY_BUFFER, 0)
			gl.glDrawArrays(gl.GL_LINES, 0, ends)
			gl.glBindBuffer(gl.GL_ARRAY_BUFFER, 0)
			gl.glDeleteBuffers(2, uint32[positions, colors])
		}

		def freeBuffers(b ModelBuffers) {
			for let (_, id) in b.ids() {
				gl.glDeleteBuffers(1, uint32[id]) when id != 0
			}
		}

		// Frees a model's buffers and textures.
		def free(store ModelStore) {
			for let (_, b) in store.meshes {
				freeBuffers(b)
			}
			gl.glDeleteTextures(store.textures.len(), store.textures) when store.textures.len() > 0
		}

		// Frees what has not been drawn for `modelKeptFrames` frames and what
		// belongs to a prepared model nobody holds any more: a model that is
		// no longer shown, or gone, gives its memory back. The frame renderer
		// calls it once a frame.
		def sweep(frame int) {
			for let (key, kept) in drawn {
				continue when frame - kept.used < modelKeptFrames && modelAlive(kept.model)
				gl.glDeleteFramebuffers(1, uint32[kept.level.fbo])
				gl.glDeleteTextures(1, uint32[kept.level.texture])
				drawn = drawn.delete(key)
			}
			for let (id, store) in stores {
				continue when frame - store.used < modelKeptFrames && modelAlive(id)
				free(store)
				stores = stores.delete(id)
			}
		}

		// Frees everything the layer holds.
		def dispose() {
			for let (_, kept) in drawn {
				gl.glDeleteFramebuffers(1, uint32[kept.level.fbo])
				gl.glDeleteTextures(1, uint32[kept.level.texture])
			}
			for let (_, store) in stores {
				free(store)
			}
			freeTarget()
			gl.glDeleteTextures(1, uint32[white]) when white != 0
			gl.glDeleteProgram(program)
			gl.glDeleteProgram(resolve)
		}
	}

	// Compiles the model layer's programs.
	internal def newModelLayer() !ModelLayer {
		let program = try buildProgram(shaderText(string(modelVertexSource)), shaderText(string(modelFragmentSource)), "the model shader")
		let resolve = try buildProgram(shaderText(string(canvasVertexSource)), shaderText(string(modelResolveSource)), "the model resolve shader")
		return new ModelLayer(program, resolve)
	}
}
