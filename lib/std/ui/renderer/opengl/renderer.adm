partial module std.ui.renderer.opengl {
	use (
		std.gfx.canvas
		std.gfx.color
		std.gfx.render as render
		std.formats.image
		std.math
		std.math.geom
		std.ui
		std.ui.renderer as r
		std.ui.renderer.opengl.gl
		std.ui.renderer.opengl.glfw
	)

	// OpenGLRenderer is a placeholder for the first desktop renderer backend.
	// It will own the platform window/context (via GLFW) and provide frames to the UI service.
	internal const _rendererMagic uint32 = 0x5A454E31

	@r.UIRenderer(name = "opengl")
	type OpenGLRenderer {
		internal started              bool
		internal forceCPU             bool
		internal initMagic            uint32
		internal windows              map<uint, r.WindowConfig>
		internal canvases             map<uint, canvas.Canvas>
		internal fbSizes              map<uint, geom.Size>
		internal texIDs               map<uint, uint32>
		internal texSizes             map<uint, geom.Size>
		internal presentA             map<uint, uint32>
		internal presentB             map<uint, uint32>
		internal presentSizes         map<uint, geom.Size>
		internal presentIndex         map<uint, int>
		internal blitTexIDs           map<uint, uint32>
		internal blitTexSizes         map<uint, geom.Size>
		internal offscreenA           map<uint, uint32>
		internal offscreenB           map<uint, uint32>
		internal offscreenFBO         map<uint, uint32>
		internal offscreenSize        map<uint, geom.Size>
		internal offscreenIndex       map<uint, int>
		internal blendReady           bool
		internal blendProgram         uint32
		internal blendPosAttr         int
		internal blendSrcAttr         int
		internal blendDstAttr         int
		internal blendViewportUniform int
		internal blendModeUniform     int
		internal blendSrcTexUniform   int
		internal blendDstTexUniform   int
		internal cursor               map<uint, geom.Point>
		internal hover                map<uint, bool>
		internal focus                map<uint, bool>
		internal mouse                map<uint, byte[]>
		internal keys                 map<uint, byte[]>

		def new(forceCPU bool = false) {
			started = false
			self.forceCPU = forceCPU
			initMagic = _rendererMagic
			windows = map<uint, r.WindowConfig>{}
			canvases = map<uint, canvas.Canvas>{}
			fbSizes = map<uint, geom.Size>{}
			texIDs = map<uint, uint32>{}
			texSizes = map<uint, geom.Size>{}
			presentA = map<uint, uint32>{}
			presentB = map<uint, uint32>{}
			presentSizes = map<uint, geom.Size>{}
			presentIndex = map<uint, int>{}
			blitTexIDs = map<uint, uint32>{}
			blitTexSizes = map<uint, geom.Size>{}
			offscreenA = map<uint, uint32>{}
			offscreenB = map<uint, uint32>{}
			offscreenFBO = map<uint, uint32>{}
			offscreenSize = map<uint, geom.Size>{}
			offscreenIndex = map<uint, int>{}
			blendReady = false
			blendProgram = 0
			blendPosAttr = -1
			blendSrcAttr = -1
			blendDstAttr = -1
			blendViewportUniform = -1
			blendModeUniform = -1
			blendSrcTexUniform = -1
			blendDstTexUniform = -1
			cursor = map<uint, geom.Point>{}
			hover = map<uint, bool>{}
			focus = map<uint, bool>{}
			mouse = map<uint, byte[]>{}
			keys = map<uint, byte[]>{}
		}

		internal def ensureState() {
			return when initMagic == _rendererMagic
			initMagic = _rendererMagic
			started = false
			windows = map<uint, r.WindowConfig>{}
			canvases = map<uint, canvas.Canvas>{}
			fbSizes = map<uint, geom.Size>{}
			texIDs = map<uint, uint32>{}
			texSizes = map<uint, geom.Size>{}
			presentA = map<uint, uint32>{}
			presentB = map<uint, uint32>{}
			presentSizes = map<uint, geom.Size>{}
			presentIndex = map<uint, int>{}
			blitTexIDs = map<uint, uint32>{}
			blitTexSizes = map<uint, geom.Size>{}
			offscreenA = map<uint, uint32>{}
			offscreenB = map<uint, uint32>{}
			offscreenFBO = map<uint, uint32>{}
			offscreenSize = map<uint, geom.Size>{}
			offscreenIndex = map<uint, int>{}
			blendReady = false
			blendProgram = 0
			blendPosAttr = -1
			blendSrcAttr = -1
			blendDstAttr = -1
			blendViewportUniform = -1
			blendModeUniform = -1
			blendSrcTexUniform = -1
			blendDstTexUniform = -1
			cursor = map<uint, geom.Point>{}
			hover = map<uint, bool>{}
			focus = map<uint, bool>{}
			mouse = map<uint, byte[]>{}
			keys = map<uint, byte[]>{}
		}

		internal def framebufferSize(id uint) (int, int, geom.Size) {
			let w int32[]
			let h int32[]
			w.len(1)
			h.len(1)
			glfw.glfwGetFramebufferSize(id, w, h)
			let wi = int(w[0])
			let hi = int(h[0])
			return (wi, hi, new geom.Size(float(w[0]), float(h[0])))
		}

		internal def initInputState(handle uint) {
			// Cursor position.
			let x float64[]
			let y float64[]
			x.len(1)
			y.len(1)
			glfw.glfwGetCursorPos(handle, x, y)
			cursor = cursor.set(handle, new geom.Point(float(x[0]), float(y[0])))

			// Hover/focus.
			hover = hover.set(handle, glfw.glfwGetWindowAttrib(handle, glfw.GLFW_HOVERED) != 0)
			focus = focus.set(handle, glfw.glfwGetWindowAttrib(handle, glfw.GLFW_FOCUSED) != 0)

			// Mouse buttons.
			let ms byte[]
			ms.len(glfw.GLFW_MOUSE_BUTTON_LAST + 1)
			for let b = 0; b <= glfw.GLFW_MOUSE_BUTTON_LAST; b = b + 1 {
				ms[b] = byte(glfw.glfwGetMouseButton(handle, b))
			}
			mouse = mouse.set(handle, ms)

			// Keys.
			let ks byte[]
			ks.len(glfw.GLFW_KEY_LAST + 1)
			for let k = 0; k <= glfw.GLFW_KEY_LAST; k = k + 1 {
				ks[k] = byte(glfw.glfwGetKey(handle, k))
			}
			keys = keys.set(handle, ks)

			// Framebuffer size.
			let (_, _, sz) = framebufferSize(handle)
			fbSizes = fbSizes.set(handle, sz)
		}

		// THREAD AFFINITY -- READ BEFORE WRITING THE RENDER LOOP.
		//
		// An OpenGL context is made current to an OS THREAD, and every gl*
		// entry point reads it out of that thread's local storage. Since the
		// coroutine scheduler landed, an `async` body is a task multiplexed
		// over a pool of carrier threads, so a task that calls
		// glfwMakeContextCurrent below, then parks (awaits, sleeps, reads a
		// channel), can resume on a DIFFERENT carrier -- where the context is
		// not current. Every draw call after that runs against no context: a
		// crash on macOS, a crash or silently blank frames under Mesa. Go
		// requires runtime.LockOSThread for exactly this.
		//
		// THIS IS HANDLED, automatically, and here is where to look if it ever
		// regresses. `glfwMakeContextCurrent`, `glfwSwapBuffers` and
		// `glfwPollEvents` are bound in glfw.adm to runtime shims that call
		// adm_gl_bind_current_task() before forwarding, so whichever task runs
		// the loop is bound to its carrier by its own first frame. No
		// application code has to know, and nothing public was added.
		//
		// Bound at those three rather than only at makeContextCurrent because
		// the task that opens a window is often not the task that renders;
		// swapBuffers and pollEvents are reached every frame by any loop,
		// wherever it lives. Binding is idempotent, so the per-frame cost is
		// one predictable branch.
		//
		// The symptom when this is missing is worth recognising, because it
		// names the wrong thing: GL calls on a thread with no current context
		// fail, and the first to notice is usually glCheckFramebufferStatus
		// reporting "framebuffer incomplete". It also hides behind vsync --
		// with vsync on, glfwSwapBuffers blocks the carrier long enough that
		// the loop never reaches a park point and so never migrates; with
		// vsync off it does, which is exactly how it was first reported.
		//
		// Still outstanding:
		//
		//   * macOS. glfwInit, glfwCreateWindow and glfwPollEvents need the
		//     process's FIRST thread there (Cocoa's NSApplication), which
		//     pinning does not provide. Route them through
		//     adm_sched_main_call, which exists and is tested but is not
		//     wired in here.
		//   * glfwSwapBuffers blocks for the vsync interval and does not
		//     release its scheduling context, so one Proc is held for it.
		//   * ADM_AFFINITY_CHECK=1 exists to turn an unpinned thread-affine
		//     call into a named diagnostic; the gl* wrappers do not use it yet.
		//
		// See docs/superpowers/specs/2026-08-09-coroutine-scheduler-design.md
		// section 5.7.
		def openWindow(cfg r.WindowConfig) !r.Window {
			ensureState()
			if !started {
				let ok = glfw.glfwInit()
				fail "GLFW init failed" when ok == 0
				started = true
			}

			let w = int(cfg.size.width)
			let h = int(cfg.size.height)

			// Apply window hints derived from config.
			glfw.glfwDefaultWindowHints()
			glfw.glfwWindowHint(glfw.GLFW_RESIZABLE, cfg.resizable ?? (glfw.GLFW_TRUE, glfw.GLFW_FALSE))

			let handle = glfw.glfwCreateWindow(w, h, cfg.title, 0, 0)
			fail "GLFW window creation failed" when handle == 0

			glfw.glfwMakeContextCurrent(handle)
			glfw.glfwSwapInterval(cfg.vsync ?? (1, 0))

			windows = windows.set(handle, cfg)
			let cv = new canvas.Canvas(w, h)
			canvases = canvases.set(handle, cv)
			initInputState(handle)

			// Allocate textures lazily on first commit to avoid driver issues during startup.

			let win = new r.Window(handle)
			let icon = cfg.icon
			if icon is none {
				return win
			}
			try setWindowIcon(win, icon)

			return win
		}

		def setWindowTitle(win r.Window, title string) !none {
			ensureState()
			let id = win.id()
			fail "unknown window" when !windows.hasKey(id)
			glfw.glfwSetWindowTitle(id, title)
			if windows.hasKey(id) {
				let cfg = windows[id]
				cfg.title = title
				windows = windows.set(id, cfg)
			}
			return none
		}

		def setWindowIcon(win r.Window, icon image.Image) !none {
			ensureState()
			let id = win.id()
			fail "unknown window" when !windows.hasKey(id)

			let w = int(icon.size().width)
			let h = int(icon.size().height)
			fail "invalid icon size" when w <= 0 || h <= 0
			let want = w * h * 4
			let px = icon.raw()
			fail "invalid icon buffer" when px.len() < want

			glfw.glfwSetWindowIcon(id, w, h, px)
			return none
		}

		def pollEvents(win r.Window) !r.PlatformEvent[] {
			ensureState()
			glfw.glfwPollEvents()

			let id = win.id()
			fail "unknown window" when !windows.hasKey(id)

			let out r.PlatformEvent[]
			if glfw.glfwWindowShouldClose(id) != 0 {
				out.push(r.PlatformEvent{kind: r.PlatformEventKind.Close})
			}

			// Resize (framebuffer size).
			let (_, _, newSize) = framebufferSize(id)

			if !fbSizes.hasKey(id) {
				fbSizes = fbSizes.set(id, newSize)
			} else {
				let old = fbSizes[id]
				if old.width != newSize.width || old.height != newSize.height {
					fbSizes = fbSizes.set(id, newSize)
					out.push(r.PlatformEvent{kind: r.PlatformEventKind.Resize, size: newSize})
				}
			}

			// Focus/blur.
			let focused = glfw.glfwGetWindowAttrib(id, glfw.GLFW_FOCUSED) != 0
			if !focus.hasKey(id) {
				focus = focus.set(id, focused)
			} else if focus[id] != focused {
				focus = focus.set(id, focused)
				out.push(r.PlatformEvent{kind: (focused ?? (r.PlatformEventKind.Focus, r.PlatformEventKind.Blur))})
			}

			// Mouse enter/leave.
			let hovered = glfw.glfwGetWindowAttrib(id, glfw.GLFW_HOVERED) != 0
			if !hover.hasKey(id) {
				hover = hover.set(id, hovered)
			} else if hover[id] != hovered {
				hover = hover.set(id, hovered)
				out.push(r.PlatformEvent{kind: (hovered ?? (r.PlatformEventKind.MouseEnter, r.PlatformEventKind.MouseLeave))})
			}

			// Cursor position / move.
			let pos = new geom.Point(1, 1)
			if hovered {
				let x float64[]
				let y float64[]
				x.len(1)
				y.len(1)

				glfw.glfwGetCursorPos(id, x, y)
				pos = new geom.Point(float(x[0]), float(y[0]))

				if !cursor.hasKey(id) {
					cursor[id] = pos
				} else {
					let prev = cursor[id]
					if prev.x != pos.x || prev.y != pos.y {
						prev.x = pos.x
						prev.y = pos.y
						out.push(r.PlatformEvent{
							kind:     r.PlatformEventKind.MouseMove,
							position: new geom.Point(pos.x, pos.y),
							delta:    new geom.Point(pos.x - prev.x, pos.y - prev.y),
						})
					}
				}
			} else if cursor.hasKey(id) {
				cursor = cursor.delete(id)
			}

			// Mouse buttons (we only surface left/right/middle for now).
			// `initInputState` sizes the cached lane arrays exactly; re-initialise
			// once when the entry is missing or the wrong size, then skip the pass
			// entirely rather than index a bad array. A window can be polled
			// before/after a state reset, and a malformed cache must never take
			// down the event loop.
			let msWant = glfw.GLFW_MOUSE_BUTTON_LAST + 1
			if hovered {
				if !mouse.hasKey(id) {
					initInputState(id)
				}
				let ms = mouse[id]
				if ms.len() != msWant {
					initInputState(id)
					ms = mouse[id]
				}
				if ms.len() == msWant {
					for let b = 0; b <= 2; b = b + 1 {
						let now = byte(glfw.glfwGetMouseButton(id, b))
						let was = ms[b]
						continue when now == was
						ms[b] = now

						let btn = ui.MouseButton.Left
						btn = ui.MouseButton.Right when b == 1
						btn = ui.MouseButton.Middle when b == 2

						let kind = (now == byte(glfw.GLFW_PRESS)) ?? (r.PlatformEventKind.MouseDown, r.PlatformEventKind.MouseUp)
						out.push(r.PlatformEvent{kind: kind, position: pos, button: btn})
					}
					mouse = mouse.set(id, ms)
				}
			}

			// Keys (same cache-shape guard as the mouse pass above).
			let ksWant = glfw.GLFW_KEY_LAST + 1
			if !keys.hasKey(id) {
				initInputState(id)
			}
			let ks = keys[id]
			if ks.len() != ksWant {
				initInputState(id)
				ks = keys[id]
			}
			if ks.len() == ksWant {
				for let k = 0; k <= glfw.GLFW_KEY_LAST; k = k + 1 {
					let now = byte(glfw.glfwGetKey(id, k))
					let was = ks[k]
					continue when now == was
					ks[k] = now

					let kind = (now == byte(glfw.GLFW_PRESS)) ?? (r.PlatformEventKind.KeyDown, r.PlatformEventKind.KeyUp)
					out.push(r.PlatformEvent{kind: kind, key: k})
				}
				keys = keys.set(id, ks)
			}

			return out
		}

		internal def canUseGPU(ctx canvas.DrawContext) bool {
			return true
		}

		internal def setColor(c color.Color) {
			let rgba = c.rgba
			gl.glColor4ub(rgba.r, rgba.g, rgba.b, rgba.a)
		}

		internal def circleSegments(rx float, ry float) int {
			let r = rx
			r = ry when ry > r
			let seg = int(r * 0.5) + 12
			seg = 12 when seg < 12
			seg = 256 when seg > 256
			return seg
		}

		internal def drawLineQuad(a geom.Point, b geom.Point, half float) {
			let dx = b.x - a.x
			let dy = b.y - a.y
			let len = math.sqrt(dx * dx + dy * dy)
			return when len <= 0.0

			let nx = -dy / len * half
			let ny = dx / len * half

			let ax0 = a.x + nx
			let ay0 = a.y + ny
			let ax1 = a.x - nx
			let ay1 = a.y - ny
			let bx0 = b.x + nx
			let by0 = b.y + ny
			let bx1 = b.x - nx
			let by1 = b.y - ny

			gl.glBegin(gl.GL_TRIANGLES)
			gl.glVertex2f(float32(ax0), float32(ay0))
			gl.glVertex2f(float32(bx0), float32(by0))
			gl.glVertex2f(float32(bx1), float32(by1))

			gl.glVertex2f(float32(ax0), float32(ay0))
			gl.glVertex2f(float32(bx1), float32(by1))
			gl.glVertex2f(float32(ax1), float32(ay1))
			gl.glEnd()
		}

		internal def pushVertexRGBA(verts float32[], uvs float32[], colors byte[], x float, y float, u float, v float, rgba color.RGBA) {
			verts.push(float32(x))
			verts.push(float32(y))
			uvs.push(float32(u))
			uvs.push(float32(v))
			colors.push(rgba.r)
			colors.push(rgba.g)
			colors.push(rgba.b)
			colors.push(rgba.a)
		}

		internal def batchRect(verts float32[], uvs float32[], colors byte[], left float, top float, right float, bottom float, rgba color.RGBA) {
			pushVertexRGBA(verts, uvs, colors, left, top, 0, 0, rgba)
			pushVertexRGBA(verts, uvs, colors, right, top, 0, 0, rgba)
			pushVertexRGBA(verts, uvs, colors, right, bottom, 0, 0, rgba)

			pushVertexRGBA(verts, uvs, colors, left, top, 0, 0, rgba)
			pushVertexRGBA(verts, uvs, colors, right, bottom, 0, 0, rgba)
			pushVertexRGBA(verts, uvs, colors, left, bottom, 0, 0, rgba)
		}

		internal def batchLineQuad(verts float32[], uvs float32[], colors byte[], a geom.Point, b geom.Point, width float, rgba color.RGBA) {
			let dx = b.x - a.x
			let dy = b.y - a.y
			let len = math.sqrt(dx * dx + dy * dy)
			return when len <= 0.0

			let half = width * 0.5
			let nx = -dy / len * half
			let ny = dx / len * half

			let ax0 = a.x + nx
			let ay0 = a.y + ny
			let ax1 = a.x - nx
			let ay1 = a.y - ny
			let bx0 = b.x + nx
			let by0 = b.y + ny
			let bx1 = b.x - nx
			let by1 = b.y - ny

			pushVertexRGBA(verts, uvs, colors, ax0, ay0, 0, 0, rgba)
			pushVertexRGBA(verts, uvs, colors, bx0, by0, 0, 0, rgba)
			pushVertexRGBA(verts, uvs, colors, bx1, by1, 0, 0, rgba)

			pushVertexRGBA(verts, uvs, colors, ax0, ay0, 0, 0, rgba)
			pushVertexRGBA(verts, uvs, colors, bx1, by1, 0, 0, rgba)
			pushVertexRGBA(verts, uvs, colors, ax1, ay1, 0, 0, rgba)
		}

		internal def batchPolygonFan(verts float32[], uvs float32[], colors byte[], points geom.Point[], rgba color.RGBA) {
			return when points.len() < 3
			let p0 = points[0]
			for let i = 1; i + 1 < points.len(); i = i + 1 {
				let p1 = points[i]
				let p2 = points[i + 1]
				pushVertexRGBA(verts, uvs, colors, p0.x, p0.y, 0, 0, rgba)
				pushVertexRGBA(verts, uvs, colors, p1.x, p1.y, 0, 0, rgba)
				pushVertexRGBA(verts, uvs, colors, p2.x, p2.y, 0, 0, rgba)
			}
		}

		internal def batchEllipseFan(verts float32[], uvs float32[], colors byte[], center geom.Point, rx float, ry float, rgba color.RGBA) {
			let segments = circleSegments(rx, ry)
			let step = math.τ / float(segments)
			for let i = 0; i < segments; i = i + 1 {
				let a0 = step * float(i)
				let a1 = step * float(i + 1)
				let x0 = center.x + math.cos(a0) * rx
				let y0 = center.y + math.sin(a0) * ry
				let x1 = center.x + math.cos(a1) * rx
				let y1 = center.y + math.sin(a1) * ry

				pushVertexRGBA(verts, uvs, colors, center.x, center.y, 0, 0, rgba)
				pushVertexRGBA(verts, uvs, colors, x0, y0, 0, 0, rgba)
				pushVertexRGBA(verts, uvs, colors, x1, y1, 0, 0, rgba)
			}
		}

		internal def batchEllipseStroke(verts float32[], uvs float32[], colors byte[], center geom.Point, rx float, ry float, width float, rgba color.RGBA) {
			let segments = circleSegments(rx, ry)
			let step = math.τ / float(segments)
			let prev = new geom.Point(center.x + math.cos(0) * rx, center.y + math.sin(0) * ry)
			for let i = 1; i <= segments; i = i + 1 {
				let a = step * float(i)
				let cur = new geom.Point(center.x + math.cos(a) * rx, center.y + math.sin(a) * ry)
				batchLineQuad(verts, uvs, colors, prev, cur, width, rgba)
				prev = cur
			}
		}

		internal def batchFlush(verts float32[], uvs float32[], colors byte[], textured bool, texID uint32, blend bool) {
			let vcount = verts.len() / 2
			return when vcount <= 0

			gl.glVertexPointer(2, gl.GL_FLOAT, 0, verts)
			gl.glColorPointer(4, gl.GL_UNSIGNED_BYTE, 0, colors)
			gl.glTexCoordPointer(2, gl.GL_FLOAT, 0, uvs)

			if textured {
				gl.glEnable(gl.GL_TEXTURE_2D)
				gl.glBindTexture(gl.GL_TEXTURE_2D, texID)
			} else {
				gl.glDisable(gl.GL_TEXTURE_2D)
			}

			if blend {
				gl.glEnable(gl.GL_BLEND)
			} else {
				gl.glDisable(gl.GL_BLEND)
			}

			gl.glDrawArrays(gl.GL_TRIANGLES, 0, vcount)

			if !blend {
				gl.glEnable(gl.GL_BLEND)
			}

			verts.len(0)
			uvs.len(0)
			colors.len(0)
		}

		internal def drawTexturedQuad(id uint, x int, y int, w int, h int, src byte[], blend bool) {
			let want = w * h * 4
			return when w <= 0 || h <= 0 || want <= 0 || src.len() < want

			ensureBlitTexture(id, w, h, src)

			let verts float32[]
			let uvs float32[]
			let colors byte[]

			let white = color.RGBA{r: 255, g: 255, b: 255, a: 255}
			pushVertexRGBA(verts, uvs, colors, float(x), float(y), 0, 0, white)
			pushVertexRGBA(verts, uvs, colors, float(x + w), float(y), 1, 0, white)
			pushVertexRGBA(verts, uvs, colors, float(x + w), float(y + h), 1, 1, white)

			pushVertexRGBA(verts, uvs, colors, float(x), float(y), 0, 0, white)
			pushVertexRGBA(verts, uvs, colors, float(x + w), float(y + h), 1, 1, white)
			pushVertexRGBA(verts, uvs, colors, float(x), float(y + h), 0, 1, white)

			let texID = blitTexIDs[id]
			batchFlush(verts, uvs, colors, true, texID, blend)
		}

		internal def ensureBlitTexture(id uint, w int, h int, src byte[]) {
			return when w <= 0 || h <= 0
			let want = w * h * 4
			return when want <= 0 || src.len() < want

			let texID uint32
			if blitTexIDs.hasKey(id) {
				texID = blitTexIDs[id]
			} else {
				let tex uint32[]
				tex.len(1)
				gl.glGenTextures(1, tex)
				texID = tex[0]
				blitTexIDs = blitTexIDs.set(id, texID)
				blitTexSizes = blitTexSizes.set(id, new geom.Size(0, 0))
			}

			gl.glBindTexture(gl.GL_TEXTURE_2D, texID)
			gl.glTexParameteri(gl.GL_TEXTURE_2D, gl.GL_TEXTURE_MIN_FILTER, int(gl.GL_NEAREST))
			gl.glTexParameteri(gl.GL_TEXTURE_2D, gl.GL_TEXTURE_MAG_FILTER, int(gl.GL_NEAREST))
			gl.glPixelStorei(gl.GL_UNPACK_ALIGNMENT, 1)

			let needAlloc = true
			if blitTexSizes.hasKey(id) {
				let ts = blitTexSizes[id]
				needAlloc = ts.width != float(w) || ts.height != float(h)
			}
			if needAlloc {
				blitTexSizes = blitTexSizes.set(id, new geom.Size(float(w), float(h)))
				gl.glTexImage2D(gl.GL_TEXTURE_2D, 0, int(gl.GL_RGBA), w, h, 0, gl.GL_RGBA, gl.GL_UNSIGNED_BYTE, src)
			} else {
				gl.glTexSubImage2D(gl.GL_TEXTURE_2D, 0, 0, 0, w, h, gl.GL_RGBA, gl.GL_UNSIGNED_BYTE, src)
			}
		}

		internal def ensurePresentTexture(id uint, w int, h int, src byte[]) {
			// Deprecated: kept for compatibility with older call sites.
			// Prefer ensurePresentTextures + presentBackTex/presentTex.
			ensurePresentTextures(id, w, h)
			let back = presentBackTex(id)
			gl.glBindTexture(gl.GL_TEXTURE_2D, back)
			gl.glPixelStorei(gl.GL_UNPACK_ALIGNMENT, 1)
			gl.glTexSubImage2D(gl.GL_TEXTURE_2D, 0, 0, 0, w, h, gl.GL_RGBA, gl.GL_UNSIGNED_BYTE, src)
		}

		internal def presentTex(id uint) uint32 {
			let idx = 0
			idx = presentIndex[id] when presentIndex.hasKey(id)
			return presentB[id] when idx == 1
			return presentA[id]
		}

		internal def presentBackTex(id uint) uint32 {
			let idx = 0
			idx = presentIndex[id] when presentIndex.hasKey(id)
			return presentA[id] when idx == 1
			return presentB[id]
		}

		internal def swapPresent(id uint) {
			let idx = 0
			idx = presentIndex[id] when presentIndex.hasKey(id)
			presentIndex = presentIndex.set(id, (idx == 0) ?? (1, 0))
		}

		internal def ensurePresentTextures(id uint, w int, h int) {
			let sizeOk = false
			if presentSizes.hasKey(id) {
				let s = presentSizes[id]
				sizeOk = s.width == float(w) && s.height == float(h)
			}

			if sizeOk && presentA.hasKey(id) && presentB.hasKey(id) && presentIndex.hasKey(id) {
				return
			}

			// Delete old textures if present (including the legacy single-texture path).
			if presentA.hasKey(id) {
				let tex uint32[]
				tex.len(1)
				tex[0] = presentA[id]
				gl.glDeleteTextures(1, tex)
				presentA = presentA.delete(id)
			}
			if presentB.hasKey(id) {
				let tex uint32[]
				tex.len(1)
				tex[0] = presentB[id]
				gl.glDeleteTextures(1, tex)
				presentB = presentB.delete(id)
			}
			if texIDs.hasKey(id) {
				let tex uint32[]
				tex.len(1)
				tex[0] = texIDs[id]
				gl.glDeleteTextures(1, tex)
				texIDs = texIDs.delete(id)
			}

			let texA uint32[]
			let texB uint32[]
			texA.len(1)
			texB.len(1)
			gl.glGenTextures(1, texA)
			gl.glGenTextures(1, texB)

			let zero byte[]
			zero.len(w * h * 4)

			gl.glBindTexture(gl.GL_TEXTURE_2D, texA[0])
			gl.glTexParameteri(gl.GL_TEXTURE_2D, gl.GL_TEXTURE_MIN_FILTER, int(gl.GL_NEAREST))
			gl.glTexParameteri(gl.GL_TEXTURE_2D, gl.GL_TEXTURE_MAG_FILTER, int(gl.GL_NEAREST))
			gl.glPixelStorei(gl.GL_UNPACK_ALIGNMENT, 1)
			gl.glTexImage2D(gl.GL_TEXTURE_2D, 0, int(gl.GL_RGBA), w, h, 0, gl.GL_RGBA, gl.GL_UNSIGNED_BYTE, zero)

			gl.glBindTexture(gl.GL_TEXTURE_2D, texB[0])
			gl.glTexParameteri(gl.GL_TEXTURE_2D, gl.GL_TEXTURE_MIN_FILTER, int(gl.GL_NEAREST))
			gl.glTexParameteri(gl.GL_TEXTURE_2D, gl.GL_TEXTURE_MAG_FILTER, int(gl.GL_NEAREST))
			gl.glPixelStorei(gl.GL_UNPACK_ALIGNMENT, 1)
			gl.glTexImage2D(gl.GL_TEXTURE_2D, 0, int(gl.GL_RGBA), w, h, 0, gl.GL_RGBA, gl.GL_UNSIGNED_BYTE, zero)

			presentA = presentA.set(id, texA[0])
			presentB = presentB.set(id, texB[0])
			presentSizes = presentSizes.set(id, new geom.Size(float(w), float(h)))
			presentIndex = presentIndex.set(id, 0)
		}

		internal def ensureOffscreen(id uint, w int, h int) {
			let sizeOk = false
			if offscreenSize.hasKey(id) {
				let s = offscreenSize[id]
				sizeOk = s.width == float(w) && s.height == float(h)
			}

			if sizeOk && offscreenA.hasKey(id) && offscreenB.hasKey(id) && offscreenFBO.hasKey(id) {
				return
			}

			if offscreenA.hasKey(id) {
				let tex uint32[]
				tex.len(1)
				tex[0] = offscreenA[id]
				gl.glDeleteTextures(1, tex)
				offscreenA = offscreenA.delete(id)
			}
			if offscreenB.hasKey(id) {
				let tex uint32[]
				tex.len(1)
				tex[0] = offscreenB[id]
				gl.glDeleteTextures(1, tex)
				offscreenB = offscreenB.delete(id)
			}
			if offscreenFBO.hasKey(id) {
				let fbo uint32[]
				fbo.len(1)
				fbo[0] = offscreenFBO[id]
				gl.glDeleteFramebuffers(1, fbo)
				offscreenFBO = offscreenFBO.delete(id)
			}

			let texA uint32[]
			let texB uint32[]
			texA.len(1)
			texB.len(1)
			gl.glGenTextures(1, texA)
			gl.glGenTextures(1, texB)

			let zero byte[]
			zero.len(w * h * 4)

			gl.glBindTexture(gl.GL_TEXTURE_2D, texA[0])
			gl.glTexParameteri(gl.GL_TEXTURE_2D, gl.GL_TEXTURE_MIN_FILTER, int(gl.GL_NEAREST))
			gl.glTexParameteri(gl.GL_TEXTURE_2D, gl.GL_TEXTURE_MAG_FILTER, int(gl.GL_NEAREST))
			gl.glPixelStorei(gl.GL_UNPACK_ALIGNMENT, 1)
			gl.glTexImage2D(gl.GL_TEXTURE_2D, 0, int(gl.GL_RGBA), w, h, 0, gl.GL_RGBA, gl.GL_UNSIGNED_BYTE, zero)

			gl.glBindTexture(gl.GL_TEXTURE_2D, texB[0])
			gl.glTexParameteri(gl.GL_TEXTURE_2D, gl.GL_TEXTURE_MIN_FILTER, int(gl.GL_NEAREST))
			gl.glTexParameteri(gl.GL_TEXTURE_2D, gl.GL_TEXTURE_MAG_FILTER, int(gl.GL_NEAREST))
			gl.glPixelStorei(gl.GL_UNPACK_ALIGNMENT, 1)
			gl.glTexImage2D(gl.GL_TEXTURE_2D, 0, int(gl.GL_RGBA), w, h, 0, gl.GL_RGBA, gl.GL_UNSIGNED_BYTE, zero)

			let fbo uint32[]
			fbo.len(1)
			gl.glGenFramebuffers(1, fbo)

			offscreenA = offscreenA.set(id, texA[0])
			offscreenB = offscreenB.set(id, texB[0])
			offscreenFBO = offscreenFBO.set(id, fbo[0])
			offscreenSize = offscreenSize.set(id, new geom.Size(float(w), float(h)))
			offscreenIndex = offscreenIndex.set(id, 0)
		}

		internal def offscreenTex(id uint) uint32 {
			let idx = 0
			idx = offscreenIndex[id] when offscreenIndex.hasKey(id)
			return offscreenB[id] when idx == 1
			return offscreenA[id]
		}

		internal def offscreenBackTex(id uint) uint32 {
			let idx = 0
			idx = offscreenIndex[id] when offscreenIndex.hasKey(id)
			return offscreenA[id] when idx == 1
			return offscreenB[id]
		}

		internal def swapOffscreen(id uint) {
			let idx = 0
			idx = offscreenIndex[id] when offscreenIndex.hasKey(id)
			offscreenIndex = offscreenIndex.set(id, (idx == 0) ?? (1, 0))
		}

		internal def blendVertexSource() string {
			return "" +
				"attribute vec2 aPos;\n" +
				"attribute vec2 aSrcUV;\n" +
				"attribute vec2 aDstUV;\n" +
				"varying vec2 vSrcUV;\n" +
				"varying vec2 vDstUV;\n" +
				"uniform vec2 uViewport;\n" +
				"void main() {\n" +
				"  float x = (aPos.x / uViewport.x) * 2.0 - 1.0;\n" +
				"  float y = 1.0 - (aPos.y / uViewport.y) * 2.0;\n" +
				"  gl_Position = vec4(x, y, 0.0, 1.0);\n" +
				"  vSrcUV = aSrcUV;\n" +
				"  vDstUV = aDstUV;\n" +
				"}\n"
		}

		internal def blendFragmentSource() string {
			return "" +
				"varying vec2 vSrcUV;\n" +
				"varying vec2 vDstUV;\n" +
				"uniform sampler2D uSrcTex;\n" +
				"uniform sampler2D uDstTex;\n" +
				"uniform int uMode;\n" +
				"const int MODE_COPY = 100;\n" +
				"const int MODE_NORMAL = 0;\n" +
				"const int MODE_DISSOLVE = 1;\n" +
				"const int MODE_DARKEN = 2;\n" +
				"const int MODE_MULTIPLY = 3;\n" +
				"const int MODE_COLOR_BURN = 4;\n" +
				"const int MODE_LINEAR_BURN = 5;\n" +
				"const int MODE_DARKER_COLOR = 6;\n" +
				"const int MODE_LIGHTEN = 7;\n" +
				"const int MODE_SCREEN = 8;\n" +
				"const int MODE_COLOR_DODGE = 9;\n" +
				"const int MODE_LINEAR_DODGE = 10;\n" +
				"const int MODE_LIGHTER_COLOR = 11;\n" +
				"const int MODE_OVERLAY = 12;\n" +
				"const int MODE_SOFT_LIGHT = 13;\n" +
				"const int MODE_HARD_LIGHT = 14;\n" +
				"const int MODE_VIVID_LIGHT = 15;\n" +
				"const int MODE_LINEAR_LIGHT = 16;\n" +
				"const int MODE_PIN_LIGHT = 17;\n" +
				"const int MODE_HARD_MIX = 18;\n" +
				"const int MODE_DIFFERENCE = 19;\n" +
				"const int MODE_EXCLUSION = 20;\n" +
				"const int MODE_SUBTRACT = 21;\n" +
				"const int MODE_DIVIDE = 22;\n" +
				"const int MODE_XOR = 23;\n" +
				"const int MODE_AVERAGE = 24;\n" +
				"const int MODE_NEGATION = 25;\n" +
				"const int MODE_HUE = 26;\n" +
				"const int MODE_SATURATION = 27;\n" +
				"const int MODE_COLOR = 28;\n" +
				"const int MODE_LUMINOSITY = 29;\n" +
				"\n" +
				"float clamp01(float x) {\n" +
				"  return x < 0.0 ? 0.0 : (x > 1.0 ? 1.0 : x);\n" +
				"}\n" +
				"\n" +
				"float blendDarken(float cs, float cd) {\n" +
				"  return cs < cd ? cs : cd;\n" +
				"}\n" +
				"\n" +
				"float blendLighten(float cs, float cd) {\n" +
				"  return cs > cd ? cs : cd;\n" +
				"}\n" +
				"\n" +
				"float blendColorDodge(float cs, float cd) {\n" +
				"  if (cs >= 1.0 || cd >= 1.0) return 1.0;\n" +
				"  float v = cd / (1.0 - cs);\n" +
				"  return v > 1.0 ? 1.0 : v;\n" +
				"}\n" +
				"\n" +
				"float blendColorBurn(float cs, float cd) {\n" +
				"  if (cs <= 0.0 || cd <= 0.0) return 0.0;\n" +
				"  float v = 1.0 - (1.0 - cd) / cs;\n" +
				"  return v < 0.0 ? 0.0 : v;\n" +
				"}\n" +
				"\n" +
				"float blendVividLight(float cs, float cd) {\n" +
				"  return cs < 0.5 ? blendColorBurn(2.0*cs, cd) : blendColorDodge(2.0*cs-1.0, cd);\n" +
				"}\n" +
				"\n" +
				"float blendPinLight(float cs, float cd) {\n" +
				"  return cs < 0.5 ? blendDarken(2.0*cs, cd) : blendLighten(2.0*cs-1.0, cd);\n" +
				"}\n" +
				"\n" +
				"float blendHardMix(float cs, float cd) {\n" +
				"  float v = blendVividLight(cs, cd);\n" +
				"  return v < 0.5 ? 0.0 : 1.0;\n" +
				"}\n" +
				"\n" +
				"float hueToRGB(float p, float q, float t) {\n" +
				"  float tt = t;\n" +
				"  if (tt < 0.0) tt += 1.0;\n" +
				"  if (tt > 1.0) tt -= 1.0;\n" +
				"  if (tt < 1.0/6.0) return p + (q - p) * 6.0 * tt;\n" +
				"  if (tt < 0.5) return q;\n" +
				"  if (tt < 2.0/3.0) return p + (q - p) * (2.0/3.0 - tt) * 6.0;\n" +
				"  return p;\n" +
				"}\n" +
				"\n" +
				"vec3 rgbToHsl(vec3 c) {\n" +
				"  float rf = c.r; float gf = c.g; float bf = c.b;\n" +
				"  float maxv = max(rf, max(gf, bf));\n" +
				"  float minv = min(rf, min(gf, bf));\n" +
				"  float l = (maxv + minv) / 2.0;\n" +
				"  float d = maxv - minv;\n" +
				"  if (d == 0.0) return vec3(0.0, 0.0, l);\n" +
				"  float s = d / (1.0 - abs(2.0*l - 1.0));\n" +
				"  float h = 0.0;\n" +
				"  if (maxv == rf) {\n h = (gf - bf) / d; if (h < 0.0) h += 6.0; }\n" +
				"  else if (maxv == gf) {\n h = (bf - rf) / d + 2.0; }\n" +
				"  else {\n h = (rf - gf) / d + 4.0; }\n" +
				"  h *= 60.0;\n" +
				"  return vec3(h, s, l);\n" +
				"}\n" +
				"\n" +
				"vec3 hslToRgb(vec3 hsl) {\n" +
				"  float h = hsl.x / 360.0;\n" +
				"  float s = clamp01(hsl.y);\n" +
				"  float l = clamp01(hsl.z);\n" +
				"  if (s == 0.0) return vec3(l, l, l);\n" +
				"  float q = l < 0.5 ? (l * (1.0 + s)) : (l + s - l*s);\n" +
				"  float p = 2.0*l - q;\n" +
				"  float r = hueToRGB(p, q, h + 1.0/3.0);\n" +
				"  float g = hueToRGB(p, q, h);\n" +
				"  float b = hueToRGB(p, q, h - 1.0/3.0);\n" +
				"  return vec3(r, g, b);\n" +
				"}\n" +
				"\n" +
				"float blendSeparable(int mode, float cs, float cd) {\n" +
				"  if (mode == MODE_NORMAL) return cs;\n" +
				"  if (mode == MODE_DARKEN) return blendDarken(cs, cd);\n" +
				"  if (mode == MODE_LIGHTEN) return blendLighten(cs, cd);\n" +
				"  if (mode == MODE_MULTIPLY) return cs * cd;\n" +
				"  if (mode == MODE_SCREEN) return 1.0 - (1.0-cs)*(1.0-cd);\n" +
				"  if (mode == MODE_OVERLAY) return cd <= 0.5 ? (2.0*cs*cd) : (1.0 - 2.0*(1.0-cs)*(1.0-cd));\n" +
				"  if (mode == MODE_HARD_LIGHT) return cs <= 0.5 ? (2.0*cs*cd) : (1.0 - 2.0*(1.0-cs)*(1.0-cd));\n" +
				"  if (mode == MODE_SOFT_LIGHT) {\n" +
				"    if (cs <= 0.5) return cd - (1.0 - 2.0*cs)*cd*(1.0-cd);\n" +
				"    float g = cd <= 0.25 ? ((16.0*cd - 12.0)*cd + 4.0)*cd : sqrt(cd);\n" +
				"    return cd + (2.0*cs - 1.0)*(g - cd);\n" +
				"  }\n" +
				"  if (mode == MODE_COLOR_DODGE) return blendColorDodge(cs, cd);\n" +
				"  if (mode == MODE_COLOR_BURN) return blendColorBurn(cs, cd);\n" +
				"  if (mode == MODE_LINEAR_DODGE) {\n" +
				"    float v = cs + cd; return v > 1.0 ? 1.0 : v;\n" +
				"  }\n" +
				"  if (mode == MODE_LINEAR_BURN) {\n" +
				"    float v = cs + cd - 1.0; return v < 0.0 ? 0.0 : v;\n" +
				"  }\n" +
				"  if (mode == MODE_VIVID_LIGHT) return blendVividLight(cs, cd);\n" +
				"  if (mode == MODE_LINEAR_LIGHT) {\n" +
				"    float v = cd + 2.0*cs - 1.0; if (v < 0.0) return 0.0; if (v > 1.0) return 1.0; return v;\n" +
				"  }\n" +
				"  if (mode == MODE_PIN_LIGHT) return blendPinLight(cs, cd);\n" +
				"  if (mode == MODE_HARD_MIX) return blendHardMix(cs, cd);\n" +
				"  if (mode == MODE_DIFFERENCE) return abs(cd - cs);\n" +
				"  if (mode == MODE_EXCLUSION) return cd + cs - 2.0*cd*cs;\n" +
				"  if (mode == MODE_SUBTRACT) {\n float v = cd - cs; return v < 0.0 ? 0.0 : v; }\n" +
				"  if (mode == MODE_DIVIDE) {\n if (cs <= 0.0) return 1.0; float v = cd / cs; return v > 1.0 ? 1.0 : v; }\n" +
				"  if (mode == MODE_AVERAGE) return (cs + cd) / 2.0;\n" +
				"  if (mode == MODE_NEGATION) return 1.0 - abs(1.0 - cd - cs);\n" +
				"  return cs;\n" +
				"}\n" +
				"\n" +
				"float xor8(float a, float b) {\n" +
				"  float ai = floor(a * 255.0 + 0.5);\n" +
				"  float bi = floor(b * 255.0 + 0.5);\n" +
				"  float res = 0.0;\n" +
				"  float bit = 1.0;\n" +
				"  for (int i = 0; i < 8; i++) {\n" +
				"    float ab = mod(floor(ai / bit), 2.0);\n" +
				"    float bb = mod(floor(bi / bit), 2.0);\n" +
				"    float xb = mod(ab + bb, 2.0);\n" +
				"    res += xb * bit;\n" +
				"    bit *= 2.0;\n" +
				"  }\n" +
				"  return res / 255.0;\n" +
				"}\n" +
				"\n" +
				"vec3 blendRGB(int mode, vec3 cs, vec3 cd) {\n" +
				"  if (mode == MODE_DARKER_COLOR) return dot(cs, vec3(1.0)) < dot(cd, vec3(1.0)) ? cs : cd;\n" +
				"  if (mode == MODE_LIGHTER_COLOR) return dot(cs, vec3(1.0)) > dot(cd, vec3(1.0)) ? cs : cd;\n" +
				"  if (mode == MODE_XOR) return vec3(xor8(cs.r, cd.r), xor8(cs.g, cd.g), xor8(cs.b, cd.b));\n" +
				"  return vec3(blendSeparable(mode, cs.r, cd.r), blendSeparable(mode, cs.g, cd.g), blendSeparable(mode, cs.b, cd.b));\n" +
				"}\n" +
				"\n" +
				"vec3 blendNonSeparable(int mode, vec3 cs, vec3 cd) {\n" +
				"  vec3 hs = rgbToHsl(cs);\n" +
				"  vec3 hd = rgbToHsl(cd);\n" +
				"  if (mode == MODE_HUE) return hslToRgb(vec3(hs.x, hd.y, hd.z));\n" +
				"  if (mode == MODE_SATURATION) return hslToRgb(vec3(hd.x, hs.y, hd.z));\n" +
				"  if (mode == MODE_COLOR) return hslToRgb(vec3(hs.x, hs.y, hd.z));\n" +
				"  if (mode == MODE_LUMINOSITY) return hslToRgb(vec3(hd.x, hd.y, hs.z));\n" +
				"  return cs;\n" +
				"}\n" +
				"\n" +
				"vec4 blendRGBA(vec4 dst, vec4 src, int mode) {\n" +
				"  float sa = src.a;\n" +
				"  float da = dst.a;\n" +
				"  if (sa <= 0.0) return dst;\n" +
				"  if (da <= 0.0 && mode != MODE_DISSOLVE) return src;\n" +
				"  if (mode == MODE_DISSOLVE) return sa < 0.5 ? dst : src;\n" +
				"  vec3 br = blendRGB(mode, src.rgb, dst.rgb);\n" +
				"  if (mode == MODE_HUE || mode == MODE_SATURATION || mode == MODE_COLOR || mode == MODE_LUMINOSITY) {\n" +
				"    br = blendNonSeparable(mode, src.rgb, dst.rgb);\n" +
				"  }\n" +
				"  float ao = sa + da - sa * da;\n" +
				"  if (ao <= 0.0) return vec4(0.0);\n" +
				"  vec3 srp = src.rgb * sa;\n" +
				"  vec3 drp = dst.rgb * da;\n" +
				"  vec3 brp = br;\n" +
				"  vec3 outp = srp * (1.0 - da) + drp * (1.0 - sa) + brp * (sa * da);\n" +
				"  vec3 outc = outp / ao;\n" +
				"  return vec4(outc, ao);\n" +
				"}\n" +
				"\n" +
				"void main() {\n" +
				"  vec4 src = texture2D(uSrcTex, vSrcUV);\n" +
				"  if (uMode == MODE_COPY) {\n gl_FragColor = src; "+"return; }\n" +
				"  vec4 dst = texture2D(uDstTex, vDstUV);\n" +
				"  gl_FragColor = blendRGBA(dst, src, uMode);\n" +
				"}\n"
		}

		internal def ensureBlendProgram() !none {
			return none when blendReady

			let vsrc = blendVertexSource()
			let fsrc = blendFragmentSource()

			let vs = gl.glCreateShader(gl.GL_VERTEX_SHADER)
			let vsrcs string[]
			vsrcs.push(vsrc)
			let vlens int[]
			vlens.push(vsrc.len())
			gl.glShaderSource(vs, 1, vsrcs, vlens)
			gl.glCompileShader(vs)

			let ok int32[]
			ok.len(1)
			gl.glGetShaderiv(vs, gl.GL_COMPILE_STATUS, ok)
			if ok[0] == 0 {
				let logLen int32[]
				logLen.len(1)
				gl.glGetShaderiv(vs, gl.GL_INFO_LOG_LENGTH, logLen)
				let log byte[]
				log.len(int(logLen[0]))
				if log.len() > 0 {
					let outLen int32[]
					outLen.len(1)
					gl.glGetShaderInfoLog(vs, log.len(), outLen, log)
				}
				fail "vertex shader compile failed: " + string(log)
			}

			let fs = gl.glCreateShader(gl.GL_FRAGMENT_SHADER)
			let fsrcs string[]
			fsrcs.push(fsrc)
			let flens int[]
			flens.push(fsrc.len())
			gl.glShaderSource(fs, 1, fsrcs, flens)
			gl.glCompileShader(fs)
			gl.glGetShaderiv(fs, gl.GL_COMPILE_STATUS, ok)
			if ok[0] == 0 {
				let logLen int32[]
				logLen.len(1)
				gl.glGetShaderiv(fs, gl.GL_INFO_LOG_LENGTH, logLen)
				let log byte[]
				log.len(int(logLen[0]))
				if log.len() > 0 {
					let outLen int32[]
					outLen.len(1)
					gl.glGetShaderInfoLog(fs, log.len(), outLen, log)
				}
				fail "fragment shader compile failed: " + string(log)
			}

			let prog = gl.glCreateProgram()
			gl.glAttachShader(prog, vs)
			gl.glAttachShader(prog, fs)
			gl.glLinkProgram(prog)
			gl.glGetProgramiv(prog, gl.GL_LINK_STATUS, ok)
			if ok[0] == 0 {
				let logLen int32[]
				logLen.len(1)
				gl.glGetProgramiv(prog, gl.GL_INFO_LOG_LENGTH, logLen)
				let log byte[]
				log.len(int(logLen[0]))
				if log.len() > 0 {
					let outLen int32[]
					outLen.len(1)
					gl.glGetProgramInfoLog(prog, log.len(), outLen, log)
				}
				fail "blend program link failed: " + string(log)
			}

			gl.glDeleteShader(vs)
			gl.glDeleteShader(fs)

			blendProgram = prog
			blendPosAttr = gl.glGetAttribLocation(prog, "aPos")
			blendSrcAttr = gl.glGetAttribLocation(prog, "aSrcUV")
			blendDstAttr = gl.glGetAttribLocation(prog, "aDstUV")
			blendViewportUniform = gl.glGetUniformLocation(prog, "uViewport")
			blendModeUniform = gl.glGetUniformLocation(prog, "uMode")
			blendSrcTexUniform = gl.glGetUniformLocation(prog, "uSrcTex")
			blendDstTexUniform = gl.glGetUniformLocation(prog, "uDstTex")
			blendReady = true
			return none
		}

		internal def blendModeValue(mode color.BlendMode) int {
			return int(mode)
		}

		internal def drawBlendQuad(id uint, viewW int, viewH int, x int, y int, w int, h int, src byte[], mode int) !none {
			try ensureBlendProgram()
			ensureOffscreen(id, viewW, viewH)
			ensureBlitTexture(id, w, h, src)

			let dstTex = offscreenTex(id)
			let outTex = offscreenBackTex(id)
			let fbo = offscreenFBO[id]

			gl.glBindFramebuffer(gl.GL_FRAMEBUFFER, fbo)
			gl.glFramebufferTexture2D(gl.GL_FRAMEBUFFER, gl.GL_COLOR_ATTACHMENT0, gl.GL_TEXTURE_2D, outTex, 0)
			let status = gl.glCheckFramebufferStatus(gl.GL_FRAMEBUFFER)
			if status != gl.GL_FRAMEBUFFER_COMPLETE {
				// Context lost mid-frame (see commit): skip this draw.
				return none when glfw.glfwGetCurrentContext() == 0
				fail "framebuffer incomplete (blend): status={status} view={viewW}x{viewH} src={w}x{h} fbo={fbo} out={outTex} dst={dstTex}"
			}
			gl.glViewport(0, 0, viewW, viewH)
			gl.glDisable(gl.GL_BLEND)

			gl.glUseProgram(blendProgram)
			gl.glUniform2f(blendViewportUniform, float32(viewW), float32(viewH))

			gl.glEnable(gl.GL_TEXTURE_2D)
			gl.glActiveTexture(gl.GL_TEXTURE0)
			gl.glBindTexture(gl.GL_TEXTURE_2D, dstTex)
			gl.glUniform1i(blendDstTexUniform, 0)

			gl.glActiveTexture(gl.GL_TEXTURE1)
			gl.glBindTexture(gl.GL_TEXTURE_2D, dstTex)
			gl.glUniform1i(blendSrcTexUniform, 1)

			let fullVerts float32[]
			let fullSrcUV float32[]
			let fullDstUV float32[]
			let fLeft = 0.0
			let fTop = 0.0
			let fRight = float(viewW)
			let fBottom = float(viewH)

			fullVerts.push(float32(fLeft))
			fullVerts.push(float32(fTop))
			// Flip V so y=0 (top) maps to v=1 (top) in texture space.
			fullSrcUV.push(float32(0.0))
			fullSrcUV.push(float32(1.0))
			fullDstUV.push(float32(0.0))
			fullDstUV.push(float32(1.0))

			fullVerts.push(float32(fRight))
			fullVerts.push(float32(fTop))
			fullSrcUV.push(float32(1.0))
			fullSrcUV.push(float32(1.0))
			fullDstUV.push(float32(1.0))
			fullDstUV.push(float32(1.0))

			fullVerts.push(float32(fRight))
			fullVerts.push(float32(fBottom))
			fullSrcUV.push(float32(1.0))
			fullSrcUV.push(float32(0.0))
			fullDstUV.push(float32(1.0))
			fullDstUV.push(float32(0.0))

			fullVerts.push(float32(fLeft))
			fullVerts.push(float32(fTop))
			fullSrcUV.push(float32(0.0))
			fullSrcUV.push(float32(1.0))
			fullDstUV.push(float32(0.0))
			fullDstUV.push(float32(1.0))

			fullVerts.push(float32(fRight))
			fullVerts.push(float32(fBottom))
			fullSrcUV.push(float32(1.0))
			fullSrcUV.push(float32(0.0))
			fullDstUV.push(float32(1.0))
			fullDstUV.push(float32(0.0))

			fullVerts.push(float32(fLeft))
			fullVerts.push(float32(fBottom))
			fullSrcUV.push(float32(0.0))
			fullSrcUV.push(float32(0.0))
			fullDstUV.push(float32(0.0))
			fullDstUV.push(float32(0.0))

			gl.glUniform1i(blendModeUniform, 100)
			gl.glEnableVertexAttribArray(blendPosAttr)
			gl.glEnableVertexAttribArray(blendSrcAttr)
			gl.glEnableVertexAttribArray(blendDstAttr)

			gl.glVertexAttribPointer(blendPosAttr, 2, gl.GL_FLOAT, false, 0, fullVerts)
			gl.glVertexAttribPointer(blendSrcAttr, 2, gl.GL_FLOAT, false, 0, fullSrcUV)
			gl.glVertexAttribPointer(blendDstAttr, 2, gl.GL_FLOAT, false, 0, fullDstUV)
			gl.glDrawArrays(gl.GL_TRIANGLES, 0, 6)

			gl.glActiveTexture(gl.GL_TEXTURE1)
			gl.glBindTexture(gl.GL_TEXTURE_2D, blitTexIDs[id])
			gl.glUniform1i(blendSrcTexUniform, 1)
			gl.glUniform1i(blendModeUniform, mode)

			let left = float(x)
			let top = float(y)
			let right = float(x + w)
			let bottom = float(y + h)

			let verts float32[]
			let srcUV float32[]
			let dstUV float32[]

			let u0 = 0.0
			let v0 = 0.0
			let u1 = 1.0
			let v1 = 1.0

			let du0 = left / float(viewW)
			let du1 = right / float(viewW)
			// dstTex is a GL texture (v=0 is bottom). Our coordinates are y=0 at top.
			let dv0 = 1.0 - (top / float(viewH))
			let dv1 = 1.0 - (bottom / float(viewH))

			verts.push(float32(left))
			verts.push(float32(top))
			srcUV.push(float32(u0))
			srcUV.push(float32(v0))
			dstUV.push(float32(du0))
			dstUV.push(float32(dv0))

			verts.push(float32(right))
			verts.push(float32(top))
			srcUV.push(float32(u1))
			srcUV.push(float32(v0))
			dstUV.push(float32(du1))
			dstUV.push(float32(dv0))

			verts.push(float32(right))
			verts.push(float32(bottom))
			srcUV.push(float32(u1))
			srcUV.push(float32(v1))
			dstUV.push(float32(du1))
			dstUV.push(float32(dv1))

			verts.push(float32(left))
			verts.push(float32(top))
			srcUV.push(float32(u0))
			srcUV.push(float32(v0))
			dstUV.push(float32(du0))
			dstUV.push(float32(dv0))

			verts.push(float32(right))
			verts.push(float32(bottom))
			srcUV.push(float32(u1))
			srcUV.push(float32(v1))
			dstUV.push(float32(du1))
			dstUV.push(float32(dv1))

			verts.push(float32(left))
			verts.push(float32(bottom))
			srcUV.push(float32(u0))
			srcUV.push(float32(v1))
			dstUV.push(float32(du0))
			dstUV.push(float32(dv1))

			gl.glVertexAttribPointer(blendPosAttr, 2, gl.GL_FLOAT, false, 0, verts)
			gl.glVertexAttribPointer(blendSrcAttr, 2, gl.GL_FLOAT, false, 0, srcUV)
			gl.glVertexAttribPointer(blendDstAttr, 2, gl.GL_FLOAT, false, 0, dstUV)

			gl.glDrawArrays(gl.GL_TRIANGLES, 0, 6)

			gl.glDisableVertexAttribArray(blendPosAttr)
			gl.glDisableVertexAttribArray(blendSrcAttr)
			gl.glDisableVertexAttribArray(blendDstAttr)

			gl.glUseProgram(0)
			gl.glActiveTexture(gl.GL_TEXTURE0)
			gl.glDisable(gl.GL_TEXTURE_2D)
			gl.glEnable(gl.GL_BLEND)
			gl.glBlendFunc(gl.GL_SRC_ALPHA, gl.GL_ONE_MINUS_SRC_ALPHA)
			gl.glBlendEquation(gl.GL_FUNC_ADD)

			swapOffscreen(id)
			let nextTex = offscreenTex(id)
			gl.glBindFramebuffer(gl.GL_FRAMEBUFFER, fbo)
			gl.glFramebufferTexture2D(gl.GL_FRAMEBUFFER, gl.GL_COLOR_ATTACHMENT0, gl.GL_TEXTURE_2D, nextTex, 0)
			return none
		}

		internal def presentOffscreen(id uint, fbW int, fbH int, viewW int, viewH int) {
			let tex = offscreenTex(id)
			gl.glBindFramebuffer(gl.GL_FRAMEBUFFER, 0)
			gl.glViewport(0, 0, fbW, fbH)

			gl.glDisable(gl.GL_BLEND)
			gl.glEnable(gl.GL_TEXTURE_2D)
			gl.glActiveTexture(gl.GL_TEXTURE0)
			gl.glBindTexture(gl.GL_TEXTURE_2D, tex)

			gl.glMatrixMode(gl.GL_PROJECTION)
			gl.glLoadIdentity()
			gl.glOrtho(float64(0.0), float64(viewW), float64(viewH), float64(0.0), float64(-1.0), float64(1.0))

			gl.glMatrixMode(gl.GL_MODELVIEW)
			gl.glLoadIdentity()

			let verts float32[]
			let uvs float32[]
			let colors byte[]
			let white = color.RGBA{r: 255, g: 255, b: 255, a: 255}

			// Flip V so the offscreen framebuffer (y=0 at top) presents upright.
			pushVertexRGBA(verts, uvs, colors, 0.0, 0.0, 0.0, 1.0, white)
			pushVertexRGBA(verts, uvs, colors, float(viewW), 0.0, 1.0, 1.0, white)
			pushVertexRGBA(verts, uvs, colors, float(viewW), float(viewH), 1.0, 0.0, white)

			pushVertexRGBA(verts, uvs, colors, 0.0, 0.0, 0.0, 1.0, white)
			pushVertexRGBA(verts, uvs, colors, float(viewW), float(viewH), 1.0, 0.0, white)
			pushVertexRGBA(verts, uvs, colors, 0.0, float(viewH), 0.0, 0.0, white)

			batchFlush(verts, uvs, colors, true, tex, false)
			gl.glDisable(gl.GL_TEXTURE_2D)
			gl.glEnable(gl.GL_BLEND)
		}

		internal def applyBlendMode(mode color.BlendMode) !none {
			switch mode {
				case color.BlendMode.Normal:
					gl.glBlendFunc(gl.GL_SRC_ALPHA, gl.GL_ONE_MINUS_SRC_ALPHA)
					gl.glBlendEquation(gl.GL_FUNC_ADD)
				case color.BlendMode.LinearDodge:
					gl.glBlendFunc(gl.GL_SRC_ALPHA, gl.GL_ONE)
					gl.glBlendEquation(gl.GL_FUNC_ADD)
				case color.BlendMode.Subtract:
					gl.glBlendFunc(gl.GL_SRC_ALPHA, gl.GL_ONE)
					gl.glBlendEquation(gl.GL_FUNC_REVERSE_SUBTRACT)
				case color.BlendMode.Difference:
					gl.glBlendFunc(gl.GL_ONE, gl.GL_ONE)
					gl.glBlendEquation(gl.GL_FUNC_REVERSE_SUBTRACT)
				case color.BlendMode.Multiply:
					gl.glBlendFunc(gl.GL_DST_COLOR, gl.GL_ONE_MINUS_SRC_ALPHA)
					gl.glBlendEquation(gl.GL_FUNC_ADD)
				case color.BlendMode.Screen:
					gl.glBlendFunc(gl.GL_ONE, gl.GL_ONE_MINUS_SRC_COLOR)
					gl.glBlendEquation(gl.GL_FUNC_ADD)
				case color.BlendMode.Xor:
					gl.glBlendFunc(gl.GL_ONE_MINUS_DST_ALPHA, gl.GL_ONE_MINUS_SRC_ALPHA)
					gl.glBlendEquation(gl.GL_FUNC_ADD)
				default:
					fail "blend mode not supported on GPU"
			}
			return none
		}

		internal def drawBlitQuad(x int, y int, w int, h int) {
			let x0 = float32(x)
			let y0 = float32(y)
			let x1 = float32(x + w)
			let y1 = float32(y + h)

			gl.glBegin(gl.GL_TRIANGLES)
			// tri 1
			gl.glTexCoord2f(0, 0)
			gl.glVertex2f(x0, y0)
			gl.glTexCoord2f(1, 0)
			gl.glVertex2f(x1, y0)
			gl.glTexCoord2f(1, 1)
			gl.glVertex2f(x1, y1)
			// tri 2
			gl.glTexCoord2f(0, 0)
			gl.glVertex2f(x0, y0)
			gl.glTexCoord2f(1, 1)
			gl.glVertex2f(x1, y1)
			gl.glTexCoord2f(0, 1)
			gl.glVertex2f(x0, y1)
			gl.glEnd()
		}

		internal def swapRGBAtoBGRA(src byte[]) byte[] {
			let out byte[]
			out.len(src.len())
			let n = src.len()
			for let i = 0; i + 3 < n; i = i + 4 {
				out[i + 0] = src[i + 2]
				out[i + 1] = src[i + 1]
				out[i + 2] = src[i + 0]
				out[i + 3] = src[i + 3]
			}
			return out
		}

		internal def drawEllipseFan(center geom.Point, rx float, ry float, filled bool) {
			let segments = circleSegments(rx, ry)
			let step = math.τ / float(segments)

			if filled {
				gl.glBegin(gl.GL_TRIANGLE_FAN)
				gl.glVertex2f(float32(center.x), float32(center.y))
			} else {
				gl.glBegin(gl.GL_LINE_LOOP)
			}

			for let i = 0; i <= segments; i = i + 1 {
				let ang = step * float(i)
				let x = center.x + math.cos(ang) * rx
				let y = center.y + math.sin(ang) * ry
				gl.glVertex2f(float32(x), float32(y))
			}

			gl.glEnd()
		}

		internal def commitCPU(id uint, frame r.Frame) !none {
			let cv = canvases[id]
			cv.apply(frame.ctx)
			let w = cv.width
			let h = cv.height

			// Present to the actual framebuffer dimensions (canvas is typically kept
			// in sync, but querying here avoids visible jumping during live resize).
			let (fbW, fbH, _) = framebufferSize(id)
			// If the window was resized *after* nextFrame() but before commit(), the
			// frame's canvas/texture no longer match the framebuffer.
			//
			// Instead of uploading (which can cause visible squish/stretch artifacts),
			// present the last uploaded texture 1:1 in the top-left and let the next
			// loop iteration redraw at the new size.
			if fbW != w || fbH != h {
				gl.glViewport(0, 0, fbW, fbH)

				// Clear first so we never see stale backbuffer pixels.
				gl.glClearColor(0, 0, 0, 1)
				gl.glClear(gl.GL_COLOR_BUFFER_BIT)

				// Draw the existing texture without stretching.
				gl.glBindTexture(gl.GL_TEXTURE_2D, presentTex(id))
				gl.glEnable(gl.GL_TEXTURE_2D)

				gl.glMatrixMode(gl.GL_PROJECTION)
				gl.glLoadIdentity()
				// Pixel coordinates with origin at top-left.
				gl.glOrtho(float64(0.0), float64(fbW), float64(fbH), float64(0.0), float64(-1.0), float64(1.0))

				gl.glMatrixMode(gl.GL_MODELVIEW)
				gl.glLoadIdentity()

				// Draw without scaling:
				// - If the framebuffer is larger than the last uploaded texture, show it 1:1 at (0,0).
				// - If the framebuffer is smaller, crop the texture (show top-left portion) instead of scaling.
				let texW = w
				let texH = h
				if presentSizes.hasKey(id) {
					let ts = presentSizes[id]
					texW = int(ts.width)
					texH = int(ts.height)
				}

				let drawW = texW
				let drawH = texH
				drawW = fbW when drawW > fbW
				drawH = fbH when drawH > fbH

				let uMax = float32(float(drawW) / float(texW))
				let vMax = float32(float(drawH) / float(texH))

				gl.glBegin(gl.GL_TRIANGLES)
				// tri 1
				// Keep the same Y orientation as the normal present path (canvas top at v=0).
				gl.glTexCoord2f(0, 0)
				gl.glVertex2f(0, 0)
				gl.glTexCoord2f(uMax, 0)
				gl.glVertex2f(float32(drawW), 0)
				gl.glTexCoord2f(uMax, vMax)
				gl.glVertex2f(float32(drawW), float32(drawH))
				// tri 2
				gl.glTexCoord2f(0, 0)
				gl.glVertex2f(0, 0)
				gl.glTexCoord2f(uMax, vMax)
				gl.glVertex2f(float32(drawW), float32(drawH))
				gl.glTexCoord2f(0, vMax)
				gl.glVertex2f(0, float32(drawH))
				gl.glEnd()

				gl.glDisable(gl.GL_TEXTURE_2D)

				glfw.glfwSwapBuffers(id)
				return none
			}

			gl.glViewport(0, 0, fbW, fbH)

			// Upload the CPU canvas to a texture and draw a fullscreen quad.
			// This is dramatically faster than glDrawPixels on most drivers and
			// avoids black flashes during resize because we always overwrite the frame.
			ensurePresentTextures(id, w, h)
			let back = presentBackTex(id)
			gl.glBindTexture(gl.GL_TEXTURE_2D, back)
			gl.glPixelStorei(gl.GL_UNPACK_ALIGNMENT, 1)
			gl.glTexSubImage2D(gl.GL_TEXTURE_2D, 0, 0, 0, w, h, gl.GL_RGBA, gl.GL_UNSIGNED_BYTE, cv.bytes())

			// Clear first so we never see stale backbuffer pixels.
			gl.glClearColor(0, 0, 0, 1)
			gl.glClear(gl.GL_COLOR_BUFFER_BIT)

			gl.glEnable(gl.GL_TEXTURE_2D)
			gl.glBindTexture(gl.GL_TEXTURE_2D, back)

			gl.glMatrixMode(gl.GL_PROJECTION)
			gl.glLoadIdentity()
			gl.glOrtho(float64(-1.0), float64(1.0), float64(-1.0), float64(1.0), float64(-1.0), float64(1.0))

			gl.glMatrixMode(gl.GL_MODELVIEW)
			gl.glLoadIdentity()

			// Note: Flip V so the canvas (y=0 at top) appears upright.
			gl.glBegin(gl.GL_TRIANGLES)
			// tri 1
			gl.glTexCoord2f(0, 1)
			gl.glVertex2f(-1, -1)
			gl.glTexCoord2f(1, 1)
			gl.glVertex2f(1, -1)
			gl.glTexCoord2f(1, 0)
			gl.glVertex2f(1, 1)
			// tri 2
			gl.glTexCoord2f(0, 1)
			gl.glVertex2f(-1, -1)
			gl.glTexCoord2f(1, 0)
			gl.glVertex2f(1, 1)
			gl.glTexCoord2f(0, 0)
			gl.glVertex2f(-1, 1)
			gl.glEnd()

			gl.glDisable(gl.GL_TEXTURE_2D)
			swapPresent(id)

			glfw.glfwSwapBuffers(id)
			return none
		}

		internal def commitGPU(id uint, frame r.Frame) !none {
			let (fbW, fbH, _) = framebufferSize(id)
			let viewport = frame.ctx.size()
			let viewW = int(viewport.width)
			let viewH = int(viewport.height)
			viewW = fbW when viewW <= 0
			viewH = fbH when viewH <= 0

			ensureOffscreen(id, viewW, viewH)
			let fbo = offscreenFBO[id]
			let tex = offscreenTex(id)
			gl.glBindFramebuffer(gl.GL_FRAMEBUFFER, fbo)
			gl.glFramebufferTexture2D(gl.GL_FRAMEBUFFER, gl.GL_COLOR_ATTACHMENT0, gl.GL_TEXTURE_2D, tex, 0)
			let status = gl.glCheckFramebufferStatus(gl.GL_FRAMEBUFFER)
			if status != gl.GL_FRAMEBUFFER_COMPLETE {
				// Context lost mid-frame (see commit): skip the frame.
				return none when glfw.glfwGetCurrentContext() == 0
				fail "framebuffer incomplete (commit): status={status} view={viewW}x{viewH} fb={fbW}x{fbH} fbo={fbo} tex={tex}"
			}

			gl.glViewport(0, 0, viewW, viewH)
			gl.glDisable(gl.GL_TEXTURE_2D)
			gl.glEnable(gl.GL_BLEND)
			gl.glBlendFunc(gl.GL_SRC_ALPHA, gl.GL_ONE_MINUS_SRC_ALPHA)
			gl.glBlendEquation(gl.GL_FUNC_ADD)

			gl.glMatrixMode(gl.GL_PROJECTION)
			gl.glLoadIdentity()
			gl.glOrtho(float64(0.0), float64(viewW), float64(viewH), float64(0.0), float64(-1.0), float64(1.0))

			gl.glMatrixMode(gl.GL_MODELVIEW)
			gl.glLoadIdentity()

			gl.glEnableClientState(gl.GL_VERTEX_ARRAY)
			gl.glEnableClientState(gl.GL_COLOR_ARRAY)
			gl.glEnableClientState(gl.GL_TEXTURE_COORD_ARRAY)

			let verts float32[]
			let uvs float32[]
			let colors byte[]

			for let (_, cmd) in frame.ctx.commands() {
				switch cmd.kind {
					case render.CommandKind.Clear:
						batchFlush(verts, uvs, colors, false, 0, true)
						let rgba = cmd.color.rgba
						gl.glClearColor(float32(float(rgba.r) / 255.0), float32(float(rgba.g) / 255.0), float32(float(rgba.b) / 255.0), float32(float(rgba.a) / 255.0))
						gl.glClear(gl.GL_COLOR_BUFFER_BIT)
					case render.CommandKind.FillRect:
						batchRect(verts, uvs, colors, cmd.rect.left, cmd.rect.top, cmd.rect.right, cmd.rect.bottom, cmd.color.rgba)
					case render.CommandKind.StrokeRect:
						let lw = cmd.strokeWidth
						lw = 1.0 when lw <= 0.0
						let rgba = cmd.color.rgba
						batchRect(verts, uvs, colors, cmd.rect.left, cmd.rect.top, cmd.rect.right, cmd.rect.top + lw, rgba)
						batchRect(verts, uvs, colors, cmd.rect.left, cmd.rect.bottom - lw, cmd.rect.right, cmd.rect.bottom, rgba)
						batchRect(verts, uvs, colors, cmd.rect.left, cmd.rect.top + lw, cmd.rect.left + lw, cmd.rect.bottom - lw, rgba)
						batchRect(verts, uvs, colors, cmd.rect.right - lw, cmd.rect.top + lw, cmd.rect.right, cmd.rect.bottom - lw, rgba)
					case render.CommandKind.Line:
						let lw = cmd.strokeWidth
						lw = 1.0 when lw <= 0.0
						batchLineQuad(verts, uvs, colors, cmd.p0, cmd.p1, lw, cmd.color.rgba)
					case render.CommandKind.Polyline:
						let lw = cmd.strokeWidth
						lw = 1.0 when lw <= 0.0
						for let i = 0; i + 1 < cmd.points.len(); i = i + 1 {
							batchLineQuad(verts, uvs, colors, cmd.points[i], cmd.points[i + 1], lw, cmd.color.rgba)
						}
					case render.CommandKind.Polygon:
						batchPolygonFan(verts, uvs, colors, cmd.points, cmd.color.rgba)
					case render.CommandKind.FillCircle:
						batchEllipseFan(verts, uvs, colors, cmd.center, cmd.radius, cmd.radius, cmd.color.rgba)
					case render.CommandKind.StrokeCircle:
						let lw = cmd.strokeWidth
						lw = 1.0 when lw <= 0.0
						batchEllipseStroke(verts, uvs, colors, cmd.center, cmd.radius, cmd.radius, lw, cmd.color.rgba)
					case render.CommandKind.FillEllipse:
						batchEllipseFan(verts, uvs, colors, cmd.center, cmd.rx, cmd.ry, cmd.color.rgba)
					case render.CommandKind.StrokeEllipse:
						let lw = cmd.strokeWidth
						lw = 1.0 when lw <= 0.0
						batchEllipseStroke(verts, uvs, colors, cmd.center, cmd.rx, cmd.ry, lw, cmd.color.rgba)
					case render.CommandKind.FillTriangle:
						let rgba = cmd.color.rgba
						pushVertexRGBA(verts, uvs, colors, cmd.p0.x, cmd.p0.y, 0, 0, rgba)
						pushVertexRGBA(verts, uvs, colors, cmd.p1.x, cmd.p1.y, 0, 0, rgba)
						pushVertexRGBA(verts, uvs, colors, cmd.p2.x, cmd.p2.y, 0, 0, rgba)
					case render.CommandKind.StrokeTriangle:
						let lw = cmd.strokeWidth
						lw = 1.0 when lw <= 0.0
						let rgba = cmd.color.rgba
						batchLineQuad(verts, uvs, colors, cmd.p0, cmd.p1, lw, rgba)
						batchLineQuad(verts, uvs, colors, cmd.p1, cmd.p2, lw, rgba)
						batchLineQuad(verts, uvs, colors, cmd.p2, cmd.p0, lw, rgba)
					case render.CommandKind.BlitCopy:
						let w = cmd.srcW
						let h = cmd.srcH
						let want = w * h * 4
						continue when w <= 0 || h <= 0 || want <= 0 || cmd.src.len() < want

						batchFlush(verts, uvs, colors, false, 0, true)
						try drawBlendQuad(id, viewW, viewH, cmd.x, cmd.y, w, h, cmd.src, 100)
					case render.CommandKind.Blit:
						let w = cmd.srcW
						let h = cmd.srcH
						let want = w * h * 4
						continue when w <= 0 || h <= 0 || want <= 0 || cmd.src.len() < want

						batchFlush(verts, uvs, colors, false, 0, true)
						try drawBlendQuad(id, viewW, viewH, cmd.x, cmd.y, w, h, cmd.src, blendModeValue(cmd.mode))
					case render.CommandKind.BlitRGBAtoBGRA:
						let w = cmd.srcW
						let h = cmd.srcH
						let want = w * h * 4
						continue when w <= 0 || h <= 0 || want <= 0 || cmd.src.len() < want

						let swapped = swapRGBAtoBGRA(cmd.src)
						batchFlush(verts, uvs, colors, false, 0, true)
						try drawBlendQuad(id, viewW, viewH, cmd.x, cmd.y, w, h, swapped, blendModeValue(color.BlendMode.Normal))
				}
			}

			batchFlush(verts, uvs, colors, false, 0, true)

			presentOffscreen(id, fbW, fbH, viewW, viewH)

			gl.glDisableClientState(gl.GL_VERTEX_ARRAY)
			gl.glDisableClientState(gl.GL_COLOR_ARRAY)
			gl.glDisableClientState(gl.GL_TEXTURE_COORD_ARRAY)

			glfw.glfwSwapBuffers(id)
			return none
		}

		def nextFrame(win r.Window) !r.Frame {
			ensureState()
			// For now we record draw commands and rasterize into a CPU canvas during commit.
			if !canvases.hasKey(win.id()) {
				fail "unknown window"
			}

			let id = win.id()
			// Always query the current framebuffer size here to keep the draw surface
			// stable during interactive resize (some platforms batch/lag events).
			let (fbW, fbH, sz) = framebufferSize(id)
			fbSizes = fbSizes.set(id, sz)

			let cur = canvases[id]
			if cur.width != fbW || cur.height != fbH {
				canvases = canvases.set(id, new canvas.Canvas(fbW, fbH))
			}

			let ctx = new canvas.DrawContext(new geom.Size(float(fbW), float(fbH)))
			return r.Frame{ctx: ctx}
		}

		def commit(win r.Window, frame r.Frame) !none {
			ensureState()
			let id = win.id()
			fail "unknown window" when !windows.hasKey(id)
			fail "unknown window" when !canvases.hasKey(id)

			glfw.glfwMakeContextCurrent(id)
			if glfw.glfwGetCurrentContext() == 0 {
				// The drawable can be transiently invalid while the window
				// manager hides or resizes the window; glfwMakeContextCurrent
				// then fails silently (only an error callback would see it) and
				// leaves NO context current, so every GL call in the frame
				// errors — glCheckFramebufferStatus returns 0, historically
				// misreported as "framebuffer incomplete". Retry once, then
				// skip the frame rather than kill the application.
				glfw.glfwMakeContextCurrent(id)
				return none when glfw.glfwGetCurrentContext() == 0
			}
			if forceCPU || !canUseGPU(frame.ctx) {
				return commitCPU(id, frame)
			}

			return commitGPU(id, frame)
		}

		def closeWindow(win r.Window) !none {
			ensureState()
			let id = win.id()
			if windows.hasKey(id) {
				windows = windows.delete(id)
			}
			if canvases.hasKey(id) {
				canvases = canvases.delete(id)
			}
			if fbSizes.hasKey(id) {
				fbSizes = fbSizes.delete(id)
			}
			if cursor.hasKey(id) {
				cursor = cursor.delete(id)
			}
			if hover.hasKey(id) {
				hover = hover.delete(id)
			}
			if focus.hasKey(id) {
				focus = focus.delete(id)
			}
			if mouse.hasKey(id) {
				mouse = mouse.delete(id)
			}
			if keys.hasKey(id) {
				keys = keys.delete(id)
			}

			if texIDs.hasKey(id) {
				let tex uint32[]
				tex.len(1)
				tex[0] = texIDs[id]
				glfw.glfwMakeContextCurrent(id)
				gl.glDeleteTextures(1, tex)
				texIDs = texIDs.delete(id)
			}
			if texSizes.hasKey(id) {
				texSizes = texSizes.delete(id)
			}
			if presentA.hasKey(id) {
				let tex uint32[]
				tex.len(1)
				tex[0] = presentA[id]
				glfw.glfwMakeContextCurrent(id)
				gl.glDeleteTextures(1, tex)
				presentA = presentA.delete(id)
			}
			if presentB.hasKey(id) {
				let tex uint32[]
				tex.len(1)
				tex[0] = presentB[id]
				glfw.glfwMakeContextCurrent(id)
				gl.glDeleteTextures(1, tex)
				presentB = presentB.delete(id)
			}
			if presentSizes.hasKey(id) {
				presentSizes = presentSizes.delete(id)
			}
			if presentIndex.hasKey(id) {
				presentIndex = presentIndex.delete(id)
			}
			if blitTexIDs.hasKey(id) {
				let tex uint32[]
				tex.len(1)
				tex[0] = blitTexIDs[id]
				glfw.glfwMakeContextCurrent(id)
				gl.glDeleteTextures(1, tex)
				blitTexIDs = blitTexIDs.delete(id)
			}
			if blitTexSizes.hasKey(id) {
				blitTexSizes = blitTexSizes.delete(id)
			}

			if offscreenA.hasKey(id) {
				let tex uint32[]
				tex.len(1)
				tex[0] = offscreenA[id]
				glfw.glfwMakeContextCurrent(id)
				gl.glDeleteTextures(1, tex)
				offscreenA = offscreenA.delete(id)
			}
			if offscreenB.hasKey(id) {
				let tex uint32[]
				tex.len(1)
				tex[0] = offscreenB[id]
				glfw.glfwMakeContextCurrent(id)
				gl.glDeleteTextures(1, tex)
				offscreenB = offscreenB.delete(id)
			}
			if offscreenFBO.hasKey(id) {
				let fbo uint32[]
				fbo.len(1)
				fbo[0] = offscreenFBO[id]
				glfw.glfwMakeContextCurrent(id)
				gl.glDeleteFramebuffers(1, fbo)
				offscreenFBO = offscreenFBO.delete(id)
			}
			if offscreenSize.hasKey(id) {
				offscreenSize = offscreenSize.delete(id)
			}
			if offscreenIndex.hasKey(id) {
				offscreenIndex = offscreenIndex.delete(id)
			}

			glfw.glfwDestroyWindow(id)

			// Terminate when last window closes.
			if windows.len() == 0 && started {
				glfw.glfwTerminate()
				started = false
			}
			return none
		}
	}
}
