partial module std.ui.renderer.opengl {
	use std.testing

	check "OpenGL renderer" {
		@test()
		def swaps_red_and_blue() {
			// 37 pixels: four vectors and a tail.
			let src byte[]
			src.len(37 * 4)
			for let i = 0; i < src.len(); i++ {
				src[i] = byte(i * 7 + 3)
			}
			let out = swapRGBAtoBGRA(src)
			assert out.len() == src.len()
			for let i = 0; i < src.len(); i += 4 {
				assert out[i] == src[i + 2] && out[i + 1] == src[i + 1] && out[i + 2] == src[i] && out[i + 3] == src[i + 3]
			}
		}
	}
}
