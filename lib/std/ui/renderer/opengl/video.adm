partial module std.ui.renderer.opengl {
	use (
		std.gfx.render as render
		std.gfx.processing.transform::(FitMode)
		std.formats.video as video
		std.ui.renderer.opengl.gl
	)

	// The textures a window draws video frames through: luma, the two
	// chroma planes, and interleaved chroma (NV12, from the GPU decoder),
	// with the size and format each holds.
	internal type VideoTextures {
		ids     uint32[]
		widths  int[]
		heights int[]
		formats uint32[]

		def new() {
			ids = uint32[]
			ids.len(4)
			gl.glGenTextures(4, ids)
			widths = int[0, 0, 0, 0]
			heights = int[0, 0, 0, 0]
			formats = uint32[uint32(0), uint32(0), uint32(0), uint32(0)]
		}

		// Binds texture `k` and gives it `w` x `h` texels of `format`,
		// reallocating it when it held another size or format. `data` fills
		// a fresh allocation; empty leaves it zeroed.
		def ensure(k int, w int, h int, format uint32, data byte[]) {
			gl.glBindTexture(gl.GL_TEXTURE_2D, ids[k])
			return when widths[k] == w && heights[k] == h && formats[k] == format
			widths[k] = w
			heights[k] = h
			formats[k] = format
			gl.glTexParameteri(gl.GL_TEXTURE_2D, gl.GL_TEXTURE_MIN_FILTER, int(gl.GL_LINEAR))
			gl.glTexParameteri(gl.GL_TEXTURE_2D, gl.GL_TEXTURE_MAG_FILTER, int(gl.GL_LINEAR))
			let (pixelFormat, pixelType, bytes) = videoTexelFormat(format)
			let zero = data
			if zero.len() < w * h * bytes {
				zero = byte[]
				zero.len(w * h * bytes)
			}
			gl.glPixelStorei(gl.GL_UNPACK_ROW_LENGTH, 0)
			gl.glTexImage2D(gl.GL_TEXTURE_2D, 0, int(format), w, h, 0, pixelFormat, pixelType, zero)
		}

		// Loads a plane of `w` x `h` samples, `stride` bytes apart, into
		// texture `k`: 8-bit samples, or 16-bit when `wide`.
		def load(k int, plane byte[], w int, h int, stride int, wide bool) {
			let format = wide ?? (gl.GL_R16, gl.GL_R8)
			let bytes = wide ?? (2, 1)
			ensure(k, w, h, format, byte[])
			gl.glPixelStorei(gl.GL_UNPACK_ALIGNMENT, 1)
			gl.glPixelStorei(gl.GL_UNPACK_ROW_LENGTH, stride / bytes)
			gl.glTexSubImage2D(gl.GL_TEXTURE_2D, 0, 0, 0, w, h, gl.GL_RED, wide ?? (gl.GL_UNSIGNED_SHORT, gl.GL_UNSIGNED_BYTE), plane)
			gl.glPixelStorei(gl.GL_UNPACK_ROW_LENGTH, 0)
		}

		// Sets how texture `k` samples outside 0..1: repeating for tiles.
		def wrap(k int, repeat bool) {
			gl.glBindTexture(gl.GL_TEXTURE_2D, ids[k])
			let mode = int(repeat ?? (gl.GL_REPEAT, gl.GL_CLAMP_TO_EDGE))
			gl.glTexParameteri(gl.GL_TEXTURE_2D, gl.GL_TEXTURE_WRAP_S, mode)
			gl.glTexParameteri(gl.GL_TEXTURE_2D, gl.GL_TEXTURE_WRAP_T, mode)
		}
	}

	// The pixel format, component type and bytes per texel of a sized
	// texture format.
	internal def videoTexelFormat(format uint32) (uint32, uint32, int) {
		return (gl.GL_RG, gl.GL_UNSIGNED_BYTE, 2) when format == gl.GL_RG8
		return (gl.GL_RED, gl.GL_UNSIGNED_SHORT, 2) when format == gl.GL_R16
		return (gl.GL_RED, gl.GL_UNSIGNED_BYTE, 1)
	}

	// Draws video frames: the Y'CbCr planes as textures, converted to RGB by
	// a shader. A frame kept on the GPU is copied into the textures there.
	internal type VideoLayer {
		program   uint32
		posAttr   int
		uvAttr    int
		viewport  int
		lumaUnit  int
		cbUnit    int
		crUnit    int
		cbcrUnit  int
		nv12      int
		lumaScale int
		chromaScale int
		full      int
		bt709     int
		textures  map<uint, VideoTextures>

		def new(program uint32) {
			self.program = program
			textures = map<uint, VideoTextures>{}
			posAttr = gl.glGetAttribLocation(program, "aPos")
			uvAttr = gl.glGetAttribLocation(program, "aUV")
			viewport = gl.glGetUniformLocation(program, "uViewport")
			lumaUnit = gl.glGetUniformLocation(program, "uY")
			cbUnit = gl.glGetUniformLocation(program, "uCb")
			crUnit = gl.glGetUniformLocation(program, "uCr")
			cbcrUnit = gl.glGetUniformLocation(program, "uCbCr")
			nv12 = gl.glGetUniformLocation(program, "uNv12")
			lumaScale = gl.glGetUniformLocation(program, "uLumaScale")
			chromaScale = gl.glGetUniformLocation(program, "uChromaScale")
			full = gl.glGetUniformLocation(program, "uFull")
			bt709 = gl.glGetUniformLocation(program, "uBt709")
		}

		// The textures of window `id`, made on first use.
		def texturesOf(id uint) VideoTextures {
			let found = textures.get(id)
			return found unless found is none
			let made = new VideoTextures()
			textures = textures.set(id, made)
			return made
		}

		// Draws a Video command into the bound framebuffer, `viewW` x `viewH`.
		// The caller fills the command's rectangle black first.
		def draw(id uint, viewW int, viewH int, cmd render.DrawCommand) {
			let frame = cmd.video
			return when frame is none
			let fw = int(frame.width)
			let fh = int(frame.height)
			let ax = cmd.rect.left
			let ay = cmd.rect.top
			let aw = cmd.rect.right - cmd.rect.left
			let ah = cmd.rect.bottom - cmd.rect.top
			return when fw <= 0 || fh <= 0 || aw <= 0.0 || ah <= 0.0
			let tex = texturesOf(id)
			let ok = upload(tex, frame)
			return unless ok
			// Where the picture lands and which part of it shows.
			let tile = cmd.fit == FitMode.Tile
			let x0 = ax
			let y0 = ay
			let x1 = ax + aw
			let y1 = ay + ah
			let u0 = 0.0
			let v0 = 0.0
			let u1 = aw / float(fw)
			let v1 = ah / float(fh)
			if !tile {
				let (dw, dh) = video.fittedSize(fw, fh, int(aw), int(ah), cmd.fit)
				return when dw <= 0 || dh <= 0
				let px = ax + (aw - float(dw)) / 2.0
				let py = ay + (ah - float(dh)) / 2.0
				x0 = px.max(ax)
				y0 = py.max(ay)
				x1 = (px + float(dw)).min(ax + aw)
				y1 = (py + float(dh)).min(ay + ah)
				u0 = (x0 - px) / float(dw)
				v0 = (y0 - py) / float(dh)
				u1 = (x1 - px) / float(dw)
				v1 = (y1 - py) / float(dh)
			}
			for let k = 0; k < 4; k++ {
				tex.wrap(k, tile)
			}
			gl.glUseProgram(program)
			gl.glUniform2f(viewport, float32(viewW), float32(viewH))
			for let k = 0; k < 4; k++ {
				gl.glActiveTexture(gl.GL_TEXTURE0 + uint32(k))
				gl.glBindTexture(gl.GL_TEXTURE_2D, tex.ids[k])
			}
			gl.glUniform1i(lumaUnit, 0)
			gl.glUniform1i(cbUnit, 1)
			gl.glUniform1i(crUnit, 2)
			gl.glUniform1i(cbcrUnit, 3)
			gl.glUniform1i(full, frame.fullRange ?? (1, 0))
			gl.glUniform1i(bt709, frame.matrix == 709 ?? (1, 0))
			let verts = float32[
				float32(x0), float32(y0), float32(x1), float32(y0), float32(x1), float32(y1),
				float32(x0), float32(y0), float32(x1), float32(y1), float32(x0), float32(y1)
			]
			let uvs = float32[
				float32(u0), float32(v0), float32(u1), float32(v0), float32(u1), float32(v1),
				float32(u0), float32(v0), float32(u1), float32(v1), float32(u0), float32(v1)
			]
			gl.glDisable(gl.GL_BLEND)
			gl.glEnableVertexAttribArray(posAttr)
			gl.glEnableVertexAttribArray(uvAttr)
			gl.glVertexAttribPointer(posAttr, 2, gl.GL_FLOAT, false, 0, verts)
			gl.glVertexAttribPointer(uvAttr, 2, gl.GL_FLOAT, false, 0, uvs)
			gl.glDrawArrays(gl.GL_TRIANGLES, 0, 6)
			gl.glDisableVertexAttribArray(posAttr)
			gl.glDisableVertexAttribArray(uvAttr)
			gl.glUseProgram(0)
			for let k = 3; k >= 0; k-- {
				gl.glActiveTexture(gl.GL_TEXTURE0 + uint32(k))
				gl.glBindTexture(gl.GL_TEXTURE_2D, uint32(0))
			}
			gl.glEnable(gl.GL_BLEND)
			gl.glBlendFunc(gl.GL_SRC_ALPHA, gl.GL_ONE_MINUS_SRC_ALPHA)
		}

		// Puts the frame's picture into the textures and sets the uniforms
		// that say how to read them. False when there is nothing to draw.
		def upload(tex VideoTextures, frame video.VideoFrame) bool {
			let w = int(frame.width)
			let h = int(frame.height)
			gl.glUseProgram(program)
			let gpu = frame.gpu
			if !(gpu is none) {
				tex.ensure(0, w, h, gl.GL_R8, byte[])
				tex.ensure(3, w >> 1, h >> 1, gl.GL_RG8, byte[])
				if gpu.fillTextures(tex.ids[0], tex.ids[3]) {
					gl.glUniform1i(nv12, 1)
					gl.glUniform1f(lumaScale, float32(1.0))
					gl.glUniform1f(chromaScale, float32(1.0))
					return true
				}
				let (y, u, v) = gpu.planes() onerror recover (byte[], byte[], byte[])
				return false when y.len() < w * h
				tex.load(0, y, w, h, w, false)
				tex.load(1, u, w >> 1, h >> 1, w >> 1, false)
				tex.load(2, v, w >> 1, h >> 1, w >> 1, false)
				gl.glUniform1i(nv12, 0)
				gl.glUniform1f(lumaScale, float32(1.0))
				gl.glUniform1f(chromaScale, float32(1.0))
				return true
			}
			return false when frame.y.len() == 0
			let wide = frame.bitDepth > 8
			// 16-bit texels hold samples of `bitDepth` bits: scale to 0..1.
			let scale = wide ?? (65535.0 / float((1 << frame.bitDepth) - 1), 1.0)
			tex.load(0, frame.y, w, h, frame.yStride, wide)
			if frame.chroma == video.ChromaLayout.Mono {
				// Neutral chroma.
				tex.ensure(1, 1, 1, gl.GL_R8, byte[128])
				tex.ensure(2, 1, 1, gl.GL_R8, byte[128])
				gl.glUniform1f(chromaScale, float32(1.0))
			} else {
				let cw = frame.chroma == video.ChromaLayout.Yuv444 ?? (w, (w + 1) >> 1)
				let ch = frame.chroma == video.ChromaLayout.Yuv420 ?? ((h + 1) >> 1, h)
				tex.load(1, frame.u, cw, ch, frame.uvStride, wide)
				tex.load(2, frame.v, cw, ch, frame.uvStride, wide)
				gl.glUniform1f(chromaScale, float32(scale))
			}
			gl.glUniform1i(nv12, 0)
			gl.glUniform1f(lumaScale, float32(scale))
			return true
		}
	}

	// The video layer of the current GL context. Fails when its shaders do
	// not compile.
	internal def newVideoLayer() !VideoLayer {
		return new VideoLayer(try buildProgram(videoVertexSource(), videoFragmentSource()))
	}

	// Compiles and links a program from vertex and fragment shader sources.
	// Fails with the driver's log when either does not compile or link.
	internal def buildProgram(vsrc string, fsrc string) !uint32 {
		let vs = try compileShader(gl.GL_VERTEX_SHADER, vsrc)
		let fs = try compileShader(gl.GL_FRAGMENT_SHADER, fsrc)
		let prog = gl.glCreateProgram()
		gl.glAttachShader(prog, vs)
		gl.glAttachShader(prog, fs)
		gl.glLinkProgram(prog)
		let ok int32[]
		ok.len(1)
		gl.glGetProgramiv(prog, gl.GL_LINK_STATUS, ok)
		gl.glDeleteShader(vs)
		gl.glDeleteShader(fs)
		if ok[0] == 0 {
			let logLen int32[]
			logLen.len(1)
			gl.glGetProgramiv(prog, gl.GL_INFO_LOG_LENGTH, logLen)
			let log byte[]
			log.len(int(logLen[0]))
			if log.len() > 0 {
				let outLen int32[]
				outLen.len(1)
				gl.glGetProgramInfoLog(prog, log.len(), outLen, log)
			}
			fail "program link failed: " + string(log)
		}
		return prog
	}

	// Compiles one shader. Fails with the driver's log.
	internal def compileShader(kind uint32, src string) !uint32 {
		let s = gl.glCreateShader(kind)
		gl.glShaderSource(s, 1, string[src], int[src.len()])
		gl.glCompileShader(s)
		let ok int32[]
		ok.len(1)
		gl.glGetShaderiv(s, gl.GL_COMPILE_STATUS, ok)
		if ok[0] == 0 {
			let logLen int32[]
			logLen.len(1)
			gl.glGetShaderiv(s, gl.GL_INFO_LOG_LENGTH, logLen)
			let log byte[]
			log.len(int(logLen[0]))
			if log.len() > 0 {
				let outLen int32[]
				outLen.len(1)
				gl.glGetShaderInfoLog(s, log.len(), outLen, log)
			}
			fail "shader compile failed: " + string(log)
		}
		return s
	}

	internal def videoVertexSource() string {
		return "" +
			"attribute vec2 aPos;\n" +
			"attribute vec2 aUV;\n" +
			"varying vec2 vUV;\n" +
			"uniform vec2 uViewport;\n" +
			"void main() {\n" +
			"  float x = (aPos.x / uViewport.x) * 2.0 - 1.0;\n" +
			"  float y = 1.0 - (aPos.y / uViewport.y) * 2.0;\n" +
			"  gl_Position = vec4(x, y, 0.0, 1.0);\n" +
			"  vUV = aUV;\n" +
			"}\n"
	}

	// Y'CbCr to RGB: BT.601 or BT.709, studio or full range.
	internal def videoFragmentSource() string {
		return "" +
			"varying vec2 vUV;\n" +
			"uniform sampler2D uY;\n" +
			"uniform sampler2D uCb;\n" +
			"uniform sampler2D uCr;\n" +
			"uniform sampler2D uCbCr;\n" +
			"uniform int uNv12;\n" +
			"uniform float uLumaScale;\n" +
			"uniform float uChromaScale;\n" +
			"uniform int uFull;\n" +
			"uniform int uBt709;\n" +
			"void main() {\n" +
			"  float y = texture2D(uY, vUV).r * uLumaScale;\n" +
			"  float cb;\n" +
			"  float cr;\n" +
			"  if (uNv12 == 1) {\n" +
			"    vec2 c = texture2D(uCbCr, vUV).rg;\n" +
			"    cb = c.r;\n" +
			"    cr = c.g;\n" +
			"  } else {\n" +
			"    cb = texture2D(uCb, vUV).r * uChromaScale;\n" +
			"    cr = texture2D(uCr, vUV).r * uChromaScale;\n" +
			"  }\n" +
			"  if (uFull == 1) {\n" +
			"    cb = cb - 0.5019608;\n" +
			"    cr = cr - 0.5019608;\n" +
			"  } else {\n" +
			"    y = (y - 0.0627451) * 1.1643836;\n" +
			"    cb = (cb - 0.5019608) * 1.1383929;\n" +
			"    cr = (cr - 0.5019608) * 1.1383929;\n" +
			"  }\n" +
			"  vec3 rgb;\n" +
			"  if (uBt709 == 1) {\n" +
			"    rgb = vec3(y + 1.5748 * cr, y - 0.187324 * cb - 0.468124 * cr, y + 1.8556 * cb);\n" +
			"  } else {\n" +
			"    rgb = vec3(y + 1.402 * cr, y - 0.344136 * cb - 0.714136 * cr, y + 1.772 * cb);\n" +
			"  }\n" +
			"  gl_FragColor = vec4(clamp(rgb, 0.0, 1.0), 1.0);\n" +
			"}\n"
	}
}
