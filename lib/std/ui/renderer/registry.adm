partial module std.ui.renderer {
	use std.reflection

	// `@UIRenderer(name="...")` marks a renderer implementation which the UI service can discover and use.
	meta def UIRenderer<Renderer>(ctx reflection.DiscoveryMetaContext<reflection.TypeMetaContext>, name string) {}

	internal let RenderersRegistry map<string, reflection.TypeDescriptor> = map<string, reflection.TypeDescriptor>{}

	@once()
	internal def loadRenderers() {
		let hits = reflection.attrs(UIRenderer)

		for let (_, hit) in hits {
			let rend = reflection.asType(hit.node)
			continue when rend is none

			let name = hit.attr.arguments.valueOf("name")
			continue when name is none
			let rendererName = string(name)

			RenderersRegistry.set(rendererName, rend)
		}
	}

	def getRenderer(name string) ?Renderer {
		loadRenderers()
		let rend = RenderersRegistry.get(name)
		return none when rend is none

		let desc reflection.TypeDescriptor = rend
		let instance = reflection.instantiate(desc)
		return none when instance is none
		return none unless instance is Renderer

		let renderer Renderer = instance
		return renderer
	}
}
