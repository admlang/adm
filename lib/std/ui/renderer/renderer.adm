partial module std.ui.renderer {
	use (
		std.gfx.canvas
		std.formats.image
		std.math.geom::(Point, Rect, Size)
		std.ui
		std.ui.styles::(Align, Alignment, Cursor)
		std.units
	)

	// WindowConfig describes how to create a platform window/surface.
	// Hosts may ignore unsupported fields, but must behave consistently.
	type WindowConfig {
		title        string
		// The size of what the window shows, in logical pixels.
		size         Size
		resizable    bool
		vsync        bool
		icon         ?image.Image         = none
		// False: no title bar and no frame; the window is what its root component draws.
		decorated    bool                 = true
		// The smallest the user can make the window, in logical pixels; none: no limit.
		minSize      ?Size<units.Pixels>  = none
		// Where its top left corner goes on the desktop, in logical pixels; none: the
		// desktop places it.
		position     ?Point<units.Pixels> = none
		// The window has no background of its own: where its components draw nothing,
		// or draw with a colour that is not opaque, what is behind the window shows. On a
		// desktop that does not blend windows it is opaque, over black.
		transparent  bool
		// Where a press goes to what is behind the window, as if the window were not
		// there: nowhere, where the window shows nothing, or everywhere.
		clickThrough ClickThrough         = ClickThrough.None
		// Stays above the other windows of the desktop.
		alwaysOnTop  bool
		// How it opens: as the desktop places it, minimized, maximized or fullscreen.
		state        ui.WindowState       = ui.WindowState.Normal
		// What it is to the desktop: an ordinary window, a dialog or a tool window. A
		// desktop decides what that looks like; a dialog without an `owner` is an
		// ordinary window.
		kind         ui.WindowKind        = ui.WindowKind.Normal
		// The window it belongs to and stays above; none: no window.
		owner        ?Window              = none
		// A name to keep its place under between runs: a window opened with it opens
		// with the size, the position and the state (maximized, fullscreen) it had
		// when it was last open, whatever `size`, `position` and `state` say. Kept
		// where `@persist` fields are, so the name is not one of their keys either.
		// Letters, digits, '.', '_' and '-'; empty: not kept.
		persist      string               = ""

		def new(title string = "ADM", width float = 800, height float = 600) {
			self.title = title
			size = new Size(width, height)
			resizable = true
			vsync = true
		}

		// Sets `position` so that the window sits in the part of `display` windows should
		// use (its `workArea`), `margin` logical pixels from the edges it is put against:
		// `placeOn(display, Align{horizontal: Alignment.End, vertical: Alignment.Start}, 16.0)`
		// is the top right corner. Start is the left and the top, End the right and the
		// bottom, Center the middle; any other alignment is Start. It reads `size`, so set
		// that first.
		def placeOn(display ui.Display, align Align, margin float = 0.0) {
			let area = display.workArea
			let (left, top) = (float(area.left) + margin, float(area.top) + margin)
			match align.horizontal {
				case Alignment.Center:
					left = (float(area.left) + float(area.right) - size.width) / 2.0
				case Alignment.End:
					left = float(area.right) - size.width - margin
				default:
			}
			match align.vertical {
				case Alignment.Center:
					top = (float(area.top) + float(area.bottom) - size.height) / 2.0
				case Alignment.End:
					top = float(area.bottom) - size.height - margin
				default:
			}
			position = new Point<units.Pixels>(left * 1(px), top * 1(px))
		}
	}

	// Where a window lets presses through to what is behind it.
	enum ClickThrough {
		// Nowhere: the window takes every press on it.
		None,
		// Where it shows nothing at all, for a window opened `transparent`: its shape for
		// the pointer is what it draws.
		Empty,
		// Everywhere: the window only shows something. It takes no press and no
		// keyboard focus, and is not listed among the desktop's windows (a notice, an
		// overlay).
		All,
	}

	// Window is an opaque handle owned by a Host implementation.
	// Concrete hosts store native handles (SDL_Window*, Cocoa handles, etc.) in `handle`.
	type Window {
		internal handle uint
		// False: not on screen and not in the taskbar; the window stays open and its
		// components stay mounted. Set it to send a window to the tray and to bring it back.
		visible         bool               = true
		// Normal, minimized, maximized or fullscreen, as the desktop reports it;
		// `UI.windowStateChanged` is emitted when it changes.
		state           ui.WindowState     = ui.WindowState.Normal
		// Where it is on the desktop and how large what it shows is, in logical pixels,
		// as the desktop has it: it follows the user moving and resizing the window. Set
		// it to move or resize the window; the desktop may then give it another place or
		// size, which this shows a moment later.
		bounds          Rect<units.Pixels> = Rect<units.Pixels>{}
		// Whether it is the window the keyboard goes to, as the desktop reports it.
		active          bool
		// Whether it was opened with `WindowConfig.transparent`: its frames start from
		// nothing, not from the theme's window colour. Set when it is opened.
		transparent     bool
		// As it was opened: `WindowConfig.clickThrough`. Set when it is opened.
		clickThrough    ClickThrough       = ClickThrough.None

		// new constructs a Window from an opaque host handle.
		// Host implementations should treat the handle as private and stable.
		def new(handle uint) {
			self.handle = handle
		}

		// id returns an opaque stable identifier for this window.
		def id() uint {
			return handle
		}
	}

	// PlatformEventKind is a low-level event category reported by a host.
	// The UI service translates platform events into high-level `std.ui` events.
	enum PlatformEventKind {
		None = 0,
		Close,
		Resize,
		Focus,
		Blur,
		MouseEnter,
		MouseLeave,
		MouseMove,
		MouseDown,
		MouseUp,
		MouseWheel,
		KeyDown,
		KeyUp,
		// Final text from the keyboard or an input method, in `text`.
		TextInput,
		// Text an input method is composing, in `text` with `caret` inside it; an empty
		// text ends the composition.
		TextCompose,
		// The window was minimized, maximized, made fullscreen or brought back: `state`.
		StateChange,
		// The tray icon itself was clicked.
		TrayActivate,
		// What the window shows was lost (it was covered, or shown again): draw it again.
		Expose,
		// Something from another application is dragged over the window, at `position`.
		DragOver,
		// What was dragged over the window left it, or the drag was given up.
		DragLeave,
		// It was dropped on the window at `position`: `files` and `text`.
		Drop,
	}

	// PlatformEvent is a low-level input/window event as reported by a host.
	// Fields not relevant to `kind` are left at their zero values.
	type PlatformEvent {
		kind PlatformEventKind

		// The window it happened in, as `Window.id()`; 0 for an event of no window.
		window uint

		// Window-relative position in device pixels, the unit of the window's frames.
		position Point

		// For Resize events: the frame's size in device pixels.
		size Size

		button ui.MouseButton
		// For MouseDown and MouseUp: 1 for a single click, 2 for a double click, and so on.
		clicks int            = 1

		// The key, by what it means in the current layout.
		key       ui.Key       = ui.Key.Unknown
		// The key by its place: the key a US keyboard has there.
		code      ui.KeyCode   = ui.Key.Unknown
		// For KeyDown: the key is held and repeating.
		repeat    bool
		// The modifier keys held when it happened.
		modifiers ui.Modifiers = ui.Modifiers{}

		// For TextInput and TextCompose; for KeyDown, the text the press produces by
		// itself; for Drop, the text dropped.
		text  string
		// For Drop: the paths of the files dropped.
		files string[]
		// For TextCompose: the caret's position in `text`, in characters.
		caret int

		// For MouseMove: how far the pointer moved. For MouseWheel: how far to scroll,
		// positive right and down. Both in device pixels.
		delta Point

		// For StateChange.
		state ui.WindowState = ui.WindowState.Normal
	}

	// Frame represents a single render tick.
	// Renderers provide a renderer-agnostic draw context per frame.
	type Frame {
		ctx  canvas.DrawContext
		// Set by the renderer in `nextFrame`: it still holds what the last frame committed
		// for this window showed, at this size, so a frame may draw only a part of it.
		kept bool
		// Set by who draws the frame, when `kept`: the frame draws over what the last one
		// showed, and `commit` shows the two together. Unset, a frame starts from nothing.
		over bool
	}

	// Host provides the platform's windows and everything the window system does for
	// them: events, input methods, the clipboard, displays and the tray. It draws
	// nothing; a Renderer draws into the windows a host opens.
	interface Host {
		def openWindow(cfg WindowConfig) !Window
		def closeWindow(win Window) !none
		def setWindowTitle(win Window, title string) !none
		def setWindowIcon(win Window, icon image.Image) !none
		// Puts the window on the screen and in the taskbar, or takes it off both; it
		// stays open either way.
		def setWindowVisible(win Window, visible bool) !none
		// Minimizes, maximizes, makes fullscreen or brings back to Normal.
		def setWindowState(win Window, state ui.WindowState) !none
		// Gives the pointer that shape while it is over the window.
		def setCursor(win Window, cursor Cursor) !none
		// The window's position and size on the desktop, in logical pixels.
		def windowBounds(win Window) !Rect<units.Pixels>
		// Moves the window and sizes what it shows, in logical pixels of the desktop. The
		// desktop may give it another place or size: `windowBounds` says which.
		def setWindowBounds(win Window, bounds Rect<units.Pixels>) !none
		// Puts the window above the others.
		def raiseWindow(win Window) !none
		// The events waiting for every window, oldest first; each names its window.
		def poll() !PlatformEvent[]
		// Returns when an event is waiting or `limit` has passed, whichever comes first:
		// how the windows' loop rests while nothing is drawn.
		def wait(limit duration) !none
		// Ends a `wait` in progress, or the next one at once. The one call of a host that
		// any task may make.
		def wake()
		// The connected monitors, the primary one first.
		def displays() !ui.Display[]

		// The text on the clipboard, "" when it holds none.
		//
		// Fails when no window is open or the caller is not on the thread that runs the windows.
		def clipboardText() !string
		// Puts the text on the clipboard, replacing what was there.
		//
		// Fails when no window is open or the caller is not on the thread that runs the windows.
		def setClipboardText(text string) !none

		// Turns text input on for the window, for a text of the given kind: typed
		// characters and input-method results arrive as TextInput, compositions as
		// TextCompose, and an on-screen keyboard is shown where there is one.
		def startTextInput(win Window, kind ui.TextKind) !none
		// Turns text input off: keys arrive as keys only and the input method is idle.
		def stopTextInput(win Window) !none
		// Tells the input method where the caret is, in logical pixels of the window, so
		// that it puts its candidate list there.
		def setTextInputCaret(win Window, caret Rect<units.Pixels>) !none

		// Shows the tray icon with its tooltip and menu, or replaces what it shows.
		//
		// Fails when the desktop has no tray.
		// Sets what says whether a point of the window, in logical pixels, is a place the
		// user drags the window by, asked when a button goes down there; none: no point
		// is. A press on such a place moves the window and reaches no component.
		def setWindowDragTest(win Window, test ?(def(Point<units.Pixels>) bool)) !none

		// Says where the window is there for the pointer: `pixels` are `width` by `height`
		// of red, green, blue and alpha, a byte each, row by row from the top, stretched
		// over the window, and a press where the alpha is 0 goes to what is behind the
		// window.
		//
		// Fails when the window is unknown or the desktop cannot shape a window.
		def setWindowShape(win Window, width int, height int, pixels byte[]) !none

		def showTray(icon image.Image, tooltip string, menu ui.MenuEntry[]) !none
		def hideTray() !none
	}

	// A host whose windows OpenGL draws in. Windows are named by `Window.id()`.
	interface GLSurface {
		// Makes the window's context current on the calling thread. False when the
		// window cannot be drawn in now (hidden or resized by the desktop this instant).
		def makeCurrent(window uint) bool
		// Shows what was drawn into the window since the last call.
		def present(window uint)
		// The size of the window's drawing surface in device pixels.
		def surfaceSize(window uint) Size
	}

	// Renderer turns the draw commands of a frame into pixels in a host's window.
	// It does not own the component tree; the UI service/controller code does.
	interface Renderer {
		// Takes the host whose windows it draws in.
		//
		// Fails when the host cannot give the kind of surface the renderer draws on.
		def attach(host Host) !none
		def nextFrame(win Window) !Frame
		def commit(win Window, frame Frame) !none
		// The pixels the window's last committed frame holds in the box from (`left`,
		// `top`), `width` by `height` device pixels: straight red, green, blue and alpha,
		// a byte each, row by row from the top.
		//
		// Fails when the renderer does not hold that frame or the box is not inside it.
		def read(win Window, left int, top int, width int, height int) !byte[]
		// Frees what the renderer holds for the window. The host closes it afterwards.
		def release(win Window) !none
	}
}
