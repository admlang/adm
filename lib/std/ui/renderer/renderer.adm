	partial module std.ui.renderer {
		use std.gfx.canvas
		use std.formats.image
		use std.math.geom::(Point, Size)
		use std.ui

	// WindowConfig describes how to create a platform window/surface.
	// Renderers may ignore unsupported fields, but must behave consistently.
	type WindowConfig {
		title     string
		size      Size
		resizable bool
		vsync     bool
		icon      ?image.Image = none

		def new(title string = "ADM", width float = 800, height float = 600) {
			self.title = title
			size = new Size(width, height)
			resizable = true
			vsync = true
		}
	}

	// Window is an opaque handle owned by a Renderer implementation.
	// Concrete backends store native handles (GLFWwindow*, Cocoa handles, etc.) in `handle`.
	type Window {
		internal handle uint

		// new constructs a Window from an opaque backend handle.
		// Renderer implementations should treat the handle as private and stable.
		def new(handle uint) {
			self.handle = handle
		}

		// id returns an opaque stable identifier for this window.
		def id() uint {
			return handle
		}
	}

	// PlatformEventKind is a low-level event category reported by a renderer backend.
	// The UI service translates platform events into high-level `std.ui` events.
	enum PlatformEventKind {
		None = 0,
		Close,
		Resize,
		Focus,
		Blur,
		MouseEnter,
		MouseLeave,
		MouseMove,
		MouseDown,
		MouseUp,
		MouseWheel,
		KeyDown,
		KeyUp,
		TextInput,
	}

	// PlatformEvent is a low-level input/window event as reported by a renderer backend.
	// Fields not relevant to `kind` are left at their zero values.
	type PlatformEvent {
		kind PlatformEventKind

		// Window-relative pixel coordinates.
		position Point

		// For Resize events (logical size).
		size Size

		button ui.MouseButton
		key    int
		rune   char
		delta  Point
	}

	// Frame represents a single render tick.
	// Backends provide a renderer-agnostic draw context per frame.
	type Frame {
		ctx canvas.DrawContext
	}

	// Renderer provides the platform window + per-frame presentation surface.
	// It does not own the component tree; the UI service/controller code does.
	interface Renderer {
		def openWindow(cfg WindowConfig) !Window
		def setWindowTitle(win Window, title string) !none
		def setWindowIcon(win Window, icon image.Image) !none
		def pollEvents(win Window) !PlatformEvent[]
		def nextFrame(win Window) !Frame
		def commit(win Window, frame Frame) !none
		def closeWindow(win Window) !none
	}
}
