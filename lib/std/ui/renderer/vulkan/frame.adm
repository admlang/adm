@os("linux", "darwin", "windows")
partial module std.ui.renderer.vulkan {
	use (
		std.gfx.canvas::(Composite, GpuEffectKind, OutlinePosition, GpuBackdropBlur, GpuBeginGroup, GpuBlit, GpuDraw, GpuEndGroup, GpuFragment, GpuFrame, GpuGradient, GpuImage, GpuMove, GpuNoise, GpuOp, GpuPixels, GpuSolid, fragmentPixels)
		std.math.geom::(FillRule, Transform2D)
		std.gfx.color::(BlendMode, RGBA)
		std.formats.video as video
		std.ui.renderer.vulkan.vk
	)

	// The GPU canvas shaders as SPIR-V (tools/build-spirv.sh): the OpenGL
	// renderer's canvas.vert, canvas.frag and effects.frag compiled with the
	// Vulkan preamble, and paint.vert for `@fragment` paints. The `.f32`
	// variants compute in floats (`double` defined as `float`, as the web's
	// GLSL ES does) for a device without 64-bit shader floats.
	@embed("spirv/canvas.vert.spv")
	internal const canvasVertexSpirv byte[]

	@embed("spirv/canvas.frag.spv")
	internal const canvasFragmentSpirv byte[]

	@embed("spirv/canvas.local.frag.spv")
	internal const canvasLocalFragmentSpirv byte[]

	@embed("spirv/effects.frag.spv")
	internal const effectsFragmentSpirv byte[]

	@embed("spirv/canvas.f32.frag.spv")
	internal const canvasFragmentF32Spirv byte[]

	@embed("spirv/canvas.local.f32.frag.spv")
	internal const canvasLocalFragmentF32Spirv byte[]

	@embed("spirv/effects.f32.frag.spv")
	internal const effectsFragmentF32Spirv byte[]

	@embed("spirv/paint.vert.spv")
	internal const paintVertexSpirv byte[]

	// The passes of the effects shader (shaders/effects.frag).
	enum EffectMode {
		Alpha,
		Covered,
		Copy,
		Inverted,
		Multiply,
		MultiplyInverse,
		Shifted,
		Box,
		Grown,
		Ring,
		Signed,
		DistanceInit,
		DistanceColumns,
		DistanceRows,
		Linear,
		Store,
		Halve,
	}

	// The canvas shader's uniform block (canvas.frag, std140) and its samplers'
	// places after the block's binding.
	internal const canvasBlock = 512
	internal const cBox = 0
	internal const cTint = 16
	internal const cPixelsOrigin = 32
	internal const cImageSize = 40
	internal const cImageSpread = 48
	internal const cInvX = 56
	internal const cInvY = 64
	internal const cInvT = 72
	internal const cSolid = 80
	internal const cSolidA = 92
	internal const cAlpha = 96
	internal const cComposite = 100
	internal const cBlend = 104
	internal const cPaired = 108
	internal const cOp = 112
	internal const cPaintKind = 116
	internal const cHasCoverage = 120
	internal const cHasClip = 124
	internal const cCoverageFromPlane = 128
	internal const cHasQuad = 132
	internal const cHardQuad = 136
	internal const cEdgeBands = 140
	internal const cEvenOdd = 144
	internal const cGradKind = 148
	internal const cSpread = 152
	internal const cOctaves = 156
	internal const cSampling = 160
	internal const cTinted = 164
	internal const cQuad = 176
	internal const cParams = 304
	internal const cMatrix = 432
	internal const canvasSamplers = 12
	internal const sDst = 0
	internal const sCoverage = 1
	internal const sClip = 2
	internal const sPixels = 3
	internal const sBlueNoise = 4
	internal const sPlane = 5
	internal const sImage = 6
	internal const sToLinear = 7
	internal const sToSrgb = 8
	internal const sTable = 9
	internal const sPerm = 10
	internal const sEdges = 11

	// The effects shader's uniform block and samplers (effects.frag).
	internal const effectsBlock = 64
	internal const eF = 0
	internal const eI = 16
	internal const eOrigin = 32
	internal const eMode = 40
	internal const eW = 44
	internal const eH = 48
	internal const ePW = 52
	internal const effectsSamplers = 7
	internal const eA = 0
	internal const eB = 1
	internal const eC = 2
	internal const eImage = 3
	internal const eLinear = 4
	internal const eSrgb = 5
	internal const eOld = 6

	// The layout of a path's edges image (bindEdges, canvas.frag's EdgeRow and
	// EdgeBandRows).
	internal const edgeRow = 1024
	internal const edgeBandRows = 16

	// What images the GPU canvas draws into and samples may be used for.
	internal const targetUsage = vk.USAGE_COLOR_ATTACHMENT | vk.USAGE_INPUT_ATTACHMENT | vk.USAGE_SAMPLED | vk.USAGE_TRANSFER_SRC | vk.USAGE_TRANSFER_DST
	internal const sampledUsage = vk.USAGE_SAMPLED | vk.USAGE_TRANSFER_DST | vk.USAGE_TRANSFER_SRC

	// One draw of a pipeline: its uniform block's bytes and the image bound
	// to each sampler, dummies until bound. A `double` member of the block is
	// written as a float when the shaders compute in floats (`float64` off):
	// std140 gives both the same offsets (a scalar array's stride is 16).
	internal type Pass {
		block    byte[]
		views    uint[]
		samplers uint[]
		float64  bool

		def new(blockSize int, samplerCount int, dummy uint, sampler uint, float64 bool) {
			self.float64 = float64
			block.len(blockSize)
			views.len(samplerCount)
			samplers.len(samplerCount)
			for let i = 0; i < samplerCount; i++ {
				views[i] = dummy
				samplers[i] = sampler
			}
		}

		def int(at int, v int) {
			putI32(block, at, v)
		}

		def uint(at int, v uint32) {
			putU32(block, at, v)
		}

		def float(at int, v float32) {
			putF32(block, at, v)
		}

		def double(at int, v float64) {
			putF64(block, at, v) when float64
			putF32(block, at, float32(v)) unless float64
		}

		def bind(slot int, img Image) {
			views[slot] = img.view
		}

		def bind(slot int, img Image, sampler uint) {
			views[slot] = img.view
			samplers[slot] = sampler
		}
	}

	// The images of one size class a frame's uploads take in turn.
	internal type ScratchClass {
		images  Image[]
		used    int     = 0
		lastUse int     = 0

		def new() {}
	}

	// The images of one format the uploads of a frame take in turn, each
	// draw its own, so the draws of a frame never share one and can wait in
	// a run: by size class (sides rounded up to powers of two), kept across
	// frames, a class no frame used for a while freed. The shaders read only
	// inside the box uploaded.
	internal type Scratch {
		internal format  uint32
		// Bytes a texel.
		internal texel   int
		internal usage   uint32
		internal classes map<string, ScratchClass>
		internal frame   int                       = 0

		def new(format uint32, texel int, usage uint32 = sampledUsage) {
			self.format = format
			self.texel = texel
			self.usage = usage
			classes = map<string, ScratchClass>{}
		}

		// An image at least w x h no draw of the frame has taken yet.
		def ensure(dev Device, w int, h int) !Image {
			let (pw, ph) = (powerOfTwo(w), powerOfTwo(h))
			let key = "{pw}x{ph}"
			let found = classes.get(key)
			let c = new ScratchClass()
			if found is none {
				classes = classes.set(key, c)
			} else {
				c = found
			}
			c.lastUse = frame
			if c.used >= c.images.len() {
				c.images.push(try dev.createImage(pw, ph, format, usage))
			}
			let img = c.images[c.used]
			c.used++
			return img
		}

		// Starts a frame: every image may be taken again; a class no frame
		// took from for 64 frames is freed.
		def reset(dev Device, frame int) {
			self.frame = frame
			let keys = classes.keys()
			for let (_, k) in keys {
				let c = classes.get(k)
				continue when c is none
				if frame - c.lastUse > 64 {
					for let (_, img) in c.images {
						dev.retire(img)
					}
					classes = classes.delete(k)
				} else {
					c.used = 0
				}
			}
		}

		// Uploads w x h packed texels to an image's corner.
		def upload(dev Device, w int, h int, data byte[]) !Image {
			let i = try ensure(dev, w, h)
			try dev.upload(i, 0, 0, w, h, texel, data)
			return i
		}

		def upload(dev Device, w int, h int, data float32[]) !Image {
			let i = try ensure(dev, w, h)
			let (buffer, at) = try dev.stageFloats(data)
			vk.cmdCopyToImage(dev.cmd, buffer, at, 0, i.image, 0, 0, uint32(w), uint32(h))
			return i
		}

		def upload(dev Device, w int, h int, data uint16[]) !Image {
			let i = try ensure(dev, w, h)
			let (buffer, at) = try dev.stageShorts(data)
			vk.cmdCopyToImage(dev.cmd, buffer, at, 0, i.image, 0, 0, uint32(w), uint32(h))
			return i
		}

		def upload(dev Device, w int, h int, data int32[]) !Image {
			let i = try ensure(dev, w, h)
			let (buffer, at) = try dev.stageInts(data)
			vk.cmdCopyToImage(dev.cmd, buffer, at, 0, i.image, 0, 0, uint32(w), uint32(h))
			return i
		}

		def free(dev Device) {
			for let (_, c) in classes {
				for let (_, img) in c.images {
					dev.retire(img)
				}
			}
			classes = map<string, ScratchClass>{}
		}
	}

	// The power of two at least n, at least 1.
	internal def powerOfTwo(n int) int {
		let p = 1
		for p < n {
			p *= 2
		}
		return p
	}

	// One draw of a run drawn in one render pass: its set and its box.
	internal struct Draw {
		set uint
		x   int
		y   int
		w   int
		h   int
	}

	// An image's levels in the cache, and the frame it was last drawn in.
	internal type CachedImage {
		levels Image[]
		used   int     = 0

		def new(levels Image[]) {
			self.levels = levels
		}
	}

	// The region a group's effects work on, and its planes' width.
	internal struct EffectRegion {
		x  int
		y  int
		w  int
		h  int
		pw int
	}

	// FrameRenderer draws GpuFrames (DrawContext.lower) with Vulkan into an
	// image the size of the frame, recording into the device's command
	// buffer: the canvas's coverage and pixels, the paint, clip, operators,
	// blend modes and groups in the same shaders the OpenGL renderer runs,
	// compiled to SPIR-V. Every image it owns stays in the general layout;
	// barriers separate the uploads and copies of an operation from its draw.
	// On a device that reads a colour attachment back within a render pass
	// (local read), the draws of a run on one target are recorded after
	// their uploads in one pass, a barrier between draws, instead of each
	// copying the target's box first.
	internal type FrameRenderer {
		internal dev         Device
		internal width       int                      = 0
		internal height      int                      = 0
		// The frame's target, then one per open group.
		internal stack       Image[]
		// Group targets kept for the next frame.
		internal spare       Image[]
		internal dst         Scratch                  = new Scratch(vk.FORMAT_R8G8B8A8_UNORM, 4)
		internal coverage    Scratch                  = new Scratch(vk.FORMAT_R8_UNORM, 1)
		internal clip        Scratch                  = new Scratch(vk.FORMAT_R8_UNORM, 1)
		// Pixel paints, and the box a `@fragment` paint pass shades.
		internal pixels      Scratch                  = new Scratch(vk.FORMAT_R8G8B8A8_UNORM, 4, targetUsage)
		// Gradient tables (1024 x 1, 16-bit channels), the blue noise they
		// dither with, and noise hashes.
		internal table       Scratch                  = new Scratch(vk.FORMAT_R16G16B16A16_UINT, 8)
		internal dither      Image                    = Image{}
		internal perm        Scratch                  = new Scratch(vk.FORMAT_R32_SINT, 4)
		// A path's edges by band (bindEdges).
		internal edges       Scratch                  = new Scratch(vk.FORMAT_R32G32B32A32_SFLOAT, 16)
		// With the device's local read: the draws waiting to go into
		// `drawTarget` in one render pass (flushDraws).
		internal pending     Draw[]
		internal drawTarget  Image                    = Image{}
		// Float planes effects work on, kept for the next group.
		internal planePool   Image[]
		// Image levels by their content key, and the frame each was last
		// drawn in.
		internal images      map<string, CachedImage>
		internal imageBytes  int                      = 0
		internal imageBudget int                      = 256 * 1024 * 1024
		internal frameCount  int                      = 0
		// The colour tables colour blurs and image halving read through.
		internal linearTable Image                    = Image{}
		internal srgbTable   Image                    = Image{}
		// Video frames drawn as image paints: the planes they are uploaded to
		// and the converted picture with its halved levels.
		internal videoPlanes ?VideoPlanes             = none
		internal videoLevels Image[]

		def new(dev Device) {
			self.dev = dev
			images = map<string, CachedImage>{}
		}

		// The image holding the last frame drawn (straight RGBA8, row 0 the
		// top of the frame), empty before the first.
		def target() Image {
			return stack.len() == 0 ?? (Image{}, stack[0])
		}

		// Whether it holds a frame of that size: one drawn with `over` then has
		// something to draw on.
		def holds(w int, h int) bool {
			return stack.len() > 0 && w == width && h == height
		}

		// Draws the frame from transparent black (with `over`, on the last
		// frame drawn when it has that size) as one submission, and waits for
		// it: for a caller that drives no frame of its own.
		//
		// Fails as `record` does.
		def draw(frame GpuFrame, over bool = false) !none {
			try dev.open()
			try record(frame, over)
			try dev.submit(0, 0)
			return try dev.wait()
		}

		// Records the frame into the device's open command buffer.
		//
		// Fails when no command buffer is open, when an image or a pipeline
		// cannot be made, or when a readback (a backdrop blur) finds the GPU
		// lost.
		def record(frame GpuFrame, over bool = false) !none {
			fail "the Vulkan device has no frame open" unless dev.recording
			try start(frame.width, frame.height, over && holds(frame.width, frame.height))
			frameCount++
			for let (_, ring) in [dst, coverage, clip, pixels, table, perm, edges] {
				ring.reset(dev, frameCount)
			}
			pending.len(0)
			for let (_, op) in frame.ops {
				try apply(op, frame)
			}
			try flushDraws()
			// Groups left open are dropped, as endGroup never came.
			for stack.len() > 1 {
				spare.push(stack.pop())
			}
			trimImages()
			return none
		}

		// The last frame's pixels, straight RGBA8, row 0 the top.
		//
		// Fails when the GPU does not finish.
		def read() !byte[] {
			let out byte[]
			return out when stack.len() == 0
			return try dev.readPixels(stack[0], 0, 0, width, height, 4)
		}

		// The last frame's pixels in a box of it, straight RGBA8, row 0 the box's top.
		//
		// Fails when the GPU does not finish.
		def read(left int, top int, wide int, high int) !byte[] {
			let out byte[]
			return out when stack.len() == 0
			return try dev.readPixels(stack[0], left, top, wide, high, 4)
		}

		// Retires every image: the device frees them once the GPU is done.
		def dispose() {
			for stack.len() > 0 {
				spare.push(stack.pop())
			}
			for let (_, t) in spare {
				dev.retire(t)
			}
			spare.len(0)
			dst.free(dev)
			coverage.free(dev)
			clip.free(dev)
			pixels.free(dev)
			table.free(dev)
			dev.retire(dither)
			dither = Image{}
			perm.free(dev)
			edges.free(dev)
			pending.len(0)
			drawTarget = Image{}
			for let (_, t) in planePool {
				dev.retire(t)
			}
			planePool.len(0)
			for let (_, c) in images {
				for let (_, l) in c.levels {
					dev.retire(l)
				}
			}
			images = map<string, CachedImage>{}
			imageBytes = 0
			freeVideoLevels()
			let planes = videoPlanes
			if planes is VideoPlanes {
				planes.free(dev)
				videoPlanes = none
			}
			dev.retire(linearTable)
			dev.retire(srgbTable)
			linearTable = Image{}
			srgbTable = Image{}
			width = 0
			height = 0
		}

		internal def start(w int, h int, keep bool = false) !none {
			if w != width || h != height {
				for stack.len() > 0 {
					dev.retire(stack.pop())
				}
				for let (_, t) in spare {
					dev.retire(t)
				}
				spare.len(0)
				width = w
				height = h
			}
			for stack.len() > 1 {
				spare.push(stack.pop())
			}
			if stack.len() == 0 {
				let t = try newTarget()
				stack.push(t)
			}
			clearTarget(stack[0]) unless keep
			return none
		}

		internal def newTarget() !Image {
			return spare.pop() when spare.len() > 0
			return try dev.createImage(width.max(1), height.max(1), vk.FORMAT_R8G8B8A8_UNORM, targetUsage)
		}

		internal def clearTarget(t Image) {
			dev.barrier()
			vk.cmdClear(dev.cmd, t.image, 0.0, 0.0, 0.0, 0.0)
		}

		internal def apply(op GpuOp, frame GpuFrame) !none {
			match op {
				case GpuDraw:
					try drawOp(op, frame)
				case GpuBlit:
					try blitOp(op)
				case GpuMove:
					try moveOp(op)
				case GpuBeginGroup:
					// A target may be a spare one a draw still waits to read.
					try flushDraws()
					let t = try newTarget()
					clearTarget(t)
					stack.push(t)
				case GpuEndGroup:
					return none when stack.len() < 2
					// The group's draws go in before it is read.
					try flushDraws()
					if op.effects.len() > 0 || op.margin > 0 {
						try endGroupEffects(op, frame)
						return none
					}
					let g = stack.pop()
					try composite(op.x, op.y, op.w, op.h, def (p Pass) !none {
						bindPaintPixels(p, g, 0, 0)
						try bindCoverage(p, op.coverage, op.w, op.h)
						p.uint(cAlpha, uint32(op.alpha))
						p.int(cComposite, int(op.composite))
						p.int(cBlend, int(op.blend))
						p.int(cPaired, 0)
						p.int(cOp, 1)
						return none
					})
					spare.push(g)
				case GpuBackdropBlur:
					try backdropOp(op)
			}
			return none
		}

		// `plane` (not empty): coverage is that plane rounded to bytes, and pixel
		// paints cover the box (px, py, pw, ph) rather than the draw's.
		internal def drawOp(d GpuDraw, frame GpuFrame, plane Image = Image{}, px int = 0, py int = 0, pw int = 0, ph int = 0) !none {
			let paint = d.paint
			// An image's level and a fragment paint's pixels are made before the
			// draw: they upload, convert and draw with other pipelines.
			let level = Image{}
			if paint is GpuImage {
				try ensureTables(frame)
				level = try imageLevel(paint)
			}
			let shaded = Image{}
			shaded = try fragmentPaint(paint, d) when paint is GpuFragment
			try composite(d.x, d.y, d.w, d.h, def (p Pass) !none {
				match paint {
					case GpuSolid:
						p.int(cPaintKind, 0)
						p.uint(cSolid, uint32(paint.r))
						p.uint(cSolid + 4, uint32(paint.g))
						p.uint(cSolid + 8, uint32(paint.b))
					case GpuPixels:
						if pw > 0 {
							try bindUploadedPixels(p, pw, ph, paint.pixels, px, py)
						} else {
							try bindUploadedPixels(p, d.w, d.h, paint.pixels, d.x, d.y)
						}
					case GpuGradient:
						p.int(cPaintKind, 3)
						try bindTable(p, paint.table, frame)
						p.int(cGradKind, int(paint.kind))
						p.int(cSpread, int(paint.spread))
						setInverse(p, paint.inv)
						for let (i, v) in paint.params {
							p.double(cParams + i * 16, float64(v)) when i < 8
						}
					case GpuImage:
						p.int(cPaintKind, 6)
						p.bind(sImage, level)
						p.bind(sToLinear, linearTable)
						p.bind(sToSrgb, srgbTable)
						p.int(cImageSize, level.w)
						p.int(cImageSize + 4, level.h)
						p.int(cImageSpread, int(paint.repeatX))
						p.int(cImageSpread + 4, int(paint.repeatY))
						p.int(cSampling, int(paint.sampling))
						let inv = paint.inv
						p.double(cParams, float64(inv.a))
						p.double(cParams + 16, float64(inv.b))
						p.double(cParams + 32, float64(inv.c))
						p.double(cParams + 48, float64(inv.d))
						p.double(cParams + 64, float64(inv.tx))
						p.double(cParams + 80, float64(inv.ty))
						let tint = paint.tint
						if tint is RGBA {
							p.int(cTinted, 1)
							p.uint(cTint, uint32(tint.r))
							p.uint(cTint + 4, uint32(tint.g))
							p.uint(cTint + 8, uint32(tint.b))
							p.uint(cTint + 12, uint32(tint.a))
						}
					case GpuNoise:
						p.int(cPaintKind, 4)
						try bindTable(p, paint.table, frame)
						setInverse(p, paint.inv)
						p.int(cOctaves, paint.octaves)
						p.bind(sPerm, try perm.upload(dev, paint.perm.len(), 1, paint.perm))
					case GpuFragment:
						// Shaded by its own pass (or the CPU) into pixels over the box.
						bindPaintPixels(p, shaded, d.x, d.y)
				}
				try bindCoverage(p, d.coverage, d.w, d.h)
				try bindClip(p, d.clip, d.w, d.h)
				p.uint(cAlpha, uint32(d.alpha))
				p.int(cComposite, int(d.composite))
				p.int(cBlend, int(d.blend))
				// fillCoverage's pair table, for large shaded fills in a
				// per-channel mode.
				let paired = !(paint is GpuSolid) && !d.layer && d.composite == Composite.SourceOver && perChannelMode(d.blend) && d.w * d.h >= 128 * 128
				p.int(cPaired, paired ?? (1, 0))
				p.int(cOp, d.layer ?? (1, 0))
				if d.quad.len() == 8 {
					p.int(cHasQuad, 1)
					p.int(cHardQuad, d.antialias ?? (0, 1))
					for let (i, v) in d.quad {
						p.double(cQuad + i * 16, float64(v))
					}
				}
				if d.edges.len() > 0 {
					try bindEdges(p, d)
				}
				if plane.image != 0 {
					p.bind(sPlane, plane)
					p.int(cCoverageFromPlane, 1)
				}
				return none
			})
			return none
		}

		// The pixels of a `@fragment` paint over the draw's box: shaded by the
		// fragment's SPIR-V module in a pass of its own when the compiler made
		// one, else on the CPU as the canvas shades it.
		internal def fragmentPaint(f GpuFragment, d GpuDraw) !Image {
			// The pixels image is written before the last draw that read it is done.
			dev.barrier()
			let code = f.shader.spirv
			return try pixels.upload(dev, d.w, d.h, fragmentPixels(f, d.x, d.y, d.w, d.h)) when code.len() == 0
			let out = try pixels.ensure(dev, d.w, d.h)
			let (setLayout, pipelineLayout) = try dev.layout("paint", 1, true, 0, 0)
			let vs = try dev.shader("paint.vert", paintVertexSpirv)
			let fs = try dev.shader("fragment:" + f.shader.name, code)
			let pipeline = try dev.pipeline("paint:" + f.shader.name, pipelineLayout, vs, fs, vk.FORMAT_R8G8B8A8_UNORM)
			// The fragment's uniforms as its std140 block, in parameter order.
			let uniforms byte[]
			let at = 0
			for let (_, param) in f.shader.params {
				let (align, size, slots) = (4, 4, 1)
				match param.kind {
					case FragmentKind.Vec2:
						(align, size, slots) = (8, 8, 2)
					case FragmentKind.Vec3:
						(align, size, slots) = (16, 12, 3)
					case FragmentKind.Vec4:
						(align, size, slots) = (16, 16, 4)
					default:
				}
				at = (at + align - 1) / align * align
				uniforms.len(at + size)
				for let k = 0; k < slots; k++ {
					let v = param.offset + k < f.uniforms.len() ?? (f.uniforms[param.offset + k], float32(0))
					match param.kind {
						case FragmentKind.Int32:
							putI32(uniforms, at + k * 4, int(v))
						case FragmentKind.Bool:
							putI32(uniforms, at + k * 4, v != float32(0) ?? (1, 0))
						default:
							putF32(uniforms, at + k * 4, v)
					}
				}
				at += size
			}
			uniforms.len(((at + 15) / 16 * 16).max(16))
			let placement byte[]
			placement.len(48)
			putF32(placement, 0, float32(f.inv.a))
			putF32(placement, 4, float32(f.inv.b))
			putF32(placement, 8, float32(f.inv.c))
			putF32(placement, 12, float32(f.inv.d))
			putF32(placement, 16, float32(f.inv.tx))
			putF32(placement, 20, float32(f.inv.ty))
			putF32(placement, 24, float32(d.x))
			putF32(placement, 28, float32(d.y))
			putF32(placement, 32, float32(d.w))
			putF32(placement, 36, float32(d.h))
			let (ub, uo) = try dev.stage(uniforms, uniforms.len())
			let (pb, po) = try dev.stage(placement, placement.len())
			let set = try dev.set(setLayout, uint[ub, pb], uint[uo, po], uint[uint(uniforms.len()), uint(placement.len())], uint[], uint[])
			dev.barrier()
			vk.cmdBeginRendering(dev.cmd, out.view, vk.LAYOUT_GENERAL, 0, 0, uint32(d.w), uint32(d.h), false, 0.0, 0.0, 0.0, 0.0)
			vk.cmdBind(dev.cmd, pipeline, pipelineLayout, set)
			// The viewport is the box, so that the position the vertex stage
			// interpolates is the pixel's own (paint.vert reads the box's size).
			vk.cmdViewportScissor(dev.cmd, uint32(d.w), uint32(d.h), 0, 0, uint32(d.w), uint32(d.h))
			vk.cmdDraw(dev.cmd, 3)
			vk.cmdEndRendering(dev.cmd)
			return out
		}

		// The draw's path edges on the edges image for the shader's coverage:
		// per band of edgeBandRows rows of the box, the index of its first edge
		// and how many cross it, then the edges, x0 y0 x1 y1 a texel, edgeRow
		// texels a row (canvas.frag's EdgeRow and EdgeBandRows).
		internal def bindEdges(p Pass, d GpuDraw) !none {
			let e = d.edges
			let bands = (d.h + edgeBandRows - 1) / edgeBandRows
			let counts int[]
			counts.len(bands)
			for let i = 0; i < e.len(); i += 4 {
				let (first, last) = edgeBands(e, i, d.y, d.h)
				for let b = first; b <= last; b++ {
					counts[b]++
				}
			}
			let starts int[]
			starts.len(bands)
			let total = bands
			for let b = 0; b < bands; b++ {
				starts[b] = total
				total += counts[b]
			}
			let rows = (total + edgeRow - 1) / edgeRow
			let data float32[]
			data.len(rows * edgeRow * 4)
			for let b = 0; b < bands; b++ {
				data[b * 4] = float32(starts[b])
				data[b * 4 + 1] = float32(counts[b])
			}
			let next = starts.clone()
			for let i = 0; i < e.len(); i += 4 {
				let (first, last) = edgeBands(e, i, d.y, d.h)
				for let b = first; b <= last; b++ {
					let at = next[b] * 4
					data[at] = float32(e[i])
					data[at + 1] = float32(e[i + 1])
					data[at + 2] = float32(e[i + 2])
					data[at + 3] = float32(e[i + 3])
					next[b]++
				}
			}
			p.bind(sEdges, try edges.upload(dev, edgeRow, rows, data))
			p.int(cEdgeBands, bands)
			p.int(cEvenOdd, d.rule == FillRule.EvenOdd ?? (1, 0))
			p.int(cHardQuad, d.antialias ?? (0, 1))
			return none
		}

		internal def blitOp(b GpuBlit) !none {
			let x0 = b.x.max(0)
			let y0 = b.y.max(0)
			let x1 = (b.x + b.w).min(width)
			let y1 = (b.y + b.h).min(height)
			return none when x0 >= x1 || y0 >= y1
			return try composite(x0, y0, x1 - x0, y1 - y0, def (p Pass) !none {
				try bindUploadedPixels(p, b.w, b.h, b.pixels, b.x, b.y)
				p.int(cBlend, int(b.blend))
				p.int(cOp, b.copy ?? (2, 3))
				return none
			})
		}

		// Moves a box of the current target: copied to the pixels image, then
		// drawn back at its new place as a copying blit is.
		internal def moveOp(m GpuMove) !none {
			return none when m.w <= 0 || m.h <= 0
			let t = stack[stack.len() - 1]
			let held = try pixels.ensure(dev, m.w, m.h)
			try flushDraws()
			dev.barrier()
			vk.cmdCopyImage(dev.cmd, t.image, int32(m.x), int32(m.y), held.image, 0, 0, uint32(m.w), uint32(m.h))
			let (x, y) = (m.x + m.dx, m.y + m.dy)
			return try composite(x, y, m.w, m.h, def (p Pass) !none {
				bindPaintPixels(p, held, x, y)
				p.int(cBlend, 0)
				p.int(cOp, 2)
				return none
			})
		}

		// Backdrop blur on the CPU: the box read back, blurred as the canvas
		// does, and written again.
		internal def backdropOp(b GpuBackdropBlur) !none {
			return none when b.w <= 0 || b.h <= 0
			let t = stack[stack.len() - 1]
			try flushDraws()
			let box = try dev.readPixels(t, b.x, b.y, b.w, b.h, 4)
			b.apply(box)
			try dev.upload(t, b.x, b.y, b.w, b.h, 4, box)
			dev.barrier()
			return none
		}

		// Runs the canvas shader over the box of the current target: lets
		// `setup` set the paint and coverage (uploading what they need) and
		// draws, reading the target's own pixels within the render pass on a
		// device with local read (the draw joins the pending run), else after
		// copying the box to a destination image.
		internal def composite(x int, y int, w int, h int, setup def(Pass) !none) !none {
			return none when w <= 0 || h <= 0
			let t = stack[stack.len() - 1]
			let p = try canvasPass()
			p.int(cBox, x)
			p.int(cBox + 4, y)
			p.int(cBox + 8, w)
			p.int(cBox + 12, h)
			if dev.localRead {
				if drawTarget.image != t.image {
					try flushDraws()
					drawTarget = t
				}
				p.bind(sDst, t)
				try setup(p)
				let (setLayout, _) = try dev.layout("canvasLocal", 1, false, 1, canvasSamplers - 1)
				let (buffer, at) = try dev.stage(p.block, canvasBlock)
				let set = try dev.set(setLayout, uint[buffer], uint[at], uint[uint(canvasBlock)], p.views, p.samplers, 1)
				pending.push(Draw{set: set, x: x, y: y, w: w, h: h})
				return none
			}
			// The target's last draw is done before the copy reads it.
			dev.barrier()
			let d = try dst.ensure(dev, w, h)
			vk.cmdCopyImage(dev.cmd, t.image, int32(x), int32(y), d.image, 0, 0, uint32(w), uint32(h))
			p.bind(sDst, d)
			try setup(p)
			let (setLayout, pipelineLayout) = try dev.layout("canvas", 1, false, 0, canvasSamplers)
			let pipeline = try canvasPipeline(pipelineLayout)
			let (buffer, at) = try dev.stage(p.block, canvasBlock)
			let set = try dev.set(setLayout, uint[buffer], uint[at], uint[uint(canvasBlock)], p.views, p.samplers)
			// The copies above are done before the draw samples them.
			dev.barrier()
			vk.cmdBeginRendering(dev.cmd, t.view, vk.LAYOUT_GENERAL, int32(x), int32(y), uint32(w), uint32(h), false, 0.0, 0.0, 0.0, 0.0)
			vk.cmdBind(dev.cmd, pipeline, pipelineLayout, set)
			vk.cmdViewportScissor(dev.cmd, uint32(t.w), uint32(t.h), int32(x), int32(y), uint32(w), uint32(h))
			vk.cmdDraw(dev.cmd, 3)
			vk.cmdEndRendering(dev.cmd)
			return none
		}

		// Draws the pending run into its target in one render pass, each draw
		// after the first seeing the pixels the ones before it wrote.
		internal def flushDraws() !none {
			return none when pending.len() == 0
			let t = drawTarget
			let (_, pipelineLayout) = try dev.layout("canvasLocal", 1, false, 1, canvasSamplers - 1)
			let pipeline = try localPipeline(pipelineLayout)
			// The uploads and copies before the run are done.
			dev.barrier()
			vk.cmdBeginRendering(dev.cmd, t.view, vk.LAYOUT_GENERAL, 0, 0, uint32(t.w), uint32(t.h), false, 0.0, 0.0, 0.0, 0.0)
			for let (i, d) in pending {
				vk.cmdLocalBarrier(dev.cmd) when i > 0
				vk.cmdBind(dev.cmd, pipeline, pipelineLayout, d.set)
				vk.cmdViewportScissor(dev.cmd, uint32(t.w), uint32(t.h), int32(d.x), int32(d.y), uint32(d.w), uint32(d.h))
				vk.cmdDraw(dev.cmd, 3)
			}
			vk.cmdEndRendering(dev.cmd)
			pending.len(0)
			return none
		}

		// A canvas pass with its samplers on dummies of the right kind and the
		// solid colour's alpha and tables as the shader expects them unset.
		internal def canvasPass() !Pass {
			let byteDummy = try dev.dummy(vk.FORMAT_R8_UNORM)
			let p = new Pass(canvasBlock, canvasSamplers, byteDummy.view, dev.nearest, dev.float64)
			p.bind(sTable, try dev.dummy(vk.FORMAT_R16G16B16A16_UINT))
			p.bind(sPerm, try dev.dummy(vk.FORMAT_R32_SINT))
			p.bind(sEdges, try dev.dummy(vk.FORMAT_R32G32B32A32_SFLOAT))
			let rgba = try dev.dummy(vk.FORMAT_R8G8B8A8_UNORM)
			p.bind(sPixels, rgba)
			p.bind(sImage, rgba)
			p.bind(sPlane, try dev.dummy(vk.FORMAT_R32_SFLOAT))
			return p
		}

		internal def canvasPipeline(pipelineLayout uint) !uint {
			let vs = try dev.shader("canvas.vert", canvasVertexSpirv)
			let fs = dev.float64 ?? (try dev.shader("canvas.frag", canvasFragmentSpirv), try dev.shader("canvas.f32.frag", canvasFragmentF32Spirv))
			return try dev.pipeline("canvas", pipelineLayout, vs, fs, vk.FORMAT_R8G8B8A8_UNORM)
		}

		// The canvas pipeline reading its target back within the render pass.
		internal def localPipeline(pipelineLayout uint) !uint {
			let vs = try dev.shader("canvas.vert", canvasVertexSpirv)
			let fs = dev.float64 ?? (try dev.shader("canvas.local.frag", canvasLocalFragmentSpirv), try dev.shader("canvas.local.f32.frag", canvasLocalFragmentF32Spirv))
			return try dev.pipeline("canvasLocal", pipelineLayout, vs, fs, vk.FORMAT_R8G8B8A8_UNORM, true)
		}

		internal def bindPaintPixels(p Pass, img Image, ox int, oy int) {
			p.bind(sPixels, img)
			p.int(cPixelsOrigin, ox)
			p.int(cPixelsOrigin + 4, oy)
			p.int(cPaintKind, 1)
		}

		// Uploads w x h pixels as the paint, texel (0, 0) at target pixel
		// (ox, oy).
		internal def bindUploadedPixels(p Pass, w int, h int, bytes byte[], ox int, oy int) !none {
			bindPaintPixels(p, try pixels.upload(dev, w, h, bytes), ox, oy)
			return none
		}

		// Device pixels to the paint's space.
		internal def setInverse(p Pass, inv Transform2D) {
			p.float(cInvX, float32(inv.a))
			p.float(cInvX + 4, float32(inv.b))
			p.float(cInvY, float32(inv.c))
			p.float(cInvY + 4, float32(inv.d))
			p.float(cInvT, float32(inv.tx))
			p.float(cInvT + 4, float32(inv.ty))
		}

		// A gradient table, and the blue noise.
		internal def bindTable(p Pass, entries uint16[], frame GpuFrame) !none {
			p.bind(sTable, try table.upload(dev, entries.len() / 4, 1, entries))
			if dither.image == 0 {
				dither = try dev.createImage(64, 64, vk.FORMAT_R8_UNORM, sampledUsage)
				try dev.upload(dither, 0, 0, 64, 64, 1, frame.blueNoise())
			}
			p.bind(sBlueNoise, dither)
			return none
		}

		internal def bindCoverage(p Pass, bytes byte[], w int, h int) !none {
			if bytes.len() > 0 {
				p.bind(sCoverage, try coverage.upload(dev, w, h, bytes))
				p.int(cHasCoverage, 1)
			}
			return none
		}

		internal def bindClip(p Pass, bytes byte[], w int, h int) !none {
			if bytes.len() > 0 {
				p.bind(sClip, try clip.upload(dev, w, h, bytes))
				p.int(cHasClip, 1)
			}
			return none
		}

		// The image of the image paint's level, from the cache while its key
		// stays the same: the window uploaded, then halved on the GPU.
		internal def imageLevel(img GpuImage) !Image {
			let picture = img.video
			return try videoLevel(picture, img.halvings) when picture is video.VideoFrame
			let key = "{img.key}"
			if !images.hasKey(key) {
				let base = try dev.createImage(img.ww, img.wh, vk.FORMAT_R8G8B8A8_UNORM, targetUsage)
				// The window's rows, packed.
				let rows byte[]
				rows.len(img.ww * img.wh * 4)
				for let j = 0; j < img.wh; j++ {
					let from = (img.wy + j) * img.stride + img.wx * 4
					let to = j * img.ww * 4
					for let i = 0; i < img.ww * 4; i++ {
						rows[to + i] = img.pixels[from + i]
					}
				}
				try dev.upload(base, 0, 0, img.ww, img.wh, 4, rows)
				let levels Image[]
				levels.push(base)
				images = images.set(key, new CachedImage(levels))
				imageBytes += img.ww * img.wh * 4
			}
			let cached = images[key]
			cached.used = frameCount
			for cached.levels.len() <= img.halvings {
				let below = cached.levels[cached.levels.len() - 1]
				let next = try dev.createImage((below.w + 1) / 2, (below.h + 1) / 2, vk.FORMAT_R8G8B8A8_UNORM, targetUsage)
				try halveInto(below, next)
				cached.levels.push(next)
				imageBytes += next.w * next.h * 4
			}
			return cached.levels[img.halvings]
		}

		// The image of a video frame's level: the picture converted from its
		// planes by the video pipeline, then halved on the GPU. A frame with
		// nothing to show is black.
		internal def videoLevel(frame video.VideoFrame, halvings int) !Image {
			videoPlanes = new VideoPlanes() when videoPlanes is none
			let planes = videoPlanes
			fail "the video planes are missing" when planes is none
			let w = int(frame.width).max(1)
			let h = int(frame.height).max(1)
			freeVideoLevels() when videoLevels.len() > 0 && (videoLevels[0].w != w || videoLevels[0].h != h)
			videoLevels.push(try dev.createImage(w, h, vk.FORMAT_R8G8B8A8_UNORM, targetUsage)) when videoLevels.len() == 0
			let base = videoLevels[0]
			if !(try planes.convert(dev, frame, base)) {
				dev.barrier()
				vk.cmdClear(dev.cmd, base.image, 0.0, 0.0, 0.0, 1.0)
			}
			for let k = 1; k <= halvings; k++ {
				if videoLevels.len() <= k {
					let below = videoLevels[k - 1]
					videoLevels.push(try dev.createImage((below.w + 1) / 2, (below.h + 1) / 2, vk.FORMAT_R8G8B8A8_UNORM, targetUsage))
				}
				try halveInto(videoLevels[k - 1], videoLevels[k])
			}
			return videoLevels[halvings]
		}

		internal def freeVideoLevels() {
			for let (_, l) in videoLevels {
				dev.retire(l)
			}
			videoLevels.len(0)
		}

		// halveLevel on the GPU: `below` averaged 2x2 into `next`.
		internal def halveInto(below Image, next Image) !none {
			let e = try effectsPass(EffectMode.Halve)
			e.int(eW, below.w)
			e.int(eH, below.h)
			e.bind(eImage, below)
			e.bind(eLinear, linearTable)
			e.bind(eSrgb, srgbTable)
			return try runEffects(e, next, 0, 0, next.w, next.h)
		}

		// Drops images no frame drew for a while, oldest first, once the
		// cache holds more than its budget.
		internal def trimImages() {
			return when imageBytes <= imageBudget
			let keys = images.keys()
			for let (_, k) in keys {
				let c = images.get(k)
				continue when c is none || frameCount - c.used < 2
				for let (_, l) in c.levels {
					dev.retire(l)
					imageBytes -= l.w * l.h * 4
				}
				images = images.delete(k)
				return when imageBytes <= imageBudget
			}
		}

		// A group with effects closed as the canvas's closeGroup does: the
		// exact region from the group's pixels, then the effects as passes
		// over float planes, the planes below and the group composited onto
		// the target below.
		internal def endGroupEffects(op GpuEndGroup, frame GpuFrame) !none {
			let g = stack.pop()
			if op.w <= 0 || op.h <= 0 {
				spare.push(g)
				return none
			}
			// The region lowering found: what the group drew, grown by the effects'
			// margin. Past what was drawn there is nothing, at least a margin away,
			// so the effects come out the same over it.
			let r = EffectRegion{x: op.x, y: op.y, w: op.w, h: op.h, pw: (op.w + 7) / 8 * 8}
			let cov = coverageWithin(op, r.x, r.y, r.w, r.h)
			try ensureTables(frame)
			stack.push(g)
			let used Image[]
			let shape = try alphaOf(r, used, g)
			let dist = shape
			let haveDist = false
			let below Image[]
			let colors RGBA[]
			let blends BlendMode[]
			let showContent = true
			for let (_, fx) in op.effects {
				match fx.kind {
					case GpuEffectKind.DropShadow:
						let a = shape
						if fx.grow != 0.0 {
							if !haveDist {
								dist = try signedDistance(r, used, shape)
								haveDist = true
							}
							a = try grown(r, used, dist, fx.grow)
						}
						let sh = try shifted(r, used, a, fx.dx, fx.dy, 0.0)
						sh = try blurPlane(r, used, sh, fx.radii)
						if fx.knockout {
							sh = try binary(r, used, EffectMode.MultiplyInverse, sh, shape)
							showContent = false
						}
						below.push(sh)
						colors.push(fx.color)
						blends.push(BlendMode.Normal)
					case GpuEffectKind.OuterGlow:
						let a = try unary(r, used, EffectMode.Copy, shape)
						if fx.grow != 0.0 {
							if !haveDist {
								dist = try signedDistance(r, used, shape)
								haveDist = true
							}
							a = try grown(r, used, dist, fx.grow)
						}
						a = try blurPlane(r, used, a, fx.radii)
						below.push(a)
						colors.push(fx.color)
						blends.push(fx.blend)
					case GpuEffectKind.InnerShadow:
						let outside = try unary(r, used, EffectMode.Inverted, shape)
						if fx.grow != 0.0 {
							if !haveDist {
								dist = try signedDistance(r, used, shape)
								haveDist = true
							}
							let g2 = try grown(r, used, dist, -fx.grow)
							outside = try unary(r, used, EffectMode.Inverted, g2)
						}
						let sh = try shifted(r, used, outside, fx.dx, fx.dy, 1.0)
						sh = try blurPlane(r, used, sh, fx.radii)
						sh = try binary(r, used, EffectMode.Multiply, sh, shape)
						try atop(r, sh, fx.color, BlendMode.Normal)
					case GpuEffectKind.InnerGlow:
						let glow = try unary(r, used, EffectMode.Inverted, shape)
						glow = try blurPlane(r, used, glow, fx.radii)
						glow = try binary(r, used, EffectMode.Multiply, glow, shape)
						try atop(r, glow, fx.color, fx.blend)
					case GpuEffectKind.Outline:
						if !haveDist {
							dist = try signedDistance(r, used, shape)
							haveDist = true
						}
						let w = fx.grow
						let (outer, inner) = (w, 0.0)
						if fx.position == OutlinePosition.Inside {
							(outer, inner) = (0.0, -w)
						} else if fx.position == OutlinePosition.Center {
							(outer, inner) = (w / 2.0, -w / 2.0)
						}
						let ga = try grown(r, used, dist, outer)
						let gb = try grown(r, used, dist, inner)
						let ring = try binary(r, used, EffectMode.Ring, ga, gb)
						let paint = fx.paint
						if !(paint is none) {
							let solidAlpha = 255
							solidAlpha = int(paint.a) when paint is GpuSolid
							try drawOp(GpuDraw{x: r.x, y: r.y, w: r.w, h: r.h, paint: paint, alpha: solidAlpha, composite: Composite.SourceOver, blend: BlendMode.Normal}, frame, ring, op.x, op.y, op.w, op.h)
						}
					case GpuEffectKind.Blur:
						try colourBlur(r, used, g, fx.radii, Image{})
						shape = try alphaOf(r, used, g)
						haveDist = false
					case GpuEffectKind.BackdropBlur:
						let within = try unary(r, used, EffectMode.Covered, shape)
						try colourBlur(r, used, stack[stack.len() - 2], fx.radii, within)
					case GpuEffectKind.ColorMatrix:
						try colorMatrix(r, fx.matrix)
				}
			}
			stack.pop()
			for let (i, l) in below {
				let c = colors[i]
				let mode = blends[i]
				try composite(r.x, r.y, r.w, r.h, def (p Pass) !none {
					p.int(cPaintKind, 5)
					p.uint(cSolid, uint32(c.r))
					p.uint(cSolid + 4, uint32(c.g))
					p.uint(cSolid + 8, uint32(c.b))
					p.uint(cSolidA, uint32(c.a))
					p.bind(sPlane, l)
					try bindCoverage(p, cov, r.w, r.h)
					p.uint(cAlpha, uint32(op.alpha))
					p.int(cComposite, int(Composite.SourceOver))
					p.int(cBlend, int(mode))
					p.int(cPaired, 0)
					p.int(cOp, 1)
					return none
				})
			}
			if showContent {
				try composite(r.x, r.y, r.w, r.h, def (p Pass) !none {
					bindPaintPixels(p, g, 0, 0)
					try bindCoverage(p, cov, r.w, r.h)
					p.uint(cAlpha, uint32(op.alpha))
					p.int(cComposite, int(op.composite))
					p.int(cBlend, int(op.blend))
					p.int(cPaired, 0)
					p.int(cOp, 1)
					return none
				})
			}
			for let (_, t) in used {
				planePool.push(t)
			}
			spare.push(g)
			return none
		}

		// alphaPlane of the group over the region.
		internal def alphaOf(r EffectRegion, used Image[], g Image) !Image {
			return try pass(r, used, EffectMode.Alpha, vk.FORMAT_R32_SFLOAT, def (e Pass) {
				bindImage(e, g, r)
			})
		}

		// The group's coverage bytes over the region, from its box's.
		internal def coverageWithin(op GpuEndGroup, x int, y int, w int, h int) byte[] {
			return byte[] when op.coverage.len() == 0
			let out byte[]
			out.len(w * h)
			for let j = 0; j < h; j++ {
				let from = (y - op.y + j) * op.w + (x - op.x)
				for let i = 0; i < w; i++ {
					out[j * w + i] = op.coverage[from + i]
				}
			}
			return out
		}

		// An effects pass with its samplers on dummies.
		internal def effectsPass(mode EffectMode) !Pass {
			let dummy = try dev.dummy(vk.FORMAT_R32_SFLOAT)
			let e = new Pass(effectsBlock, effectsSamplers, dummy.view, dev.nearest, dev.float64)
			let rgba = try dev.dummy(vk.FORMAT_R8G8B8A8_UNORM)
			e.bind(eImage, rgba)
			e.bind(eOld, rgba)
			e.int(eMode, int(mode))
			return e
		}

		// Draws the effects pass over the box of `into`.
		internal def runEffects(e Pass, into Image, x int, y int, w int, h int) !none {
			// Draws waiting on the target go in first: a pass may read it.
			try flushDraws()
			let (setLayout, pipelineLayout) = try dev.layout("effects", 1, false, 0, effectsSamplers)
			let vs = try dev.shader("canvas.vert", canvasVertexSpirv)
			let fs = dev.float64 ?? (try dev.shader("effects.frag", effectsFragmentSpirv), try dev.shader("effects.f32.frag", effectsFragmentF32Spirv))
			let pipeline = try dev.pipeline("effects", pipelineLayout, vs, fs, into.format)
			let (buffer, at) = try dev.stage(e.block, effectsBlock)
			let set = try dev.set(setLayout, uint[buffer], uint[at], uint[uint(effectsBlock)], e.views, e.samplers)
			// What the pass reads was written by the passes and copies before it.
			dev.barrier()
			vk.cmdBeginRendering(dev.cmd, into.view, vk.LAYOUT_GENERAL, int32(x), int32(y), uint32(w), uint32(h), false, 0.0, 0.0, 0.0, 0.0)
			vk.cmdBind(dev.cmd, pipeline, pipelineLayout, set)
			vk.cmdViewportScissor(dev.cmd, uint32(into.w), uint32(into.h), int32(x), int32(y), uint32(w), uint32(h))
			vk.cmdDraw(dev.cmd, 3)
			vk.cmdEndRendering(dev.cmd)
			return none
		}

		// A pass of the effects shader into a new plane of the region.
		internal def pass(r EffectRegion, used Image[], mode EffectMode, format uint32, setup def(Pass)) !Image {
			let out = try planeOf(r.pw, r.h, format)
			used.push(out)
			let e = try effectsPass(mode)
			e.int(eW, r.w)
			e.int(eH, r.h)
			e.int(ePW, r.pw)
			setup(e)
			try runEffects(e, out, 0, 0, r.pw, r.h)
			return out
		}

		internal def unary(r EffectRegion, used Image[], mode EffectMode, a Image) !Image {
			return try pass(r, used, mode, a.format, def (e Pass) {
				e.bind(eA, a)
			})
		}

		internal def binary(r EffectRegion, used Image[], mode EffectMode, a Image, b Image) !Image {
			return try pass(r, used, mode, vk.FORMAT_R32_SFLOAT, def (e Pass) {
				e.bind(eA, a)
				e.bind(eB, b)
			})
		}

		// shifted: the plane moved by (dx, dy), `outside` coming in.
		internal def shifted(r EffectRegion, used Image[], a Image, dx float, dy float, outside float) !Image {
			return try unary(r, used, EffectMode.Copy, a) when dx == 0.0 && dy == 0.0
			let (fx, fy) = (dx.floor(), dy.floor())
			return try pass(r, used, EffectMode.Shifted, vk.FORMAT_R32_SFLOAT, def (e Pass) {
				e.bind(eA, a)
				e.int(eI, int(fx))
				e.int(eI + 4, int(fy))
				e.float(eF, float32(dx - fx))
				e.float(eF + 4, float32(dy - fy))
				e.float(eF + 8, float32(outside))
			})
		}

		// grown: clamp(0.5 + by - distance, 0, 1).
		internal def grown(r EffectRegion, used Image[], dist Image, by float) !Image {
			return try pass(r, used, EffectMode.Grown, vk.FORMAT_R32_SFLOAT, def (e Pass) {
				e.bind(eA, dist)
				e.float(eF, float32(0.5 + by))
			})
		}

		// blurPlane: three box passes down, then three across.
		internal def blurPlane(r EffectRegion, used Image[], a Image, radii int[]) !Image {
			let cur = a
			for let dir = 0; dir < 2; dir++ {
				for let (_, br) in radii {
					continue when br <= 0
					let src = cur
					cur = try pass(r, used, EffectMode.Box, a.format, def (e Pass) {
						e.bind(eA, src)
						e.int(eI, br)
						e.int(eI + 4, dir)
						e.float(eF, float32(1.0 / float(2 * br + 1)))
					})
				}
			}
			return cur
		}

		// signedDistance from exact distance transforms to the inside and
		// the outside.
		internal def signedDistance(r EffectRegion, used Image[], shape Image) !Image {
			let toInside = try distanceTo(r, used, shape, true)
			let toOutside = try distanceTo(r, used, shape, false)
			return try pass(r, used, EffectMode.Signed, vk.FORMAT_R32_SFLOAT, def (e Pass) {
				e.bind(eA, shape)
				e.bind(eB, toInside)
				e.bind(eC, toOutside)
			})
		}

		internal def distanceTo(r EffectRegion, used Image[], shape Image, inside bool) !Image {
			let d = try pass(r, used, EffectMode.DistanceInit, vk.FORMAT_R32_SFLOAT, def (e Pass) {
				e.bind(eA, shape)
				e.int(eI, inside ?? (1, 0))
			})
			let edge = inside ?? (float32(1e20), float32(0))
			let cols = try pass(r, used, EffectMode.DistanceColumns, vk.FORMAT_R32_SFLOAT, def (e Pass) {
				e.bind(eA, d)
				e.float(eF, edge)
			})
			return try pass(r, used, EffectMode.DistanceRows, vk.FORMAT_R32_SFLOAT, def (e Pass) {
				e.bind(eA, cols)
				e.float(eF, edge)
			})
		}

		// blurWhere on the target's region: premultiplied linear light,
		// blurred, written back (as far as `within` covers, when given).
		internal def colourBlur(r EffectRegion, used Image[], t Image, radii int[], within Image) !none {
			let lin = try pass(r, used, EffectMode.Linear, vk.FORMAT_R32G32B32A32_SFLOAT, def (e Pass) {
				bindImage(e, t, r)
				e.bind(eLinear, linearTable)
			})
			let blurred = try blurPlane(r, used, lin, radii)
			// The region's pixels before, then the store over them.
			try flushDraws()
			dev.barrier()
			let old = try dst.ensure(dev, r.w, r.h)
			vk.cmdCopyImage(dev.cmd, t.image, int32(r.x), int32(r.y), old.image, 0, 0, uint32(r.w), uint32(r.h))
			let e = try effectsPass(EffectMode.Store)
			e.bind(eOld, old)
			e.bind(eA, blurred)
			e.bind(eSrgb, srgbTable)
			e.int(eOrigin, r.x)
			e.int(eOrigin + 4, r.y)
			if within.image != 0 {
				e.bind(eB, within)
				e.int(eI, 1)
			}
			return try runEffects(e, t, r.x, r.y, r.w, r.h)
		}

		// paintAtop over the current target's region.
		internal def atop(r EffectRegion, plane Image, c RGBA, mode BlendMode) !none {
			return try composite(r.x, r.y, r.w, r.h, def (p Pass) !none {
				p.int(cPaintKind, 0)
				p.uint(cSolid, uint32(c.r))
				p.uint(cSolid + 4, uint32(c.g))
				p.uint(cSolid + 8, uint32(c.b))
				p.uint(cSolidA, uint32(c.a))
				p.bind(sPlane, plane)
				p.int(cBlend, int(mode))
				p.int(cOp, 4)
				return none
			})
		}

		// applyMatrix over the current target's region.
		internal def colorMatrix(r EffectRegion, m float[]) !none {
			return try composite(r.x, r.y, r.w, r.h, def (p Pass) !none {
				for let j = 0; j < 5; j++ {
					p.float(cMatrix + j * 16, float32(m[j]))
					p.float(cMatrix + j * 16 + 4, float32(m[5 + j]))
					p.float(cMatrix + j * 16 + 8, float32(m[10 + j]))
					p.float(cMatrix + j * 16 + 12, float32(m[15 + j]))
				}
				p.int(cOp, 5)
				return none
			})
		}

		internal def bindImage(e Pass, img Image, r EffectRegion) {
			e.bind(eImage, img)
			e.int(eOrigin, r.x)
			e.int(eOrigin + 4, r.y)
		}

		// A float plane of w x h, from the pool when one fits.
		internal def planeOf(w int, h int, format uint32) !Image {
			for let (i, t) in planePool {
				if t.w == w && t.h == h && t.format == format {
					let last = planePool.len() - 1
					planePool[i] = planePool[last]
					planePool.len(last)
					return t
				}
			}
			return try dev.createImage(w, h, format, targetUsage)
		}

		// The colour tables colour blurs and halving read through.
		internal def ensureTables(frame GpuFrame) !none {
			return none when linearTable.image != 0
			linearTable = try dev.createImage(256, 1, vk.FORMAT_R32_SFLOAT, sampledUsage)
			let (lb, la) = try dev.stageFloats(frame.srgbToLinear())
			vk.cmdCopyToImage(dev.cmd, lb, la, 0, linearTable.image, 0, 0, 256, 1)
			srgbTable = try dev.createImage(4096, 1, vk.FORMAT_R8_UNORM, sampledUsage)
			try dev.upload(srgbTable, 0, 0, 4096, 1, 1, frame.linearToSrgb())
			return none
		}
	}

	// The first and last band of a box `h` rows high from row `y0` that the
	// edge at `i` crosses; first > last when none.
	internal def edgeBands(e float[], i int, y0 int, h int) (int, int) {
		let ya = e[i + 1].min(e[i + 3]) - float(y0)
		let yb = e[i + 1].max(e[i + 3]) - float(y0)
		return (1, 0) when yb <= 0.0 || ya >= float(h) || ya == yb
		return (int(ya.max(0.0)) / edgeBandRows, (int(yb.ceil()).min(h) - 1) / edgeBandRows)
	}

	// Whether the canvas blends the mode channel by channel.
	internal def perChannelMode(mode BlendMode) bool {
		return !(mode := BlendMode.Normal || BlendMode.DarkerColor || BlendMode.LighterColor || BlendMode.Hue || BlendMode.Saturation || BlendMode.Color || BlendMode.Luminosity)
	}
}
