partial module std.ui.renderer.vulkan {
	use (
		std.testing
		std.crypto.hash::SHA256
		std.data.encoding
		std.formats.video as video
		std.gfx.canvas::DrawContext
		std.math.geom::Size
		std.ui.renderer.scenes
		std.ui.renderer.vulkan.vk
	)

	// An H.264 stream (Main profile, CABAC, 3 frames; the one
	// std/formats/video/h264_test.adm decodes) for the picture the GPU decodes.
	internal const h264GpuStream = ""

	// The shader sources the embedded SPIR-V was compiled from, for the check
	// that they are still the same (tools/build-spirv.sh).
	@embed("../opengl/shaders/canvas.vert")
	internal const glslCanvasVertex byte[]

	@embed("../opengl/shaders/canvas.frag")
	internal const glslCanvasFragment byte[]

	@embed("../opengl/shaders/effects.frag")
	internal const glslEffectsFragment byte[]

	@embed("shaders/present.frag")
	internal const glslPresentFragment byte[]

	@embed("shaders/video.vert")
	internal const glslVideoVertex byte[]

	@embed("shaders/video.frag")
	internal const glslVideoFragment byte[]

	@embed("shaders/paint.vert")
	internal const glslPaintVertex byte[]

	@embed("spirv/sources.sha256")
	internal const spirvSources byte[]

	// A device for the suites on the machine's own Vulkan loader, with no
	// window: any device that runs the GPU canvas (Mesa's llvmpipe does);
	// none when the machine has no Vulkan, which the suites say and skip.
	internal def testDevice() ?Device {
		let loader = vk.loadSystem()
		if loader == 0 {
			println("GPU canvas (Vulkan): no Vulkan loader, skipped")
			return none
		}
		return openDevice(loader, string[], none) onerror (err error) {
			println("GPU canvas (Vulkan): ", err.message, ", skipped")
			return none
		}
	}

	check "Vulkan GPU canvas" {
		// The scene lowered and drawn by the GPU, against the frame drawn on
		// the CPU: no channel more than one level off. The number of channels
		// that differ at all is printed.
		def matches(r FrameRenderer, s scenes.Scene, perThousand int = 0) bool {
			let ctx = new DrawContext(new Size(float(s.w), float(s.h)))
			s.draw(ctx)
			let frame = ctx.lower()
			let want = frame.render().pixels
			r.draw(frame) onerror (err error) {
				println("GPU canvas (Vulkan) ", s.name, ": ", err.message)
				return false
			}
			let got = r.read() onerror (err error) {
				println("GPU canvas (Vulkan) ", s.name, ": ", err.message)
				return false
			}
			if got.len() != want.len() {
				println("GPU canvas (Vulkan) ", s.name, ": ", got.len(), " bytes read, ", want.len(), " wanted")
				return false
			}
			let (off, far) = scenes.compare(got, want, 1)
			println("GPU canvas (Vulkan) ", s.name, ": ", off, " of ", want.len(), " channels differ, ", far, " by more than one")
			scenes.printFar(got, want, s.w, 1, 6) when far > 0
			return far <= want.len() * perThousand / 1000
		}

		@test()
		def drawsWhatTheCanvasDraws() {
			let dev = testDevice()
			return when dev is none
			println("GPU canvas (Vulkan): ", dev.name)
			let r = new FrameRenderer(dev)
			let failed = 0
			for let (_, s) in scenes.parityScenes() {
				failed++ unless matches(r, s)
			}
			r.dispose()
			dev.dispose()
			assert failed == 0
		}

		// The frame drawn at its size through the GPU canvas: its pixels, or
		// none of them when the draw fails.
		def drawVideo(r FrameRenderer, frame video.VideoFrame, w int, h int) byte[] {
			let ctx = new DrawContext(new Size(float(w), float(h)))
			scenes.videoScene(ctx, frame, false)
			r.draw(ctx.lower()) onerror (err error) {
				println("GPU canvas (Vulkan) video: ", err.message)
				return byte[]
			}
			return r.read() onerror recover byte[]
		}

		// The float shaders, which a device without 64-bit shader floats runs
		// (MoltenVK): every scene within a level of the CPU canvas but for a
		// thousandth of the channels, as the GPU canvas on the web.
		@test()
		def drawsInFloatsWithoutDoubles() {
			let loader = vk.loadSystem()
			return when loader == 0
			let dev = openDevice(loader, string[], none, false) onerror (err error) {
				println("GPU canvas (Vulkan, floats): ", err.message, ", skipped")
				return
			}
			assert !dev.float64
			println("GPU canvas (Vulkan, floats): ", dev.name)
			let r = new FrameRenderer(dev)
			let failed = 0
			for let (_, s) in scenes.parityScenes() {
				failed++ unless matches(r, s, 1)
			}
			r.dispose()
			dev.dispose()
			assert failed == 0
		}

		// A picture the GPU decoded (NVDEC), copied into the GPU canvas's
		// images without leaving the GPU, against the same picture drawn through
		// its planes after a download: the same pixels. Skipped where the GPU
		// does not decode H.264 or the Vulkan device cannot share memory with
		// the decoder.
		@test()
		def drawsGpuDecodedPicturesWithoutLeavingTheGpu() {
			let dev = testDevice()
			return when dev is none
			if !dev.exportable || dev.vendor != vendorNvidia {
				println("GPU canvas (Vulkan): ", dev.name, " is not the GPU that decodes, or cannot export memory, skipped")
				dev.dispose()
				return
			}
			let data = encoding.base64decode(h264GpuStream) onerror recover byte[]
			let stream = video.open(data) onerror (err error) {
				println("GPU canvas (Vulkan): the stream does not open: ", err.message)
				assert false
				return
			}
			let pictures = stream.frames(onGpu = true) onerror (err error) {
				println("GPU canvas (Vulkan): the stream does not decode: ", err.message)
				assert false
				return
			}
			let first = pictures.next() onerror (err error) {
				println("GPU canvas (Vulkan): the stream does not decode: ", err.message)
				assert false
				return
			}
			if first is none || !first.onGpu {
				println("GPU canvas (Vulkan): the GPU does not decode the stream, skipped")
				dev.dispose()
				return
			}
			let frame video.VideoFrame = first
			let w = int(frame.width)
			let h = int(frame.height)
			let r = new FrameRenderer(dev)
			let shared = drawVideo(r, frame, w, h)
			let vp = r.videoPlanes
			let wentThrough = vp is none || vp.importFailed || vp.shared[0].image == 0
			println("GPU canvas (Vulkan): ", dev.name, " draws the decoded picture ", wentThrough ?? ("through main memory", "on the GPU"))
			video.download(frame) onerror (err error) {
				println("GPU canvas (Vulkan) video: ", err.message)
				recover none
			}
			assert !frame.onGpu
			let planar = drawVideo(r, frame, w, h)
			r.dispose()
			dev.dispose()
			assert !wentThrough
			assert shared.len() == w * h * 4 && planar.len() == shared.len()
			let (off, far) = scenes.compare(shared, planar, 0)
			println("GPU canvas (Vulkan) video on the GPU: ", off, " of ", shared.len(), " channels differ from the planes' picture")
			scenes.printFar(shared, planar, w, 0, 6) when far > 0
			assert far == 0
		}

		// Frames drawn one over the last (a window's parts, a scrolled view)
		// end as every frame applied to a canvas does.
		@test()
		def drawsPartsOverTheLastFrame() {
			let dev = testDevice()
			return when dev is none
			let r = new FrameRenderer(dev)
			let failed = 0
			for let (_, s) in scenes.paritySequences() {
				let want = scenes.expected(s)
				let ok = true
				for let (i, f) in s.frames {
					r.draw(f.lower(), i > 0) onerror (err error) {
						println("GPU canvas (Vulkan) ", s.name, ": ", err.message)
						ok = false
						recover none
					}
				}
				let got = r.read() onerror (err error) {
					println("GPU canvas (Vulkan) ", s.name, ": ", err.message)
					ok = false
					recover byte[]
				}
				let (_, far) = scenes.compare(got, want.pixels, 1)
				println("GPU canvas (Vulkan) ", s.name, ": ", far, " channels off by more than one")
				scenes.printFar(got, want.pixels, s.w, 1, 8) when far > 0
				failed++ unless ok && got.len() == want.pixels.len() && far == 0
			}
			r.dispose()
			dev.dispose()
			assert failed == 0
		}

		// A live raster changed in parts between frames: only the marked rectangles
		// are uploaded, and every frame still shows what the CPU canvas does.
		@test()
		def drawsLiveRastersByTheirMarks() {
			let dev = testDevice()
			return when dev is none
			let r = new FrameRenderer(dev)
			let failed = scenes.liveRasterRuns("GPU canvas (Vulkan)", (ctx DrawContext) => {
				try r.draw(ctx.lower())
				return try r.read()
			})
			r.dispose()
			dev.dispose()
			assert failed == 0
		}

		// A video frame under a transform: converted and sampled on the GPU,
		// against the frame drawn on the CPU. The two convert Y'CbCr
		// separately (floats in the shader, integers in `video.toImage`), so
		// channels may be a few levels apart; a picture upside down or with
		// its chroma swapped is far off.
		@test()
		def drawsVideoThroughTheCanvas() {
			let dev = testDevice()
			return when dev is none
			let picture = scenes.videoFrame()
			let r = new FrameRenderer(dev)
			let failed = 0
			for let turn = 0; turn < 2; turn++ {
				let ctx = new DrawContext(new Size(64.0, 48.0))
				scenes.videoScene(ctx, picture, turn == 1)
				let frame = ctx.lower()
				let want = frame.render().pixels
				let ok = true
				r.draw(frame) onerror (err error) {
					println("GPU canvas (Vulkan) video: ", err.message)
					ok = false
					recover none
				}
				let got = r.read() onerror (err error) {
					println("GPU canvas (Vulkan) video: ", err.message)
					ok = false
					recover byte[]
				}
				let (_, far) = scenes.compare(got, want, 4)
				println("GPU canvas (Vulkan) video turn ", turn, ": ", far, " channels more than four levels off")
				scenes.printFar(got, want, 64, 4, 6) when far > 0
				failed++ unless ok && got.len() == want.len() && far == 0
			}
			r.dispose()
			dev.dispose()
			assert failed == 0
		}

		// The embedded SPIR-V was compiled from the shader sources as they are:
		// tools/build-spirv.sh records their digests when it builds them.
		@test()
		def shadersAreCurrent() {
			let sources = map<string, byte[]>{
				"std/ui/renderer/opengl/shaders/canvas.vert":  glslCanvasVertex,
				"std/ui/renderer/opengl/shaders/canvas.frag":  glslCanvasFragment,
				"std/ui/renderer/opengl/shaders/effects.frag": glslEffectsFragment,
				"std/ui/renderer/vulkan/shaders/present.frag": glslPresentFragment,
				"std/ui/renderer/vulkan/shaders/video.vert":   glslVideoVertex,
				"std/ui/renderer/vulkan/shaders/video.frag":   glslVideoFragment,
				"std/ui/renderer/vulkan/shaders/paint.vert":   glslPaintVertex,
			}
			let recorded = 0
			for let (_, line) in string(spirvSources).split("\n") {
				let parts = line.trim().split(" ")
				continue when parts.len() != 2
				recorded++
				if !sources.hasKey(parts[1]) {
					println("an unknown shader is recorded: ", parts[1])
					assert false
					continue
				}
				let digest = new SHA256().hash(sources[parts[1]]).hex().lower()
				println(parts[1], " changed since spirv/ was built: run tools/build-spirv.sh") when digest != parts[0]
				assert digest == parts[0]
			}
			println("spirv/sources.sha256 records ", recorded, " shaders, ", sources.len(), " are embedded") when recorded != sources.len()
			assert recorded == sources.len()
			assert canvasVertexSpirv.len() % 4 == 0 && canvasFragmentSpirv.len() > 0 && effectsFragmentSpirv.len() > 0 && paintVertexSpirv.len() > 0
		}
	}
}
