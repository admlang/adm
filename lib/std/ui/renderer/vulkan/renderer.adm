partial module std.ui.renderer.vulkan {
	use std.ui.renderer as r
	use std.ui.renderer.opengl as glr
	use std.formats.image

	// Vulkan renderer scaffolding. Uses the OpenGL backend for now.
	@r.UIRenderer(name = "vulkan")
	type VulkanRenderer {
		internal initMagic uint32
		internal inner ?glr.OpenGLRenderer = none

		def new() {
			initMagic = 0x5A454E31
			inner = new glr.OpenGLRenderer()
		}

		internal def resetInner() glr.OpenGLRenderer {
			inner = new glr.OpenGLRenderer()
			let rend = inner
			return new glr.OpenGLRenderer() when rend is none
			return rend
		}

		internal def ensureInner() glr.OpenGLRenderer {
			if initMagic != 0x5A454E31 {
				initMagic = 0x5A454E31
				return resetInner()
			}
			let rend = inner
			return resetInner() when rend is none
			return rend
		}

		def openWindow(cfg r.WindowConfig) !r.Window {
			let rend = ensureInner()
			return rend.openWindow(cfg)
		}

		def setWindowTitle(win r.Window, title string) !none {
			let rend = ensureInner()
			return rend.setWindowTitle(win, title)
		}

		def setWindowIcon(win r.Window, icon image.Image) !none {
			let rend = ensureInner()
			return rend.setWindowIcon(win, icon)
		}

		def pollEvents(win r.Window) !r.PlatformEvent[] {
			let rend = ensureInner()
			return rend.pollEvents(win)
		}

		def nextFrame(win r.Window) !r.Frame {
			let rend = ensureInner()
			return rend.nextFrame(win)
		}

		def commit(win r.Window, frame r.Frame) !none {
			let rend = ensureInner()
			return rend.commit(win, frame)
		}

		def closeWindow(win r.Window) !none {
			let rend = ensureInner()
			return rend.closeWindow(win)
		}
	}
}
