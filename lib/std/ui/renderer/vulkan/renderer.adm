@os("linux", "darwin", "windows")
partial module std.ui.renderer.vulkan {
	use (
		std.gfx.canvas
		std.math.geom
		std.services.logging::(Logging)
		std.ui.renderer as r
		std.ui.renderer.vulkan.vk
	)

	// The present shader as SPIR-V (tools/build-spirv.sh, shaders/present.frag).
	@embed("spirv/present.frag.spv")
	internal const presentFragmentSpirv byte[]

	// The present shader's uniform block (shaders/present.frag).
	internal const presentBlock = 16

	// A window's swapchain and what presents into it.
	internal type WindowSurface {
		surface        uint
		swapchain      uint   = 0
		images         uint[]
		views          uint[]
		// One semaphore per image: the frame drawn into it, for its present.
		renderDone     uint[]
		// The next image is acquired through it.
		acquire        uint   = 0
		format         uint32 = 0
		colorSpace     uint32 = 0
		presentMode    uint32 = 0
		compositeAlpha uint32 = 0
		w              int    = 0
		h              int    = 0
		// The swapchain no longer fits the window: made again before the next frame.
		stale          bool   = false

		def new(surface uint) {
			self.surface = surface
		}
	}

	// The desktop renderer on Vulkan: draws in the windows of a host that gives
	// Vulkan surfaces (`VulkanSurface`), one device for all of them.
	//
	// Every frame is drawn by the GPU canvas (`FrameRenderer`, the same
	// shaders as the OpenGL renderer's compiled to SPIR-V) into an image of
	// the frame's size, then shown in the window's swapchain image by the
	// present pass, its colour multiplied by its alpha as a desktop that blends
	// windows reads it. A window whose GPU canvas fails is drawn on the CPU
	// canvas and shown the same way.
	@r.UIRenderer(name = "vulkan")
	type VulkanRenderer {
		internal forceCPU        bool
		internal host            ?r.VulkanSurface         = none
		internal dev             ?Device                  = none
		internal windows         map<uint, WindowSurface>
		internal frameRenderers  map<uint, FrameRenderer>
		// The canvas each window's frames are rasterised into when the GPU canvas
		// does not draw them, and the image it is shown through.
		internal canvases        map<uint, canvas.Canvas>
		internal cpuImages       map<uint, Image>
		internal fbSizes         map<uint, geom.Size>
		// The windows where the GPU canvas failed and the CPU canvas draws instead.
		internal gpuCanvasFailed map<uint, bool>
		// The windows whose last committed frame is still held whole: in the GPU
		// canvas's image, or in the canvas the frames are rasterised into.
		internal canvasHeld      map<uint, bool>
		internal cpuHeld         map<uint, bool>

		// `forceCPU`: every frame is rasterised on the CPU canvas.
		def new(forceCPU bool = false) {
			self.forceCPU = forceCPU
			windows = map<uint, WindowSurface>{}
			frameRenderers = map<uint, FrameRenderer>{}
			canvases = map<uint, canvas.Canvas>{}
			cpuImages = map<uint, Image>{}
			fbSizes = map<uint, geom.Size>{}
			gpuCanvasFailed = map<uint, bool>{}
			canvasHeld = map<uint, bool>{}
			cpuHeld = map<uint, bool>{}
		}

		// Takes the host whose windows it draws in: makes it open them for Vulkan,
		// and opens the device.
		//
		// Fails when the host's windows are not Vulkan surfaces, when the machine
		// has no Vulkan loader or no device that runs the GPU canvas (the message
		// names the devices and what each lacks), or when the host has a window
		// open for OpenGL already.
		def attach(host r.Host) !none {
			fail "the Vulkan renderer needs a host whose windows are Vulkan surfaces" unless host is r.VulkanSurface
			let surfaces r.VulkanSurface = host
			let extensions = try surfaces.vulkanInstanceExtensions()
			if dev is none {
				let loader = vk.loadSystem()
				fail "the machine has no Vulkan loader (libvulkan.so.1, vulkan-1.dll or libvulkan.1.dylib)" when loader == 0
				dev = try openDevice(loader, extensions, (instance uint, physical uint, family uint32) => surfaces.vulkanPresents(instance, physical, family))
			}
			self.host = surfaces
			return none
		}

		internal def device() !Device {
			let d = dev
			fail "the Vulkan renderer has no host" when d is none
			return d
		}

		internal def framebufferSize(id uint) (int, int, geom.Size) {
			let h = host
			return (0, 0, new geom.Size(0.0, 0.0)) when h is none
			let size = h.surfaceSize(id)
			return (int(size.width), int(size.height), size)
		}

		// Whether what the window's last committed frame showed is still held at that size.
		internal def holdsFrame(id uint, w int, h int) bool {
			return cpuHeld.hasKey(id) when forceCPU || gpuCanvasFailed.hasKey(id)
			return canvasHeld.hasKey(id) && frameRenderers.hasKey(id) && frameRenderers[id].holds(w, h)
		}

		// Starts a frame: a draw surface the size of the window's framebuffer.
		//
		// Fails when no host is attached.
		def nextFrame(win r.Window) !r.Frame {
			fail "the Vulkan renderer has no host" when host is none || dev is none
			let id = win.id()
			let (fbW, fbH, sz) = framebufferSize(id)
			fbSizes = fbSizes.set(id, sz)
			if !canvases.hasKey(id) || canvases[id].width != fbW || canvases[id].height != fbH {
				canvases = canvases.set(id, new canvas.Canvas(fbW, fbH))
				cpuHeld = cpuHeld.delete(id)
			}
			let ctx = new canvas.DrawContext(new geom.Size(float(fbW), float(fbH)))
			return r.Frame{ctx: ctx, kept: holdsFrame(id, fbW, fbH)}
		}

		// Draws the frame and shows it in the window.
		//
		// Fails when the window has no frame started, when the window's surface or
		// swapchain cannot be made, or when the GPU is lost. A window of no size
		// (minimized) skips the frame.
		def commit(win r.Window, frame r.Frame) !none {
			let id = win.id()
			fail "unknown window" when !canvases.hasKey(id)
			let d = try device()
			let ws = try windowSurface(id)
			try d.open()
			let shown = Image{}
			if forceCPU || gpuCanvasFailed.hasKey(id) {
				shown = try commitCPU(id, frame)
			} else {
				shown = try commitCanvas(id, frame)
			}
			if shown.image == 0 {
				// Nothing to show this frame: what was recorded is run anyway.
				try d.submit(0, 0)
				return none
			}
			return try present(id, win, ws, shown)
		}

		// Draws the frame on the GPU canvas: the image to show, or none when a
		// frame drawing a part had nothing to draw over. A failure moves the
		// window to the CPU canvas for good.
		internal def commitCanvas(id uint, frame r.Frame) !Image {
			let d = try device()
			frameRenderers = frameRenderers.set(id, new FrameRenderer(d)) unless frameRenderers.hasKey(id)
			let fr = frameRenderers[id]
			let lowered = frame.ctx.lower()
			fr.record(lowered, frame.over) onerror (err error) {
				Logging.warning("vulkan: the GPU canvas failed, drawing on the CPU instead", {"window": id, "error": err.message})
				gpuCanvasFailed = gpuCanvasFailed.set(id, true)
				canvasHeld = canvasHeld.delete(id)
				fr.dispose()
				frameRenderers = frameRenderers.delete(id)
				// The command buffer may hold half a frame: it is dropped with what
				// it recorded and opened anew for the CPU canvas's upload.
				try d.submit(0, 0)
				try d.wait()
				try d.open()
				// A frame that drew a part has nothing to draw over on the CPU canvas: the
				// window keeps what it shows until the next frame, which is told so.
				return Image{} when frame.over
				return try commitCPU(id, frame)
			}
			canvasHeld = canvasHeld.set(id, true)
			return fr.target()
		}

		// Rasterises the frame on the CPU canvas and uploads it: the image to show.
		internal def commitCPU(id uint, frame r.Frame) !Image {
			let d = try device()
			let cv = canvases.get(id)
			fail "unknown window" when cv is none
			cv.apply(frame.ctx)
			cpuHeld = cpuHeld.set(id, true) unless frame.over
			let img = Image{}
			img = cpuImages[id] when cpuImages.hasKey(id)
			if img.image == 0 || img.w != cv.width || img.h != cv.height {
				d.retire(img)
				img = try d.createImage(cv.width, cv.height, vk.FORMAT_R8G8B8A8_UNORM, sampledUsage)
				cpuImages = cpuImages.set(id, img)
			}
			d.barrier()
			try d.upload(img, 0, 0, cv.width, cv.height, 4, cv.pixels)
			return img
		}

		// The window's surface, made on its first frame.
		internal def windowSurface(id uint) !WindowSurface {
			return windows[id] when windows.hasKey(id)
			let h = host
			let d = try device()
			fail "the Vulkan renderer has no host" when h is none
			let surface = try h.createVulkanSurface(id, d.instance)
			fail "the device {d.name} cannot present to the window" unless vk.presents(d.physical, d.family, surface)
			let ws = new WindowSurface(surface)
			let out uint[]
			out.len(1)
			let res = vk.createSemaphore(d.device, out)
			fail "a Vulkan semaphore cannot be made: {vk.resultName(res)}" when res != vk.SUCCESS
			ws.acquire = out[0]
			windows = windows.set(id, ws)
			return ws
		}

		// Makes the window's swapchain for its current size, replacing the one
		// it has.
		//
		// Fails when the surface cannot be asked or the swapchain made.
		internal def makeSwapchain(id uint, win r.Window, ws WindowSurface, w int, h int) !none {
			let d = try device()
			let h2 = host
			fail "the Vulkan renderer has no host" when h2 is none
			// Nothing may still draw into the old images.
			try d.wait()
			let info uint32[]
			info.len(8)
			let res = vk.surfaceInfo(d.physical, ws.surface, info)
			fail "the window's surface cannot be asked: {vk.resultName(res)}" when res != vk.SUCCESS
			let minImages = int(info[0]).max(2)
			minImages = minImages.min(int(info[1])) when info[1] != 0
			let alphas = info[4]
			// The present pass writes the colour multiplied by the alpha: a transparent
			// window asks for pre-multiplied composition, else what the window system
			// does with the alpha. A surface that composes opaquely only (NVIDIA's on
			// X11) leaves the alpha to the window system: an X11 compositor reads it
			// from the window's 32-bit visual, which the host gives such a window.
			let alpha = vk.COMPOSITE_OPAQUE
			if win.transparent {
				if (alphas & vk.COMPOSITE_PRE_MULTIPLIED) != 0 {
					alpha = vk.COMPOSITE_PRE_MULTIPLIED
				} else if (alphas & vk.COMPOSITE_INHERIT) != 0 {
					alpha = vk.COMPOSITE_INHERIT
				}
			}
			alpha = (alphas & vk.COMPOSITE_INHERIT) != 0 ?? (vk.COMPOSITE_INHERIT, (alphas & vk.COMPOSITE_PRE_MULTIPLIED) != 0 ?? (vk.COMPOSITE_PRE_MULTIPLIED, vk.COMPOSITE_POST_MULTIPLIED)) when (alphas & alpha) == 0
			let modes = info[5]
			let mode = vk.PRESENT_FIFO
			mode = (modes & (1 << vk.PRESENT_MAILBOX)) != 0 ?? (vk.PRESENT_MAILBOX, (modes & (1 << vk.PRESENT_IMMEDIATE)) != 0 ?? (vk.PRESENT_IMMEDIATE, vk.PRESENT_FIFO)) unless h2.vsync(id)
			// The surface's size when it has one; the window's otherwise.
			let (sw, sh) = (w, h)
			(sw, sh) = (int(info[2]), int(info[3])) when info[2] != 0xFFFFFFFF && info[2] != 0
			let out uint[]
			out.len(1)
			res = vk.createSwapchain(d.device, ws.surface, uint32(sw.max(1)), uint32(sh.max(1)), info[6], info[7], mode, alpha, uint32(minImages), ws.swapchain, out)
			fail "the window's swapchain cannot be made: {vk.resultName(res)}" when res != vk.SUCCESS
			for let (_, v) in ws.views {
				vk.destroyView(d.device, v)
			}
			vk.destroySwapchain(d.device, ws.swapchain) when ws.swapchain != 0
			ws.swapchain = out[0]
			ws.format = info[6]
			ws.colorSpace = info[7]
			ws.presentMode = mode
			ws.compositeAlpha = alpha
			ws.w = sw
			ws.h = sh
			ws.stale = false
			let images uint[]
			images.len(16)
			let n = int(vk.swapchainImages(d.device, ws.swapchain, images, 16)).min(16)
			ws.images = images[0:n].clone()
			ws.views = uint[]
			for let i = 0; i < n; i++ {
				res = vk.createView(d.device, ws.images[i], ws.format, out)
				fail "a swapchain image view cannot be made: {vk.resultName(res)}" when res != vk.SUCCESS
				ws.views.push(out[0])
			}
			for ws.renderDone.len() < n {
				res = vk.createSemaphore(d.device, out)
				fail "a Vulkan semaphore cannot be made: {vk.resultName(res)}" when res != vk.SUCCESS
				ws.renderDone.push(out[0])
			}
			return none
		}

		// Shows the image in the window: the swapchain made to fit, an image of
		// it acquired, the present pass drawn into it, the frame submitted and
		// the image presented.
		internal def present(id uint, win r.Window, ws WindowSurface, shown Image) !none {
			let d = try device()
			let (fbW, fbH, _) = framebufferSize(id)
			if fbW <= 0 || fbH <= 0 {
				// Minimized: nothing can be shown; the frame's drawing is run anyway.
				try d.submit(0, 0)
				return none
			}
			if ws.swapchain == 0 || ws.stale || ws.w != fbW || ws.h != fbH {
				try makeSwapchain(id, win, ws, fbW, fbH)
			}
			let index uint32[]
			index.len(1)
			let res = vk.acquire(d.device, ws.swapchain, ws.acquire, index)
			if res == vk.ERROR_OUT_OF_DATE {
				try makeSwapchain(id, win, ws, fbW, fbH)
				res = vk.acquire(d.device, ws.swapchain, ws.acquire, index)
			}
			if res != vk.SUCCESS && res != vk.SUBOPTIMAL {
				try d.submit(0, 0)
				fail "the window's swapchain image cannot be acquired: {vk.resultName(res)}"
			}
			ws.stale = true when res == vk.SUBOPTIMAL
			let i = int(index[0])
			let (setLayout, pipelineLayout) = try d.layout("present", 1, false, 0, 1)
			let vs = try d.shader("canvas.vert", canvasVertexSpirv)
			let fs = try d.shader("present.frag", presentFragmentSpirv)
			let pipeline = try d.pipeline("present", pipelineLayout, vs, fs, ws.format)
			let block byte[]
			block.len(presentBlock)
			putI32(block, 0, shown.w)
			putI32(block, 4, shown.h)
			let (buffer, at) = try d.stage(block, presentBlock)
			let set = try d.set(setLayout, uint[buffer], uint[at], uint[uint(presentBlock)], uint[shown.view], uint[d.nearest])
			// The frame's image is drawn before the pass samples it.
			d.barrier()
			vk.cmdLayout(d.cmd, ws.images[i], vk.LAYOUT_UNDEFINED, vk.LAYOUT_COLOR_ATTACHMENT)
			vk.cmdBeginRendering(d.cmd, ws.views[i], vk.LAYOUT_COLOR_ATTACHMENT, 0, 0, uint32(ws.w), uint32(ws.h), true, 0.0, 0.0, 0.0, 0.0)
			vk.cmdBind(d.cmd, pipeline, pipelineLayout, set)
			vk.cmdViewportScissor(d.cmd, uint32(ws.w), uint32(ws.h), 0, 0, uint32(ws.w), uint32(ws.h))
			vk.cmdDraw(d.cmd, 3)
			vk.cmdEndRendering(d.cmd)
			vk.cmdLayout(d.cmd, ws.images[i], vk.LAYOUT_COLOR_ATTACHMENT, vk.LAYOUT_PRESENT)
			try d.submit(ws.acquire, ws.renderDone[i])
			res = vk.present(d.queue, ws.swapchain, uint32(i), ws.renderDone[i])
			if res == vk.ERROR_OUT_OF_DATE || res == vk.SUBOPTIMAL {
				ws.stale = true
				return none
			}
			fail "the window's image cannot be presented: {vk.resultName(res)}" when res != vk.SUCCESS
			return none
		}

		// The pixels of the window's last committed frame in a box of it: read back
		// from the GPU canvas's image, or copied from the canvas the frames are
		// rasterised into.
		//
		// Fails when no frame of that size is held for the window (none was committed,
		// or the last one drew a part the window had nothing to draw over), when the
		// box is not inside the frame, or when the GPU does not answer.
		def read(win r.Window, left int, top int, width int, height int) !byte[] {
			let id = win.id()
			fail "no frame is held for the window" unless fbSizes.hasKey(id)
			let size = fbSizes[id]
			let (wide, high) = (int(size.width), int(size.height))
			fail "the box is not inside the frame" when left < 0 || top < 0 || width <= 0 || height <= 0 || left + width > wide || top + height > high
			fail "no frame is held for the window" unless holdsFrame(id, wide, high)
			if forceCPU || gpuCanvasFailed.hasKey(id) {
				let cv = canvases.get(id)
				fail "no frame is held for the window" when cv is none
				let from = cv.pixels
				return from.clone() when width == wide && height == high
				let out byte[]
				for let row = 0; row < height; row++ {
					let start = ((top + row) * wide + left) * 4
					out.push(...from[start:start + width * 4])
				}
				return out
			}
			let fr = frameRenderers.get(id)
			fail "no frame is held for the window" when fr is none
			return try fr.read(left, top, width, height)
		}

		// Waits for the GPU and frees everything: the windows' GPU canvases,
		// swapchains and surfaces, then the device. A renderer the UI service
		// drops after its windows closed.
		def dispose() {
			let d = dev
			return when d is none
			let ids = frameRenderers.keys()
			for let (_, id) in ids {
				release(new r.Window(id)) onerror recover none
			}
			let rest = windows.keys()
			for let (_, id) in rest {
				release(new r.Window(id)) onerror recover none
			}
			d.dispose()
			dev = none
		}

		// Frees what the renderer holds for the window: its GPU canvas, swapchain
		// and surface. The device stays for the other windows.
		//
		// Fails when the GPU does not finish what it was drawing in the window.
		def release(win r.Window) !none {
			let id = win.id()
			let d = dev
			if !(d is none) {
				try d.wait()
			}
			if frameRenderers.hasKey(id) {
				frameRenderers[id].dispose()
				frameRenderers = frameRenderers.delete(id)
			}
			d.retire(cpuImages[id]) when !(d is none) && cpuImages.hasKey(id)
			cpuImages = cpuImages.delete(id) when cpuImages.hasKey(id)
			if !(d is none) && windows.hasKey(id) {
				let ws = windows[id]
				for let (_, v) in ws.views {
					vk.destroyView(d.device, v)
				}
				vk.destroySwapchain(d.device, ws.swapchain) when ws.swapchain != 0
				for let (_, s) in ws.renderDone {
					vk.destroySemaphore(d.device, s)
				}
				vk.destroySemaphore(d.device, ws.acquire) when ws.acquire != 0
				let h = host
				h.destroyVulkanSurface(d.instance, ws.surface) unless h is none
				windows = windows.delete(id)
			}
			gpuCanvasFailed = gpuCanvasFailed.delete(id) when gpuCanvasFailed.hasKey(id)
			canvasHeld = canvasHeld.delete(id)
			cpuHeld = cpuHeld.delete(id)
			canvases = canvases.delete(id) when canvases.hasKey(id)
			fbSizes = fbSizes.delete(id) when fbSizes.hasKey(id)
			return none
		}
	}
}
