@os("linux", "darwin", "windows")
module std.ui.renderer.vulkan.vk {
	// The Vulkan calls the renderer makes, through vk_loader.h: every Vulkan
	// function is fetched at run time from the loader the host (or the machine)
	// gives, so nothing links against libvulkan, and a call that takes
	// structures is a flat function of the header. Handles and pointers are
	// `uint`; a VkResult is an `int32`, 0 for success.

	// VkResult: the call succeeded.
	const SUCCESS int32 = 0
	// VkResult: the swapchain still presents but no longer fits the surface.
	const SUBOPTIMAL int32 = 1000001003
	// VkResult: the swapchain no longer fits the surface and must be made again.
	const ERROR_OUT_OF_DATE int32 = -1000001004
	// VkResult: the descriptor pool is used up.
	const ERROR_OUT_OF_POOL_MEMORY int32 = -1000069000
	// VkResult: the device is lost.
	const ERROR_DEVICE_LOST int32 = -4
	// VkResult: the surface is lost.
	const ERROR_SURFACE_LOST int32 = -1000000000
	// VkResult: a wait ran out of time.
	const TIMEOUT int32 = 2

	// VK_MAKE_API_VERSION(0, 1, 3, 0): what the renderer asks for.
	const API_VERSION_1_3 uint32 = 4206592
	const API_VERSION_1_2 uint32 = 4202496
	// VK_MAKE_API_VERSION(0, 1, 0, 0).
	const API_VERSION_1_0 uint32 = 4194304

	// VkPhysicalDeviceType: a GPU in the processor.
	const DEVICE_INTEGRATED uint32 = 1
	// VkPhysicalDeviceType: a GPU of its own.
	const DEVICE_DISCRETE uint32 = 2
	// VkPhysicalDeviceType: a virtual machine's GPU.
	const DEVICE_VIRTUAL uint32 = 3
	// VkPhysicalDeviceType: the CPU (Mesa's llvmpipe).
	const DEVICE_CPU uint32 = 4

	// VkFormat: one byte a texel (coverage, clips, tables).
	const FORMAT_R8_UNORM uint32 = 9
	// VkFormat: two bytes a texel (interleaved chroma).
	const FORMAT_R8G8_UNORM uint32 = 16
	// VkFormat: straight RGBA8, the canvas's pixels.
	const FORMAT_R8G8B8A8_UNORM uint32 = 37
	// VkFormat: BGRA8, what most swapchains offer.
	const FORMAT_B8G8R8A8_UNORM uint32 = 44
	// VkFormat: 16-bit samples (video planes of more than 8 bits).
	const FORMAT_R16_UNORM uint32 = 70
	// VkFormat: four 16-bit integers (gradient tables).
	const FORMAT_R16G16B16A16_UINT uint32 = 95
	// VkFormat: a 32-bit integer a texel (noise hashes).
	const FORMAT_R32_SINT uint32 = 99
	// VkFormat: a float a texel (effect planes).
	const FORMAT_R32_SFLOAT uint32 = 100
	// VkFormat: four floats a texel (path edges, colour planes).
	const FORMAT_R32G32B32A32_SFLOAT uint32 = 109

	// VkImageUsageFlagBits: copied from.
	const USAGE_TRANSFER_SRC uint32 = 0x1
	// VkImageUsageFlagBits: copied or cleared into.
	const USAGE_TRANSFER_DST uint32 = 0x2
	// VkImageUsageFlagBits: read by a sampler.
	const USAGE_SAMPLED uint32 = 0x4
	// VkImageUsageFlagBits: drawn into.
	const USAGE_COLOR_ATTACHMENT uint32 = 0x10
	// VkImageUsageFlagBits: read back as an input attachment while drawn into.
	const USAGE_INPUT_ATTACHMENT uint32 = 0x80

	// VkBufferUsageFlagBits: copied from.
	const BUFFER_TRANSFER_SRC uint32 = 0x1
	// VkBufferUsageFlagBits: copied into.
	const BUFFER_TRANSFER_DST uint32 = 0x2
	// VkBufferUsageFlagBits: read as a uniform block.
	const BUFFER_UNIFORM uint32 = 0x10

	// VkImageLayout: whatever the image holds is dropped.
	const LAYOUT_UNDEFINED uint32 = 0
	// VkImageLayout: every use, the renderer's own images' layout.
	const LAYOUT_GENERAL uint32 = 1
	// VkImageLayout: drawn into (a swapchain image).
	const LAYOUT_COLOR_ATTACHMENT uint32 = 2
	// VkImageLayout: handed to the presentation engine.
	const LAYOUT_PRESENT uint32 = 1000001002

	// VkDescriptorType: an image read through a sampler.
	const DESCRIPTOR_COMBINED_IMAGE_SAMPLER uint32 = 1
	// VkDescriptorType: a uniform block.
	const DESCRIPTOR_UNIFORM_BUFFER uint32 = 6
	// VkDescriptorType: the colour attachment read back within the render pass.
	const DESCRIPTOR_INPUT_ATTACHMENT uint32 = 10

	// VkShaderStageFlagBits: the vertex stage.
	const STAGE_VERTEX uint32 = 0x1
	// VkShaderStageFlagBits: the fragment stage.
	const STAGE_FRAGMENT uint32 = 0x10

	// VkPresentModeKHR: shown at once, tearing allowed.
	const PRESENT_IMMEDIATE uint32 = 0
	// VkPresentModeKHR: the newest frame at the next blank.
	const PRESENT_MAILBOX uint32 = 1
	// VkPresentModeKHR: every frame in turn at a blank (vsync).
	const PRESENT_FIFO uint32 = 2

	// VkCompositeAlphaFlagBitsKHR: the window's alpha is ignored.
	const COMPOSITE_OPAQUE uint32 = 0x1
	// VkCompositeAlphaFlagBitsKHR: the colour is already multiplied by the alpha.
	const COMPOSITE_PRE_MULTIPLIED uint32 = 0x2
	// VkCompositeAlphaFlagBitsKHR: the desktop multiplies the colour by the alpha.
	const COMPOSITE_POST_MULTIPLIED uint32 = 0x4
	// VkCompositeAlphaFlagBitsKHR: as the window system has it.
	const COMPOSITE_INHERIT uint32 = 0x8

	// Takes vkGetInstanceProcAddr and fetches the entry points that need no
	// instance; false when the pointer is 0.
	@c("vk_loader.h", symbol = "adm_vk_load", ret = "bool", params = ["adm_vk_handle"])
	def load(getInstanceProcAddr uint) bool;

	// The machine's Vulkan loader's vkGetInstanceProcAddr, 0 when it has none.
	@c("vk_loader.h", symbol = "adm_vk_load_system", ret = "adm_vk_handle")
	def loadSystem() uint;

	// The highest instance version the loader supports.
	@c("vk_loader.h", symbol = "adm_vk_instance_version", ret = "uint32_t")
	def instanceVersion() uint32;

	// Whether the loader has the instance layer.
	@c("vk_loader.h", symbol = "adm_vk_has_layer", ret = "bool", params = ["const char*"])
	def hasLayer(name string) bool;

	// Whether the loader has the instance extension.
	@c("vk_loader.h", symbol = "adm_vk_has_instance_extension", ret = "bool", params = ["const char*"])
	def hasInstanceExtension(name string) bool;

	// Creates the instance; out[0]. A VkResult.
	@c("vk_loader.h", symbol = "adm_vk_create_instance", ret = "int32_t", params = ["uint32_t", "const char* const*", "uint32_t", "const char* const*", "uint32_t", "uint32_t", "adm_vk_handle*"])
	def createInstance(apiVersion uint32, extensions string[], extensionCount uint32, layers string[], layerCount uint32, debug bool, out uint[]) int32;

	// Destroys the instance.
	@c("vk_loader.h", symbol = "adm_vk_destroy_instance", ret = "void", params = ["adm_vk_handle"])
	def destroyInstance(instance uint);

	// The physical devices, up to `max` into out; how many there are.
	@c("vk_loader.h", symbol = "adm_vk_physical_devices", ret = "uint32_t", params = ["adm_vk_handle", "adm_vk_handle*", "uint32_t"])
	def physicalDevices(instance uint, out uint[], max uint32) uint32;

	// info: API version, type, 64-bit floats, dynamic rendering,
	// synchronization2, uniform offset alignment, largest image side,
	// swapchain extension, buffer-image granularity; name: 256 bytes,
	// NUL-terminated.
	@c("vk_loader.h", symbol = "adm_vk_physical_device_info", ret = "void", params = ["adm_vk_handle", "uint32_t*", "uint8_t*"])
	def physicalDeviceInfo(physical uint, info uint32[], name byte[]);

	// The first queue family with graphics, presenting to the surface when it
	// is not 0; -1 for none.
	@c("vk_loader.h", symbol = "adm_vk_queue_family", ret = "int32_t", params = ["adm_vk_handle", "adm_vk_handle"])
	def queueFamily(physical uint, surface uint) int32;

	// Whether the queue family of the device can present to the surface.
	@c("vk_loader.h", symbol = "adm_vk_presents", ret = "bool", params = ["adm_vk_handle", "uint32_t", "adm_vk_handle"])
	def presents(physical uint, family uint32, surface uint) bool;

	// Creates the device on the family with the extensions: out[0] the device,
	// out[1] its queue. A VkResult.
	@c("vk_loader.h", symbol = "adm_vk_create_device", ret = "int32_t", params = ["adm_vk_handle", "uint32_t", "const char* const*", "uint32_t", "uint32_t", "uint32_t", "adm_vk_handle*"])
	def createDevice(physical uint, family uint32, extensions string[], extensionCount uint32, localRead bool, float64 bool, out uint[]) int32;

	// Destroys the device.
	@c("vk_loader.h", symbol = "adm_vk_destroy_device", ret = "void", params = ["adm_vk_handle"])
	def destroyDevice(device uint);

	// Waits until the device is idle. A VkResult.
	@c("vk_loader.h", symbol = "adm_vk_device_wait_idle", ret = "int32_t", params = ["adm_vk_handle"])
	def deviceWaitIdle(device uint) int32;

	// Waits until the queue is idle. A VkResult.
	@c("vk_loader.h", symbol = "adm_vk_queue_wait_idle", ret = "int32_t", params = ["adm_vk_handle"])
	def queueWaitIdle(queue uint) int32;

	// Destroys a surface of the instance.
	@c("vk_loader.h", symbol = "adm_vk_destroy_surface", ret = "void", params = ["adm_vk_handle", "adm_vk_handle"])
	def destroySurface(instance uint, surface uint);

	// A buffer with memory bound: out[0] the buffer, out[1] its memory, out[2]
	// where host memory is mapped. A VkResult.
	@c("vk_loader.h", symbol = "adm_vk_create_buffer", ret = "int32_t", params = ["adm_vk_handle", "uint64_t", "uint32_t", "uint32_t", "adm_vk_handle*"])
	def createBuffer(device uint, size uint, usage uint32, host bool, out uint[]) int32;

	// Destroys a buffer and frees its memory.
	@c("vk_loader.h", symbol = "adm_vk_destroy_buffer", ret = "void", params = ["adm_vk_handle", "adm_vk_handle", "adm_vk_handle"])
	def destroyBuffer(device uint, buffer uint, memory uint);

	// Copies n bytes of data into mapped memory at offset.
	@c("vk_loader.h", symbol = "adm_vk_write_mapped", ret = "void", params = ["adm_vk_handle", "uint64_t", "const void*", "uint64_t"])
	def writeMapped(mapped uint, offset uint, data byte[], n uint);

	// Copies n bytes of floats into mapped memory at offset.
	@c("vk_loader.h", symbol = "adm_vk_write_mapped", ret = "void", params = ["adm_vk_handle", "uint64_t", "const void*", "uint64_t"])
	def writeMappedFloats(mapped uint, offset uint, data float32[], n uint);

	// Copies n bytes of doubles into mapped memory at offset.
	@c("vk_loader.h", symbol = "adm_vk_write_mapped", ret = "void", params = ["adm_vk_handle", "uint64_t", "const void*", "uint64_t"])
	def writeMappedDoubles(mapped uint, offset uint, data float64[], n uint);

	// Copies n bytes of 32-bit integers into mapped memory at offset.
	@c("vk_loader.h", symbol = "adm_vk_write_mapped", ret = "void", params = ["adm_vk_handle", "uint64_t", "const void*", "uint64_t"])
	def writeMappedInts(mapped uint, offset uint, data int32[], n uint);

	// Copies n bytes of unsigned 32-bit integers into mapped memory at offset.
	@c("vk_loader.h", symbol = "adm_vk_write_mapped", ret = "void", params = ["adm_vk_handle", "uint64_t", "const void*", "uint64_t"])
	def writeMappedUints(mapped uint, offset uint, data uint32[], n uint);

	// Copies n bytes of 16-bit values into mapped memory at offset.
	@c("vk_loader.h", symbol = "adm_vk_write_mapped", ret = "void", params = ["adm_vk_handle", "uint64_t", "const void*", "uint64_t"])
	def writeMappedShorts(mapped uint, offset uint, data uint16[], n uint);

	// Copies n bytes of mapped memory at offset into out.
	@c("vk_loader.h", symbol = "adm_vk_read_mapped", ret = "void", params = ["adm_vk_handle", "uint64_t", "uint8_t*", "uint64_t"])
	def readMapped(mapped uint, offset uint, out byte[], n uint);

	// A 2D image of w x h in the format for the usage, with no memory yet:
	// out[0] the image, out[1] the bytes it needs, out[2] their alignment,
	// out[3] the memory types that may hold it. A VkResult.
	@c("vk_loader.h", symbol = "adm_vk_create_image", ret = "int32_t", params = ["adm_vk_handle", "uint32_t", "uint32_t", "uint32_t", "uint32_t", "adm_vk_handle*"])
	def createImage(device uint, w uint32, h uint32, format uint32, usage uint32, out uint[]) int32;

	// Binds the image to the memory at the offset and makes its view: out[0]. A VkResult.
	@c("vk_loader.h", symbol = "adm_vk_create_exported_image", ret = "int32_t", params = ["adm_vk_handle", "uint32_t", "uint32_t", "uint32_t", "uint32_t", "adm_vk_handle*"])
	def createExportedImage(device uint, w uint32, h uint32, format uint32, usage uint32, out uint[]) int32;

	@c("vk_loader.h", symbol = "adm_vk_export_memory_fd", ret = "int32_t", params = ["adm_vk_handle", "adm_vk_handle"])
	def exportMemoryFd(device uint, memory uint) int32;

	@c("vk_loader.h", symbol = "adm_vk_bind_image", ret = "int32_t", params = ["adm_vk_handle", "adm_vk_handle", "uint32_t", "adm_vk_handle", "uint64_t", "adm_vk_handle*"])
	def bindImage(device uint, image uint, format uint32, memory uint, offset uint, out uint[]) int32;

	// A memory type among those `mask` allows, a device-local one when asked; -1 for none.
	@c("vk_loader.h", symbol = "adm_vk_choose_memory", ret = "int32_t", params = ["uint32_t", "uint32_t"])
	def chooseMemory(mask uint32, deviceLocal bool) int32;

	// Allocates `size` bytes of the memory type: out[0]. A VkResult.
	@c("vk_loader.h", symbol = "adm_vk_allocate", ret = "int32_t", params = ["adm_vk_handle", "uint64_t", "uint32_t", "adm_vk_handle*"])
	def allocate(device uint, size uint, memoryType uint32, out uint[]) int32;

	// Frees device memory.
	@c("vk_loader.h", symbol = "adm_vk_free", ret = "void", params = ["adm_vk_handle", "adm_vk_handle"])
	def free(device uint, memory uint);

	// Destroys an image and its view; its memory is freed apart.
	@c("vk_loader.h", symbol = "adm_vk_destroy_image", ret = "void", params = ["adm_vk_handle", "adm_vk_handle", "adm_vk_handle"])
	def destroyImage(device uint, image uint, imageView uint);

	@c("vk_loader.h", symbol = "adm_vk_create_view", ret = "int32_t", params = ["adm_vk_handle", "adm_vk_handle", "uint32_t", "adm_vk_handle*"])
	def createView(device uint, image uint, format uint32, out uint[]) int32;

	// Destroys an image view.
	@c("vk_loader.h", symbol = "adm_vk_destroy_view", ret = "void", params = ["adm_vk_handle", "adm_vk_handle"])
	def destroyView(device uint, imageView uint);

	// A sampler, nearest or `linear`, clamped to the edge or `repeat`ing: out[0].
	// A VkResult.
	@c("vk_loader.h", symbol = "adm_vk_create_sampler", ret = "int32_t", params = ["adm_vk_handle", "uint32_t", "uint32_t", "adm_vk_handle*"])
	def createSampler(device uint, linear bool, repeat bool, out uint[]) int32;

	// Destroys a sampler.
	@c("vk_loader.h", symbol = "adm_vk_destroy_sampler", ret = "void", params = ["adm_vk_handle", "adm_vk_handle"])
	def destroySampler(device uint, sampler uint);

	// A set layout of n bindings (types, stages) and a pipeline layout over
	// it: out[0], out[1]. A VkResult.
	@c("vk_loader.h", symbol = "adm_vk_create_layouts", ret = "int32_t", params = ["adm_vk_handle", "const uint32_t*", "const uint32_t*", "uint32_t", "adm_vk_handle*"])
	def createLayouts(device uint, types uint32[], stages uint32[], n uint32, out uint[]) int32;

	// Destroys a set layout and the pipeline layout over it.
	@c("vk_loader.h", symbol = "adm_vk_destroy_layouts", ret = "void", params = ["adm_vk_handle", "adm_vk_handle", "adm_vk_handle"])
	def destroyLayouts(device uint, setLayout uint, pipelineLayout uint);

	// A pool for `sets` sets holding up to `uniforms` uniform buffers and
	// `samplers` combined image samplers: out[0]. A VkResult.
	@c("vk_loader.h", symbol = "adm_vk_create_descriptor_pool", ret = "int32_t", params = ["adm_vk_handle", "uint32_t", "uint32_t", "uint32_t", "adm_vk_handle*"])
	def createDescriptorPool(device uint, sets uint32, uniforms uint32, samplers uint32, out uint[]) int32;

	// Destroys a descriptor pool and the sets it gave.
	@c("vk_loader.h", symbol = "adm_vk_destroy_descriptor_pool", ret = "void", params = ["adm_vk_handle", "adm_vk_handle"])
	def destroyDescriptorPool(device uint, pool uint);

	// Takes back every set the pool gave. A VkResult.
	@c("vk_loader.h", symbol = "adm_vk_reset_descriptor_pool", ret = "int32_t", params = ["adm_vk_handle", "adm_vk_handle"])
	def resetDescriptorPool(device uint, pool uint) int32;

	// A set of the layout from the pool: out[0]. A VkResult
	// (ERROR_OUT_OF_POOL_MEMORY when the pool is used up).
	@c("vk_loader.h", symbol = "adm_vk_allocate_set", ret = "int32_t", params = ["adm_vk_handle", "adm_vk_handle", "adm_vk_handle", "adm_vk_handle*"])
	def allocateSet(device uint, pool uint, layout uint, out uint[]) int32;

	// Writes `uniforms` uniform buffers at bindings 0.., then `images`
	// combined image samplers after them.
	@c("vk_loader.h", symbol = "adm_vk_write_set", ret = "void", params = ["adm_vk_handle", "adm_vk_handle", "const adm_vk_handle*", "const uint64_t*", "const uint64_t*", "uint32_t", "const adm_vk_handle*", "const adm_vk_handle*", "uint32_t", "uint32_t"])
	def writeSet(device uint, set uint, buffers uint[], offsets uint[], ranges uint[], uniforms uint32, views uint[], samplers uint[], images uint32, inputs uint32);

	// A shader module from `size` bytes of SPIR-V: out[0]. A VkResult.
	@c("vk_loader.h", symbol = "adm_vk_create_shader", ret = "int32_t", params = ["adm_vk_handle", "const void*", "uint64_t", "adm_vk_handle*"])
	def createShader(device uint, code byte[], size uint, out uint[]) int32;

	// Destroys a shader module.
	@c("vk_loader.h", symbol = "adm_vk_destroy_shader", ret = "void", params = ["adm_vk_handle", "adm_vk_handle"])
	def destroyShader(device uint, shader uint);

	// A pipeline of the two modules into one attachment of the format. A VkResult.
	@c("vk_loader.h", symbol = "adm_vk_create_pipeline", ret = "int32_t", params = ["adm_vk_handle", "adm_vk_handle", "adm_vk_handle", "adm_vk_handle", "uint32_t", "uint32_t", "adm_vk_handle*"])
	def createPipeline(device uint, layout uint, vertex uint, fragment uint, format uint32, localRead bool, out uint[]) int32;

	// Destroys a pipeline.
	@c("vk_loader.h", symbol = "adm_vk_destroy_pipeline", ret = "void", params = ["adm_vk_handle", "adm_vk_handle"])
	def destroyPipeline(device uint, pipeline uint);

	// A command pool, its buffer and a fence: out[0..2]. A VkResult.
	@c("vk_loader.h", symbol = "adm_vk_create_commands", ret = "int32_t", params = ["adm_vk_handle", "uint32_t", "adm_vk_handle*"])
	def createCommands(device uint, family uint32, out uint[]) int32;

	// Destroys a command pool (its buffer with it) and a fence.
	@c("vk_loader.h", symbol = "adm_vk_destroy_commands", ret = "void", params = ["adm_vk_handle", "adm_vk_handle", "adm_vk_handle"])
	def destroyCommands(device uint, pool uint, fence uint);

	// Resets the pool and begins its buffer for one submission. A VkResult.
	@c("vk_loader.h", symbol = "adm_vk_begin_commands", ret = "int32_t", params = ["adm_vk_handle", "adm_vk_handle", "adm_vk_handle"])
	def beginCommands(device uint, pool uint, cmd uint) int32;

	// Ends the command buffer. A VkResult.
	@c("vk_loader.h", symbol = "adm_vk_end_commands", ret = "int32_t", params = ["adm_vk_handle"])
	def endCommands(cmd uint) int32;

	// Submits the buffer after `wait` (a semaphore or 0), signalling `signal` (or
	// 0) and `fence` (or 0) when done. A VkResult.
	@c("vk_loader.h", symbol = "adm_vk_submit", ret = "int32_t", params = ["adm_vk_handle", "adm_vk_handle", "adm_vk_handle", "adm_vk_handle", "adm_vk_handle"])
	def submit(queue uint, cmd uint, wait uint, signal uint, fence uint) int32;

	// Waits for the fence at most `timeout` nanoseconds and resets it. A VkResult.
	@c("vk_loader.h", symbol = "adm_vk_wait_fence", ret = "int32_t", params = ["adm_vk_handle", "adm_vk_handle", "uint64_t"])
	def waitFence(device uint, fence uint, timeout uint) int32;

	// A semaphore: out[0]. A VkResult.
	@c("vk_loader.h", symbol = "adm_vk_create_semaphore", ret = "int32_t", params = ["adm_vk_handle", "adm_vk_handle*"])
	def createSemaphore(device uint, out uint[]) int32;

	// Destroys a semaphore.
	@c("vk_loader.h", symbol = "adm_vk_destroy_semaphore", ret = "void", params = ["adm_vk_handle", "adm_vk_handle"])
	def destroySemaphore(device uint, semaphore uint);

	// A barrier: every write so far done and visible before anything after. Not
	// inside rendering.
	@c("vk_loader.h", symbol = "adm_vk_cmd_barrier", ret = "void", params = ["adm_vk_handle"])
	def cmdBarrier(cmd uint);

	// Inside rendering that reads its attachment back: what the draws so far
	// wrote to a pixel is seen by the draws after, pixel by pixel.
	@c("vk_loader.h", symbol = "adm_vk_cmd_local_barrier", ret = "void", params = ["adm_vk_handle"])
	def cmdLocalBarrier(cmd uint);

	// Moves the image from one layout to another, after everything before and
	// before everything after.
	@c("vk_loader.h", symbol = "adm_vk_cmd_layout", ret = "void", params = ["adm_vk_handle", "adm_vk_handle", "uint32_t", "uint32_t"])
	def cmdLayout(cmd uint, image uint, oldLayout uint32, newLayout uint32);

	// Copies w x h texels from the buffer at `offset` (rows `rowLength` texels
	// apart, 0 for packed) into the image (general layout) at (x, y).
	@c("vk_loader.h", symbol = "adm_vk_cmd_copy_to_image", ret = "void", params = ["adm_vk_handle", "adm_vk_handle", "uint64_t", "uint32_t", "adm_vk_handle", "int32_t", "int32_t", "uint32_t", "uint32_t"])
	def cmdCopyToImage(cmd uint, buffer uint, offset uint, rowLength uint32, image uint, x int32, y int32, w uint32, h uint32);

	// Copies the w x h box of the image (general layout) at (x, y) into the buffer
	// at `offset`, rows packed.
	@c("vk_loader.h", symbol = "adm_vk_cmd_copy_to_buffer", ret = "void", params = ["adm_vk_handle", "adm_vk_handle", "int32_t", "int32_t", "uint32_t", "uint32_t", "adm_vk_handle", "uint64_t"])
	def cmdCopyToBuffer(cmd uint, image uint, x int32, y int32, w uint32, h uint32, buffer uint, offset uint);

	// Copies the w x h box at (sx, sy) of `src` to (dx, dy) of `dst`, both in the
	// general layout.
	@c("vk_loader.h", symbol = "adm_vk_cmd_copy_image", ret = "void", params = ["adm_vk_handle", "adm_vk_handle", "int32_t", "int32_t", "adm_vk_handle", "int32_t", "int32_t", "uint32_t", "uint32_t"])
	def cmdCopyImage(cmd uint, src uint, sx int32, sy int32, dst uint, dx int32, dy int32, w uint32, h uint32);

	// Fills the whole image (general layout) with the colour.
	@c("vk_loader.h", symbol = "adm_vk_cmd_clear", ret = "void", params = ["adm_vk_handle", "adm_vk_handle", "float", "float", "float", "float"])
	def cmdClear(cmd uint, image uint, r float32, g float32, b float32, a float32);

	// Begins rendering into the view (an image in `layout`) over the w x h area at
	// (x, y), kept or `clear`ed to the colour.
	@c("vk_loader.h", symbol = "adm_vk_cmd_begin_rendering", ret = "void", params = ["adm_vk_handle", "adm_vk_handle", "uint32_t", "int32_t", "int32_t", "uint32_t", "uint32_t", "uint32_t", "float", "float", "float", "float"])
	def cmdBeginRendering(cmd uint, imageView uint, layout uint32, x int32, y int32, w uint32, h uint32, clear bool, r float32, g float32, b float32, a float32);

	// Ends rendering.
	@c("vk_loader.h", symbol = "adm_vk_cmd_end_rendering", ret = "void", params = ["adm_vk_handle"])
	def cmdEndRendering(cmd uint);

	// Binds the pipeline and its one descriptor set.
	@c("vk_loader.h", symbol = "adm_vk_cmd_bind", ret = "void", params = ["adm_vk_handle", "adm_vk_handle", "adm_vk_handle", "adm_vk_handle"])
	def cmdBind(cmd uint, pipeline uint, layout uint, set uint);

	// Sets the viewport (vw x vh from the origin, y down) and the scissor box.
	@c("vk_loader.h", symbol = "adm_vk_cmd_viewport_scissor", ret = "void", params = ["adm_vk_handle", "uint32_t", "uint32_t", "int32_t", "int32_t", "uint32_t", "uint32_t"])
	def cmdViewportScissor(cmd uint, vw uint32, vh uint32, sx int32, sy int32, sw uint32, sh uint32);

	// Draws `vertices` vertices once.
	@c("vk_loader.h", symbol = "adm_vk_cmd_draw", ret = "void", params = ["adm_vk_handle", "uint32_t"])
	def cmdDraw(cmd uint, vertices uint32);

	// out: least and most images, current width and height, composite alpha
	// modes, present modes as bits, the format picked and its colour space.
	@c("vk_loader.h", symbol = "adm_vk_surface_info", ret = "int32_t", params = ["adm_vk_handle", "adm_vk_handle", "uint32_t*"])
	def surfaceInfo(physical uint, surface uint, out uint32[]) int32;

	// A swapchain of at least `minImages` w x h images in the format and colour
	// space, presented in the mode with the composite alpha, replacing `old` (or
	// 0): out[0]. A VkResult.
	@c("vk_loader.h", symbol = "adm_vk_create_swapchain", ret = "int32_t", params = ["adm_vk_handle", "adm_vk_handle", "uint32_t", "uint32_t", "uint32_t", "uint32_t", "uint32_t", "uint32_t", "uint32_t", "adm_vk_handle", "adm_vk_handle*"])
	def createSwapchain(device uint, surface uint, w uint32, h uint32, format uint32, colorSpace uint32, presentMode uint32, compositeAlpha uint32, minImages uint32, old uint, out uint[]) int32;

	// Destroys a swapchain and its images.
	@c("vk_loader.h", symbol = "adm_vk_destroy_swapchain", ret = "void", params = ["adm_vk_handle", "adm_vk_handle"])
	def destroySwapchain(device uint, swapchain uint);

	// The swapchain's images, up to `max` into out; how many there are.
	@c("vk_loader.h", symbol = "adm_vk_swapchain_images", ret = "uint32_t", params = ["adm_vk_handle", "adm_vk_handle", "adm_vk_handle*", "uint32_t"])
	def swapchainImages(device uint, swapchain uint, out uint[], max uint32) uint32;

	// Takes the next image of the swapchain, signalling the semaphore when it may
	// be drawn into: its index into out[0]. A VkResult (SUBOPTIMAL and
	// ERROR_OUT_OF_DATE say the swapchain no longer fits the window).
	@c("vk_loader.h", symbol = "adm_vk_acquire", ret = "int32_t", params = ["adm_vk_handle", "adm_vk_handle", "adm_vk_handle", "uint32_t*"])
	def acquire(device uint, swapchain uint, semaphore uint, out uint32[]) int32;

	// Presents the swapchain's image once the semaphore is signalled. A VkResult.
	@c("vk_loader.h", symbol = "adm_vk_present", ret = "int32_t", params = ["adm_vk_handle", "adm_vk_handle", "uint32_t", "adm_vk_handle"])
	def present(queue uint, swapchain uint, index uint32, semaphore uint) int32;

	// The name of a VkResult the renderer may meet, for its messages.
	def resultName(result int32) string {
		let code = int(result)
		match code {
			case 0:
				return "VK_SUCCESS"
			case - 1:
				return "VK_ERROR_OUT_OF_HOST_MEMORY"
			case - 2:
				return "VK_ERROR_OUT_OF_DEVICE_MEMORY"
			case - 3:
				return "VK_ERROR_INITIALIZATION_FAILED"
			case - 4:
				return "VK_ERROR_DEVICE_LOST"
			case - 6:
				return "VK_ERROR_LAYER_NOT_PRESENT"
			case - 7:
				return "VK_ERROR_EXTENSION_NOT_PRESENT"
			case - 8:
				return "VK_ERROR_FEATURE_NOT_PRESENT"
			case - 9:
				return "VK_ERROR_INCOMPATIBLE_DRIVER"
			case - 10:
				return "VK_ERROR_TOO_MANY_OBJECTS"
			case - 11:
				return "VK_ERROR_FORMAT_NOT_SUPPORTED"
			case - 1000000000:
				return "VK_ERROR_SURFACE_LOST_KHR"
			case - 1000000001:
				return "VK_ERROR_NATIVE_WINDOW_IN_USE_KHR"
			case - 1000001004:
				return "VK_ERROR_OUT_OF_DATE_KHR"
			case - 1000069000:
				return "VK_ERROR_OUT_OF_POOL_MEMORY"
			case 1000001003:
				return "VK_SUBOPTIMAL_KHR"
			default:
				return "VkResult {code}"
		}
	}
}
