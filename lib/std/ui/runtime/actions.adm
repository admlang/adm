internal partial module std.ui.runtime {
	use (
		std.ui::(KeyEvent, Modifiers, actionsOf)
		std.ui.layout::Node
	)

	// The keys of each action, read once per shortcut text: one chord, or several
	// pressed one after another; none when a chord names no key.
	type ActionTable {
		keys  map<string, ?Hotkey[]>
		// The chords of a shortcut typed so far, while they begin one.
		typed Hotkey[]
	}

	let actionTable = new ActionTable()

	def chordsOf(shortcut string) ?Hotkey[] {
		if actionTable.keys.hasKey(shortcut) {
			return actionTable.keys[shortcut]
		}
		let chords Hotkey[]
		let read ?Hotkey[] = chords
		for let part in shortcut.split(" ") {
			continue when part.trim() == ""
			let chord = parseHotkey(part)
			if chord is none {
				read = none
				break
			}
			chords.push(chord)
		}
		read = none when chords.len() == 0
		actionTable.keys[shortcut] = read
		return read
	}

	// Runs the action whose shortcut `event` ends, from the focused component up to the
	// window's root, the innermost first: an action is the keys' while its component holds
	// the focus (`actionsOf`). A chord that begins a longer shortcut is kept until the next
	// key, which either goes on with it or starts again. True when an action ran, or the
	// key went on with a shortcut.
	def runActionKey(chain Node[], event KeyEvent) bool {
		let typed = actionTable.typed.clone()
		typed.push(Hotkey{key: event.key, shift: event.modifiers.shift, alt: event.modifiers.alt, mod: event.modifiers.mod, command: event.modifiers.command})
		let begins = false
		for let step in chain {
			let owner = step.owner
			continue when owner is none
			for let act in actionsOf(owner) {
				let chords = chordsOf(act.shortcut)
				continue when chords is none || chords.len() < typed.len()
				let matches = true
				for let (k, chord) in typed {
					let pressed = KeyEvent{target: owner, key: chord.key, modifiers: Modifiers{shift: chord.shift, alt: chord.alt, mod: chord.mod, command: chord.command}}
					matches = hotkeyMatches(chords[k], pressed)
					break unless matches
				}
				continue unless matches
				if chords.len() > typed.len() {
					begins = true
					continue
				}
				continue unless act.enabled
				actionTable.typed = Hotkey[]
				let _ = act.run()
				return true
			}
		}
		actionTable.typed = begins ?? (typed, Hotkey[])
		return begins
	}
}
