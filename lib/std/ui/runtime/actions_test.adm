internal partial module std.ui.runtime {
	use (
		std.math.geom::Size
		std.testing
		std.ui.components::Button
		std.ui::(Key, KeyEvent, Modifiers, UI, action, actionsOf)
		std.ui.styles::*
		std.units::Pixels
	)

	let actionLog = string[]

	// A component whose controller declares actions: one with an `enabled` method, one
	// whose shortcut is two chords, one with no shortcut.
	component Drafts {
		style {
			Box
		}

		type {
			dirty bool = true

			@action("Save", shortcut = "Ctrl+S", icon = "save", enabled = canSave)
			def save() {
				actionLog.push("save")
				dirty = false
			}

			def canSave() bool {
				return dirty
			}

			@action("Comment", shortcut = "Ctrl+K Ctrl+C")
			def comment() {
				actionLog.push("comment")
			}

			@action("Share")
			def share() {
				actionLog.push("share")
			}
		}

		view {}
	}

	// A button that shows an action.
	component Saver {
		style {
			Box
		}

		type {
			dirty bool = true

			@action("Save", enabled = canSave)
			def save() {
				actionLog.push("saved")
				dirty = false
			}

			def canSave() bool {
				return dirty
			}
		}

		view {
			Button(action = save)
		}
	}

	check "Actions" {
		// A button given an action takes its label, runs it when pressed and is enabled
		// while the action is.
		@test()
		def TestButtonsShowActions() {
			actionLog = string[]
			let saver = Saver()
			let scene = new Scene(saver)
			let size = new Size<Pixels>(200(px), 100(px))
			scene.arrange(size)
			let button = saver.children[0]
			assert button is Button
			if button is Button {
				assert button.shownLabel() == "Save" && button.enabled
				button.click()
				scene.arrange(size)
				assert actionLog.join(",") == "saved" && !button.enabled
			}
		}

		// The actions a controller declares, bound to its component: listed with what
		// the annotation says, run on that component, enabled as its method says.
		@test()
		def TestActionsOfAComponent() {
			actionLog = string[]
			let drafts = Drafts()
			let all = actionsOf(drafts)
			assert all.len() == 3
			let save = all[0]
			assert save.id.endsWith("Drafts.save") && save.label == "Save" && save.shortcut == "Ctrl+S" && save.icon == "save"
			assert save.enabled && save.run() && actionLog.join(",") == "save"
			assert !save.enabled && !save.run() && actionLog.join(",") == "save"
			assert all[2].enabled && all[2].shortcut == ""
			// Every declared action, for a keymap editor.
			let ids = string[]
			for let info in UI.actions() {
				ids.push(info.id) when info.id.contains("Drafts.")
			}
			assert ids.len() == 3
		}

		// A key no component took runs the action whose shortcut it is, while it is
		// enabled; a chord that begins a longer shortcut waits for the next.
		@test()
		def TestShortcutsRunActions() {
			actionLog = string[]
			let drafts = Drafts()
			let scene = new Scene(drafts)
			scene.arrange(new Size<Pixels>(200(px), 100(px)))
			let press = def (key Key, ctrl bool) {
				let _ = scene.key(KeyEvent{target: drafts, key: key, modifiers: Modifiers{control: ctrl, mod: ctrl}})
				let _ = scene.keyUp(key)
			}
			let ctrlDown = def () {
				let _ = scene.key(KeyEvent{target: drafts, key: Key.LeftControl})
			}
			ctrlDown()
			press(Key.S, true)
			assert actionLog.join(",") == "save"
			// Saved: not enabled until there is something to save.
			press(Key.S, true)
			assert actionLog.join(",") == "save"
			press(Key.K, true)
			assert actionLog.join(",") == "save"
			press(Key.C, true)
			assert actionLog.join(",") == "save,comment"
			// A chord that starts no shortcut leaves nothing pending.
			press(Key.K, true)
			press(Key.X, true)
			press(Key.C, true)
			assert actionLog.join(",") == "save,comment"
		}
	}
}
