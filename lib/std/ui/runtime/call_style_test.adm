internal partial module std.ui.runtime {
	use (
		std.math.geom::Size
		std.testing
		std.ui.components
		std.ui.styles::*
		std.units::*
	)

	enum SiteMode {
		Plain,
		Loud,
	}

	component SiteLeaf {
		type {
			@state
			chosen bool = false

			@state
			mode SiteMode = SiteMode.Plain

			def seen() float {
				return style.opacity
			}

			def bold() bool {
				let font = style.font
				return !(font is none) && font.weight == FontWeight.Bold
			}

			def family() string {
				let font = style.font
				return "" when font is none
				return font.family
			}
		}

		style {
			Box
			Compositing
			Typography
			opacity = 0.5
			on      = {
				hover:  {opacity: 0.75},
				chosen: {font: {weight: FontWeight.Bold}},
			}
		}

		view {}
	}

	component SitePage {
		type {
			dim float = 0.25
		}

		view {
			SiteLeaf(ref = plain)
			SiteLeaf(ref = set, style = {opacity: dim, width: 40(px)})
			SiteLeaf(ref = states, style = {on: {hover: {opacity: 0.1, on: {pressed: {opacity: 0.2}}}, [chosen, Loud]: {opacity: 0.9}}})
			components.Button("Save", ref = save, style = {width: 77(px)})
		}

		style {
			Box
			Typography
			font = Font{family: "serif", size: 20(px)}
		}
	}

	check "Call style" {
		// What a call sets on the style of the component it makes stays under the
		// component's own states, and follows the values it was written with.
		@test()
		def TestACallSetsPropertiesOfTheStyle() {
			let page = SitePage()
			let scene = new Scene(page)
			let size = new Size<Pixels>(200(px), 200(px))
			scene.arrange(size)
			let (plain, set, save) = (page.plain, page.set, page.save)
			assert !(plain is none) && !(set is none) && !(save is none)
			return when plain is none || set is none || save is none
			assert plain.seen() == 0.5 && set.seen() == 0.25
			assert float(set.style.geom.frame.width) == 40.0 && float(save.style.geom.frame.width) == 77.0
			plain.isHover = true
			set.isHover = true
			scene.arrange(size)
			// The component's hover look, but not over what the call set.
			assert plain.seen() == 0.75 && set.seen() == 0.25
			page.dim = 0.3
			scene.arrange(size)
			assert set.seen() == 0.3
			set.isHover = false
			scene.arrange(size)
			assert set.seen() == 0.3 && float(set.style.geom.frame.width) == 40.0
		}

		// A call's `on` gives states looks of its own, over the component's: built-in
		// states, the component's `@state` fields, nested and listed together.
		@test()
		def TestACallGivesStatesLooks() {
			let page = SitePage()
			let scene = new Scene(page)
			let size = new Size<Pixels>(200(px), 200(px))
			scene.arrange(size)
			let states = page.states
			assert !(states is none)
			return when states is none
			assert states.seen() == 0.5
			states.isHover = true
			scene.arrange(size)
			assert states.seen() == 0.1
			states.isPressed = true
			scene.arrange(size)
			assert states.seen() == 0.2
			states.isHover = false
			states.isPressed = false
			states.chosen = true
			scene.arrange(size)
			assert states.seen() == 0.5
			states.mode = SiteMode.Loud
			scene.arrange(size)
			assert states.seen() == 0.9
		}

		// A state that names a field of an inherited font shows it over the font above.
		@test()
		def TestAStateNamesFieldsOfAnInheritedFont() {
			let page = SitePage()
			let scene = new Scene(page)
			let size = new Size<Pixels>(200(px), 200(px))
			scene.arrange(size)
			let plain = page.plain
			assert !(plain is none)
			return when plain is none
			assert plain.family() == "serif" && !plain.bold()
			plain.chosen = true
			scene.arrange(size)
			assert plain.family() == "serif" && plain.bold()
			plain.chosen = false
			scene.arrange(size)
			assert plain.family() == "serif" && !plain.bold()
		}
	}
}
