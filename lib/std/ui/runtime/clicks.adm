internal partial module std.ui.runtime {
	use (
		std.math.geom::Point
		std.time
		std.ui::(Key, KeyEvent, MouseButton, PointerEvent, PointerPhase)
		std.units::Pixels
	)

	// How long a press is held before it is a long press, and how far the pointer may
	// move meanwhile.
	const longPressDelay = 500ms
	const longPressSlop = 8.0

	// The press the scene follows for a component that takes clicks (`takesClicks`):
	// one at a time, as there is one pointer.
	type ClickPress {
		// The component the primary button went down on; none: no press is followed.
		taker     ?component    = none
		// When the press that may become a long press went down, and where in the
		// taker's coordinates; none: it cannot become one (any more).
		downAt    ?time.Time    = none
		downPos   Point<Pixels> = new Point<Pixels>(0(px), 0(px))
		// A long press ran: its release clicks nothing.
		longFired bool          = false
	}

	// Takes a pointer event that `owner`, a component that takes clicks, left to the
	// scene: a press of the primary button captures the pointer, and its release over the
	// component clicks it, or double clicks it on the second click of a double click when
	// it takes those. True when the event was its. A disabled component takes none.
	def clickPointer(scene Scene, owner component, e PointerEvent) bool {
		return false when owner.disabled
		let press = scene.click
		let held = press.taker
		let mine = !(held is none) && held == owner
		match e.phase {
			case PointerPhase.Down:
				return false when e.button != MouseButton.Left
				e.capture()
				press.taker = owner
				press.longFired = false
				press.downAt = none
				owner.isPressed = true
				if takesLongPress(owner) {
					let now = time.now()
					press.downAt = now
					press.downPos = e.position
					wakeBy(now + longPressDelay)
				}
				return true
			case PointerPhase.Move:
				if mine {
					let dx = float(e.position.x) - float(press.downPos.x)
					let dy = float(e.position.y) - float(press.downPos.y)
					press.downAt = none when dx * dx + dy * dy > longPressSlop * longPressSlop
				}
				return false
			case PointerPhase.Cancel:
				endClick(press) when mine
				return false
			case PointerPhase.Up:
				return false when e.button != MouseButton.Left || !mine
				let long = press.longFired
				endClick(press)
				return true when long
				let (x, y) = (float(e.position.x), float(e.position.y))
				let frame = owner.style.geom.frame
				return true unless x >= 0.0 && y >= 0.0 && x < float(frame.width) && y < float(frame.height)
				if e.clicks == 2 && takesDoubleClick(owner) {
					doubleClick(owner)
				} else {
					owner.click()
				}
				return true
			default:
				return false
		}
	}

	// Takes a key for the focused component when it takes clicks: Space, Enter and the
	// keypad's Enter going down click it. True when the key did.
	def clickKey(owner component, e KeyEvent) bool {
		return false when !e.down || owner.disabled || !owner.takesClicks
		return false unless e.key := Key.Space || Key.Enter || Key.KeypadEnter
		owner.click()
		return true
	}

	// Runs the long press the scene follows once it was held long enough; asked on each
	// frame, which the press asked for.
	def heldLong(scene Scene) {
		let press = scene.click
		let since = press.downAt
		return when since is none
		let now = time.now()
		if now < since + longPressDelay {
			wakeBy(since + longPressDelay)
			return
		}
		press.downAt = none
		let owner = press.taker
		return when owner is none || owner.disabled
		press.longFired = true
		owner.longPressed()
		let run = owner.onLongPress
		run() unless run is none
	}

	// The press ended: none is followed.
	def endClick(press ClickPress) {
		let owner = press.taker
		owner.isPressed = false unless owner is none
		press.taker = none
		press.downAt = none
	}

	// `owner` takes long presses: it has `onLongPress` or declares `longPressed`.
	def takesLongPress(owner component) bool {
		return !(owner.onLongPress is none) || (owner.__clicks() & 4) != 0
	}

	// `owner` takes double clicks: it has `onDoubleClick` or declares `doubleClicked`.
	def takesDoubleClick(owner component) bool {
		return !(owner.onDoubleClick is none) || (owner.__clicks() & 2) != 0
	}

	// Double clicks `owner`: its own `doubleClicked`, then the caller's `onDoubleClick`.
	def doubleClick(owner component) {
		owner.doubleClicked()
		let run = owner.onDoubleClick
		run() unless run is none
	}
}
