internal partial module std.ui.runtime {
	use (
		std.math.geom::(Point, Size)
		std.testing
		std.time
		std.ui::(Key, KeyEvent, MouseButton, PointerPhase)
		std.ui.styles::*
		std.units::Pixels
	)

	internal let clickLog = string[]

	internal def padClicked() {
		clickLog.push("click")
	}

	internal def padDoubled() {
		clickLog.push("double")
	}

	internal def padHeld() {
		clickLog.push("long")
	}

	// A square that declares nothing about clicks: what its caller gives it decides.
	component ClickSquare {
		style {
			Box
			width  = 100(px)
			height = 100(px)
		}

		type {}

		view {
			children()
		}
	}

	// A square whose controller says what a click on it does, and nothing else.
	component Clicker {
		style {
			Box
			width  = 40(px)
			height = 40(px)
		}

		type {
			def clicked() {
				clickLog.push("own")
			}
		}

		view {}
	}

	// A square that takes clicks, holding a `Clicker`.
	component ClickHolder {
		style {
			Box
			width  = 100(px)
			height = 100(px)
		}

		type {}

		view {
			ClickSquare(onClick = padClicked) {
				Clicker()
			}
		}
	}

	internal def clickScene(root component) Scene {
		let scene = new Scene(root)
		scene.arrange(new Size<Pixels>(200(px), 200(px)))
		return scene
	}

	internal def tap(scene Scene, at Point<Pixels>, clicks int = 1) {
		let _ = scene.pointer(PointerPhase.Down, at, clicks = clicks)
		let _ = scene.pointer(PointerPhase.Up, at, clicks = clicks)
	}

	check "Clicks" {
		// A component given `onClick` takes clicks with nothing else written, and the
		// second press of a double click runs `onDoubleClick` in its place.
		@test()
		def TestClickInputs() {
			clickLog = string[]
			let scene = clickScene(ClickSquare(onClick = padClicked, onDoubleClick = padDoubled))
			let at = new Point<Pixels>(20(px), 20(px))
			tap(scene, at)
			tap(scene, at, clicks = 2)
			assert clickLog.join(",") == "click,double"
		}

		// Without `onDoubleClick` the second press is one more click.
		@test()
		def TestSecondClickWithoutDouble() {
			clickLog = string[]
			let scene = clickScene(ClickSquare(onClick = padClicked))
			let at = new Point<Pixels>(20(px), 20(px))
			tap(scene, at)
			tap(scene, at, clicks = 2)
			assert clickLog.join(",") == "click,click"
		}

		// A release away from where the press began, or of the secondary button,
		// clicks nothing; a disabled component takes no click.
		@test()
		def TestNoClick() {
			clickLog = string[]
			let pad = ClickSquare(onClick = padClicked)
			let scene = clickScene(pad)
			let _ = scene.pointer(PointerPhase.Down, new Point<Pixels>(20(px), 20(px)))
			let _ = scene.pointer(PointerPhase.Up, new Point<Pixels>(150(px), 150(px)))
			let at = new Point<Pixels>(20(px), 20(px))
			let _ = scene.pointer(PointerPhase.Down, at, MouseButton.Right)
			let _ = scene.pointer(PointerPhase.Up, at, MouseButton.Right)
			pad.enabled = false
			scene.arrange(new Size<Pixels>(200(px), 200(px)))
			tap(scene, at)
			assert clickLog.len() == 0
		}

		// A press held half a second runs `onLongPress` and its release clicks nothing;
		// one that moves away first is an ordinary click.
		@test()
		def TestLongPress() {
			clickLog = string[]
			let window = new Size<Pixels>(200(px), 200(px))
			let scene = clickScene(ClickSquare(onClick = padClicked, onLongPress = padHeld))
			let at = new Point<Pixels>(20(px), 20(px))
			let _ = scene.pointer(PointerPhase.Down, at)
			scene.arrange(window)
			assert clickLog.len() == 0
			time.sleep(550ms)
			scene.arrange(window)
			assert clickLog.join(",") == "long"
			let _ = scene.pointer(PointerPhase.Up, at)
			assert clickLog.join(",") == "long"
			let _ = scene.pointer(PointerPhase.Down, at)
			let _ = scene.pointer(PointerPhase.Move, new Point<Pixels>(40(px), 20(px)))
			time.sleep(550ms)
			scene.arrange(window)
			let _ = scene.pointer(PointerPhase.Up, new Point<Pixels>(40(px), 20(px)))
			assert clickLog.join(",") == "long,click"
		}

		// Declaring `clicked` is enough: the component takes the click, before its
		// caller's `onClick`, takes the focus, and Space and Enter click it then. The
		// one under the pointer that takes clicks has it; the one around it does not.
		@test()
		def TestClickedHook() {
			clickLog = string[]
			let holder = ClickHolder()
			let scene = clickScene(holder)
			let square = holder.children[0]
			let inner = square.children[0]
			assert inner.takesClicks && inner.takesFocus && inner.takesTab
			assert !holder.takesClicks && !holder.takesFocus
			tap(scene, new Point<Pixels>(10(px), 10(px)))
			assert clickLog.join(",") == "own" && scene.focused() == inner
			let _ = scene.key(KeyEvent{target: inner, key: Key.Space})
			let _ = scene.key(KeyEvent{target: inner, key: Key.Enter})
			let _ = scene.key(KeyEvent{target: inner, key: Key.A})
			assert clickLog.join(",") == "own,own,own"
			tap(scene, new Point<Pixels>(80(px), 80(px)))
			assert clickLog.join(",") == "own,own,own,click" && scene.focused() == square
		}

		// `focusable = false` keeps a component that takes clicks out of the focus and
		// of Tab; `click()` clicks it as a press does.
		@test()
		def TestFocusOptOut() {
			clickLog = string[]
			let pad = ClickSquare(onClick = padClicked, focusable = false)
			let scene = clickScene(pad)
			assert pad.takesClicks && !pad.takesFocus && !pad.takesTab
			tap(scene, new Point<Pixels>(20(px), 20(px)))
			assert clickLog.join(",") == "click" && !pad.focused
			pad.click()
			assert clickLog.join(",") == "click,click"
		}
	}
}
