internal partial module std.ui.runtime {
	use (
		std.math.geom::(Point, Size)
		std.testing
		std.ui::PointerPhase
		std.ui.styles::*
		std.units::Pixels
	)

	component ShapeShifting {
		view {}

		style {
			Box
			Control
			width  = 50(px)
			height = 50(px)
			cursor = Cursor.Pointer
		}

		type {
			def busy() {
				style.cursor = Cursor.Wait
			}
		}
	}

	check "Pointer shape" {
		// A component whose shape changes under a pointer that does not move shows the new
		// one with the next layout.
		@test()
		def TestTheShapeFollowsAStyleThatChangesUnderARestingPointer() {
			let shown = ShapeShifting()
			let scene = new Scene(shown)
			let size = new Size<Pixels>(100(px), 100(px))
			scene.arrange(size)
			let _ = scene.pointer(PointerPhase.Move, new Point<Pixels>(10(px), 10(px)))
			assert scene.cursor == Cursor.Pointer
			shown.busy()
			scene.arrange(size)
			assert scene.cursor == Cursor.Wait
		}
	}
}
