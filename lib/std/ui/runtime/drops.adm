internal partial module std.ui.runtime {
	use (
		std.math.geom::Point
		std.time
		std.ui::(DragData, DropEffect, MouseButton, PointerPhase)
		std.ui.layout::Node
		std.ui.styles::Cursor
		std.units::Pixels
	)

	// A component things are dropped on: `DropTarget`.
	interface DropZone {
		// Whether it takes what is dragged.
		def takes(data DragData) bool
		// What a drop of `data` at `at`, a point of the window in logical pixels, would
		// do; None: it is not taken there.
		def dropEffect(data DragData, at Point<Pixels>) DropEffect
		// It was dropped at `at`, a point of the window in logical pixels.
		def dropOn(data DragData, at Point<Pixels>)
	}

	// The nearest `DropZone` that is enabled, at `from` or above it.
	def zoneFrom(from ?component) ?component {
		let under = from
		for {
			return none when under is none
			return under when under is DropZone && !under.disabled
			under = under.parent()
		}
	}

	// The component things dragged over `node` would be offered to first.
	def zoneAt(node ?Node) ?component {
		return none when node is none
		return zoneFrom(node.owner)
	}

	// Sets or clears `dropTarget` on `zone` and on what it holds directly: a zone
	// without a box of its own shows through its child.
	def markDrop(zone component, on bool) {
		zone.isDropTarget = on
		for let child in zone.childNodes {
			child.isDropTarget = on
		}
	}

	// How far the pointer moves with the button down, in logical pixels, before what it
	// pressed is dragged.
	const dragSlack = 4.0

	// A component that is dragged with what it holds: `Draggable`.
	interface DragSource {
		// Whether a move away from the press that is on it now drags it.
		def drags() bool
		// What it carries.
		def dragData() DragData
		// It is dragged and the pointer is at `at`, a point of the window in logical
		// pixels.
		def dragMoved(at Point<Pixels>)
		// Its drag began.
		def dragBegan()
		// Its drag is over: `dropped` when a zone took what it carries.
		def dragEnded(dropped bool)
	}

	// How near an edge of something that scrolls the pointer brings a drag before the
	// content scrolls under it, how far it scrolls each time, and how often, in logical
	// pixels.
	const scrollEdge = 24.0
	const scrollStep = 12.0
	const scrollEvery = 16ms

	// The nearest `DragSource` that is enabled, at or above `from`.
	def sourceFrom(from ?component) ?component {
		let under = from
		for {
			return none when under is none
			return under when under is DragSource && !under.disabled
			under = under.parent()
		}
	}

	// Whether `owner` is `inside` or held by it, however deep.
	def heldIn(owner ?component, inside component) bool {
		let at = owner
		for {
			return false when at is none
			return true when at == inside
			at = at.parent()
		}
	}

	// Sets or clears `dragging` on `source` and on what it holds directly, as `markDrop`
	// does for a zone.
	def markDrag(source component, on bool) {
		source.isDragging = on
		for let child in source.childNodes {
			child.isDragging = on
		}
	}

	// The scale the scene was drawn at last, for finding what is under a point.
	def dropScale(scene Scene) float {
		return scene.kept.scale > 0.0 ?? (scene.kept.scale, 1.0)
	}

	// Gives `dropTarget` to `now` and takes it from the zone that had it. True when that
	// changed.
	def markOver(scene Scene, now ?component) bool {
		let was = scene.dropOver
		return false when was is none && now is none
		if !(was is none) && !(now is none) {
			return false when was == now
		}
		markDrop(was, false) unless was is none
		markDrop(now, true) unless now is none
		scene.dropOver = now
		return true
	}

	// The zone a drop of `data` at `at` would go to: the nearest one at or above the
	// component there that takes it and whose effect there is not None. One that refuses
	// leaves it to a zone further out. `scene.dropEffect` is what that zone would do.
	def takerAt(scene Scene, at Point<Pixels>, data DragData) ?component {
		scene.dropEffect = DropEffect.None
		let zone = zoneAt(nodeAt(scene, at, dropScale(scene)))
		for {
			return none when zone is none
			if zone is DropZone {
				if zone.takes(data) {
					let effect = zone.dropEffect(data, at)
					if effect != DropEffect.None {
						scene.dropEffect = effect
						return zone
					}
				}
			}
			zone = zoneFrom(zone.parent())
		}
	}

	// Something from another application is dragged over the point `at` of the window
	// (logical pixels): the zone there gets `dropTarget`, the one that had it loses it.
	// True when that changed. What is dragged is not known until it is dropped, so the
	// zone is not asked whether it takes it.
	def runtimeDragOver(scene Scene, at Point<Pixels>) bool {
		return markOver(scene, zoneAt(nodeAt(scene, at, dropScale(scene))))
	}

	// What was dragged over the window left it or was let go of nowhere.
	def dragLeft(scene Scene) bool {
		return markOver(scene, none)
	}

	// `data` was dropped at `at`: the zone `takerAt` finds is given it. True when one
	// took it.
	def dropAt(scene Scene, at Point<Pixels>, data DragData) bool {
		let _ = dragLeft(scene)
		let zone = takerAt(scene, at, data)
		return false when zone is none
		if zone is DropZone {
			zone.dropOn(data, at)
		}
		return true
	}

	// The pointer's shape while something is dragged, for what a drop would do.
	def dragCursor(effect DropEffect) Cursor {
		match effect {
			case DropEffect.Copy:
				return Cursor.Copy
			case DropEffect.Move:
				return Cursor.Move
			case DropEffect.Link:
				return Cursor.Link
			default:
				return Cursor.NotAllowed
		}
	}

	// Starts dragging `source`, the pointer at `at`: the press it began with is called
	// off (nothing is pressed or hovered, no component holds the pointer), the source
	// shows `dragging`, and the zone under the pointer that takes its data shows
	// `dropTarget`. False when `source` is not a `DragSource`.
	def beginDrag(scene Scene, source component, at Point<Pixels>, scale float) bool {
		if source is DragSource {
			return false when !source.drags()
			let data = source.dragData()
			let _ = routePointer(scene, PointerPhase.Cancel, at, MouseButton.Left, new Point<Pixels>(0(px), 0(px)), scale)
			scene.dragged = source
			scene.dragData = data
			markDrag(source, true)
			source.dragBegan()
			dragTo(scene, source, data, at)
			return true
		}
		return false
	}

	// The pointer moved to `at` with `source` dragged.
	def dragTo(scene Scene, source component, data DragData, at Point<Pixels>) {
		if source is DragSource {
			source.dragMoved(at)
		}
		scene.dragAt = at
		let _ = markOver(scene, takerAt(scene, at, data))
		scene.cursor = dragCursor(scene.dropEffect)
		wakeBy(time.now() + scrollEvery) when nearEdge(scene, at, false)
	}

	// Whether the pointer at `at` is near an edge of something that scrolls and can
	// scroll further that way: the innermost such thing under the pointer. With
	// `scroll`, it is scrolled a step that way.
	def nearEdge(scene Scene, at Point<Pixels>, scroll bool) bool {
		let under = nodeAt(scene, at, dropScale(scene))
		return false when under is none
		let (x, y) = (float(at.x), float(at.y))
		for let above in chainOf(under) {
			let owner = above.owner
			continue when owner is none || above.scroll is none
			if owner is Scroller {
				let (left, top, right, bottom) = viewOf(above)
				let axes = owner.scrollAxes()
				let (dx, dy) = (0.0, 0.0)
				if axes.vertical {
					dy = -scrollStep when y < top + scrollEdge
					dy = scrollStep when y > bottom - scrollEdge
				}
				if axes.horizontal {
					dx = -scrollStep when x < left + scrollEdge
					dx = scrollStep when x > right - scrollEdge
				}
				continue when dx == 0.0 && dy == 0.0
				// The offset counts from the start corner: the right one under RightToLeft.
				let by = new Point<Pixels>((above.rtl ?? (-dx, dx)) * 1(px), dy * 1(px))
				return true when !scroll
				return true when owner.scrollBy(by)
			}
		}
		return false
	}

	// Once a frame while something is dragged: content the pointer rests near an edge
	// of scrolls a step, and the zone under the pointer is found again.
	def dragTick(scene Scene) {
		let source = scene.dragged
		let data = scene.dragData
		return when source is none || data is none
		return when !nearEdge(scene, scene.dragAt, true)
		let _ = markOver(scene, takerAt(scene, scene.dragAt, data))
		scene.cursor = dragCursor(scene.dropEffect)
		wakeBy(time.now() + scrollEvery)
	}

	// Ends the drag under way: without a drop, unless `told` is false, and then the
	// caller tells the source. False when nothing is dragged.
	def endDrag(scene Scene, told bool = true) bool {
		let source = scene.dragged
		return false when source is none
		markDrag(source, false)
		if told && source is DragSource {
			source.dragEnded(false)
		}
		let _ = dragLeft(scene)
		scene.dragged = none
		scene.dragData = none
		scene.dropEffect = DropEffect.None
		scene.cursor = Cursor.Default
		scene.touched = true
		return true
	}

	// Takes what the pointer did while something is dragged: a move shows where a drop
	// would go, the release of the primary button drops, and the drag is called off when
	// the gesture is taken away or the source left the window. Nothing is hovered or
	// pressed meanwhile and no component is offered the event. Returns the component
	// under the pointer.
	def dragPointer(scene Scene, source component, data DragData, phase PointerPhase, at Point<Pixels>, button MouseButton, scale float) component {
		scene.touched = true
		if phase == PointerPhase.Cancel || !heldIn(source, scene.root) {
			let _ = endDrag(scene)
			return scene.hit(at, scale)
		}
		match phase {
			case PointerPhase.Move:
				dragTo(scene, source, data, at)
			case PointerPhase.Leave:
				let _ = dragLeft(scene)
				scene.cursor = Cursor.NotAllowed
			case PointerPhase.Up:
				return scene.hit(at, scale) when button != MouseButton.Left
				// The drag is over before the zone hears of the drop: its handler may
				// start anything.
				let _ = endDrag(scene, false)
				let dropped = dropAt(scene, at, data)
				if source is DragSource {
					source.dragEnded(dropped)
				}
				// What is under the pointer is hovered again.
				return routePointer(scene, PointerPhase.Move, at, button, new Point<Pixels>(0(px), 0(px)), scale)
			default:
		}
		return scene.hit(at, scale)
	}
}
