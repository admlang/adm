internal partial module std.ui.runtime {
	use (
		std.math.geom::(Point, Size)
		std.ui.layout::Node
		std.ui.styles::Layer
		std.units::Pixels
	)

	// A component that places itself in the window each frame and is no business of the
	// pointer's or of Escape: a notice in a corner. The runtime calls `place` before its
	// style is read, as it does for a floating component.
	interface Placing {
		// Called each frame with the window's size: where it sets its visibility and its
		// anchors.
		def place(window Size<Pixels>)
	}

	// A component that floats over the page: a popover, a menu, a tooltip, a dialog.
	// The runtime lets it place itself before its style is read each frame, and tells it
	// when the user turned away from it. It is not seen on the first frame it is shown:
	// that frame only measures it, so that `place` knows its size on the next.
	//
	// One whose style puts it in `Layer.Modal` is modal while it is shown: the page
	// behind it is dimmed and takes no pointer, Tab stays inside it, the focus moves into
	// it and returns to where it was when it goes.
	interface Floating {
		Placing
		// Whether it is shown now.
		def floating() bool
		// The component it hangs beside; none: nothing in particular.
		def floatTarget() ?component
		// The user pressed outside it and its target, or pressed Escape with nothing
		// else taking the key.
		def dismiss()
	}

	// A component the user moves the window by: a press on it, or on what it holds that
	// takes no focus, is the desktop's, which drags the window. `WindowDrag` is one.
	interface WindowGrip {
		// Whether it drags now.
		def gripsWindow() bool
	}

	// A component that opens where the secondary button was released on its parent: a
	// context menu.
	interface Contextual {
		// The secondary button came up at `at`, a point of the window, on the component
		// it is a child of or on something under that one.
		def context(at Point<Pixels>)
	}

	// Tells the context menu nearest a release of the secondary button on `under`: the
	// one that is a child of `under` or of the nearest ancestor that has one. A release
	// inside a context menu opens none.
	def openContext(under Node, at Point<Pixels>) bool {
		for let step in chainOf(under) {
			let held = step.owner
			if !(held is none) {
				return false when held is Contextual
			}
			for let child in step.children {
				let owner = child.owner
				continue when owner is none
				if owner is Contextual {
					owner.context(at)
					return true
				}
			}
		}
		return false
	}

	// Lets a floating component place itself and notes the shown ones, the latest last;
	// a component that only places itself does that.
	def refloat(scene Scene, node Node, owner component) {
		// One test for the many components that do neither.
		if owner is Placing {
			owner.place(scene.window)
			if owner is Floating {
				scene.floats.push(node) when owner.floating()
			}
		}
	}

	// What components asked to have run once the frame's tree is in step and laid out.
	type Afterwards {
		runs (def())[]
	}

	let afterwards = new Afterwards()

	// Runs `run` at the end of the `arrange` under way (of the next one, outside of one).
	// For what a component finds out while the tree is brought in step (`place`) and
	// that calls the application: the application may then change anything.
	def afterArrange(run def()) {
		afterwards.runs.push(run)
	}

	// Runs what `afterArrange` was given, each once.
	def runAfterwards() {
		return when afterwards.runs.len() == 0
		let due = afterwards.runs
		afterwards.runs = []
		for let run in due {
			run()
		}
	}

	// Whether `node` is `inside` or under it.
	def within(node Node, inside Node) bool {
		return holds(chainOf(node), inside)
	}

	// A press landed on `under`: every shown floating component it is neither inside nor
	// on the target of is dismissed.
	def dismissOutside(scene Scene, under Node) {
		let chain = chainOf(under)
		for let float in scene.floats {
			continue when holds(chain, float) || !inTree(scene, float)
			let owner = float.owner
			continue when owner is none
			if owner is Floating {
				let target = owner.floatTarget()
				let onTarget = false
				if !(target is none) {
					for let step in chain {
						let held = step.owner
						continue when held is none
						onTarget = true when held == target || scopedBy(held, target)
					}
				}
				owner.dismiss() unless onTarget
			}
		}
	}

	// Dismisses the floating component shown last. False when none is shown.
	def dismissLast(scene Scene) bool {
		for let i = scene.floats.len() - 1; i >= 0; i-- {
			let float = scene.floats[i]
			continue when !inTree(scene, float)
			let owner = float.owner
			continue when owner is none
			if owner is Floating {
				continue when !owner.floating()
				owner.dismiss()
				return true
			}
		}
		return false
	}

	// The modal floating component shown on top: the last one in the Modal layer.
	def modalOf(scene Scene) ?Node {
		for let i = scene.floats.len() - 1; i >= 0; i-- {
			let float = scene.floats[i]
			return float when float.box.layer == Layer.Modal && inTree(scene, float)
		}
		return none
	}

	// Whether a press or a move on `under` is the page's, behind `modal`: it is neither
	// in the modal nor in something floating that was shown after it (a menu it opened).
	def behind(scene Scene, modal Node, under Node) bool {
		let past = false
		for let float in scene.floats {
			if float == modal {
				past = true
				return false when within(under, float)
				continue
			}
			return false when past && within(under, float)
		}
		return true
	}

	// Hides a floating component on the first frame it is shown, when its size is not
	// known yet: called once its style was read.
	def hideFresh(scene Scene, node Node, owner component) {
		if owner is Floating {
			return when !owner.floating() || holds(scene.floated, node)
			let decoration = node.decoration
			decoration.opacity = 0.0 unless decoration is none
		}
	}

	// Follows the modal on top from one frame to the next: when one appears the focus
	// moves to its first Tab stop and the old focus is kept; when it goes, the focus
	// returns there.
	def followModal(scene Scene) {
		let now = modalOf(scene)
		let was = scene.modal
		let same = (now is none) == (was is none)
		same = now == was when same && !(now is none) && !(was is none)
		return when same
		if now is none {
			let back = scene.focusBefore
			scene.focusBefore = none
			scene.modal = none
			return when back is none || !inTree(scene, back)
			setFocus(scene, back)
			return
		}
		scene.focusBefore = scene.focus when was is none
		scene.modal = now
		let stops Node[]
		tabStops(now, stops)
		if stops.len() > 0 {
			setFocus(scene, stops[0])
		} else {
			setFocus(scene, none)
		}
	}
}
