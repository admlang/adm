internal partial module std.ui.runtime {
	use (
		std.math.geom::Size
		std.testing
		std.ui.components::Text
		std.ui.styles::*
		std.units::Pixels
	)

	// Counts what it is told, and shows it.
	component GivenCounter {
		type {
			@state
			n int = 0
		}

		view {
			Text("n={n}")
		}

		style {
			Box
		}
	}

	// Holds what `setChildren` gives it.
	component GivenHost {
		type {}

		view {
			children()
		}

		style {
			Box
		}
	}

	check "Given content" {
		// A component `setChildren` gave runs its view again on each frame its host
		// places it: what it shows follows its state.
		@test()
		def TestGivenReruns() {
			let host = GivenHost()
			let scene = new Scene(host)
			let size = new Size<Pixels>(200(px), 100(px))
			let counter = GivenCounter()
			host.setChildren([counter])
			scene.arrange(size)
			counter.n = 5
			scene.arrange(size)
			scene.arrange(size)
			let text = counter.children[0]
			assert text is Text
			if text is Text {
				assert text.text == "n=5"
			}
			scene.close()
		}
	}
}
