internal partial module std.ui.runtime {
	use (
		std.math.geom::Size
		std.testing
		std.ui.styles::*
		std.units::Pixels
	)

	// A line of a list of things to choose: `run` when it is chosen.
	struct TapAction {
		label string
		run   ?(def()) = none
	}

	// A thing to choose, made with `new`.
	type TapChoice {
		label string
		run   def()

		def new(label string, run def()) {
			self.label = label
			self.run = run
		}
	}

	// Holds the actions it is given.
	component ActionHolder {
		style {
			Box
		}

		type {
			@input
			actions TapAction[] = []
		}

		view {}
	}

	// Holds the choice it is given.
	component ChoiceHolder {
		style {
			Box
		}

		type {
			@input
			choice ?TapChoice = none
		}

		view {}
	}

	// Holds a label and what choosing it runs.
	component PairHolder {
		style {
			Box
		}

		type {
			@input
			pair (string, ?(def())) = ("", none)
		}

		view {}
	}

	// Holds a function taking any number of counts.
	component ManyHolder {
		style {
			Box
		}

		type {
			@input
			onMany ?(def(...int) int) = none
		}

		view {}
	}

	internal def countMany(counts ...int) int {
		for let (_, count) in counts {
			taps += count
		}
		return counts.len()
	}

	// A holder given actions written as a literal, and the count its view reads.
	component ActionsPage {
		style {
			Box
		}

		type {}

		view {
			ActionHolder(actions = [TapAction{label: "plain"}, TapAction{label: "count", run: countTap}])
			TapCount(count = tapsRead())
		}
	}

	// A holder given a choice made in place, and the count.
	component ChoicePage {
		style {
			Box
		}

		type {}

		view {
			ChoiceHolder(choice = new TapChoice("count", countTap))
			TapCount(count = tapsRead())
		}
	}

	// A holder given a tuple with a function in it, and the count.
	component PairPage {
		style {
			Box
		}

		type {}

		view {
			PairHolder(pair = ("count", countTap))
			TapCount(count = tapsRead())
		}
	}

	// A holder given a function taking any number of arguments, and the count.
	component ManyPage {
		style {
			Box
		}

		type {}

		view {
			ManyHolder(onMany = countMany)
			TapCount(count = tapsRead())
		}
	}

	internal let valuesWindow = new Size<Pixels>(200(px), 200(px))

	check "Handlers in values" {
		// A function a view writes into a literal it gives marks the view's component
		// when it is called, as one given as an argument does.
		@test()
		def TestAFunctionInALiteralMarks() {
			taps = 0
			let page = ActionsPage()
			let scene = clickScene(page)
			let holder = page.find<ActionHolder>()
			assert !(holder is none)
			return when holder is none
			assert holder.actions.len() == 2
			assert holder.actions[0].run is none
			let run = holder.actions[1].run
			assert !(run is none)
			return when run is none
			let runs = pageRuns
			run()
			assert taps == 1
			assert page.needsBuild
			let _ = scene.arrange(valuesWindow)
			assert pageRuns == runs + 1
		}

		// So does one given to a `new`.
		@test()
		def TestAFunctionGivenToNewMarks() {
			taps = 0
			let page = ChoicePage()
			let scene = clickScene(page)
			let holder = page.find<ChoiceHolder>()
			assert !(holder is none)
			return when holder is none
			let choice = holder.choice
			assert !(choice is none)
			return when choice is none
			let runs = pageRuns
			choice.run()
			assert taps == 1
			assert page.needsBuild
			let _ = scene.arrange(valuesWindow)
			assert pageRuns == runs + 1
		}

		// A function in a tuple keeps its wrapper while it stays the same function: a
		// run of the view gives the child nothing new.
		@test()
		def TestAFunctionInATupleKeepsItsWrapper() {
			taps = 0
			let page = PairPage()
			let scene = clickScene(page)
			let holder = page.find<PairHolder>()
			assert !(holder is none)
			return when holder is none
			let run = holder.pair.1
			assert !(run is none)
			return when run is none
			let runs = pageRuns
			run()
			assert taps == 1
			let _ = scene.arrange(valuesWindow)
			assert pageRuns == runs + 1
			assert !holder.needsBuild
			let again = holder.pair.1
			return when again is none
			assert again == run
		}

		// A function taking any number of arguments is wrapped as any other, and the
		// wrapper passes them on.
		@test()
		def TestAVariadicFunctionMarks() {
			taps = 0
			let page = ManyPage()
			let scene = clickScene(page)
			let holder = page.find<ManyHolder>()
			assert !(holder is none)
			return when holder is none
			let many = holder.onMany
			assert !(many is none)
			return when many is none
			let runs = pageRuns
			assert many(1, 2, 3) == 3
			assert taps == 6
			assert many() == 0
			assert page.needsBuild
			let _ = scene.arrange(valuesWindow)
			assert pageRuns == runs + 1
		}
	}
}
