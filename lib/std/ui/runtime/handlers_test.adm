internal partial module std.ui.runtime {
	use (
		std.math.geom::(Point, Size)
		std.testing
		std.ui::(Key, KeyEvent, PointerPhase)
		std.ui.styles::*
		std.units::Pixels
	)

	// How many times the views of the pages below ran: each reads `taps` through it.
	internal let pageRuns = 0

	internal def tapsRead() int {
		pageRuns++
		return taps
	}

	internal def tapsNow() int {
		return taps
	}

	// Gives the square it places the handler it was given.
	component TapRelay {
		style {
			Box
		}

		type {
			@input
			onTap ?(def()) = none
		}

		view {
			ClickSquare(onClick = onTap)
		}
	}

	// A relay given `countTap`, and the count its view reads.
	component RelayPage {
		style {
			Box
		}

		type {}

		view {
			TapRelay(onTap = countTap)
			TapCount(count = tapsRead())
		}
	}

	// Shows the number the function it was given returns: its view calls it.
	component Asker {
		style {
			Box
		}

		type {
			@input
			ask ?(def() int) = none

			def asked() int {
				let from = ask
				return 0 when from is none
				return from()
			}
		}

		view {
			TapCount(count = asked())
		}
	}

	// An asker given `tapsNow`, and the count its view reads.
	component AskPage {
		style {
			Box
		}

		type {}

		view {
			Asker(ask = tapsNow)
			TapCount(count = tapsRead())
		}
	}

	// As many squares as `rows`, all given `countTap`, and the count.
	component RowsPage {
		style {
			Box
		}

		type {
			rows int = 3
		}

		view {
			for let i in 0..rows {
				ClickSquare(onClick = countTap)
			}
			TapCount(count = tapsRead())
		}
	}

	// A square given a function written in place, and the count.
	component LiteralPage {
		style {
			Box
		}

		type {}

		view {
			ClickSquare(onClick = () => {
				taps += 2
			})
			TapCount(count = tapsRead())
		}
	}

	// A square given no handler, and the count.
	component PlainTapPage {
		style {
			Box
		}

		type {}

		view {
			ClickSquare()
			TapCount(count = tapsRead())
		}
	}

	// The window `clickScene` lays out, and a point of the square a page places first.
	internal let tapWindow = new Size<Pixels>(200(px), 200(px))
	internal let tapPoint = new Point<Pixels>(20(px), 20(px))

	@bindable
	struct TapName {
		name string
	}

	// Writes the text it is bound to.
	component NameEditor {
		style {
			Box
		}

		type {
			@input(value = true, bind = true)
			value string = ""

			def write(text string) {
				value = text
			}
		}

		view {}
	}

	// An editor bound to a member of an object the page holds, and the count.
	component NamePage {
		style {
			Box
		}

		type {
			named TapName = TapName{name: "a"}
		}

		view {
			NameEditor(named.name)
			TapCount(count = tapsRead())
		}
	}

	check "Handlers" {
		// A handler the page's view gave changes a module's value: the page's view runs
		// again in the next frame, whoever held the handler meanwhile.
		@test()
		def TestAHandlerPassedOnRunsItsGiversView() {
			taps = 0
			let page = RelayPage()
			let scene = clickScene(page)
			let shown = page.find<TapCount>()
			assert !(shown is none)
			return when shown is none
			let runs = pageRuns
			tap(scene, tapPoint)
			let _ = scene.arrange(tapWindow)
			assert taps == 1
			assert shown.count == 1
			assert pageRuns == runs + 1
			let _ = scene.arrange(tapWindow)
			assert pageRuns == runs + 1
		}

		// Keys and text where no view gave a handler run no view. (A press sets the
		// states of what is under the pointer, which are marks of their own.)
		@test()
		def TestNoHandlerNoRun() {
			taps = 0
			let page = PlainTapPage()
			let scene = clickScene(page)
			let runs = pageRuns
			let _ = scene.key(KeyEvent{target: page, key: Key.A})
			let _ = scene.text("a")
			let _ = scene.arrange(tapWindow)
			assert pageRuns == runs
		}

		// The call marks the giver wherever it is made: here outside any event.
		@test()
		def TestACallFromAnywhereMarks() {
			taps = 0
			let page = TapPage()
			let scene = clickScene(page)
			let shown = page.find<TapCount>()
			assert !(shown is none)
			return when shown is none
			let run = page.children[0].onClick
			assert !(run is none)
			return when run is none
			run()
			assert taps == 1
			assert page.needsBuild
			let _ = scene.arrange(tapWindow)
			assert shown.count == 1
		}

		// A function a view of the frame calls says what that view shows: the giver is
		// not marked, or every frame would ask for the next.
		@test()
		def TestACallFromAViewMarksNothing() {
			taps = 4
			let page = AskPage()
			let scene = clickScene(page)
			let asker = page.children[0]
			let shown = asker.find<TapCount>()
			assert !(shown is none)
			return when shown is none
			assert shown.count == 4
			let runs = pageRuns
			taps = 6
			asker.redraw()
			let _ = scene.arrange(tapWindow)
			assert shown.count == 6
			assert pageRuns == runs
			assert !page.needsBuild
		}

		// The children of a loop given one function hold one wrapper, and a run of the
		// view that finds the same function gives them nothing new.
		@test()
		def TestRowsGivenOneFunctionShareItsWrapper() {
			taps = 0
			let page = RowsPage()
			let scene = clickScene(page)
			let (first, second) = (page.children[0].onClick, page.children[1].onClick)
			assert !(first is none)
			assert !(second is none)
			return when first is none
			return when second is none
			assert first == second
			page.rows = 2
			let _ = scene.arrange(tapWindow)
			assert page.children.len() == 3
			let again = page.children[0].onClick
			return when again is none
			assert again == first
			assert !page.children[0].needsBuild
			let runs = pageRuns
			tap(scene, tapPoint)
			let _ = scene.arrange(tapWindow)
			assert taps == 1
			assert pageRuns == runs + 1
		}

		// A function written in place marks as one named does.
		@test()
		def TestAFunctionWrittenInPlaceMarks() {
			taps = 0
			let page = LiteralPage()
			let scene = clickScene(page)
			let shown = page.find<TapCount>()
			assert !(shown is none)
			return when shown is none
			tap(scene, tapPoint)
			let _ = scene.arrange(tapWindow)
			assert taps == 2
			assert shown.count == 2
		}

		// A child that writes a place bound to a member of another object than the
		// page marks the page: no store of the page's fields says so.
		@test()
		def TestABoundPlaceOfAnotherObjectMarks() {
			let page = NamePage()
			let scene = clickScene(page)
			let editor = page.find<NameEditor>()
			assert !(editor is none)
			return when editor is none
			let runs = pageRuns
			editor.write("b")
			assert page.named.name == "b"
			assert page.needsBuild
			let _ = scene.arrange(tapWindow)
			assert pageRuns == runs + 1
			assert editor.value == "b"
		}
	}
}
