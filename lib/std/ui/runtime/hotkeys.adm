internal partial module std.ui.runtime {
	use (
		std.ui::(Key, KeyEvent)
		std.ui.layout::Node
	)

	// A component that keys pressed anywhere in its window run: a menu line with a
	// shortcut.
	interface Hotkeyed {
		// The keys; none: it has none.
		def hotkey() ?Hotkey
		// The keys were pressed.
		def hotkeyPressed()
	}

	// A key and the modifiers held with it. `mod` is the platform's main modifier (Control,
	// Command on macOS), `command` the Command or Windows key.
	struct Hotkey {
		key                      Key
		shift, alt, mod, command bool
	}

	// The keys written as they are shown, "Ctrl+Shift+S", "F2", "Del", read once per text.
	type HotkeySlot {
		text  string
		found ?Hotkey = none

		// The keys `written` names; none for an empty text and for one that names no key,
		// which is reported once with the frame's warnings.
		def get(written string) ?Hotkey {
			return found when written == text
			text = written
			found = none
			return none when written == ""
			found = parseHotkey(written)
			warn("shortcut \"" + written + "\" is not read: write modifiers (Ctrl, Shift, Alt, Cmd) and one key of `Key`, joined with +") when found is none
			return found
		}
	}

	// The key a name stands for as people write it, in any case: a member of `Key`, a
	// digit, or a short form (Del, Esc, Ins, Return, PgUp, PgDn).
	def keyNamed(written string) ?Key {
		let name = written.trim().upper()
		switch name {
			case "DEL":
				return Key.Delete
			case "ESC":
				return Key.Escape
			case "INS":
				return Key.Insert
			case "RETURN":
				return Key.Enter
			case "PGUP":
				return Key.PageUp
			case "PGDN", "PGDOWN":
				return Key.PageDown
			default:
		}
		// A digit is the key of that digit.
		name = "DIGIT" + name when name.len() == 1 && name >= "0" && name <= "9"
		for let (at, known) in Key.keys() {
			// `Unknown` and `Character` name no one key.
			continue when at <= Key.Character.ordinal
			return Key(at) when known.upper() == name
		}
		return none
	}

	// The keys written in `spec`; none when a part before the last is no modifier or the
	// last names no key. "Ctrl" is the platform's main modifier (Command on macOS); "Cmd",
	// "Super", "Meta" and "Win" are the Command or Windows key.
	def parseHotkey(spec string) ?Hotkey {
		let parts = spec.split("+")
		return none when parts.len() == 0
		let key = keyNamed(parts[parts.len() - 1])
		return none when key is none
		let keys = Hotkey{key: key}
		for let i = 0; i + 1 < parts.len(); i++ {
			switch parts[i].trim().upper() {
				case "SHIFT":
					keys.shift = true
				case "ALT", "OPTION":
					keys.alt = true
				case "CTRL", "CONTROL", "MOD":
					keys.mod = true
				case "CMD", "COMMAND", "SUPER", "META", "WIN":
					keys.command = true
				default:
					return none
			}
		}
		return keys
	}

	// Whether `event` is the key of `keys` with exactly its modifiers.
	def hotkeyMatches(keys Hotkey, event KeyEvent) bool {
		return false when event.key != keys.key
		let held = event.modifiers
		return false when held.shift != keys.shift || held.alt != keys.alt || held.mod != keys.mod
		// Where Command is the main modifier it is held with it.
		return held.command == keys.command || (keys.mod && held.command)
	}

	// What went wrong since the last frame that a frame's warnings report.
	type Warnings {
		pending string[]
	}

	let noted = new Warnings()

	// Adds a line to the warnings the next `Scene.arrange` returns.
	def warn(line string) {
		noted.pending.push(line)
	}

	// The lines added with `warn` since it was last called.
	def takeWarnings() string[] {
		let taken = noted.pending
		noted.pending = string[]
		return taken
	}

	// Runs the first enabled component at or under `node` whose keys are those of `event`.
	// True when one ran. The lines of a context menu are passed over: the keys such a
	// line shows are the ones its target takes while it has the focus, not keys of the
	// window.
	def runHotkey(node Node, event KeyEvent) bool {
		let owner = node.owner
		if !(owner is none) {
			return false when owner.disabled || owner is Contextual
			if owner is Hotkeyed {
				let keys = owner.hotkey()
				if !(keys is none) && hotkeyMatches(keys, event) {
					owner.hotkeyPressed()
					return true
				}
			}
		}
		for let child in node.children {
			return true when runHotkey(child, event)
		}
		return false
	}
}
