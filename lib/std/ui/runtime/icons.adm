internal partial module std.ui.runtime {
	use (
		std.gfx.canvas
		std.gfx.color::(Color, RGBA)
		std.math.geom::(Line, LineCap, LineJoin, Path, Point, Rect, StrokeStyle)
		std.ui::IconSet
		std.units::Pixels
	)

	// A line of an std icon: 1.5 thick, round at its ends and corners.
	def iconStroke() StrokeStyle {
		return StrokeStyle{width: 1.5(px), cap: LineCap.Round, join: LineJoin.Round}
	}

	// Records an icon made of open lines through the points of each of `lines`, two numbers
	// a point.
	def lineIcon(lines float[][]) canvas.Picture {
		return canvas.record(def (painter canvas.Painter) {
			let ink = new Color(RGBA{r: 0, g: 0, b: 0, a: 255})
			for let points in lines {
				let path = new Path()
				path.moveTo(points[0], points[1])
				for let i = 2; i + 1 < points.len(); i += 2 {
					path.lineTo(points[i], points[i + 1])
				}
				painter.stroke(path, ink, iconStroke())
			}
		})
	}

	// The icons the std components use: chevrons, close, check, search, menu, plus, minus.
	def stdIcons() IconSet {
		let icons = map<string, canvas.Picture>{}
		icons = icons.set("chevron-down", lineIcon([[4.0, 6.0, 8.0, 10.0, 12.0, 6.0]]))
		icons = icons.set("chevron-up", lineIcon([[4.0, 10.0, 8.0, 6.0, 12.0, 10.0]]))
		icons = icons.set("chevron-right", lineIcon([[6.0, 4.0, 10.0, 8.0, 6.0, 12.0]]))
		icons = icons.set("chevron-left", lineIcon([[10.0, 4.0, 6.0, 8.0, 10.0, 12.0]]))
		icons = icons.set("close", lineIcon([[4.5, 4.5, 11.5, 11.5], [11.5, 4.5, 4.5, 11.5]]))
		icons = icons.set("check", lineIcon([[3.5, 8.5, 6.5, 11.5, 12.5, 4.5]]))
		icons = icons.set("plus", lineIcon([[8.0, 3.5, 8.0, 12.5], [3.5, 8.0, 12.5, 8.0]]))
		icons = icons.set("minus", lineIcon([[3.5, 8.0, 12.5, 8.0]]))
		icons = icons.set("menu", lineIcon([[3.0, 4.5, 13.0, 4.5], [3.0, 8.0, 13.0, 8.0], [3.0, 11.5, 13.0, 11.5]]))
		icons = icons.set("search", canvas.record(def (painter canvas.Painter) {
			let ink = new Color(RGBA{r: 0, g: 0, b: 0, a: 255})
			let glass = new Path().circle(new Point(7.0, 7.0), 4.0)
			painter.stroke(glass, ink, iconStroke())
			painter.stroke(new Line(new Point(10.0, 10.0), new Point(13.0, 13.0)), ink, iconStroke())
		}))
		return IconSet{name: "std", icons: icons}
	}

	// The icon sets the program knows, std's first, and how often they changed: a
	// component that looked an icon up keeps it until this number moves.
	type IconShelf {
		sets    IconSet[]
		version int
	}

	let shelf = new IconShelf()

	// Adds a set; one with the name of a set already there replaces it.
	def shelveIcons(set IconSet) {
		let kept IconSet[] = shelf.sets.len() == 0 ?? ([stdIcons()], [])
		for let held in shelf.sets {
			kept.push(held) when held.name != set.name
		}
		kept.push(set)
		shelf.sets = kept
		shelf.version++
	}

	// An icon as a component draws it.
	struct FoundIcon {
		picture canvas.Picture
		// Whether it takes the colour of the text around it.
		tinted  bool
	}

	// The icon called `name`, looked for in the set added last first; `set/name` looks in
	// that set alone. None when no set holds it.
	def iconNamed(name string) ?FoundIcon {
		shelf.sets = [stdIcons()] when shelf.sets.len() == 0
		let slash = name.indexOf("/")
		let within = slash < 0 ?? ("", name[:slash])
		let wanted = slash < 0 ?? (name, name[slash + 1:])
		for let i = shelf.sets.len() - 1; i >= 0; i-- {
			let set = shelf.sets[i]
			continue when within != "" && set.name != within
			return FoundIcon{picture: set.icons[wanted], tinted: set.tinted} when set.icons.hasKey(wanted)
		}
		return none
	}

	// How often the icon sets changed.
	def iconsVersion() int {
		return shelf.version
	}

	// Draws an icon in `box`, as large as fits and in its middle; one that is tinted in
	// `ink`.
	def drawIcon(target canvas.Painter, icon FoundIcon, box Rect, ink Color) {
		let (wide, high) = (box.right - box.left, box.bottom - box.top)
		let by = (wide / 16.0).min(high / 16.0)
		return when by <= 0.0
		target.save()
		target.beginGroup(bounds = box) when icon.tinted
		target.save()
		target.translate(box.left + (wide - 16.0 * by) / 2.0, box.top + (high - 16.0 * by) / 2.0)
		target.scale(by, by)
		icon.picture.replay(target)
		target.restore()
		if icon.tinted {
			// The colour goes where the picture put ink, and nowhere else.
			target.setComposite(canvas.Composite.SourceIn)
			target.fill(box, ink)
			target.endGroup()
		}
		target.restore()
	}
}
