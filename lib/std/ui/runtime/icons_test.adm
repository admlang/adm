partial module std.ui.runtime {
	use (
		std.gfx.canvas
		std.gfx.color::(Color, RGBA)
		std.math.geom::Rect
		std.testing
		std.ui::(IconPainter, IconSet)
	)

	check "Icons" {
		// A tinted icon from a document is drawn in the ink, once per ink and shared by
		// every component that draws it, its own colours kept; a tinted icon without a
		// painter is flooded with the ink.
		@test()
		def TestInkedIconsDrawInTheInk() {
			let blue = new Color(RGBA{r: 0, g: 0, b: 255, a: 255})
			let black = new Color(RGBA{r: 0, g: 0, b: 0, a: 255})
			let red = new Color(RGBA{r: 255, g: 0, b: 0, a: 255})
			let green = new Color(RGBA{r: 0, g: 255, b: 0, a: 255})
			let made = 0
			let painters = map<string, IconPainter>{}
			painters = painters.set("half", def (ink Color) canvas.Picture {
				made++
				return canvas.record(def (p canvas.Painter) {
					p.fill(Rect{left: 0.0, top: 0.0, right: 8.0, bottom: 16.0}, ink)
					p.fill(Rect{left: 8.0, top: 0.0, right: 16.0, bottom: 16.0}, blue)
				})
			})
			let icons = map<string, canvas.Picture>{}
			icons = icons.set("half", canvas.record(def (p canvas.Painter) {
				p.fill(Rect{left: 0.0, top: 0.0, right: 16.0, bottom: 16.0}, black)
			}))
			shelveIcons(IconSet{name: "inky", icons: icons, inked: painters})
			shelveIcons(IconSet{name: "flat", icons: icons})
			let box = Rect{left: 0.0, top: 0.0, right: 16.0, bottom: 16.0}

			let found = iconNamed("inky/half")
			assert found is FoundIcon
			if found is FoundIcon {
				let surface = new canvas.Canvas(16, 16)
				drawIcon(surface, found, box, red)
				assert inked(surface, 4, 8, 255, 0, 0) && inked(surface, 12, 8, 0, 0, 255)
				drawIcon(surface, found, box, red)
				assert made == 1
				drawIcon(surface, found, box, green)
				assert made == 2 && inked(surface, 4, 8, 0, 255, 0) && inked(surface, 12, 8, 0, 0, 255)
				// Another component looking the icon up shares the pictures.
				let again = iconNamed("inky/half")
				drawIcon(new canvas.Canvas(16, 16), again, box, green) when again is FoundIcon
				assert made == 2
			}

			let flat = iconNamed("flat/half")
			assert flat is FoundIcon
			if flat is FoundIcon {
				let surface = new canvas.Canvas(16, 16)
				drawIcon(surface, flat, box, red)
				assert inked(surface, 4, 8, 255, 0, 0) && inked(surface, 12, 8, 255, 0, 0)
			}
		}
	}
}
