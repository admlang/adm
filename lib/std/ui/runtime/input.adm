internal partial module std.ui.runtime {
	use (
		std.math.geom::(Point, Transform2D)
		std.ui::(Key, KeyEvent, Modifiers, MouseButton, PointerEvent, PointerPhase, TextInputClient)
		std.ui.layout::Node
		std.ui.paint
		std.ui.styles::(Cursor, CursorShape)
		std.units::Pixels
	)

	// Whether `node` is still in the scene's tree.
	def inTree(scene Scene, node Node) bool {
		let at = node
		for {
			return true when at == scene.tree
			let above = at.parent
			return false when above is none
			at = above
		}
	}

	// `node` and its ancestors, the node first.
	def chainOf(node Node) Node[] {
		let chain Node[] = [node]
		for {
			let above = chain[chain.len() - 1].parent
			break when above is none
			chain.push(above)
		}
		return chain
	}

	def holds(chain Node[], node Node) bool {
		for let held in chain {
			return true when held == node
		}
		return false
	}

	// A window point in the coordinates of `node`; the point itself when the node's
	// transform cannot be undone.
	def localPoint(scene Scene, node Node, at Point<Pixels>, scale float) Point<Pixels> {
		let measure = new paint.Measure(float(scene.window.width), float(scene.window.height), scale)
		return pointIn(paint.world(measure, node), at)
	}

	// A window point in the coordinates whose transform to the window is `world`; the
	// point itself when that transform cannot be undone.
	def pointIn(world Transform2D, at Point<Pixels>) Point<Pixels> {
		let inverse = paint.undo(world)
		return at when inverse is none
		let (x, y) = (float(at.x), float(at.y))
		return new Point<Pixels>((inverse.a * x + inverse.c * y + inverse.tx) * 1(px), (inverse.b * x + inverse.d * y + inverse.ty) * 1(px))
	}

	// The left and top in the window of each node of `chain` (a node and its ancestors,
	// the node first), two numbers a node; empty when a node of the chain has a transform,
	// so that its place alone does not say where a point falls in it.
	def originsOf(scene Scene, chain Node[], scale float) float[] {
		let measure = new paint.Measure(float(scene.window.width), float(scene.window.height), scale)
		let origins float[]
		origins.len(chain.len() * 2)
		for let (i, node) in chain {
			let frame = node.geom.frame
			let (left, top) = (measure.snap(float(frame.left)), measure.snap(float(frame.top)))
			let decoration = node.decoration
			if !(decoration is none) {
				let turned = paint.matrixOf(measure, decoration.transform, measure.snap(float(frame.right)) - left, measure.snap(float(frame.bottom)) - top, node.em)
				return [] unless turned is none
			}
			origins[i * 2] = left
			origins[i * 2 + 1] = top
		}
		return origins
	}

	// The transform to the window of each node of `chain` (a node and its ancestors up
	// to the root, the node first), each made once from its parent's.
	def worldsOf(scene Scene, chain Node[], scale float) Transform2D[] {
		let measure = new paint.Measure(float(scene.window.width), float(scene.window.height), scale)
		let worlds Transform2D[]
		worlds.len(chain.len())
		for let i = chain.len() - 1; i >= 0; i-- {
			let node = chain[i]
			let parent = node.parent
			if parent is none || i == chain.len() - 1 {
				worlds[i] = paint.world(measure, node)
				continue
			}
			worlds[i] = worlds[i + 1].then(paint.local(measure, node, measure.snap(float(parent.geom.frame.left)), measure.snap(float(parent.geom.frame.top))))
		}
		return worlds
	}

	// Hands the event to the component of `node` alone.
	def tell(scene Scene, node Node, phase PointerPhase, target component, at Point<Pixels>, scale float) {
		let owner = node.owner
		return when owner is none
		let event = new PointerEvent(phase, target, at)
		event.position = localPoint(scene, node, at, scale)
		event.modifiers = scene.modifiers
		let _ = owner.pointer(event)
	}

	// Takes one thing a pointer did at `at`, a point of the window in logical pixels:
	// keeps `hover` and `pressed` right, tells components the pointer entered or left them,
	// moves the focus on a press, and offers the event to the component under the pointer
	// (or the one that captured it), then to its ancestors until one handles it. Returns
	// the component under the pointer.
	def routePointer(scene Scene, phase PointerPhase, at Point<Pixels>, button MouseButton, scroll Point<Pixels>, scale float, clicks int = 1) component {
		// While something is dragged the pointer is the drag's.
		let source = scene.dragged
		let carried = scene.dragData
		if !(source is none) && !(carried is none) {
			return dragPointer(scene, source, carried, phase, at, button, scale)
		}
		let found = nodeAt(scene, at, scale)
		let under = scene.tree
		under = found unless found is none
		// Behind a modal nothing is under the pointer but the modal itself, and what the
		// pointer does there is given to nobody.
		let modal = modalOf(scene)
		let blocked = false
		if !(modal is none) && behind(scene, modal, under) {
			under = modal
			blocked = true
		}
		let target = scene.root
		let hit = under.owner
		target = hit unless hit is none

		// Hover: the component under the pointer and its ancestors; none once the pointer
		// left the window.
		let leaving = phase == PointerPhase.Leave || phase == PointerPhase.Cancel
		// The pointer is still over the component it was over: the same chain is hovered.
		let same = !leaving && scene.over.len() > 0 && scene.over[0] == under && inTree(scene, under)
		// A move changes something only when the hover set does or a component takes it;
		// any other phase does.
		scene.touched = !same || phase != PointerPhase.Move
		if !same {
			let over Node[]
			over = chainOf(under) unless leaving
			for let old in scene.over {
				continue when holds(over, old) || !inTree(scene, old)
				let owner = old.owner
				owner.isHover = false unless owner is none
				hoverScopes(owner, false)
				tell(scene, old, PointerPhase.Leave, target, at, scale)
			}
			for let fresh in over {
				continue when holds(scene.over, fresh)
				let owner = fresh.owner
				owner.isHover = true unless owner is none
				hoverScopes(owner, true)
				tell(scene, fresh, PointerPhase.Enter, target, at, scale)
			}
			scene.over = over
		}
		// The tooltip waits on the component the pointer came to; a press or a turn of
		// the wheel hides it until the pointer is over another one.
		if leaving || phase == PointerPhase.Down || phase == PointerPhase.Scroll {
			dropTip(scene)
		} else if !blocked && !same {
			watchTip(scene, under, at, false)
		}
		return target when phase == PointerPhase.Enter || phase == PointerPhase.Leave

		if phase == PointerPhase.Down {
			scene.keyed = false
			dismissOutside(scene, under)
			release(scene)
			if !blocked {
				scene.pressed = under
				hit.isPressed = true unless hit is none
				scene.pressAt = at
				scene.dragFrom = sourceFrom(hit) when button == MouseButton.Left
				focusFrom(scene, under)
			}
		}
		if blocked {
			release(scene) when phase == PointerPhase.Up || phase == PointerPhase.Cancel
			return target
		}

		let start = under
		let held = scene.held
		start = held when !(held is none) && inTree(scene, held)
		let event = new PointerEvent(phase, target, at)
		event.button = button
		event.scroll = scroll
		event.modifiers = scene.modifiers
		event.clicks = clicks
		let chain = chainOf(start)
		// Where each node of the chain starts in the window; empty when one of them is
		// transformed, and then each gets its matrix.
		let origins = originsOf(scene, chain, scale)
		let worlds Transform2D[]
		worlds = worldsOf(scene, chain, scale) when origins.len() == 0
		// The component that handled the event.
		let taker ?component = none
		for let (i, step) in chain {
			let owner = step.owner
			continue when owner is none
			if origins.len() == 0 {
				event.position = pointIn(worlds[i], event.windowPosition)
			} else {
				event.position = new Point<Pixels>(event.windowPosition.x - origins[i * 2] * 1(px), event.windowPosition.y - origins[i * 2 + 1] * 1(px))
			}
			let handled = owner.pointer(event)
			taker = owner when handled
			// A scoped component above it has no place in the tree of nodes: it is
			// offered the event here, where the component it holds saw it.
			let scope = scopeAbove(owner)
			for !handled {
				break when scope is none
				handled = scope.pointer(event)
				taker = scope when handled
				scope = scopeAbove(scope)
			}
			scene.touched = true when handled
			scene.held = step when event.captured && scene.held is none && phase == PointerPhase.Down
			break when handled
		}
		if phase == PointerPhase.Up && button == MouseButton.Right {
			scene.touched = true when openContext(under, at)
		}
		// A press on something in a `DragSource` that moved away drags it, unless a
		// component inside the source took the move for a drag of its own (a slider's
		// thumb, a selection in a field).
		let dragFrom = scene.dragFrom
		if phase == PointerPhase.Move && !(dragFrom is none) {
			let (dx, dy) = (float(at.x) - float(scene.pressAt.x), float(at.y) - float(scene.pressAt.y))
			if dx * dx + dy * dy >= dragSlack * dragSlack && !heldIn(taker, dragFrom) {
				return target when beginDrag(scene, dragFrom, at, scale)
			}
		}

		release(scene) when phase == PointerPhase.Up || phase == PointerPhase.Cancel
		// The pointer's shape: that of the component that holds the pointer, else of the
		// one under it; the plain arrow once it left the window.
		let pointing = under
		let holding = scene.held
		pointing = holding when !(holding is none) && inTree(scene, holding)
		scene.cursor = leaving ?? (Cursor.Default, cursorOf(pointing))
		return target
	}

	// The pointer's shape over `node`: the `cursor` of the nearest style at or above it
	// that sets one, the plain arrow when none does. An image cursor is not shown yet.
	def cursorOf(node Node) Cursor {
		let at ?Node = node
		for {
			return Cursor.Default when at is none
			let owner = at.owner
			if !(owner is none) {
				let look = owner.style
				if look is Cursored {
					let shape = look.cursor
					if !(shape is none) {
						return shape when shape is Cursor
						return Cursor.Default
					}
				}
			}
			at = at.parent
		}
	}

	// Sets `hover` on the scoped components directly above `owner`.
	def hoverScopes(owner ?component, on bool) {
		return when owner is none
		let scope = scopeAbove(owner)
		for {
			return when scope is none
			scope.isHover = on
			scope = scopeAbove(scope)
		}
	}

	// Sets `focusWithin` on the scoped components directly above `owner`.
	def withinScopes(owner ?component, on bool) {
		return when owner is none
		let scope = scopeAbove(owner)
		for {
			return when scope is none
			scope.isFocusWithin = on
			scope = scopeAbove(scope)
		}
	}

	// Ends a press: nothing is pressed and no component holds the pointer.
	def release(scene Scene) {
		let pressed = scene.pressed
		if !(pressed is none) {
			let owner = pressed.owner
			owner.isPressed = false unless owner is none
		}
		scene.pressed = none
		scene.held = none
		scene.dragFrom = none
	}

	// Gives the focus to the nearest focusable component at or above `node`; none there
	// takes the focus away.
	def focusFrom(scene Scene, node Node) {
		for let step in chainOf(node) {
			let owner = step.owner
			continue when owner is none
			if owner.focusable && !owner.disabled {
				keepReturns(scene, step)
				setFocus(scene, step)
				return
			}
		}
		setFocus(scene, none)
	}

	// A component that remembers which component under it had the keyboard focus last,
	// and may keep Tab among what it holds: `FocusScope`.
	interface FocusKeeper {
		// `inside`, a component it holds, got the focus.
		def keepFocus(inside component)
		// The component it holds that had the focus last; none: none had.
		def keptFocus() ?component
		// Whether Tab stays among what it holds.
		def trapsFocus() bool
	}

	// The nearest keeper at or above `from` that keeps Tab inside.
	def trapOf(from ?component) ?component {
		let at = from
		for {
			return none when at is none
			if at is FocusKeeper {
				return at when at.trapsFocus()
			}
			at = at.parent()
		}
	}

	// Where the focus goes when Tab would move it from `old` to `next`: into a keeper
	// it enters from outside, to what had the focus there last when that can still take
	// it; else to `next`. The outermost keeper entered decides.
	def keptFor(scene Scene, next Node, old ?Node) Node {
		let came ?component = none
		came = old.owner unless old is none
		let found = next
		let at = next.owner
		for {
			break when at is none
			if at is FocusKeeper {
				let kept = at.keptFocus()
				if !heldIn(came, at) && !(kept is none) && heldIn(kept, at) && kept.focusable && !kept.disabled {
					let node = nodeOf(scene.tree, kept)
					found = node unless node is none || !shown(scene, node)
				}
			}
			at = at.parent()
		}
		return found
	}

	// Moves the keyboard focus to `node`'s component and keeps `focused` and `focusWithin`
	// right; none: nothing has the focus.
	def setFocus(scene Scene, node ?Node, byKey bool = false) {
		let old = scene.focus
		if !(old is none) {
			for let above in chainOf(old) {
				let owner = above.owner
				continue when owner is none
				owner.isFocused = false
				owner.isFocusWithin = false
				owner.isFocusVisible = false
				withinScopes(owner, false)
			}
		}
		scene.focus = node
		return when node is none
		for let above in chainOf(node) {
			let owner = above.owner
			owner.isFocusWithin = true unless owner is none
			withinScopes(owner, true)
		}
		let owner = node.owner
		return when owner is none
		owner.isFocused = true
		owner.isFocusVisible = byKey
		// Every keeper above it remembers it.
		let above = owner.parent()
		for {
			break when above is none
			if above is FocusKeeper {
				above.keepFocus(owner)
			}
			above = above.parent()
		}
	}

	// Notes a modifier key going down or up in the scene's set: the left and right Shift,
	// Control, Alt and Super; other keys change nothing.
	def holdModifier(scene Scene, key Key, down bool) {
		let held = scene.modifiers
		match key {
			case Key.LeftShift, Key.RightShift:
				held.shift = down
			case Key.LeftControl, Key.RightControl:
				held.control = down
				held.mod = down
			case Key.LeftAlt, Key.RightAlt:
				held.alt = down
			case Key.LeftSuper, Key.RightSuper:
				held.command = down
			default:
		}
	}

	// Hands text the platform's input produced to the focused component when it edits
	// text. False when it does not.
	def routeText(scene Scene, text string) bool {
		let focus = scene.focus
		return false when focus is none || !inTree(scene, focus)
		let owner = focus.owner
		return false when owner is none
		if owner is TextInputClient {
			owner.commit(text)
			return true
		}
		return false
	}

	// Appends the nodes under `node` that Tab stops at, in tree order: visible, enabled,
	// focusable components with `tabStop`.
	def tabStops(node Node, into Node[]) {
		return when !node.box.visible || node.exiting
		let owner = node.owner
		if !(owner is none) {
			return when !owner.enabled
			into.push(node) when owner.tabStop && owner.focusable
		}
		for let child in node.children {
			tabStops(child, into)
		}
	}

	// Moves the focus to the next Tab stop after the focused component, or the one before
	// it, going round at the ends, and scrolls it into view. False when there is none.
	def tabFocus(scene Scene, backwards bool) bool {
		let stops Node[]
		// Inside the modal on top when there is one.
		let from = scene.tree
		let modal = modalOf(scene)
		from = modal unless modal is none
		tabStops(from, stops)
		let focus = scene.focus
		// Inside a keeper that keeps Tab among what it holds, only those are stops.
		let trap ?component = none
		trap = trapOf(focus.owner) unless focus is none
		if !(trap is none) {
			let inside Node[]
			for let stop in stops {
				inside.push(stop) when heldIn(stop.owner, trap)
			}
			stops = inside
		}
		let count = stops.len()
		return false when count == 0
		let at = backwards ?? (0, count - 1)
		if !(focus is none) {
			for let (i, stop) in stops {
				at = i when stop == focus
			}
		}
		let next = keptFor(scene, stops[(at + (backwards ?? (count - 1, 1))) % count], focus)
		setFocus(scene, next, true)
		showNode(next)
		return true
	}

	// The box a node that scrolls shows its content in: its content box, in the window.
	def viewOf(node Node) (float, float, float, float) {
		let outer = node.geom.frame
		let inner = node.geom.content
		return (float(outer.left) + float(inner.left), float(outer.top) + float(inner.top), float(outer.left) + float(inner.right), float(outer.top) + float(inner.bottom))
	}

	// Scrolls every scrolling ancestor of `node` by what brings the node's box inside its
	// view, as far as the boxes of the last layout tell.
	def showNode(node Node) {
		let frame = node.geom.frame
		let (left, top, right, bottom) = (float(frame.left), float(frame.top), float(frame.right), float(frame.bottom))
		for let above in chainOf(node) {
			continue when above == node
			let owner = above.owner
			if !(owner is none) && !(above.scroll is none) {
				if owner is Scroller {
					let (viewLeft, viewTop, viewRight, viewBottom) = viewOf(above)
					let dx = 0.0
					dx = right - viewRight when right > viewRight
					dx = left - viewLeft when left < viewLeft
					let dy = 0.0
					dy = bottom - viewBottom when bottom > viewBottom
					dy = top - viewTop when top < viewTop
					// The offset counts from the start corner: the right one under
					// RightToLeft.
					let _ = owner.scrollBy(new Point<Pixels>((above.rtl ?? (-dx, dx)) * 1(px), dy * 1(px)))
					left -= dx
					right -= dx
					top -= dy
					bottom -= dy
				}
			}
		}
	}

	// Offers a key to the focused component, then to its ancestors until one handles it;
	// to the root when nothing has the focus. Tab left unhandled moves the focus to the
	// next Tab stop, with Shift held to the one before. A key that came up is offered the
	// same way and does nothing more. Sets the event's target and returns it.
	def routeKey(scene Scene, event KeyEvent) component {
		let start = scene.tree
		let focus = scene.focus
		start = focus when !(focus is none) && inTree(scene, focus)
		let target = scene.root
		let first = start.owner
		target = first unless first is none
		event.target = target
		holdModifier(scene, event.key, event.down)
		let held = scene.modifiers
		event.modifiers = Modifiers{shift: held.shift, control: held.control, alt: held.alt, command: held.command, mod: held.mod}
		if event.down {
			scene.keyed = true
			dropTip(scene)
			// Escape calls off a drag before any component hears of it.
			return target when event.key == Key.Escape && endDrag(scene)
		}
		let handled = false
		for let step in chainOf(start) {
			let owner = step.owner
			continue when owner is none
			handled = owner.key(event)
			let scope = scopeAbove(owner)
			for !handled {
				break when scope is none
				handled = scope.key(event)
				scope = scopeAbove(scope)
			}
			break when handled
		}
		return target when !event.down
		// Tab that no component took moves the focus; Escape closes what floats on top.
		if !handled && event.key == Key.Tab {
			let _ = tabFocus(scene, scene.modifiers.shift)
			watchTip(scene, scene.focus, new Point<Pixels>(0(px), 0(px)), true)
		}
		if !handled && event.key == Key.Escape {
			let _ = dismissLast(scene)
		}
		// A key no component took runs the menu line, anywhere in the window (in the modal
		// on top when there is one), whose shortcut it is.
		if !handled && !(event.key := Key.Tab || Key.Escape) {
			let within = scene.tree
			let modal = modalOf(scene)
			within = modal unless modal is none
			handled = runHotkey(within, event)
		}
		// The Menu key, or Shift+F10, opens the context menu of the focused component,
		// at its middle.
		if !handled && (event.key == Key.Menu || (event.key == Key.F10 && scene.modifiers.shift)) {
			let frame = start.geom.frame
			let middle = new Point<Pixels>((frame.left + frame.right) / 2.0, (frame.top + frame.bottom) / 2.0)
			let _ = openContext(start, middle)
		}
		return target
	}
}
