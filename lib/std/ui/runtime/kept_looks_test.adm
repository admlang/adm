internal partial module std.ui.runtime {
	use (
		std.math.geom::(Axes, Edges, Size)
		std.ui.layout::Node
		std.testing
		std.ui.components::(Column, Row, Text)
		std.ui.styles::*
		std.units::*
	)

	component KeptPage {
		type {}

		view {
			Column(ref = column, style = {width: fill}) {
				Text("inside", ref = label)
			}
		}

		style {
			Box
			Layout
			Typography
			font = {size: 20(px)}
		}
	}

	// The font size a node was given, in pixels; 0 when it has none.
	internal def fontOf(node Node) float {
		let size = node.fontSize
		return size is none ?? (0.0, float(size))
	}

	check "Kept looks" {
		// A style counts the assignments that change a property: the value it holds, or
		// one made anew with the same fields, is no change.
		@test()
		def TestEqualAssignmentsKeepTheCount() {
			let look = Row().style
			look.width = fill
			look.gap = new Axes<Extent>(4(px))
			look.minWidth = 10(px)
			let start = look.version
			look.width = fill
			look.gap = new Axes<Extent>(4(px))
			look.minWidth = 10(px)
			assert look.version == start
			look.gap = new Axes<Extent>(5(px))
			assert look.version == start + 1
			look.minWidth = 12(px)
			look.minWidth = none
			assert look.version == start + 3
		}

		// A node whose look is as it was is not copied again, yet follows what changes
		// above it (an inherited font) and on its own component (a property set in code).
		@test()
		def TestUnchangedNodesFollowChangesAbove() {
			let page = KeptPage()
			let scene = new Scene(page)
			let size = new Size<Pixels>(200(px), 200(px))
			scene.arrange(size)
			scene.arrange(size)
			let (label, column) = (page.label, page.column)
			assert !(label is none) && !(column is none)
			return when label is none || column is none
			let before = nodeOf(scene.tree, label)
			assert !(before is none)
			if !(before is none) {
				assert fontOf(before) == 20.0
			}
			page.style.font = Font{size: 30(px)}
			scene.arrange(size)
			let after = nodeOf(scene.tree, label)
			if !(after is none) {
				assert fontOf(after) == 30.0
			}
			column.style.padding = new Edges<Extent>(6(px))
			scene.arrange(size)
			let held = nodeOf(scene.tree, column)
			assert !(held is none)
			if !(held is none) {
				let top = held.box.padding.top
				assert top is Pixels
				if top is Pixels {
					assert top == 6(px)
				}
			}
			scene.close()
		}
	}
}
