internal partial module std.ui.runtime {
	use (
		std.testing
		std.ui.styles::*
	)

	component NarrowNamed {
		style {
			Box
		}

		type {
			@input(value = true)
			label string
		}

		view {}
	}

	// A `?component` narrowed with `is`: present, and read as the component it is.
	def labelOf(from ?component) string {
		let at ?component = from
		if at is NarrowNamed {
			return at.label
		}
		return ""
	}

	def labelOfPlain(from component) string {
		if from is NarrowNamed {
			return from.label
		}
		return ""
	}

	check "KindNarrowing" {
		// A component held through its kind, optional or not, narrowed with `is`,
		// reads the fields of the component it is.
		@test()
		def TestNarrowOptionalComponent() {
			assert labelOfPlain(NarrowNamed("a")) == "a"
			assert labelOf(NarrowNamed("b")) == "b"
			assert labelOf(none) == ""
		}
	}
}
