partial module std.ui.runtime {
	use (
		std.gfx.canvas
		std.gfx.color::(Color, RGBA)
		std.math.geom::Size
		std.testing
		std.ui::UI
		std.ui.components::(Column, Panel, Popover, Text)
		std.ui.styles::*
		std.units::Pixels
	)

	// A popover holding a panel drawn in the floating layer, as a sticky row of a list
	// in a popover is.
	component FloatInPopup {
		type {}

		view {
			Text("anchor", ref = anchor)
			Popover(open = true, attach = anchor, ref = popover) {
				Column(style = {width: 120(px), height: 80(px)}) {
					Panel(style = {width: 100(px), height: 30(px), layer: Layer.Floating, background: new BackgroundFill(new Color(RGBA{r: 255, g: 0, b: 0, a: 255}))}, ref = floated)
				}
			}
		}

		style {
			Box
			Layout
			width  = 200(px)
			height = 200(px)
		}
	}

	check "Layers" {
		// A node in the floating layer inside a popover is painted after the popover,
		// not under it: the popover's surface would cover a sticky row of a list in it.
		@test()
		def TestFloatInsideAPopupPaintsOverIt() {
			let page = FloatInPopup()
			let scene = new Scene(page)
			let size = new Size<Pixels>(200(px), 200(px))
			scene.arrange(size)
			scene.arrange(size)
			let floated = page.floated
			assert !(floated is none)
			return when floated is none
			let surface = new canvas.Canvas(200, 200)
			scene.paint(surface)
			let frame = floated.style.geom.frame
			let (x, y) = (int(frame.left) + 50, int(frame.top) + 15)
			let at = (y * 200 + x) * 4
			assert surface.pixels[at] == 255 && surface.pixels[at + 1] == 0 && surface.pixels[at + 2] == 0
			scene.close()
		}
	}
}
