internal partial module std.ui.runtime {
	use (
		std.gfx.canvas
		std.gfx.color::Color
		std.math::(ln, sqrt)
		std.math.easing
		std.math.geom::(Corners, Edges)
		std.time
		std.ui.layout::Node
		std.ui.styles::*
		std.units::(Angle, Extent, FontRelative, Length, Percent, Pixels, ViewportHeight, ViewportWidth)
	)

	// What a node's drawn look is travelling through.
	enum MotionKind {
		// Nothing: it is drawn as its style says.
		Still,
		// From the look its style's `enter` gives to its own: it appeared.
		Enter,
		// From its own look to the one its style's `exit` gives: it goes.
		Exit,
		// From the look it was drawn with to the one its style now gives: a state, a
		// write to its style or the theme changed it, and its style's `transition`
		// says how long that takes.
		Change,
	}

	// The values of a node a change of look moves through: those the renderer draws
	// (opacity, transform, background colour, corners, border colours, drop shadows)
	// and the box sizes and spacing layout reads.
	struct Drawn {
		opacity    float           = 1.0
		transform  Transform       = Transform{}
		background ?Color          = none
		radius     Corners<Extent> = new Corners<Extent>(0(px))
		borders    Color[]         = []
		shadows    Shadow[]        = []
		width      Sizing          = auto
		height     Sizing          = auto
		margin     Edges<Extent>   = new Edges<Extent>(0(px))
		padding    Edges<Extent>   = new Edges<Extent>(0(px))
	}

	// The motion of one node whose style has an `enter` or an `exit`.
	type Moving {
		node      Node
		kind      MotionKind    = MotionKind.Still
		// When the motion under way began.
		start     time.Time
		// The look it comes from (Enter) or goes to (Exit): a node filled from a copy of
		// the style with the patch applied.
		ghost     Node          = new Node()
		// Whether the node was shown, by its style and its place in the tree, when it was
		// last looked at.
		shown     bool
		// Whether it was looked at in the frame under way, and whether its component
		// was told `detached` when its exit began.
		frame     int
		told      bool
		// The curve of the motion under way, how long it takes after its delay, and
		// whether the curve reads seconds (a spring) or a share of that length.
		ease      easing.Easing = easing.linear
		length    duration
		delay     duration
		inSeconds bool
		// For a change of look: the values its style gave it last, what a change
		// started from, and what was drawn in the frame before.
		target    ?Drawn        = none
		from      Drawn         = Drawn{}
		drawn     Drawn         = Drawn{}

		def new(node Node) {
			self.node = node
		}
	}

	// Gives `state` the curve and the length of the transition `how`, both from
	// `std.math.easing`. A spring has no duration of its own: it is over once it has
	// settled within a thousandth, and its curve reads seconds, not a share of its length.
	def timeMotion(state Moving, how Transition) {
		state.delay = how.delay
		state.length = how.duration
		state.inSeconds = false
		let curve = how.easing
		match curve {
			case Ease:
				match curve {
					case Ease.Out:
						state.ease = easing.easeOutCubic
					case Ease.In:
						state.ease = easing.easeInCubic
					case Ease.InOut:
						state.ease = easing.easeInOutCubic
					default:
						state.ease = easing.linear
				}
			case Curve:
				state.ease = easing.cubicBezier(curve.x1, curve.y1, curve.x2, curve.y2)
			case Steps:
				state.ease = easing.steps(curve.count)
			case Spring:
				state.ease = easing.spring(curve.mass, curve.stiffness, curve.damping, 0.0)
				state.length = settleTime(curve)
				state.inSeconds = true
		}
	}

	// How long a spring takes to stay within a thousandth of where it comes to rest;
	// one that is not damped never does and is given a second.
	def settleTime(of Spring) duration {
		return 0s when of.mass <= 0.0 || of.stiffness <= 0.0
		let natural = sqrt(of.stiffness / of.mass)
		let ratio = of.damping / (2.0 * sqrt(of.stiffness * of.mass))
		return 1s when ratio <= 0.0
		// The slower of its two rates decides when it is overdamped.
		let rate = ratio <= 1.0 ?? (ratio * natural, natural * (ratio - sqrt(ratio * ratio - 1.0)))
		return ln(1000.0) / rate * 1s
	}

	// How far the motion of `state` has gone `elapsed` after it began: 0 at its start, 1
	// at its end (a spring passes 1 on the way), and whether it is over.
	def progress(state Moving, elapsed duration) (float, bool) {
		let since = elapsed - state.delay
		return (0.0, false) when since < 0s
		return (1.0, true) when since >= state.length
		let run = state.ease
		return (run(float(since) / float(1s)), false) when state.inSeconds
		return (run(float(since) / float(state.length)), false)
	}

	// Whether a distance is none at all, which it then is in every unit.
	def isNone(extent Extent) bool {
		match extent {
			case Pixels:
				return float(extent) == 0.0
			case Percent:
				return float(extent) == 0.0
			case FontRelative:
				return float(extent) == 0.0
			case ViewportHeight:
				return float(extent) == 0.0
			case ViewportWidth:
				return float(extent) == 0.0
			case Length:
				return float(extent) == 0.0
		}
	}

	// `part` of a distance, in its own unit.
	def share(of Extent, part float) Extent {
		match of {
			case Pixels:
				let at Extent = of * part
				return at
			case Percent:
				let at Extent = of * part
				return at
			case FontRelative:
				let at Extent = of * part
				return at
			case ViewportHeight:
				let at Extent = of * part
				return at
			case ViewportWidth:
				let at Extent = of * part
				return at
			case Length:
				let at Extent = of * part
				return at
		}
	}

	// A distance part of the way from one to another of the same unit, or from or to no
	// distance (in the unit of the other); `to` when their units differ otherwise.
	def between(from Extent, to Extent, part float) Extent {
		return share(to, part) when isNone(from)
		return share(from, 1.0 - part) when isNone(to)
		if from is Pixels && to is Pixels {
			let at Extent = from + (to - from) * part
			return at
		}
		if from is Percent && to is Percent {
			let at Extent = from + (to - from) * part
			return at
		}
		if from is FontRelative && to is FontRelative {
			let at Extent = from + (to - from) * part
			return at
		}
		return to
	}

	// A transform part of the way from one to another, field by field; the fixed point
	// and the matrix are `to`'s.
	def between(from Transform, to Transform, part float) Transform {
		let turn Angle = from.rotate + (to.rotate - from.rotate) * part
		return Transform{
			translate: Offset{x: between(from.translate.x, to.translate.x, part), y: between(from.translate.y, to.translate.y, part)},
			scale:     from.scale.lerp(to.scale, part),
			rotate:    turn,
			skew:      from.skew.lerp(to.skew, part),
			origin:    to.origin,
			matrix:    to.matrix,
		}
	}

	// What a node's `motionSlot` is when its style has neither an `enter` nor an `exit`.
	const motionless = -2

	// The time a scene's motions read: the scene's own when it is given one.
	def motionNow(scene Scene) time.Time {
		let set = scene.clock
		return set unless set is none
		return time.now()
	}

	// Starts a motion of `state` towards or from the look `patch` gives a copy of
	// the style of `owner`.
	def startMotion(state Moving, kind MotionKind, owner component, patch def(style, component), how Transition, em float, since time.Time) {
		timeMotion(state, how)
		let copy = owner.style.clone()
		patch(copy, owner)
		let ghost = new Node()
		let _ = lookInto(ghost, copy, em)
		state.ghost = ghost
		state.kind = kind
		state.start = since
	}

	// Follows the motion of `node`, whose style was just copied into it: one that
	// appears starts from its style's `enter`, one that goes travels to its `exit` and is
	// then let go of; in between its opacity and its transform are part of the way.
	// A node that goes stays drawn, takes no pointer, no focus and no Tab, and its
	// component is told `detached` as the exit begins. One that comes back while it goes
	// travels back from where it was. A transition of no length, or a move under reduced
	// motion, happens at once.
	def moveNode(scene Scene, node Node, owner component, em float) {
		let slot = node.motionSlot
		// Most nodes have a style with neither: that is found out once.
		return when slot == motionless
		let look = owner.style
		if slot < 0 {
			if look.enter is none && look.exit is none && !changes(look) {
				node.motionSlot = motionless
				return
			}
			slot = scene.moving.len()
			scene.moving.push(new Moving(node))
			node.motionSlot = slot
		}
		let state = scene.moving[slot]
		state.frame = scene.frame
		let how = Transition{}
		how = look.transition when look is Moved
		let now = motionNow(scene)
		let wanted = node.box.visible && !owner.isLeaving
		// What its style gives it now, before a motion draws anything else.
		let aim ?Drawn = none
		aim = drawnOf(node) when changes(look)
		if wanted && !state.shown {
			let (part, _) = progress(state, now - state.start)
			let back = state.kind == MotionKind.Exit
			let from = back ?? (look.exit, look.enter)
			if back && state.told {
				// It is in the tree again: its component hears so.
				reattach(node)
				state.told = false
			}
			node.exiting = false
			state.kind = MotionKind.Still
			if !(from is none) {
				// Called back while it went, it returns from as far as it had gone.
				let since = now
				since = now - how.duration * (1.0 - part) when back && how.duration > 0s
				startMotion(state, MotionKind.Enter, owner, from, how, em, since)
			}
		} else if !wanted && state.shown {
			let to = look.exit
			state.kind = MotionKind.Still
			if !(to is none) {
				startMotion(state, MotionKind.Exit, owner, to, how, em, now)
				node.exiting = true
				// What goes is gone for the program at once; the focus leaves it when
				// the frame is laid out (`leaveHidden`), for where it came from.
				if owner.isLeaving && !state.told {
					detach(node)
					state.told = true
				}
			}
		}
		state.shown = wanted
		if !(aim is none) && (state.kind == MotionKind.Still || state.kind == MotionKind.Change) {
			followChange(scene, state, node, aim, how, now)
			return when state.kind == MotionKind.Change
		} else if !(aim is none) {
			// An enter or an exit draws it: a change counts from where it lands.
			state.target = aim
		}
		// A child its view dropped whose exit is over, or never began, is let go of.
		if state.kind == MotionKind.Still {
			letGo(scene, node, owner) when owner.isLeaving
			return
		}
		let (part, over) = progress(state, now - state.start)
		if over {
			let went = state.kind == MotionKind.Exit
			state.kind = MotionKind.Still
			if went {
				node.exiting = false
				letGo(scene, node, owner) when owner.isLeaving
			}
			return
		}
		// A motion under way: the frame shows the next step of it.
		wakeBy(now)
		scene.changes += 1
		let (decoration, other) = (node.decoration, state.ghost.decoration)
		node.box.visible = true when state.kind == MotionKind.Exit
		return when decoration is none || other is none
		let (from, to, along) = state.kind == MotionKind.Enter ?? ((other, decoration, part), (decoration, other, part))
		let opacity = from.opacity + (to.opacity - from.opacity) * along
		// What moves the component jumps under reduced motion; a fade stays.
		let turned = scene.reduceMotion ?? (decoration.transform, between(from.transform, to.transform, along))
		decoration.opacity = opacity
		decoration.transform = turned
	}

	// Whether a change of the style's look travels: its `transition` takes time.
	def changes(look style) bool {
		return false unless look is Moved
		let how = look.transition
		return how.duration > 0s || how.easing is Spring
	}

	// Follows a change of the look of `node`, whose style just gave it `aim`: when that
	// differs from what it gave last, the drawn values travel from where they are to it
	// (from where an earlier change had taken them, when one was under way). The first
	// look a node gets is drawn at once.
	def followChange(scene Scene, state Moving, node Node, aim Drawn, how Transition, now time.Time) {
		let last = state.target
		if last is none {
			state.target = aim
			return
		}
		if !sameDrawn(last, aim) {
			state.from = state.kind == MotionKind.Change ?? (state.drawn, last)
			state.target = aim
			timeMotion(state, how)
			state.kind = MotionKind.Change
			state.start = now
		}
		return when state.kind != MotionKind.Change
		let (part, over) = progress(state, now - state.start)
		if over {
			state.kind = MotionKind.Still
			return
		}
		let shown = blendDrawn(state.from, aim, part, scene.reduceMotion)
		applyDrawn(node, shown)
		state.drawn = shown
		wakeBy(now)
		scene.changes += 1
	}

	// The values of `node` a change moves through, as its style gave them.
	def drawnOf(node Node) Drawn {
		let box = node.box
		let d = Drawn{width: box.width, height: box.height, margin: box.margin, padding: box.padding}
		let decoration = node.decoration
		return d when decoration is none
		d.opacity = decoration.opacity
		d.transform = decoration.transform
		d.radius = decoration.radius
		d.shadows = decoration.shadows
		let layers = decoration.background.layers
		if layers.len() == 1 {
			let only = layers[0]
			d.background = only when only is Color
		}
		let b = decoration.border
		for let side in [b.top, b.right, b.bottom, b.left] {
			let paint = side.paint
			if !(paint is Color) {
				d.borders = []
				break
			}
			d.borders.push(paint)
		}
		return d
	}

	// Whether two sets of values are the same, value by value: a style writes new
	// objects for the same values on every frame a state holds.
	def sameDrawn(a Drawn, b Drawn) bool {
		return false unless a.opacity == b.opacity && sameTransform(a.transform, b.transform) && sameCorners(a.radius, b.radius)
		return false unless sameEdges(a.margin, b.margin) && sameEdges(a.padding, b.padding) && sameSizing(a.width, b.width) && sameSizing(a.height, b.height)
		let (x, y) = (a.background, b.background)
		return false unless (x is none) == (y is none)
		return false unless x is none || y is none || x == y
		return false unless a.borders.len() == b.borders.len() && a.shadows.len() == b.shadows.len()
		for let (i, c) in a.borders {
			return false unless c == b.borders[i]
		}
		for let (i, shade) in a.shadows {
			return false unless sameShadow(shade, b.shadows[i])
		}
		return true
	}

	def sameExtent(a Extent, b Extent) bool {
		return isNone(a) && isNone(b) || (a is Pixels && b is Pixels && float(a) == float(b)) || (a is Percent && b is Percent && float(a) == float(b)) || (a is FontRelative && b is FontRelative && float(a) == float(b)) || (a is ViewportHeight && b is ViewportHeight && float(a) == float(b)) || (a is ViewportWidth && b is ViewportWidth && float(a) == float(b)) || (a is Length && b is Length && float(a) == float(b))
	}

	// The distance a size is; none for `auto` and `fill`.
	def extentOf(size Sizing) ?Extent {
		match size {
			case Auto:
				return none
			case Fill:
				return none
			default:
				let at Extent = size
				return at
		}
		return none
	}

	def sameSizing(a Sizing, b Sizing) bool {
		let (x, y) = (extentOf(a), extentOf(b))
		return !(y is none) && sameExtent(x, y) unless x is none
		return false unless y is none
		return true when a is Auto && b is Auto
		return a is Fill && b is Fill && a.weight == b.weight
	}

	def sameEdges(a Edges<Extent>, b Edges<Extent>) bool {
		return sameExtent(a.top, b.top) && sameExtent(a.right, b.right) && sameExtent(a.bottom, b.bottom) && sameExtent(a.left, b.left)
	}

	def sameCorners(a Corners<Extent>, b Corners<Extent>) bool {
		return sameExtent(a.topLeft, b.topLeft) && sameExtent(a.topRight, b.topRight) && sameExtent(a.bottomRight, b.bottomRight) && sameExtent(a.bottomLeft, b.bottomLeft)
	}

	def sameTransform(a Transform, b Transform) bool {
		return a == b || (sameExtent(a.translate.x, b.translate.x) && sameExtent(a.translate.y, b.translate.y) && a.scale.x == b.scale.x && a.scale.y == b.scale.y && float(a.rotate) == float(b.rotate) && float(a.skew.x) == float(b.skew.x) && float(a.skew.y) == float(b.skew.y) && a.origin.x == b.origin.x && a.origin.y == b.origin.y && a.matrix is none && b.matrix is none)
	}

	def sameShadow(a Shadow, b Shadow) bool {
		return a.offset.x == b.offset.x && a.offset.y == b.offset.y && float(a.blur) == float(b.blur) && float(a.spread) == float(b.spread) && a.color == b.color && a.knockout == b.knockout when a is canvas.DropShadow && b is canvas.DropShadow
		let (x, y) = (a, b)
		return x == y
	}

	// The values part of the way from `from` to `to`: numbers and distances of one unit
	// in between, colours through OKLab, a drop shadow field by field; what cannot be
	// in between is `to`'s from the start. Under reduced motion what moves or resizes
	// the component is `to`'s at once, fades and colours keep their time.
	def blendDrawn(from Drawn, to Drawn, part float, reduced bool) Drawn {
		let d = Drawn{opacity: from.opacity + (to.opacity - from.opacity) * part}
		let moves = reduced ?? (1.0, part)
		d.transform = reduced ?? (to.transform, between(from.transform, to.transform, part))
		d.radius = new Corners<Extent>(between(from.radius.topLeft, to.radius.topLeft, part), between(from.radius.topRight, to.radius.topRight, part), between(from.radius.bottomRight, to.radius.bottomRight, part), between(from.radius.bottomLeft, to.radius.bottomLeft, part))
		let (x, y) = (from.background, to.background)
		d.background = y
		d.background = x.mixOklab(y, part) when !(x is none) && !(y is none)
		d.borders = to.borders
		if from.borders.len() == to.borders.len() {
			d.borders = []
			for let (i, c) in from.borders {
				d.borders.push(c.mixOklab(to.borders[i], part))
			}
		}
		d.shadows = to.shadows
		if from.shadows.len() == to.shadows.len() {
			let mixed Shadow[]
			for let (i, a) in from.shadows {
				let b = to.shadows[i]
				if a is canvas.DropShadow && b is canvas.DropShadow {
					mixed.push(canvas.DropShadow{offset: a.offset.lerp(b.offset, moves), blur: (float(a.blur) + (float(b.blur) - float(a.blur)) * part) * 1(px), spread: (float(a.spread) + (float(b.spread) - float(a.spread)) * moves) * 1(px), color: a.color.mixOklab(b.color, part), knockout: b.knockout})
				} else {
					mixed.push(b)
				}
			}
			d.shadows = mixed
		}
		d.width = betweenSizing(from.width, to.width, moves)
		d.height = betweenSizing(from.height, to.height, moves)
		d.margin = betweenEdges(from.margin, to.margin, moves)
		d.padding = betweenEdges(from.padding, to.padding, moves)
		return d
	}

	def betweenSizing(from Sizing, to Sizing, part float) Sizing {
		let (x, y) = (extentOf(from), extentOf(to))
		return to when x is none || y is none
		let at Sizing = between(x, y, part)
		return at
	}

	def betweenEdges(from Edges<Extent>, to Edges<Extent>, part float) Edges<Extent> {
		return new Edges<Extent>(between(from.top, to.top, part), between(from.right, to.right, part), between(from.bottom, to.bottom, part), between(from.left, to.left, part))
	}

	// Draws `node` with the values: its box for layout, its decoration for the renderer.
	// New values are given, never written into the ones a style holds.
	def applyDrawn(node Node, d Drawn) {
		let box = node.box
		box.width = d.width
		box.height = d.height
		box.margin = d.margin
		box.padding = d.padding
		let decoration = node.decoration
		return when decoration is none
		decoration.opacity = d.opacity
		decoration.transform = d.transform
		decoration.radius = d.radius
		decoration.shadows = d.shadows
		let colour = d.background
		decoration.background = new BackgroundFill([colour], decoration.background.area) unless colour is none
		if d.borders.len() == 4 {
			let b = decoration.border
			let side = def (was Border, paint Color) Border {
				return Border{width: was.width, paint: paint, lineStyle: was.lineStyle}
			}
			decoration.border = new Edges<Border>(side(b.top, d.borders[0]), side(b.right, d.borders[1]), side(b.bottom, d.borders[2]), side(b.left, d.borders[3]))
		}
	}

	// Lets go of a child its view dropped: its component is told `detached` when its exit
	// did not tell it, its parent unmounts it, and its node, no longer shown, leaves the
	// tree with the next pass.
	def letGo(scene Scene, node Node, owner component) {
		let above = owner.parent()
		return when above is none || node.motionSlot < 0
		let state = scene.moving[node.motionSlot]
		detach(node) unless state.told
		state.told = true
		node.exiting = true
		node.box.visible = false
		above.finishLeaving(owner)
		scene.touched = true
		wakeBy(motionNow(scene))
	}

	// Tells the component of `node` and those under it that they are in the tree again.
	def reattach(node Node) {
		let owner = node.owner
		attachOwner(owner) unless owner is none
		for let child in node.children {
			reattach(child)
		}
	}

	// Forgets the motions of nodes that left the tree: those the pass that just ended
	// did not meet.
	def settleMotions(scene Scene) {
		let all = scene.moving
		let stale = false
		for let state in all {
			stale = true when state.frame != scene.frame
		}
		return when !stale
		let kept Moving[]
		for let state in all {
			if state.frame != scene.frame {
				state.node.motionSlot = -1
				continue
			}
			state.node.motionSlot = kept.len()
			kept.push(state)
		}
		scene.moving = kept
	}
}
