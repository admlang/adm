internal partial module std.ui.runtime {
	use (
		std.gfx.color::(Color, RGBA)
		std.math.geom::Size
		std.testing
		std.time
		std.ui.styles::*
		std.units::Pixels
	)

	// A look that changes with the pointer over it, and a transition to travel by.
	style Glow {
		Box
		Compositing
		Background
		Transforms
		Motion
		on = {hover: {opacity: 0.5}}
	}

	component Glowing {
		style Glow
		view Nothing
		type {
			def new() {
				style.width = 40(px)
				style.height = 20(px)
				style.transition = Transition{duration: 100ms, easing: Ease.Linear}
				style.background = new BackgroundFill(new Color(RGBA{r: 0, g: 0, b: 0, a: 255}))
			}
		}
	}

	check "Motion" {
		// A change of look, by a state or a write to the style, travels for the
		// style's `transition`: from where it is drawn to where the style now puts it,
		// back from part of the way when it changes again; a colour passes through
		// OKLab; a size moves through layout. The first look is drawn at once.
		@test()
		def TestChangesOfLookTravel() {
			let glowing = Glowing()
			let scene = new Scene(glowing)
			let size = new Size<Pixels>(200(px), 100(px))
			let t0 = time.now()
			let at = def (since duration) {
				scene.clock = t0 + since
				scene.arrange(size)
			}
			let opacity = def () float {
				let decoration = scene.tree.decoration
				return decoration is none ?? (-1.0, decoration.opacity)
			}
			at(0ms)
			assert opacity() == 1.0
			glowing.isHover = true
			at(0ms)
			assert opacity() == 1.0
			at(50ms)
			assert (opacity() - 0.75).abs() < 1e-6
			at(100ms)
			assert opacity() == 0.5
			// What is drawn on the way is the renderer's alone: the style keeps its value
			// and the state's look holds the target all along.
			let own = glowing.style
			assert own.opacity == 1.0 && glowing.style.opacity == 0.5
			at(150ms)
			assert opacity() == 0.5
			glowing.isHover = false
			at(150ms)
			at(200ms)
			assert (opacity() - 0.75).abs() < 1e-6
			// Changed again half way: back from where it was drawn.
			glowing.isHover = true
			at(200ms)
			at(250ms)
			assert (opacity() - 0.625).abs() < 1e-6
			at(400ms)
			assert opacity() == 0.5

			let black = new Color(RGBA{r: 0, g: 0, b: 0, a: 255})
			let white = new Color(RGBA{r: 255, g: 255, b: 255, a: 255})
			glowing.style.background = new BackgroundFill(white)
			at(500ms)
			at(550ms)
			let decoration = scene.tree.decoration
			assert !(decoration is none)
			if !(decoration is none) {
				let painted = decoration.background.layers[0]
				assert painted is Color && painted == black.mixOklab(white, 0.5)
			}

			glowing.style.width = 80(px)
			at(700ms)
			at(750ms)
			assert float(glowing.style.geom.frame.width) == 60.0
			at(800ms)
			assert float(glowing.style.geom.frame.width) == 80.0
		}

		// Under reduced motion what moves the component goes there at once; a fade
		// keeps its time.
		@test()
		def TestReducedMotionMovesAtOnce() {
			let glowing = Glowing()
			let scene = new Scene(glowing)
			scene.reduceMotion = true
			let size = new Size<Pixels>(200(px), 100(px))
			let t0 = time.now()
			let at = def (since duration) {
				scene.clock = t0 + since
				scene.arrange(size)
			}
			at(0ms)
			glowing.style.transform = Transform{translate: Offset{x: 10(px)}}
			glowing.style.opacity = 0.0
			at(10ms)
			at(60ms)
			let decoration = scene.tree.decoration
			assert !(decoration is none)
			if !(decoration is none) {
				let moved = decoration.transform.translate.x
				assert moved is Pixels && float(moved) == 10.0 && (decoration.opacity - 0.5).abs() < 1e-6
			}
		}
	}
}
