internal partial module std.ui.runtime {
	use (
		std.math.geom::(Rect, Size)
		std.os
		std.services.storage::(Storage)
		std.testing
		std.ui.frames
		std.ui.styles::Box
		std.units::Pixels
	)

	let opensHeard = 0

	// Hears every file the Storage service opens.
	component Hearing {
		style {
			Box
		}

		type {
			@on(Storage.fileOpened)
			def opened(evt Event<string>) {
				opensHeard++
			}
		}

		view {}
	}

	// Shows the hearing component, or not.
	component HearingHost {
		style {
			Box
		}

		type {
			@state
			shown bool = true
		}

		view {
			if shown {
				Hearing()
			}
		}
	}

	check "Observers" {
		// A component's `@on` handlers run while it is in a tree: not before
		// it is attached, not after it left, again when it is back.
		@test()
		def TestHandlersRunOnlyWhileAttached() !none {
			let open = def () !none {
				let file = try os.tempFile("adm-observers-")
				let path = file.path()
				try file.close()
				os.remove(path) onerror recover none
				return none
			}
			opensHeard = 0
			let host = HearingHost()
			try open()
			assert opensHeard == 0
			let scene = new Scene(host)
			let size = new Size<Pixels>(100(px), 100(px))
			scene.arrange(size)
			scene.arrange(size)
			try open()
			assert opensHeard == 1
			host.shown = false
			scene.arrange(size)
			scene.arrange(size)
			try open()
			assert opensHeard == 1
			host.shown = true
			scene.arrange(size)
			scene.arrange(size)
			try open()
			assert opensHeard == 2
			scene.close()
			return none
		}

		// `redraw(rect)` from outside a frame marks no view, its own or the one that
		// places it: the frame it asks for draws, and nothing else runs again.
		@test()
		def TestAPartAsksForADrawingAlone() !none {
			let host = HearingHost()
			let scene = new Scene(host)
			let size = new Size<Pixels>(100(px), 100(px))
			scene.arrange(size)
			scene.arrange(size)
			assert scene.quiet()
			let child = host.children[0]
			child.redraw(Rect<Pixels>{left: 0(px), top: 0(px), right: 4(px), bottom: 4(px)})
			assert !child.needsBuild && !child.isStale && !host.needsBuild && !host.staleBelow
			scene.arrange(size)
			assert !scene.quiet()
			// Once a drawing took the part the window rests again.
			assert !(frames.redrawPartOf(child) is none)
			scene.arrange(size)
			assert scene.quiet()
			scene.close()
			return none
		}

		// A component that asked for part of it to be drawn again and left the tree
		// before the drawing is not kept for that part.
		@test()
		def TestAPartLeavesWithItsComponent() !none {
			let host = HearingHost()
			let scene = new Scene(host)
			let size = new Size<Pixels>(100(px), 100(px))
			scene.arrange(size)
			scene.arrange(size)
			let child = host.children[0]
			let part = Rect<Pixels>{left: 0(px), top: 0(px), right: 4(px), bottom: 4(px)}
			child.redraw(part)
			host.shown = false
			scene.arrange(size)
			scene.arrange(size)
			assert frames.redrawPartOf(child) is none
			// One still in the tree keeps its part until it is drawn.
			host.redraw(part)
			scene.arrange(size)
			assert !(frames.redrawPartOf(host) is none)
			scene.close()
			return none
		}
	}
}
