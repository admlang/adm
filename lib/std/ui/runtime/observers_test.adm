internal partial module std.ui.runtime {
	use (
		std.math.geom::Size
		std.os
		std.services.storage::(Storage)
		std.testing
		std.ui.styles::Box
		std.units::Pixels
	)

	let opensHeard = 0

	// Hears every file the Storage service opens.
	component Hearing {
		style {
			Box
		}

		type {
			@on(Storage.fileOpened)
			def opened(evt Event<string>) {
				opensHeard++
			}
		}

		view {}
	}

	// Shows the hearing component, or not.
	component HearingHost {
		style {
			Box
		}

		type {
			@state
			shown bool = true
		}

		view {
			if shown {
				Hearing()
			}
		}
	}

	check "Observers" {
		// A component's `@on` handlers run while it is in a tree: not before
		// it is attached, not after it left, again when it is back.
		@test()
		def TestHandlersRunOnlyWhileAttached() !none {
			let open = def () !none {
				let file = try os.tempFile("adm-observers-")
				let path = file.path()
				try file.close()
				os.remove(path) onerror recover none
				return none
			}
			opensHeard = 0
			let host = HearingHost()
			try open()
			assert opensHeard == 0
			let scene = new Scene(host)
			let size = new Size<Pixels>(100(px), 100(px))
			scene.arrange(size)
			scene.arrange(size)
			try open()
			assert opensHeard == 1
			host.shown = false
			scene.arrange(size)
			scene.arrange(size)
			try open()
			assert opensHeard == 1
			host.shown = true
			scene.arrange(size)
			scene.arrange(size)
			try open()
			assert opensHeard == 2
			scene.close()
			return none
		}
	}
}
