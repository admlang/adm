// What the UI keeps between runs: the `@persist(key)` fields of components and the
// placement of windows opened with `WindowConfig.persist`. Each is a value of the
// application's vault (`std.services.vault`), named `ui.persist.<key>`.
internal partial module std.ui.runtime {
	use (
		std.services.vault::Vault
		std.time
	)

	// Under which every kept value is named in the vault.
	const keptPrefix = "ui.persist."

	// How long a changed value waits for another change before it is written: a
	// divider being dragged writes the vault once, when it rests.
	const keepDelay = 500ms

	// Whether a value can be kept under `key`: what the vault takes as a name, with the
	// prefix before it.
	def keepable(key string) bool {
		return false when key.len() == 0 || key.len() + keptPrefix.len() > 255
		for let c in key {
			continue when c.isLetter() || c.isDigit() || c == '.' || c == '_' || c == '-'
			return false
		}
		return true
	}

	// The values that changed and are not written yet.
	type KeptValues {
		// What writes each one, by key, and the keys in the order they first changed.
		writes  map<string, def () !none>
		order   string[]
		// When the last of them changed.
		touched ?time.Time                = none
		// The vault was asked to open, and whether it did.
		asked   bool
		open    bool
	}

	let keeper = new KeptValues()

	// Whether the vault is open, opening it on first use. A vault that cannot be opened
	// (no home folder, a file from another machine) is not asked again: nothing is kept
	// and nothing is restored in this run.
	def keptOpen() bool {
		return keeper.open when keeper.asked
		keeper.asked = true
		keeper.open = true
		await Vault.start() onerror (err error) {
			keeper.open = false
			recover none
		}
		return keeper.open
	}

	// What is stored for a key: the value in a struct, so that a kept `none` (an optional
	// field that was cleared) reads back as a value that is there.
	struct Kept<T> {
		value T
	}

	// The value kept under `key`, `fallback` when there is none. A value that does not
	// read as `T` (it was kept by a version with another type for it) is removed.
	//
	// A field marked `@persist(key)` starts with `restored(key, <its default>)`.
	def restored<T>(key string, fallback T) T {
		return fallback unless keptOpen()
		// A change of it that is still waiting is what was kept.
		writeKept() when keeper.writes.hasKey(key)
		let found = Vault.load<Kept<T>>(keptPrefix + key) onerror (err error) {
			Vault.remove(keptPrefix + key) onerror recover none
			recover none
		}
		return fallback when found is none
		return found.value
	}

	// Keeps `value` under `key`: written to the vault once no kept value changed for
	// `keepDelay`, and when a window closes or the UI stops.
	//
	// An assignment that changes a field marked `@persist(key)` calls it.
	def keep<T>(key string, value T) {
		keeper.order.push(key) unless keeper.writes.hasKey(key)
		keeper.writes = keeper.writes.set(key, def () !none {
			return try Vault.store<Kept<T>>(keptPrefix + key, Kept<T>{value: value})
		})
		let now = time.now()
		keeper.touched = now
		wakeBy(now + keepDelay)
	}

	// Writes the waiting values when they have rested for `keepDelay` at `now`; else asks
	// for a pass of the UI loop when they will have.
	def writeKeptDue(now time.Time) {
		let touched = keeper.touched
		return when touched is none
		if now - touched >= keepDelay {
			writeKept()
			return
		}
		wakeBy(touched + keepDelay)
	}

	// Writes every waiting value now. One that cannot be written (the vault did not open,
	// the disk is full, the type does not cross a process link) is given up.
	def writeKept() {
		let order = keeper.order
		let writes = keeper.writes
		let nothing map<string, def () !none>
		keeper.order = []
		keeper.writes = nothing
		keeper.touched = none
		return unless keptOpen()
		for let key in order {
			let write = writes.get(key)
			continue when write is none
			write() onerror recover none
		}
	}

	// Forgets the value kept under `key`.
	def forget(key string) {
		keeper.writes = keeper.writes.delete(key) when keeper.writes.hasKey(key)
		return unless keptOpen()
		Vault.remove(keptPrefix + key) onerror recover none
	}
}
