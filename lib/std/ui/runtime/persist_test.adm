internal partial module std.ui.runtime {
	use (
		std.services.vault::(Vault, VaultConfig)
		std.testing
		std.ui.styles::*
	)

	struct KeptPane {
		name  string
		share float
	}

	style KeptLook {
		Box
	}

	component Remembering {
		style KeptLook
		view {}

		type {
			@persist("test.width")
			width int = 240

			@persist("test.panes")
			panes KeptPane[] = []

			@state
			@persist("test.note")
			note ?string = none

			@persist("test.pick")
			pick ?string = "home"

			@input
			@persist("test.title")
			title string = "untitled"
		}
	}

	// A controller declared apart: its `@persist` field is the field of each component
	// that names it.
	@controller()
	type Counting {
		@state
		@persist("test.count")
		count int = 0

		def bump() {
			count = count + 1
		}
	}

	component Counter {
		style KeptLook
		view {}
		type Counting
	}

	check "Persist" {
		// A `@persist` field of a `@controller()` type is kept for the component that
		// names the type, an assignment in the controller's own method included.
		@test()
		def TestPersistInAControllerDeclaredApart() !none {
			Vault.config(VaultConfig{memoryKiB: 64, passes: 1}) onerror recover none
			forget("test.count")
			let first = Counter()
			assert first.count == 0
			first.bump()
			first.count = first.count + 1
			assert keeper.order.join(",") == "test.count"
			assert Counter().count == 2
		}

		// A `@persist` field starts with its default, an assignment that changes it is
		// kept, and the next component made starts with what was kept: before the value
		// is written and after.
		@test()
		def TestPersistFieldsAreKeptAndRestored() !none {
			Vault.config(VaultConfig{memoryKiB: 64, passes: 1}) onerror recover none
			for let key in ["test.width", "test.panes", "test.note", "test.title", "test.pick"] {
				forget(key)
			}
			let first = Remembering()
			assert first.width == 240 && first.panes.len() == 0 && first.note is none && first.title == "untitled"
			first.width = 300
			first.panes = [KeptPane{name: "files", share: 0.25}, KeptPane{name: "editor", share: 0.75}]
			first.note = "seen"
			// An optional that was cleared is kept cleared, not given its default again.
			first.pick = none
			assert keeper.order.join(",") == "test.width,test.panes,test.note,test.pick"

			let second = Remembering()
			assert second.width == 300 && second.panes.len() == 2 && second.panes[1].name == "editor" && second.panes[1].share == 0.75
			let note = second.note
			assert !(note is none) && note == "seen"
			assert second.pick is none
			// Making it wrote what was waiting.
			assert keeper.order.len() == 0
			assert try Vault.has("ui.persist.test.width")
		}

		// A value that did not change keeps nothing; one that did is written when it has
		// rested, not before.
		@test()
		def TestPersistWritesWhenTheValueRests() !none {
			Vault.config(VaultConfig{memoryKiB: 64, passes: 1}) onerror recover none
			forget("test.width")
			let shown = Remembering()
			shown.width = 240
			assert keeper.order.len() == 0 && keeper.touched is none
			shown.width = 310
			let touched = keeper.touched
			fail "the change is not waiting" when touched is none
			writeKeptDue(touched + keepDelay - 1ms)
			assert keeper.order.len() == 1
			assert !(try Vault.has("ui.persist.test.width"))
			writeKeptDue(touched + keepDelay)
			assert keeper.order.len() == 0 && keeper.touched is none
			assert try Vault.has("ui.persist.test.width")
			assert Remembering().width == 310
		}

		// An input the call passes is what the field starts with, kept value or not, and
		// a kept value that no longer reads as the field's type is removed.
		@test()
		def TestPersistLeavesInputsAndDropsOtherTypes() !none {
			Vault.config(VaultConfig{memoryKiB: 64, passes: 1}) onerror recover none
			forget("test.width")
			forget("test.title")
			let first = Remembering()
			first.title = "kept"
			writeKept()
			assert Remembering().title == "kept"
			assert Remembering(title = "passed").title == "passed"

			assert keptOpen()
			try Vault.store("ui.persist.test.width", "wide")
			assert Remembering().width == 240
			assert !(try Vault.has("ui.persist.test.width"))
		}
	}
}
