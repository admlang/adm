internal partial module std.ui.runtime {
	use (
		std.math.geom::Size
		std.services.vault::(Vault, VaultConfig)
		std.services.vault.kept::(forget, restored)
		std.testing
		std.ui.components::PersistScope
		std.ui.styles::*
		std.units::Pixels
	)

	// Keeps a width of its own and, through a controller declared apart, a count.
	component ScopedPane {
		style {
			Box
		}

		type {
			@persist("scoped.width")
			width int = 100
		}

		view {}
	}

	@controller()
	type ScopedCounting {
		@persist("scoped.count")
		count int = 0

		def bump() {
			count = count + 1
		}
	}

	component ScopedCounter {
		style {
			Box
		}

		type ScopedCounting

		view {}
	}

	// Two panes in two scopes, one in a scope inside another, one outside any.
	component ScopedPanes {
		style {
			Box
		}

		type {}

		view {
			PersistScope("left") {
				ScopedPane(ref = left)
				ScopedCounter(ref = counter)
			}
			PersistScope("right") {
				PersistScope("inner") {
					ScopedPane(ref = inner)
				}
			}
			ScopedPane(ref = plain)
		}
	}

	check "PersistScope" {
		// A kept field of a component under a scope is kept under the scope's name, a
		// scope inside another under both; one outside any scope keeps its key as
		// written. What is kept is restored for the component made in the same place.
		@test()
		def TestKeysInsideScopes() {
			Vault.config(VaultConfig{memoryKiB: 64, passes: 1}) onerror recover none
			for let key in ["left.scoped.width", "right.inner.scoped.width", "scoped.width", "left.scoped.count", "scoped.count"] {
				forget(key)
			}
			let panes = ScopedPanes()
			let scene = new Scene(panes)
			let size = new Size<Pixels>(200(px), 100(px))
			scene.arrange(size)
			let left = panes.find<ScopedPane>("left")
			let inner = panes.find<ScopedPane>("inner")
			let plain = panes.find<ScopedPane>("plain")
			let counter = panes.find<ScopedCounter>("counter")
			assert !(left is none) && !(inner is none) && !(plain is none) && !(counter is none)
			left.width = 1 unless left is none
			inner.width = 2 unless inner is none
			plain.width = 3 unless plain is none
			counter.bump() unless counter is none
			assert restored<int>("left.scoped.width", 0) == 1
			assert restored<int>("right.inner.scoped.width", 0) == 2
			assert restored<int>("scoped.width", 0) == 3
			assert restored<int>("left.scoped.count", 0) == 1 && restored<int>("scoped.count", 0) == 0

			let again = ScopedPanes()
			let next = new Scene(again)
			next.arrange(size)
			let back = again.find<ScopedPane>("left")
			let deep = again.find<ScopedPane>("inner")
			let alone = again.find<ScopedPane>("plain")
			let counted = again.find<ScopedCounter>("counter")
			assert back.width == 1 unless back is none
			assert deep.width == 2 unless deep is none
			assert alone.width == 3 unless alone is none
			assert counted.count == 1 unless counted is none
			// Made outside a view, a component keeps its key as written.
			assert ScopedPane().width == 3
		}
	}
}
