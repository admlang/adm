// The view runtime: mirrors a mounted component tree as layout nodes, fills them from the
// components' styles, lays them out, draws them and finds the component under a point.
internal partial module std.ui.runtime {
	use (
		std.gfx.canvas
		std.math.geom::(Point, Size)
		std.time
		std.ui.frames
		std.ui::(DragData, DropEffect, Key, KeyEvent, Limit, Modifiers, MouseButton, Orientation, PointerPhase, SizeClass, StyleRule, StyleSheet, Theme, UI, Viewport)
		std.ui.layout::Node
		std.ui.paint
		std.ui.platform::hotGeneration
		std.ui.styles::*
		std.units::Pixels
	)

	// One mounted component tree and the nodes that mirror it. Each frame: `arrange` reads
	// every component's style and lays the tree out, `paint` draws it.
	type Scene {
		root            component
		// The node of `root`; a component's node has the nodes of its `children` under it,
		// in order.
		tree            Node
		shadows         paint.ShadowCache
		// What a component's `render` records its own drawing in, in the component's own
		// logical pixels; its size is the window's.
		draw            canvas.DrawContext
		// The nodes the pointer is over, the topmost first; the node a button went down on;
		// the node that captured the pointer; the node with the keyboard focus.
		over            Node[]
		pressed         ?Node              = none
		held            ?Node              = none
		focus           ?Node              = none
		// The nodes of the floating components shown in the last `arrange`, in tree order.
		floats          Node[]
		// Those of the `arrange` before: one not among them is new this frame.
		floated         Node[]
		// The modal on top as of the last `arrange`, and what had the focus before a modal
		// took it.
		modal           ?Node              = none
		focusBefore     ?Node              = none
		// What had the focus before it went into each floating component that took it.
		returns         FocusReturn[]
		// The theme the veil behind a modal comes from.
		look            ?Theme             = none
		// The nodes that start a layer, as the last `arrange` left the tree: the hit test
		// of each pointer event starts from them.
		layers          paint.LayerRoot[]
		// Whether the last pointer event changed anything a frame could show: the hover
		// set, a press, or a component took it.
		touched         bool
		// The modifier keys that are down, from the keys the scene was given.
		modifiers       Modifiers          = Modifiers{}
		// Whether the keyboard was used after the pointer last pressed: a focus a
		// component asks for then shows its ring.
		keyed           bool
		// The part of the window the last `repaint` drew, in device pixels.
		drawnPart       paint.DeviceBox    = paint.DeviceBox{}
		// The component something dragged over the window would be dropped on.
		dropOver        ?component         = none
		// The motions of the nodes whose style has an `enter` or an `exit`; the time they
		// read when it is not the clock's (a test's); whether what moves a component
		// happens at once (the desktop asks for less motion).
		moving          Moving[]
		clock           ?time.Time         = none
		reduceMotion    bool
		// What the components read as `viewport`: its size, size classes and orientation
		// are set by `arrange`, the rest by whoever owns the window. A window is
		// `Compact` on an axis below the first of its two widths (heights) and
		// `Expanded` from the second.
		viewport        Viewport           = Viewport{}
		widthClasses    (float, float)     = (600.0, 1000.0)
		heightClasses   (float, float)     = (480.0, 900.0)
		// Where the button went down, and the `DragSource` at or above what it went down
		// on, which a move away from there drags; none: no press that could drag.
		pressAt         Point<Pixels>      = new Point<Pixels>(0(px), 0(px))
		dragFrom        ?component         = none
		// The press a component that takes clicks follows.
		click           ClickPress         = new ClickPress()
		// The `DragSource` being dragged and what it carries; none: nothing is dragged.
		dragged         ?component         = none
		dragData        ?DragData          = none
		// Where the pointer was last while it was dragged.
		dragAt          Point<Pixels>      = new Point<Pixels>(0(px), 0(px))
		// What the zone with `dropTarget` would do with what is dragged.
		dropEffect      DropEffect         = DropEffect.None
		// The `@scoped` components in the tree: they have no node.
		scopes          ScopeEntry[]
		// Those of the frame before, while a frame's pass over the tree runs, and where in
		// them the pass looks first.
		scopesBefore    ScopeEntry[]
		scopeNext       int
		// Counts the calls of `arrange`.
		frame           int
		// What the components with a scoped child hold as layout sees it, whether each
		// is under a scoped component that is not enabled, and the theme a scoped component
		// above it provides: one run per component on the way down from the root, the
		// deepest last.
		unscoped        component[]
		unscopedBlocked bool[]
		unscopedTheme   Theme[]
		unscopedSheets  StyleSheet[][]
		unscopedMarks   int[]
		// The style sheets of every window (`UI.addStyles`), the first added first.
		styles          StyleSheet[]       = []
		// The pointer's shape over the component it is on, as the last pointer event left it.
		cursor          Cursor             = Cursor.Default
		// The tooltip, and how long the pointer rests on a component before it shows.
		tip             Tip                = new Tip()
		tipDelay        duration           = 500ms
		// What the last drawing left for one that draws only a part of the window.
		kept            paint.Retained     = new paint.Retained()
		// The window `arrange` laid out last.
		window          Size<Pixels>       = new Size<Pixels>(0(px), 0(px))
		// Whether a style in the tree takes values from other components (`$parent`, a ref),
		// and how many layouts in a row `settleFollowers` asked for and saw move something.
		// The theme's changes this scene has seen (`frames.themeVersion`), and whether the
		// layout under way gives every style what its body assigns from the theme again.
		themeSeen       int
		retheme         bool
		// The reloads of `adm run --hot` this scene has seen (`hotGeneration`), and
		// whether the layout under way gives every style what its new code makes.
		reloadSeen      int64
		restyle         bool
		// `UI.theme()` as the layout under way found it: what a style reads while no
		// component above its own provides another.
		theme           Theme
		follows         bool
		unsettled       int
		// Whether the frame under way was asked for by `settleFollowers` alone; the UI
		// service says so before it lays the window out.
		settling        bool
		// The requests for a frame that runs every view this scene has seen
		// (`frames.allVersion`), and the window's size, scale and state the last layout
		// was for: another one runs every view and brings every node in step (`whole`).
		allSeen         int
		portSeen        float[]            = []
		whole           bool
		// Whether the user acted since the last frame (`pointer`, `key`, `text`, `drop`): a
		// press, a release, a key, text, a drop, or a drag taken by a component given
		// handlers (`handedAbove`). What the handlers it reached
		// changed is not known (a model or a module's value the views read), so the next
		// frame runs every view.
		acting          bool
		// What the frame under way changed that its drawing shows: views run, nodes
		// brought in step, a layout, motions, the tooltip. None: the window shows what it
		// showed (`quiet`).
		changes         int
		// The components whose view reads one marked before the last layout
		// (`frames.follow`): marked at the start of the next frame.
		followUp        component[]

		def new(root component) {
			self.root = root
			shadows = new paint.ShadowCache()
			draw = new canvas.DrawContext()
			tree = mount(root)
			// The scene says what changed (`Node.layoutChanged`): layout reads only that.
			tree.tracked = true
			themeSeen = frames.themeVersion()
			reloadSeen = hotGeneration()
			theme = UI.theme()
		}

		// Runs the views again (`rerun` on the root), brings the nodes in step with the
		// components (a component new to the tree is told `attached`, one gone from it
		// `detached`), copies each component's style into its
		// node and lays the tree out in a window of that size. A component reads where it
		// was put as `style.geom`. Returns layout's warnings and those of the components.
		def arrange(window Size<Pixels>, direction Direction = Direction.LeftToRight, fontSize Pixels = 16(px)) string[] {
			self.window = window
			settleViewport(self)
			changes = 0
			let themes = frames.themeVersion()
			retheme = themes != themeSeen
			themeSeen = themes
			let reloads = hotGeneration()
			restyle = reloads != reloadSeen
			reloadSeen = reloads
			whole = retheme || restyle || wholeAsked(self, direction, fontSize)
			changes += 1 when whole
			// What asked from its `render` for a whole frame runs its view again, and so
			// does a view that reads a component marked before the last layout.
			for let asked in frames.takeRebuilds() {
				asked._mark()
			}
			frames.marksFollows(true)
			for let held in followUp {
				held._mark()
			}
			frames.marksFollows(false)
			followUp = []
			// The views of the components marked since the last frame run again; all of
			// them when the window, the theme or the code changed, the user acted, or
			// `UI.redraw()` asked.
			let views = whole || acting
			acting = false
			frames.frameRunning(true)
			changes += 1 when root.needsBuild || root.staleBelow
			frames.rebuildAll(true) when views
			root._rerunMarked()
			frames.rebuildAll(false) when views
			frames.frameRunning(false)
			floated = floats
			floats = Node[]
			let tipWas = tip.placed
			liftTip(self)
			beginScopes(self)
			follows = false
			theme = UI.theme()
			frames.frameWorks(true)
			let _ = syncTree(self, tree, root, float(fontSize), theme, none, styles, sheetsMark(0, styles))
			settleScopes(self)
			settleMotions(self)
			placeTip(self)
			if tip.placed != tipWas {
				// The root holds the tooltip's node or no longer does.
				tree.layoutChanged()
				changes += 1
			}
			if tip.placed {
				// Placed again each frame from what it shows and where.
				tip.node.restyled = true
				tip.node.layoutChanged()
			}
			let laid = tree.laidSerial
			let warnings = tree.arrange(window, direction, fontSize)
			let relaid = tree.laidSerial != laid || tree.relaidParts
			changes += 1 when relaid || tree.shifted
			frames.frameWorks(false)
			settleFollowers(self, warnings)
			layers = layersOf(self) when relaid || layers.len() == 0
			followModal(self)
			giveFocus(self)
			giveReveals(self)
			dragTick(self)
			heldLong(self)
			leaveHidden(self)
			runAfterwards()
			// The sizes the content took change only with a layout of the whole tree.
			reportScroll(tree) when relaid
			// The views that read a component marked before this layout run again in the
			// next frame, as do what the frame marked as it brought the nodes in step or
			// after layout (an `em` that changed, a scroller told its content's size).
			followUp = frames.takeFollows()
			frames.askFrame(true) when root.staleBelow || root.isStale || followUp.len() > 0
			warnings.push(...takeWarnings())
			return warnings
		}

		// Whether the last `arrange` changed nothing its drawing shows: no view ran, no
		// node was brought in step, nothing was laid out or moved. The window then shows
		// what it showed.
		def quiet() bool {
			return changes == 0
		}

		// Draws the tree as laid out last on `target` (a canvas or a renderer's frame), the
		// window in device pixels, `scale` of them per logical pixel. Each component is drawn by its `render`.
		def paint(target canvas.Painter, scale float = 1.0) {
			draw.resetWithSize(new Size(float(window.width), float(window.height)))
			frames.framePainting(true)
			drawTree(self, target, scale, none, none)
			frames.framePainting(false)
		}

		// After `paint`: what that drawing changed against the drawing of the whole window
		// before it (`paint.changedPart`): what of the frame before moved and the parts to
		// draw again, in device pixels; none when all of it is to be shown.
		def changed() ?paint.Change {
			return changedIn(self)
		}

		// The calls of a frame that shows only what `change` (from `changed`) says changed,
		// over the frame before, each part filled with `ground` first (`paint.partOf`).
		def partOf(change paint.Change, ground Paint) ?canvas.DrawContext {
			return partIn(self, change, ground)
		}

		// Whether a component that can show asked from its `render`, in the last drawing,
		// to be drawn again: a spinner that turns. One scrolled out of sight does not
		// count.
		def animating() bool {
			return kept.again.len() > 0 && animateIn(time.now(), 1s) <= 0s
		}

		// How long from `now` until a component that can show wants to be drawn again,
		// at most `longest`; `longest` when none asked.
		def animateIn(now time.Time, longest duration) duration {
			return longest when kept.again.len() == 0
			// Before the first drawing of the whole window the components that asked are
			// drawn with all of it.
			return 0s when kept.scale <= 0.0
			return waitIn(self, now, longest)
		}

		// Draws again the components that asked for it from their `render` in the last
		// drawing, and what shares their place in the window, on a `target` that still
		// holds that drawing: the part is filled with `ground` first. Nothing else runs,
		// no view, no style, no layout, so it is for a frame nothing else asked for.
		// False, with nothing drawn, when the part cannot be drawn alone: no component
		// asked, the window's size or `scale` is not that of the last `paint`, or the
		// window shows a filter or a backdrop.
		def repaint(target canvas.Painter, scale float, ground Paint) bool {
			let now = time.now()
			let part = damageIn(self, scale, now)
			return false when part is none
			drawnPart = part
			draw.resetWithSize(new Size(float(window.width), float(window.height)))
			frames.framePainting(true)
			drawTree(self, target, scale, part, ground, now)
			frames.framePainting(false)
			return true
		}

		// The component drawn topmost under `at`, a point of the window in logical pixels;
		// the root when no other component is there: the root stands for the window.
		def hit(at Point<Pixels>, scale float = 1.0) component {
			let found = nodeAt(self, at, scale)
			return root when found is none
			let owner = found.owner
			return root when owner is none
			return owner
		}

		// Whether the user drags the window by the point `at` (logical pixels): the
		// component drawn there is a `WindowGrip` or is held by one, with nothing between
		// them that takes the keyboard focus (a button in a title bar is pressed, the
		// title beside it drags).
		def dragsWindow(at Point<Pixels>) bool {
			let found = nodeAt(self, at, kept.scale > 0.0 ?? (kept.scale, 1.0))
			return false when found is none
			let under = found.owner
			for {
				return false when under is none
				return under.gripsWindow() when under is WindowGrip
				return false when under.takesFocus
				under = under.parent()
			}
		}

		// Something from another application is dragged over `at` (logical pixels): the
		// `DropTarget` there shows `dropTarget`. True when what shows changed.
		def dragOver(at Point<Pixels>) bool {
			return runtimeDragOver(self, at)
		}

		// What was dragged over the window left it. True when what shows changed.
		def dragLeave() bool {
			return dragLeft(self)
		}

		// `data` was dropped at `at`: the nearest `DropTarget` there that takes it gets
		// it. True when one did.
		def drop(at Point<Pixels>, data DragData) bool {
			acting = true
			return dropAt(self, at, data)
		}

		// Takes what a pointer did at `at`, a point of the window in logical pixels, and
		// returns the component under it: sets `hover` and `pressed`, moves the focus on a
		// press, and offers the event to that component's `pointer` and its ancestors'.
		// `clicks` is 2 for the second press of a double click, 3 for a triple one.
		def pointer(phase PointerPhase, at Point<Pixels>, button MouseButton = MouseButton.Left, scroll Point<Pixels> = new Point<Pixels>(0(px), 0(px)), scale float = 1.0, clicks int = 1) component {
			// A move while pressed counts when what took it was given handlers (`routePointer`);
			// a turn of the wheel scrolls, and a handler of it that changes more calls
			// `redraw()`.
			acting = true when phase == PointerPhase.Down || phase == PointerPhase.Up
			return routePointer(self, phase, at, button, scroll, scale, clicks)
		}

		// Offers a key to the focused component's `key` and its ancestors'; returns the
		// component it was for.
		def key(event KeyEvent) component {
			acting = true
			return routeKey(self, event)
		}

		// Takes the release of a key: it is offered like a key that went down, with
		// `down` false; returns the component it was for.
		def keyUp(key Key) component {
			acting = true
			return routeKey(self, KeyEvent{target: root, key: key, down: false})
		}

		// Takes the modifier keys the host says are held: what the scene made of the
		// keys it was given gives way to it (a key let go of while another window had
		// the keyboard).
		def hold(held Modifiers) {
			modifiers = Modifiers{shift: held.shift, control: held.control, alt: held.alt, command: held.command, mod: held.mod}
		}

		// Takes text the platform's input produced (a typed character, an input method's
		// result) for the focused component; false when that one does not edit text.
		def text(typed string) bool {
			acting = true
			return routeText(self, typed)
		}

		// The component with the keyboard focus; the root when none has it.
		def focused() component {
			let node = focus
			return root when node is none
			let owner = node.owner
			return root when owner is none
			return owner
		}

		// Calls off the drag of a `Draggable` under way. False when nothing is dragged.
		def cancelDrag() bool {
			return endDrag(self)
		}

		// Tells every component it is leaving the window.
		def close() {
			unmount(tree)
		}
	}

	// The part of the window the scene can draw alone at `now`: see `paint.damageOf`.
	def damageIn(scene Scene, scale float, now time.Time) ?paint.DeviceBox {
		return paint.damageOf(scene.kept, scene.window, scale, now)
	}

	// What the scene's last drawing changed: see `paint.changedPart`.
	def changedIn(scene Scene) ?paint.Change {
		return paint.changedPart(scene.kept)
	}

	// The calls of a frame showing what `change` says of the scene's last drawing: see
	// `paint.partOf`.
	def partIn(scene Scene, change paint.Change, ground Paint) ?canvas.DrawContext {
		return paint.partOf(scene.kept, change, ground)
	}

	// How long until a component of the scene wants to be drawn again: see `paint.waitOf`.
	def waitIn(scene Scene, now time.Time, longest duration) duration {
		return paint.waitOf(scene.kept, scene.window, scene.kept.scale, now, longest)
	}

	def drawTree(scene Scene, target canvas.Painter, scale float, part ?paint.DeviceBox, ground ?Paint, now ?time.Time = none) {
		// The veil is asked for only while a modal is shown.
		if scene.modal is none {
			paint.paint(target, scene.tree, scene.window, scale, scene.shadows, scene.draw, none, scene.kept, part, ground, now)
			return
		}
		let held = scene.look
		let look = UI.theme()
		look = held unless held is none
		scene.look = look
		paint.paint(target, scene.tree, scene.window, scale, scene.shadows, scene.draw, look.palette.scrim, scene.kept, part, ground, now)
	}

	// Whether the frame under way runs every view and brings every node in step: the
	// first one, `UI.redraw()` asked (`frames.askAll`), or the window's size, scale or
	// state, the reading direction or the font size are not those of the last one (what
	// a view reads as `viewport`). Notes what it saw for the next frame.
	def wholeAsked(scene Scene, direction Direction, fontSize Pixels) bool {
		let asked = frames.allVersion()
		let whole = asked != scene.allSeen
		scene.allSeen = asked
		let port = scene.viewport
		let last = scene.portSeen
		let now = [float(scene.window.width), float(scene.window.height), port.scale, port.active ?? (1.0, 0.0), port.fullscreen ?? (1.0, 0.0), float(int(direction)), float(fontSize)]
		let same = last.len() == now.len()
		if same {
			for let (i, value) in now {
				same = false when last[i] != value
			}
		}
		scene.portSeen = now unless same
		return whole || !same
	}

	// How many layouts in a row `settleFollowers` asks for by itself: two components that
	// take their size from each other never come to rest.
	const settleLimit = 8

	// After a layout: when a style of the tree reads other components and the layout moved
	// something, what that style read is a layout old, and the scene asks for one more.
	// `unsettled` counts the layouts of that chain alone: a frame drawn for another reason
	// (an event, a scroll, a motion) starts it again, so the layout after the last of those
	// is always asked for. Past the limit the scene stops asking and says so once.
	def settleFollowers(scene Scene, warnings string[]) {
		let own = scene.settling
		scene.settling = false
		return when !scene.follows
		scene.unsettled = 0 unless own
		if !scene.tree.moved() {
			scene.unsettled = 0
			return
		}
		scene.unsettled += 1
		if scene.unsettled <= settleLimit {
			frames.askSettle()
			return
		}
		warnings.push("styles that read another component (`$parent`, `$prev`, a ref) did not come to rest in {settleLimit} layouts: two components take their size from each other") when scene.unsettled == settleLimit + 1
	}

	// The nodes of the scene's tree that start a layer.
	def layersOf(scene Scene) paint.LayerRoot[] {
		return paint.layerRoots(scene.tree)
	}

	// From a component's `render`: asks for that component to be drawn again at `at`,
	// alone, as `redraw()` asks for the next frame the display shows. Something that
	// changes in steps (a spinner) asks for its next step, not for every frame. Each
	// component is drawn when its own time comes.
	def redrawBy(at time.Time) {
		frames.askFrame()
		paint.askedBy(at)
	}

	// When the windows are next drawn although nothing happened in them: what a std
	// component that changes with time alone (a blinking caret) asks for, and the
	// components that asked with the time each wants.
	type Waker {
		at   ?time.Time  = none
		dues time.Time[]
		whos component[]
	}

	let waker = new Waker()

	// Asks for a frame at `at`, or sooner when one was asked for before that. With `who`,
	// that component is marked then (`_mark`): what it shows changes with the time
	// (a caret's blink), which no store says. Without, the frame runs what the scene does
	// with time (tooltips, motions, long presses) and what is live.
	def wakeBy(at time.Time, who ?component = none) {
		if !(who is none) {
			let found = false
			for let (i, held) in waker.whos {
				continue unless held == who
				found = true
				waker.dues[i] = at when at < waker.dues[i]
			}
			if !found {
				waker.dues.push(at)
				waker.whos.push(who)
			}
		}
		let had = waker.at
		return when !(had is none) && had <= at
		waker.at = at
	}

	// How long from `now` until the frame asked for with `wakeBy`, at most `longest`.
	def wakeIn(now time.Time, longest duration) duration {
		let at = waker.at
		return longest when at is none
		let left = at - now
		return 0s when left <= 0s
		return longest when left > longest
		return left
	}

	// Whether a frame asked for with `wakeBy` is due at `now`; it is then no longer asked,
	// and the components that asked for it are marked.
	def wakeDue(now time.Time) bool {
		let at = waker.at
		return false when at is none || at > now
		waker.at = none
		return true when waker.whos.len() == 0
		let (dues, whos) = (waker.dues, waker.whos)
		waker.dues = []
		waker.whos = []
		for let (i, who) in whos {
			if dues[i] <= now {
				who._mark()
			} else {
				wakeBy(dues[i], who)
			}
		}
		return true
	}

	def nodeAt(scene Scene, at Point<Pixels>, scale float) ?Node {
		return paint.hit(scene.tree, at, scene.window, scale) when scene.layers.len() == 0
		return paint.hit(scene.tree, at, scene.window, scale, scene.layers)
	}

	// A node for a component that just entered the tree. The component's `style.geom` is
	// the node's geometry from here on, so layout writes straight into it.
	def mount(owner component) Node {
		let node = new Node()
		node.owner = owner
		let look = owner.style
		look.geom = node.geom when look is Placed
		attachOwner(owner)
		// One that asks for the focus when it is mounted gets it once it is laid out.
		owner.focus() when owner.autofocus
		return node
	}

	// Takes `node` and what is under it out of the tree for good, when the scene closes: every component is told
	// `detached`, children first, then the node's own component lets go of the children its
	// view placed (`Component<T>.unmount`, which goes down by itself). A child that holds
	// one of its parent's methods as a handler keeps the parent alive until then.
	def unmount(node Node) {
		detach(node)
		let owner = node.owner
		owner.unmount() unless owner is none
	}

	// Tells the component of `node` and those under it that they left the tree.
	def detach(node Node) {
		for let child in node.children {
			detach(child)
		}
		let owner = node.owner
		detachOwner(owner) unless owner is none
	}

	// Tells `owner` it is in a window's tree. A scope its tasks were cancelled in
	// when it last left is let go of, so `tasks` starts a new one.
	def attachOwner(owner component) {
		if owner._tasksEnded {
			owner._tasks = none
			owner._tasksEnded = false
		}
		owner.attached()
	}

	// Tells `owner` it left the tree, once the tasks it started in `tasks` are
	// cancelled. The cancelled scope stays until the next attach, so a task started
	// in it meanwhile never runs.
	def detachOwner(owner component) {
		let held = owner._tasks
		held.cancel("the component left the tree") unless held is none
		owner._tasksEnded = !(held is none)
		owner.detached()
	}

	// The theme the style of `owner` reads when the component above it reads `above`:
	// the one it provides (`provide<Theme>(theme)`), else that one.
	def themeUnder(owner component, above Theme) Theme {
		for let held in owner.provided {
			return held when held is Theme
		}
		return above
	}

	// Whether `theme` is the one a node's style last read; a node that never took one
	// again read the theme of the scene when its style was made.
	def sameTheme(scene Scene, seen ?Theme, theme Theme) bool {
		return theme == scene.theme when seen is none
		return seen == theme
	}

	// Makes `node` and the nodes under it match `owner` and its children: the nodes of
	// components still there are kept, in the components' order. `above` is the theme
	// the component above `owner` reads, `outer` the look in effect of the component
	// above it, none for the root; `clean` that what `outer` gives is what it gave when
	// the node was in step last (the root's is always). A node that is still in step
	// (`quietIn`) is left as it is and only the nodes under it are visited. Returns
	// whether the component's look was copied into the node.
	def syncTree(scene Scene, node Node, owner component, parentEm float, above Theme, outer ?style, sheets StyleSheet[], mark int, blocked bool = false, clean bool = true) bool {
		if clean && !node.live && quietIn(scene, node, owner, parentEm, above, mark, blocked) {
			syncQuiet(scene, node, owner, above, sheets, mark, blocked)
			return false
		}
		// What is copied may change what layout reads (its box, its children, what it
		// measures) and what is drawn.
		scene.changes += 1 when owner.isStale
		node.layoutChanged()
		owner.isStale = false
		owner.staleBelow = false
		// What is under a component that is not enabled is not enabled either.
		owner.isBlocked = blocked when owner.isBlocked != blocked
		let inside = blocked || !owner.enabled
		refloat(scene, node, owner)
		// The theme its style reads: the one it provides, else the one above it. When
		// that is another theme than the style last read, or the theme changed, what
		// the style's body assigns from it is assigned again.
		let theme = themeUnder(owner, above)
		// New code was loaded: the style takes what its builder makes now, and
		// what its body assigns from the theme is assigned again on that.
		let renewed = scene.restyle && __style_hot_renew(owner.style)
		if renewed || scene.retheme || !sameTheme(scene, node.theme, theme) {
			node.theme = theme
			let look = owner.style
			let themed = look.themed
			if !(themed is none) {
				themed(look, owner)
			}
		}
		// The style sheets around it, with the one it provides, and their rules that
		// can be for it.
		let (inSheets, inMark) = sheetsUnder(owner, sheets, mark)
		findRules(node, owner, sheets, mark)
		// The variants the call that made it asks for are its style's.
		let variants = owner._styleVariant
		if !(variants is none) {
			let look = owner.style
			look.variant = variants unless look.variant.equals(variants)
		}
		// What the style's inherited properties take while unset: the values of the
		// nearest styles above that have them, as those are now. Nothing to take again
		// when those are as they were and no property of the style was assigned since.
		let own = owner.style
		let steady = clean && !scene.retheme && !scene.restyle && node.syncedVersion == own.version
		__style_inherit(own, outer) unless steady
		// What the style takes from the component and from other components, as they are
		// now; what it read of another one is a layout old once something moves.
		let bound = own.bound
		if !(bound is none) {
			node.readsOthers = bound(own, owner)
			scene.follows = true when node.readsOthers
		}
		let (em, copied) = restyle(node, owner, parentEm, steady)
		owner.em = em when owner.em != em
		node.syncedVersion = own.version
		// What the components under it inherit from: its look as the states make it;
		// as it was for them when it is the same look and that was not copied again.
		let shown = __style_shown(own)
		let lastShown = node.syncedShown
		let under = steady && !copied && !(lastShown is none) && __style_same(lastShown, shown)
		node.syncedShown = shown
		moveNode(scene, node, owner, parentEm)
		hideFresh(scene, node, owner)
		let wanted = owner.children
		// A child its view dropped that still shows its exit is laid out and drawn with
		// the others.
		let going = owner.leaving.len() > 0
		if going {
			wanted = wanted.clone()
			wanted.push(...owner.leaving)
		}
		// A scoped component among them has no node: what it holds stands in its place,
		// and so does what it holds that goes.
		let scoped = false
		for let child in wanted {
			if child.isScoped {
				scoped = true
				going = true when child.leaving.len() > 0
			}
		}
		// Where this component's run starts in `scene.unscoped`.
		let base = scene.unscoped.len()
		if scoped {
			pushUnscoped(scene, owner, node, inside, theme, inSheets, inMark)
			wanted = scene.unscoped
		}
		let count = wanted.len() - (scoped ?? (base, 0))
		let first = scoped ?? (base, 0)
		let had = node.children
		let same = had.len() == count
		if same {
			for let i = 0; i < count; i++ {
				let held = had[i].owner
				same = false when held is none || held != wanted[first + i]
			}
		}
		if !same {
			// The order they were in: a child that goes keeps its place.
			let before Node[]
			before = had.clone() when going
			let kept Node[]
			for let i = 0; i < count; i++ {
				let child = wanted[first + i]
				let found ?Node = none
				for let (at, old) in had {
					let held = old.owner
					continue when held is none || held != child
					found = old
					had.remove(at)
					break
				}
				if found is none {
					let fresh = mount(child)
					fresh.parent = node
					kept.push(fresh)
				} else {
					kept.push(found)
				}
			}
			// A component that left `children` is told so and no more: the view that
			// dropped it for good has unmounted it already, and one a view did not place
			// this time keeps what is under it for when it comes back.
			// One that showed its exit was told when that began.
			for let gone in had {
				detach(gone) unless gone.exiting
			}
			node.children = going ?? (inPlace(kept, before), kept)
		}
		for let i = 0; i < count; i++ {
			// Where the node's component stands among those wanted: at the node's own
			// place, unless one that goes was put back where it was.
			let at = i
			if going {
				let held = node.children[i].owner
				for let k = 0; k < count; k++ {
					let other = scoped ?? (scene.unscoped[first + k], wanted[k])
					at = k when !(held is none) && other == held
				}
			}
			// Read again each time: a component below adds its own run after this one.
			if scoped {
				let held = scene.unscoped[first + at]
				let (childTheme, childMark, childBlocked) = (scene.unscopedTheme[first + at], scene.unscopedMarks[first + at], scene.unscopedBlocked[first + at])
				continue when under && passOver(scene, node.children[i], held, em, childTheme, childMark, childBlocked)
				let _ = syncTree(scene, node.children[i], held, em, childTheme, shown, scene.unscopedSheets[first + at], childMark, childBlocked, under)
			} else {
				continue when under && passOver(scene, node.children[i], wanted[at], em, theme, inMark, inside)
				let _ = syncTree(scene, node.children[i], wanted[at], em, theme, shown, inSheets, inMark, inside, under)
			}
		}
		if scoped {
			scene.unscoped.len(base)
			scene.unscopedBlocked.len(base)
			scene.unscopedTheme.len(base)
			scene.unscopedSheets.len(base)
			scene.unscopedMarks.len(base)
		}
		settleMeasure(node, owner)
		node.syncedAbove = above
		node.live = changesUnmarked(node, owner, own, scoped, going)
		node.liveBelow = node.live || anyLiveBelow(node)
		scene.changes += 1 when copied || !same
		return copied
	}

	// Whether the node of `owner` and everything under it can be passed over whole: the
	// node is in step (`quietIn`) and nothing under it is marked (`staleBelow`) or live.
	// The caller has checked that what it passes down is what it passed before.
	def passOver(scene Scene, node Node, owner component, parentEm float, above Theme, mark int, blocked bool) bool {
		return false when node.live || node.liveBelow || owner.staleBelow
		return quietIn(scene, node, owner, parentEm, above, mark, blocked)
	}

	// Whether a node under `node` is live, as the last pass over each left it.
	def anyLiveBelow(node Node) bool {
		for let child in node.children {
			return true when child.liveBelow
		}
		return false
	}

	// Whether nothing `syncTree` copies of `owner` into `node` can have changed since the
	// node was brought in step last: no store marked the component stale, its style
	// counted no assignment, what the component above gives is as it was then, and
	// neither the theme nor the code changed. What the component above passes as
	// `outer` is the caller's to compare (`clean`).
	def quietIn(scene Scene, node Node, owner component, parentEm float, above Theme, mark int, blocked bool) bool {
		return false when owner.isStale || scene.whole
		let own = owner.style
		return false when node.syncedVersion != own.version || node.syncedEm != parentEm || owner.em != node.syncedEmOut
		return false when node.rulesOf != mark || owner.isBlocked != blocked
		let last = node.syncedAbove
		return !(last is none) && last == above
	}

	// `syncTree` for a node that is in step: nothing is copied into it, the nodes under
	// it are visited with what they were given before, and what is read from code that
	// may read anything is read again: where a scrolling component is scrolled to, and
	// the first baseline of a component that sizes to what it measures. Which of its
	// children take room is found again only when one of them was copied.
	def syncQuiet(scene Scene, node Node, owner component, above Theme, sheets StyleSheet[], mark int, blocked bool) {
		owner.staleBelow = false
		let children = node.children
		let copied = false
		let live = false
		if children.len() > 0 {
			let (inSheets, inMark) = sheetsUnder(owner, sheets, mark)
			let theme = themeUnder(owner, above)
			let (em, shown, inside) = (node.syncedEmOut, node.syncedShown, blocked || !owner.enabled)
			for let child in children {
				let held = child.owner
				continue when held is none
				if !passOver(scene, child, held, em, theme, inMark, inside) {
					copied = true when syncTree(scene, child, held, em, theme, shown, inSheets, inMark, inside)
				}
				live = true when child.liveBelow
			}
		}
		node.liveBelow = live
		// Which of its children take room, and so whether it measures itself, may have
		// changed with one of them.
		if copied {
			settleMeasure(node, owner)
			node.layoutChanged()
		}
	}

	// Whether what `syncTree` copies of the component can change with no store that
	// marks it stale (`Component.isStale`), so its node is brought in step on every
	// pass: its style reads other components (`$parent`, a ref: a `bound` body that
	// says so), rules of style sheets apply to it, it places itself or moves, or what it
	// holds is scoped or going. What its own fields, inputs and states, a call's
	// `style` and its variants give changes with a mark.
	def changesUnmarked(node Node, owner component, own style, scoped bool, going bool) bool {
		return true when scoped || going || node.motionSlot != motionless || node.rules.len() > 0
		// A style body that reads only its own component reads what marks it.
		return true when !(own.bound is none) && node.readsOthers
		return owner is Placing
	}

	// A component with nothing under it that takes room (no child, or only ones out of
	// the flow: a menu, a hover card) sizes to what it measures itself.
	def settleMeasure(node Node, owner component) {
		let flowing = false
		for let child in node.children {
			flowing = true when child.box.position := Position.Normal || Position.Sticky
		}
		if !flowing {
			node.baseline = owner.firstBaseline()
			if node.measure is none {
				node.measure = def (limit Limit) Size<Pixels> {
					return owner.measure(limit)
				}
			}
		} else {
			node.measure = none
			node.baseline = none
		}
	}

	// Copies the component's style into its node: the box, the arrangement, the tracks and
	// what it is painted with. Returns what `1(em)` is for its children, and whether the
	// look was copied: not when `held` (what it inherits is as it was) and the look is
	// the one copied last with no property assigned since, or a copy that holds the same
	// values as that one (a state's or a variant's look, made on every layout), under
	// the same `em`. A node that moves or floats is copied every time: those write over
	// what is copied.
	def restyle(node Node, owner component, parentEm float, held bool) (float, bool) {
		let look = stateLook(node, owner)
		let last = node.syncedLook
		let kept = !(last is none) && (last == look ?? (node.syncedLookVersion == look.version, __style_same(last, look)))
		let same = held && kept && node.syncedEm == parentEm && node.motionSlot == motionless && !(owner is Floating)
		let em = same ?? (node.syncedEmOut, lookInto(node, look, parentEm))
		node.syncedLook = look
		node.syncedLookVersion = look.version
		node.syncedEm = parentEm
		node.syncedEmOut = em
		node.restyled = !same
		rescroll(node, owner)
		return (em, !same)
	}

	// Copies a style into `node`, as `restyle` does a component's.
	def lookInto(node Node, look style, parentEm float) float {
		if look is Boxed {
			let box = node.box
			box.width = look.width
			box.height = look.height
			box.minWidth = look.minWidth
			box.minHeight = look.minHeight
			box.maxWidth = look.maxWidth
			box.maxHeight = look.maxHeight
			box.margin = look.margin
			box.padding = look.padding
			box.position = look.position
			box.anchors = look.anchors
			box.layer = look.layer
			box.visible = look.visible
			box.align = look.align
			box.direction = look.direction
		}
		if look is Arranged {
			let layout = node.layout
			layout.arrange = look.arrange
			layout.gap = look.gap
			layout.distribute = look.distribute
			layout.wrap = look.wrap
			layout.reverse = look.reverse
		}
		if look is Tracked {
			let tracks = node.tracks
			tracks.columns = look.columns
			tracks.rows = look.rows
			tracks.autoTrack = look.autoTrack
			tracks.flow = look.flow
			tracks.dense = look.dense
		}
		node.alignSelf = look.alignSelf when look is SelfAligned
		node.cell = look.cell when look is Celled
		let em = parentEm
		if look is Lettered {
			let font = look.font
			// A font the style named other fields of (`font = {weight: ...}`) keeps
			// the size above.
			em = paint.sizeIn(font.size, parentEm) unless font is none || !__style_names(look, "font", "size")
		}
		node.fontSize = em * 1(px)
		decorate(node, look)
		return em
	}

	// Gives the scene's viewport the window's size, with the size classes and the
	// orientation that follow from it, and the root the viewport.
	def settleViewport(scene Scene) {
		let port = scene.viewport
		let (width, height) = (float(scene.window.width), float(scene.window.height))
		port.size = scene.window
		port.widthClass = sizeClass(width, scene.widthClasses)
		port.heightClass = sizeClass(height, scene.heightClasses)
		port.orientation = height > width ?? (Orientation.Portrait, Orientation.Landscape)
		scene.root._viewport = port
	}

	def sizeClass(extent float, classes (float, float)) SizeClass {
		let (compact, expanded) = classes
		return SizeClass.Compact when extent < compact
		return SizeClass.Expanded when extent >= expanded
		return SizeClass.Medium
	}

	// The nodes of `kept` with those that go put back where they were among the others
	// in `before`: after the nearest node before them there that is still kept.
	def inPlace(kept Node[], before Node[]) Node[] {
		let placed Node[]
		for let node in kept {
			placed.push(node) unless goes(node)
		}
		for let (at, old) in before {
			continue unless goes(old) && holds(kept, old)
			// After the nearest earlier sibling that is placed; first when none is.
			let after = -1
			for let back = at - 1; back >= 0 && after < 0; back-- {
				for let (i, node) in placed {
					after = i when node == before[back]
				}
			}
			let next Node[]
			next.push(old) when after < 0
			for let (i, node) in placed {
				next.push(node)
				next.push(old) when i == after
			}
			placed = next
		}
		// One that goes and was not there before keeps its place at the end.
		for let node in kept {
			placed.push(node) when goes(node) && !holds(placed, node)
		}
		return placed
	}

	// Whether the node's component is one its view dropped.
	def goes(node Node) bool {
		let owner = node.owner
		return !(owner is none) && owner.isLeaving
	}

	// The node's decoration, made when it has none.
	def decorationIn(node Node) paint.Decoration {
		let held = node.decoration
		return held unless held is none
		let made = new paint.Decoration()
		node.decoration = made
		return made
	}

	// Fills the node's decoration from the paint styles the component's style embeds; a
	// style with none of them leaves the node without one.
	def decorate(node Node, look style) {
		let painted = look is Shaped || look is Filled || look is Bordered || look is Ringed || look is Shadowed || look is Filtered || look is Backed || look is Composited || look is Transformed || look is Clipped || look is Pointed
		if !painted {
			node.decoration = none
			return
		}
		let decoration = decorationIn(node)
		if look is Shaped {
			decoration.radius = look.radius
			decoration.corners = look.corners
		}
		decoration.background = look.background when look is Filled
		if look is Bordered {
			decoration.border = look.border
			decoration.borderImage = look.borderImage
			node.border = decoration.borderWidths()
		}
		decoration.outline = look.outline when look is Ringed
		decoration.shadows = look.shadows when look is Shadowed
		decoration.filters = look.filters when look is Filtered
		decoration.backdrop = look.backdrop when look is Backed
		if look is Composited {
			decoration.opacity = look.opacity
			decoration.blend = look.blend
		}
		decoration.transform = look.transform when look is Transformed
		if look is Clipped {
			decoration.clip = look.clip
			decoration.mask = look.mask
		}
		if look is Pointed {
			decoration.hitTest = look.hitTest
			decoration.hitSlop = look.hitSlop
			decoration.minTarget = look.minTarget
		}
	}
}
