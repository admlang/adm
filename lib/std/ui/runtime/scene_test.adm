internal partial module std.ui.runtime {
	use (
		std.formats.fonts
		std.gfx.canvas
		std.os
		std.ui.components
		std.ui.paint
		std.gfx.color::(Color, RGBA)
		std.math.geom::(Axes, Edges, Point, Rect, Size)
		std.testing
		std.ui as _
		std.time
		std.ui.frames
		std.ui::(Key, KeyEvent, Modifiers, PointerEvent, PointerPhase, RenderContext)
		std.ui.styles::*
		std.units::(Extent, Pixels)
	)

	let seen = string[]

	def tint(r int, g int, b int) Color {
		return new Color(RGBA{r: byte(r), g: byte(g), b: byte(b), a: 255})
	}

	def inked(surface canvas.Canvas, x int, y int, r int, g int, b int) bool {
		let i = (y * surface.width + x) * 4
		return surface.pixels[i + 3] == 255 && int(surface.pixels[i]) == r && int(surface.pixels[i + 1]) == g && int(surface.pixels[i + 2]) == b
	}

	style Surface {
		Box
		Layout
		Background
		Compositing
	}

	style Framed {
		Box
		Borders
	}

	view Nothing {}

	component Tile {
		style Surface
		view Nothing
		type {
			@input
			name string = "tile"

			def new() {
				style.width = 40(px)
				style.height = 20(px)
				style.background = new BackgroundFill(tint(200, 0, 0))
			}

			def attached() {
				seen.push("{name} attached")
			}

			def detached() {
				seen.push("{name} detached")
			}
		}
	}

	// Draws a bar of its own between the std passes.
	component Meter {
		style Framed
		view Nothing
		type {
			def new() {
				style.width = 40(px)
				style.height = 20(px)
				style.border = new Edges<Border>(Border{width: 2(px), paint: tint(0, 0, 0)})
			}

			def render(ctx RenderContext) {
				ctx.outerShadows()
				ctx.background()
				let area = ctx.geometry.content
				ctx.draw.fill(Rect{left: float(area.left), top: float(area.top), right: float(area.left) + float(area.width) / 2.0, bottom: float(area.bottom)}, tint(0, 200, 0))
				ctx.borders()
				ctx.childNodes()
				ctx.innerShadows()
			}
		}
	}

	component Page {
		style Surface
		view {
			Tile(name = "first") when leading
			Meter()
			Tile(name = "last")
		}
		type {
			// The first tile is there while this holds.
			leading bool = true

			def new() {
				style.width = fill
				style.height = fill
				style.padding = new Edges<Extent>(10(px))
				style.gap = new Axes<Extent>(5(px))
				style.background = new BackgroundFill(tint(255, 255, 255))
			}

			def wide() Pixels {
				return style.geom.frame.width
			}
		}
	}

	// Takes a press, captures the pointer and handles keys; logs what it receives.
	component Knob {
		style Surface
		view Nothing
		type {
			def new() {
				style.width = 40(px)
				style.height = 20(px)
			}

			def pointer(e PointerEvent) bool {
				seen.push("knob {e.phase} {int(float(e.position.x))},{int(float(e.position.y))}")
				return false when e.phase != PointerPhase.Down && e.phase != PointerPhase.Move && e.phase != PointerPhase.Up
				e.capture() when e.phase == PointerPhase.Down
				return true
			}

			def key(e KeyEvent) bool {
				if !e.down {
					seen.push("knob up {e.key}")
					return false
				}
				seen.push("knob key {e.key}")
				return e.key == Key.Enter
			}
		}
	}

	component Board {
		style Surface
		view {
			Knob(focusable = true)
			Tile(name = "plain")
		}
		type {
			def new() {
				style.width = fill
				style.height = fill
				style.padding = new Edges<Extent>(10(px))
			}

			def pointer(e PointerEvent) bool {
				seen.push("board {e.phase}")
				return true
			}

			def key(e KeyEvent) bool {
				return false when !e.down
				seen.push("board key {e.key}")
				return true
			}
		}
	}

	// A panel inside a panel, fifteen deep, with a button at the bottom.
	component Nest {
		type {
			def new() {
				style.width = 400(px)
				style.height = 300(px)
			}
		}

		view {
			components.Panel() {
				components.Panel() {
					components.Panel() {
						components.Panel() {
							components.Panel() {
								components.Panel() {
									components.Panel() {
										components.Panel() {
											components.Panel() {
												components.Panel() {
													components.Panel() {
														components.Panel() {
															components.Panel() {
																components.Panel() {
																	components.Button(label = "Deep")
																}
															}
														}
													}
												}
											}
										}
									}
								}
							}
						}
					}
				}
			}
		}

		style Surface
	}

	// How many times a `Ticker` drew itself, and how many times the tile beside it did.
	let drawn = int[]

	// How long a `Ticker` asks to wait before it is drawn again; 0s: the next frame.
	let tickEvery = [0s]

	// Draws a shade that changes each time it is drawn, and asks to be drawn again.
	component Ticker {
		style Surface
		view Nothing
		type {
			def new() {
				style.width = 40(px)
				style.height = 20(px)
			}

			def render(ctx RenderContext) {
				drawn[0] += 1
				ctx.draw.fill(Rect{left: 0.0, top: 0.0, right: 40.0, bottom: 20.0}, tint(drawn[0] * 50, 0, 0))
				if tickEvery[0] > 0s {
					redrawBy(time.now() + tickEvery[0])
				} else {
					redraw()
				}
			}
		}
	}

	// Counts the times it is drawn.
	component Still {
		style Surface
		view Nothing
		type {
			def new() {
				style.width = 40(px)
				style.height = 20(px)
			}

			def render(ctx RenderContext) {
				drawn[1] += 1
				ctx.draw.fill(Rect{left: 0.0, top: 0.0, right: 40.0, bottom: 20.0}, tint(0, 0, 200))
			}
		}
	}

	style Cut {
		Box
		Layout
		Clipping
	}

	// A box that cuts off what it holds, 20 high, with a `Ticker` under a tile: the
	// ticker is out of sight.
	component Hold {
		style Cut
		view {
			Tile(name = "held")
			Ticker()
		}
		type {
			def new() {
				style.width = 60(px)
				style.height = 20(px)
				style.clip = true
			}
		}
	}

	// Draws a shade that changes each time, inside its box and in a square under it, and
	// asks to be drawn again: what it draws outside its box breaks the contract.
	component Spill {
		style Surface
		view Nothing
		type {
			def new() {
				style.width = 40(px)
				style.height = 20(px)
			}

			def render(ctx RenderContext) {
				drawn[2] += 1
				ctx.draw.fill(Rect{left: 0.0, top: 0.0, right: 40.0, bottom: 20.0}, tint(0, drawn[2] * 50, 0))
				ctx.draw.fill(Rect{left: 0.0, top: 30.0, right: 10.0, bottom: 40.0}, tint(0, drawn[2] * 50, 0))
				redraw()
			}
		}
	}

	// Fades in from a little lower, and out.
	style Faded {
		Box
		Compositing
		Transforms
		Motion
		enter = {opacity: 0.0, transform: {translate: {y: 8(px)}}}
		exit = {opacity: 0.0}
	}

	// Whether `Fades` places its `Fading`, and what a `Fading` heard.
	let fadeShown = [true]
	let fadeLog = string[]

	component Fading {
		style Faded
		view Nothing
		type {
			def new() {
				style.width = 40(px)
				style.height = 20(px)
				style.transition = Transition{duration: 100ms, easing: Ease.Linear}
			}

			def attached() {
				fadeLog.push("attached")
			}

			def detached() {
				fadeLog.push("detached")
			}
		}
	}

	// A tile, a component that fades in and out, a tile.
	component Fades {
		style Surface
		view {
			Tile(name = "above")
			if fadeShown[0] {
				Fading()
			}
			Tile(name = "below")
		}
		type {
			def new() {
				style.width = fill
				style.height = fill
			}
		}
	}

	// A ticker, a counted component and one that asks for every frame, one under another.
	component Mixed {
		style Surface
		view {
			Ticker()
			Still()
			Spill()
		}
		type {
			def new() {
				style.width = fill
				style.height = fill
			}
		}
	}

	// Two tickers with a counted component between them, then one that spills.
	component Pair {
		style Surface
		view {
			if spilling {
				Spill()
			} else {
				Ticker()
				Still()
				Ticker()
			}
		}
		type {
			spilling bool

			def new() {
				style.width = fill
				style.height = fill
				style.gap = new Axes<Extent>(5(px))
				style.background = new BackgroundFill(tint(255, 255, 255))
			}
		}
	}

	component Clock {
		style Surface
		view {
			Ticker() unless hidden
			Tile(name = "still")
			Still()
			Hold() when hidden
		}
		type {
			// The ticker is inside the box that cuts it off.
			hidden bool

			def new() {
				style.width = fill
				style.height = fill
				style.gap = new Axes<Extent>(5(px))
				style.background = new BackgroundFill(tint(255, 255, 255))
			}
		}
	}

	let nestScene ?Scene = none

	check "Scene" {
		@test()
		def TestScene() {
			seen = string[]
			let page = Page()
			let scene = new Scene(page)
			let warnings = scene.arrange(new Size<Pixels>(100(px), 100(px)))
			// Every component was told it is in a window, parents first.
			assert warnings.len() == 0 && seen.join(",") == "first attached,last attached"

			// Layout read each style: a column with padding and a gap; a component reads
			// where it was put as `style.geom`.
			let first = scene.tree.children[0].geom.frame
			let meter = scene.tree.children[1].geom.frame
			assert float(first.left) == 10.0 && float(first.top) == 10.0 && float(first.width) == 40.0 && float(meter.top) == 35.0
			assert float(page.wide()) == 100.0
			let look = page.children[1].style
			if look is Placed {
				assert float(look.geom.frame.top) == 35.0
			}
			assert look is Placed

			// Each component is drawn by its `render`: the default passes for the tiles,
			// the meter's own bar between its background and its border.
			let surface = new canvas.Canvas(100, 100)
			scene.paint(surface)
			assert inked(surface, 5, 5, 255, 255, 255) && inked(surface, 20, 20, 200, 0, 0) && inked(surface, 20, 70, 200, 0, 0)
			assert inked(surface, 20, 45, 0, 200, 0) && inked(surface, 40, 45, 255, 255, 255) && inked(surface, 11, 45, 0, 0, 0) && inked(surface, 48, 45, 0, 0, 0)

			// Drawn into a renderer's recording and replayed, the frame is the same.
			let recording = new canvas.DrawContext(new Size(100.0, 100.0))
			scene.paint(recording)
			let replayed = new canvas.Canvas(100, 100)
			replayed.apply(recording)
			assert inked(replayed, 5, 5, 255, 255, 255) && inked(replayed, 20, 20, 200, 0, 0) && inked(replayed, 20, 45, 0, 200, 0) && inked(replayed, 11, 45, 0, 0, 0)

			// The component under a point.
			let whole component = page
			assert scene.hit(new Point<Pixels>(20(px), 45(px))) == page.children[1] && scene.hit(new Point<Pixels>(80(px), 45(px))) == whole
			// Past every component the root is the target: it stands for the window.
			page.style.width = 50(px)
			scene.arrange(new Size<Pixels>(100(px), 100(px)))
			assert scene.hit(new Point<Pixels>(80(px), 45(px))) == whole
			page.style.width = fill

			// A style changed between frames is read again; a component gone from the tree
			// is told so and the ones after it move up.
			page.style.gap = new Axes<Extent>(0(px))
			page.leading = false
			scene.arrange(new Size<Pixels>(100(px), 100(px)))
			assert seen.join(",") == "first attached,last attached,first detached"
			assert float(scene.tree.children[0].geom.frame.top) == 10.0 && float(scene.tree.children[1].geom.frame.top) == 30.0
			scene.close()
			assert seen.len() == 4 && seen[3] == "last detached"
		}

		// A `Text` sizes its node by its text, gives it a baseline and draws the text in its
		// content box.
		@test()
		def TestTextComponent() !none {
			let label = components.Text(text = "Hello world")
			let data = try os.readFile("samples/fonts/ttf/SourceSansPro-Black.ttf")
			let block = new paint.TextBlock("Hello world", Font{family: "Source Sans Pro"})
			block.faces = [try (try fonts.load(data)).face(0)]
			label.block = block
			let scene = new Scene(label)
			scene.arrange(new Size<Pixels>(200(px), 80(px)))
			let frame = scene.tree.geom.frame
			assert float(frame.width) > 60.0 && float(frame.width) < 110.0 && float(frame.height) > 18.0 && float(frame.height) < 26.0
			assert !(scene.tree.geom.baseline is none)
			let surface = new canvas.Canvas(200, 80)
			scene.paint(surface)
			let ink = 0
			for let y = 0; y < int(float(frame.height)); y++ {
				for let x = 0; x < int(float(frame.width)); x++ {
					ink++ when surface.pixels[(y * 200 + x) * 4 + 3] > 200
				}
			}
			assert ink > 150 && surface.pixels[(60 * 200 + 150) * 4 + 3] == 0
		}

		// A pointer over the tree sets `hover` and `pressed`, tells components it entered
		// and left, goes to the component under it and up until one handles it, and stays
		// with a component that captured it; a press gives the focus, keys follow it.
		@test()
		def TestPointerAndKeys() {
			let board = Board()
			let scene = new Scene(board)
			scene.arrange(new Size<Pixels>(100(px), 100(px)))
			let knob = board.children[0]
			let plain = board.children[1]
			let whole component = board
			seen = string[]

			// Over the knob: it and the board are hovered; the knob handles the move.
			assert scene.pointer(PointerPhase.Move, new Point<Pixels>(15(px), 12(px))) == knob
			assert knob.hover && board.hover && !plain.hover
			assert seen.join(";") == "knob Enter 5,2;board Enter;knob Move 5,2"

			// A press: pressed, focused, captured.
			seen = string[]
			scene.pointer(PointerPhase.Down, new Point<Pixels>(15(px), 12(px)))
			assert knob.pressed && knob.focused && knob.focusWithin && board.focusWithin && !board.focused
			assert seen.join(";") == "knob Down 5,2"

			// Dragged over the other tile, the knob still gets the pointer.
			seen = string[]
			assert scene.pointer(PointerPhase.Move, new Point<Pixels>(15(px), 40(px))) == plain
			assert !knob.hover && plain.hover && knob.pressed
			assert seen.join(";") == "knob Leave 5,30;knob Move 5,30"
			scene.pointer(PointerPhase.Up, new Point<Pixels>(15(px), 40(px)))
			assert !knob.pressed && knob.focused

			// Released, a move over the plain tile is not handled there and reaches the board.
			seen = string[]
			scene.pointer(PointerPhase.Move, new Point<Pixels>(16(px), 40(px)))
			assert seen.join(";") == "board Move"

			// Keys go to the focused knob, then up when it does not handle them.
			seen = string[]
			assert scene.key(KeyEvent{target: whole, key: Key.Enter}) == knob
			scene.key(KeyEvent{target: whole, key: Key.A})
			assert seen.join(";") == "knob key Enter;knob key A;board key A"

			// A key that comes up is offered the same way, with `down` false. What the
			// host says is held replaces what the scene made of the keys it saw.
			seen = string[]
			assert scene.keyUp(Key.A) == knob && seen.join(";") == "knob up A"
			scene.key(KeyEvent{target: whole, key: Key.LeftShift})
			assert scene.modifiers.shift
			scene.hold(Modifiers{})
			assert !scene.modifiers.shift
			scene.hold(Modifiers{alt: true})
			assert scene.modifiers.alt
			scene.keyUp(Key.LeftAlt)
			assert !scene.modifiers.alt

			// A press where nothing is focusable takes the focus away; the pointer leaving
			// the window clears hover.
			scene.pointer(PointerPhase.Down, new Point<Pixels>(15(px), 40(px)))
			scene.pointer(PointerPhase.Up, new Point<Pixels>(15(px), 40(px)))
			assert !knob.focused && !board.focusWithin
			scene.pointer(PointerPhase.Leave, new Point<Pixels>(15(px), 40(px)))
			assert !plain.hover && !board.hover
			assert scene.key(KeyEvent{target: whole, key: Key.A}) == whole
		}

		// One pointer move over a component fifteen deep: the hit test, the hover set and
		// the event offered up the chain.
		@benchmark()
		def RouteMoveFifteenDeep() {
			if nestScene is none {
				let made = new Scene(Nest())
				made.arrange(new Size<Pixels>(400(px), 300(px)))
				nestScene = made
			}
			let scene = nestScene
			return when scene is none
			let _ = scene.pointer(PointerPhase.Move, new Point<Pixels>(12(px), 10(px)))
			let _ = scene.pointer(PointerPhase.Move, new Point<Pixels>(14(px), 11(px)))
		}

		// A shortcut is read once into a key and its modifiers; one that names no key
		// or has a part that is no modifier is none, and reported once.
		@test()
		def TestHotkeys() {
			let _ = takeWarnings()
			let page = Page()
			let save = parseHotkey("Ctrl + shift+s")
			assert !(save is none)
			if !(save is none) {
				assert save.key == Key.S && save.mod && save.shift && !save.alt && !save.command
				let held = Modifiers{shift: true, mod: true, control: true}
				assert hotkeyMatches(save, KeyEvent{target: page, key: Key.S, modifiers: held})
				assert !hotkeyMatches(save, KeyEvent{target: page, key: Key.S, modifiers: Modifiers{mod: true, control: true}})
				assert !hotkeyMatches(save, KeyEvent{target: page, key: Key.D, modifiers: held})
			}
			let names = string[]
			for let written in ["del", "PgDn", "7", "f12", " esc "] {
				let key = keyNamed(written)
				names.push(key.name) unless key is none
			}
			assert names.join(",") == "Delete,PageDown,Digit7,F12,Escape"
			assert keyNamed("Unknown") is none && keyNamed("Character") is none && keyNamed("") is none
			assert parseHotkey("Crtl+S") is none && parseHotkey("Ctrl+") is none && parseHotkey("Ctrl+Nope") is none

			let slot = new HotkeySlot()
			assert slot.get("") is none && takeWarnings().len() == 0
			assert slot.get("Crtl+S") is none && slot.get("Crtl+S") is none
			let told = takeWarnings()
			assert told.len() == 1 && told[0].contains("Crtl+S")
			assert !(slot.get("F2") is none) && takeWarnings().len() == 0
		}

		// A component whose style has an `enter` appears from that look, and one with an
		// `exit` that its view drops stays where it was, drawn part of the way to that
		// look and there for nothing else, until the transition ends; placed again
		// while it goes, the same component comes back from where it was.
		@test()
		def TestEnterAndExit() {
			fadeShown = [true]
			fadeLog = string[]
			let fades = Fades()
			let scene = new Scene(fades)
			let size = new Size<Pixels>(100(px), 100(px))
			let t0 = time.now()
			let at = def (since duration) {
				scene.clock = t0 + since
				scene.arrange(size)
			}
			// Whether the node at `index` is drawn that opaque and that far down.
			let drawnAs = def (index int, opacity float, down float) bool {
				let decoration = scene.tree.children[index].decoration
				return false when decoration is none
				let moved = decoration.transform.translate.y
				return (decoration.opacity - opacity).abs() < 1e-6 && moved is Pixels && (float(moved) - down).abs() < 1e-6
			}
			at(0ms)
			let fading = fades.children[1]
			assert scene.tree.children.len() == 3 && drawnAs(1, 0.0, 8.0) && fadeLog.join(",") == "attached"
			at(50ms)
			assert drawnAs(1, 0.5, 4.0)
			at(100ms)
			assert drawnAs(1, 1.0, 0.0)

			// Dropped: still the second of three, half gone after half the time, not
			// under the pointer, told at once; then let go of.
			fadeShown = [false]
			at(200ms)
			assert fades.children.len() == 2 && fades.leaving.len() == 1 && scene.tree.children.len() == 3
			assert scene.tree.children[1].owner is Fading && drawnAs(1, 1.0, 0.0) && fadeLog.join(",") == "attached,detached"
			at(250ms)
			assert drawnAs(1, 0.5, 0.0)
			let middle = scene.tree.children[1].geom.frame
			assert scene.hit(new Point<Pixels>(middle.left + 5(px), middle.top + 5(px))) != fading
			at(300ms)
			assert fades.leaving.len() == 0 && fading.hasLeft
			at(310ms)
			assert scene.tree.children.len() == 2 && fadeLog.join(",") == "attached,detached"

			// A new one enters; dropped and placed again half way, the same one returns
			// from there and hears it is back.
			fadeShown = [true]
			at(400ms)
			let second = fades.children[1]
			assert second != fading && drawnAs(1, 0.0, 8.0)
			at(500ms)
			fadeShown = [false]
			at(600ms)
			at(650ms)
			assert drawnAs(1, 0.5, 0.0) && second.isLeaving
			fadeShown = [true]
			at(650ms)
			assert fades.children[1] == second && !second.isLeaving && drawnAs(1, 0.5, 0.0)
			at(675ms)
			assert drawnAs(1, 0.75, 0.0)
			at(700ms)
			assert drawnAs(1, 1.0, 0.0)
			assert fadeLog.join(",") == "attached,detached,attached,detached,attached"

			// Under reduced motion what moves it happens at once; the fade stays.
			fadeShown = [false]
			at(800ms)
			at(900ms)
			at(910ms)
			scene.reduceMotion = true
			fadeShown = [true]
			at(1000ms)
			assert drawnAs(1, 0.0, 0.0)
			at(1050ms)
			assert drawnAs(1, 0.5, 0.0)

			// A thousand times in and out: the scene keeps the motion of the one that
			// is there and nothing of those that left.
			scene.reduceMotion = false
			let since = 2s
			for let round = 0; round < 1000; round++ {
				fadeShown = [false]
				at(since)
				at(since + 100ms)
				at(since + 110ms)
				assert fades.leaving.len() == 0 && scene.tree.children.len() == 2 && scene.moving.len() == 0
				fadeShown = [true]
				at(since + 200ms)
				at(since + 300ms)
				assert scene.tree.children.len() == 3 && scene.moving.len() == 1
				since += 400ms
			}
			scene.close()
		}

		// A component that asks from its `render` to be drawn again is drawn alone on
		// the frame before; one out of sight is not drawn and no longer asks.
		@test()
		def TestRepaint() {
			drawn = [0, 0, 0]
			let clock = Clock()
			let scene = new Scene(clock)
			let size = new Size<Pixels>(100(px), 100(px))
			let surface = new canvas.Canvas(100, 100)
			let ground = tint(255, 255, 255)
			scene.arrange(size)
			assert !scene.animating()
			// Asking from `render` is not asking for a frame of every window.
			let _ = frames.frameAsked()
			scene.paint(surface)
			assert drawn[0] == 1
			assert scene.animating()
			assert !frames.frameAsked()
			assert inked(surface, 5, 5, 50, 0, 0) && inked(surface, 5, 30, 200, 0, 0) && inked(surface, 60, 5, 255, 255, 255)
			// A plain rectangle a `render` fills lands in the component's own place.
			assert inked(surface, 5, 55, 0, 0, 200)

			// Only the ticker's box changes; what was outside it is as it was, although
			// the part was filled with another colour first.
			surface.fill(Rect{left: 60.0, top: 0.0, right: 100.0, bottom: 100.0}, tint(0, 0, 9))
			assert scene.repaint(surface, 1.0, tint(0, 0, 255))
			assert drawn[0] == 2 && scene.animating()
			assert inked(surface, 5, 5, 100, 0, 0) && inked(surface, 39, 19, 100, 0, 0) && inked(surface, 5, 30, 200, 0, 0)
			assert inked(surface, 60, 5, 0, 0, 9) && inked(surface, 45, 5, 255, 255, 255)

			// A window of another size or scale is drawn whole.
			assert !scene.repaint(surface, 2.0, ground) && drawn[0] == 2

			// Drawn in a recording, as a renderer's frame is, the part leaves out the
			// components that drew nothing in it: the one beside the ticker is not drawn
			// again, and the two recordings give the picture a whole drawing does.
			let whole = new canvas.DrawContext(new Size(100.0, 100.0))
			scene.paint(whole)
			let still = drawn[1]
			let part = new canvas.DrawContext(new Size(100.0, 100.0))
			assert scene.repaint(part, 1.0, ground)
			assert drawn[0] == 4
			assert drawn[1] == still
			assert part.count() < whole.count()
			let shown = new canvas.Canvas(100, 100)
			shown.apply(whole)
			assert inked(shown, 5, 5, 150, 0, 0) && inked(shown, 5, 55, 0, 0, 200)
			shown.apply(part)
			assert inked(shown, 5, 5, 200, 0, 0) && inked(shown, 5, 30, 200, 0, 0) && inked(shown, 5, 55, 0, 0, 200) && inked(shown, 60, 5, 255, 255, 255)

			// Out of sight in a box that cuts it off: drawn with the whole window, then
			// not counted as asking, and a part without it draws nothing.
			clock.hidden = true
			scene.arrange(size)
			scene.paint(surface)
			assert drawn[0] == 5 && !scene.animating()
			assert !scene.repaint(surface, 1.0, ground) && drawn[0] == 5

			// One that asks for a time is not drawn before it: the window waits until
			// then; asked for the next frame, it is drawn at once.
			clock.hidden = false
			scene.arrange(size)
			scene.paint(surface)
			assert scene.animating() && scene.animateIn(time.now(), 2h) == 0s
			tickEvery = [1h]
			scene.paint(surface)
			let wait = scene.animateIn(time.now(), 2h)
			assert !scene.animating() && wait > 30min && wait <= 1h
			tickEvery = [0s]
			scene.close()
		}

		// The part is one rectangle around every component that asked: what lies between
		// two of them is drawn again with them. A component that draws outside its
		// border box while it asks leaves there what the whole frame drew.
		@test()
		def TestRepaintLimits() {
			drawn = [0, 0, 0]
			let pair = Pair()
			let scene = new Scene(pair)
			let size = new Size<Pixels>(100(px), 100(px))
			let ground = tint(255, 255, 255)
			scene.arrange(size)
			let whole = new canvas.DrawContext(new Size(100.0, 100.0))
			scene.paint(whole)
			assert drawn[0] == 2 && drawn[1] == 1
			let part = new canvas.DrawContext(new Size(100.0, 100.0))
			assert scene.repaint(part, 1.0, ground)
			assert drawn[0] == 4 && drawn[1] == 2

			pair.spilling = true
			scene.arrange(size)
			let surface = new canvas.Canvas(100, 100)
			scene.paint(surface)
			assert inked(surface, 5, 5, 0, 50, 0) && inked(surface, 5, 35, 0, 50, 0)
			assert scene.repaint(surface, 1.0, ground)
			assert inked(surface, 5, 5, 0, 100, 0) && inked(surface, 5, 35, 0, 50, 0)
			scene.close()

			// Each component is drawn when its own time comes: one that asked for a
			// later time stays asked while another is drawn frame after frame.
			drawn = [0, 0, 0]
			tickEvery = [1h]
			let mixed = new Scene(Mixed())
			mixed.arrange(size)
			let page = new canvas.DrawContext(new Size(100.0, 100.0))
			mixed.paint(page)
			assert drawn[0] == 1 && drawn[1] == 1 && drawn[2] == 1 && mixed.animating()
			let next = new canvas.DrawContext(new Size(100.0, 100.0))
			assert mixed.repaint(next, 1.0, ground) && mixed.repaint(next, 1.0, ground)
			assert drawn[0] == 1 && drawn[1] == 1 && drawn[2] == 3
			assert mixed.kept.again.len() == 2 && mixed.animating()
			tickEvery = [0s]
			mixed.close()
		}
	}
}
