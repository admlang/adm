internal partial module std.ui.runtime {
	use (
		std.ui.layout::Node
		std.ui.styles::*
		std.units::Pixels
	)

	// A `@scoped` component in a scene's tree: one that is there for what it does and has
	// no layout node, no style and no geometry. What it holds is laid out under the node
	// of the nearest component above it that has one.
	type ScopeEntry {
		owner component
		// The node its content is laid out under.
		under Node
		// The frame that last found it in the tree: `Scene.frame` then.
		frame int

		def new(owner component, under Node, frame int) {
			self.owner = owner
			self.under = under
			self.frame = frame
		}
	}

	// The scoped component directly above `owner`; none when its parent has a node.
	def scopeAbove(owner component) ?component {
		let above = owner.parent()
		return none when above is none || !above.isScoped
		return above
	}

	// Appends what `from` holds to `scene.unscoped` as layout sees it: a scoped component is
	// replaced by what it holds, all the way down. `scene.unscopedBlocked` gets for each
	// whether a scoped component above it is not enabled. Scoped components met are noted
	// in the scene: one new to the tree is told `attached`.
	def pushUnscoped(scene Scene, from component, under Node, blocked bool) {
		for let child in from.children {
			pushOne(scene, child, under, blocked)
		}
		// What its view dropped and still shows its exit stands with the others.
		for let child in from.leaving {
			pushOne(scene, child, under, blocked)
		}
	}

	// `pushUnscoped` for one child.
	def pushOne(scene Scene, child component, under Node, blocked bool) {
		if !child.isScoped {
			scene.unscoped.push(child)
			scene.unscopedBlocked.push(blocked)
			return
		}
		child.isBlocked = blocked when child.isBlocked != blocked
		noteScope(scene, child, under)
		pushUnscoped(scene, child, under, blocked || !child.enabled)
	}

	// Starts a frame's pass over the tree: the scoped components of the frame before are
	// what `noteScope` looks its own up in.
	def beginScopes(scene Scene) {
		let before = scene.scopes
		scene.scopes = scene.scopesBefore
		scene.scopesBefore = before
		scene.scopes.len(0)
		scene.scopeNext = 0
		scene.frame++
	}

	// Marks a scoped component as in the tree this frame. The pass meets them in the order
	// of the frame before while the tree is the same, so the one after the last found is
	// tried first; the others are searched only where the tree changed.
	def noteScope(scene Scene, owner component, under Node) {
		let before = scene.scopesBefore
		let at = scene.scopeNext
		if at >= before.len() || before[at].owner != owner {
			at = before.len()
			for let (i, entry) in before {
				if entry.owner == owner {
					at = i
					break
				}
			}
		}
		if at < before.len() {
			let entry = before[at]
			entry.under = under
			entry.frame = scene.frame
			scene.scopes.push(entry)
			scene.scopeNext = at + 1
			return
		}
		scene.scopes.push(new ScopeEntry(owner, under, scene.frame))
		owner.attached()
		owner.focus() when owner.autofocus
	}

	// Ends a frame's pass over the tree: a scoped component it did not meet left the tree
	// and is told `detached`.
	def settleScopes(scene Scene) {
		let before = scene.scopesBefore
		for let entry in before {
			entry.owner.detached() when entry.frame != scene.frame
		}
		before.len(0)
	}

	// Whether `owner` is held by the scoped component `scope`, directly or through other
	// scoped ones.
	def scopedBy(owner component, scope component) bool {
		let above = scopeAbove(owner)
		for {
			return false when above is none
			return true when above == scope
			above = scopeAbove(above)
		}
	}
}
