internal partial module std.ui.runtime {
	use (
		std.math.geom::(Axes, Point, Size)
		std.ui.layout::Node
		std.ui.paint
		std.units::Pixels
	)

	// A component that scrolls its child nodes. Each frame the runtime reads these into
	// the component's node, so layout sets the content out unshrunk on the scrolling axes
	// and moves it by the offset, and cuts the content off at the padding box.
	interface Scroller {
		// The axes the content scrolls on.
		def scrollAxes() Axes<bool>
		// How far the content is scrolled from its start corner.
		def scrollOffset() Point<Pixels>
		// The room a scrollbar takes from the content box; 0: none.
		def scrollbarRoom() Pixels
		// Whether that room is taken when nothing scrolls.
		def scrollbarKept() bool
		// Told after layout: the size the content was laid out in.
		def scrolled(extent Size<Pixels>)
		// Scrolls by a distance; false when the content was already as far as it goes.
		def scrollBy(by Point<Pixels>) bool
	}

	// Copies what a scrolling component says into its node; a component that does not
	// scroll leaves the node as any other.
	def rescroll(node Node, owner component) {
		if owner is Scroller {
			node.scroll = owner.scrollOffset()
			node.scrollAxes = owner.scrollAxes()
			node.scrollbar = float(owner.scrollbarRoom())
			node.scrollbarKept = owner.scrollbarKept()
			let held = node.decoration
			let decoration = new paint.Decoration()
			decoration = held unless held is none
			decoration.clip = true
			node.decoration = decoration
			return
		}
		node.scroll = none
	}

	// Tells every scrolling component under `node` the size its content took.
	def reportScroll(node Node) {
		let owner = node.owner
		if !(node.scroll is none) && !(owner is none) {
			owner.scrolled(new Size<Pixels>(node.extentW * 1(px), node.extentH * 1(px))) when owner is Scroller
		}
		for let child in node.children {
			reportScroll(child)
		}
	}
}
