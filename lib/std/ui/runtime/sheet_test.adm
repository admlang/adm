internal partial module std.ui.runtime {
	use (
		std.math.geom::Size
		std.testing
		std.ui::(StyleSheet, kind, ref, rule)
		std.ui.components
		std.ui.styles::*
		std.units::*
	)

	component SheetLeaf {
		type {
			@state
			chosen bool = false

			def seen() float {
				return style.opacity
			}

			def wide() float {
				return float(style.geom.frame.width)
			}
		}

		style {
			Box
			Compositing
			opacity = 0.5
			width   = 10(px)
			height  = 10(px)
			on      = {
				hover: {opacity: 0.75},
			}
		}

		view {}
	}

	component SheetRow {
		view {
			children()
		}

		style {
			Box
		}
	}

	component SheetPage {
		type {
			inner StyleSheet = new StyleSheet()
		}

		view {
			SheetLeaf(ref = plain)
			SheetLeaf(ref = called, style = {opacity: 0.3})
			SheetRow() {
				SheetLeaf(ref = rowed)
			}
			components.Styled(inner) {
				SheetLeaf(ref = scoped)
			}
		}

		style {
			Box
		}
	}

	// Whether both are the same style object.
	def sameLook(one ?style, other ?style) bool {
		return false when one is none || other is none
		return one == other
	}

	check "Style sheets" {
		// A rule gives the components its selector matches properties of their style,
		// under the component's own states and under what a call sets.
		@test()
		def TestRulesSetPropertiesOfTheStyle() {
			let page = SheetPage()
			let scene = new Scene(page)
			let size = new Size<Pixels>(200(px), 200(px))
			scene.styles = [new StyleSheet([
				rule(kind<SheetLeaf>(), style = {opacity: 0.4, width: 20(px)}),
				rule(kind<SheetLeaf>().inside(kind<SheetRow>()), style = {width: 30(px)}),
			])]
			scene.arrange(size)
			let (plain, called, rowed) = (page.plain, page.called, page.rowed)
			assert !(plain is none) && !(called is none) && !(rowed is none)
			return when plain is none || called is none || rowed is none
			assert plain.seen() == 0.4 && plain.wide() == 20.0
			// The more precise rule after the other; the call over both.
			assert rowed.seen() == 0.4 && rowed.wide() == 30.0
			assert called.seen() == 0.3 && called.wide() == 20.0
			// The component's own hover look stays over the rule.
			plain.isHover = true
			called.isHover = true
			scene.arrange(size)
			assert plain.seen() == 0.75 && called.seen() == 0.3
			// The look is kept from one layout to the next while nothing it was made
			// of changed; an assignment to the style shows at the next one, under the
			// rule where both set the property.
			plain.isHover = false
			scene.arrange(size)
			let first = scene.tree.children[0].kept
			scene.arrange(size)
			assert sameLook(scene.tree.children[0].kept, first)
			plain.style.height = 33(px)
			plain.style.width = 15(px)
			scene.arrange(size)
			assert float(plain.style.geom.frame.height) == 33.0 && plain.wide() == 20.0 && !sameLook(scene.tree.children[0].kept, first)
			// Without the sheet the component is as it wrote itself.
			plain.isHover = false
			scene.styles = []
			scene.arrange(size)
			assert plain.seen() == 0.5 && plain.wide() == 15.0 && rowed.wide() == 10.0
		}

		// A selector that asks for a state is asked at every layout, and a rule's `on`
		// gives states looks over the component's own.
		@test()
		def TestRulesFollowStates() {
			let page = SheetPage()
			let scene = new Scene(page)
			let size = new Size<Pixels>(200(px), 200(px))
			scene.styles = [new StyleSheet([
				rule(kind<SheetLeaf>().state("chosen"), style = {width: 40(px)}),
				rule(ref("plain").kind<SheetLeaf>(), style = {on: {hover: {opacity: 0.9}, chosen: {opacity: 0.2}}}),
			])]
			scene.arrange(size)
			let (plain, rowed) = (page.plain, page.rowed)
			assert !(plain is none) && !(rowed is none)
			return when plain is none || rowed is none
			assert plain.seen() == 0.5 && plain.wide() == 10.0
			plain.chosen = true
			scene.arrange(size)
			assert plain.wide() == 40.0 && plain.seen() == 0.2 && rowed.wide() == 10.0
			plain.chosen = false
			plain.isHover = true
			rowed.isHover = true
			scene.arrange(size)
			assert plain.wide() == 10.0 && plain.seen() == 0.9 && rowed.seen() == 0.75
		}

		// `Styled` gives what it holds a sheet of its own, after the window's; a sheet
		// that changed is read again.
		@test()
		def TestStyledScopesASheet() {
			let page = SheetPage()
			let scene = new Scene(page)
			let size = new Size<Pixels>(200(px), 200(px))
			let outer = new StyleSheet([rule(kind<SheetLeaf>(), style = {width: 20(px), opacity: 0.4})])
			scene.styles = [outer]
			page.inner.add(rule(kind<SheetLeaf>(), style = {width: 50(px)}))
			scene.arrange(size)
			let (plain, scoped) = (page.plain, page.scoped)
			assert !(plain is none) && !(scoped is none)
			return when plain is none || scoped is none
			assert plain.wide() == 20.0 && scoped.wide() == 50.0 && scoped.seen() == 0.4
			page.inner.add(rule(kind<SheetLeaf>(), style = {opacity: 0.6}))
			scene.arrange(size)
			assert scoped.seen() == 0.6 && plain.seen() == 0.4
			page.inner = new StyleSheet()
			scene.arrange(size)
			assert scoped.wide() == 20.0 && scoped.seen() == 0.4
		}

		// A rule whose selector names no kind sets each property on any style that has
		// it, its states' looks too; a style without the property is left alone.
		@test()
		def TestRulesWithoutAKind() {
			let page = SheetPage()
			let scene = new Scene(page)
			let size = new Size<Pixels>(200(px), 200(px))
			scene.styles = [new StyleSheet([
				rule(ref("rowed").inside(kind<SheetRow>()), style = {opacity: 0.2, width: 25(px)}),
				rule(ref("plain"), style = {on: {hover: {opacity: 0.85}}}),
			])]
			scene.arrange(size)
			let (plain, rowed) = (page.plain, page.rowed)
			assert !(plain is none) && !(rowed is none)
			return when plain is none || rowed is none
			assert rowed.seen() == 0.2 && rowed.wide() == 25.0
			assert plain.seen() == 0.5 && plain.wide() == 10.0
			plain.isHover = true
			scene.arrange(size)
			assert plain.seen() == 0.85
		}
	}
}
