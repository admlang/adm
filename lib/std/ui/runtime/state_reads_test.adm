internal partial module std.ui.runtime {
	use (
		std.math.geom::(Point, Size)
		std.testing
		std.ui::PointerPhase
		std.ui.styles::*
		std.units::Pixels
	)

	// How many times the views of the pages below ran.
	internal let stateRuns = 0

	internal def stateRun() int {
		stateRuns++
		return 0
	}

	internal def stateShown(on bool) int {
		stateRuns++
		return on ?? (1, 0)
	}

	// A page whose view reads none of its states.
	component StillPage {
		style {
			Box
			width  = 100(px)
			height = 100(px)
		}

		type {}

		view {
			TapCount(count = stateRun())
		}
	}

	// A page whose view shows whether the pointer is over it.
	component HoverPage {
		style {
			Box
			width  = 100(px)
			height = 100(px)
		}

		type {}

		view {
			TapCount(count = stateShown(hover))
		}
	}

	// A page whose view shows whether it is pressed.
	component PressPage {
		style {
			Box
			width  = 100(px)
			height = 100(px)
		}

		type {}

		view {
			TapCount(count = stateShown(pressed))
		}
	}

	// A square whose look is the same in every state.
	component PlainSquare {
		style {
			Box
			width  = 50(px)
			height = 50(px)
		}

		type {}

		view {}
	}

	// A square that dims under the pointer.
	component DimSquare {
		style {
			Box
			Compositing
			width  = 50(px)
			height = 50(px)
			on     = {hover: {opacity: 0.5}}
		}

		type {}

		view {}
	}

	// A page that names a plain square with `ref`.
	component PlainRefPage {
		style {
			Box
		}

		type {}

		view {
			PlainSquare(ref = square)
			TapCount(count = stateRun())
		}
	}

	// A page that names a square with a look for `hover` with `ref`.
	component DimRefPage {
		style {
			Box
		}

		type {}

		view {
			DimSquare(ref = square)
			TapCount(count = stateRun())
		}
	}

	internal let stateWindow = new Size<Pixels>(200(px), 200(px))

	check "States a view reads" {
		// A state changing runs no view that does not read it: the pointer coming over
		// a component, a press on it and the pointer leaving bring its node in step
		// only.
		@test()
		def TestAStateNoViewReadsRunsNone() {
			let page = StillPage()
			let scene = clickScene(page)
			let at = new Point<Pixels>(20(px), 20(px))
			let runs = stateRuns
			let _ = scene.pointer(PointerPhase.Move, at)
			assert page.hover && page.isStale && !page.needsBuild
			scene.arrange(stateWindow)
			assert !page.isStale
			tap(scene, at)
			scene.arrange(stateWindow)
			let _ = scene.pointer(PointerPhase.Leave, at)
			assert !page.hover
			scene.arrange(stateWindow)
			assert stateRuns == runs
		}

		// A view that reads a state runs again when that state changes.
		@test()
		def TestAStateAViewReadsRunsIt() {
			let page = HoverPage()
			let scene = clickScene(page)
			let shown = page.find<TapCount>()
			assert !(shown is none)
			return when shown is none
			let at = new Point<Pixels>(20(px), 20(px))
			let runs = stateRuns
			let _ = scene.pointer(PointerPhase.Move, at)
			scene.arrange(stateWindow)
			assert stateRuns == runs + 1 && shown.count == 1
			let _ = scene.pointer(PointerPhase.Leave, at)
			scene.arrange(stateWindow)
			assert stateRuns == runs + 2 && shown.count == 0
		}

		// And for that state alone: a view that reads `pressed` does not run when the
		// pointer comes over its component.
		@test()
		def TestAViewRunsForTheStatesItReads() {
			let page = PressPage()
			let scene = clickScene(page)
			let shown = page.find<TapCount>()
			assert !(shown is none)
			return when shown is none
			let at = new Point<Pixels>(20(px), 20(px))
			let runs = stateRuns
			let _ = scene.pointer(PointerPhase.Move, at)
			scene.arrange(stateWindow)
			assert stateRuns == runs
			let _ = scene.pointer(PointerPhase.Down, at)
			scene.arrange(stateWindow)
			assert stateRuns == runs + 1 && shown.count == 1
			let _ = scene.pointer(PointerPhase.Up, at)
			scene.arrange(stateWindow)
			assert stateRuns == runs + 2 && shown.count == 0
		}

		// A view that names a component with `ref` reads it as the layout leaves it: it
		// runs again for a state of that component its look changes with, and not for
		// one that leaves the look as it is.
		@test()
		def TestARefRunsItsHolderForAStateWithALook() {
			let at = new Point<Pixels>(20(px), 20(px))
			let plain = PlainRefPage()
			let scene = clickScene(plain)
			let runs = stateRuns
			let _ = scene.pointer(PointerPhase.Move, at)
			scene.arrange(stateWindow)
			let _ = scene.pointer(PointerPhase.Leave, at)
			scene.arrange(stateWindow)
			assert stateRuns == runs

			let dim = DimRefPage()
			let dimScene = clickScene(dim)
			runs = stateRuns
			let _ = dimScene.pointer(PointerPhase.Move, at)
			dimScene.arrange(stateWindow)
			assert stateRuns > runs
		}
	}
}
