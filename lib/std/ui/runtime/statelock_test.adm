internal partial module std.ui.runtime {
	use (
		std.testing
		std.ui.styles::Box
	)

	// Counts in a `@state` field from several tasks.
	component Counted {
		style {
			Box
		}

		type {
			@state
			count int = 0

			async def bump(times int) {
				for let i = 0; i < times; i++ {
					count = count + 1
				}
			}
		}

		view {}
	}

	check "StateLock" {
		// A statement that reads and writes a `@state` field holds the state lock, so
		// increments from two tasks are never lost.
		@test()
		def TestStateStatementsFromTwoTasks() {
			let counted = Counted()
			let a = counted.bump(2000)
			let b = counted.bump(2000)
			await a
			await b
			assert counted.count == 4000
		}
	}
}
