internal partial module std.ui.runtime {
	use (
		std.testing
		std.time
		std.ui.styles::Box
	)

	// Counts in a `@state` field from several tasks.
	component Counted {
		style {
			Box
		}

		type {
			@state
			count int = 0

			async def bump(times int) {
				for let i = 0; i < times; i++ {
					count = count + 1
				}
			}
		}

		view {}
	}

	// Asks to be drawn again from a task of its own.
	component Poked {
		style {
			Box
		}

		type {
			async def poke() {
				redraw()
			}
		}

		view {}
	}

	check "StateLock" {
		// A statement that reads and writes a `@state` field holds the state lock, so
		// increments from two tasks are never lost.
		@test()
		def TestStateStatementsFromTwoTasks() {
			let counted = Counted()
			let a = counted.bump(2000)
			let b = counted.bump(2000)
			await a
			await b
			assert counted.count == 4000
		}

		// `redraw()` from a task marks under the state lock: while the windows' loop holds
		// it (here the test, spinning without a wait, which would give it up), the task's
		// marks wait.
		@test()
		def TestRedrawFromATaskWaitsForTheLock() {
			let poked = Poked()
			poked.isStale = false
			poked.needsBuild = false
			__global_lock(1)
			let task = poked.poke()
			let start = time.now()
			for time.now().since(start) < 30ms {}
			let early = poked.isStale
			__global_unlock(1)
			await task
			assert !early && poked.isStale
		}
	}
}
