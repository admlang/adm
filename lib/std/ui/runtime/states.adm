internal partial module std.ui.runtime {
	use (
		std.reflection
		std.ui::(StyleRule, StyleSheet)
		std.ui.layout::Node
	)

	// The prelude's `@state`, as reflection names a field's annotation.
	const stateMeta = "builtin.state"

	// The `@state` fields of one component, as its style's `on` asks for them: a bool by
	// its name, an enum by the name of the case it holds.
	type StateReader {
		bools  reflection.Field[]
		enums  reflection.Field[]
		// For each of `enums`, its cases' values and their names.
		values int[][]
		names  string[][]

		def new(owner component) {
			for let (_, field) in reflection.fields(owner) {
				continue unless field.hasAttr(stateMeta)
				if field.kind == reflection.FieldKind.Bool {
					bools.push(field)
					continue
				}
				let described = field.descriptor
				continue when field.kind != reflection.FieldKind.Enum || described is none
				let (held, called) = (int[], string[])
				for let (_, member) in reflection.members(described) {
					held.push(reflection.scalarText(member.value).toInt<int>())
					called.push(member.node.name)
				}
				enums.push(field)
				values.push(held)
				names.push(called)
			}
		}

		// A number for the values of the states as they are now: another one when any
		// of them changed.
		def signature() int {
			let sum = 0
			for let field in bools {
				sum = sum * 2 + (field.asBool() ?? (1, 0))
			}
			for let field in enums {
				sum = sum * 31 + field.asInt()
			}
			return sum
		}

		// Whether the state called `name` holds now.
		def holds(name string) bool {
			for let field in bools {
				return field.asBool() when field.name == name
			}
			for let (i, field) in enums {
				let at = names[i].indexOf(name)
				return field.asInt() == values[i][at] when at >= 0
			}
			return false
		}
	}

	// What answers for the states of `owner` by name: made once for its node.
	def stateAsker(node Node, owner component) def(name string) bool {
		let asked = node.stateOf
		return asked unless asked is none
		let reader = new StateReader(owner)
		let made = def (name string) bool {
			return reader.holds(name)
		}
		node.stateOf = made
		node.statesNow = def () int {
			return reader.signature()
		}
		return made
	}

	// A number for the style sheets in `sheets` as they are now, after those `above`
	// stands for: another one when a sheet is added, taken away or changed.
	def sheetsMark(above int, sheets StyleSheet[]) int {
		let mark = above
		for let sheet in sheets {
			mark = mark * 31 + sheet.id * 7919 + sheet.version + 1
		}
		return mark
	}

	// The style sheets around what `owner` holds and their number: those around it,
	// and after them the ones it provides (`Styled`).
	def sheetsUnder(owner component, sheets StyleSheet[], mark int) (StyleSheet[], int) {
		let own StyleSheet[]
		for let held in owner.provided {
			own.push(held) when held is StyleSheet
		}
		return (sheets, mark) when own.len() == 0
		return (sheets + own, sheetsMark(mark, own))
	}

	// Keeps in `node.rules` the rules of `sheets` that can be for `owner`, in the order
	// they apply: the less precise selector first, then the outer sheet, then the order
	// written. Found again when the sheets or the component's role are other ones.
	def findRules(node Node, owner component, sheets StyleSheet[], mark int) {
		let role = int(owner.role)
		return when node.rulesOf == mark && node.rulesRole == role
		node.rulesOf = mark
		node.rulesRole = role
		node.rules.len(0)
		for let sheet in sheets {
			for let made in sheet.rules {
				continue unless made.fits(owner)
				// After the rules that are no more precise.
				let at = node.rules.len()
				for at > 0 && node.rules[at - 1].weight > made.weight {
					at--
				}
				node.rules = node.rules[:at] + [made] + node.rules[at:]
			}
		}
	}

	// The style a component is laid out and drawn with: its own, or a copy with the looks
	// others give it. Later wins: the sets of its style's `variants` it is asked for
	// (`style.variant`), in that order; what the rules of the style sheets around it
	// set, in the order `findRules` keeps them; what its style's `on` gives the states
	// that hold, in the order written, then what the variants' `on` gives them; what the
	// rules' `on` gives those states; what the call
	// that made the component sets (`style = {...}`); what that call's `on` gives the
	// states. So a rule keeps the component's own state looks, and a property set at a
	// call is not replaced by a state of the component. While no rule is for it and no
	// state holds, what the call sets is set on the style itself.
	def stateLook(node Node, owner component) style {
		let look = owner.style
		let (any, apply) = (look.onAny, look.onStates)
		let (set, siteAny, siteApply) = (owner._styleSet, owner._styleAny, owner._styleStates)
		// The rules for it, a bit each: one whose selector asks more than what the
		// component is is asked now.
		let (ruled, stated) = (0, false)
		let rules = node.rules
		for let (at, made) in rules {
			continue unless made.fixed || made.selector.matches(owner)
			ruled |= 1 << (at % 62)
			stated = true unless made.any is none
		}
		// The sets of the style's `variants` it is asked for.
		let names = look.variant
		let (variantSet, variantAny, variantStates) = (look.variantSet, look.variantAny, look.variantStates)
		let varied = names.len() > 0 && !(variantSet is none)
		let own = !(any is none) && !(apply is none)
		let site = !(siteAny is none) && !(siteApply is none)
		if !own && !site && ruled == 0 && !varied {
			set(look, owner) unless set is none
			return look
		}
		let asked = stateAsker(node, owner)
		let held = owner.heldStates()
		own = any(held, asked) when !(any is none) && own
		site = siteAny(held, asked) when !(siteAny is none) && site
		if !own && !site && ruled == 0 && !varied {
			set(look, owner) unless set is none
			look.shown = none
			return look
		}
		// The look made last time stands while everything it was made of does. What a
		// call sets, and what the style's own `on` and `variants` give, is read from values
		// that change without a trace (a field of the component, the place of another
		// one), so a look with either is made every time; a rule's values are the
		// sheet's, which says when they changed (`StyleSheet.changed`).
		let keeps = set is none && siteApply is none && !own && !varied && rules.len() <= 62
		let states = 0
		if keeps {
			let now = node.statesNow
			states = now() unless now is none
			let last = node.kept
			if !(last is none) && node.keptVersion == look.version && node.keptHeld == held && node.keptStates == states && node.keptRules == ruled && node.keptOf == node.rulesOf {
				__style_inherit(last, look.outer)
				look.shown = last
				return last
			}
		}
		let made = look.clone()
		variantSet(made, owner, names) when varied && !(variantSet is none)
		for let (at, by) in rules {
			continue when ruled & (1 << (at % 62)) == 0 || !(by.fixed || rules.len() <= 62 || by.selector.matches(owner))
			let give = by.set
			give(made, owner) unless give is none
		}
		apply(made, owner, held, asked) when own && !(apply is none)
		if varied && !(variantAny is none) && !(variantStates is none) {
			variantStates(made, owner, held, asked, names) when variantAny(held, asked, names)
		}
		if stated {
			for let (at, by) in rules {
				continue when ruled & (1 << (at % 62)) == 0 || !(by.fixed || rules.len() <= 62 || by.selector.matches(owner))
				let (some, give) = (by.any, by.states)
				continue when some is none || give is none
				give(made, owner, held, asked) when some(held, asked)
			}
		}
		set(made, owner) unless set is none
		siteApply(made, owner, held, asked) when site && !(siteApply is none)
		// A look that names fields of an inherited property changes what the copy
		// takes from above.
		__style_inherit(made, look.outer)
		// What the component reads as `style.x` while the looks hold.
		look.shown = made
		if keeps {
			node.kept = made
			node.keptVersion = look.version
			node.keptHeld = held
			node.keptStates = states
			node.keptRules = ruled
			node.keptOf = node.rulesOf
		} else {
			node.kept = none
		}
		return made
	}
}
