internal partial module std.ui.runtime {
	use (
		std.reflection
		std.ui.layout::Node
	)

	// The prelude's `@state`, as reflection names a field's annotation.
	const stateMeta = "builtin.state"

	// The `@state` fields of one component, as its style's `on` asks for them: a bool by
	// its name, an enum by the name of the case it holds.
	type StateReader {
		bools  reflection.Field[]
		enums  reflection.Field[]
		// For each of `enums`, its cases' values and their names.
		values int[][]
		names  string[][]

		def new(owner component) {
			for let (_, field) in reflection.fields(owner) {
				continue unless field.hasAttr(stateMeta)
				if field.kind == reflection.FieldKind.Bool {
					bools.push(field)
					continue
				}
				let described = field.descriptor
				continue when field.kind != reflection.FieldKind.Enum || described is none
				let (held, called) = (int[], string[])
				for let (_, member) in reflection.members(described) {
					held.push(reflection.scalarText(member.value).toInt<int>())
					called.push(member.node.name)
				}
				enums.push(field)
				values.push(held)
				names.push(called)
			}
		}

		// Whether the state called `name` holds now.
		def holds(name string) bool {
			for let field in bools {
				return field.asBool() when field.name == name
			}
			for let (i, field) in enums {
				let at = names[i].indexOf(name)
				return field.asInt() == values[i][at] when at >= 0
			}
			return false
		}
	}

	// What answers for the states of `owner` by name: made once for its node.
	def stateAsker(node Node, owner component) def(name string) bool {
		let asked = node.stateOf
		return asked unless asked is none
		let reader = new StateReader(owner)
		let made = def (name string) bool {
			return reader.holds(name)
		}
		node.stateOf = made
		return made
	}

	// The style a component is laid out and drawn with: its own, or a copy with the looks
	// its style's `on` gives the states that hold, in the order written.
	def stateLook(node Node, owner component) style {
		let look = owner.style
		let any = look.onAny
		let apply = look.onStates
		return look when any is none || apply is none
		let asked = stateAsker(node, owner)
		let held = owner.heldStates()
		return look unless any(held, asked)
		let made = look.clone()
		apply(made, held, asked)
		return made
	}
}
