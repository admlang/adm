internal partial module std.ui.runtime {
	use (
		std.math.geom::(Edges, Size)
		std.testing
		std.ui.styles::*
		std.units::Pixels
	)

	enum Mark {
		Off,
		On,
		Mixed,
	}

	style Stated {
		Box
		Compositing
		on = {
			hover:           {opacity: 0.5, on: {pressed: {opacity: 0.25}}},
			[hover, picked]: {width: 30(px)},
			Mixed:           {opacity: 0.75},
			disabled:        {opacity: 0.125},
		}
	}

	component Stateful {
		style Stated
		view {}

		type {
			@state
			picked bool = false

			@state
			mark Mark = Mark.Off

			def new() {
				style.width = 10(px)
				style.height = 10(px)
			}
		}
	}

	// A control: one `Shape` under its background, border, outline and shadows, and a
	// focus ring only while the focus is shown.
	style RingLook {
		Box
		Control
		on = {
			focusVisible: {outline: {width: 2(px)}},
		}
	}

	component Ringing {
		style RingLook
		view {}

		type {
			def new() {
				style.width = 10(px)
				style.height = 10(px)
				let edge = Border{width: 1(px)}
				style.border = new Edges<Border>(edge)
			}
		}
	}

	check "States" {
		// A style's `on` gives the looks of the states that hold: the built-in ones,
		// a `@state` bool by its name and a `@state` enum by its case, the entries in
		// the order written; the component's own style is not written into.
		@test()
		def TestStatesChangeTheLook() {
			let shown = Stateful()
			let scene = new Scene(shown)
			let size = new Size<Pixels>(100(px), 100(px))
			// The opacity and the width the component is drawn with.
			let lookNow = def () string {
				scene.arrange(size)
				let decoration = scene.tree.decoration
				return "none" when decoration is none
				return "{decoration.opacity} {float(scene.tree.geom.frame.width)}"
			}
			assert lookNow() == "1.000000 10.000000"
			shown.isHover = true
			assert lookNow() == "0.500000 10.000000"
			shown.isPressed = true
			assert lookNow() == "0.250000 10.000000"
			shown.picked = true
			assert lookNow() == "0.250000 30.000000"
			shown.isPressed = false
			shown.mark = Mark.Mixed
			assert lookNow() == "0.750000 30.000000"
			shown.mark = Mark.On
			shown.isHover = false
			assert lookNow() == "1.000000 10.000000"
			// Not enabled: neither hovered nor pressed.
			shown.isHover = true
			shown.enabled = false
			assert lookNow() == "0.125000 10.000000"
			shown.enabled = true
			shown.isHover = false
			assert lookNow() == "1.000000 10.000000"
			assert shown.style.opacity == 1.0
		}

		// A nested literal in a state changes one field of what the property holds.
		@test()
		def TestStateMergesAValue() {
			let shown = Ringing()
			let scene = new Scene(shown)
			let size = new Size<Pixels>(100(px), 100(px))
			let ring = def () string {
				scene.arrange(size)
				let decoration = scene.tree.decoration
				return "none" when decoration is none
				return "{float(decoration.outline.width)} {float(decoration.border.top.width)}"
			}
			assert ring() == "0.000000 1.000000"
			shown.isFocused = true
			assert ring() == "0.000000 1.000000"
			shown.isFocusVisible = true
			assert ring() == "2.000000 1.000000"
			assert float(shown.style.outline.width) == 0.0
		}
	}
}
