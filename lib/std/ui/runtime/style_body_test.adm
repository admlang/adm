internal partial module std.ui.runtime {
	use (
		std.gfx.color::(Color, RGBA)
		std.math.geom::(Axes, Edges, Size)
		std.testing
		std.ui::(Appearance, ColorScheme, UI)
		std.ui.styles::*
		std.units::(Extent, Pixels)
	)

	// A style whose body sets its properties: whole values, one side of a value, a
	// property read back, and a `let` of its own.
	style Fitted {
		Box
		Layout
		let side Extent = 40(px)

		width = 300(px)
		height = width
		padding = new Edges<Extent>(12(px))
		margin = {left: 16(px)}
		gap = new Axes<Extent>(side)
		arrange = Arrange.Row
		on = {
			hover: {wrap: true},
		}
	}

	component FittedBox {
		type {
			def new() {
				// The body's values are there when the constructor runs, and it may
				// change them.
				style.visible = "{style.padding.left}" == "12 px"
				style.reverse = true
			}
		}

		view {}

		style Fitted
	}

	// The same in the style a component writes in place.
	component InlineFitted {
		type {}

		view {}

		style {
			Box
			width    = 40(px)
			minWidth = 8(px)
			visible  = false
		}
	}

	// A style that embeds one whose body sets properties: that body applies first,
	// then this one.
	style Narrow {
		Fitted
		let side Extent = 7(px)

		width = 120(px)
		minWidth = side
	}

	component NarrowBox {
		type {}

		view {}

		style Narrow
	}

	// What a style's `enter` and `exit` start from, with a `let` of its own.
	style Entering {
		Compositing
		let dim float = 0.25

		enter = {opacity: 0.0}
		exit = {opacity: dim}
	}

	// A style that embeds two with `enter`, `exit` and `on` (`Stated`, of the states
	// suite) and writes its own: the embedded ones apply first, in the order named.
	style Layered {
		Stated
		Entering
		let dim float = 0.75

		width = 10(px)
		height = 10(px)
		enter = {width: 5(px)}
		on = {
			hover:   {width: 20(px)},
			pressed: {opacity: dim},
		}
	}

	component LayeredBox {
		type {}

		view {}

		style Layered
	}

	// A component whose style starts as another component's: `InlineFitted`'s properties
	// and what its style block assigns, with one value changed.
	component Mimic {
		type {}

		view {}

		style {
			InlineFitted.style
			minWidth = 9(px)
		}
	}

	// The same from a component that names its style.
	component NarrowMimic {
		type {}

		view {}

		style {
			NarrowBox.style
			height = 1(px)
		}
	}

	// A style whose body reads the theme: in an assignment, which follows the theme, and
	// in a state's look, read when the look is made.
	style Themed {
		Box
		@styleProperty
		let ink Color = new Color(RGBA{r: 0, g: 0, b: 0, a: 255})

		@styleProperty
		let shade Color = new Color(RGBA{r: 0, g: 0, b: 0, a: 255})

		width = 10(px)
		height = 10(px)
		ink = theme.palette.foreground
		// Reads a property assigned from the theme: it follows the theme with it.
		shade = ink
		on = {
			hover: {ink: theme.palette.accent},
		}
	}

	component ThemedBox {
		type {}

		view {}

		style Themed
	}

	// One that embeds it and assigns from the theme too.
	component ThemedMimic {
		type {}

		view {}

		style {
			ThemedBox.style
			ink = theme.palette.danger
		}
	}

	check "StyleBody" {
		// A style body's assignments are the values a component's style starts with:
		// each component gets its own, an embedded style's defaults stay where the body
		// says nothing, and `on` and the constructor work as before.
		@test()
		def TestStyleBodySetsProperties() {
			let first = FittedBox()
			let look = first.style
			assert "{look.width} {look.height}" == "300 px 300 px"
			assert "{look.padding.left} {look.padding.bottom}" == "12 px 12 px"
			assert "{look.margin.left} {look.margin.top}" == "16 px 0 px"
			assert "{look.gap.horizontal}" == "40 px"
			assert look.arrange == Arrange.Row && look.visible && look.reverse
			// What the body does not name keeps the embedded style's default.
			assert !look.wrap && look.minWidth is none

			// A second component has a style of its own with the same values.
			let second = FittedBox()
			second.style.width = 10(px)
			assert "{first.style.width} {second.style.width}" == "300 px 10 px"

			let plain = InlineFitted()
			let small = plain.style.minWidth
			assert "{plain.style.width}" == "40 px" && !plain.style.visible
			assert !(small is none) && "{small}" == "8 px"
		}

		@test()
		def TestEmbeddedStyleBodyApplies() {
			let box = NarrowBox()
			let look = box.style
			let least = look.minWidth
			assert "{look.width} {look.height}" == "120 px 300 px"
			assert "{look.padding.left} {look.margin.left}" == "12 px 16 px"
			assert "{look.gap.horizontal}" == "40 px"
			assert look.arrange == Arrange.Row
			assert !(least is none) && "{least}" == "7 px"
		}

		// What a style body assigns from `theme` is there when the constructor runs and is
		// assigned again when the theme changes; a state's look reads the theme of the moment.
		@test()
		def TestStyleFollowsTheTheme() {
			let theme = UI.theme()
			theme.follow(Appearance{scheme: ColorScheme.Light})
			let shown = ThemedBox()
			let mimic = ThemedMimic()
			let light = theme.palette.foreground
			assert shown.style.ink == light && shown.style.shade == light
			assert mimic.style.ink == theme.palette.danger
			let scene = new Scene(shown)
			let size = new Size<Pixels>(100(px), 100(px))
			scene.arrange(size)
			// Set by hand: kept when the theme changes.
			shown.style.width = 30(px)
			theme.follow(Appearance{scheme: ColorScheme.Dark})
			let dark = theme.palette.foreground
			assert light != dark && shown.style.ink == light
			scene.arrange(size)
			assert shown.style.ink == dark && shown.style.shade == dark && "{shown.style.width}" == "30 px"
			shown.isHover = true
			let look = stateLook(scene.tree, shown)
			assert look is Themed && look.ink == theme.palette.accent
			// The component's own style is not written into by a state.
			assert shown.style.ink == dark
			theme.follow(Appearance{})
		}

		// `Component.style` on a line of its own embeds that component's style.
		@test()
		def TestComponentStyleIsEmbedded() {
			let look = Mimic().style
			let least = look.minWidth
			assert "{look.width}" == "40 px" && !look.visible
			assert !(least is none) && "{least}" == "9 px"

			let narrow = NarrowMimic().style
			assert "{narrow.width} {narrow.height}" == "120 px 1 px"
			assert "{narrow.gap.horizontal} {narrow.padding.left}" == "40 px 12 px"
		}

		// `enter`, `exit` and `on` of the embedded styles come along, and this style's
		// own are applied after them. A state the component does not have never holds.
		@test()
		def TestEmbeddedStylePatchesApply() {
			let shown = LayeredBox()
			let look = shown.style
			let enter = look.enter
			let exit = look.exit
			let entering = look.clone()
			let leaving = look.clone()
			if !(enter is none) {
				enter(entering)
			}
			if !(exit is none) {
				exit(leaving)
			}
			assert entering is Layered && entering.opacity == 0.0 && "{entering.width}" == "5 px"
			// The embedded style's own `let`, not this style's of the same name.
			assert leaving is Layered && leaving.opacity == 0.25 && "{leaving.width}" == "10 px"

			let scene = new Scene(shown)
			let size = new Size<Pixels>(100(px), 100(px))
			let lookNow = def () string {
				scene.arrange(size)
				let decoration = scene.tree.decoration
				return "none" when decoration is none
				return "{decoration.opacity} {float(scene.tree.geom.frame.width)}"
			}
			assert lookNow() == "1.000000 10.000000"
			shown.isHover = true
			assert lookNow() == "0.500000 20.000000"
			shown.isPressed = true
			assert lookNow() == "0.750000 20.000000"
			shown.isPressed = false
			shown.isHover = false
			assert lookNow() == "1.000000 10.000000"
		}
	}
}
