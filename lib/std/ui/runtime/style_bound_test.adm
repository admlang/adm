internal partial module std.ui.runtime {
	use (
		std.math.geom::Size
		std.testing
		std.ui.styles::*
		std.units::Pixels
	)

	component BoundLeaf {
		type {}

		view {}

		style {
			Box
			width  = 40(px)
			height = 20(px)
		}
	}

	// A style that takes values from the components around its own: as tall as the
	// sibling before it, as wide as its parent, no higher than the top of the tree is
	// wide. It has no sibling after it, so that assignment is not made.
	component BoundFollower {
		type {}

		view {}

		style {
			Box
			width     = $parent.geom.frame.width
			height    = $prev.geom.frame.height
			maxHeight = $root.geom.frame.width
			minHeight = $next.geom.frame.height
			// A line of another component, moved: layout follows it.
			anchors = {top: $prev.geom.bottom + 2(px)}
		}
	}

	// A style that reads a `ref` of its component's view, in one field of a value.
	component BoundPair {
		type {
			// `$x` reads as `x.style` anywhere a component has a name.
			def leadWidth() string {
				let held = lead
				return "" when held is none
				return "{$held.width}"
			}
		}

		view {
			BoundLeaf(ref = lead)
			BoundFollower(ref = tail)
		}

		style {
			Box
			Layout
			width   = 80(px)
			arrange = Arrange.Column
			padding = {top: $lead.geom.frame.height}
		}
	}

	// Two components that take their width from each other: they never come to rest.
	component BoundGrower {
		type {}

		view {}

		style {
			Box
			width  = 10(px)
			height = 10(px)
			width  = $prev.geom.frame.width + 10(px)
			width  = $next.geom.frame.width + 10(px)
		}
	}

	component BoundRace {
		type {}

		view {
			BoundGrower()
			BoundGrower()
		}

		style {
			Box
			Layout
			arrange = Arrange.Row
		}
	}

	check "StyleBound" {
		// `$x` is the style of another component: an assignment that reads one is made
		// before each layout, with what the last layout gave that component.
		@test()
		def TestStyleReadsOtherComponents() {
			let shown = BoundPair()
			let scene = new Scene(shown)
			let size = new Size<Pixels>(200(px), 200(px))
			// The first layout puts the components somewhere, the second gives the styles
			// what the first found; the scene asks for a frame until a layout moves nothing.
			scene.arrange(size)
			assert scene.follows && scene.unsettled == 1
			let layouts = 1
			for scene.unsettled > 0 && layouts < 8 {
				scene.arrange(size)
				layouts += 1
			}
			assert scene.unsettled == 0 && layouts == 3
			// At rest, another layout moves nothing and asks for nothing.
			scene.arrange(new Size<Pixels>(300(px), 200(px)))
			assert scene.unsettled == 0
			assert "{shown.style.padding.top} {shown.style.padding.left}" == "20 px 0 px"
			assert shown.leadWidth() == "40 px"
			let tail = shown.tail
			assert !(tail is none)
			if !(tail is none) {
				let look = tail.style
				let most = look.maxHeight
				assert "{look.width} {look.height}" == "80 px 20 px"
				assert !(most is none) && "{most}" == "80 px"
				assert look.minHeight is none
				let top = look.anchors.top
				assert !(top is none)
				if !(top is none) {
					assert !(top.edge is none) && "{top.offset}" == "2 px" && !(top.target is none)
				}
			}
		}

		// Components that take their size from each other are laid out a few times in a
		// row by the scene's own asking, then left, with one warning.
		@test()
		def TestStylesThatNeverRestAreLeft() {
			let scene = new Scene(BoundRace())
			let size = new Size<Pixels>(400(px), 100(px))
			let told = 0
			for let i = 0; i < 12; i++ {
				// As the UI service says of a frame asked for by the scene alone.
				scene.settling = i > 0
				told += scene.arrange(size).len()
			}
			assert scene.unsettled == 12 && told == 1
			// Any other frame starts the count again.
			scene.arrange(size)
			assert scene.unsettled == 1
		}
	}
}
