internal partial module std.ui.runtime {
	use (
		std.math.geom::Size
		std.testing
		std.ui::(Appearance, ColorScheme, UI)
		std.ui.styles::*
		std.units::Pixels
	)

	// The style of a generic component names the component and its refs: its
	// assignments are made for each instance, with the instance's own types.
	component GenericRows<T> {
		type {
			@input(value = true)
			items T[] = []

			@input
			wide def(T) bool = def (item T) bool {
				return false
			}

			def widest() bool {
				for let item in items {
					return true when wide(item)
				}
				return false
			}
		}

		view {
			BoundLeaf(ref = head)
		}

		style {
			Box
			width     = 10(px) * self.items.len()
			height    = self.widest() ?? (40(px), 20(px))
			maxHeight = $head.geom.frame.height
		}
	}

	// Embeds a style whose body assigns, reads the theme and has states, and adds
	// its own of each: every function of the style is the instance's.
	component GenericCard<T> {
		type {
			@input(value = true)
			items T[] = []

			@state
			picked bool = false
		}

		view {}

		style {
			ThemedBox.style
			ink    = theme.palette.danger
			height = 10(px) * self.items.len()
			on     = {
				picked: {width: 30(px)},
			}
		}
	}

	check "StyleOfGenericComponent" {
		@test()
		def TestEachInstanceHasItsStyle() {
			let words = GenericRows(["a", "b", "c"])
			let counts = GenericRows([1, 200], wide = def (n int) bool {
				return n > 100
			})
			let size = new Size<Pixels>(200(px), 200(px))
			for let shown in [new Scene(words), new Scene(counts)] {
				shown.arrange(size)
				shown.arrange(size)
			}
			let most = words.style.maxHeight
			assert "{words.style.width} {words.style.height}" == "30 px 20 px"
			assert !(most is none) && "{most}" == "20 px"
			assert "{counts.style.width} {counts.style.height}" == "20 px 40 px"
		}

		@test()
		def TestEmbeddedBodiesApplyToAnInstance() {
			let theme = UI.theme()
			theme.follow(Appearance{scheme: ColorScheme.Light})
			let card = GenericCard([1.5, 2.5])
			let names = GenericCard(["a"])
			assert card.style.ink == theme.palette.danger && card.style.shade == theme.palette.foreground
			let size = new Size<Pixels>(100(px), 100(px))
			let scene = new Scene(card)
			scene.arrange(size)
			new Scene(names).arrange(size)
			assert "{card.style.width} {card.style.height}" == "10 px 20 px"
			assert "{names.style.height}" == "10 px"
			// A state of the component, then one of the embedded style's.
			card.picked = true
			scene.arrange(size)
			assert "{float(scene.tree.geom.frame.width)}" == "30.000000"
			let own = card.style
			assert "{own.width}" == "10 px" && "{card.style.width}" == "30 px"
			// What the instance's body took from the theme follows it.
			theme.follow(Appearance{scheme: ColorScheme.Dark})
			scene.arrange(size)
			assert card.style.ink == theme.palette.danger && card.style.shade == theme.palette.foreground
			theme.follow(Appearance{})
		}
	}
}
