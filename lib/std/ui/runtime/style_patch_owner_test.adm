internal partial module std.ui.runtime {
	use (
		std.math.geom::Size
		std.testing
		std.ui.styles::*
		std.units::(Extent, Pixels)
	)

	// A style whose `on`, `enter` and `exit` read the component (`self`) and the
	// components around it (`$x`): each value is taken when the look is made.
	component OwnerLook {
		type {
			@input
			wide Extent = 30(px)

			@state
			picked bool = false
		}

		view {
			BoundLeaf(ref = lead)
		}

		style {
			Box
			Compositing
			width  = 10(px)
			height = 10(px)
			on     = {
				hover:  {width: self.wide},
				picked: {height: $lead.geom.frame.width, on: {hover: {width: $parent.geom.frame.width}}},
			}
			enter = {width: self.wide, height: $parent.geom.frame.height}
			exit  = {width: $lead.geom.frame.height, opacity: 0.0}
		}
	}

	component OwnerHolder {
		type {}

		view {
			OwnerLook(wide = 70(px), ref = held)
		}

		style {
			Box
			width  = 120(px)
			height = 90(px)
		}
	}

	check "StylePatchOwner" {
		// The look of a state reads the component and its neighbours as they are then.
		@test()
		def TestStatesReadTheComponent() {
			let holder = OwnerHolder()
			let scene = new Scene(holder)
			let size = new Size<Pixels>(200(px), 200(px))
			scene.arrange(size)
			let shown = holder.held
			assert !(shown is none)
			return when shown is none
			let node = scene.tree.children[0]
			let lookNow = def () string {
				let look = stateLook(node, shown)
				return "?" unless look is Boxed
				return "{look.width} {look.height}"
			}
			assert lookNow() == "10 px 10 px"
			shown.isHover = true
			assert lookNow() == "70 px 10 px"
			shown.wide = 45(px)
			assert lookNow() == "45 px 10 px"
			shown.picked = true
			// The leaf is 40 wide; hovered and picked, as wide as the holder.
			assert lookNow() == "120 px 40 px"
			shown.isHover = false
			assert lookNow() == "10 px 40 px"
			let own = shown.style
			assert "{own.width} {own.height}" == "10 px 10 px"
		}

		// So do the looks a component appears from and leaves to. A component that
		// is not there leaves its assignment out.
		@test()
		def TestEnterAndExitReadTheComponent() {
			let holder = OwnerHolder()
			let scene = new Scene(holder)
			scene.arrange(new Size<Pixels>(200(px), 200(px)))
			let shown = holder.held
			assert !(shown is none)
			return when shown is none
			let enter = shown.style.enter
			let exit = shown.style.exit
			assert !(enter is none) && !(exit is none)
			return when enter is none || exit is none
			let from = shown.style.clone()
			enter(from, shown)
			assert from is Boxed && "{from.width} {from.height}" == "70 px 90 px"
			let to = shown.style.clone()
			exit(to, shown)
			assert to is Boxed && "{to.width}" == "20 px"
			assert to is Composited && to.opacity == 0.0

			// Alone, it has no parent: that assignment is not made.
			let alone = OwnerLook()
			let made = alone.style.enter
			assert !(made is none)
			return when made is none
			let look = alone.style.clone()
			made(look, alone)
			assert look is Boxed && "{look.width} {look.height}" == "30 px 10 px"
		}
	}
}
