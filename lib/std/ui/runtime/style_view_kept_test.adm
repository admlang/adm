internal partial module std.ui.runtime {
	use (
		std.testing
		std.ui.styles::*
		std.units::Pixels
	)

	// What a style holds for a datatype is taken as a value of the datatype: kept in a
	// field, a local or an array, passed and returned. It is the values of the moment,
	// as a datatype value made from any other object is.
	type KeptLooks {
		boxed ?Boxed      = none
		faded ?Composited = none
		all   Boxed[]     = []
	}

	def widthOf(look Boxed) string {
		return "{look.width}"
	}

	def boxedOf(look style) ?Boxed {
		return look when look is Boxed
		return none
	}

	check "StyleViewKept" {
		@test()
		def TestANarrowedStyleIsKeptAsAValue() {
			let shown = Stateful()
			// Held by its kind, and by its declaration: a `Stated` has what `Boxed` asks.
			let look style = shown.style
			let typed = shown.style
			let whole Boxed = typed
			assert typed is Boxed
			assert "{whole.width}" == "10 px"
			let found = new KeptLooks()
			if look is Boxed {
				found.boxed = look
				found.all.push(look)
				let held Boxed = look
				assert "{held.width} {held.height}" == "10 px 10 px"
				assert widthOf(look) == "10 px"
				// The view writes the style; what was kept has the values it took.
				look.width = 40(px)
				assert "{held.width}" == "10 px" && widthOf(look) == "40 px"
			}
			found.faded = look when look is Composited
			let boxed = found.boxed
			assert !(boxed is none)
			return when boxed is none
			assert "{boxed.width} {boxed.height}" == "10 px 10 px"
			assert widthOf(found.all[0]) == "10 px"
			let faded = found.faded
			assert !(faded is none) && faded.opacity == 1.0
			let again = boxedOf(shown.style)
			assert !(again is none) && "{again.width}" == "40 px"
		}
	}
}
