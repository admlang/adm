// What each std style holds, as datatypes: a style that embeds a std style satisfies its
// datatype, so the runtime reads any component's style through the ones it satisfies
// (`if look is Boxed { look.width … }`).
internal partial module std.ui.runtime {
	use (
		std.gfx.color::BlendMode
		std.math.geom::(Axes, Corners, Edges)
		std.ui::Geometry
		std.ui.styles::*
		std.units::(Extent, Pixels)
	)

	// `Style<T>`: every style.
	datatype Placed {
		geom Geometry
	}

	// `Box`.
	datatype Boxed {
		width, height       Sizing
		minWidth, minHeight ?Extent
		maxWidth, maxHeight ?Extent
		margin, padding     Edges<Extent>
		position            Position
		anchors             Anchors
		layer               Layer
		visible             bool
		align               Align
		direction           ?Direction
	}

	// `Layout`.
	datatype Arranged {
		arrange    Arrange
		gap        Axes<Extent>
		distribute Distribute
		wrap       bool
		reverse    bool
	}

	// `Tracks`.
	datatype Tracked {
		columns, rows TrackList
		autoTrack     Track
		flow          GridFlow
		dense         bool
	}

	// A child property of `Layout`, on the style of a child that sets it.
	datatype SelfAligned {
		alignSelf ?Align
	}

	// A child property of `Tracks`, on the style of a child that sets it.
	datatype Celled {
		cell Cell
	}

	// `Shape`.
	datatype Shaped {
		radius  Corners<Extent>
		corners CornerShape
	}

	// `Background`.
	datatype Filled {
		background BackgroundFill
	}

	// `Borders`.
	datatype Bordered {
		border      Edges<Border>
		borderImage ?NineSlice
	}

	// `Outline`.
	datatype Ringed {
		outline Ring
	}

	// `Shadows`.
	datatype Shadowed {
		shadows Shadow[]
	}

	// `Filters`.
	datatype Filtered {
		filters Filter[]
	}

	// `Backdrop`.
	datatype Backed {
		backdrop Filter[]
	}

	// `Compositing`.
	datatype Composited {
		opacity float
		blend   BlendMode
	}

	// `Motion`.
	datatype Moved {
		transition Transition
	}

	// `Transforms`.
	datatype Transformed {
		transform Transform
	}

	// `Clipping`.
	datatype Clipped {
		clip bool
		mask ?Paint
	}

	// `Interaction`: the pointer's shape over the component.
	datatype Cursored {
		cursor ?CursorShape
	}

	// `Interaction`.
	datatype Pointed {
		hitTest   HitTest
		hitSlop   Edges<Pixels>
		minTarget Pixels
	}

	// `Typography`: the font, whose size is what `1(em)` is below the component.
	datatype Lettered {
		font ?Font
	}
}
