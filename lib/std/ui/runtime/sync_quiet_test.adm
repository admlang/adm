internal partial module std.ui.runtime {
	use (
		std.gfx.canvas
		std.math.geom::(Point, Size)
		std.testing
		std.ui::(PointerPhase, RenderContext)
		std.ui.components
		std.ui.layout::Node
		std.time
		std.ui.styles::*
		std.units::Pixels
	)

	style QuietLook {
		Box
		Compositing
		on = {
			hover:    {opacity: 0.5},
			disabled: {opacity: 0.25},
		}
	}

	style QuietLeafLook {
		QuietLook
		on = {
			lit: {opacity: 0.75},
		}
	}

	component QuietLeaf {
		style QuietLeafLook
		view {}

		type {
			@state
			lit bool = false

			def new() {
				style.width = 10(px)
				style.height = 10(px)
			}
		}
	}

	// A leaf whose field another component's `render` sets.
	component QuietTarget {
		style QuietLook
		view {}

		type {
			at int = 0

			def new() {
				style.width = 10(px)
				style.height = 10(px)
			}
		}
	}

	// Sets its child's field in its `render`, as a page scrolls its scroll view to an
	// anchor when it is drawn.
	component QuietMover {
		style QuietLook
		view {
			QuietTarget()
		}

		type {
			pending int = 0

			def render(ctx RenderContext) {
				ctx.childNodes()
				let held = find<QuietTarget>()
				return when held is none || pending == 0
				held.at = pending
				pending = 0
			}
		}
	}

	// Two leaves, and a third while `extra` holds.
	component QuietRow {
		style QuietLook
		view {
			QuietLeaf()
			QuietLeaf()
			QuietLeaf() when extra
		}

		type {
			extra bool = false
		}
	}

	component QuietPage {
		style QuietLook
		view {
			QuietRow()
			QuietRow()
		}
	}

	// A scrolled column of leaves, and a text that shows `words`.
	component QuietScroll {
		style QuietLook
		view {
			components.ScrollView() {
				components.Column() {
					for let i = 0; i < 30; i++ {
						QuietLeaf()
					}
				}
			}
			components.Text(words)
		}

		type {
			words string = ""

			def new() {
				style.width = fill
				style.height = fill
			}
		}
	}

	// A block that turns red under the pointer, as a control does.
	component QuietSpot {
		view {}

		style {
			Box
			Layout
			Background
			Control
			width      = 40(px)
			height     = 20(px)
			background = new BackgroundFill(tint(0, 0, 255))
			on         = {
				hover: {background: new BackgroundFill(tint(255, 0, 0))},
			}
		}
	}

	component QuietSpots {
		style {
			Box
			Layout
		}
		view {
			QuietSpot()
			QuietSpot()
		}
	}

	// Does `act` to the `at`-th leaf of the `row`-th row of a `QuietPage`; false when
	// that is no `QuietLeaf`.
	def onLeaf(page component, row int, at int, act def(leaf QuietLeaf)) bool {
		let held = page.childNodes[row].childNodes[at]
		return false unless held is QuietLeaf
		act(held)
		return true
	}

	// The opacity the node of the `at`-th leaf of the `row`-th row is drawn with.
	def quietOpacity(scene Scene, row int, at int) float {
		let decoration = scene.tree.children[row].children[at].decoration
		return 1.0 when decoration is none
		return decoration.opacity
	}

	check "SyncQuiet" {
		// A store that changes a field the node copies, or a `@state` field, marks the
		// component stale; one that stores the value it held does not.
		@test()
		def TestStoresMarkTheComponentStale() {
			let leaf = QuietLeaf()
			leaf.isStale = false
			leaf.isHover = false
			assert !leaf.isStale
			leaf.isHover = true
			assert leaf.isStale
			leaf.isStale = false
			leaf.lit = true
			assert leaf.isStale
			leaf.isStale = false
			leaf.enabled = false
			assert leaf.isStale
			leaf.isStale = false
			leaf.provide(3)
			assert leaf.isStale
		}

		// Nodes whose components changed nothing are left as they are: the leaves, the
		// rows and the page are in step after a layout, and a layout with nothing changed
		// leaves them so.
		@test()
		def TestUnchangedNodesStayInStep() {
			let page = QuietPage()
			let scene = new Scene(page)
			let size = new Size<Pixels>(200(px), 200(px))
			scene.arrange(size)
			scene.arrange(size)
			assert !scene.tree.live
			assert !scene.tree.children[1].live
			assert !scene.tree.children[1].children[0].live
			assert onLeaf(page, 1, 0, def (leaf QuietLeaf) {
				assert !leaf.isStale
			})
			assert quietOpacity(scene, 1, 0) == 1.0
		}

		// A change deep under nodes that are in step is found: a state, a `@state`
		// field, a component above that is no longer enabled, a property of a style, a
		// child its view adds.
		@test()
		def TestChangesUnderQuietNodesAreFound() {
			let page = QuietPage()
			let scene = new Scene(page)
			let size = new Size<Pixels>(200(px), 200(px))
			scene.arrange(size)
			scene.arrange(size)
			assert onLeaf(page, 1, 1, def (leaf QuietLeaf) {
				leaf.isHover = true
			})
			scene.arrange(size)
			assert quietOpacity(scene, 1, 1) == 0.5
			assert quietOpacity(scene, 1, 0) == 1.0
			assert onLeaf(page, 0, 0, def (leaf QuietLeaf) {
				leaf.lit = true
			})
			scene.arrange(size)
			assert quietOpacity(scene, 0, 0) == 0.75
			page.childNodes[1].enabled = false
			scene.arrange(size)
			assert quietOpacity(scene, 1, 0) == 0.25
			assert quietOpacity(scene, 1, 1) == 0.25
			assert quietOpacity(scene, 0, 1) == 1.0
			page.childNodes[1].enabled = true
			scene.arrange(size)
			assert quietOpacity(scene, 1, 0) == 1.0
			assert quietOpacity(scene, 1, 1) == 0.5
			assert onLeaf(page, 0, 1, def (leaf QuietLeaf) {
				leaf.style.width = 30(px)
			})
			scene.arrange(size)
			assert float(scene.tree.children[0].children[1].geom.frame.width) == 30.0
			let row = page.childNodes[0]
			if row is QuietRow {
				row.extra = true
			}
			scene.arrange(size)
			assert scene.tree.children[0].children.len() == 3
		}

		// The pointer moving onto a leaf under nodes in step gives it its hover look, and
		// moving off takes it away.
		@test()
		def TestPointerHoverReachesQuietNodes() {
			let page = QuietPage()
			let scene = new Scene(page)
			let size = new Size<Pixels>(200(px), 200(px))
			scene.arrange(size)
			scene.arrange(size)
			let at = scene.tree.children[1].children[1].geom.frame
			let inside = new Point<Pixels>(at.left + 2(px), at.top + 2(px))
			let _ = scene.pointer(PointerPhase.Move, inside)
			scene.arrange(size)
			assert quietOpacity(scene, 1, 1) == 0.5
			let _ = scene.pointer(PointerPhase.Move, new Point<Pixels>(199(px), 199(px)))
			scene.arrange(size)
			assert quietOpacity(scene, 1, 1) == 1.0
		}

		// The hover look of a control is drawn once its transition ends: the pointer onto
		// the first block, then off it.
		// A `render` that sets another component's field marks that one for the next
		// frame; what it keeps in its own fields marks nothing.
		@test()
		def TestAStoreFromAnotherRenderMarks() {
			let mover = QuietMover()
			let scene = new Scene(mover)
			let size = new Size<Pixels>(50(px), 50(px))
			let surface = new canvas.Canvas(50, 50)
			scene.arrange(size)
			scene.paint(surface)
			let held = mover.find<QuietTarget>()
			assert !(held is none)
			return when held is none
			mover.pending = 7
			scene.arrange(size)
			scene.paint(surface)
			assert held.at == 7 && held.isStale && !mover.isStale
			scene.arrange(size)
			assert !held.isStale
		}

		@test()
		def TestHoverIsDrawn() {
			let shown = QuietSpots()
			let scene = new Scene(shown)
			let size = new Size<Pixels>(100(px), 100(px))
			let surface = new canvas.Canvas(100, 100)
			let t0 = time.now()
			let at = def (since duration) {
				scene.clock = t0 + since
				scene.arrange(size)
				scene.paint(surface)
			}
			at(0ms)
			at(10ms)
			assert inked(surface, 5, 5, 0, 0, 255)
			let _ = scene.pointer(PointerPhase.Move, new Point<Pixels>(5(px), 5(px)))
			at(20ms)
			at(2s)
			at(2010ms)
			assert inked(surface, 5, 5, 255, 0, 0)
			assert inked(surface, 5, 25, 0, 0, 255)
			let _ = scene.pointer(PointerPhase.Move, new Point<Pixels>(90(px), 90(px)))
			at(2020ms)
			at(4s)
			at(4010ms)
			assert inked(surface, 5, 5, 0, 0, 255)
		}

		// What code that may read anything gives is read again under nodes in step: where
		// a scrolling component is scrolled to, and the first baseline of a text.
		@test()
		def TestQuietNodesReadScrollAndBaselines() {
			let shown = QuietScroll()
			let scene = new Scene(shown)
			let size = new Size<Pixels>(200(px), 100(px))
			scene.arrange(size)
			scene.arrange(size)
			let scroller = scene.tree.children[0]
			let text = scene.tree.children[1]
			assert !scroller.live
			assert !text.live
			assert text.baseline is none
			let column = shown.childNodes[0]
			if column is components.ScrollView {
				assert column.scrollBy(new Point<Pixels>(0(px), 40(px)))
			}
			shown.words = "Words"
			scene.arrange(size)
			let offset = scroller.scroll
			assert !(offset is none) && float(offset.y) == 40.0
			assert !(text.baseline is none)
		}

		// Two looks of one style are the same while every property holds the same value,
		// as an assignment that counts compares them.
		@test()
		def TestLooksCompareByValue() {
			let leaf = QuietLeaf()
			let one = leaf.style.clone()
			let two = leaf.style.clone()
			assert one != two
			assert __style_same(one, two)
			if two is QuietLeafLook {
				two.width = 10(px)
			}
			assert __style_same(one, two)
			if two is QuietLeafLook {
				two.width = 20(px)
			}
			assert !__style_same(one, two)
			assert !__style_same(one, QuietPage().style)
			let spot = QuietSpot()
			let blue = spot.style.clone()
			let red = spot.style.clone()
			if red is Filled {
				red.background = new BackgroundFill(tint(255, 0, 0))
			}
			assert !__style_same(blue, red)
		}

		// The look a state that holds makes on every layout is copied into the node once:
		// a copy that holds the same values as the one before changes nothing.
		@test()
		def TestAHeldStateIsCopiedOnce() {
			let page = QuietPage()
			let scene = new Scene(page)
			let size = new Size<Pixels>(200(px), 200(px))
			scene.arrange(size)
			assert onLeaf(page, 1, 1, def (leaf QuietLeaf) {
				leaf.isHover = true
			})
			scene.arrange(size)
			let node = scene.tree.children[1].children[1]
			let hovered = page.childNodes[1].childNodes[1]
			let (_, copied) = restyle(node, hovered, node.syncedEm, true)
			assert !copied
			assert quietOpacity(scene, 1, 1) == 0.5
			hovered.isHover = false
			let (_, again) = restyle(node, hovered, node.syncedEm, true)
			assert again
		}
	}
}
