internal partial module std.ui.runtime {
	use (
		std.math.geom::Size
		std.testing
		std.time
		std.ui.styles::*
		std.units::Pixels
	)

	let watchShown = [true]

	// Starts a task in `tasks` when it is attached, which reports that it runs and,
	// once it is cancelled, that it was.
	component Watcher {
		style {
			Box
		}

		type {
			started channel<bool>
			told channel<bool>
			// A task `detached` started in `tasks`: never runs, the scope being
			// cancelled by then.
			late ?(async none) = none

			def new() {
				started = new channel<bool>(size = 4)
				told    = new channel<bool>(size = 4)
			}

			def attached() {
				async<tasks> watch()
			}

			def detached() {
				late = async<tasks> watch()
			}

			async def watch() {
				started <- true
				time.sleep(30s)
				told <- canceled()
			}
		}

		view {}
	}

	component Watches {
		style {
			Box
		}

		view {
			if watchShown[0] {
				Watcher()
			}
		}
	}

	check "Tasks" {
		// A task started in `tasks` runs while the component is in the tree and is
		// cancelled when it leaves, before `detached`; attached again, it starts in a
		// new scope.
		@test()
		def TestTasksEndWithTheirComponent() {
			watchShown = [true]
			let watches = Watches()
			let scene = new Scene(watches)
			let size = new Size<Pixels>(100(px), 100(px))
			scene.arrange(size)
			let watcher = watches.children[0]
			assert watcher is Watcher
			if watcher is Watcher {
				assert <- watcher.started
				let first = watcher.tasks
				assert first.running()
				watchShown = [false]
				// The view reads a global, which no store of the component marks.
				watches.redraw()
				scene.arrange(size)
				assert watches.children.len() == 0
				assert <- watcher.told
				let _ = first.wait()
				let late = watcher.late
				assert !first.running()
				assert !(late is none)
				assert late.done() unless late is none
				assert watcher.started.len() == 0 && watcher.told.len() == 0
			}
		}

		// A component that never reads `tasks` makes no scope.
		@test()
		def TestTasksAreMadeWhenRead() {
			let quiet = Watches()
			watchShown = [false]
			let scene = new Scene(quiet)
			scene.arrange(new Size<Pixels>(100(px), 100(px)))
			assert quiet._tasks is none
		}

		// A task started in `tasks` after the component left never runs; attached
		// again, the component starts its tasks in a new scope.
		@test()
		def TestTasksAfterDetach() {
			let watcher = Watcher()
			let scene = new Scene(watcher)
			let size = new Size<Pixels>(100(px), 100(px))
			scene.arrange(size)
			assert <- watcher.started
			let first = watcher.tasks
			detach(scene.tree)
			assert <- watcher.told
			let _ = first.wait()
			assert watcher.tasks == first && watcher.started.len() == 0
			reattach(scene.tree)
			assert watcher.tasks != first
			assert <- watcher.started
			detach(scene.tree)
			assert <- watcher.told
		}
	}
}
