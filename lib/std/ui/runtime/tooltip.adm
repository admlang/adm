internal partial module std.ui.runtime {
	use (
		std.gfx.canvas
		std.math.geom::(Corners, Edges, Point)
		std.time
		std.ui::(Limit, UI)
		std.ui.frames
		std.ui.layout::Node
		std.ui.paint
		std.ui.styles::*
		std.units::(Extent, Pixels)
	)

	// The widest a tooltip's text is set, and how far under the pointer it starts, in
	// logical pixels.
	const tipWidth = 320.0
	const tipDrop = 20.0

	// The `tooltip` text of the component the pointer rests on or the keyboard moved the
	// focus to. It is drawn by a node of the scene's own, in the Tooltip layer, that lets
	// the pointer through; the node is under the tree's root only while the text shows.
	type Tip {
		// The node whose component's tooltip is wanted; none: nothing.
		target ?Node            = none
		// When the pointer came to rest on it or the focus reached it, and where the
		// pointer was then.
		since  time.Time
		at     Point<Pixels>    = new Point<Pixels>(0(px), 0(px))
		// The focus brought it: it shows under the component, not under the pointer.
		byKey  bool
		// What draws it, and its text as set last.
		node   Node             = new Node()
		block  ?paint.TextBlock = none
		// Whether `node` is under the tree's root now.
		placed bool
	}

	// The nearest node at or above `from` whose component has a tooltip.
	def tipHolder(from ?Node) ?Node {
		let at = from
		for {
			return none when at is none
			let owner = at.owner
			if !(owner is none) {
				return at when owner.tooltip != "" && !owner.disabled
			}
			at = at.parent
		}
	}

	// Notes what the tooltip is wanted for now: the component at or above `from` that has
	// one. Another component than before starts its wait again; none hides it.
	def watchTip(scene Scene, from ?Node, at Point<Pixels>, byKey bool) {
		let tip = scene.tip
		let holder = tipHolder(from)
		let had = tip.target
		let same = (holder is none) == (had is none)
		same = holder == had when same && !(holder is none) && !(had is none)
		return when same
		scene.touched = true when tip.placed
		tip.target = holder
		return when holder is none
		tip.since = time.now()
		tip.at = at
		tip.byKey = byKey
		wakeBy(tip.since + scene.tipDelay)
	}

	// Hides the tooltip until the pointer or the focus reaches another component.
	def dropTip(scene Scene) {
		scene.touched = true when scene.tip.placed
		scene.tip.target = none
	}

	// Takes the tooltip's node out of the tree, so that the tree mirrors the components
	// alone while it is brought in step with them.
	def liftTip(scene Scene) {
		let tip = scene.tip
		return when !tip.placed
		tip.placed = false
		let under = scene.tree.children
		let last = under.len() - 1
		under.remove(last) when last >= 0 && under[last] == tip.node
	}

	// Puts the tooltip's node under the root when its component was rested on for the
	// scene's delay: under the pointer, or under the component the focus is on, moved
	// inside the window and above when there is no room below.
	def placeTip(scene Scene) {
		let tip = scene.tip
		let target = tip.target
		return when target is none
		let owner = target.owner
		if owner is none || !inTree(scene, target) || owner.tooltip == "" {
			tip.target = none
			return
		}
		let due = tip.since + scene.tipDelay
		if time.now() < due {
			wakeBy(due)
			return
		}
		let theme = UI.theme()
		let palette = theme.palette
		let metrics = theme.metrics
		let block = tipBlock(tip, owner.tooltip)
		block.foreground = palette.foreground

		let node = tip.node
		let decoration = decorationIn(node)
		decoration.background = new BackgroundFill(palette.overlay)
		let radius Extent = metrics.radius
		decoration.radius = new Corners<Extent>(radius)
		decoration.border = new Edges<Border>(Border{width: metrics.borderWidth, paint: palette.border})
		decoration.hitTest = HitTest.None
		node.border = decoration.borderWidths()
		paint.setText(node, block)

		let pad = float(metrics.unit)
		let box = node.box
		let side Extent = pad * 2.0 * 1(px)
		let over Extent = pad * 1(px)
		box.padding = new Edges<Extent>(over, side)
		box.position = Position.Relative
		box.layer = Layer.Tooltip
		box.maxWidth = tipWidth * 1(px)

		let line = float(metrics.borderWidth) * 2.0
		let size = block.measure(Limit{width: (tipWidth - pad * 4.0 - line) * 1(px)})
		let (wide, high) = (float(size.width) + pad * 4.0 + line, float(size.height) + pad * 2.0 + line)
		let (windowWide, windowHigh) = (float(scene.window.width), float(scene.window.height))
		let (left, top, above) = (float(tip.at.x), float(tip.at.y) + tipDrop, float(tip.at.y) - pad)
		if tip.byKey {
			let frame = target.geom.frame
			left = float(frame.left)
			top = float(frame.bottom) + pad
			above = float(frame.top) - pad
		}
		top = above - high when top + high > windowHigh && above - high >= 0.0
		left = (windowWide - wide).min(left).max(0.0)
		let across = new AnchorLine(scene.root, AnchorEdge.Left)
		let along Extent = left * 1(px)
		across.offset = along
		let down = new AnchorLine(scene.root, AnchorEdge.Top)
		let fall Extent = top.max(0.0) * 1(px)
		down.offset = fall
		box.anchors = Anchors{left: across, top: down}

		node.parent = scene.tree
		scene.tree.children.push(node)
		tip.placed = true
	}

	// The tip's text block: the one it has while the text is the same.
	def tipBlock(tip Tip, text string) paint.TextBlock {
		let held = tip.block
		if !(held is none) {
			return held when held.text == text
		}
		let made = new paint.TextBlock(text, Font{family: "system-ui"}, 13(px))
		tip.block = made
		return made
	}

	// What had the focus before it went into a floating component from outside it.
	type FocusReturn {
		float Node
		back  ?Node

		def new(float Node, back ?Node) {
			self.float = float
			self.back = back
		}
	}

	// Gives the keyboard focus to the component that asked for it with `focus()`, when
	// it is in this scene and can take it. One behind the modal on top cannot.
	def giveFocus(scene Scene) {
		let wanted = frames.focusAsked()
		return when wanted is none
		let top = wanted
		for {
			let above = top.parent()
			break when above is none
			top = above
		}
		// Another window's: its scene gives it.
		if top != scene.root {
			frames.focusLooked()
			return
		}
		frames.focusGiven()
		return when !wanted.focusable || wanted.disabled
		let node = nodeOf(scene.tree, wanted)
		return when node is none
		let modal = modalOf(scene)
		if !(modal is none) {
			return when behind(scene, modal, node)
		}
		keepReturns(scene, node)
		let moved = !wanted.focused
		setFocus(scene, node, scene.keyed)
		showNode(node)
		// This frame's styles ran before the focus moved: the next one gives the looks
		// their `on` has for it.
		frames.askFrame() when moved
	}

	// Scrolls into view the components of this scene that asked for it with `reveal()`;
	// those of other windows stay asked for.
	def giveReveals(scene Scene) {
		let wanted = frames.revealsAsked()
		return when wanted.len() == 0
		let left component[]
		let shown = false
		for let asked in wanted {
			if !heldIn(asked, scene.root) {
				left.push(asked)
				continue
			}
			let node = nodeOf(scene.tree, asked)
			continue when node is none
			showNode(node)
			shown = true
		}
		frames.revealsLeft(left)
		// The scrolling shows in the frame after this one.
		frames.askFrame(true) when shown
	}

	// Before the focus goes to `node`: each floating component it enters from outside
	// keeps what has the focus now, to give it back when that one is hidden.
	def keepReturns(scene Scene, node Node) {
		let old = scene.focus
		for let float in scene.floats {
			continue when !within(node, float)
			if !(old is none) {
				continue when within(old, float)
			}
			let known = false
			for let kept in scene.returns {
				known = true when kept.float == float
			}
			scene.returns.push(new FocusReturn(float, old)) unless known
		}
	}

	// Forgets what is kept for floating components that are no longer shown. When the
	// focused component is in one of them (a line of a menu that closed), the focus
	// returns to what had it before it entered the outermost of them, when that is still
	// shown; else nothing has it.
	def leaveHidden(scene Scene) {
		return when scene.returns.len() == 0
		let focus = scene.focus
		let lost = !(focus is none) && !shown(scene, focus)
		let back ?Node = none
		let found = false
		let kept FocusReturn[]
		for let entry in scene.returns {
			if shown(scene, entry.float) {
				kept.push(entry)
				continue
			}
			if !found {
				found = true
				back = entry.back
			}
		}
		return when !found
		scene.returns = kept
		return when !lost
		if back is none || !shown(scene, back) {
			setFocus(scene, none)
			return
		}
		setFocus(scene, back, scene.keyed)
	}

	// Whether `node` is in the scene's tree with nothing hidden at or above it.
	def shown(scene Scene, node Node) bool {
		let at = node
		for {
			return false when !at.box.visible
			return true when at == scene.tree
			let above = at.parent
			return false when above is none
			at = above
		}
	}

	// The node of `owner` at or under `node`.
	def nodeOf(node Node, owner component) ?Node {
		let held = node.owner
		return node when !(held is none) && held == owner
		for let child in node.children {
			let found = nodeOf(child, owner)
			return found unless found is none
		}
		return none
	}
}
