internal partial module std.ui.runtime {
	use (
		std.math.geom::Size
		std.testing
		std.ui::(StyleSheet, kind, rule)
		std.ui.styles::*
		std.units::*
	)

	component VariantLeaf {
		type {
			@input
			loud bool = false

			def seen() float {
				return style.opacity
			}

			def wide() float {
				return float(style.geom.frame.width)
			}
		}

		style {
			Box
			Compositing
			opacity = 0.5
			width   = 10(px)
			height  = 10(px)
			on      = {
				hover: {opacity: 0.75},
			}
			variants = {
				big:     {width: 30(px)},
				small:   {width: 5(px)},
				primary: {opacity: 0.9, on: {hover: {opacity: 1.0}, pressed: {width: 31(px)}}},
			}
		}

		view {}
	}

	// Asks for a variant of the style it embeds in its own body.
	component VariantSmall {
		type {
			def wide() float {
				return float(style.geom.frame.width)
			}
		}

		style {
			VariantLeaf.style
			variant = [small]
		}

		view {}
	}

	component VariantPage {
		type {}

		view {
			VariantLeaf(ref = plain)
			VariantLeaf(ref = big, style = {variant: [big]})
			VariantLeaf(ref = both, style = {variant: [primary, big], height: 12(px)})
			VariantLeaf(ref = order, style = {variant: [big, small]})
			VariantSmall(ref = small)
		}

		style {
			Box
		}
	}

	check "Style variants" {
		// A call asks a component's style for some of its variants: each gives what
		// it lists, in the order asked, over the style's own values.
		@test()
		def TestACallAsksForVariants() {
			let page = VariantPage()
			let scene = new Scene(page)
			let size = new Size<Pixels>(200(px), 200(px))
			scene.arrange(size)
			let (plain, big, both, order) = (page.plain, page.big, page.both, page.order)
			assert !(plain is none) && !(big is none) && !(both is none) && !(order is none)
			return when plain is none || big is none || both is none || order is none
			assert plain.wide() == 10.0 && plain.seen() == 0.5
			assert big.wide() == 30.0 && big.seen() == 0.5
			assert both.wide() == 30.0 && both.seen() == 0.9 && float(both.style.geom.frame.height) == 12.0
			assert order.wide() == 5.0
			let small = page.small
			assert !(small is none)
			assert small.wide() == 5.0 unless small is none
			assert big.style.variant.join(",") == "big" && both.style.variant.join(",") == "primary,big"
			// The style itself holds its own values.
			let own = both.style
			if own is Boxed {
				assert "{own.width}" == "10 px"
			}
		}

		// A variant's `on` gives states looks, after the style's own.
		@test()
		def TestVariantsGiveStatesLooks() {
			let page = VariantPage()
			let scene = new Scene(page)
			let size = new Size<Pixels>(200(px), 200(px))
			scene.arrange(size)
			let (big, both) = (page.big, page.both)
			assert !(big is none) && !(both is none)
			return when big is none || both is none
			big.isHover = true
			both.isHover = true
			scene.arrange(size)
			assert big.seen() == 0.75 && both.seen() == 1.0 && both.wide() == 30.0
			both.isPressed = true
			scene.arrange(size)
			assert both.wide() == 31.0
		}

		// The variants are the style's: code may change them, and a rule selects by them.
		@test()
		def TestVariantsChangeAndAreSelected() {
			let page = VariantPage()
			let scene = new Scene(page)
			let size = new Size<Pixels>(200(px), 200(px))
			scene.styles = [new StyleSheet([rule(kind<VariantLeaf>().variant("primary"), style = {height: 40(px)})])]
			scene.arrange(size)
			let (plain, both) = (page.plain, page.both)
			assert !(plain is none) && !(both is none)
			return when plain is none || both is none
			assert float(plain.style.geom.frame.height) == 10.0
			plain.style.variant = ["primary"]
			scene.arrange(size)
			assert plain.seen() == 0.9 && float(plain.style.geom.frame.height) == 40.0
			plain.style.variant = []
			scene.arrange(size)
			assert plain.seen() == 0.5 && float(plain.style.geom.frame.height) == 10.0
			// What the call sets stays over the rule.
			assert float(both.style.geom.frame.height) == 12.0
		}
	}
}
