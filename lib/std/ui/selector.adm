partial module std.ui {
	use std.reflection

	// SelectorKind identifies one predicate in a selector chain.
	//
	// Declaration order is meaningful: it is the canonical ordering used by
	// `Selector.str()`, so `kind<Button>().hover()` and `hover().kind<Button>()`
	// produce the same key. Insert new members in the group they belong to.
	enum SelectorKind {
		// Identity.
		Id,
		Kind,
		Class,
		ClassAny,
		ClassAll,
		Property,

		// Structural position among siblings.
		FirstChild,
		LastChild,
		OnlyChild,
		NthChild,
		NthLastChild,
		FirstOfKind,
		LastOfKind,
		NthOfKind,

		// Relationships to other nodes. The selector always describes the node
		// being styled, never the related one.
		Inside,
		DirectlyInside,
		Containing,
		After,
		ImmediatelyAfter,

		// Logic.
		Not,
		AnyOf,
		AllOf,

		// Interaction state.
		Hover,
		Focus,
		FocusVisible,
		FocusWithin,
		Active,
		Pressed,
		Dragged,
		DropTarget,

		// Form state.
		Checked,
		Indeterminate,
		Disabled,
		Enabled,
		ReadOnly,
		Required,
		Valid,
		Invalid,

		// Widget state.
		Selected,
		Expanded,
		Loading,
		IsEmpty,

		// Environment conditions. These describe the surface, not the node, and
		// carry no specificity.
		MinWidth,
		MaxWidth,
		DarkMode,
		LightMode,
		Rtl,
		ReducedMotion,
		HighContrast,
		Platform,

		// Explicit precedence override.
		Priority,
	}

	// SelectorMatch is one predicate plus its operands.
	//
	// Operands are typed fields rather than a single `any`: a selector's whole
	// job is to stringify and compare, and neither is writable against `any`.
	// Only the fields a given kind uses are populated.
	struct SelectorMatch {
		kind SelectorKind

		// text carries a single name: an id, a class, a resolved component type
		// name, or a platform name.
		text string

		// texts carries a name list (`ClassAny`/`ClassAll`) or a name/value pair
		// (`Property`).
		texts string[]

		// num and step carry positional arguments: `nthChild(num)`, the `step` of
		// `nth(step, num)`, or a `priority(num)`.
		num  int
		step int

		// real carries a measurement, e.g. `minWidth(real)`.
		real float

		// group carries nested selectors: one entry for a relationship
		// (`inside`, `containing`, …) or `not`, and N for `anyOf`/`allOf`.
		group Selector[]
	}

	// Selector describes which nodes a style applies to.
	//
	// Selectors are immutable: every method returns a new value, so a selector is
	// safe to share, store in a constant, and branch from.
	//
	//     let primary = kind<Button>().class("primary")
	//     let a = primary.hover()      // primary is unchanged
	//     let b = primary.disabled()
	//
	// Used as a key in a style `children` block, a selector is identified by
	// `str()`, which is canonical — predicate order does not affect the key.
	type Selector {
		internal parts SelectorMatch[] = []

		// with returns a copy of this selector plus one predicate.
		//
		// `parts + [m]` allocates a new array; `parts += m` would mutate the array
		// this selector shares with every selector derived from it.
		internal def with(m SelectorMatch) Selector {
			let next = new Selector()

			next.parts = parts + [m]
			return next
		}

		// predicates returns the predicates making up this selector.
		def predicates() SelectorMatch[] {
			return parts
		}

		// Identity ------------------------------------------------------------

		// Matches components of type T.
		//
		//     kind<Button>()
		//
		// The type is resolved at compile time, so renaming the component updates
		// the selector and a misspelling is a compile error.
		def kind<T: component>() Selector {
			let zero T
			return with(SelectorMatch{kind: SelectorKind.Kind, text: reflection.typeName(zero)})
		}

		// Matches components whose class list contains value.
		def class(value string) Selector {
			return with(SelectorMatch{kind: SelectorKind.Class, text: value})
		}

		// Matches components carrying at least one of the classes.
		def classAny(value ...string) Selector {
			return with(SelectorMatch{kind: SelectorKind.ClassAny, texts: value})
		}

		// Matches components carrying every one of the classes.
		def classAll(value ...string) Selector {
			return with(SelectorMatch{kind: SelectorKind.ClassAll, texts: value})
		}

		// Matches the component with this id.
		def id(value string) Selector {
			return with(SelectorMatch{kind: SelectorKind.Id, text: value})
		}

		// Matches components whose controller property equals value.
		//
		//     kind<Button>().property("variant", "primary")
		def property(name string, value string) Selector {
			return with(SelectorMatch{kind: SelectorKind.Property, texts: [name, value]})
		}

		// Structural position -------------------------------------------------

		def firstChild() Selector {
			return with(SelectorMatch{kind: SelectorKind.FirstChild})
		}

		def lastChild() Selector {
			return with(SelectorMatch{kind: SelectorKind.LastChild})
		}

		def onlyChild() Selector {
			return with(SelectorMatch{kind: SelectorKind.OnlyChild})
		}

		// Matches the index'th child, counting from 1.
		def nthChild(index int) Selector {
			return with(SelectorMatch{kind: SelectorKind.NthChild, num: index})
		}

		// Matches the index'th child counting from the end, from 1.
		def nthLastChild(index int) Selector {
			return with(SelectorMatch{kind: SelectorKind.NthLastChild, num: index})
		}

		// Matches every child whose 1-based position is `step * n + offset`.
		//
		//     nth(2, 1)   // 1st, 3rd, 5th, …
		def nth(step int, offset int) Selector {
			return with(SelectorMatch{kind: SelectorKind.NthChild, step: step, num: offset})
		}

		// Matches children in odd positions (1st, 3rd, …).
		def odd() Selector {
			return nth(2, 1)
		}

		// Matches children in even positions (2nd, 4th, …).
		def even() Selector {
			return nth(2, 2)
		}

		// Position counted among siblings of the same component type only.
		def firstOfKind() Selector {
			return with(SelectorMatch{kind: SelectorKind.FirstOfKind})
		}

		def lastOfKind() Selector {
			return with(SelectorMatch{kind: SelectorKind.LastOfKind})
		}

		def nthOfKind(index int) Selector {
			return with(SelectorMatch{kind: SelectorKind.NthOfKind, num: index})
		}

		// Relationships -------------------------------------------------------
		//
		// Every relationship reads as a property of the node being styled, so
		// there is never a question of which node the selector picks out.

		// Matches when some ancestor matches sel.
		//
		//     kind<Button>().inside(kind<Dialog>())   // buttons in dialogs
		def inside(sel Selector) Selector {
			return with(SelectorMatch{kind: SelectorKind.Inside, group: [sel]})
		}

		// Matches when the immediate parent matches sel.
		def directlyInside(sel Selector) Selector {
			return with(SelectorMatch{kind: SelectorKind.DirectlyInside, group: [sel]})
		}

		// Matches when some descendant matches sel.
		//
		//     kind<Row>().containing(kind<Icon>())    // rows that hold an icon
		def containing(sel Selector) Selector {
			return with(SelectorMatch{kind: SelectorKind.Containing, group: [sel]})
		}

		// Matches when some earlier sibling matches sel.
		def after(sel Selector) Selector {
			return with(SelectorMatch{kind: SelectorKind.After, group: [sel]})
		}

		// Matches when the immediately preceding sibling matches sel.
		def immediatelyAfter(sel Selector) Selector {
			return with(SelectorMatch{kind: SelectorKind.ImmediatelyAfter, group: [sel]})
		}

		// Logic ---------------------------------------------------------------

		// Matches when sel does not match.
		def not(sel Selector) Selector {
			return with(SelectorMatch{kind: SelectorKind.Not, group: [sel]})
		}

		// Matches when any of the selectors match.
		//
		// This is also how several component types are matched at once:
		//
		//     anyOf(kind<Button>(), kind<Link>())
		//
		// The group is appended element by element rather than assigned whole:
		// `group: sel` is rejected with `cannot assign Selector[] to field
		// "group" of type std.ui.Selector[]`, because a collected variadic keeps
		// the unqualified spelling while the field resolves to the qualified one.
		def anyOf(sel ...Selector) Selector {
			let m = SelectorMatch{kind: SelectorKind.AnyOf}
			for let (_, s) in sel {
				m.group += s
			}
			return with(m)
		}

		// Matches when all of the selectors match.
		def allOf(sel ...Selector) Selector {
			let m = SelectorMatch{kind: SelectorKind.AllOf}
			for let (_, s) in sel {
				m.group += s
			}
			return with(m)
		}

		// Combines two selectors that must both match the same node.
		//
		//     kind<Button>() & class("primary")
		infix def & (other Selector) Selector {
			let next = new Selector()
			next.parts = parts + other.parts
			return next
		}

		// Matches when either selector matches.
		//
		//     kind<Button>() | kind<Link>()
		infix def | (other Selector) Selector {
			let next = new Selector()
			next.parts = [SelectorMatch{kind:SelectorKind.AnyOf, group:[self, other]}]
			return next
		}

		// Interaction state ---------------------------------------------------

		def hover() Selector {
			return with(SelectorMatch{kind: SelectorKind.Hover})
		}

		def focus() Selector {
			return with(SelectorMatch{kind: SelectorKind.Focus})
		}

		// Focused, and the surface wants a visible focus ring.
		def focusVisible() Selector {
			return with(SelectorMatch{kind: SelectorKind.FocusVisible})
		}

		// Contains the focused node.
		def focusWithin() Selector {
			return with(SelectorMatch{kind: SelectorKind.FocusWithin})
		}

		def active() Selector {
			return with(SelectorMatch{kind: SelectorKind.Active})
		}

		def pressed() Selector {
			return with(SelectorMatch{kind: SelectorKind.Pressed})
		}

		def dragged() Selector {
			return with(SelectorMatch{kind: SelectorKind.Dragged})
		}

		// A valid drop target for the drag in progress.
		def dropTarget() Selector {
			return with(SelectorMatch{kind: SelectorKind.DropTarget})
		}

		// Form state ----------------------------------------------------------

		def checked() Selector {
			return with(SelectorMatch{kind: SelectorKind.Checked})
		}

		// Neither checked nor unchecked, e.g. a tri-state checkbox.
		def indeterminate() Selector {
			return with(SelectorMatch{kind: SelectorKind.Indeterminate})
		}

		def disabled() Selector {
			return with(SelectorMatch{kind: SelectorKind.Disabled})
		}

		def enabled() Selector {
			return with(SelectorMatch{kind: SelectorKind.Enabled})
		}

		def readOnly() Selector {
			return with(SelectorMatch{kind: SelectorKind.ReadOnly})
		}

		def required() Selector {
			return with(SelectorMatch{kind: SelectorKind.Required})
		}

		def valid() Selector {
			return with(SelectorMatch{kind: SelectorKind.Valid})
		}

		def invalid() Selector {
			return with(SelectorMatch{kind: SelectorKind.Invalid})
		}

		// Widget state --------------------------------------------------------

		def selected() Selector {
			return with(SelectorMatch{kind: SelectorKind.Selected})
		}

		def expanded() Selector {
			return with(SelectorMatch{kind: SelectorKind.Expanded})
		}

		def loading() Selector {
			return with(SelectorMatch{kind: SelectorKind.Loading})
		}

		// Matches components with no children.
		def isEmpty() Selector {
			return with(SelectorMatch{kind: SelectorKind.IsEmpty})
		}

		// Environment conditions ----------------------------------------------
		//
		// These describe the surface rather than the node, and contribute no
		// specificity: they gate a rule instead of competing with other rules.

		// Matches when the containing surface is at least width wide.
		def minWidth(width float) Selector {
			return with(SelectorMatch{kind: SelectorKind.MinWidth, real: width})
		}

		// Matches when the containing surface is at most width wide.
		def maxWidth(width float) Selector {
			return with(SelectorMatch{kind: SelectorKind.MaxWidth, real: width})
		}

		def darkMode() Selector {
			return with(SelectorMatch{kind: SelectorKind.DarkMode})
		}

		def lightMode() Selector {
			return with(SelectorMatch{kind: SelectorKind.LightMode})
		}

		// Matches when the surface lays out right to left.
		def rtl() Selector {
			return with(SelectorMatch{kind: SelectorKind.Rtl})
		}

		// Matches when the user asked for less animation.
		def reducedMotion() Selector {
			return with(SelectorMatch{kind: SelectorKind.ReducedMotion})
		}

		def highContrast() Selector {
			return with(SelectorMatch{kind: SelectorKind.HighContrast})
		}

		// Matches when running on the named platform, e.g. "linux", "windows",
		// "darwin". Compare against `Runtime.os()`.
		def platform(name string) Selector {
			return with(SelectorMatch{kind: SelectorKind.Platform, text: name})
		}

		// Precedence ----------------------------------------------------------

		// Raises this selector above others that would otherwise win.
		//
		// Prefer a more precise selector; reach for this when precedence has to be
		// stated outright. Unlike CSS `!important` it is a number, so two
		// overrides still resolve predictably.
		def priority(level int) Selector {
			return with(SelectorMatch{kind: SelectorKind.Priority, num: level})
		}

		// Introspection -------------------------------------------------------

		// specificity scores how precise this selector is. Higher wins.
		//
		// An id beats any number of classes, a class beats a component type, and a
		// state is the finest tiebreak. Environment conditions score zero: a
		// dark-mode rule should not outrank a light-mode one. `priority()`
		// dominates everything.
		def specificity() int {
			let score = 0
			for let (_, part) in parts {
				score += specificityOf(part)
			}
			return score
		}

		// str renders the canonical string form, which is also this selector's
		// identity as a style key.
		//
		// Predicates are emitted in `SelectorKind` order, so the same set of
		// predicates always yields the same string regardless of chain order.
		def str() string {
			// `sort` orders in place, and `parts` is this selector's own field --
			// rendering a string must not reorder it.
			let ordered = parts.clone().sort(def (i, j SelectorMatch) bool {
				let ri = int(i.kind)
				let rj = int(j.kind)
				return ri < rj when ri != rj
				return partText(i) < partText(j)
			})
			let out = ""
			let seen = new map<string, bool>{}
			for let (_, part) in ordered {
				let rendered = partText(part)
				continue when seen.hasKey(rendered)
				seen[rendered] = true
				out += rendered
			}
			return out
		}

		// explain describes this selector for diagnostics, with its score.
		def explain() string {
			return "{str()} (specificity {specificity()})"
		}

		// validate reports selectors that cannot match anything, so a mistake
		// fails at build time instead of silently styling nothing.
		def validate() !none {
			let ids = 0
			let kinds = 0
			let minW = -1.0
			let maxW = -1.0
			let seen = map<string, bool>{}

			for let (_, part) in parts {
				if part.kind == SelectorKind.Id {
					ids++
					fail "selector has more than one id()" when ids > 1
				}
				if part.kind == SelectorKind.Kind {
					kinds++
					fail "selector has more than one kind(); use anyOf() to match several types" when kinds > 1
				}
				minW = part.real when part.kind == SelectorKind.MinWidth
				maxW = part.real when part.kind == SelectorKind.MaxWidth

				let rendered = partText(part)
				fail "selector repeats {rendered}" when seen.hasKey(rendered)
				seen[rendered] = true
			}

			fail "selector cannot be both firstChild() and lastChild(); use onlyChild()" when has(SelectorKind.FirstChild) && has(SelectorKind.LastChild)
			fail "selector cannot be both disabled() and enabled()" when has(SelectorKind.Disabled) && has(SelectorKind.Enabled)
			fail "selector cannot be both valid() and invalid()" when has(SelectorKind.Valid) && has(SelectorKind.Invalid)
			fail "selector cannot be both darkMode() and lightMode()" when has(SelectorKind.DarkMode) && has(SelectorKind.LightMode)
			fail "selector minWidth exceeds maxWidth" when minW >= 0.0 && maxW >= 0.0 && minW > maxW
			return none
		}

		// has reports whether this selector carries a predicate of that kind.
		def has(kind SelectorKind) bool {
			for let (_, part) in parts {
				return true when part.kind == kind
			}
			return false
		}
	}

	// specificityOf scores one predicate. See `Selector.specificity`.
	internal def specificityOf(part SelectorMatch) int {
		return 10000 * part.num when part.kind == SelectorKind.Priority
		return 1000 when part.kind == SelectorKind.Id
		return 100 when part.kind == SelectorKind.Class
		return 100 when part.kind == SelectorKind.ClassAny
		return 100 * part.texts.len() when part.kind == SelectorKind.ClassAll
		return 100 when part.kind == SelectorKind.Property
		return 10 when part.kind == SelectorKind.Kind

		// Environment conditions gate a rule rather than competing with others.
		return 0 when part.kind == SelectorKind.MinWidth
		return 0 when part.kind == SelectorKind.MaxWidth
		return 0 when part.kind == SelectorKind.DarkMode
		return 0 when part.kind == SelectorKind.LightMode
		return 0 when part.kind == SelectorKind.Rtl
		return 0 when part.kind == SelectorKind.ReducedMotion
		return 0 when part.kind == SelectorKind.HighContrast
		return 0 when part.kind == SelectorKind.Platform

		// A relationship scores as itself plus what it points at, so a deeper
		// requirement is more specific than a shallower one.
		if part.group.len() != 0 {
			let inner = 0
			for let (_, sel) in part.group {
				inner += sel.specificity()
			}
			return 1 + inner
		}
		return 1
	}

	// partText renders one predicate in canonical form.
	internal def partText(part SelectorMatch) string {
		return "#{part.text}" when part.kind == SelectorKind.Id
		return "<{part.text}>" when part.kind == SelectorKind.Kind
		return ".{part.text}" when part.kind == SelectorKind.Class
		return ":classAny({part.texts.join(", ")})" when part.kind == SelectorKind.ClassAny
		return ":classAll({part.texts.join(", ")})" when part.kind == SelectorKind.ClassAll
		return ":property({part.texts.join(" = ")})" when part.kind == SelectorKind.Property

		return ":firstChild" when part.kind == SelectorKind.FirstChild
		return ":lastChild" when part.kind == SelectorKind.LastChild
		return ":onlyChild" when part.kind == SelectorKind.OnlyChild
		return ":nthChild({part.step}n+{part.num})" when part.kind == SelectorKind.NthChild && part.step != 0
		return ":nthChild({part.num})" when part.kind == SelectorKind.NthChild
		return ":nthLastChild({part.num})" when part.kind == SelectorKind.NthLastChild
		return ":firstOfKind" when part.kind == SelectorKind.FirstOfKind
		return ":lastOfKind" when part.kind == SelectorKind.LastOfKind
		return ":nthOfKind({part.num})" when part.kind == SelectorKind.NthOfKind

		return ":inside({groupText(part)})" when part.kind == SelectorKind.Inside
		return ":directlyInside({groupText(part)})" when part.kind == SelectorKind.DirectlyInside
		return ":containing({groupText(part)})" when part.kind == SelectorKind.Containing
		return ":after({groupText(part)})" when part.kind == SelectorKind.After
		return ":immediatelyAfter({groupText(part)})" when part.kind == SelectorKind.ImmediatelyAfter

		return ":not({groupText(part)})" when part.kind == SelectorKind.Not
		return ":anyOf({groupText(part)})" when part.kind == SelectorKind.AnyOf
		return ":allOf({groupText(part)})" when part.kind == SelectorKind.AllOf

		return ":hover" when part.kind == SelectorKind.Hover
		return ":focus" when part.kind == SelectorKind.Focus
		return ":focusVisible" when part.kind == SelectorKind.FocusVisible
		return ":focusWithin" when part.kind == SelectorKind.FocusWithin
		return ":active" when part.kind == SelectorKind.Active
		return ":pressed" when part.kind == SelectorKind.Pressed
		return ":dragged" when part.kind == SelectorKind.Dragged
		return ":dropTarget" when part.kind == SelectorKind.DropTarget

		return ":checked" when part.kind == SelectorKind.Checked
		return ":indeterminate" when part.kind == SelectorKind.Indeterminate
		return ":disabled" when part.kind == SelectorKind.Disabled
		return ":enabled" when part.kind == SelectorKind.Enabled
		return ":readOnly" when part.kind == SelectorKind.ReadOnly
		return ":required" when part.kind == SelectorKind.Required
		return ":valid" when part.kind == SelectorKind.Valid
		return ":invalid" when part.kind == SelectorKind.Invalid

		return ":selected" when part.kind == SelectorKind.Selected
		return ":expanded" when part.kind == SelectorKind.Expanded
		return ":loading" when part.kind == SelectorKind.Loading
		return ":isEmpty" when part.kind == SelectorKind.IsEmpty

		return ":minWidth({part.real})" when part.kind == SelectorKind.MinWidth
		return ":maxWidth({part.real})" when part.kind == SelectorKind.MaxWidth
		return ":darkMode" when part.kind == SelectorKind.DarkMode
		return ":lightMode" when part.kind == SelectorKind.LightMode
		return ":rtl" when part.kind == SelectorKind.Rtl
		return ":reducedMotion" when part.kind == SelectorKind.ReducedMotion
		return ":highContrast" when part.kind == SelectorKind.HighContrast
		return ":platform({part.text})" when part.kind == SelectorKind.Platform

		return ":priority({part.num})" when part.kind == SelectorKind.Priority
		return ""
	}

	// groupText renders a predicate's nested selectors.
	internal def groupText(part SelectorMatch) string {
		let rendered = string[]
		for let (_, sel) in part.group {
			rendered.push(sel.str())
		}
		return rendered.join(",")
	}

	// Entry points ------------------------------------------------------------
	//
	// Each mirrors the method of the same name so a chain reads left to right
	// without naming `Selector` first.

	// Matches components of type T. See `Selector.kind`.
	def kind<T: component>() Selector {
		let selector = new Selector()
		return selector.kind<T>()
	}

	def class(value string) Selector {
		let selector = new Selector()
		return selector.class(value)
	}

	def classAny(value ...string) Selector {
		let selector = new Selector()
		return selector.classAny(...value)
	}

	def classAll(value ...string) Selector {
		let selector = new Selector()
		return selector.classAll(...value)
	}

	def id(value string) Selector {
		let selector = new Selector()
		return selector.id(value)
	}

	def property(name string, value string) Selector {
		let selector = new Selector()
		return selector.property(name, value)
	}

	def firstChild() Selector {
		let selector = new Selector()
		return selector.firstChild()
	}

	def lastChild() Selector {
		let selector = new Selector()
		return selector.lastChild()
	}

	def onlyChild() Selector {
		let selector = new Selector()
		return selector.onlyChild()
	}

	def nthChild(index int) Selector {
		let selector = new Selector()
		return selector.nthChild(index)
	}

	def nthLastChild(index int) Selector {
		let selector = new Selector()
		return selector.nthLastChild(index)
	}

	def nth(step int, offset int) Selector {
		let selector = new Selector()
		return selector.nth(step, offset)
	}

	def odd() Selector {
		let selector = new Selector()
		return selector.odd()
	}

	def even() Selector {
		let selector = new Selector()
		return selector.even()
	}

	def firstOfKind() Selector {
		let selector = new Selector()
		return selector.firstOfKind()
	}

	def lastOfKind() Selector {
		let selector = new Selector()
		return selector.lastOfKind()
	}

	def nthOfKind(index int) Selector {
		let selector = new Selector()
		return selector.nthOfKind(index)
	}

	def not(sel Selector) Selector {
		let selector = new Selector()
		return selector.not(sel)
	}

	def anyOf(sel ...Selector) Selector {
		let selector = new Selector()
		return selector.anyOf(...sel)
	}

	def allOf(sel ...Selector) Selector {
		let selector = new Selector()
		return selector.allOf(...sel)
	}

	def hover() Selector {
		let selector = new Selector()
		return selector.hover()
