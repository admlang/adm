partial module std.ui {
	use (
		std.reflection
		std.ui.runtime::(StateReader, builtinStateBit)
		std.ui.styles::Direction
	)

	// SelectorKind identifies one predicate in a selector chain.
	//
	// Declaration order is meaningful: it is the canonical ordering used by
	// `Selector.str()`, so `kind<Button>().hover()` and `hover().kind<Button>()`
	// produce the same key. Insert new members in the group they belong to.
	enum SelectorKind {
		// Identity.
		Ref,
		Kind,
		Role,
		// The component that listens: `own()`.
		Own,
		// One of the component's named states: `state("selected")`.
		State,
		Variant,
		Property,

		// Structural position among siblings.
		FirstChild,
		LastChild,
		OnlyChild,
		NthChild,
		NthLastChild,
		FirstOfKind,
		LastOfKind,
		NthOfKind,

		// Relationships to other nodes. The selector always describes the node
		// being styled, never the related one.
		Inside,
		DirectlyInside,
		Containing,
		After,
		ImmediatelyAfter,

		// Logic.
		Not,
		AnyOf,
		AllOf,

		// Interaction state.
		Hover,
		Focus,
		FocusVisible,
		FocusWithin,
		Active,
		Pressed,
		Dragged,
		DropTarget,

		// Form state.
		Checked,
		Indeterminate,
		Disabled,
		Enabled,
		ReadOnly,
		Required,
		Valid,
		Invalid,

		// Widget state.
		Selected,
		Expanded,
		Loading,
		IsEmpty,

		// Environment conditions. These describe the surface, not the node, and
		// carry no specificity.
		MinWidth,
		MaxWidth,
		DarkMode,
		LightMode,
		Rtl,
		ReducedMotion,
		HighContrast,
		Platform,

		// Explicit precedence override.
		Priority,
	}

	// SelectorMatch is one predicate plus its operands.
	//
	// Operands are typed fields rather than a single `any`: a selector's whole
	// job is to stringify and compare, and neither is writable against `any`.
	// Only the fields a given kind uses are populated.
	struct SelectorMatch {
		kind SelectorKind

		// text carries a single name: a ref, a state, a variant, a resolved
		// component type name, or a platform name.
		text string

		// texts carries a name/value pair (`Property`).
		texts string[]

		// num and step carry positional arguments: `nthChild(num)`, the `step` of
		// `nth(step, num)`, or a `priority(num)`; num is also the role of `role(r)`.
		num  int
		step int

		// real carries a measurement, e.g. `minWidth(real)`.
		real float

		// group carries nested selectors: one entry for a relationship
		// (`inside`, `containing`, …) or `not`, and N for `anyOf`/`allOf`.
		group Selector[]
	}

	// Selector describes which nodes a style applies to.
	//
	// Selectors are immutable: every method returns a new value, so a selector is
	// safe to share, store in a constant, and branch from.
	//
	//     let primary = kind<Button>().variant("primary")
	//     let a = primary.hover()      // primary is unchanged
	//     let b = primary.disabled()
	//
	// Used as a key in a style `children` block, a selector is identified by
	// `str()`, which is canonical — predicate order does not affect the key.
	type Selector {
		internal parts SelectorMatch[] = []

		// with returns a copy of this selector plus one predicate.
		//
		// `parts + [m]` allocates a new array; `parts += m` would mutate the array
		// this selector shares with every selector derived from it.
		internal def with(m SelectorMatch) Selector {
			let next = new Selector()

			next.parts = parts + [m]
			return next
		}

		// predicates returns the predicates making up this selector.
		def predicates() SelectorMatch[] {
			return parts
		}

		// Identity ------------------------------------------------------------

		// Matches components of type T.
		//
		//     kind<Button>()
		//
		// The type is resolved at compile time, so renaming the component updates
		// the selector and a misspelling is a compile error.
		def kind<T: component>() Selector {
			let zero T
			return with(SelectorMatch{kind: SelectorKind.Kind, text: reflection.typeName(zero)})
		}

		// Matches components whose `role` is `value`: what a component is, whatever
		// its type (`Role.Button` for every kind of button).
		//
		//     role(Role.Button).inside(kind<Toolbar>())
		def role(value Role) Selector {
			return with(SelectorMatch{kind: SelectorKind.Role, text: "{value}", num: int(value)})
		}

		// Matches components whose style applies the variant `name`
		// (`style.variant` lists it).
		//
		//     kind<Button>().variant("primary")
		def variant(name string) Selector {
			return with(SelectorMatch{kind: SelectorKind.Variant, text: name})
		}

		// Matches the components a view named `value` with `ref = value`: a component's
		// one name. From outside the view that named it, this is how it is reached.
		//
		//     ref("save")
		//     kind<Toolbar>().ref("main")
		def ref(value string) Selector {
			return with(SelectorMatch{kind: SelectorKind.Ref, text: value})
		}

		// Picks one of the component's states by its name: a built-in one (`hover`,
		// `pressed`, `focused`, `focusWithin`, `focusVisible`, `disabled`, `dragging`,
		// `dropTarget`), a `@state` bool field, or a case of a `@state` enum field.
		// `matches` asks whether the state holds now; in the filter of a listener of
		// `UI.stateChange` the change is of that state.
		//
		//     kind<Tab>().state("current")
		//     @on(UI.stateChange, ref("mainTabs").state("selected"))
		def state(name string) Selector {
			return with(SelectorMatch{kind: SelectorKind.State, text: name})
		}

		// Matches the component that listens, in the filter of a listener that is a
		// method of a component: "this instance".
		//
		//     @on(UI.stateChange, own().state("file"))
		def own() Selector {
			return with(SelectorMatch{kind: SelectorKind.Own})
		}

		// Matches components whose controller has a field `name` that reads as `value`:
		// a string as it is, a number or a bool as it prints, an enum by the name of
		// its case.
		//
		//     kind<Toolbar>().property("orientation", "Vertical")
		def property(name string, value string) Selector {
			return with(SelectorMatch{kind: SelectorKind.Property, texts: [name, value]})
		}

		// Structural position -------------------------------------------------

		// Matches a component that is its parent's first child.
		def firstChild() Selector {
			return with(SelectorMatch{kind: SelectorKind.FirstChild})
		}

		// Matches a component that is its parent's last child.
		def lastChild() Selector {
			return with(SelectorMatch{kind: SelectorKind.LastChild})
		}

		// Matches a component that is its parent's only child.
		def onlyChild() Selector {
			return with(SelectorMatch{kind: SelectorKind.OnlyChild})
		}

		// Matches the index'th child, counting from 1.
		def nthChild(index int) Selector {
			return with(SelectorMatch{kind: SelectorKind.NthChild, num: index})
		}

		// Matches the index'th child counting from the end, from 1.
		def nthLastChild(index int) Selector {
			return with(SelectorMatch{kind: SelectorKind.NthLastChild, num: index})
		}

		// Matches every child whose 1-based position is `step * n + offset`.
		//
		//     nth(2, 1)   // 1st, 3rd, 5th, …
		def nth(step int, offset int) Selector {
			return with(SelectorMatch{kind: SelectorKind.NthChild, step: step, num: offset})
		}

		// Matches children in odd positions (1st, 3rd, …).
		def odd() Selector {
			return nth(2, 1)
		}

		// Matches children in even positions (2nd, 4th, …).
		def even() Selector {
			return nth(2, 2)
		}

		// Position counted among siblings of the same component type only.
		def firstOfKind() Selector {
			return with(SelectorMatch{kind: SelectorKind.FirstOfKind})
		}

		// Matches the last child of its type among its siblings.
		def lastOfKind() Selector {
			return with(SelectorMatch{kind: SelectorKind.LastOfKind})
		}

		// Matches the index'th child of its type among its siblings, counting from 1.
		def nthOfKind(index int) Selector {
			return with(SelectorMatch{kind: SelectorKind.NthOfKind, num: index})
		}

		// Relationships -------------------------------------------------------
		//
		// Every relationship reads as a property of the node being styled, so
		// there is never a question of which node the selector picks out.

		// Matches when some ancestor matches sel.
		//
		//     kind<Button>().inside(kind<Dialog>())   // buttons in dialogs
		def inside(sel Selector) Selector {
			return with(SelectorMatch{kind: SelectorKind.Inside, group: [sel]})
		}

		// Matches when the immediate parent matches sel.
		def directlyInside(sel Selector) Selector {
			return with(SelectorMatch{kind: SelectorKind.DirectlyInside, group: [sel]})
		}

		// Matches when some descendant matches sel.
		//
		//     kind<Row>().containing(kind<Icon>())    // rows that hold an icon
		def containing(sel Selector) Selector {
			return with(SelectorMatch{kind: SelectorKind.Containing, group: [sel]})
		}

		// Matches when some earlier sibling matches sel.
		def after(sel Selector) Selector {
			return with(SelectorMatch{kind: SelectorKind.After, group: [sel]})
		}

		// Matches when the immediately preceding sibling matches sel.
		def immediatelyAfter(sel Selector) Selector {
			return with(SelectorMatch{kind: SelectorKind.ImmediatelyAfter, group: [sel]})
		}

		// Logic ---------------------------------------------------------------

		// Matches when sel does not match.
		def not(sel Selector) Selector {
			return with(SelectorMatch{kind: SelectorKind.Not, group: [sel]})
		}

		// Matches when any of the selectors match.
		//
		// This is also how several component types are matched at once:
		//
		//     anyOf(kind<Button>(), kind<Link>())
		//
		// The group is appended element by element rather than assigned whole:
		// `group: sel` is rejected with `cannot assign Selector[] to field
		// "group" of type std.ui.Selector[]`, because a collected variadic keeps
		// the unqualified spelling while the field resolves to the qualified one.
		def anyOf(sel ...Selector) Selector {
			let m = SelectorMatch{kind: SelectorKind.AnyOf}
			for let (_, s) in sel {
				m.group += s
			}
			return with(m)
		}

		// Matches when all of the selectors match.
		def allOf(sel ...Selector) Selector {
			let m = SelectorMatch{kind: SelectorKind.AllOf}
			for let (_, s) in sel {
				m.group += s
			}
			return with(m)
		}

		// Combines two selectors that must both match the same node.
		//
		//     kind<Button>() & variant("primary")
		infix def & (other Selector) Selector {
			let next = new Selector()
			next.parts = parts + other.parts
			return next
		}

		// Matches when either selector matches.
		//
		//     kind<Button>() | kind<Link>()
		infix def | (other Selector) Selector {
			let next = new Selector()
			next.parts = [SelectorMatch{kind: SelectorKind.AnyOf, group: [self, other]}]
			return next
		}

		// Interaction state ---------------------------------------------------

		// Matches while the pointer is over the component.
		def hover() Selector {
			return with(SelectorMatch{kind: SelectorKind.Hover})
		}

		// Matches the focused component.
		def focus() Selector {
			return with(SelectorMatch{kind: SelectorKind.Focus})
		}

		// Focused, and the surface wants a visible focus ring.
		def focusVisible() Selector {
			return with(SelectorMatch{kind: SelectorKind.FocusVisible})
		}

		// Contains the focused node.
		def focusWithin() Selector {
			return with(SelectorMatch{kind: SelectorKind.FocusWithin})
		}

		// Matches while the component is being activated, such as a button held down.
		def active() Selector {
			return with(SelectorMatch{kind: SelectorKind.Active})
		}

		// Matches while a pointer button is down on the component.
		def pressed() Selector {
			return with(SelectorMatch{kind: SelectorKind.Pressed})
		}

		// Matches the component being dragged.
		def dragged() Selector {
			return with(SelectorMatch{kind: SelectorKind.Dragged})
		}

		// A valid drop target for the drag in progress.
		def dropTarget() Selector {
			return with(SelectorMatch{kind: SelectorKind.DropTarget})
		}

		// Form state ----------------------------------------------------------

		// Matches a checked toggle.
		def checked() Selector {
			return with(SelectorMatch{kind: SelectorKind.Checked})
		}

		// Neither checked nor unchecked, e.g. a tri-state checkbox.
		def indeterminate() Selector {
			return with(SelectorMatch{kind: SelectorKind.Indeterminate})
		}

		// Matches a disabled control.
		def disabled() Selector {
			return with(SelectorMatch{kind: SelectorKind.Disabled})
		}

		// Matches an enabled control.
		def enabled() Selector {
			return with(SelectorMatch{kind: SelectorKind.Enabled})
		}

		// Matches a control the user can read but not edit.
		def readOnly() Selector {
			return with(SelectorMatch{kind: SelectorKind.ReadOnly})
		}

		// Matches a control that needs a value.
		def required() Selector {
			return with(SelectorMatch{kind: SelectorKind.Required})
		}

		// Matches a control whose value passes validation.
		def valid() Selector {
			return with(SelectorMatch{kind: SelectorKind.Valid})
		}

		// Matches a control whose value fails validation.
		def invalid() Selector {
			return with(SelectorMatch{kind: SelectorKind.Invalid})
		}

		// Widget state --------------------------------------------------------

		// Matches a selected item, such as a list row or a tab.
		def selected() Selector {
			return with(SelectorMatch{kind: SelectorKind.Selected})
		}

		// Matches an expanded container, such as an open tree node.
		def expanded() Selector {
			return with(SelectorMatch{kind: SelectorKind.Expanded})
		}

		// Matches a component still waiting on its data.
		def loading() Selector {
			return with(SelectorMatch{kind: SelectorKind.Loading})
		}

		// Matches components with no children.
		def isEmpty() Selector {
			return with(SelectorMatch{kind: SelectorKind.IsEmpty})
		}

		// Environment conditions ----------------------------------------------
		//
		// These describe the surface rather than the node, and contribute no
		// specificity: they gate a rule instead of competing with other rules.

		// Matches when the containing surface is at least width wide.
		def minWidth(width float) Selector {
			return with(SelectorMatch{kind: SelectorKind.MinWidth, real: width})
		}

		// Matches when the containing surface is at most width wide.
		def maxWidth(width float) Selector {
			return with(SelectorMatch{kind: SelectorKind.MaxWidth, real: width})
		}

		// Matches when the surface uses a dark theme.
		def darkMode() Selector {
			return with(SelectorMatch{kind: SelectorKind.DarkMode})
		}

		// Matches when the surface uses a light theme.
		def lightMode() Selector {
			return with(SelectorMatch{kind: SelectorKind.LightMode})
		}

		// Matches when the surface lays out right to left.
		def rtl() Selector {
			return with(SelectorMatch{kind: SelectorKind.Rtl})
		}

		// Matches when the user asked for less animation.
		def reducedMotion() Selector {
			return with(SelectorMatch{kind: SelectorKind.ReducedMotion})
		}

		// Matches when the user asked for high contrast.
		def highContrast() Selector {
			return with(SelectorMatch{kind: SelectorKind.HighContrast})
		}

		// Matches a program built for the named system: "linux", "windows", "macos",
		// "android", "wasm" (`__os__`).
		def platform(name string) Selector {
			return with(SelectorMatch{kind: SelectorKind.Platform, text: name})
		}

		// Precedence ----------------------------------------------------------

		// Raises this selector above others that would otherwise win.
		//
		// Prefer a more precise selector; reach for this when precedence has to be
		// stated outright. Unlike CSS `!important` it is a number, so two
		// overrides still resolve predictably.
		def priority(level int) Selector {
			return with(SelectorMatch{kind: SelectorKind.Priority, num: level})
		}

		// Introspection -------------------------------------------------------

		// specificity scores how precise this selector is. Higher wins.
		//
		// A ref beats any number of variants, a variant beats a component type or a
		// role, and a state is the finest tiebreak. Environment conditions score zero: a
		// dark-mode rule should not outrank a light-mode one. `priority()`
		// dominates everything.
		def specificity() int {
			let score = 0
			for let (_, part) in parts {
				score += specificityOf(part)
			}
			return score
		}

		// str renders the canonical string form, which is also this selector's
		// identity as a style key.
		//
		// Predicates are emitted in `SelectorKind` order, so the same set of
		// predicates always yields the same string regardless of chain order.
		def str() string {
			// `sort` orders in place, and `parts` is this selector's own field --
			// rendering a string must not reorder it.
			let ordered = parts.clone().sort(def (i, j SelectorMatch) bool {
				let ri = int(i.kind)
				let rj = int(j.kind)
				return ri < rj when ri != rj
				return partText(i) < partText(j)
			})
			let out = ""
			let seen = new map<string, bool>{}
			for let (_, part) in ordered {
				let rendered = partText(part)
				continue when seen.hasKey(rendered)
				seen[rendered] = true
				out += rendered
			}
			return out
		}

		// explain describes this selector for diagnostics, with its score.
		def explain() string {
			return "{str()} (specificity {specificity()})"
		}

		// validate reports selectors that cannot match anything, so a mistake
		// fails at build time instead of silently styling nothing.
		def validate() !none {
			let refs = 0
			let kinds = 0
			let minW = -1.0
			let maxW = -1.0
			let seen = map<string, bool>{}

			for let (_, part) in parts {
				if part.kind == SelectorKind.Ref {
					refs++
					fail "selector has more than one ref()" when refs > 1
				}
				if part.kind == SelectorKind.Kind {
					kinds++
					fail "selector has more than one kind(); use anyOf() to match several types" when kinds > 1
				}
				minW = part.real when part.kind == SelectorKind.MinWidth
				maxW = part.real when part.kind == SelectorKind.MaxWidth

				let rendered = partText(part)
				fail "selector repeats {rendered}" when seen.hasKey(rendered)
				seen[rendered] = true
			}

			fail "selector cannot be both firstChild() and lastChild(); use onlyChild()" when has(SelectorKind.FirstChild) && has(SelectorKind.LastChild)
			fail "selector cannot be both disabled() and enabled()" when has(SelectorKind.Disabled) && has(SelectorKind.Enabled)
			fail "selector cannot be both valid() and invalid()" when has(SelectorKind.Valid) && has(SelectorKind.Invalid)
			fail "selector cannot be both darkMode() and lightMode()" when has(SelectorKind.DarkMode) && has(SelectorKind.LightMode)
			fail "selector minWidth exceeds maxWidth" when minW >= 0.0 && maxW >= 0.0 && minW > maxW
			return none
		}

		// Whether `c` is a component this selector describes, as it is now: every
		// predicate holds for it. A selector without predicates matches every
		// component. This is what a filter of `@on(Component.event, selector)` asks of
		// the component an event came from.
		//
		// Decided from the component: `ref`, `kind`, `role`, `variant` (its style's),
		// the positions among its siblings, the relationships (`inside`, `containing`,
		// `after` and the like), the logic, `hover`, `focus`, `focusVisible`,
		// `focusWithin`, `pressed` and `active` (both: held down), `dragged`,
		// `dropTarget`, `disabled`, `enabled`, `isEmpty`, `rtl`; `state(name)` and
		// `property(name, value)` from its controller's fields; from the desktop's look:
		// `darkMode`, `lightMode`, `reducedMotion`, `highContrast`; `minWidth` and
		// `maxWidth` from its `viewport` (neither holds before the first layout); `platform` from the system the program was built
		// for. `priority` holds for every component.
		//
		// `checked`, `indeterminate`, `readOnly`, `required`, `valid`, `invalid`,
		// `selected`, `expanded` and `loading` each ask for the component's `@state` of
		// that name, and never hold for a component without one.
		//
		// `own` belongs to a change of state and holds only in `matchesEvent`;
		// `unanswered()` says whether a selector carries it.
		def matches(c component) bool {
			for let (_, part) in parts {
				return false unless partHolds(part, c)
			}
			return true
		}

		// Whether a change of a component's state is one this selector describes, for the
		// filter of a listener of `UI.stateChange`: the component that changed matches,
		// as `matches` says; each `state(name)` names the state that changed; and with
		// `own()` the component is `listener`, the component whose method listens (none
		// for a listener that is a function, which `own()` then never matches).
		def matchesEvent(change StateChange, listener ?component = none) bool {
			for let (_, part) in parts {
				match part.kind {
					case SelectorKind.State:
						return false when part.text != change.state
					case SelectorKind.Own:
						return false when listener is none || listener != change.source
					default:
						return false unless partHolds(part, change.source)
				}
			}
			return true
		}

		// The kinds of predicate in this selector, at any depth, that `matches` cannot
		// decide from a component and so never holds: see `matches`.
		def unanswered() SelectorKind[] {
			let found SelectorKind[]
			collectUnanswered(self, found)
			return found
		}

		// has reports whether this selector carries a predicate of that kind.
		def has(kind SelectorKind) bool {
			for let (_, part) in parts {
				return true when part.kind == kind
			}
			return false
		}
	}

	// Whether `matches` has no source in a component for this kind of predicate.
	internal def unansweredKind(kind SelectorKind) bool {
		return kind == SelectorKind.Own
	}

	// Appends to `found` the unanswered kinds in `sel` and in the selectors it nests,
	// each once.
	internal def collectUnanswered(sel Selector, found SelectorKind[]) {
		for let (_, part) in sel.parts {
			found.push(part.kind) when unansweredKind(part.kind) && !found.includes(part.kind)
			for let (_, nested) in part.group {
				collectUnanswered(nested, found)
			}
		}
	}

	// The components beside `c` under its parent, itself among them, in order; empty
	// for a component without a parent.
	internal def siblingsOf(c component) component[] {
		let alone component[]
		let above = c.parent()
		return alone when above is none
		return above.childNodes
	}

	// The 1-based position of `c` in `among`, counting only those `counted` holds for
	// (none: all of them); 0 when it is not there. `total` is how many were counted.
	internal def positionIn(c component, among component[], sameKind bool) (int, int) {
		let kind = sameKind ?? (reflection.typeName(c), "")
		let (at, total) = (0, 0)
		for let (_, other) in among {
			continue when sameKind && reflection.typeName(other) != kind
			total++
			at = total when other == c
		}
		return (at, total)
	}

	// Whether some component under `c`, at any depth, matches `sel`.
	internal def holdsBelow(c component, sel Selector) bool {
		for let (_, child) in c.childNodes {
			return true when sel.matches(child) || holdsBelow(child, sel)
		}
		return false
	}

	// Whether one predicate holds for `c`. See `Selector.matches`.
	internal def partHolds(part SelectorMatch, c component) bool {
		switch part.kind {
			case SelectorKind.Ref:
				return c.refName == part.text
			case SelectorKind.Kind:
				return reflection.typeName(c) == part.text
			case SelectorKind.Role:
				return int(c.role) == part.num
			case SelectorKind.Variant:
				return c.style.variant.includes(part.text)
			case SelectorKind.State:
				return stateHolds(c, part.text)
			case SelectorKind.Property:
				let field = reflection.field(c, part.texts[0])
				return !(field is none) && fieldText(field) == part.texts[1]
			case SelectorKind.Checked:
				return stateHolds(c, "checked")
			case SelectorKind.Indeterminate:
				return stateHolds(c, "indeterminate")
			case SelectorKind.ReadOnly:
				return stateHolds(c, "readOnly")
			case SelectorKind.Required:
				return stateHolds(c, "required")
			case SelectorKind.Valid:
				return stateHolds(c, "valid")
			case SelectorKind.Invalid:
				return stateHolds(c, "invalid")
			case SelectorKind.Selected:
				return stateHolds(c, "selected")
			case SelectorKind.Expanded:
				return stateHolds(c, "expanded")
			case SelectorKind.Loading:
				return stateHolds(c, "loading")
			case SelectorKind.MinWidth:
				let width = float(c.viewport.size.width)
				return width > 0.0 && width >= part.real
			case SelectorKind.MaxWidth:
				let width = float(c.viewport.size.width)
				return width > 0.0 && width <= part.real
			case SelectorKind.Platform:
				return __os__ == part.text
			case SelectorKind.FirstChild, SelectorKind.LastChild, SelectorKind.OnlyChild, SelectorKind.NthChild, SelectorKind.NthLastChild:
				let (at, total) = positionIn(c, siblingsOf(c), false)
				return false when at == 0
				switch part.kind {
					case SelectorKind.FirstChild:
						return at == 1
					case SelectorKind.LastChild:
						return at == total
					case SelectorKind.OnlyChild:
						return total == 1
					case SelectorKind.NthLastChild:
						return total - at + 1 == part.num
					default:
				}
				// `step * n + offset` for some n from 0 up; without a step, the one position.
				return at == part.num when part.step == 0
				let over = at - part.num
				return over % part.step == 0 && over / part.step >= 0
			case SelectorKind.FirstOfKind, SelectorKind.LastOfKind, SelectorKind.NthOfKind:
				let (at, total) = positionIn(c, siblingsOf(c), true)
				return false when at == 0
				return at == 1 when part.kind == SelectorKind.FirstOfKind
				return at == total when part.kind == SelectorKind.LastOfKind
				return at == part.num
			case SelectorKind.Inside:
				let above = c.parent()
				for {
					return false when above is none
					return true when part.group[0].matches(above)
					above = above.parent()
				}
			case SelectorKind.DirectlyInside:
				let above = c.parent()
				return !(above is none) && part.group[0].matches(above)
			case SelectorKind.Containing:
				return holdsBelow(c, part.group[0])
			case SelectorKind.After, SelectorKind.ImmediatelyAfter:
				let before ?component = none
				for let (_, other) in siblingsOf(c) {
					if other == c {
						return part.kind == SelectorKind.ImmediatelyAfter && !(before is none) && part.group[0].matches(before)
					}
					return true when part.kind == SelectorKind.After && part.group[0].matches(other)
					before = other
				}
				return false
			case SelectorKind.Not:
				return !part.group[0].matches(c)
			case SelectorKind.AnyOf:
				for let (_, one) in part.group {
					return true when one.matches(c)
				}
				return false
			case SelectorKind.AllOf:
				for let (_, one) in part.group {
					return false unless one.matches(c)
				}
				return true
			case SelectorKind.Hover:
				return c.hover
			case SelectorKind.Focus:
				return c.focused
			case SelectorKind.FocusVisible:
				return c.focusVisible
			case SelectorKind.FocusWithin:
				return c.focusWithin
			case SelectorKind.Active, SelectorKind.Pressed:
				return c.pressed
			case SelectorKind.Dragged:
				return c.dragging
			case SelectorKind.DropTarget:
				return c.dropTarget
			case SelectorKind.Disabled:
				return c.disabled
			case SelectorKind.Enabled:
				return !c.disabled
			case SelectorKind.IsEmpty:
				return c.childNodes.len() == 0
			case SelectorKind.Rtl:
				return c.style.geom.direction == Direction.RightToLeft
			case SelectorKind.DarkMode:
				return UI.appearance().scheme == ColorScheme.Dark
			case SelectorKind.LightMode:
				return UI.appearance().scheme == ColorScheme.Light
			case SelectorKind.ReducedMotion:
				return UI.appearance().reduceMotion
			case SelectorKind.HighContrast:
				return UI.appearance().contrast == Contrast.High
			case SelectorKind.Priority:
				return true
			default:
				// `own`, which only a change of state answers.
				return false
		}
	}

	// Whether the state of `c` called `name` holds now: one the view runtime keeps for
	// every component, a `@state` bool field by its name, or a `@state` enum field that
	// holds the case of that name.
	internal def stateHolds(c component, name string) bool {
		// As a style's `on` sees them: a disabled component is not hovered, pressed or
		// focused.
		let bit = builtinStateBit(name)
		return c.heldStates() & bit != 0 when bit != 0
		return new StateReader(c).holds(name)
	}

	// What a field of a component reads as, for `property(name, value)`: an enum by the
	// name of its case, a string as it is, a number or a bool as it prints; "" for any
	// other field.
	internal def fieldText(field reflection.Field) string {
		let described = field.descriptor
		if field.kind == reflection.FieldKind.Enum && !(described is none) {
			let held = field.asInt()
			for let (_, member) in reflection.members(described) {
				return member.node.name when reflection.scalarText(member.value).toInt<int>() == held
			}
			return ""
		}
		match field.kind {
			case reflection.FieldKind.String:
				return field.asString()
			case reflection.FieldKind.Bool:
				return "{field.asBool()}"
			case reflection.FieldKind.Int:
				return "{field.asInt()}"
			case reflection.FieldKind.Uint:
				return "{field.asUint()}"
			case reflection.FieldKind.Float:
				return "{field.asFloat()}"
			default:
				return ""
		}
	}

	// specificityOf scores one predicate. See `Selector.specificity`.
	internal def specificityOf(part SelectorMatch) int {
		return 10000 * part.num when part.kind == SelectorKind.Priority
		return 1000 when part.kind == SelectorKind.Ref
		return 100 when part.kind == SelectorKind.Variant
		return 100 when part.kind == SelectorKind.Property
		return 10 when part.kind == SelectorKind.Kind
		return 10 when part.kind == SelectorKind.Role

		// Environment conditions gate a rule rather than competing with others.
		return 0 when part.kind == SelectorKind.MinWidth
		return 0 when part.kind == SelectorKind.MaxWidth
		return 0 when part.kind == SelectorKind.DarkMode
		return 0 when part.kind == SelectorKind.LightMode
		return 0 when part.kind == SelectorKind.Rtl
		return 0 when part.kind == SelectorKind.ReducedMotion
		return 0 when part.kind == SelectorKind.HighContrast
		return 0 when part.kind == SelectorKind.Platform

		// A relationship scores as itself plus what it points at, so a deeper
		// requirement is more specific than a shallower one.
		if part.group.len() != 0 {
			let inner = 0
			for let (_, sel) in part.group {
				inner += sel.specificity()
			}
			return 1 + inner
		}
		return 1
	}

	// partText renders one predicate in canonical form.
	internal def partText(part SelectorMatch) string {
		return ":own" when part.kind == SelectorKind.Own
		return ":state({part.text})" when part.kind == SelectorKind.State
		return ":ref({part.text})" when part.kind == SelectorKind.Ref
		return "<{part.text}>" when part.kind == SelectorKind.Kind
		return ":role({part.text})" when part.kind == SelectorKind.Role
		return ".{part.text}" when part.kind == SelectorKind.Variant
		return ":property({part.texts.join(" = ")})" when part.kind == SelectorKind.Property

		return ":firstChild" when part.kind == SelectorKind.FirstChild
		return ":lastChild" when part.kind == SelectorKind.LastChild
		return ":onlyChild" when part.kind == SelectorKind.OnlyChild
		return ":nthChild({part.step}n+{part.num})" when part.kind == SelectorKind.NthChild && part.step != 0
		return ":nthChild({part.num})" when part.kind == SelectorKind.NthChild
		return ":nthLastChild({part.num})" when part.kind == SelectorKind.NthLastChild
		return ":firstOfKind" when part.kind == SelectorKind.FirstOfKind
		return ":lastOfKind" when part.kind == SelectorKind.LastOfKind
		return ":nthOfKind({part.num})" when part.kind == SelectorKind.NthOfKind

		return ":inside({groupText(part)})" when part.kind == SelectorKind.Inside
		return ":directlyInside({groupText(part)})" when part.kind == SelectorKind.DirectlyInside
		return ":containing({groupText(part)})" when part.kind == SelectorKind.Containing
		return ":after({groupText(part)})" when part.kind == SelectorKind.After
		return ":immediatelyAfter({groupText(part)})" when part.kind == SelectorKind.ImmediatelyAfter

		return ":not({groupText(part)})" when part.kind == SelectorKind.Not
		return ":anyOf({groupText(part)})" when part.kind == SelectorKind.AnyOf
		return ":allOf({groupText(part)})" when part.kind == SelectorKind.AllOf

		return ":hover" when part.kind == SelectorKind.Hover
		return ":focus" when part.kind == SelectorKind.Focus
		return ":focusVisible" when part.kind == SelectorKind.FocusVisible
		return ":focusWithin" when part.kind == SelectorKind.FocusWithin
		return ":active" when part.kind == SelectorKind.Active
		return ":pressed" when part.kind == SelectorKind.Pressed
		return ":dragged" when part.kind == SelectorKind.Dragged
		return ":dropTarget" when part.kind == SelectorKind.DropTarget

		return ":checked" when part.kind == SelectorKind.Checked
		return ":indeterminate" when part.kind == SelectorKind.Indeterminate
		return ":disabled" when part.kind == SelectorKind.Disabled
		return ":enabled" when part.kind == SelectorKind.Enabled
		return ":readOnly" when part.kind == SelectorKind.ReadOnly
		return ":required" when part.kind == SelectorKind.Required
		return ":valid" when part.kind == SelectorKind.Valid
		return ":invalid" when part.kind == SelectorKind.Invalid

		return ":selected" when part.kind == SelectorKind.Selected
		return ":expanded" when part.kind == SelectorKind.Expanded
		return ":loading" when part.kind == SelectorKind.Loading
		return ":isEmpty" when part.kind == SelectorKind.IsEmpty

		return ":minWidth({part.real})" when part.kind == SelectorKind.MinWidth
		return ":maxWidth({part.real})" when part.kind == SelectorKind.MaxWidth
		return ":darkMode" when part.kind == SelectorKind.DarkMode
		return ":lightMode" when part.kind == SelectorKind.LightMode
		return ":rtl" when part.kind == SelectorKind.Rtl
		return ":reducedMotion" when part.kind == SelectorKind.ReducedMotion
		return ":highContrast" when part.kind == SelectorKind.HighContrast
		return ":platform({part.text})" when part.kind == SelectorKind.Platform

		return ":priority({part.num})" when part.kind == SelectorKind.Priority
		return ""
	}

	// groupText renders a predicate's nested selectors.
	internal def groupText(part SelectorMatch) string {
		let rendered = string[]
		for let (_, sel) in part.group {
			rendered.push(sel.str())
		}
		return rendered.join(",")
	}

	// Entry points ------------------------------------------------------------
	//
	// Each mirrors the method of the same name so a chain reads left to right
	// without naming `Selector` first.

	// Matches components of type T. See `Selector.kind`.
	def kind<T: component>() Selector {
		let selector = new Selector()
		return selector.kind<T>()
	}

	// Same as Selector.role on a new selector.
	def role(value Role) Selector {
		return new Selector().role(value)
	}

	// Same as Selector.variant on a new selector.
	def variant(name string) Selector {
		return new Selector().variant(name)
	}

	// Same as Selector.ref on a new selector.
	def ref(value string) Selector {
		return new Selector().ref(value)
	}

	// Same as Selector.state on a new selector.
	def state(name string) Selector {
		return new Selector().state(name)
	}

	// Same as Selector.own on a new selector.
	def own() Selector {
		return new Selector().own()
	}

	// Same as Selector.property on a new selector.
	def property(name string, value string) Selector {
		let selector = new Selector()
		return selector.property(name, value)
	}

	// Same as Selector.firstChild on a new selector.
	def firstChild() Selector {
		let selector = new Selector()
		return selector.firstChild()
	}

	// Same as Selector.lastChild on a new selector.
	def lastChild() Selector {
		let selector = new Selector()
		return selector.lastChild()
	}

	// Same as Selector.onlyChild on a new selector.
	def onlyChild() Selector {
		let selector = new Selector()
		return selector.onlyChild()
	}

	// Same as Selector.nthChild on a new selector.
	def nthChild(index int) Selector {
		let selector = new Selector()
		return selector.nthChild(index)
	}

	// Same as Selector.nthLastChild on a new selector.
	def nthLastChild(index int) Selector {
		let selector = new Selector()
		return selector.nthLastChild(index)
	}

	// Same as Selector.nth on a new selector.
	def nth(step int, offset int) Selector {
		let selector = new Selector()
		return selector.nth(step, offset)
	}

	// Same as Selector.odd on a new selector.
	def odd() Selector {
		let selector = new Selector()
		return selector.odd()
	}

	// Same as Selector.even on a new selector.
	def even() Selector {
		let selector = new Selector()
		return selector.even()
	}

	// Same as Selector.firstOfKind on a new selector.
	def firstOfKind() Selector {
		let selector = new Selector()
		return selector.firstOfKind()
	}

	// Same as Selector.lastOfKind on a new selector.
	def lastOfKind() Selector {
		let selector = new Selector()
		return selector.lastOfKind()
	}

	// Same as Selector.nthOfKind on a new selector.
	def nthOfKind(index int) Selector {
		let selector = new Selector()
		return selector.nthOfKind(index)
	}

	// Same as Selector.not on a new selector.
	def not(sel Selector) Selector {
		let selector = new Selector()
		return selector.not(sel)
	}

	// Same as Selector.anyOf on a new selector.
	def anyOf(sel ...Selector) Selector {
		let selector = new Selector()
		return selector.anyOf(...sel)
	}

	// Same as Selector.allOf on a new selector.
	def allOf(sel ...Selector) Selector {
		let selector = new Selector()
		return selector.allOf(...sel)
	}

	// Same as Selector.hover on a new selector.
	def hover() Selector {
		let selector = new Selector()
		return selector.hover()
	}

	// Same as Selector.focus on a new selector.
	def focus() Selector {
		let selector = new Selector()
		return selector.focus()
	}

	// Same as Selector.focusVisible on a new selector.
	def focusVisible() Selector {
		let selector = new Selector()
		return selector.focusVisible()
	}

	// Same as Selector.focusWithin on a new selector.
	def focusWithin() Selector {
		let selector = new Selector()
		return selector.focusWithin()
	}

	// Same as Selector.active on a new selector.
	def active() Selector {
		let selector = new Selector()
		return selector.active()
	}

	// Same as Selector.pressed on a new selector.
	def pressed() Selector {
		let selector = new Selector()
		return selector.pressed()
	}

	// Same as Selector.dragged on a new selector.
	def dragged() Selector {
