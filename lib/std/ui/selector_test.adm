partial module std.ui {
	use std.testing

	component MatchButton {
		view {}
		style {}
		type {}
	}

	// Holds a button named `inner`.
	component MatchHolder {
		view {
			MatchButton(ref = inner)
		}
		style {}
		type {}
	}

	// A button named `save`, a button, and a holder.
	component MatchPage {
		view {
			MatchButton(ref = save)
			MatchButton()
			MatchHolder()
		}
		style {}
		type {}
	}

	check "Selector" {
		component SelectorButton {
			view {}
			style {}
			type {}
		}

		component SelectorDialog {
			view {}
			style {}
			type {}
		}

		// `matches` asks the component as it is now: its name, kind, place among its
		// siblings, what is around it and its states.
		@test()
		def matchesAsksTheComponent() {
			let page = MatchPage()
			page.rerun()
			let (save, plain, holder) = (page.childNodes[0], page.childNodes[1], page.childNodes[2])
			holder.rerun()
			let inner = holder.childNodes[0]

			// Its name and kind; a selector without predicates matches anything.
			assert ref("save").matches(save) && !ref("save").matches(plain) && !ref("save").matches(inner)
			assert kind<MatchButton>().matches(save) && !kind<MatchButton>().matches(holder)
			assert kind<MatchButton>().ref("inner").matches(inner) && !kind<MatchHolder>().ref("inner").matches(inner)
			assert new Selector().matches(page)

			// Its place among its siblings; the root is nobody's child.
			assert firstChild().matches(save) && !firstChild().matches(plain) && lastChild().matches(holder) && !firstChild().matches(page)
			assert onlyChild().matches(inner) && !onlyChild().matches(save)
			assert nthChild(2).matches(plain) && nthLastChild(1).matches(holder) && nthLastChild(3).matches(save)
			assert odd().matches(save) && odd().matches(holder) && !odd().matches(plain) && even().matches(plain)
			assert nth(2, 3).matches(holder) && !nth(2, 3).matches(save)
			assert firstOfKind().matches(save) && firstOfKind().matches(holder) && lastOfKind().matches(plain) && nthOfKind(2).matches(plain)

			// What is around it.
			assert kind<MatchButton>().inside(kind<MatchPage>()).matches(inner) && !kind<MatchButton>().directlyInside(kind<MatchPage>()).matches(inner)
			assert new Selector().directlyInside(kind<MatchHolder>()).matches(inner) && !new Selector().inside(kind<MatchHolder>()).matches(save)
			assert new Selector().containing(ref("inner")).matches(page) && new Selector().containing(ref("inner")).matches(holder) && !new Selector().containing(ref("inner")).matches(save)
			assert new Selector().after(ref("save")).matches(holder) && new Selector().after(ref("save")).matches(plain) && !new Selector().after(ref("save")).matches(save)
			assert new Selector().immediatelyAfter(ref("save")).matches(plain) && !new Selector().immediatelyAfter(ref("save")).matches(holder)

			// Logic.
			assert not(ref("save")).matches(plain) && !not(ref("save")).matches(save)
			assert anyOf(ref("save"), kind<MatchHolder>()).matches(holder) && !anyOf(ref("save"), kind<MatchHolder>()).matches(plain)
			assert allOf(kind<MatchButton>(), firstChild()).matches(save) && !allOf(kind<MatchButton>(), firstChild()).matches(plain)
			assert (ref("save") | ref("inner")).matches(inner) && (kind<MatchButton>() & ref("save")).matches(save)

			// Its states, as the view runtime sets them.
			assert !hover().matches(save) && enabled().matches(save) && !disabled().matches(save)
			save.isHover = true
			save.isPressed = true
			save.isFocused = true
			save.isFocusVisible = true
			page.isFocusWithin = true
			assert hover().matches(save) && pressed().matches(save) && active().matches(save) && focus().matches(save) && focusVisible().matches(save)
			assert focusWithin().matches(page) && !focusWithin().matches(plain) && ref("save").hover().matches(save) && !ref("save").hover().matches(plain)
			holder.enabled = false
			inner.isBlocked = true
			assert disabled().matches(holder) && disabled().matches(inner) && !enabled().matches(inner)
			assert isEmpty().matches(save) && !isEmpty().matches(holder) && priority(2).matches(save)
		}

		// A predicate a component has no answer to never holds, and a selector names
		// the ones it carries.
		@test()
		def unansweredPredicatesNeverHold() {
			let page = MatchPage()
			page.rerun()
			let save = page.childNodes[0]
			assert !id("save").matches(save) && !class("primary").matches(save) && !checked().matches(save) && !selected().matches(save)
			assert !ref("save").expanded().matches(save) && !minWidth(0.0).matches(save) && !platform("linux").matches(save)
			assert ref("save").hover().unanswered().len() == 0
			let open = kind<MatchButton>().checked().inside(class("bar").checked()).unanswered()
			assert open.len() == 2 && open[0] == SelectorKind.Checked && open[1] == SelectorKind.Class
		}

		// A change of state is matched by the component it is of, the state's name and,
		// with `own()`, the component that listens.
		@test()
		def matchesEventAsksTheChange() {
			let page = MatchPage()
			page.rerun()
			let (save, plain) = (page.childNodes[0], page.childNodes[1])
			let change = StateChange{source: save, state: "selected", value: 1, previous: 0}
			assert ref("save").state("selected").matchesEvent(change) && !ref("save").state("open").matchesEvent(change)
			assert state("selected").matchesEvent(change) && !ref("other").state("selected").matchesEvent(change)
			assert kind<MatchButton>().firstChild().matchesEvent(change) && new Selector().matchesEvent(change)
			assert own().state("selected").matchesEvent(change, save) && !own().matchesEvent(change, plain) && !own().matchesEvent(change)
			// Outside a change neither holds, and a selector says so.
			assert !own().matches(save) && !state("selected").matches(save)
			let open = own().state("selected").unanswered()
			assert open.len() == 2 && open[0] == SelectorKind.Own && open[1] == SelectorKind.State
			assert ref("tabs").state("selected").str() == ":ref(tabs):state(selected)" && own().str() == ":own"
		}

		@test()
		def refIsPartOfTheKey() {
			assert ref("save").str() == ":ref(save)" && kind<MatchButton>().ref("save").str() == ref("save").kind<MatchButton>().str()
			assert ref("save").specificity() == 1000
			let failed = false
			ref("a").ref("b").validate() onerror (err error) {
				failed = err.message.contains("more than one ref()")
				recover none
			}
			assert failed
		}

		@test()
		def chainingDoesNotShareState() {
			// A selector is a value: branching from one must not alter it, nor
			// the other branches.
			let base = kind<SelectorButton>().class("primary")
			let hovered = base.hover()
			let off = base.disabled()

			assert base.str() == "<std.ui.SelectorButton>.primary"
			assert hovered.str() == "<std.ui.SelectorButton>.primary:hover"
			assert off.str() == "<std.ui.SelectorButton>.primary:disabled"
		}

		@test()
		def kindResolvesTheComponentType() {
			assert kind<SelectorButton>().str() == "<std.ui.SelectorButton>"
			assert kind<SelectorDialog>().str() == "<std.ui.SelectorDialog>"
		}

		@test()
		def strIsCanonical() {
			// Same predicates, different chain order, same key.
			let a = kind<SelectorButton>().hover().class("primary").id("save")
			let b = id("save").hover().kind<SelectorButton>().class("primary")
			assert a.str() == b.str()
			assert a.str() == "#save<std.ui.SelectorButton>.primary:hover"
		}

		@test()
		def strDropsDuplicates() {
			assert hover().hover().str() == ":hover"

			// Three or more repeats, and repeats of two interleaved predicates:
			// two identical parts can pass even when dedupe is broken.
			assert hover().hover().hover().str() == ":hover"
			assert class("a").class("b").class("a").class("b").str() == ".a.b"
		}

		@test()
		def specificityRanksIdOverClassOverKind() {
			assert id("save").specificity() > class("primary").specificity()
			assert class("primary").specificity() > kind<SelectorButton>().specificity()
			assert kind<SelectorButton>().specificity() > hover().specificity()

			// An id outranks any number of classes.
			assert id("save").specificity() > classAll("a", "b", "c").specificity()
		}

		@test()
		def environmentConditionsCarryNoSpecificity() {
			assert darkMode().specificity() == 0
			assert minWidth(600.0).specificity() == 0
			assert kind<SelectorButton>().darkMode().specificity() == kind<SelectorButton>().specificity()
		}

		@test()
		def priorityDominates() {
			let plain = id("save").class("a").class("b")
			assert kind<SelectorButton>().priority(1).specificity() > plain.specificity()
		}

		@test()
		def relationshipsNest() {
			let sel = kind<SelectorButton>().inside(kind<SelectorDialog>())
			assert sel.str() == "<std.ui.SelectorButton>:inside(<std.ui.SelectorDialog>)"

			let held = kind<SelectorDialog>().containing(kind<SelectorButton>())
			assert held.str() == "<std.ui.SelectorDialog>:containing(<std.ui.SelectorButton>)"

			// A deeper requirement is more specific than a bare kind.
			assert sel.specificity() > kind<SelectorButton>().specificity()
		}

		@test()
		def logicCombinators() {
			let either = anyOf(kind<SelectorButton>(), kind<SelectorDialog>())
			assert either.str() == ":anyOf(<std.ui.SelectorButton>,<std.ui.SelectorDialog>)"

			let negated = kind<SelectorButton>().not(class("ghost"))
			assert negated.str() == "<std.ui.SelectorButton>:not(.ghost)"
		}

		@test()
		def infixOperators() {
			let anded = kind<SelectorButton>() & class("primary")
			assert anded.str() == "<std.ui.SelectorButton>.primary"

			let ored = kind<SelectorButton>() | kind<SelectorDialog>()
			assert ored.str() == ":anyOf(<std.ui.SelectorButton>,<std.ui.SelectorDialog>)"
		}

		@test()
		def nthSugar() {
			assert nthChild(3).str() == ":nthChild(3)"
			assert odd().str() == ":nthChild(2n+1)"
			assert even().str() == ":nthChild(2n+2)"
			assert nth(3, 2).str() == ":nthChild(3n+2)"
		}

		@test()
		def validateAcceptsSaneSelectors() !none {
			try kind<SelectorButton>().class("primary").hover().validate()
			try id("save").minWidth(100.0).maxWidth(200.0).validate()
			return none
		}

		@test()
		def validateRejectsTwoIds() {
			let sel = id("a").id("b")
			let result = sel.validate() onerror (err error) {
				recover none
			}
			assert sel.has(SelectorKind.Id)
		}

		@test()
		def validateRejectsContradictions() {
			assert firstChild().lastChild().has(SelectorKind.FirstChild)
			assert disabled().enabled().has(SelectorKind.Enabled)
			assert darkMode().lightMode().has(SelectorKind.DarkMode)
		}

		@test()
		def explainIncludesTheScore() {
			let text = kind<SelectorButton>().hover().explain()
			assert text.contains("<std.ui.SelectorButton>:hover")
			assert text.contains("specificity")
		}

		@test()
		def selectorsWorkAsStyleChildrenKeys() {
			let styles = map<string, string>{}
			styles[kind<SelectorButton>().hover().str()] = "hovered"
			styles[hover().kind<SelectorButton>().str()] = "still hovered"

			// Canonical keys collapse the two spellings into one entry.
			assert styles.len() == 1
			assert styles[kind<SelectorButton>().hover().str()] == "still hovered"
		}
	}
}
