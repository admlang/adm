partial module std.ui {
	use (
		std.formats.image
		std.gfx.canvas
		std.gfx.color::(Color, RGBA)
		std.gfx.render
		std.math.geom::(Point, Rect, Size)
		std.services.clipboard::Clipboard
		std.services.vault::(Vault, VaultConfig)
		std.testing
		std.ui.renderer as r
		std.ui.renderer::(PlatformEvent, PlatformEventKind)
		std.services.vault.kept::forget
		std.ui.styles::*
		std.ui.frames::currentTask
		std.time
		std.units::Pixels
	)

	// A host and renderer with no screen: every window is 100 by 60 and numbered from 1
	// as it opens. Events come from `script`, one list per poll, then none; the committed
	// frames of window `watched` are drawn on `shown`.
	internal type Stage {
		shown   canvas.Canvas
		// What the first window showed last, and the shapes the host was given.
		glass   canvas.Canvas
		shapes  string[]
		// The window that was moved last and where the desktop has it; what was asked.
		moved   uint
		placed  Rect<Pixels>                = Rect<Pixels>{}
		moves   string[]
		watched uint                        = uint(1)
		script  PlatformEvent[][]
		opened  int
		closed  int[]
		polls   int
		// Each title the host was given, in order.
		titles  string[]
		frames  map<uint, int>              = map<uint, int>{}
		// The alpha of the clear each window's last frame started with.
		grounds map<uint, int>              = map<uint, int>{}
		// What says, per window in the order opened, whether a point drags it.
		drags   (def(Point<Pixels>) bool)[]
		// The window system's clipboard, and whether it refuses the caller.
		held    string                      = ""
		refuses bool                        = false
		// How often the loop rested and was woken, and what runs while it rests.
		waits   int
		wakes   int
		resting ?(def())                    = none
		// What the host was told, one line each.
		told    string[]
		// What each window was opened with: title, size, position and state.
		asked   string[]
		// The windows opened without the desktop's frame, by title.
		bare    string[]
		// The pointer shape it was last given.
		pointer Cursor                      = Cursor.Default
		// Whether its frames hold the last one, and how many committed frames were drawn
		// over it.
		keeps   bool
		overs   int
		// The task each call that opens, closes, names, raises or marks a window, or
		// shows the tray, ran on; the task the loop rested on last.
		callers uint[]
		looper  uint

		def new() {
			shown = new canvas.Canvas(100, 60)
			glass = new canvas.Canvas(100, 60)
		}

		def attach(host r.Host) !none {
			return none
		}

		def openWindow(cfg r.WindowConfig) !r.Window {
			callers.push(currentTask())
			opened++
			let at = cfg.position
			let place = "anywhere"
			place = "at {int(float(at.x))},{int(float(at.y))}" unless at is none
			asked.push("{cfg.title} {int(cfg.size.width)}x{int(cfg.size.height)} {place} {cfg.state}")
			bare.push(cfg.title) unless cfg.decorated
			return new r.Window(uint(opened))
		}

		def setWindowTitle(win r.Window, title string) !none {
			callers.push(currentTask())
			titles.push(title)
			return none
		}

		def setWindowIcon(win r.Window, icon image.Image) !none {
			callers.push(currentTask())
			told.push("window {win.id()} icon")
			return none
		}

		def setWindowVisible(win r.Window, visible bool) !none {
			told.push("window {win.id()} {visible ?? ("shown", "hidden")}")
			return none
		}

		def setWindowState(win r.Window, state WindowState) !none {
			told.push("window {win.id()} {state}")
			return none
		}

		def setCursor(win r.Window, cursor Cursor) !none {
			pointer = cursor
			return none
		}

		def poll() !PlatformEvent[] {
			let poll = polls
			polls++
			// Polled this often, the script never closed its windows: end the test.
			if poll > 50 {
				let all PlatformEvent[]
				for let id = 1; id <= opened; id++ {
					all.push(PlatformEvent{kind: PlatformEventKind.Close, window: uint(id)})
				}
				return all
			}
			return script[poll] when poll < script.len()
			return []
		}

		def wait(limit duration) !none {
			waits++
			looper = currentTask()
			let run = resting
			run() unless run is none
			return none
		}

		def wake() {
			wakes++
		}

		def nextFrame(win r.Window) !r.Frame {
			return r.Frame{ctx: new canvas.DrawContext(new Size(100.0, 60.0)), kept: keeps && frames.hasKey(win.id())}
		}

		def commit(win r.Window, frame r.Frame) !none {
			let count = 0
			count = frames[win.id()] when frames.hasKey(win.id())
			frames = frames.set(win.id(), count + 1)
			overs++ when frame.over
			// What the frame starts from: the alpha of its clear.
			for let (_, cmd) in frame.ctx.commands() {
				if cmd.kind == render.CommandKind.Clear {
					grounds = grounds.set(win.id(), int(cmd.color.rgba.a))
					break
				}
			}
			shown.apply(frame.ctx) when win.id() == watched
			glass.apply(frame.ctx) when win.id() == uint(1)
			return none
		}

		def release(win r.Window) !none {
			return none
		}

		// The pixels of the first window's frames, whole.
		def read(win r.Window, left int, top int, width int, height int) !byte[] {
			fail "only the first window is kept, whole" when win.id() != uint(1) || left != 0 || top != 0 || width != glass.width || height != glass.height
			return glass.pixels.clone()
		}

		def setWindowShape(win r.Window, width int, height int, pixels byte[]) !none {
			let there = 0
			for let i = 3; i < pixels.len(); i += 4 {
				there++ when pixels[i] != 0
			}
			shapes.push("shape {win.id()} {width}x{height} {there}")
			return none
		}

		def closeWindow(win r.Window) !none {
			callers.push(currentTask())
			closed.push(int(win.id()))
			return none
		}

		def displays() !Display[] {
			return [Display{primary: true}]
		}

		def windowBounds(win r.Window) !Rect<Pixels> {
			return placed when moved == win.id()
			return Rect<Pixels>{left: 0(px), top: 0(px), right: 100(px), bottom: 60(px)}
		}

		// The desktop gives the window the size asked for and keeps it on the screen: a
		// place left of 0 becomes 0.
		def setWindowBounds(win r.Window, bounds Rect<Pixels>) !none {
			let left = float(bounds.left).max(0.0)
			placed = Rect<Pixels>{left: left * 1(px), top: bounds.top, right: (left + float(bounds.width)) * 1(px), bottom: bounds.bottom}
			moved = win.id()
			moves.push("{win.id()} to {int(float(bounds.left))},{int(float(bounds.top))} {int(float(bounds.width))}x{int(float(bounds.height))}")
			return none
		}

		def raiseWindow(win r.Window) !none {
			callers.push(currentTask())
			moves.push("{win.id()} raised")
			return none
		}

		def clipboardText() !string {
			fail "stage: not the windows' task" when refuses
			return held
		}

		def setClipboardText(text string) !none {
			fail "stage: not the windows' task" when refuses
			held = text
			return none
		}

		def startTextInput(win r.Window, kind TextKind) !none {
			told.push("window {win.id()} text input {kind}")
			return none
		}

		def stopTextInput(win r.Window) !none {
			told.push("window {win.id()} text input off")
			return none
		}

		def setTextInputCaret(win r.Window, caret Rect<Pixels>) !none {
			return none
		}

		def setWindowDragTest(win r.Window, test ?(def(Point<Pixels>) bool)) !none {
			drags.push(test) unless test is none
			return none
		}

		def showTray(icon image.Image, tooltip string, menu MenuEntry[]) !none {
			callers.push(currentTask())
			told.push("tray {tooltip} {menu.len()}")
			return none
		}

		def hideTray() !none {
			callers.push(currentTask())
			told.push("tray off")
			return none
		}
	}

	internal let stageClicks = string[]
	internal let stageKept = int[]
	internal let stageStates = string[]

	style StagePlate {
		Box
		Background
	}

	view StageEmpty {}

	component StageButton {
		style StagePlate
		view StageEmpty
		type {
			def new() {
				style.width = 40(px)
				style.height = 20(px)
				style.background = new BackgroundFill(new Color(RGBA{r: 0, g: 0, b: 200, a: 255}))
			}
		}
	}

	component StagePage {
		style StagePlate
		view {
			StageButton()
		}
		type {
			def new() {
				style.width = fill
				style.height = fill
				style.background = new BackgroundFill(new Color(RGBA{r: 255, g: 255, b: 255, a: 255}))
			}
		}
	}

	// A page whose `render` makes a theme of its own and draws with it, as a preview of
	// a theme does.
	component ThemeSample {
		style StagePlate
		view {}
		type {
			def new() {
				style.width = fill
				style.height = fill
			}

			def render(ctx RenderContext) {
				let theme = new Theme(Appearance{scheme: ColorScheme.Dark})
				theme.palette.window = new Color(RGBA{r: 10, g: 20, b: 30, a: 255})
				theme.colors = theme.colors.set("sample", new Color(RGBA{r: 200, g: 0, b: 0, a: 255}))
				theme.fonts.body = Font{family: "serif", size: 13(px)}
				ctx.draw.fill(Rect{left: 0.0, top: 0.0, right: 40.0, bottom: 20.0}, theme.color("sample"))
			}
		}
	}

	// The root of a second window: two buttons.
	component StagePalette {
		style StagePlate
		view {
			StageButton()
			StageButton()
		}
		type {}
	}

	// A chrome for a window: it places what it is given.
	component StageFrame {
		style StagePlate
		view {
			children()
		}
		type {}
	}

	// What `TestAddedFromAnotherTaskWhileRunning` adds from a task of its own once the
	// windows run.
	internal def addLate(theme Theme, sheet StyleSheet, added int[]) {
		for UI.windows().len() == 0 {
			time.sleep(1ms)
		}
		let dot = canvas.record(def (painter canvas.Painter) {})
		UI.addIcons(IconSet{name: "late", icons: map<string, canvas.Picture>{"dot": dot}})
		UI.setTheme(theme)
		UI.addStyles(sheet)
		added[0] = 1
	}

	// What `TestWindowCallsFromAnotherTask` does from a task of its own once the windows
	// run, noting each outcome in `done`.
	internal def callLate(done string[]) !none {
		for UI.windows().len() == 0 {
			time.sleep(1ms)
		}
		let first = UI.windows()[0]
		try UI.setWindowTitle(first, "late")
		try UI.raiseWindow(first)
		let second = try UI.openWindow(StagePage(), new r.WindowConfig("second", 100, 60))
		done.push("opened {second.id()} of {UI.windows().len()}")
		try UI.setWindowIcon(second, new image.Image(16, 16))
		try UI.showTray(new image.Image(16, 16), "late")
		try UI.hideTray()
		let refused = new r.WindowConfig("refused", 100, 60)
		refused.persist = "no such name!"
		let _ = UI.openWindow(StagePage(), refused) onerror (err error) {
			done.push("refused {err.message.contains("cannot be kept")}")
			recover first
		}
		try UI.closeWindow(second)
		done.push("closed, {UI.windows().len()} left")
		return none
	}

	// What `TestWindowCallCancelled` asks from a task of its own once the windows run:
	// says when it asks, then how the call failed ("" when it did not).
	internal def titleLate(asked int[], outcome string[]) {
		for UI.windows().len() == 0 {
			time.sleep(1ms)
		}
		asked[0] = 1
		let failure = ""
		UI.setWindowTitle(UI.windows()[0], "late") onerror (err error) {
			failure = err.message
			recover none
		}
		outcome.push(failure)
	}

	check "UI service" {
		@on(UI.click)
		def onClick(evt Event<ClickEvent>) {
			let count = evt.result.target.children.len()
			stageClicks.push(count == 0 ?? ("button", count == 1 ?? ("page", "palette")))
		}

		// Sends the palette to the tray the first time it is asked to close.
		@on(UI.closeRequested)
		def onCloseRequested(evt Event<CloseRequest>) {
			let request = evt.result
			return when request.window.id() != uint(1) || stageKept.len() > 0
			stageKept.push(int(request.window.id()))
			request.cancel()
			request.window.visible = false
		}

		@on(UI.windowStateChanged)
		def onState(evt Event<r.Window>) {
			stageStates.push("{evt.result.id()} {evt.result.state}")
		}

		// `run` lays each window's tree out, draws it into each frame, and gives a click the
		// component under it, the window's root past every other component. A window whose
		// close request is cancelled stays open; hidden, it is not drawn; `run` returns once
		// every window is closed.
		@test()
		def TestRunDrawsAndRoutes() !none {
			stageClicks = string[]
			stageKept = int[]
			stageStates = string[]
			let stage = new Stage()
			let click = def (window int, x float, y float) PlatformEvent {
				let event = PlatformEvent{kind: PlatformEventKind.MouseUp, window: uint(window)}
				event.position = new Point(x, y)
				return event
			}
			let close = def (window int) PlatformEvent {
				return PlatformEvent{kind: PlatformEventKind.Close, window: uint(window)}
			}
			// Window 1 is the palette, opened before `run`; window 2 is the page `run` opens.
			// The desktop minimizes the page on the fourth pass.
			let minimized = PlatformEvent{kind: PlatformEventKind.StateChange, window: uint(2), state: WindowState.Minimized}
			stage.script = [[], [click(1, 80.0, 50.0), click(2, 10.0, 10.0), click(2, 80.0, 40.0)], [close(1)], [minimized], [close(1), close(2)]]
			stage.watched = uint(2)
			try UI.config(UIConfig{renderer: stage, host: stage})
			try await UI.start()
			// The palette shows what is behind it: its frames start from nothing.
			let glass = new r.WindowConfig("palette", 100, 60)
			glass.transparent = true
			glass.clickThrough = r.ClickThrough.Empty
			let palette = try UI.openWindow(StagePalette(), glass)
			try await UI.run(StagePage(), new r.WindowConfig("stage", 100, 60))
			try await UI.stop()
			let at = def (x int, y int) int {
				let i = (y * 100 + x) * 4
				return int(stage.shown.pixels[i]) * 65536 + int(stage.shown.pixels[i + 1]) * 256 + int(stage.shown.pixels[i + 2])
			}
			assert at(10, 10) == 200 && at(80, 40) == 0xffffff
			assert stageClicks.join(",") == "palette,button,page"
			assert palette.transparent && stage.grounds[uint(1)] == 0 && stage.grounds[uint(2)] == 255
			// The palette lets presses through where it shows nothing: the host got its
			// shape once, for the frames that followed covered the same.
			assert stage.shapes.join(",") == "shape 1 100x60 1600"
			// Each window gave the host what says where it is dragged by: nowhere, here.
			assert stage.drags.len() == 2 && !stage.drags[0](new Point<Pixels>(10(px), 10(px)))
			// The palette's first close was cancelled and hid it: no frames while hidden, and
			// none for the page once the desktop minimized it. Both
			// windows closed on the last pass, which ended the run.
			assert stageKept.len() == 1 && !palette.visible
			assert palette.id() == uint(1) && stage.closed.len() == 2 && stage.closed[0] == 1 && stage.closed[1] == 2
			assert stage.frames[uint(1)] == 2 && stage.frames[uint(2)] == 3
			// The host was told to hide the palette, and its report of the page's state reached
			// the window and the event.
			assert stage.told.join(",") == "window 1 hidden" && stageStates.join(",") == "2 Minimized"
			stage.told = []

			// While a window is open the `Clipboard` service reads and writes the
			// host's clipboard.
			try UI.config(UIConfig{renderer: stage, host: stage})
			try await UI.start()
			let board = try UI.openWindow(StagePalette(), new r.WindowConfig("board", 100, 60))
			try Clipboard.copy("copied in a window")
			assert stage.held == "copied in a window"
			stage.held = "from the desktop"
			assert try Clipboard.paste() == "from the desktop"
			try Clipboard.clear()
			assert stage.held == "" && !(try Clipboard.has())
			try UI.closeWindow(board)
			try await UI.stop()

			// The tray takes an icon, a tooltip and a menu, and can be removed.
			let quit = MenuEntry{label: "Quit", onSelect: def () {}}
			try UI.config(UIConfig{renderer: stage, host: stage})
			try await UI.start()
			try UI.showTray(new image.Image(16, 16), "Stage", [MenuEntry{label: "Show"}, MenuEntry{separator: true}, quit])
			try UI.hideTray()
			try await UI.stop()
			assert stage.told.join(",") == "tray Stage 3,tray off"
		}

		// A window is drawn after something happened in it and for the frames that settle
		// it, then the loop rests. A component's `redraw()` during a rest wakes the host
		// and gets one more frame; nothing else does.
		// A window opened with a theme gives it to what it shows; another window reads
		// `UI.theme()`.
		@test()
		def TestWindowTheme() !none {
			stageKept = [0]
			let stage = new Stage()
			try UI.config(UIConfig{renderer: stage, host: stage})
			try await UI.start()
			let own = new Theme(Appearance{scheme: ColorScheme.Dark})
			let themed = new r.WindowConfig("themed", 100, 60)
			themed.theme = own
			let page = StagePalette()
			let other = StagePalette()
			let first = try UI.openWindow(page, themed)
			let second = try UI.openWindow(other, new r.WindowConfig("plain", 100, 60))
			assert themeOf(page) == own && themeOf(other) == UI.theme() && UI.theme() != own
			try UI.closeWindow(first)
			try UI.closeWindow(second)
			try await UI.stop()
		}

		// A window's `bounds` are where the desktop has it; set, they move and resize it,
		// and then show what the desktop made of that. A window is raised when asked.
		@test()
		def TestWindowBounds() !none {
			stageKept = [0]
			let stage = new Stage()
			try UI.config(UIConfig{renderer: stage, host: stage})
			try await UI.start()
			let win = try UI.openWindow(StagePalette(), new r.WindowConfig("palette", 100, 60))
			assert float(win.bounds.left) == 0.0 && float(win.bounds.width) == 100.0 && float(win.bounds.height) == 60.0
			try UI.raiseWindow(win)
			let rests = [0]
			let seen = string[]
			let active = bool[]
			stage.resting = def () {
				rests[0]++
				active.push(win.active)
				// Asked for a place left of the screen, 150 by 80.
				win.bounds = Rect<Pixels>{left: -50(px), top: 10(px), right: 100(px), bottom: 90(px)} when rests[0] == 1
				seen.push("{int(float(win.bounds.left))},{int(float(win.bounds.top))} {int(float(win.bounds.width))}x{int(float(win.bounds.height))}") when rests[0] == 4
			}
			// The page opens maximized; the desktop then makes it the window the keyboard
			// goes to, and takes that away again.
			let large = new r.WindowConfig("stage", 100, 60)
			large.state = WindowState.Maximized
			let quiet PlatformEvent[]
			let script PlatformEvent[][]
			for let i = 0; i <= stage.polls; i++ {
				script.push(quiet)
			}
			script.push([PlatformEvent{kind: PlatformEventKind.Focus, window: uint(1)}])
			// Long enough for the frames an event asks for to settle and the loop to rest.
			for let i = 0; i < 12; i++ {
				script.push(quiet)
			}
			script.push([PlatformEvent{kind: PlatformEventKind.Blur, window: uint(1)}])
			stage.script = script
			try await UI.run(StagePage(), large)
			try await UI.stop()
			// The host was told once; the desktop kept the window on the screen, and the
			// window shows that.
			assert stage.moves.join(";") == "1 raised;1 to -50,10 150x80"
			assert seen.join(";") == "0,10 150x80"
			assert stage.told.join(",") == "window 2 Maximized"
			assert active.len() > 2 && active[0] && !active[active.len() - 1]
		}

		// A window opened with `persist` is kept where the user left it and opens there in
		// the next run, on a display that is still there; its configuration is left as
		// written.
		@test()
		def TestWindowIsKept() !none {
			stageKept = [0]
			Vault.config(VaultConfig{memoryKiB: 64, passes: 1}) onerror recover none
			forget("test.window")
			let stage = new Stage()
			try UI.config(UIConfig{renderer: stage, host: stage})
			try await UI.start()
			let kept = new r.WindowConfig("palette", 100, 60)
			kept.persist = "test.window"
			let win = try UI.openWindow(StagePalette(), kept)
			let rests = [0]
			stage.resting = def () {
				rests[0]++
				win.bounds = Rect<Pixels>{left: 30(px), top: 10(px), right: 180(px), bottom: 90(px)} when rests[0] == 1
				win.state = WindowState.Maximized when rests[0] == 3
			}
			try await UI.run(StagePage(), new r.WindowConfig("stage", 100, 60))
			try await UI.stop()
			assert stage.asked.join(";") == "palette 100x60 anywhere Normal;stage 100x60 anywhere Normal"

			let again = new Stage()
			try UI.config(UIConfig{renderer: again, host: again})
			try await UI.start()
			let back = try UI.openWindow(StagePalette(), kept)
			assert again.asked.join(";") == "palette 150x80 at 30,10 Maximized"
			assert kept.size.width == 100.0 && kept.position is none && kept.state == WindowState.Normal
			// The same settings opened again while that window is open: the name stays
			// the first window's, so the second opens as written.
			let twin = try UI.openWindow(StagePalette(), kept)
			assert again.asked.join(";") == "palette 150x80 at 30,10 Maximized;palette 100x60 anywhere Normal"
			try UI.closeWindow(twin)
			try UI.closeWindow(back)

			// A name the values cannot be kept under is refused when the window opens.
			let unnamed = new r.WindowConfig("palette", 100, 60)
			unnamed.persist = "main window"
			let refused = false
			UI.openWindow(StagePalette(), unnamed) onerror (err error) {
				refused = true
				recover back
			}
			assert refused
			try await UI.stop()
			forget("test.window")

			// A place is used again only while a display shows enough of the window there.
			let screen = Display{name: "DP-1", workArea: Rect<Pixels>{left: 0(px), top: 0(px), right: 1920(px), bottom: 1040(px)}}
			let there = KeptWindow{left: 1800.0, top: 900.0, width: 400.0, height: 300.0, state: WindowState.Normal}
			let gone = KeptWindow{left: 2600.0, top: 100.0, width: 400.0, height: 300.0, state: WindowState.Normal}
			assert onDisplays(there, [screen]) && !onDisplays(gone, [screen])
			assert onDisplays(gone, [Display{primary: true}])
		}

		// A window is put against the edges of a display's work area; one that lets every
		// press through is given a shape with nothing in it when it is opened.
		@test()
		def TestPlacementAndOverlay() !none {
			let screen = Display{name: "DP-1", bounds: Rect<Pixels>{left: -1920(px), top: 0(px), right: 0(px), bottom: 1080(px)}, workArea: Rect<Pixels>{left: -1920(px), top: 0(px), right: 0(px), bottom: 1040(px)}}
			let note = new r.WindowConfig("note", 300, 100)
			note.placeOn(screen, Align{horizontal: Alignment.End, vertical: Alignment.Start}, 16.0)
			let corner = note.position
			assert !(corner is none)
			if !(corner is none) {
				assert float(corner.x) == -316.0 && float(corner.y) == 16.0
			}
			note.placeOn(screen, Align{horizontal: Alignment.Center, vertical: Alignment.End})
			let low = note.position
			if !(low is none) {
				assert float(low.x) == -1110.0 && float(low.y) == 940.0
			}
			note.placeOn(screen, Align{}, 8.0)
			let first = note.position
			if !(first is none) {
				assert float(first.x) == -1912.0 && float(first.y) == 8.0
			}

			let stage = new Stage()
			try UI.config(UIConfig{renderer: stage, host: stage})
			try await UI.start()
			note.clickThrough = r.ClickThrough.All
			note.alwaysOnTop = true
			let win = try UI.openWindow(StagePalette(), note)
			assert win.clickThrough == r.ClickThrough.All && stage.shapes.join(",") == "shape 1 1x1 0"
			// The shape of what is drawn is for a transparent window only.
			let plain = new r.WindowConfig("plain", 100, 60)
			plain.clickThrough = r.ClickThrough.Empty
			let opaque = try UI.openWindow(StagePalette(), plain)
			assert opaque.clickThrough == r.ClickThrough.None
			try await UI.stop()
		}

		@test()
		def TestFramesOnDemand() !none {
			// The suite's close handler keeps a window only while this is empty.
			stageKept = [0]
			let stage = new Stage()
			let page = StagePage()
			let asked = [0]
			stage.resting = def () {
				asked[0]++
				// On the first rest only.
				page.redraw() when asked[0] == 1
			}
			try UI.config(UIConfig{renderer: stage, host: stage})
			try await UI.start()
			try await UI.run(page, new r.WindowConfig("stage", 100, 60))
			try await UI.stop()
			// Three frames for the window that opened, one for the redraw; the loop rested
			// on every other pass until the stage closed the window.
			assert stage.frames[uint(1)] == 4 && stage.wakes >= 1 && stage.waits > 10

			// With `forceRedraw` every pass draws and none rests.
			let eager = new Stage()
			try UI.config(UIConfig{renderer: eager, host: eager, forceRedraw: true})
			try await UI.start()
			try await UI.run(StagePage(), new r.WindowConfig("stage", 100, 60))
			try await UI.stop()
			assert eager.frames[uint(1)] > 40 && eager.waits == 0
			stageKept = int[]
		}

		// A theme made and changed inside a `render` is no theme change: the loop draws
		// the window and rests, as for any page.
		@test()
		def TestThemeMadeInRenderAsksNoFrame() !none {
			stageKept = [0]
			let stage = new Stage()
			try UI.config(UIConfig{renderer: stage, host: stage})
			try await UI.start()
			try await UI.run(ThemeSample(), new r.WindowConfig("stage", 100, 60))
			try await UI.stop()
			assert stage.frames[uint(1)] <= 3 && stage.waits > 10
			stageKept = int[]
		}

		// A renderer that holds the last frame is given only what changed: the frames
		// after the first that show nothing new are not committed, and a component's
		// `redraw()` gives a frame of its part, drawn over the last, that shows what a
		// whole frame shows.
		@test()
		def TestFramesShowWhatChanged() !none {
			stageKept = [0]
			let stage = new Stage()
			stage.keeps = true
			let page = StagePage()
			let asked = [0]
			stage.resting = def () {
				asked[0]++
				// The button, a small part of the window.
				page.childNodes[0].redraw() when asked[0] == 1 && page.childNodes.len() > 0
			}
			try UI.config(UIConfig{renderer: stage, host: stage})
			try await UI.start()
			try await UI.run(page, new r.WindowConfig("stage", 100, 60))
			try await UI.stop()
			assert stage.frames[uint(1)] == 2 && stage.overs == 1
			let whole = new Stage()
			try UI.config(UIConfig{renderer: whole, host: whole})
			try await UI.start()
			try await UI.run(StagePage(), new r.WindowConfig("stage", 100, 60))
			try await UI.stop()
			assert stage.shown.pixels.equals(whole.shown.pixels)
			stageKept = int[]
		}

		// A window opened with a chrome has none of the desktop's: the chrome stands for
		// the window and holds its root. What is in a window finds it with
		// `context<Window>()`, and `UI.window` finds one by its title or its name.
		@test()
		def TestWindowChromeAndLookup() !none {
			stageKept = [0]
			let stage = new Stage()
			try UI.config(UIConfig{renderer: stage, host: stage})
			try await UI.start()
			let frame = StageFrame()
			let framed = new r.WindowConfig("framed", 100, 60)
			framed.chrome = frame
			framed.name = "main"
			let page = StagePalette()
			let other = StagePalette()
			let first = try UI.openWindow(page, framed)
			let second = try UI.openWindow(other, new r.WindowConfig("plain", 100, 60))
			// Only the first opened without a frame, and its configuration is as written.
			assert stage.bare.join(",") == "framed" && framed.decorated
			let inside component = page
			assert frame.childNodes.len() == 1 && frame.childNodes[0] == inside
			let above = page.parent()
			let holder component = frame
			assert !(above is none) && above == holder

			let own = page.context<r.Window>()
			let its = other.context<r.Window>()
			assert !(own is none) && own.id() == first.id()
			assert !(its is none) && its.id() == second.id()

			let byTitle = UI.window(title = "plain")
			let byName = UI.window(name = "main")
			let both = UI.window(title = "framed", name = "main")
			assert !(byTitle is none) && byTitle.id() == second.id()
			assert !(byName is none) && byName.id() == first.id()
			assert !(both is none) && both.id() == first.id()
			assert UI.window(title = "plain", name = "main") is none
			assert UI.window(title = "nothing") is none && UI.window() is none
			try UI.closeWindow(first)
			assert UI.window(name = "main") is none
			try UI.closeWindow(second)
			try await UI.stop()
			stageKept = int[]
		}

		// The title a page declares is shown in place of the window's own, the page that
		// declared last first; the window's own comes back when no page declares one.
		@test()
		def TestPageTitles() !none {
			stageKept = [0]
			let stage = new Stage()
			try UI.config(UIConfig{renderer: stage, host: stage})
			try await UI.start()
			let win = try UI.openWindow(StagePalette(), new r.WindowConfig("own", 100, 60))
			let (outer, inner) = (StagePalette(), StagePalette())
			let shown = def () string {
				return stage.titles.len() == 0 ?? ("", stage.titles[stage.titles.len() - 1])
			}
			try UI.setPageTitle(win, outer, "Docs")
			assert shown() == "Docs"
			try UI.setPageTitle(win, inner, "Units")
			assert shown() == "Units"
			// The window's own title is kept for later while a page declares one.
			try UI.setWindowTitle(win, "renamed")
			assert shown() == "Units" && !(UI.window(title = "renamed") is none)
			try UI.setPageTitle(win, inner, "Units, examples")
			assert shown() == "Units, examples"
			try UI.setPageTitle(win, inner, none)
			assert shown() == "Docs"
			try UI.setPageTitle(win, outer, none)
			assert shown() == "renamed"
			try UI.closeWindow(win)
			try await UI.stop()
			stageKept = int[]
		}

		// Icons, a theme and style sheets added by another task while `run` serves the
		// windows: what the windows' loop reads under the state lock, so a set decoded
		// on a task of its own is there for the next frame.
		@test()
		def TestAddedFromAnotherTaskWhileRunning() !none {
			// The suite's close handler keeps a window only while this is empty.
			stageKept = [0]
			let stage = new Stage()
			try UI.config(UIConfig{renderer: stage, host: stage})
			try await UI.start()
			let added = [0]
			let seen = [0]
			stage.resting = def () {
				// A rest gives the other task the processor.
				time.sleep(2ms)
				let wins = UI.windows()
				if added[0] == 1 && seen[0] == 0 && wins.len() > 0 {
					seen[0] = 1
					wins[0].close()
				}
			}
			let theme = new Theme(Appearance{})
			let sheet = new StyleSheet([])
			let late = async addLate(theme, sheet, added)
			try await UI.run(StagePage(), new r.WindowConfig("stage", 100, 60))
			await late
			try await UI.stop()
			// The loop saw them while it ran, before the stage would have closed it.
			assert seen[0] == 1 && stage.polls < 50
			assert !(UI.icon("late/dot") is none) && UI.theme() == theme
			UI.removeStyles(sheet)
			stageKept = int[]
		}

		// What opens, closes, names, raises or marks a window, or shows the tray, called
		// from another task while `run` serves the windows: each call is made on the
		// loop's task, the window system's, and returns once it ran there, with what it
		// returned or how it failed.
		@test()
		def TestWindowCallsFromAnotherTask() !none {
			// The suite's close handler keeps a window only while this is empty.
			stageKept = [0]
			let stage = new Stage()
			try UI.config(UIConfig{renderer: stage, host: stage})
			try await UI.start()
			let done string[]
			stage.resting = def () {
				// A rest gives the other task the processor.
				time.sleep(2ms)
				let wins = UI.windows()
				wins[0].close() when done.len() == 3 && wins.len() > 0
			}
			let late = async callLate(done)
			try await UI.run(StagePage(), new r.WindowConfig("stage", 100, 60))
			try await late
			try await UI.stop()
			assert done.join("; ") == "opened 2 of 2; refused true; closed, 1 left"
			assert stage.polls < 50
			assert stage.titles.includes("late") && stage.moves.includes("1 raised") && stage.closed.join(",") == "2,1"
			assert stage.told.includes("window 2 icon") && stage.told.includes("tray late 0") && stage.told.includes("tray off")
			assert stage.callers.len() == 9
			for let task in stage.callers {
				assert task == stage.looper
			}
			stageKept = int[]
		}

		// A task cancelled while its call waits for the windows' loop takes the call back:
		// the loop never makes it, and the caller fails.
		@test()
		def TestWindowCallCancelled() !none {
			stageKept = [0]
			let stage = new Stage()
			try UI.config(UIConfig{renderer: stage, host: stage})
			try await UI.start()
			let asked = [0]
			let outcome string[]
			let late = async titleLate(asked, outcome)
			let rests = [0]
			// The loop's first rest lasts until the other task asked, was cancelled and
			// went on: its call is handed to the loop while the loop rests.
			stage.resting = def () {
				return unless rests[0] == 0
				rests[0] = 1
				for asked[0] == 0 {
					time.sleep(1ms)
				}
				time.sleep(2ms)
				late.cancel()
				for outcome.len() == 0 {
					time.sleep(1ms)
				}
				UI.windows()[0].close()
			}
			try await UI.run(StagePage(), new r.WindowConfig("stage", 100, 60))
			await late
			try await UI.stop()
			assert outcome.len() == 1 && outcome[0].contains("cancelled")
			assert !stage.titles.includes("late")
			stageKept = int[]
		}

		// `Window.close()` asks as the user's close button does: a handler of
		// `UI.closeRequested` may keep the window open, and without one it closes.
		@test()
		def TestWindowCloseAsks() !none {
			// The suite's handler keeps window 1 the first time it is asked to close.
			stageKept = int[]
			let stage = new Stage()
			try UI.config(UIConfig{renderer: stage, host: stage})
			try await UI.start()
			let rests = [0]
			let open = int[]
			stage.resting = def () {
				rests[0]++
				let wins = UI.windows()
				if rests[0] == 1 && wins.len() > 0 {
					wins[0].close()
				}
				// Asked once and kept: still open, and hidden by the handler.
				if rests[0] == 3 {
					open.push(wins.len())
					wins[0].close() when wins.len() > 0
				}
			}
			try await UI.run(StagePage(), new r.WindowConfig("stage", 100, 60))
			try await UI.stop()
			assert stageKept.len() == 1 && open.join(",") == "1"
			// The second request was not cancelled: the window closed before the stage
			// closed it.
			assert stage.polls < 50
			stageKept = int[]
		}
	}
}
