partial module std.ui {
	use (
		std.reflection
		std.ui.frames
	)

	// How many style sheets were made: each gets the next number.
	internal let sheetsMade = [0]

	// One rule of a style sheet: which components it is for, and what it gives their
	// style. Written with `rule`.
	type StyleRule {
		// The components the rule is for.
		selector Selector

		// What the rule sets on the style of a component it is for, and what it gives
		// that component's states: the compiler writes them from the rule's
		// `style = {...}`, as it does for a component call.
		set    ?def(look style, owner component)                                   = none
		states ?def(look style, owner component, held int, state def(string) bool) = none
		any    ?def(held int, state def(string) bool) bool                         = none

		// For the view runtime. How precise the selector is, and what of it a component
		// either is or is not for as long as it lives: its kind, its `ref`, its role
		// (-1: any). `fixed`: the selector says nothing else, so a component those fit
		// is one the rule is for.
		weight int
		kind   string = ""
		ref    string = ""
		role   int    = -1
		fixed  bool   = true

		def new(selector Selector) {
			self.selector = selector
			weight = selector.specificity()
			for let (_, part) in selector.predicates() {
				match part.kind {
					case SelectorKind.Kind:
						kind = part.text
					case SelectorKind.Ref:
						ref = part.text
					case SelectorKind.Role:
						role = part.num
					case SelectorKind.Priority:
					default:
						fixed = false
				}
			}
		}

		// Whether the rule can be for `c` at all: its kind, `ref` and role are the
		// selector's.
		def fits(c component) bool {
			return false when role >= 0 && int(c.role) != role
			return false when ref != "" && c.refName != ref
			return kind == "" || reflection.typeName(c) == kind
		}
	}

	// A rule of a style sheet: the components `selector` matches get what `style` lists,
	// properties of the style of the kind the selector names and, under `on`, looks for
	// its states. A selector that names no kind gives each property to every style that
	// has it, as `std.ui.styles` and the rule's own module declare it.
	//
	//     rule(kind<Button>(), style = {radius: new Corners<Extent>(0(px))})
	//     rule(kind<Button>().variant("primary"), style = {background: accent, on: {hover: {background: bright}}})
	//     rule(kind<Label>().inside(kind<Toolbar>()), style = {padding: new Edges<Extent>(4(px))})
	//     rule(role(Role.Button).inside(kind<Toolbar>()), style = {minHeight: 28(px)})
	//
	// The values are read when the rule is applied: at the first layout of a component
	// it is for, and again whenever that component's style, its states or the sheet
	// change (`StyleSheet.changed`).
	def rule(selector Selector, _styleSet ?def(look style, owner component) = none, _styleStates ?def(look style, owner component, held int, state def(string) bool) = none, _styleAny ?def(held int, state def(string) bool) bool = none) StyleRule {
		let made = new StyleRule(selector)
		made.set = _styleSet
		made.states = _styleStates
		made.any = _styleAny
		return made
	}

	// Rules that restyle components from outside them: a theme's look for the std
	// components, an application's house style. `UI.addStyles(sheet)` applies one to
	// every window; `Styled(sheet) { ... }` to the components it holds.
	//
	//     let sheet = new StyleSheet([
	//         rule(kind<Button>(), style = {radius: new Corners<Extent>(0(px))}),
	//         rule(kind<Button>().hover(), style = {font: {weight: FontWeight.Bold}}),
	//     ])
	//     UI.addStyles(sheet)
	//
	// A component's look is, later winning: its own style; the rules for it, the
	// sheets from the outermost in, the less precise selector first
	// (`Selector.specificity`), then in the order written; the states of its own
	// style's `on`; those of the rules' `on`; what the call that made it sets
	// (`style = {...}`), then that call's `on`.
	type StyleSheet {
		rules   StyleRule[]
		// For the view runtime: a number of its own, and one that changes whenever the
		// rules do.
		id      int
		version int         = 0

		def new(rules StyleRule[] = []) {
			self.rules = rules
			sheetsMade[0] += 1
			id = sheetsMade[0]
		}

		// Adds a rule.
		def add(made StyleRule) {
			rules.push(made)
			changed()
		}

		// Call it after changing a value a rule reads, or the rules themselves, by
		// hand: the components the sheet is for take their looks again on the next
		// frame.
		def changed() {
			version++
			frames.askFrame(true)
		}
	}
}
