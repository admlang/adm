partial module std.ui {
	// What `UI.stateChange` reports: a component's `@state` field was assigned a different
	// value.
	struct StateChange {
		// The component whose state changed.
		source   component
		// The name of the state field: "selected".
		state    string
		// The new value; the listener knows the type.
		value    any
		// The value it replaced.
		previous any
	}
}
