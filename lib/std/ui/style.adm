partial module std.ui {
	use (
		std.gfx.color::Color
		std.math.geom::(Point, Rect, Size)
		std.ui.styles::*
	)

	// StyleNode is a read-only layout snapshot used for cascading and selectors.
	// It is available as `root`, `parent`, `prev`, and `next` inside `style { ... }` blocks.
	type StyleNode {
		rect Rect

		left float {
			def get() float {
				return rect.left
			}
		}

		right float {
			def get() float {
				return rect.right
			}
		}

		top float {
			def get() float {
				return rect.top
			}
		}

		bottom float {
			def get() float {
				return rect.bottom
			}
		}

		width float {
			def get() float {
				return rect.width
			}
		}

		height float {
			def get() float {
				return rect.height
			}
		}

		center Point {
			def get() Point {
				return rect.center
			}
		}
	}

	// A font choice: family, size, weight and italic.
	type FontStyle {
		family string
		size   float
		weight int
		italic bool
	}

	// The spacing and background of a box: padding, margin and background colour.
	type BoxStyle {
		padding Insets
		margin  Insets

		backgroundColor Color
	}

	// StyleClass is a "CSS-like" style object used inside `style { ... }` blocks.
	// Renderers interpret these values; the compiler only typechecks accesses.
	type StyleClass {
		box     BoxStyle
		font    FontStyle
		opacity float

		rect  Rect
		align Point
		size  Size
		color Color

		width float {
			def get() float {
				return size.width
			}

			def set(val float) {
				size.width = val
			}
		}

		height float {
			def get() float {
				return size.height
			}

			def set(val float) {
				size.height = val
			}
		}

		left float {
			def get() float {
				return rect.left
			}

			def set(val float) {
				rect.left = val
			}
		}

		right float {
			def get() float {
				return rect.right
			}

			def set(val float) {
				rect.right = val
			}
		}

		top float {
			def get() float {
				return rect.top
			}

			def set(val float) {
				rect.top = val
			}
		}

		bottom float {
			def get() float {
				return rect.bottom
			}

			def set(val float) {
				rect.bottom = val
			}
		}
	}

	// Style overrides for a component's interaction states.
	type StyleStates {
		hover    StyleClass
		pressed  StyleClass
		disabled StyleClass
	}

	// Style overrides for named child parts, keyed by part name.
	type StyleChildren = map<string, StyleClass>
}
