partial module std.ui.styles {

    /*
        Absolute:
            px — CSS pixel, basically the default screen unit.
            pt — points, traditionally print typography; 1pt = 1/72 inch.
            pc — picas; 1pc = 12pt.
            in — inches.
            cm — centimeters.
            mm — millimeters.
            Q — quarter-millimeters.
        Font-relative units:
            em — relative to the current element’s font size.
            rem — relative to the root element’s font size.
            ex — roughly the x-height of the current font.
            rex — x-height of the root font.
            ch — width of the 0 glyph in the current font.
            rch — same, but root font.
            cap — cap height of the current font.
            rcap — cap height of the root font.
            ic — width of the CJK “水”-like ideographic advance measure.
            ric — same, root-relative.
            lh — current line-height.
            rlh — root line-height.
        Viewport units:
            vw — 1% of viewport width.
            vh — 1% of viewport height.
            vmin — 1% of the smaller of viewport width/height.
            vmax — 1% of the larger.
        Then CSS added viewport variants because mobile browsers have dynamic browser chrome:
            svw, svh — small viewport size.
            lvw, lvh — large viewport size.
            dvw, dvh — dynamic viewport size.
            and corresponding svmin, svmax, lvmin, lvmax, dvmin, dvmax.
        Container-relative units:
            cqw — 1% of query container width.
            cqh — 1% of query container height.
            cqi — 1% of container inline size.
            cqb — 1% of container block size.
            cqmin — 1% of the smaller container dimension.
            cqmax — 1% of the larger.
        Container:
            % — percentage relative to some context-dependent containing dimension.
    */

    enum LengthType {
        Pixel = "px"
        Percent = "%"
        ViewportWidth = "vw"
        ViewportHeight = "vh"
    }

    type Length = float

    def px(val float) Length {
        let floatVal float
        floatVal.tags().add("ui.length.unit=px")
        return floatVal
    }

    def pct(val float) Length {
        let floatVal float = val
        floatVal.tags().add("ui.length.unit=pct")
        return floatVal
    }

    def vh(val float) Length {
        let floatVal float = val
        floatVal.tags().add("ui.length.unit=vh")
        return floatVal
    }

    def vw(val float) Length {
        let floatVal float = val
        floatVal.tags().add("ui.length.unit=vw")
        return floatVal
    }

    def typeOf(val Length) LengthType {
        let tags = val.tags()
        switch {
            case tags.has("ui.length.unit=px"): return LengthType.Pixel
            case tags.has("ui.length.unit=pct"): return LengthType.Percent
            case tags.has("ui.length.unit=vh"): return LengthType.ViewportHeight
            case tags.has("ui.length.unit=vw"): return LengthType.ViewportWidth
            default: return LengthType.Pixel
        }
    }

    check "Length" {
        use std.testing

        @test
        def testLength() {
            let tmp = px(100)
            println(tmp.tags())
        }
    }

}