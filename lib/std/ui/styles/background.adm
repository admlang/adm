partial module std.ui.styles {
	use std.gfx.canvas

	// What an area, a border side, text or a shadow is filled with: a colour, a gradient,
	// a pattern, noise or a shader.
	type Paint = canvas.Paint

	// Which box of a component something covers or is measured against.
	enum BoxArea {
		Border,
		Padding,
		Content,
	}

	// What fills a component behind its content.
	type BackgroundFill {
		// Painted bottom to top.
		layers Paint[] = []
		// The box the layers cover.
		area   BoxArea = BoxArea.Border

		// A single paint over the border box: `background = theme.palette.surface`.
		@implicit
		def new(paint canvas.Paint) {
			layers = [paint]
		}

		// Several paints, the first at the bottom, over `area`.
		def new(layers Paint[], area BoxArea = BoxArea.Border) {
			self.layers = layers
			self.area = area
		}
	}

	// A filled background.
	style Background {
		Shape

		// What fills the component behind its content.
		@styleProperty
		let background BackgroundFill = new BackgroundFill([])
	}
}
