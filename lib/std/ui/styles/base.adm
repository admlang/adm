partial module std.ui.styles {
	use (
		std.math.geom::Edges
		std.units::(Extent, FontRelative, Length, Percent, Pixels, ViewportHeight, ViewportWidth)
	)

	// Sizes to the content.
	struct Auto {}

	// A share of the parent's leftover space. Siblings split it by weight: two `fill`s get half
	// each, `fill` beside `fill * 2` gets a third.
	type Fill {
		internal share float

		// The fill's weight, 1 for `fill`. Read-only: `fill * 2` makes a new fill.
		weight float {
			def get() float {
				return share
			}
		}

		def new(weight float = 1.0) {
			share = weight
		}

		// The same fill with its weight multiplied: `fill * 2`.
		infix def * (times float) Fill {
			return new Fill(share * times)
		}
	}

	// Sizes to the content.
	const auto Auto = Auto{}

	// A share of the leftover space, weight 1.
	const fill Fill = new Fill()

	// A width or height: a fixed extent, the content's size, or a share of the leftover space.
	type Sizing = Extent | Auto | Fill

	// The lines of a component's box an anchor can name.
	enum AnchorEdge {
		Left,
		Top,
		Right,
		Bottom,
		CenterX,
		CenterY,
	}

	// What an anchor pins an edge to. A distance (`10(px)`) is measured from the matching edge
	// of the box `position` selects. A named line (`$trigger.geom.bottom + 2(px)`) is an edge of
	// another component, followed when that component moves.
	type AnchorLine {
		// The component whose line this is; none for a distance. The line does not keep
		// the component alive: a component's own geometry names it in its lines.
		weak target ?component  = none
		// Which of the target's lines; none for a distance.
		edge        ?AnchorEdge = none
		// The distance from the line, or from the reference box's edge; negative after
		// `line - 8(px)`.
		offset      Extent      = 0(px)

		// A distance from the matching edge of the reference box.
		@implicit
		def new(distance Extent) {
			offset = distance
		}

		// The `edge` line of `target`.
		def new(target ?component, edge AnchorEdge) {
			self.target = target
			self.edge = edge
		}

		// The same line moved `distance` right or down.
		infix def + (distance Extent) AnchorLine {
			let line = new AnchorLine(distance)
			line.target = target
			line.edge = edge
			return line
		}

		// The same line moved `distance` left or up.
		infix def - (distance Extent) AnchorLine {
			let line = new AnchorLine(negated(distance))
			line.target = target
			line.edge = edge
			return line
		}
	}

	// The same extent with its sign turned.
	internal def negated(distance Extent) Extent {
		match distance {
			case Pixels:
				return -distance
			case Percent:
				return -distance
			case ViewportHeight:
				return -distance
			case ViewportWidth:
				return -distance
			case FontRelative:
				return -distance
			case Length:
				return -distance
		}
	}

	// Where the edges of a Relative, Absolute or Sticky component are pinned; ignored under
	// `Position.Normal`. Each is a distance from the box it is placed against (the parent for
	// Relative, the window for Absolute) or a named line of another component. Left and right
	// both set stretch it across; one sets the side it sticks to.
	struct Anchors {
		left    ?AnchorLine = none
		top     ?AnchorLine = none
		right   ?AnchorLine = none
		bottom  ?AnchorLine = none
		// Offset of its centre from the box's centre.
		centerX ?AnchorLine = none
		centerY ?AnchorLine = none
	}

	// The base of every component's style: its size, spacing, placement, drawing layer,
	// visibility and how it places its own content. Every style embeds it.
	style Box {
		// The width.
		@styleProperty
		let width Sizing = auto

		// The height.
		@styleProperty
		let height Sizing = auto

		// The smallest width layout may give it; none means no limit.
		@styleProperty
		let minWidth ?Extent = none

		// The smallest height layout may give it; none means no limit.
		@styleProperty
		let minHeight ?Extent = none

		// The largest width layout may give it; none means no limit.
		@styleProperty
		let maxWidth ?Extent = none

		// The largest height layout may give it; none means no limit.
		@styleProperty
		let maxHeight ?Extent = none

		// Space kept free around the component.
		@styleProperty
		let margin Edges<Extent> = new Edges<Extent>(0(px))

		// Space between the component's edge and its content.
		@styleProperty
		let padding Edges<Extent> = new Edges<Extent>(0(px))

		// Whether the parent's layout places it, and if not, what it is placed against.
		@styleProperty
		let position Position = Position.Normal

		// For Relative, Absolute and Sticky: where its edges are pinned.
		@styleProperty
		let anchors Anchors = Anchors{}

		// The drawing layer. A layer above Content escapes its ancestors' clipping.
		@styleProperty
		let layer Layer = Layer.Content

		// Not visible: not drawn, no space, no input, but still in the tree and running.
		// To keep the space, a component whose style has `Compositing` sets `opacity` to 0.
		@styleProperty
		let visible bool = true

		// Where the content (children or text) sits inside the component.
		@styleProperty
		let align Align = Align{}

		// The reading direction. Unset takes the parent's; the window takes the language's.
		// Under RightToLeft a row's children run right to left, Start is the right side, and
		// left and right swap in margin, padding, anchors, borders and radii. Set it to pin a
		// subtree: a code editor stays LeftToRight.
		@styleProperty(inherit = true)
		let direction ?Direction = none
	}
}
