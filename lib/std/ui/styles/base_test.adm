partial module std.ui.styles {
	use (
		std.gfx.color::(Color, Transparent)
		std.testing
		std.units::Pixels
	)

	check "Box" {
		// `fill * 2` doubles the weight; plain `fill` has weight 1.
		@test()
		def TestFillWeight() {
			assert fill.weight == 1.0
			let twice = fill * 2
			assert twice.weight == 2.0
			assert fill.weight == 1.0
		}

		// The base defaults: sized to content, no spacing, laid out by the parent, visible.
		@test()
		def TestBoxDefaults() {
			let size Sizing = 12(px)
			match size {
				case Pixels:
					assert float(size) == 12.0
				default:
					assert false
			}
			let anchors = Anchors{bottom: 10(px), right: 5(px)}
			assert anchors.left is none
			assert !(anchors.bottom is none)
		}

		// A distance becomes an anchor with no target; a named line keeps its component's edge.
		@test()
		def TestAnchorLines() {
			let anchors = Anchors{bottom: 10(px)}
			let bottom = anchors.bottom
			assert !(bottom is none)
			if !(bottom is none) {
				assert bottom.target is none
				assert bottom.edge is none
			}
			let line = new AnchorLine(none, AnchorEdge.Bottom)
			assert !(line.edge is none)
			assert line.target is none
			// A line moved by a distance is the same line with that offset.
			let below = line + 4(px)
			let above = line - 4(px)
			assert !(below.edge is none) && "{below.offset} {above.offset}" == "4 px -4 px"
		}

		// A size becomes a track, a paint a background, where one is expected.
		@test()
		def TestImplicitStyleValues() {
			let tracks = Track[200(px), fill, auto]
			assert tracks.len() == 3
			assert tracks[1].min is none
			let surface BackgroundFill = new Color(Transparent)
			assert surface.layers.len() == 1
			assert surface.area == BoxArea.Border
			let font = Font{family: "Inter"}
			assert font.weight == FontWeight.Normal && font.ligatures
		}
	}
}
