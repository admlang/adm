partial module std.ui.styles {
	use (
		std.testing
		std.units::Pixels
	)

	check "Box" {
		// `fill * 2` doubles the weight; plain `fill` has weight 1.
		@test()
		def TestFillWeight() {
			assert fill.weight == 1.0
			let twice = fill * 2
			assert twice.weight == 2.0
			assert fill.weight == 1.0
		}

		// The base defaults: sized to content, no spacing, laid out by the parent, visible.
		@test()
		def TestBoxDefaults() {
			let size Size = 12(px)
			match size {
				case Pixels:
					assert float(size) == 12.0
				default:
					assert false
			}
			let anchors = Anchors{bottom: 10(px), right: 5(px)}
			assert anchors.left is none
			assert !(anchors.bottom is none)
		}
	}
}
