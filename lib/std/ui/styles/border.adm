partial module std.ui.styles {
	use (
		std.gfx.canvas
		std.gfx.color::(Color, Transparent)
		std.gfx::Raster
		std.math.geom::Edges
		std.units::Pixels
	)

	// One side of a border: its width, paint and line style.
	type Border = canvas.Border

	// How a border side is drawn: Solid, Dashed, Dotted, Double, Groove, Ridge, Inset,
	// Outset, None.
	type LineStyle = canvas.LineStyle

	// A border drawn from one image cut in nine: the four corners are kept, the four edges
	// and the centre stretched or repeated.
	struct NineSlice {
		image  Raster
		// How far in from each side of the image the cuts are.
		slice  Edges<Pixels>
		// Whether edges and centre repeat; false stretches them.
		repeat bool          = false
		// Whether the centre piece is drawn, as a background.
		center bool          = false
	}

	// Borders on the four sides. Their widths take layout space.
	style Borders {
		Shape

		// The four sides. `border = Border{width: 1(px), paint: line}` sets all of them,
		// `border = {bottom: Border{width: 2(px), paint: accent}}` one.
		@styleProperty
		let border Edges<Border> = new Edges<Border>(Border{width: 0(px), paint: new Color(Transparent)})

		// Replaces the drawn sides with an image; the widths still take their space.
		@styleProperty
		let borderImage ?NineSlice = none
	}
}
