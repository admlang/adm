partial module std.ui.styles {
	/*
	CSS has a huge amount:
	outline
	outline offset
	*/

	enum LineStyle {
		Solid,
		Dashed,
		Dotted,
		Double,
		Groove,
		Ridge,
		Inset,
		Outset,
		None
	}

	style Borders {
		use (
			std.gfx.color::(ColorModel, Transparent)
			std.gfx::(Raster)
			std.math.geom::(Corners, Edges)
			std.units::(Extent, Pixels)
		)

		@styleProperty
		let borderWidth Edges<float> = new Edges<float>(0)

		@styleProperty
		let borderColor Edges<ColorModel> = new Edges<ColorModel>(Transparent)

		@styleProperty
		let borderStyle Edges<LineStyle> = new Edges<LineStyle>(LineStyle.Solid)

		@styleProperty
		let borderRadius Corners<Extent> = new Corners<Extent>(0(px))

		@styleProperty
		let borderImage Edges<?Raster> = new Edges<?Raster>(none)
	}
}
