partial module std.ui.styles {
	// Cutting a component's content to its shape.
	style Clipping {
		Shape

		// Cuts children and content off at the padding box, following the corner radius.
		@styleProperty
		let clip bool = false

		// The alpha of this paint, stretched over the border box, masks the component and
		// its children.
		@styleProperty
		let mask ?Paint = none
	}
}
