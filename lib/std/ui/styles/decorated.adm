partial module std.ui.styles {
	// Everything a box is painted with: background, border, outline, shadows. They share
	// one `Shape`, so the four follow the same corners.
	style Decorated {
		Background
		Borders
		Outline
		Shadows
	}

	// What a control is made of: what it is painted with, its text, how it meets the
	// pointer and how its changes are timed.
	style Control {
		Decorated
		Typography
		Interaction
		Motion
	}
}
