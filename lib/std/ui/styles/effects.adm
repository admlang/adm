partial module std.ui.styles {
	use (
		std.gfx.canvas
		std.gfx.color::BlendMode
	)

	// A shadow or glow, as the canvas draws them: `DropShadow{offset, blur, spread, color,
	// knockout}`, `InnerShadow{offset, blur, choke, color}`, `OuterGlow{blur, spread, color,
	// blend}`, `InnerGlow{blur, color, blend}`.
	type Shadow = canvas.DropShadow | canvas.InnerShadow | canvas.OuterGlow | canvas.InnerGlow

	// A filter over pixels: `Blur{radius}`, `ColorAdjust{brightness, contrast, saturation,
	// hue}`, `ColorMatrix{values}`.
	type Filter = canvas.Blur | canvas.ColorAdjust | canvas.ColorMatrix

	// Shadows and glows.
	style Shadows {
		Shape

		// Drawn in order, the first at the bottom. Outer ones follow the border box and its
		// radius, take no layout space and are drawn under the background; inner ones are
		// drawn last, over the content, so what is inside looks sunk.
		@styleProperty
		let shadows Shadow[] = []
	}

	// Filters over the component.
	style Filters {
		// Applied in order to the component and its children, as one image.
		@styleProperty
		let filters Filter[] = []
	}

	// Filters over what is behind the component: frosted glass.
	style Backdrop {
		// Applied in order to what is behind the component, inside its shape. Skipped (the
		// background drawn opaque) when the user asked for reduced transparency.
		@styleProperty
		let backdrop Filter[] = []
	}

	// How a component mixes with what is behind it. Its own style: only a component that fades
	// (a panel, a dialog, an overlay) embeds it.
	style Compositing {
		// 0 invisible to 1 solid. At 0 the component still takes its space and still receives
		// input.
		@styleProperty
		let opacity float = 1.0

		// How it mixes with what is behind it.
		@styleProperty
		let blend BlendMode = BlendMode.Normal
	}

	// Everything drawn around or over a component as a whole: compositing, shadows, filters,
	// backdrop.
	style Effects {
		Compositing
		Shadows
		Filters
		Backdrop
	}
}
