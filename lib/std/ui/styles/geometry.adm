partial module std.ui.styles {

	type Edges<T> {
		top, right, bottom, left T

		def new(all T) {
			left = all
			top = all
			right = all
			bottom = all
		}

		def new(topBottom, leftRight T) {
			left = leftRight
			top = topBottom
			right = leftRight
			bottom = topBottom
		}

		def new(top, right, bottom, left T) {
			self.left = left
			self.top = top
			self.right = right
			self.bottom = bottom
		}
	}

    check "Edges" {
		use std.testing

		@test()
		def testInsetsContructor() {

			let inset = new Edges<Length>(px(10.0))
			assert px(10.0) := inset.left && inset.top && inset.right && inset.bottom

			inset = new Edges<Length>(px(10.0), pct(20.0))
			assert px(10.0) := inset.top && inset.bottom
			assert pct(20.0) := inset.left && inset.right

			inset = new Edges<Length>(px(10.0), px(20.0), px(30.0), px(40.0))
			assert inset.top == px(10)
			assert inset.right == px(20)
			assert inset.bottom == px(30)
			assert inset.left == px(40)
		}
	}

	type Corners<T> {
		topLeft, topRight, bottomRight, bottomLeft T

		def new(all T) {
			topLeft = all
			topRight = all
			bottomRight = all
			bottomLeft = all
		}

		def new(top, bottom T) {
			topLeft = top
			topRight = top
			bottomRight = bottom
			bottomLeft = bottom
		}

		def new(topLeft, topRight, bottomRight, bottomLeft T) {
			self.topLeft = topLeft
			self.topRight = topRight
			self.bottomRight = bottomRight
			self.bottomLeft = bottomLeft
		}
	}
	/*
	Geometry / sizing
	
	width / height
	min/max width/height
	aspect ratio
	intrinsic sizing (min-content, max-content, fit-content)
	box sizing
	possibly preferred size
	*/
}
