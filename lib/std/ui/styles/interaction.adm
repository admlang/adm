partial module std.ui.styles {
	use (
		std.gfx.canvas
		std.gfx.color::(Color, Transparent)
		std.gfx::Raster
		std.math.geom::(Edges, Point)
		std.units::Pixels
	)

	// The pointer shapes every platform has.
	enum Cursor {
		Default,
		// A hand: links.
		Pointer,
		// An I-beam.
		Text,
		Crosshair,
		Move,
		Grab,
		Grabbing,
		NotAllowed,
		Wait,
		// Busy, still usable.
		Progress,
		Help,
		ResizeHorizontal,
		ResizeVertical,
		ResizeDiagonalDown,
		ResizeDiagonalUp,
		// Between two columns: splitters.
		ResizeColumn,
		// Between two rows.
		ResizeRow,
		ZoomIn,
		ZoomOut,
		Copy,
		Link,
		Hidden,
	}

	// A pointer drawn from an image.
	struct ImageCursor {
		image   Raster
		// The pixel of the image that points.
		hotspot Point<Pixels>
	}

	// A pointer: a platform shape or an image.
	type CursorShape = Cursor | ImageCursor

	// What part of a component the pointer can hit.
	enum HitTest {
		// The border box, following the corner radius.
		Box,
		// Only its children: the component itself lets the pointer through.
		Children,
		// Nothing: it and its children let the pointer through.
		None,
	}

	// How a component is pointed at.
	style Interaction {
		// The pointer over the component. Unset takes the parent's.
		@styleProperty(inherit = true)
		let cursor ?CursorShape = none

		// What part of the component the pointer can hit.
		@styleProperty
		let hitTest HitTest = HitTest.Box

		// Grows the area the pointer hits beyond the border box, without changing the layout
		// or the drawing: a 1 px splitter with a 6 px grab zone.
		@styleProperty
		let hitSlop Edges<Pixels> = new Edges<Pixels>(0(px))

		// The smallest hit area on each axis, grown around the centre when the box is
		// smaller, so small icon buttons stay tappable with a finger.
		@styleProperty
		let minTarget Pixels = 0(px)
	}

	// When a scrollbar is shown and whether it takes space.
	enum ScrollbarMode {
		// Shown while there is something to scroll; takes space.
		Auto,
		// Always shown; takes space.
		Always,
		// Drawn over the content while scrolling, then fades; takes no space.
		Overlay,
		// Never shown; the content still scrolls.
		Hidden,
	}

	// The look of a scrollbar.
	struct Scrollbar {
		mode       ScrollbarMode = ScrollbarMode.Auto
		thickness  Pixels        = 12(px)
		thumb      canvas.Paint  = new Color(Transparent)
		thumbHover canvas.Paint  = new Color(Transparent)
		track      canvas.Paint  = new Color(Transparent)
		radius     Pixels        = 0(px)
		// The shortest the thumb gets, however long the content.
		minThumb   Pixels        = 24(px)
		// Keeps the bar's space when there is nothing to scroll, so content does not shift
		// when the bar appears.
		stable     bool          = false
	}

	// The scrollbars of a component that scrolls.
	style Scrollbars {
		@styleProperty
		let scrollbar Scrollbar = Scrollbar{}
	}

	// Content with its own size (an image, an icon, a video) fitted into the box.
	style ImageContent {
		Foreground

		// How the content is fitted into the content box. Where it sits when it does not
		// fill the box is `align`.
		@styleProperty
		let fit canvas.Fit = canvas.Fit.Contain

		// Draws the content's shape in this paint, ignoring its colours: monochrome icons.
		// none: the content's own colours, except for a vector icon declared monochrome,
		// which takes `foreground`.
		@styleProperty
		let tint ?Paint = none

		// How pixels are read when scaled. Nearest keeps pixel art sharp.
		@styleProperty
		let sampling canvas.Sampling = canvas.Sampling.Bilinear
	}
}
