partial module std.ui.styles {
	use (
		std.math.geom::Axes
		std.units::(Extent, Pixels)
	)

	// Where content sits along one axis of the space it is given.
	enum Alignment {
		Start,
		Center,
		End,
		// Uses the whole space: a box stretches, text is justified.
		Fill,
		// Vertical axis of a Row only: children line up on their first text baseline; a child
		// without text uses its bottom edge. Elsewhere it acts as Start.
		Baseline,
	}

	// Alignment on both axes.
	struct Align {
		horizontal Alignment = Alignment.Start
		vertical   Alignment = Alignment.Start
	}

	// The reading direction of a component's content.
	enum Direction {
		LeftToRight,
		RightToLeft,
	}

	// How a container arranges its children.
	enum Arrange {
		// Top to bottom.
		Column,
		// Along the reading direction: left to right, or right to left.
		Row,
		// In the columns and rows of `Tracks`.
		Grid,
		// On top of each other, each given the whole content box.
		Layered,
	}

	// How the space children leave free on the main axis is shared.
	enum Distribute {
		// Children sit together; `align` says where the group goes.
		Packed,
		// Equal space between children, none at the ends:  |A----B----C|
		Between,
		// Equal space around each child, half at the ends: |-A--B--C-|
		Around,
		// Equal space between children and at the ends:    |--A--B--C--|
		Evenly,
	}

	// How a container arranges its children.
	style Layout {
		// The arrangement.
		@styleProperty
		let arrange Arrange = Arrange.Column

		// The space between neighbouring children: `horizontal` between columns, `vertical`
		// between rows.
		@styleProperty
		let gap Axes<Extent> = new Axes<Extent>(0(px))

		// How free main-axis space is shared between children.
		@styleProperty
		let distribute Distribute = Distribute.Packed

		// Row and Column only: children that do not fit move to a new line.
		@styleProperty
		let wrap bool = false

		// Lays the children out last to first.
		@styleProperty
		let reverse bool = false

		// Set on a child: where it sits in the slot the container gives it, when that differs
		// from the container's `align`.
		@childProperty
		let alignSelf ?Align = none
	}
}
