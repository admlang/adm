partial module std.ui.styles {
	// A cubic Bézier timing curve through (0, 0), (x1, y1), (x2, y2), (1, 1).
	struct Curve {
		x1 float
		y1 float
		x2 float
		y2 float
	}

	// A spring: it overshoots and settles, and has no fixed duration.
	struct Spring {
		stiffness float = 170.0
		damping   float = 26.0
		mass      float = 1.0
	}

	// Jumps through `count` equal steps.
	struct Steps {
		count int
	}

	// Named timing curves.
	enum Ease {
		Linear,
		// Starts fast, ends slow: things arriving, and the default.
		Out,
		// Starts slow, ends fast: things leaving.
		In,
		// Slow at both ends: things moving across the screen.
		InOut,
	}

	// How time maps to progress.
	type Easing = Ease | Curve | Spring | Steps

	// How a property travels from its old value to its new one.
	struct Transition {
		duration duration = 0ms
		easing   Easing   = Ease.Out
		delay    duration = 0ms
	}

	// How the drawn look travels from the style's previous result to its new one. Three
	// more names are reserved in a style that embeds it: `transitions` (per property),
	// `enter` (the look it animates from when it appears) and `exit` (the look it animates
	// to before it is removed).
	style Motion {
		// How every animatable property of this component changes. 0ms: at once.
		@styleProperty
		let transition Transition = Transition{}
	}
}
