partial module std.ui.styles {
	use (
		std.gfx.canvas
		std.gfx.color::(Color, Transparent)
		std.units::Pixels
	)

	// A ring around a component.
	struct Ring {
		width  Pixels       = 0(px)
		paint  canvas.Paint = new Color(Transparent)
		// The distance from the border box; negative draws inside it.
		offset Pixels       = 0(px)
		line   LineStyle    = LineStyle.Solid
	}

	// A ring outside the border box: the keyboard focus ring.
	style Outline {
		Shape

		// The ring. It follows the corner radius, takes no layout space and is not clipped
		// by ancestors.
		@styleProperty
		let outline Ring = Ring{}
	}
}
