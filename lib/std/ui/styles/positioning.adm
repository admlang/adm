partial module std.ui.styles {

    /*
    Positioning / anchoring

    top/right/bottom/left
    absolute/relative/fixed/sticky positioning
    inset
    anchor positioning
    z-order / stacking
*/

	type Insets {
		left   float
		top    float
		right  float
		bottom float

		def new(size float) {
			left = size
			top = size
			right = size
			bottom = size
		}

		def new(topBottom, leftRight float) {
			left = leftRight
			top = topBottom
			right = leftRight
			bottom = topBottom
		}

		def new(top, right, bottom, left float) {
			self.left = left
			self.top = top
			self.right = right
			self.bottom = bottom
		}
	}

	check "Insets" {
	    use std.testing

        @test()
		def testInsetsContructor() {
			let inset = new Insets(10.0)
			assert 10.0 := inset.left && inset.top && inset.right && inset.bottom

			inset = new Insets(10.0, 20.0)
			assert 10.0 := inset.top && inset.bottom
			assert 20.0 := inset.left && inset.right

			inset = new Insets(10.0, 20.0, 30.0, 40.0)
			assert inset.top == 10
			assert inset.right == 20
			assert inset.bottom == 30
			assert inset.left == 40
		}
	}
}
