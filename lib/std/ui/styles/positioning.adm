partial module std.ui.styles {
	/*
	Positioning / anchoring
	
	top/right/bottom/left
	absolute/relative/fixed/sticky positioning
	inset
	anchor positioning
	z-order / stacking
	*/

	// How a component takes part in its parent's layout.
	enum Position {
		// The parent's layout places it among its siblings.
		Normal,
		// Placed like Normal, then held at the edge of the scroll area once scrolled past it.
		Sticky,
		// Out of the layout, placed against the parent's box with `place` and `offset`.
		Relative,
		// Out of the layout, placed against the window: (0, 0) is the window's top-left.
		Absolute,
	}

	// The drawing layers of a window, bottom to top. Layers are window-wide: a component in any
	// layer above Content is clipped only by the window, not by its ancestors. Inside one layer,
	// tree order decides. The layer never changes where a component is placed; `position` does.
	enum Layer {
		// Behind the content: wallpapers, backdrops.
		Background,
		// Where components draw unless they say otherwise.
		Content,
		// Above the content: sticky headers, floating buttons.
		Floating,
		// Dialogs; a newer one is on top.
		Modal,
		// Menus and dropdowns, also over a modal.
		Popup,
		// Tooltips.
		Tooltip,
		// Notifications and toasts.
		Notification,
		// Drag previews and custom cursors.
		Drag,
		// Inspector overlays.
		Debug,
	}
}
