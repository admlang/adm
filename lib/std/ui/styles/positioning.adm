partial module std.ui.styles {
	/*
	Positioning / anchoring
	
	top/right/bottom/left
	absolute/relative/fixed/sticky positioning
	inset
	anchor positioning
	z-order / stacking
	*/


    enum Positioning {
        // Default positioning for components. Normal layout participation
        Flow,
        // Removed from normal layout and positioned relative against a containing box.
        Absolute,
        // Positioned absolute against the window
        Oberlay,
        // Pinned to the viewport, but not the window
        Pinned,
    }

}
