partial module std.ui.styles {
	use (
		std.math.geom::Corners
		std.units::(Extent, Pixels)
	)

	// How a corner is cut.
	enum CornerShape {
		// A quarter ellipse.
		Round,
		// A straight cut.
		Cut,
		// A superellipse that eases into the sides.
		Smooth,
	}

	// The outline the paint styles follow: background, borders, outline, shadows and
	// clipping embed it, so a component has one radius.
	style Shape {
		// The corner radii. A percentage is of the box's shorter side, so `50(%)` makes a
		// pill or a circle.
		@styleProperty
		let radius Corners<Extent> = new Corners<Extent>(0(px))

		// How the corners are cut.
		@styleProperty
		let corners CornerShape = CornerShape.Round
	}
}
