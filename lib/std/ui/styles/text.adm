partial module std.ui.styles {
	use (
		std.gfx.canvas
		std.gfx.color::(Color, Transparent)
		std.units::(Extent, Pixels)
	)

	// The weight of a font on the OpenType scale.
	enum FontWeight {
		Thin = 100,
		ExtraLight = 200,
		Light = 300,
		Normal = 400,
		Medium = 500,
		SemiBold = 600,
		Bold = 700,
		ExtraBold = 800,
		Black = 900,
	}

	// How wide the letterforms are.
	enum FontWidth {
		Condensed,
		SemiCondensed,
		Normal,
		SemiExpanded,
		Expanded,
	}

	// A font: family, size, weight and slant. `UI.appearance()` reports the system
	// fonts as Fonts, and text styles use one to say how text is drawn.
	struct Font {
		// The family name ("Inter", "Noto Sans") or a generic family: "system-ui",
		// "sans-serif", "serif", "monospace".
		family    string
		// Families tried, in order, for characters `family` lacks. The platform's own
		// fallback comes after them.
		fallback  string[]           = []
		// The em size.
		size      Extent             = 16(px)
		weight    FontWeight         = FontWeight.Normal
		width     FontWidth          = FontWidth.Normal
		// Whether the italic (or oblique) face is used.
		italic    bool
		// Whether the font's ligatures are used ("->" drawn as an arrow in a coding font).
		ligatures bool               = true
		// OpenType features by tag: {"tnum": 1} for figures of equal width, {"zero": 1} for
		// a slashed zero.
		features  map<string, int>   = map<string, int>{}
		// Variable-font axes by tag: {"wght": 450.0, "opsz": 14.0}. An axis named here wins
		// over `weight` and `width`.
		axes      map<string, float> = map<string, float>{}
	}

	// The colour of text and monochrome icons.
	style Foreground {
		// What text and monochrome icons are drawn with. Unset takes the parent's; the
		// window takes the theme's.
		@styleProperty(inherit = true)
		let foreground ?Paint = none
	}

	// Where a line may break.
	enum Wrap {
		// Never: one line, however long.
		None,
		// Between words.
		Words,
		// Between words, and inside a word too long for the line.
		Anywhere,
		// Between words, with lines of similar length (headings).
		Balanced,
	}

	// What happens to spaces and line breaks in the text.
	enum Whitespace {
		// Runs of spaces and line breaks become one space.
		Collapse,
		// Kept as written: code.
		Preserve,
		// Spaces collapse, line breaks are kept.
		PreserveLines,
	}

	// How text that does not fit is cut.
	enum TextOverflow {
		Clip,
		// "A long sentence…"
		Ellipsis,
		// "…/src/ui/button.adm": the end matters, as in a path.
		EllipsisStart,
		// "/home/…/button.adm": both ends matter, as in a tab title.
		EllipsisMiddle,
		// Fades out over the last characters.
		Fade,
	}

	// Letter case applied when drawing; the text itself is unchanged.
	enum Casing {
		None,
		Upper,
		Lower,
		Capitalize,
		SmallCaps,
	}

	// How the lines of a text are set.
	struct ParagraphLayout {
		// The distance between baselines: a multiple of the font size, or an extent.
		lineHeight    float | Extent         = 1.4
		// Added between characters.
		letterSpacing Extent                 = 0(px)
		// Added between words.
		wordSpacing   Extent                 = 0(px)
		// Indent of the first line.
		indent        Extent                 = 0(px)
		// Indent of the lines a wrapped line continues on (code editors).
		wrapIndent    Extent                 = 0(px)
		wrap          Wrap                   = Wrap.Words
		whitespace    Whitespace             = Whitespace.Collapse
		overflow      TextOverflow           = TextOverflow.Clip
		// The most lines shown; none: all of them.
		maxLines      ?int                   = none
		// Whether long words may break with a hyphen, by the language's rules.
		hyphens       bool                   = false
		// The width of a tab stop, in space widths.
		tabSize       int                    = 4
		casing        Casing                 = Casing.None
		// Upright horizontal lines, or vertical text.
		orientation   canvas.TextOrientation = canvas.TextOrientation.Horizontal
	}

	// The shape of a decoration line.
	enum DecorationLine {
		Solid,
		Double,
		Dotted,
		Dashed,
		// The squiggle under a spelling mistake or a compile error.
		Wavy,
	}

	// Lines drawn with the text.
	struct Decoration {
		underline      bool
		overline       bool
		strikethrough  bool
		line           DecorationLine = DecorationLine.Solid
		// none: the text's foreground.
		paint          ?Paint         = none
		// none: the font's own underline thickness.
		thickness      ?Extent        = none
		// An underline leaves gaps where letters descend through it.
		skipDescenders bool           = true
	}

	// How text is drawn: font, line setting, decoration.
	style Typography {
		Foreground

		// The font. Unset takes the parent's. A literal sets the fields it names over the
		// inherited font: `font = {weight: FontWeight.Bold}` keeps the family and size.
		@styleProperty(inherit = true)
		let font ?Font = none

		// How lines are set. Unset takes the parent's; a literal merges like `font`.
		@styleProperty(inherit = true)
		let paragraph ?ParagraphLayout = none

		// Underline, overline, strikethrough. Not inherited.
		@styleProperty
		let decoration Decoration = Decoration{}
	}

	// The look of a range of characters inside a text. Every field unset takes the
	// surrounding text's value.
	struct RunStyle {
		font       ?Font       = none
		foreground ?Paint      = none
		// Painted behind the range: selection, search hits, diff changes.
		background ?Paint      = none
		decoration ?Decoration = none
		// Raises or lowers the range from the baseline: superscripts.
		shift      ?Extent     = none
	}

	// A styled range of a text: `TextRun{start: 6, end: 11, foreground: accent}`.
	struct TextRun {
		// The look of the range.
		RunStyle

		// The first character covered.
		start   int
		// One past the last character covered.
		end     int
		// What following the range opens; makes it a link.
		link    ?string = none
		// Shown when the pointer rests on the range.
		tooltip ?string = none
	}

	// The shape of the text caret.
	enum CaretShape {
		Bar,
		Block,
		Underline,
	}

	// The text caret.
	struct Caret {
		// none: the text's foreground.
		paint ?Paint     = none
		shape CaretShape = CaretShape.Bar
		// The width of a Bar, the thickness of an Underline.
		width Pixels     = 1(px)
		// A full on-off cycle; 0s: no blinking; none: the platform's
		// (`Appearance.caretBlink`).
		blink ?duration  = none
	}

	// The colours of selected text.
	struct Selection {
		// Behind selected text while the component has the focus.
		background canvas.Paint = new Color(Transparent)
		// Selected text; none: unchanged.
		foreground ?Paint       = none
		// Behind selected text while another component has the focus.
		inactive   canvas.Paint = new Color(Transparent)
	}

	// The parts of editable text: caret, selection, placeholder.
	style Editable {
		@styleProperty
		let caret Caret = Caret{}

		@styleProperty
		let selection Selection = Selection{}

		// The hint shown while the field is empty; none: the foreground, dimmed by the theme.
		@styleProperty
		let placeholder ?Paint = none
	}

	// How glyph edges are smoothed.
	enum Antialias {
		// What the platform does by default.
		Platform,
		None,
		Gray,
		// LCD subpixels, where the display has them.
		Subpixel,
	}

	// How glyphs are rasterized.
	struct Rendering {
		antialias Antialias = Antialias.Platform
		// Fits glyph outlines to the pixel grid (sharper, less faithful).
		hinting   bool      = true
	}

	// How glyphs are rasterized, for a subtree.
	style TextRendering {
		// Unset takes the parent's.
		@styleProperty(inherit = true)
		let rendering ?Rendering = none
	}
}
