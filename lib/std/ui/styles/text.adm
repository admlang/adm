partial module std.ui.styles {
    style Text {
        @styleProperty
        let fontFamily string | string[]
        @styleProperty
        let size float
        @styleProperty
        let weight int | string = "normal"
    }

	/*
	font family
	size
	weight
	style
	stretch
	line height
	letter spacing
	word spacing
	alignment
	indentation
	capitalization/transformation
	wrapping
	whitespace
	overflow/ellipsis
	decoration
	hyphenation
	writing direction
	vertical writing
	font feature settings
	variable fonts
	*/

	type TYP = int | string
	type X {
	    vstr string
        vint int

	    @implicit
	    def new(val TYP) {
	        match val {
	            case string: vstr = val
	            case int: vint = val
	        }
	    }

        def str() string {
            return vstr
        }

        def num() int {
            return vint
        }
	}

	check "test" {
	    use std.testing

	    @test
	    def test() {
	        let x X = "test"
	        println(x.str())
	        x = 123
	        println(x.num())
	    }
	}
}
