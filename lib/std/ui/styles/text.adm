partial module std.ui.styles {
	use std.units::Extent

	// A font: family, size, weight and slant. `UI.appearance()` reports the system
	// fonts as Fonts, and text styles use one to say how text is drawn.
	struct Font {
		// The family name ("Inter", "Noto Sans") or a generic family: "system-ui",
		// "sans-serif", "serif", "monospace".
		family string
		// The em size.
		size   Extent = 16(px)
		// The weight on the OpenType scale: 100 thin, 400 normal, 700 bold, 900 black.
		weight int    = 400
		// Whether the italic (or oblique) face is used.
		italic bool
	}

	style Text {
		@styleProperty
		let fontFamily string | string[]
		@styleProperty
		let size float
		@styleProperty
		let weight int | string = "normal"
	}
	/*
	font family
	size
	weight
	style
	stretch
	line height
	letter spacing
	word spacing
	alignment
	indentation
	capitalization/transformation
	wrapping
	whitespace
	overflow/ellipsis
	decoration
	hyphenation
	writing direction
	vertical writing
	font feature settings
	variable fonts
	*/
}
