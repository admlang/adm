partial module std.ui.styles {
	use std.units::(Extent, Pixels)

	// One grid column or row.
	type Track {
		// Fixed, sized to its largest cell (`auto`), or a share of the leftover space
		// (`fill`, `fill * 2`).
		size Sizing  = auto
		// The smallest it may become; none: no limit.
		min  ?Extent = none
		// The largest it may become; none: no limit.
		max  ?Extent = none

		// A track of that size with no limits: `Track[200(px), fill, auto]`.
		@implicit
		def new(size Sizing) {
			self.size = size
		}

		def new(size Sizing, min ?Extent, max ?Extent = none) {
			self.size = size
			self.min = min
			self.max = max
		}
	}

	// As many equal tracks as fit: each at least `min` wide, the leftover shared between
	// them. `columns = TrackFit{min: 240(px)}` gives four columns on a desktop and one on a
	// phone.
	struct TrackFit {
		min   Extent
		// The most tracks to make; none: as many as fit.
		count ?int   = none
		// Keeps the track width when there are fewer children than tracks, leaving empty
		// tracks; false stretches the children over the whole width.
		keep  bool   = false
	}

	// A grid's columns or rows: a list of tracks, or as many as fit.
	type TrackList = Track[] | TrackFit

	// Which way children without a cell fill the grid.
	enum GridFlow {
		Rows,
		Columns,
	}

	// Where a child sits in a grid.
	struct Cell {
		// 1-based; none: the next free cell in flow order.
		column     ?int = none
		row        ?int = none
		// How many tracks it covers.
		columnSpan int  = 1
		rowSpan    int  = 1
	}

	// A grid's columns and rows.
	style Tracks {
		// The columns, left to right.
		@styleProperty
		let columns TrackList = [new Track(fill)]

		// The rows, top to bottom. Children beyond them get `autoTrack` rows.
		@styleProperty
		let rows TrackList = Track[]

		// The track made for children placed beyond `rows` (or beyond `columns` when the flow
		// is Columns).
		@styleProperty
		let autoTrack Track = new Track(auto)

		// Whether children without a cell fill row by row or column by column.
		@styleProperty
		let flow GridFlow = GridFlow.Rows

		// Lets later small children fill holes earlier wide ones left.
		@styleProperty
		let dense bool = false

		// Set on a child: its grid cell.
		@childProperty
		let cell Cell = Cell{}
	}
}
