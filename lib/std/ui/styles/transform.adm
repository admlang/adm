partial module std.ui.styles {
	use (
		std.math.geom::(Point, Transform2D, Vec2)
		std.units::(Angle, Extent, Pixels)
	)

	// A distance along each axis, in any unit.
	struct Offset {
		x Extent = 0(px)
		y Extent = 0(px)
	}

	// A move, scale, turn and slant of a component about a point.
	struct Transform {
		// Percentages are of the component's own size.
		translate Offset       = Offset{}
		scale     Vec2         = new Vec2(1.0, 1.0)
		rotate    Angle        = 0(°)
		skew      Point<Angle> = new Point<Angle>(0(°), 0(°))
		// The fixed point, as fractions of the box: (0.5, 0.5) is its centre.
		origin    Point        = new Point(0.5, 0.5)
		// Applied after the fields above; none: nothing more.
		matrix    ?Transform2D = none
	}

	// A drawn transform. The component keeps the place and size layout gave it and its
	// neighbours do not move; input follows the transform.
	style Transforms {
		@styleProperty
		let transform Transform = Transform{}
	}
}
