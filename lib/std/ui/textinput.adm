partial module std.ui {
	use (
		std.math.geom::Rect
		std.units::Pixels
	)

	// What the on-screen keyboard and autofill should offer for a text input.
	enum TextKind {
		Text,
		Multiline,
		Number,
		Decimal,
		Email,
		Url,
		Phone,
		Password,
		Search,
	}

	// A stretch of a text, in characters: `start` included, `end` excluded. The two are
	// equal for a caret.
	struct TextRange {
		start int
		end   int
	}

	// What a component that edits text offers the platform's text input (typed
	// characters, input methods, on-screen keyboards) while it has the keyboard focus.
	interface TextInputClient {
		// Text being composed: shown underlined at the caret, not yet part of the value.
		// `caret` is the position inside it.
		def compose(text string, caret int)
		// Final text: replaces the composition, or is inserted at the caret.
		def commit(text string)
		// Text around the caret, for the input method's context.
		def surrounding() string
		// The selected range of the text; `start == end` is the caret.
		def selection() TextRange
		// Removes `before` characters before the caret and `after` after it (on-screen
		// keyboards delete this way, without key events).
		def deleteSurrounding(before int, after int)
		// Where the caret is, in window coordinates: the platform puts its candidate
		// window there.
		def caretRect() Rect<Pixels>
		// What the on-screen keyboard and autofill should offer.
		def inputKind() TextKind
	}
}
