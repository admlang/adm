partial module std.ui {
	use (
		std.gfx.color::Color
		std.ui.frames
		std.ui.styles::(Easing, Font, RunStyle, Shadow)
		std.units::(Extent, Pixels)
	)

	// How much space controls take.
	enum Density {
		Compact,
		Normal,
		Comfortable,
	}

	// The colours of a theme, named by what they are for.
	struct Palette {
		// Backgrounds, back to front.
		window, surface, surfaceRaised, surfaceSunken, overlay Color
		// Text and icons on those.
		foreground, foregroundMuted, foregroundDisabled        Color
		// Lines.
		border, borderStrong, divider                          Color
		// The highlight colour and what is drawn on it.
		accent, onAccent                                       Color
		// What a surface is mixed with while the pointer is over a control and while it
		// is held down (`surfaceRaised.mix(hover)`), and the accent fill in those states.
		hover, pressed                                         Color
		accentHover, accentPressed                             Color
		// The focus ring, and selected content.
		focus, selection, selectionInactive, onSelection       Color
		link, linkVisited                                      Color
		// Status.
		danger, warning, success, info                         Color
		onDanger, onWarning, onSuccess, onInfo                 Color
		// Behind a modal, and what shadows are drawn with.
		scrim, shadow                                          Color
	}

	// The fonts of a theme, by use.
	struct Fonts {
		body, label, caption, title Font
		// Heading levels 1 to 6.
		headings                    Font[]
		// Monospace: code, the editor.
		code                        Font
	}

	// The sizes of a theme.
	struct Metrics {
		density       Density = Density.Normal
		// The spacing step: gaps and paddings are multiples of it.
		unit          Pixels  = 4(px)
		radius        Pixels  = 4(px)
		borderWidth   Pixels  = 1(px)
		focusWidth    Pixels  = 2(px)
		// The height of a button, a field, a list row.
		controlHeight Pixels  = 28(px)
		iconSize      Pixels  = 16(px)
		// The smallest hit area while the pointer is a finger.
		touchTarget   Pixels  = 44(px)
		// The longest comfortable line of prose.
		measure       Extent  = 35(em)
	}

	// The durations and timing curves of a theme.
	struct MotionTokens {
		fast, normal, slow duration
		enter, exit, move  Easing
	}

	// A named set of values styles read.
	type Theme {
		name      string
		scheme    ColorScheme
		palette   Palette
		fonts     Fonts
		metrics   Metrics
		motion    MotionTokens
		// Shadows by height: elevation[0] flat, higher floats more.
		elevation Shadow[][]
		// Colours outside the fixed set, by dotted name: "syntax.keyword",
		// "editor.lineNumber", "terminal.ansiRed".
		colors    map<string, Color>
		// Text looks outside the fixed set, by dotted name.
		runs      map<string, RunStyle>

		// The theme the platform asks for: its scheme, accent and fonts.
		def new(appearance Appearance) {
			follow(appearance)
		}

		// Takes the scheme, accent, contrast and fonts of `appearance`: the palette becomes
		// the light or the dark one, with the colours that follow the accent worked out
		// from it. Colours set by hand on the palette are replaced.
		def follow(appearance Appearance) {
			scheme = appearance.scheme
			name = scheme == ColorScheme.Dark ?? ("Dark", "Light")
			palette = scheme == ColorScheme.Dark ?? (darkPalette(), lightPalette())
			let high = appearance.contrast == Contrast.High
			tint(palette, appearance.accent, scheme, high)
			sharpen(palette) when high
			fonts.body = appearance.font
			fonts.label = appearance.font
			fonts.code = appearance.monospaceFont
			frames.themeChanged()
		}

		// The colour named `name`. A name not found is looked up without its last part
		// ("syntax.keyword.control", then "syntax.keyword", then "syntax"); when none is
		// found the result is `fallback`, or the palette's foreground.
		def color(name string, fallback ?Color = none) Color {
			let key = name
			for key.len() > 0 {
				return colors[key] when colors.hasKey(key)
				let dot = key.lastIndexOf(".")
				break when dot < 0
				key = key[:dot]
			}
			return fallback when !(fallback is none)
			return palette.foreground
		}

		// The text look named `name`, found as `color` finds a colour; an empty one when
		// none is found.
		def run(name string) RunStyle {
			let key = name
			for key.len() > 0 {
				return runs[key] when runs.hasKey(key)
				let dot = key.lastIndexOf(".")
				break when dot < 0
				key = key[:dot]
			}
			return RunStyle{}
		}
	}

	internal def hex(code string) Color {
		return new Color(code)
	}

	// The neutral and status colours of the light scheme.
	internal def lightPalette() Palette {
		let ink = hex("#1D1D20")
		let white = hex("#FFFFFF")
		return Palette{
			window:             hex("#F2F2F4"),
			surface:            hex("#FAFAFB"),
			surfaceRaised:      white,
			surfaceSunken:      hex("#E9E9EC"),
			overlay:            white,
			foreground:         ink,
			foregroundMuted:    hex("#5E5E66"),
			foregroundDisabled: hex("#9A9AA2"),
			border:             hex("#D3D3D9"),
			borderStrong:       hex("#8A8A94"),
			divider:            hex("#E4E4E8"),
			hover:              hex("#E1E1E1"),
			pressed:            hex("#C2C2C2"),
			selectionInactive:  hex("#DCDCE0"),
			onSelection:        ink,
			link:               hex("#1A5FB4"),
			linkVisited:        hex("#813D9C"),
			danger:             hex("#C01C28"),
			warning:            hex("#E5A50A"),
			success:            hex("#1F7A37"),
			info:               hex("#1A66C4"),
			onDanger:           white,
			onWarning:          ink,
			onSuccess:          white,
			onInfo:             white,
			scrim:              hex("#000000").withOpacity(0.4),
			shadow:             hex("#000000").withOpacity(0.2),
		}
	}

	// The neutral and status colours of the dark scheme.
	internal def darkPalette() Palette {
		let ink = hex("#1B1B1E")
		let light = hex("#EDEDF0")
		return Palette{
			window:             ink,
			surface:            hex("#242428"),
			surfaceRaised:      hex("#2E2E33"),
			surfaceSunken:      hex("#151517"),
			overlay:            hex("#34343A"),
			foreground:         light,
			foregroundMuted:    hex("#A5A5AE"),
			foregroundDisabled: hex("#6A6A72"),
			border:             hex("#3E3E45"),
			borderStrong:       hex("#7E7E88"),
			divider:            hex("#303036"),
			hover:              hex("#4F4F54"),
			pressed:            hex("#6D6D70"),
			selectionInactive:  hex("#3A3A40"),
			onSelection:        light,
			link:               hex("#78AEED"),
			linkVisited:        hex("#C28FDB"),
			danger:             hex("#F5737C"),
			warning:            hex("#F0C040"),
			success:            hex("#4CC870"),
			info:               hex("#6AA8F0"),
			onDanger:           ink,
			onWarning:          ink,
			onSuccess:          ink,
			onInfo:             ink,
			scrim:              hex("#000000").withOpacity(0.6),
			shadow:             hex("#000000").withOpacity(0.5),
		}
	}

	// `from` moved toward `toward` in steps until it stands out from `against` by `ratio`,
	// or as far as it gets.
	internal def contrasting(from Color, toward Color, against Color, ratio float) Color {
		let made = from
		for let step = 1; step <= 50 && made.contrastRatio(against) < ratio; step++ {
			made = from.mix(toward, float(step) * 0.02)
		}
		return made
	}

	// Sets the colours that follow the accent: the accent fill, moved until what is drawn
	// on it reads at 4.5 to 1 (white wherever white can get there from 3 to 1, else dark),
	// its hovered and held-down fills a step further from what is drawn on it (toward it
	// for a fill that is already black or white), the focus
	// ring at 3 to 1 on a surface, and the selection, the accent mixed into the surface as
	// far as the foreground still reads on it. Under high contrast the accent reads at 7
	// to 1 and the focus ring at 4.5 to 1.
	internal def tint(palette Palette, accent Color, scheme ColorScheme, high bool) {
		let white = hex("#FFFFFF")
		let black = hex("#000000")
		let dark = scheme == ColorScheme.Dark
		let on = accent.contrastRatio(white) >= 3.0 ?? (white, hex("#1D1D20"))
		let away = on == white ?? (black, white)
		palette.onAccent = on
		palette.accent = contrasting(accent, away, on, high ?? (7.0, 4.5))
		// A fill already at the end of its scale steps toward what is drawn on it.
		let step = palette.accent.mix(away, 0.1) == palette.accent ?? (on, away)
		palette.accentHover = palette.accent.mix(step, 0.1)
		palette.accentPressed = palette.accent.mix(step, 0.2)
		palette.focus = contrasting(accent, dark ?? (white, black), palette.surface, high ?? (4.5, 3.0))
		palette.selection = contrasting(palette.surface.mix(accent, dark ?? (0.45, 0.3)), palette.surface, palette.foreground, 4.5)
	}

	// The high-contrast form: every line is a strong one and muted text is full strength.
	// `tint` raises the accent and the focus ring.
	internal def sharpen(palette Palette) {
		palette.foregroundDisabled = palette.foregroundMuted
		palette.foregroundMuted = palette.foreground
		palette.border = palette.borderStrong
		palette.divider = palette.borderStrong
	}
}
