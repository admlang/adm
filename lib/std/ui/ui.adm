partial module std.ui {
	use (
		std.math.geom::(Point, Size)
		std.gfx.canvas::DrawContext
	)

	// The pointer button a ClickEvent reports.
	enum MouseButton {
		Left = 0,
		Right = 1,
		Middle = 2,
	}

	// ClickEvent is emitted when a pointer click is resolved to a target component.
	type ClickEvent {
		target   string
		position Point
		button   MouseButton
		clicks   int
	}

	// MouseMoveEvent is emitted when the pointer moves over a window surface.
	type MouseMoveEvent {
		target   string
		position Point
		delta    Point
	}

	// MouseWheelEvent is emitted for scroll wheel / trackpad scroll gestures.
	type MouseWheelEvent {
		target   string
		position Point
		delta    Point
	}

	// ResizeEvent is emitted when a window changes size.
	type ResizeEvent {
		size Size
	}

	// CloseEvent is emitted when the user requests a window close.
	type CloseEvent {
		reason string
	}

	// KeyEvent is emitted for key presses/releases.
	type KeyEvent {
		target string
		key    int
	}

	// TextInputEvent is emitted for text composition/character input.
	type TextInputEvent {
		target string
		rune   char
	}

	// Draws a component onto a DrawContext.
	interface ComponentRenderer {
		def render(ctx DrawContext)
	}
}
