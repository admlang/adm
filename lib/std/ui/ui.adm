partial module std.ui {
	use std.math.geom::(Point, Size)

	// The pointer button a ClickEvent reports.
	enum MouseButton {
		Left = 0,
		Right = 1,
		Middle = 2,
	}

	// ClickEvent is emitted when a pointer button is released over a window.
	type ClickEvent {
		// The component drawn topmost under the pointer; the window's root when no other
		// component is there.
		target   component
		position Point
		button   MouseButton
		clicks   int
	}

	// MouseMoveEvent is emitted when the pointer moves over a window surface.
	type MouseMoveEvent {
		// The component drawn topmost under the pointer; the window's root when no other
		// component is there.
		target   component
		position Point
		delta    Point
	}

	// MouseWheelEvent is emitted for scroll wheel / trackpad scroll gestures.
	type MouseWheelEvent {
		// The component drawn topmost under the pointer; the window's root when no other
		// component is there.
		target   component
		position Point
		delta    Point
	}

	// ResizeEvent is emitted when a window changes size.
	type ResizeEvent {
		size Size
	}

	// CloseEvent is emitted when the user requests a window close.
	type CloseEvent {
		reason string
	}

	// KeyEvent is emitted for key presses/releases.
	type KeyEvent {
		// The component that has the keyboard focus; the window's root when none has.
		target    component
		// What the key means in the current layout.
		key       Key
		// The modifier keys held when it happened.
		modifiers Modifiers = Modifiers{}
		// Whether the key went down; false: it came up.
		down      bool      = true
		// The key went down before and repeats because it is held.
		repeat    bool
		// The key by its place, whatever the layout: the key a US keyboard has there
		// (games, shortcuts that must stay in place). Unknown when the host does not
		// say.
		code      KeyCode   = Key.Unknown
		// The text the press produces by itself; "" for a key that types nothing or
		// with Control, Alt or Command held. What an input method composes comes as
		// text input, not here.
		text      string
	}

	// TextInputEvent is emitted for text composition/character input.
	type TextInputEvent {
		// The component that has the keyboard focus; the window's root when none has.
		target component
		rune   char
	}

	// Draws a component with a RenderContext.
	interface ComponentRenderer {
		def render(ctx RenderContext)
	}
}
