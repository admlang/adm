partial module std.ui {
	use (
		std.math.geom::(Edges, Size)
		std.units::Pixels
	)

	// How much room there is on one axis, as the three classes most layouts distinguish:
	// a phone, a tablet or small window, a desktop.
	enum SizeClass {
		Compact,
		Medium,
		Expanded,
	}

	// Whether a window is taller than wide.
	enum Orientation {
		Portrait,
		Landscape,
	}

	// The most precise pointing device in use.
	enum PointerKind {
		None,
		// A finger.
		Coarse,
		// A mouse, trackpad or pen.
		Fine,
	}

	// The window as layouts see it.
	struct Viewport {
		// The visible area, in logical pixels: what `vw` and `vh` measure. On a phone it
		// excludes the on-screen keyboard.
		size        Size<Pixels>
		widthClass  SizeClass     = SizeClass.Expanded
		heightClass SizeClass     = SizeClass.Expanded
		orientation Orientation   = Orientation.Landscape
		// Device pixels per logical pixel.
		scale       float         = 1.0
		// What the system covers at each edge: notch, rounded corners, status and
		// navigation bars.
		insets      Edges<Pixels> = new Edges<Pixels>(0(px))
		// How far the on-screen keyboard covers the bottom; 0 without one.
		keyboard    Pixels        = 0(px)
		pointer     PointerKind   = PointerKind.Fine
		// Whether the pointer can rest over things without pressing.
		hover       bool          = true
		// Whether the window is the active one.
		active      bool          = true
		fullscreen  bool
	}
}
