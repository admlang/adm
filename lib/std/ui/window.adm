partial module std.ui {
	use std.ui.renderer as r

	// How a window sits on the desktop.
	enum WindowState {
		Normal,
		Minimized,
		Maximized,
		Fullscreen,
	}

	// What a window is to the desktop.
	enum WindowKind {
		// An ordinary top-level window.
		Normal,
		// Stays above its owner; no taskbar entry.
		Dialog,
		// A small tool window above its owner.
		Utility,
	}

	// What `UI.closeRequested` carries when the user asks to close a window. A handler that
	// calls `cancel` keeps the window open: to ask about unsaved changes, or to send the
	// window to the tray by setting its `visible` to false instead.
	type CloseRequest {
		window        r.Window
		internal kept bool

		def new(window r.Window) {
			self.window = window
		}

		// Whether a handler kept the window open.
		cancelled bool {
			def get() bool {
				return kept
			}
		}

		// Keeps the window open.
		def cancel() {
			kept = true
		}
	}
}
