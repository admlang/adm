partial module std.units {
	// Space and motion -------------------------------------------------------

	// Area, in square metres.
	type Area = Length ** 2

	// Volume, in cubic metres.
	type Volume = Length ** 3

	// Speed, in metres per second: `36(km/h)`, `10(kn)`.
	type Speed = Length / Time

	// Acceleration, in metres per second squared.
	type Acceleration = Speed / Time

	// Jerk, in metres per second cubed.
	type Jerk = Acceleration / Time

	// Angular velocity, in radians per second: `3000(rpm)`, `90(°/s)`.
	type AngularVelocity = Angle / Time

	// Angular acceleration, in radians per second squared.
	type AngularAcceleration = AngularVelocity / Time

	// Wavenumber or print resolution, per metre: `300(dpi)`.
	type Resolution = Length ** -1

	// The hectare, 10 000 m².
	@unit("ha")
	const hectare Area = 10000(m²)

	// The litre, with its prefixed forms: mL, cL, dL.
	@unit("L", prefixes = Prefixes.SI)
	const litre Volume = 0.001(m³)

	// The knot, one nautical mile per hour.
	@unit("kn")
	const knot Speed = 0.514444444444444444(m/s)

	// Standard gravity.
	@unit("g₀")
	const standardGravity Acceleration = 9.80665(m/s²)

	// Revolutions per minute.
	@unit("rpm")
	const rpm AngularVelocity = 0.10471975511965977(rad/s)

	// Dots per inch.
	@unit("dpi")
	const dpi Resolution = 39.37007874015748(1/m)

	// Mechanics --------------------------------------------------------------

	// Force, in newtons.
	type Force = Mass * Acceleration

	// Pressure, in pascals.
	type Pressure = Force / Area

	// Energy, in joules. Torque has the same dimension and is the same type.
	type Energy = Force * Length

	// Power, in watts.
	type Power = Energy / Time

	// Torque, in newton metres: `40(N·m)`.
	type Torque = Force * Length

	// Momentum, in kilogram metres per second.
	type Momentum = Mass * Speed

	// Density, in kilograms per cubic metre.
	type Density = Mass / Volume

	// Volume flow, in cubic metres per second: `12(L/min)`.
	type VolumeFlow = Volume / Time

	// Mass flow, in kilograms per second.
	type MassFlow = Mass / Time

	// Dynamic viscosity, in pascal seconds.
	type Viscosity = Pressure * Time

	// Fuel consumption, volume per distance: `6.5(L/100km)`.
	type FuelConsumption = Volume / Length

	// The newton, with its prefixed forms: kN, mN.
	@unit("N", prefixes = Prefixes.SI)
	const newton Force = 1(kg*m/s²)

	// The pascal, with its prefixed forms: hPa, kPa, MPa.
	@unit("Pa", prefixes = Prefixes.SI)
	const pascal Pressure = 1(N/m²)

	// The bar, 100 kPa, with its prefixed forms: mbar.
	@unit("bar", prefixes = Prefixes.SI)
	const bar Pressure = 100000(Pa)

	// The joule, with its prefixed forms: kJ, MJ.
	@unit("J", prefixes = Prefixes.SI)
	const joule Energy = 1(N*m)

	// The kilowatt hour.
	@unit("kWh")
	const kilowattHour Energy = 3600000(J)

	// The kilocalorie.
	@unit("kcal")
	const kilocalorie Energy = 4184(J)

	// The electronvolt, with its prefixed forms: keV, MeV, GeV.
	@unit("eV", prefixes = Prefixes.SI)
	const electronvolt Energy = 1.602176634e-19(J)

	// The watt, with its prefixed forms: mW, kW, MW.
	@unit("W", prefixes = Prefixes.SI)
	const watt Power = 1(J/s)

	// Power in decibels relative to one milliwatt: `10(dBm)` is 10 mW,
	// `-30(dBm)` is 1 µW. Read a level back with `p.to(dBm)`.
	@unit("dBm", log = 10)
	const dBm Power = 1(mW)

	// Power in decibels relative to one watt: `30(dBW)` is 1 kW.
	@unit("dBW", log = 10)
	const dBW Power = 1(W)

	// Time and frequency -----------------------------------------------------

	// Frequency, in hertz. Radioactivity has the same dimension and is the
	// same type.
	type Frequency = Time ** -1

	// The hertz, with its prefixed forms: kHz, MHz, GHz.
	@unit("Hz", prefixes = Prefixes.SI)
	const hertz Frequency = 1(1/s)

	// Beats per minute.
	@unit("bpm")
	const bpm Frequency = 0.016666666666666666(1/s)

	// Electrical -------------------------------------------------------------

	// Electric charge, in coulombs: `2500(mAh)`.
	type Charge = ElectricCurrent * Time

	// Voltage, in volts.
	type Voltage = Power / ElectricCurrent

	// Electrical resistance, in ohms.
	type Resistance = Voltage / ElectricCurrent

	// Electrical conductance, in siemens.
	type Conductance = ElectricCurrent / Voltage

	// Capacitance, in farads.
	type Capacitance = Charge / Voltage

	// Magnetic flux, in webers.
	type MagneticFlux = Voltage * Time

	// Inductance, in henries.
	type Inductance = MagneticFlux / ElectricCurrent

	// Magnetic flux density, in teslas.
	type FluxDensity = MagneticFlux / Area

	// The coulomb, with its prefixed forms: mC, µC.
	@unit("C", prefixes = Prefixes.SI)
	const coulomb Charge = 1(A*s)

	// The milliampere hour, a battery's charge.
	@unit("mAh")
	const milliampereHour Charge = 3.6(C)

	// The volt, with its prefixed forms: mV, kV.
	@unit("V", prefixes = Prefixes.SI)
	const volt Voltage = 1(W/A)

	// The ohm, with its prefixed forms: kΩ, MΩ.
	@unit("Ω", prefixes = Prefixes.SI)
	const ohm Resistance = 1(V/A)

	// The siemens, with its prefixed forms: mS, µS.
	@unit("S", prefixes = Prefixes.SI)
	const siemens Conductance = 1(A/V)

	// The farad, with its prefixed forms: µF, nF, pF.
	@unit("F", prefixes = Prefixes.SI)
	const farad Capacitance = 1(C/V)

	// The henry, with its prefixed forms: mH, µH.
	@unit("H", prefixes = Prefixes.SI)
	const henry Inductance = 1(Wb/A)

	// The weber.
	@unit("Wb", prefixes = Prefixes.SI)
	const weber MagneticFlux = 1(V*s)

	// The tesla, with its prefixed forms: mT, µT.
	@unit("T", prefixes = Prefixes.SI)
	const tesla FluxDensity = 1(Wb/m²)

	// Light ------------------------------------------------------------------

	// Luminous flux, in lumens.
	type LuminousFlux = LuminousIntensity * SolidAngle

	// Illuminance, in lux.
	type Illuminance = LuminousFlux / Area

	// Luminance, in candelas per square metre.
	type Luminance = LuminousIntensity / Area

	// The lumen.
	@unit("lm")
	const lumen LuminousFlux = 1(cd*sr)

	// The lux.
	@unit("lx")
	const lux Illuminance = 1(lm/m²)

	// Thermal and chemistry --------------------------------------------------

	// Specific heat capacity, in joules per kilogram kelvin.
	type SpecificHeat = Energy / (Mass * Temperature)

	// Molar mass, in kilograms per mole: `18(g/mol)`.
	type MolarMass = Mass / Amount

	// Concentration, in moles per cubic metre: `0.1(mol/L)`.
	type Concentration = Amount / Volume

	// Radiation --------------------------------------------------------------

	// Absorbed dose, in grays. Equivalent dose has the same dimension and is
	// the same type.
	type AbsorbedDose = Energy / Mass

	// Equivalent dose, in sieverts.
	type EquivalentDose = Energy / Mass

	// Radioactivity, in becquerels; the dimension of Frequency.
	type Radioactivity = Time ** -1

	// The becquerel, with its prefixed forms: kBq, MBq.
	@unit("Bq", prefixes = Prefixes.SI)
	const becquerel Radioactivity = 1(1/s)

	// The gray, with its prefixed forms: mGy.
	@unit("Gy", prefixes = Prefixes.SI)
	const gray AbsorbedDose = 1(J/kg)

	// The sievert, with its prefixed forms: mSv, µSv.
	@unit("Sv", prefixes = Prefixes.SI)
	const sievert EquivalentDose = 1(J/kg)

	// Data rate --------------------------------------------------------------

	// Data rate, in bytes per second: `100(Mbps)`, `20(MB/s)`.
	type DataRate = DataSize / Time

	// Bits per second, with decimal and binary prefixes: kbps, Mbps, Gbps.
	@unit("bps", prefixes = Prefixes.Data)
	const bitsPerSecond DataRate = 0.125(B/s)
}
