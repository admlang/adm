partial module std.units {
	// Reads a quantity from text: a number, optionally followed by a unit of
	// the same dimension as `unit` (`10kg`, `10 kg`, `2.5 t`), or a bare
	// number, read in `unit`: `parseUnit("10", kg)` is 10 kg. The text's unit
	// is a single unit (`g`, `t`, `mg`) or `unit` exactly as written at the
	// call: `parseUnit("36 m/s", km/h)` fails, since `m/s` is compound and not
	// the call's unit, while `parseUnit("36 km/h", km/h)` works. Fails when the
	// text does not start with a number, or when its unit is unknown, compound
	// or measures another dimension.
	def parseUnit<D>(text string, unit Unit<D>) !D {
		let s = text.trim()
		let end = numberEnd(s)
		fail "parseUnit: \"{text}\" is not a number" when end == 0
		let value = parseFloat<float>(s[:end])
		let symbol = s[end:].trim()
		return quantityOf(unit, inBase(value, unit.factor, unit.offset, unit.log)) when symbol == ""
		for let i in 0..unit.symbols.len() {
			return quantityOf(unit, inBase(value, unit.factors[i], unit.offsets[i], unit.logs[i])) when unit.symbols[i] == symbol
		}
		fail "parseUnit: \"{symbol}\" in \"{text}\" is not a unit of {unit.symbol}"
	}

	// The quantity `value` stands for in `unit`: `quantity(3, km)` is 3000 m,
	// `quantity(db, dB)` the linear gain of a level held in a variable. The
	// counterpart of `v.to(unit)`; for a literal write `3(km)`.
	def quantity<D>(value float, unit Unit<D>) D {
		return quantityOf(unit, inBase(value, unit.factor, unit.offset, unit.log))
	}

	// value in a unit with this factor, offset and log scale, in base units.
	internal def inBase(value float, factor float, offset float, log float) float {
		return factor * 10.0 ** (value / log) when log != 0.0
		return value * factor + offset
	}

	// The length of the number s starts with: a sign, digits with an optional
	// fraction, and an optional exponent. 0 when s starts with no digit.
	internal def numberEnd(s string) int {
		let i = 0
		i += 1 when i < s.len() && (s[i] == '-' || s[i] == '+')
		let digits = 0
		for i < s.len() && s[i] >= '0' && s[i] <= '9' {
			i += 1
			digits += 1
		}
		if i < s.len() && s[i] == '.' {
			i += 1
			for i < s.len() && s[i] >= '0' && s[i] <= '9' {
				i += 1
				digits += 1
			}
		}
		return 0 when digits == 0
		if i < s.len() && (s[i] == 'e' || s[i] == 'E') {
			let j = i + 1
			j += 1 when j < s.len() && (s[j] == '-' || s[j] == '+')
			let expDigits = j
			for j < s.len() && s[j] >= '0' && s[j] <= '9' {
				j += 1
			}
			i = j when j > expDigits
		}
		return i
	}
}
