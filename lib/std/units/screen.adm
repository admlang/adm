// Screen and layout units: logical pixels, percentages, viewport shares and
// font-relative sizes, the lengths the canvas and the UI take beside the SI
// ones.

partial module std.units {
	// Logical pixels: device pixels scaled by the display's DPI.
	@dimension(unit = "px")
	type Pixels

	// A share of a reference size: the parent's along the same axis in the UI,
	// the rectangle's for a corner radius, the gradient line for a stop.
	@dimension(unit = "%")
	type Percent

	// A share of the window's height: `100(vh)` is the whole height.
	@dimension(unit = "vh")
	type ViewportHeight

	// A share of the window's width: `100(vw)` is the whole width.
	@dimension(unit = "vw")
	type ViewportWidth

	// Multiples of the current font size: `1(em)` is the font size.
	@dimension(unit = "em")
	type FontRelative

	// A size or offset in any of the UI's units: `8(px)`, `50(%)`, `80(vh)`,
	// `2(cm)`. The renderer converts each case when it lays out.
	type Extent = Pixels | Percent | ViewportHeight | ViewportWidth | FontRelative | Length
}
