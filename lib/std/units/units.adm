// Units of measure: the dimensions quantity literals are typed with
// (`100(km)` is a `Length`) and the SI units, with the units accepted for use
// with SI. A quantity is a float in its dimension's base units; the dimension
// exists only in the type. Derived dimensions are in `derived.adm`.

partial module std.units {
	// Length, in metres.
	@dimension(unit = "m")
	type Length

	// Mass, in kilograms.
	@dimension(unit = "kg")
	type Mass

	// Time, in seconds. `duration` stays the type of timers and timeouts; a
	// duration meeting a Time is read in seconds.
	@dimension(unit = "s")
	type Time

	// Electric current, in amperes.
	@dimension(unit = "A")
	type ElectricCurrent

	// Thermodynamic temperature, in kelvins.
	@dimension(unit = "K")
	type Temperature

	// Amount of substance, in moles.
	@dimension(unit = "mol")
	type Amount

	// Luminous intensity, in candelas.
	@dimension(unit = "cd")
	type LuminousIntensity

	// Plane angle, in radians.
	@dimension(unit = "rad")
	type Angle

	// Solid angle, in steradians.
	@dimension(unit = "sr")
	type SolidAngle

	// Amount of data, in bytes.
	@dimension(unit = "B")
	type DataSize

	// Length -----------------------------------------------------------------

	// The metre, with its prefixed forms: km, cm, mm, µm, nm.
	@unit("m", prefixes = Prefixes.SI)
	const metre Length = 1(m)

	// The astronomical unit.
	@unit("au")
	const astronomicalUnit Length = 149597870700(m)

	// The nautical mile.
	@unit("nmi")
	const nauticalMile Length = 1852(m)

	// The typographic point, 1/72 of an inch: font sizes.
	@unit("pt")
	const point Length = 0.000352777777777777778(m)

	// Mass -------------------------------------------------------------------

	// The gram, with its prefixed forms: mg, µg, kg.
	@unit("g", prefixes = Prefixes.SI)
	const gram Mass = 0.001(kg)

	// The tonne, 1000 kg.
	@unit("t")
	const tonne Mass = 1000(kg)

	// The dalton (unified atomic mass unit).
	@unit("Da")
	const dalton Mass = 1.66053906660e-27(kg)

	// Time -------------------------------------------------------------------

	// The second, with its prefixed forms: ms, µs, ns.
	@unit("s", prefixes = Prefixes.SI)
	const second Time = 1(s)

	// The minute.
	@unit("min")
	const minute Time = 60(s)

	// The hour.
	@unit("h")
	const hour Time = 3600(s)

	// The day.
	@unit("d")
	const day Time = 86400(s)

	// Electric current, temperature, amount, light --------------------------

	// The ampere, with its prefixed forms: mA, µA, kA.
	@unit("A", prefixes = Prefixes.SI)
	const ampere ElectricCurrent = 1(A)

	// The kelvin, with its prefixed forms: mK.
	@unit("K", prefixes = Prefixes.SI)
	const kelvin Temperature = 1(K)

	// The degree Celsius: 0 °C is 273.15 K. A literal in °C is an absolute
	// temperature, so a sum of two warns; write differences in K.
	@unit("°C", offset = 273.15)
	const celsius Temperature = 1(K)

	// The mole, with its prefixed forms: mmol, µmol.
	@unit("mol", prefixes = Prefixes.SI)
	const mole Amount = 1(mol)

	// The candela.
	@unit("cd", prefixes = Prefixes.SI)
	const candela LuminousIntensity = 1(cd)

	// Angles -----------------------------------------------------------------

	// The radian, with its prefixed forms: mrad.
	@unit("rad", prefixes = Prefixes.SI)
	const radian Angle = 1(rad)

	// The degree, π/180 rad.
	@unit("°")
	const degree Angle = 0.017453292519943295(rad)

	// The minute of arc, 1/60 of a degree.
	@unit("′")
	const arcminute Angle = 0.0002908882086657216(rad)

	// The second of arc, 1/60 of a minute of arc.
	@unit("″")
	const arcsecond Angle = 0.00000484813681109536(rad)

	// The steradian.
	@unit("sr")
	const steradian SolidAngle = 1(sr)

	// Levels -----------------------------------------------------------------

	// The decibel of an amplitude ratio (20·log10): `-6(dB)` is the plain
	// float 0.501, a gain to multiply samples by; `+6(dB)` doubles. Gains in
	// dB add, so their linear values multiply: `-6(dB) * -6(dB)` is -12 dB.
	// Read a level back with `gain.to(dB)`.
	@unit("dB", log = 20)
	const decibel float = 1

	// Decibels relative to digital full scale (1.0): `-3(dBFS)` is a peak of
	// 0.708.
	@unit("dBFS", log = 20)
	const dBFS float = 1

	// Data -------------------------------------------------------------------

	// The byte (octet), with decimal and binary prefixes: kB, MB, GB, KiB,
	// MiB, GiB. Named `octet` because `byte` is the integer type.
	@unit("B", prefixes = Prefixes.Data)
	const octet DataSize = 1(B)

	// The bit, an eighth of a byte, with the same prefixes: kbit, Mbit, Kibit.
	@unit("bit", prefixes = Prefixes.Data)
	const bit DataSize = 0.125(B)
}
