partial module std.units {
	use std.testing

	check "Quantity literals" {
		@test()
		def literalIsItsDimension() {
			let d Length = 2.5(m)
			let t Time = 3(s)
			let m = 70(kg)
			assert float(d) == 2.5
			assert float(t) == 3.0
			assert float(m) == 70.0
		}

		@test()
		def negativeLiteral() {
			let d = -5(m)
			assert float(d) == -5.0
		}

		@test()
		def cancelledUnitsAreAFloat() {
			let ratio float = 3(m/m)
			assert ratio == 3.0
			assert float(2(m²/m)) == 2.0
		}

		@test()
		def printsInTheBaseUnit() {
			let d = 2.5(m)
			assert "{d}" == "2.5 m"
			assert d.str() == "2.5 m"
		}
	}

	check "Catalogue" {
		// Whether a and b differ by less than a millionth of b.
		def near(a float, b float) bool {
			let diff = a - b
			return (diff < 0.0 ?? (-diff, diff)) <= 0.000001 * (b < 0.0 ?? (-b, b))
		}

		@test()
		def prefixedUnits() {
			assert near(float(2.5(km)), 2500.0)
			assert near(float(3(mm)), 0.003)
			assert near(float(5(mg)), 0.000005)
			assert near(float(250(ms)), 0.25)
			assert near(float(1(µs)), 0.000001)
			assert near(float(2(kN)), 2000.0)
			assert near(float(1013(hPa)), 101300.0)
			assert near(float(1(KiB)), 1024.0)
			assert near(float(1(MB)), 1000000.0)
			assert near(float(8(bit)), 1.0)
		}

		@test()
		def acceptedUnits() {
			assert near(float(1(h)), 3600.0)
			assert near(float(1(d)), 86400.0)
			assert near(float(1(L)), 0.001)
			assert near(float(1(t)), 1000.0)
			assert near(float(1(ha)), 10000.0)
			assert near(float(180(°)), 3.141592653589793)
			assert near(float(1(kWh)), 3600000.0)
			assert near(float(1(bar)), 100000.0)
			assert near(float(20(°C)), 293.15)
		}

		@test()
		def derivedDimensions() {
			let v Speed = 100(km) / 2(h)
			assert near(v.to(km / h), 50.0)
			let f Force = 2(kg) * 9.81(m/s²)
			let w Energy = f * 3(m)
			let torque Torque = w
			assert near(float(torque), 58.86)
			let p Power = w / 2(s)
			assert near(p.to(W), 29.43)
			let u Voltage = 12(V)
			let r Resistance = u / 2(A)
			assert near(r.to(Ω), 6.0)
			let fuel FuelConsumption = 6.5(L/100km)
			assert near(fuel.to(L / (100 * km)), 6.5)
			let rate DataRate = 100(Mbps)
			assert near(rate.to(MB / s), 12.5)
			let hz Frequency = 1 / 20(ms)
			assert near(hz.to(Hz), 50.0)
			let battery Charge = 2500(mAh)
			assert near(battery.to(C), 9000.0)
		}

		@test()
		def durationsAreTimes() {
			let v = 100(km) / 2h
			assert near(v.to(km / h), 50.0)
			assert 2h == 2(h)
			assert 90min > 1(h)
		}

		@test()
		def formats() {
			assert 1500(m).str(km) == "1.5 km"
			assert 36(km/h).str() == "10 m/s"
			assert 1(m).str(cm, digits = 1) == "100.0 cm"
			assert 300(K).str(°C, digits = 2) == "26.85 °C"
		}
	}

	check "Parsing" {
		// Reads a length in the given unit, passing the unit on.
		def readLength(text string, unit Unit<Length>) !Length {
			return try parseUnit(text, unit)
		}

		@test()
		def numbersAndUnits() !none {
			assert float(try parseUnit("10 kg", kg)) == 10.0
			assert float(try parseUnit("10kg", kg)) == 10.0
			assert float(try parseUnit("10", kg)) == 10.0
			assert float(try parseUnit(" 250 g ", kg)) == 0.25
			assert float(try parseUnit("-1.5e3 m", km)) == -1500.0
			assert (try parseUnit("36", km / h)).to(m / s) == 10.0
			assert (try parseUnit("20 °C", K)).to(°C) == 20.0
			assert float(try parseUnit("1 KiB", MB)) == 1024.0
		}

		@test()
		def localsDoNotHideUnits() !none {
			let m = 3
			assert float(try parseUnit("2", m)) == 2.0
			assert m == 3
		}

		@test()
		def unitsPassOn() !none {
			assert float(try readLength("2", km)) == 2000.0
			assert float(try readLength("5 mm", km)) == 0.005
		}

		@test()
		def failures() {
			let wrong = parseUnit("10 m", kg) onerror (err error) {
				assert err.message.contains("is not a unit of kg")
				recover 0(kg)
			}
			assert float(wrong) == 0.0
			let notNumber = parseUnit("kg", kg) onerror (err error) {
				assert err.message.contains("is not a number")
				recover 0(kg)
			}
			assert float(notNumber) == 0.0
			let unknown = parseUnit("3 furlong", m) onerror {
				recover 1(m)
			}
			assert float(unknown) == 1.0
		}
	}

	check "Levels" {
		// Whether a and b differ by less than a millionth.
		def near(a float, b float) bool {
			let diff = a - b
			return (diff < 0.0 ?? (-diff, diff)) <= 0.000001
		}

		@test()
		def decibelsAreLinearGains() {
			assert near(-6(dB), 0.5011872336272722)
			assert near(0(dB), 1.0)
			assert near(20(dB), 10.0)
			assert near((-6(dB) * -6(dB)).to(dB), -12.0)
			assert near(0.5.to(dB), -6.020599913279624)
			assert (-3(dB)).str(dB, digits = 1) == "-3.0 dB"
			assert near(-3(dBFS), 0.7079457843841379)
		}

		@test()
		def powerLevels() {
			assert near(float(10(dBm)), 0.01)
			assert near(float(-30(dBm)), 0.000001)
			assert near(1(W).to(dBm), 30.0)
			assert near(30(dBW).to(kW), 1.0)
			assert (2 * 10(dBm)).str(dBm, digits = 2) == "13.01 dBm"
		}

		@test()
		def signsBelongToTheNumber() {
			assert near((-5(°C)).to(°C), -5.0)
			assert near(float(-5(°C)), 268.15)
		}

		@test()
		def quantitiesOfVariables() {
			let level = -6.0
			assert near(quantity(level, dB), 0.5011872336272722)
			let n = 3.0
			assert near(float(quantity(n, km)), 3000.0)
			assert near(float(quantity(20.0, °C)), 293.15)
			assert near(float(quantity(10.0, dBm)), 0.01)
		}

		@test()
		def parsesLevels() !none {
			assert near(try parseUnit("-3 dB", dB), 0.7079457843841379)
			assert near(float(try parseUnit("20 dBm", W)), 0.1)
		}
	}
}
