partial module std.validations {
	use std.reflection

	// len constrains the length of the annotated field: at least `min` characters
	// or elements and at most `max`, either bound optional.
	meta def len(target reflection.DeclarationMetaContext, min, max ?int) {}

	// url requires the annotated string field to be an absolute URL, as isURL
	// checks it.
	meta def url(target reflection.DeclarationMetaContext) {}

	// email requires the annotated string field to be an e-mail address, as
	// isEmail checks it.
	meta def email(target reflection.DeclarationMetaContext) {}

	// phone requires the annotated string field to be a phone number.
	meta def phone(target reflection.DeclarationMetaContext) {}

	// creditcard requires the annotated string field to be a card number whose
	// digits pass the Luhn check.
	meta def creditcard(target reflection.DeclarationMetaContext) {}

	// date requires the annotated string field to be a calendar date.
	meta def date(target reflection.DeclarationMetaContext) {}

	// time requires the annotated string field to be a time of day.
	meta def time(target reflection.DeclarationMetaContext) {}

	// datetime requires the annotated string field to be a date with a time.
	meta def datetime(target reflection.DeclarationMetaContext) {}

	// file requires the annotated string field to name an existing file.
	meta def file(target reflection.DeclarationMetaContext) {}

	// base64image requires the annotated string field to be an image encoded as
	// a Base64 data URL.
	meta def base64image(target reflection.DeclarationMetaContext) {}

	// numeric requires the annotated string field to be a plain decimal number, as
	// isNumeric checks it.
	meta def numeric(target reflection.DeclarationMetaContext) {}

	// expression requires the annotated string field to match `pattern` in full.
	meta def expression(target reflection.DeclarationMetaContext, pattern regex) {}

	// list requires the annotated field to hold a list of values.
	meta def list(target reflection.DeclarationMetaContext) {}

	// truthy requires the annotated string field to be one of the boolean words
	// isTruthy accepts.
	meta def truthy(target reflection.DeclarationMetaContext) {}
}
