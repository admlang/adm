partial module std.validations {
	use (
		std.strings::(trim, lower)
		std.data.encoding
	)

	const (
		// Accepted string representations of a true boolean value.
		TRUE_VALUES = ["true", "yes", "on", "1", "active", "enabled", "ok", "good", "valid", "available"]

		// FALSE_VALUES is every word isTruthy accepts as a negative.
		FALSE_VALUES = ["false", "no", "off", "0", "inactive", "disabled", "bad", "invalid", "unavailable"]
	)

	internal const (
		numericRe      = /^[+-]?([0-9]+(\.[0-9]+)?|\.[0-9]+)$/
		alphaRe        = /^[a-zA-Z]+$/
		alphaNumericRe = /^[a-zA-Z0-9]+$/
		hexaRe         = /^[0-9a-fA-F]+$/
		base64Re       = /^[A-Za-z0-9+\/]*={0,2}$/
		ipv4Re         = /^([0-9]{1,3}\.){3}[0-9]{1,3}$/
		ipv6Re         = /^([0-9a-fA-F]{0,4}:){7}[0-9a-fA-F]{0,4}$/
		uuidRe         = /^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$/
		emailRe        = /^[A-Za-z0-9.!#$%&'*+\/=?^_`{|}~-]+@[A-Za-z0-9]([A-Za-z0-9-]*[A-Za-z0-9])?(\.[A-Za-z0-9]([A-Za-z0-9-]*[A-Za-z0-9])?)+$/
		urlRe          = /^[A-Za-z][A-Za-z0-9+.-]*:\/\/[^ \/?#]+([\/?#][^ ]*)?$/
	)

	// **isTruthy** reports whether the text is a word that can be interpreted as a
	// boolean: one of `true`, `yes`, `on`, `1`, `active`, `enabled`, `ok`,
	// `good`, `valid`, `available` or their negatives `false`, `no`, `off`,
	// `0`, `inactive`, `disabled`, `bad`, `invalid`, `unavailable`. Case
	// and surrounding whitespace are ignored. It answers whether the text
	// is a boolean at all, not which one: use it to validate a form field,
	// a flag or a setting before reading its value and convert it to a boolean.
	//
	// Example:
	// ```example
	// isTruthy(" Yes ") // true
	// isTruthy("off")   // true: a recognised negative
	// isTruthy("maybe") // false
	// ```
	// @see TRUE_VALUES
	// @see FALSE_VALUES
	def isTruthy(@trim() @lower() txt string) bool {
		return txt in TRUE_VALUES || txt in FALSE_VALUES
	}

	// isNumeric reports whether the text is a plain decimal number: an
	// optional sign, then digits with an optional fraction (`42`, `-3.14`,
	// `.5`). No exponent, no thousands separators, no hexadecimal, and an
	// empty string is not a number. Surrounding whitespace is ignored.
	def isNumeric(@trim() @lower() txt string) bool {
		return false when txt.isEmpty()
		return numericRe.test(txt)
	}

	// isAlpha reports whether the text is one or more ASCII letters (`a`-`z`,
	// `A`-`Z`) and nothing else. Accented and non-Latin letters do not
	// count. Surrounding whitespace is ignored; an empty string is false.
	def isAlpha(@trim() txt string) bool {
		return false when txt.isEmpty()
		return alphaRe.test(txt)
	}

	// isAlphanumeric reports whether the text is one or more ASCII letters
	// or digits and nothing else: no spaces, punctuation or underscores.
	// Surrounding whitespace is ignored; an empty string is false.
	def isAlphanumeric(@trim() txt string) bool {
		return false when txt.isEmpty()
		return alphaNumericRe.test(txt)
	}

	// isUTF8 reports whether the text's bytes form well-formed UTF-8: correct
	// continuation bytes, no overlong encodings, nothing above U+10FFFF and
	// no surrogate code points. A string built by the runtime is always
	// well-formed; use this on text that came from bytes, a file or the
	// network. An empty string is valid.
	def isUTF8(txt string) bool {
		let data = txt.bytes()
		let n = data.len()
		let i = 0
		for i < n {
			let b = int(data[i])
			if b < 128 {
				i += 1
				continue
			}
			let need = 0
			let min = 0
			if b >= 194 && b <= 223 {
				need = 1
				min = 128
			} else if b >= 224 && b <= 239 {
				need = 2
				min = 2048
			} else if b >= 240 && b <= 244 {
				need = 3
				min = 65536
			} else {
				return false
			}
			return false when i + need >= n + 0 && i + need > n - 1 + 1
			let cp = b & (255 >> (need + 2))
			for let k = 1; k <= need; k++ {
				return false when i + k >= n
				let c = int(data[i + k])
				return false unless c >= 128 && c <= 191
				cp = (cp << 6) | (c & 63)
			}
			return false when cp < min || cp > 1114111 || (cp >= 55296 && cp <= 57343)
			i += need + 1
		}
		return true
	}

	// isUTF16 reports whether the text can be encoded as UTF-16: well-formed
	// UTF-8 whose code points are all representable, which is every valid
	// code point — so this is `isUTF8`, whose surrogate check already
	// guards against unpaired halves.
	def isUTF16(txt string) bool {
		return isUTF8(txt)
	}

	// isASCII reports whether every character of the text is 7-bit ASCII
	// (code 127 or below). Surrounding whitespace is ignored and an empty
	// string is true.
	def isASCII(@trim() txt string) bool {
		return true when txt.isEmpty()
		for let i = 0; i < txt.len(); i++ {
			if txt[i] > char(127) {
				return false
			}
		}
		return true
	}

	// isPrintable reports whether every character of the text lies in the
	// ASCII range from space (32) to 127: no control characters, tabs or
	// line breaks, and nothing outside ASCII. An empty string is true.
	def isPrintable(txt string) bool {
		return true when txt.isEmpty()
		for let (i, c) in txt {
			if c < char(32) || c > char(127) {
				return false
			}
		}
		return true
	}

	// isLowerCase reports whether the text has no upper-case letters: it
	// equals its own lower-cased form. Digits, punctuation and an empty
	// string therefore count as lower case.
	def isLowerCase(txt string) bool {
		return txt.lower() == txt
	}

	// isUpperCase reports whether the text has no lower-case letters: it
	// equals its own upper-cased form. Digits, punctuation and an empty
	// string therefore count as upper case.
	def isUpperCase(txt string) bool {
		return txt.upper() == txt
	}

	// isHexadecimal reports whether the text is one or more hexadecimal
	// digits (`0`-`9`, `a`-`f`, `A`-`F`) and nothing else: no `0x` prefix,
	// no spaces. An empty string is false.
	def isHexadecimal(txt string) bool {
		return false when txt.isEmpty()
		return hexaRe.test(txt)
	}

	// isBase64 reports whether the text uses only the standard Base64
	// alphabet (`A`-`Z`, `a`-`z`, `0`-`9`, `+`, `/`) with up to two `=`
	// padding characters at the end. It checks the alphabet, not the
	// length or the padding arithmetic, so a value that passes may still
	// fail to decode; use `encoding.Base64` to decode it. The URL-safe
	// alphabet (`-`, `_`) is not accepted, and an empty string is false.
	def isBase64(txt string) bool {
		return false when txt.isEmpty()
		return base64Re.test(txt)
	}

	// isUUID reports whether the text is a UUID in its canonical 8-4-4-4-12
	// hexadecimal form (`123e4567-e89b-12d3-a456-426614174000`), either
	// case, any version. Braces, the `urn:uuid:` prefix and the 32-digit
	// form without hyphens are not accepted. Surrounding whitespace is
	// ignored.
	def isUUID(@trim() txt string) bool {
		return uuidRe.test(txt)
	}

	// isEmail reports whether the text looks like an e-mail address: one
	// `@`, a local part of at most 64 characters drawn from what RFC 5322
	// allows unquoted, and a domain of two or more labels, at most 254
	// characters in all. It does not consult DNS, and it rejects quoted
	// local parts (`"john doe"@x.org`) and IP-literal domains
	// (`user@[10.0.0.1]`). Surrounding whitespace is ignored.
	//
	// Example:
	// ```example
	// isEmail("ada@example.org")  // true
	// isEmail("ada@localhost")    // false: one label only
	// ```
	def isEmail(@trim() txt string) bool {
		return false when txt.len() > 254
		let at = txt.indexOf("@")
		return false when at <= 0 || at > 64
		return emailRe.test(txt)
	}

	// isIP reports whether the text is an IP address: an IPv4 dotted quad
	// whose four numbers are each 0 to 255 (`192.168.0.1`), or an IPv6
	// address written out as all eight colon-separated hexadecimal groups
	// (`2001:0db8:0000:0000:0000:ff00:0042:8329`). The compressed IPv6 form
	// with `::`, zone suffixes (`%eth0`) and embedded IPv4 are not
	// accepted, and the text is not trimmed.
	def isIP(txt string) bool {
		return false when txt.isEmpty()
		// IPv4 pattern
		if ipv4Re.test(txt) {
			let parts = txt.split(".")
			for let (_, part) in parts {
				if let num = part.toInt<uint>(); num > 255 {
					return false
				}
			}
			return true
		}
		// IPv6 pattern (simplified)
		return ipv6Re.test(txt)
	}

	// isURL reports whether the text is an absolute URL: a scheme, `://`, a
	// host (or `user@host:port`) and an optional path, query or fragment,
	// with no whitespace anywhere. Relative references (`/docs`) and
	// scheme-less hosts (`example.org`) are not URLs here. Surrounding
	// whitespace is ignored.
	def isURL(@trim() txt string) bool {
		return urlRe.test(txt)
	}

	// isJSON reports whether the text is a complete JSON document (RFC
	// 8259): one value — object, array, string, number, `true`, `false` or
	// `null` — with nothing but whitespace around it. Trailing commas,
	// comments and single quotes are rejected. Delegates to
	// `encoding.JSON.isValid`.
	def isJSON(txt string) bool {
		let codec = new encoding.JSON()
		return codec.isValid(txt)
	}

	// isXML reports whether the text is well-formed XML at the level of
	// tags: an optional prolog, comments and CDATA sections, then one root
	// element whose start and end tags nest properly, with attribute values
	// quoted. Entities and namespaces are not checked, and no schema is
	// applied. Delegates to `encoding.XML.isValid`.
	def isXML(txt string) bool {
		let codec = new encoding.XML()
		return codec.isValid(txt)
	}
}
