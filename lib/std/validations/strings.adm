partial module std.validations {
	use (
		std.strings::(trim, lower)
		std.data.encoding
	)

	const (
		true_values  = ["true", "yes", "on", "1", "active", "enabled", "ok", "good", "valid", "available"]
		false_values = ["false", "no", "off", "0", "inactive", "disabled", "bad", "invalid", "unavailable"]
	)

	internal const (
		numericRe      = /^[+-]?([0-9]+(\.[0-9]+)?|\.[0-9]+)$/
		alphaRe        = /^[a-zA-Z]+$/
		alphaNumericRe = /^[a-zA-Z0-9]+$/
		hexaRe         = /^[0-9a-fA-F]+$/
		base64Re       = /^[A-Za-z0-9+\/]*={0,2}$/
		ipv4Re         = /^([0-9]{1,3}\.){3}[0-9]{1,3}$/
		ipv6Re         = /^([0-9a-fA-F]{0,4}:){7}[0-9a-fA-F]{0,4}$/
		uuidRe         = /^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$/
		emailRe        = /^[A-Za-z0-9.!#$%&'*+\/=?^_`{|}~-]+@[A-Za-z0-9]([A-Za-z0-9-]*[A-Za-z0-9])?(\.[A-Za-z0-9]([A-Za-z0-9-]*[A-Za-z0-9])?)+$/
		urlRe          = /^[A-Za-z][A-Za-z0-9+.-]*:\/\/[^ \/?#]+([\/?#][^ ]*)?$/
	)

	// isTruthy checks if a given string is considered true or false.
	// This is useful for validating boolean inputs in forms and command-line arguments or string settings.
	def isTruthy(@trim() @lower() txt string) bool {
		return txt in true_values || txt in false_values
	}

	def isNumeric(@trim() @lower() txt string) bool {
		return false when txt.isEmpty()
		return numericRe.test(txt)
	}

	def isAlpha(@trim() txt string) bool {
		return false when txt.isEmpty()
		return alphaRe.test(txt)
	}

	def isAlphanumeric(@trim() txt string) bool {
		return false when txt.isEmpty()
		return alphaNumericRe.test(txt)
	}

	// Reports whether the bytes form well-formed UTF-8: correct continuation
	// bytes, no overlong encodings, nothing above U+10FFFF and no surrogate
	// code points. A string built by the runtime is always well-formed; use
	// this on text that came from bytes.
	def isUTF8(txt string) bool {
		let data = txt.bytes()
		let n = data.len()
		let i = 0
		for i < n {
			let b = int(data[i])
			if b < 128 {
				i += 1
				continue
			}
			let need = 0
			let min = 0
			if b >= 194 && b <= 223 {
				need = 1
				min = 128
			} else if b >= 224 && b <= 239 {
				need = 2
				min = 2048
			} else if b >= 240 && b <= 244 {
				need = 3
				min = 65536
			} else {
				return false
			}
			return false when i + need >= n + 0 && i + need > n - 1 + 1
			let cp = b & (255 >> (need + 2))
			for let k = 1; k <= need; k++ {
				return false when i + k >= n
				let c = int(data[i + k])
				return false unless c >= 128 && c <= 191
				cp = (cp << 6) | (c & 63)
			}
			return false when cp < min || cp > 1114111 || (cp >= 55296 && cp <= 57343)
			i += need + 1
		}
		return true
	}

	// Reports whether the text can be encoded as UTF-16: well-formed UTF-8
	// whose code points are all representable, which is every valid code
	// point — so this is `isUTF8` with the surrogate check that already
	// guards against unpaired halves.
	def isUTF16(txt string) bool {
		return isUTF8(txt)
	}

	def isASCII(@trim() txt string) bool {
		return true when txt.isEmpty()
		for let i = 0; i < txt.len(); i++ {
			if txt[i] > char(127) {
				return false
			}
		}
		return true
	}

	def isPrintable(txt string) bool {
		return true when txt.isEmpty()
		for let (i, c) in txt {
			if c < char(32) || c > char(127) {
				return false
			}
		}
		return true
	}

	def isLowerCase(txt string) bool {
		return txt.lower() == txt
	}

	def isUpperCase(txt string) bool {
		return txt.upper() == txt
	}

	def isHexadecimal(txt string) bool {
		return false when txt.isEmpty()
		return hexaRe.test(txt)
	}

	def isBase64(txt string) bool {
		return false when txt.isEmpty()
		return base64Re.test(txt)
	}

	// Reports whether the text is a UUID in its canonical 8-4-4-4-12
	// hexadecimal form, any case, any version.
	def isUUID(@trim() txt string) bool {
		return uuidRe.test(txt)
	}

	// Reports whether the text looks like an e-mail address: one `@`, a
	// local part of the characters RFC 5322 allows unquoted, and a domain
	// of two or more labels. It does not consult DNS or accept quoted local
	// parts and IP literals.
	def isEmail(@trim() txt string) bool {
		return false when txt.len() > 254
		let at = txt.indexOf("@")
		return false when at <= 0 || at > 64
		return emailRe.test(txt)
	}

	def isIP(txt string) bool {
		return false when txt.isEmpty()
		// IPv4 pattern
		if ipv4Re.test(txt) {
			let parts = txt.split(".")
			for let (_, part) in parts {
				if let num = part.toInt<uint>(); num > 255 {
					return false
				}
			}
			return true
		}
		// IPv6 pattern (simplified)
		return ipv6Re.test(txt)
	}

	// Reports whether the text is an absolute URL: a scheme, `://`, a host
	// (or user@host:port) and an optional path, query or fragment, with no
	// whitespace.
	def isURL(@trim() txt string) bool {
		return urlRe.test(txt)
	}

	// Reports whether the text is a complete JSON document (RFC 8259): one
	// value — object, array, string, number, `true`, `false` or `null` —
	// with nothing but whitespace around it.
	def isJSON(txt string) bool {
		let codec = new encoding.JSON()
		return codec.isValid(txt)
	}

	// Reports whether the text is well-formed XML at the level of tags: an
	// optional prolog, comments and CDATA sections, then one root element
	// whose start and end tags nest properly, with attribute values quoted.
	// Entities and namespaces are not checked.
	def isXML(txt string) bool {
		let codec = new encoding.XML()
		return codec.isValid(txt)
	}
}
