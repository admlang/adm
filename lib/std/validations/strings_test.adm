partial module std.validations {
	use std.testing

	check "String validations" {
		@test()
		def IsTruthy() {
			assert true_values.mapElem(a => a.isTruthy()).find(a => !a) is none
			println(string["TRUE", "YES"].mapElem(a => a.isTruthy()).str())
			assert string["TRUE", "YES"].mapElem(a => a.isTruthy()).find(a => !a) is none
			assert false_values.mapElem(a => a.isTruthy()).find(a => !a) is none
			assert string["test", "", " "].mapElem(a => a.isTruthy()).find(a => a) is none
		}

		@test()
		def isNumeric() {
			assert string["123", "-123", "12.3", "-12.3", " 123 "].mapElem(a => a.isNumeric()).find(a => !a) is none
			assert string["test", "xyz", "", " "].mapElem(a => a.isNumeric()).find(a => a) is none
		}

		@test()
		def isAlpha() {
			assert string["abc", "ABC", "abcXYZ"].mapElem(a => a.isAlpha()).find(a => !a) is none
			assert string["abc123", "123", "", " ", "abc-def", "abc def"].mapElem(a => a.isAlpha()).find(a => a) is none
		}

		@test()
		def isAlphanumeric() {
			assert string["abc123", "ABC123", "test123TEST"].mapElem(a => a.isAlphanumeric()).find(a => !a) is none
			assert string["abc-123", "", " ", "test 123", "abc_def"].mapElem(a => a.isAlphanumeric()).find(a => a) is none
		}

		@test()
		def isASCII() {
			assert string["hello", "123", "Hello World!", "test@example.com"].mapElem(a => a.isASCII()).find(a => !a) is none
			assert string["hello™", "café", "日本語", "emoji😀"].mapElem(a => a.isASCII()).find(a => a) is none
			assert "".isASCII() == true
		}

		@test()
		def isPrintable() {
			assert string["hello", "Hello World!", "123 abc"].mapElem(a => a.isPrintable()).find(a => !a) is none
			assert string["hello\n", "test\t", "line\r\n"].mapElem(a => a.isPrintable()).find(a => a) is none
			assert "".isPrintable() == true
		}

		@test()
		def isLowerCase() {
			assert string["abc", "hello", "", " ", "test"].mapElem(a => a.isLower()).find(a => !a) is none
			assert string["ABC", "Hello", "tesD123", "abc aED"].mapElem(a => a.isLower()).find(a => a) is none
		}

		@test()
		def isUpperCase() {
			assert string["ABC", "HELLO", "", " ", "TEST"].mapElem(a => a.isUpper()).find(a => !a) is none
			assert string["abc", "Hello", "TESf123", "ABf DfF"].mapElem(a => a.isUpper()).find(a => a) is none
		}

		@test()
		def isHexadecimal() {
			assert string["1234567890", "abcdef", "ABCDEF", "1a2b3c"].mapElem(a => a.isHexadecimal()).find(a => !a) is none
			assert string["xyz", "12g", "", " ", "0x123"].mapElem(a => a.isHexadecimal()).find(a => a) is none
		}

		@test()
		def isBase64() {
			assert string["SGVsbG8=", "dGVzdA==", "YWJjMTIz", "QUJD"].mapElem(a => a.isBase64()).find(a => !a) is none
			assert string["Hello!", "test@", "abc-123", "==="].mapElem(a => a.isBase64()).find(a => a) is none
			assert "".isBase64() == false
		}

		@test()
		def isIP() {
			assert string[
					"192.168.1.1",
					"127.0.0.1",
					"255.255.255.255",
					"0.0.0.0",
					"2001:0db8:85a3:0000:0000:8a2e:0370:7334"
				].mapElem(a => a.isIP()).find(a => !a) is none

			assert string[
					"256.1.1.1",
					"192.168.1",
					"192.168.1.1.1",
					"",
					"not-an-ip",
					"192.168.-1.1"
				].mapElem(a => a.isIP()).find(a => a) is none
		}

		@test()
		def isUUID() {
			assert "123e4567-e89b-12d3-a456-426614174000".isUUID()
			assert "123E4567-E89B-12D3-A456-426614174000".isUUID()
			assert !"123e4567e89b12d3a456426614174000".isUUID()
			assert !"123e4567-e89b-12d3-a456-42661417400".isUUID()
			assert !"".isUUID()
		}

		@test()
		def isEmail() {
			assert "a@b.co".isEmail()
			assert "first.last+tag@sub.example.org".isEmail()
			assert !"a@b".isEmail()
			assert !"@example.com".isEmail()
			assert !"a b@example.com".isEmail()
			assert !"a@@example.com".isEmail()
			assert !"".isEmail()
		}

		@test()
		def isURL() {
			assert "https://example.com".isURL()
			assert "http://example.com/path?q=1#frag".isURL()
			assert "git@github.com:user/repo.git".isURL() == false
			assert "ssh://git@github.com/user/repo.git".isURL()
			assert !"example.com".isURL()
			assert !"http://exa mple.com".isURL()
			assert !"".isURL()
		}

		@test()
		def isJSON() {
			assert "\{}".isJSON()
			assert "[]".isJSON()
			assert " \{\"a\": [1, 2.5e3, true, null, \"x\"], \"b\": \{\"c\": -0.1}} ".isJSON()
			assert "\"just a string\"".isJSON()
			assert "42".isJSON()
			assert !"\{".isJSON()
			assert !"\{\"a\": }".isJSON()
			assert !"[1,]".isJSON()
			assert !"\{'a': 1}".isJSON()
			assert !"01".isJSON()
			assert !"\{} \{}".isJSON()
			assert !"".isJSON()
		}

		@test()
		def isXML() {
			assert "<a/>".isXML()
			assert "<?xml version=\"1.0\"?><root attr=\"v\"><child>text</child><!-- c --><e/></root>".isXML()
			assert "<a><b><c>x</c></b></a>".isXML()
			assert "<a><![CDATA[<not a tag>]]></a>".isXML()
			assert !"<a>".isXML()
			assert !"<a></b>".isXML()
			assert !"<a attr=v></a>".isXML()
			assert !"text".isXML()
			assert !"<a></a><b></b>".isXML()
			assert !"".isXML()
		}

		@test()
		def isUTF8() {
			assert "plain".isUTF8()
			assert "héllo wörld ✓ 🎉".isUTF8()
			assert "".isUTF8()
			assert "héllo".isUTF16()
		}
	}
}
