partial module std.validations {
	// luhnCheck reports whether a number passes the Luhn checksum, the
	// check-digit formula behind credit card numbers, IMEIs and many other
	// identifiers ([Luhn algorithm](https://en.wikipedia.org/wiki/Luhn_algorithm)).
	// The data is the number as ASCII digit bytes, check digit last; it is
	// not trimmed, and spaces or dashes must be removed first. An empty
	// input fails. Passing says the digits are consistent, not that the
	// number was issued.
	//
	// Example:
	// ```example
	// luhnCheck(byte[]("79927398713")) // true
	// luhnCheck(byte[]("79927398714")) // false: wrong check digit
	// ```
	def luhnCheck(data byte[]) bool {
		let n, result, double = data.len(), 0, false
		return false when n == 0 // edge case: empty data

		// Iterate from right to left
		for let i = n - 1; i >= 0; i-- {
			let number = int(data[i]) - 48
			if double {
				number *= 2
				number -= 9 when number > 9
			}
			result += number
			double = !double
		}
		return (result % 10) == 0
	}

	check "luhnCheck" {
		for let (_, t) in string["79927398713", "49927398716", "1234567812345670", "0"] {
			assert luhnCheck(byte[](t))
		}
		for let (_, t) in string["123", "79927398714", "1234567812345678", "", "1"] {
			assert !luhnCheck(byte[](t))
		}
	}
}
